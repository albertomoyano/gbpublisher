{
  "formato": "gbpublisher-regex",
  "version": 1,
  "patrones": [
    {
      "nombre": "rango-anios",
      "descripcion": "Rango de años: «1990--2000», «1990–2000», «1990 - 2000»… → «1990-2000» (guion simple)",
      "patron": "(?<![\\p{L}\\p{N}])(\\d{4})(?:\\s*(?:---|--|–|—)\\s*|\\s+-\\s*|-\\s+)(\\d{4})(?![\\p{L}\\p{N}])",
      "reemplazo": "$1-$2",
      "flags": "",
      "texto_prueba": "Variantes: 1990--2000, 1990–2000, 1990—2000, 1990---2000, 1990 - 2000, 1990 -2000, 1990- 2000, 1990 -- 2000\nYa bien (no coincide): 1990-2000\nNo son años (no coinciden): 12345--67890, 199--200, ISBN 978-950-12-3456-7"
    }
  ]
}
