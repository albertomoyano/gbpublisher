# ÓRDENES ADMITIDAS EN EL TEXTO: LA LETRA VOLADA \sptext (SC-62) Y LAS
# CIFRAS \num, \SI Y \SIrange (SC-65), Y LAS MARCAS DE ÍNDICE \index (SC-77,
# CON UN NIVEL DE LLAVES ADENTRO: |see{…}, \emph{…}). EL PATRÓN SE ESCRIBE UNA SOLA VEZ Y
# SE USA EN EL ESTADO SUELTO Y COMO HIJO DE LA BASTARDILLA, LA NEGRITA Y EL
# TACHADO: SIN EL HIJO, ADENTRO DE UN from … to TODO TOMA EL COLOR DEL TRAMO
# (GV-119). SOLO LA FORMA: EL CONTENIDO LO VALIDA EL FILTRO
$(orden)=/\\(sptext\{[^}\n]*\}|num\{[^}\n]*\}|SI(range)?(\{[^}\n]*\}){2,3}|index(\[[^]\n]*\])?\{([^{}\n]|\{[^{}\n]*\})*\})/

shortcode.abre{Function}:
  match /^:::+\s*(\{[^}]*\}|[a-z0-9-]+).*$/

shortcode.ancla{Function}:
  match /^\[\/[a-z0-9-]+\]:\x20#\x20\(\)\s*$/

shortcode.cierra{Function}:
  match /^:::+\s*$/

shortcode.linea.abre{Function}:
  match /\[(?=[^\]\n]*\]\{)/

shortcode.linea.cierra{Function}:
  match /\]\{[^}\n]*\}/

latex.orden{Function}:
  match $(orden)

comment{Documentation}:
  match /^>.*$/

header{Header}:
  match /^#{1,6}.*$/

code.block{String}:
  from /^```/ to /^```$/

code.inline{String}:
  from ` to `

# NEGRITA Y BASTARDILLA JUNTAS (***texto*** O ___texto___): VAN ANTES DE LA
# NEGRITA. SIN ESTOS ESTADOS, bold.double TOMABA ** Y CERRABA EN LOS DOS
# PRIMEROS ASTERISCOS DEL FINAL; EL TERCERO ABRÍA UNA BASTARDILLA QUE NO
# CERRABA Y COLOREABA TODO LO QUE SEGUÍA
bold.italic.star{Keyword}:
  from *** to ***
  latex.orden.dentro{Function}:
    match $(orden)

bold.italic.underscore{Keyword}:
  from ___ to ___
  latex.orden.dentro{Function}:
    match $(orden)

bold.double{Keyword}:
  from ** to **
  latex.orden.dentro{Function}:
    match $(orden)

bold.underscore{Keyword}:
  from __ to __
  latex.orden.dentro{Function}:
    match $(orden)

# LA BASTARDILLA ABRE SOLO CON UN * PEGADO AL TEXTO QUE SIGUE: «* ítem» ES UNA
# LISTA Y «5 * 3» NO ES BASTARDILLA. EL CIERRE NO PUEDE MIRAR HACIA ATRÁS: UN
# LOOKBEHIND NO VE LO ANTERIOR A LA POSICIÓN (MEDIDO, GV-120)
italic.star{Comment}:
  from /\*(?=\S)/ to *
  latex.orden.dentro{Function}:
    match $(orden)

# UNA PALABRA CON GUION BAJO ADENTRO (snake_case, año_ñandú) NO ES BASTARDILLA:
# PANDOC NO LA LEE COMO ÉNFASIS. SE CONSUME ENTERA ANTES DE italic.underscore
palabra.guion.bajo{Normal}:
  match /[\p{L}\p{N}]+(_[\p{L}\p{N}]+)+/

italic.underscore{Comment}:
  from /_(?=\S)/ to _
  latex.orden.dentro{Function}:
    match $(orden)

strikethrough{Removed}:
  from ~~ to ~~
  latex.orden.dentro{Function}:
    match $(orden)

reference{Added}:
  match /\[@([^\]]+)\]/

references{Added}:
  match /\[[^\]]*@[^]]*\]/

footnote{Preprocessor}:
  match /\[\^([^\]]+)\]/

error{Error}:
  match /\[[0-9]{2}-[^\]]*\]/

link{Expansion}:
  match /\[([^\]]+)\]\(([^\)]+)\)/

image{Expansion}:
  match /!\[([^\]]*)\]\(([^\)]+)\)/

list.unordered{Operator}:
  match /^\s*[\-\*\+]\s/

list.ordered{Number}:
  match /^\s*[0-9]+\.\s/

rule{Operator}:
  match /^[\-\*_]{3,}\s*$/

url{Datatype}:
  match /https?:\/\/[^\s)\]]+/

table.pipe{Symbol}:
  symbol |

