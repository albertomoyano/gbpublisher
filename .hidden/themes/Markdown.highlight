# LETRA VOLADA (SC-62): EL PATRÓN SE ESCRIBE UNA SOLA VEZ Y SE USA EN EL
# ESTADO SUELTO Y COMO HIJO DE LA BASTARDILLA, LA NEGRITA Y EL TACHADO: SIN
# EL HIJO, ADENTRO DE UN from … to TODO TOMA EL COLOR DEL TRAMO (GV-119)
$(sptext)=/\\sptext\{[^}\n]*\}/

shortcode.abre{Function}:
  match /^:::+\s*(\{[^}]*\}|[a-z0-9-]+).*$/

shortcode.ancla{Function}:
  match /^\[\/[a-z0-9-]+\]:\x20#\x20\(\)\s*$/

shortcode.cierra{Function}:
  match /^:::+\s*$/

shortcode.linea.abre{Function}:
  match /\[(?=[^\]\n]*\]\{)/

shortcode.linea.cierra{Function}:
  match /\]\{[^}\n]*\}/

latex.sptext{Function}:
  match $(sptext)

comment{Documentation}:
  match /^>.*$/

header{Header}:
  match /^#{1,6}.*$/

code.block{String}:
  from /^```/ to /^```$/

code.inline{String}:
  from ` to `

bold.double{Keyword}:
  from ** to **
  latex.sptext.dentro{Function}:
    match $(sptext)

bold.underscore{Keyword}:
  from __ to __
  latex.sptext.dentro{Function}:
    match $(sptext)

italic.star{Comment}:
  from * to *
  latex.sptext.dentro{Function}:
    match $(sptext)

italic.underscore{Comment}:
  from _ to _
  latex.sptext.dentro{Function}:
    match $(sptext)

strikethrough{Removed}:
  from ~~ to ~~
  latex.sptext.dentro{Function}:
    match $(sptext)

reference{Added}:
  match /\[@([^\]]+)\]/

references{Added}:
  match /\[[^\]]*@[^]]*\]/

footnote{Preprocessor}:
  match /\[\^([^\]]+)\]/

error{Error}:
  match /\[[0-9]{2}-[^\]]*\]/

link{Expansion}:
  match /\[([^\]]+)\]\(([^\)]+)\)/

image{Expansion}:
  match /!\[([^\]]*)\]\(([^\)]+)\)/

list.unordered{Operator}:
  match /^\s*[\-\*\+]\s/

list.ordered{Number}:
  match /^\s*[0-9]+\.\s/

rule{Operator}:
  match /^[\-\*_]{3,}\s*$/

url{Datatype}:
  match /https?:\/\/[^\s)\]]+/

table.pipe{Symbol}:
  symbol |

