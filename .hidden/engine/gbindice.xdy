;; ============================================================
;; MÓDULO      : gbindice.xdy
;; PROPÓSITO   : DECLARA PARA xindy LOS FORMATOS DE PÁGINA QUE
;;               ESCRIBE docbook-to-latex.xsl EN LOS ÍNDICES
;;               ONOMÁSTICO Y DE CONCEPTOS (SC-77):
;;                 gbIndPrincipal  LA PÁGINA PRINCIPAL (|textbf
;;                                 EN EL .md), EN NEGRITA
;;                 gbIndNota       LA MARCA ESTÁ EN UNA NOTA: «23 n.»
;;               \gbIndPrincipal Y \gbIndNota LOS DEFINE EL CONTRATO
;;               (preambulo-contrato.tex, VERSIÓN 18).
;; POR QUÉ     : xindy DESCARTA UNA PÁGINA CON UN FORMATO QUE NO TIENE
;;               DECLARADO, CON UN «WARNING: unknown attribute» Y NADA
;;               MÁS (GV-160). compilar_latex_comun.sh LO AVISA.
;; UBICACIÓN   : engine/ — VIAJA EN EL .deb Y NO SE COPIA A
;;               ~/.gbpublisher (SC-11), COMO compilar_latex_comun.sh.
;; USO         : xindy -M texindy -M page-ranges -M word-order
;;                     -M RUTA/gbindice.xdy -L spanish-modern -C utf8 …
;;               DESPUÉS DE texindy, QUE YA DECLARA LOS CUATRO PRIMEROS.
;; ORDEN       : EN UN MISMO GRUPO, CUANDO UNA ENTRADA TIENE DOS MARCAS
;;               EN LA MISMA PÁGINA, QUEDA LA DEL FORMATO QUE VA PRIMERO
;;               EN LA LISTA (MEDIDO, 30/10/2026):
;;                 PRINCIPAL Y COMÚN EN LA PÁGINA 5   → 5 EN NEGRITA
;;                 COMÚN Y EN NOTA EN LA PÁGINA 5     → 5, SIN «n.»
;;               POR ESO gbIndPrincipal VA PRIMERO Y gbIndNota ÚLTIMO.
;;               xindy AVISA QUE IGNORA LA REDEFINICIÓN DE LOS CUATRO
;;               QUE YA TENÍA; EL ORDEN NUEVO SE APLICA IGUAL (MEDIDO).
;; ============================================================

(define-attributes (("gbIndPrincipal" "default" "textbf" "textit" "hyperpage" "gbIndNota")))

(markup-locref :open "\gbIndPrincipal{" :close "}" :attr "gbIndPrincipal")
(markup-locref :open "\gbIndNota{" :close "}" :attr "gbIndNota")
