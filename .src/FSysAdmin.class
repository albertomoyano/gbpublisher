' ============================================
' Función   : btnProyectosTodos_Click
' Propósito : Recarga todos los proyectos en el TableView
' ============================================
Public Sub btnProyectosTodos_Click()

  CargarProyectosDelServidor()

End

' ============================================
' Función   : btnProyectosEnCurso_Click
' Propósito : Filtra y muestra solo los proyectos activos
' ============================================
Public Sub btnProyectosEnCurso_Click()

  If Not hConnServidor Or Not hConnServidor.Opened Then
    m_Sonido.sonar("Warning")
    Message.Warning("No hay conexión al servidor.")
    Return
  Endif

  ConfigurarTableViewProyectos()

  Dim rs As Result = hConnServidor.Exec("SELECT * FROM proyectos " &
    "WHERE activo = 1 ORDER BY fecha_creacion DESC;")

  LlenarTableViewProyectos(rs)

Catch
  m_Sonido.sonar("Error")
  Message.Error("Error cargando proyectos en curso: " & Error.Text)

End

' ============================================
' Función   : btnProyectosArchivados_Click
' Propósito : Filtra y muestra solo los proyectos archivados
' ============================================
Public Sub btnProyectosArchivados_Click()

  If Not hConnServidor Or Not hConnServidor.Opened Then
    m_Sonido.sonar("Warning")
    Message.Warning("No hay conexión al servidor.")
    Return
  Endif

  ConfigurarTableViewProyectos()

  Dim rs As Result = hConnServidor.Exec("SELECT * FROM proyectos " &
    "WHERE activo = 0 ORDER BY fecha_creacion DESC;")

  LlenarTableViewProyectos(rs)

Catch
  m_Sonido.sonar("Error")
  Message.Error("Error cargando proyectos archivados: " & Error.Text)

End

' ============================================
' Función   : ConfigurarTableViewProyectos
' Propósito : Establece la estructura de columnas del
'             TableView de proyectos
' ============================================
Private Sub ConfigurarTableViewProyectos()

  With TableViewProyectos
    .Clear
    .Rows.Count = 0
    .Columns.Count = 7

    .Columns[0].Title = "ID"
    .Columns[0].Width = 0
    .Columns[1].Title = "Proyecto"
    .Columns[1].Width = 250
    .Columns[2].Title = "Activo"
    .Columns[2].Width = 0
    .Columns[3].Title = "Ocupado"
    .Columns[3].Width = 80
    .Columns[4].Title = "Tipo"
    .Columns[4].Width = 200
    .Columns[5].Title = "Fecha Creación"
    .Columns[5].Width = 150
    .Columns[6].Title = "Última Modificación"
    .Columns[6].Width = 150

    .Mode = Select.Single
    .Header = True
  End With

End

' ============================================
' Función   : LlenarTableViewProyectos
' Propósito : Llena el TableView de proyectos con los
'             datos del Result recibido
' Parámetros: rs As Result — resultado de la consulta
' ============================================
Private Sub LlenarTableViewProyectos(rs As Result)

  Dim i As Integer

  If Not rs.Available Then
    TableViewProyectos.Rows.Count = 0
    Return
  Endif

  TableViewProyectos.Rows.Count = rs.Count
  i = 0

  While rs.Available
    TableViewProyectos[i, 0].Text = rs["id"]
    TableViewProyectos[i, 1].Text = rs["nombre"]
    TableViewProyectos[i, 2].Text = rs["activo"]

    Select Case rs["tipo_producto"]
      Case 1
        TableViewProyectos[i, 4].Text = "Revista en markdown"
      Case 2
        TableViewProyectos[i, 4].Text = "Libro en markdown"
      Case 3
        TableViewProyectos[i, 4].Text = "Libro en LaTeX"
      Default
        TableViewProyectos[i, 4].Text = "Desconocido"
    End Select

    ' COLUMNA OCUPADO CON INDICADOR VISUAL DE COLOR
    If rs["ocupado"] = True Or rs["ocupado"] = 1 Then
      TableViewProyectos[i, 3].Text = "SÍ"
      TableViewProyectos[i, 3].Background = Color.RGB(255, 200, 200)
    Else
      TableViewProyectos[i, 3].Text = "NO"
      TableViewProyectos[i, 3].Background = Color.RGB(200, 255, 200)
    Endif

    If rs["fecha_creacion"] Then
      Try TableViewProyectos[i, 5].Text = Format(rs["fecha_creacion"], "dd/mm/yyyy hh:nn")
    Endif

    If rs["fecha_modificacion"] Then
      Try TableViewProyectos[i, 6].Text = Format(rs["fecha_modificacion"], "dd/mm/yyyy hh:nn")
    Endif

    i += 1
    rs.MoveNext()
  Wend

End

' ============================================
' Función   : CargarProyectosDelServidor
' Propósito : Consulta todos los proyectos del servidor
'             y los muestra en el TableView
' ============================================
Private Sub CargarProyectosDelServidor()

  If Not hConnServidor Or Not hConnServidor.Opened Then
    m_Sonido.sonar("Warning")
    Message.Warning("No hay conexión al servidor.")
    Return
  Endif

  ConfigurarTableViewProyectos()

  Dim rs As Result = hConnServidor.Exec(
    "SELECT * FROM proyectos ORDER BY fecha_creacion DESC;")

  LlenarTableViewProyectos(rs)

Catch
  m_Sonido.sonar("Error")
  Message.Error("Error cargando proyectos: " & Error.Text)

End

' ============================================
' Función   : TableViewProyectos_Click
' Propósito : Carga el estado del proyecto seleccionado,
'             incluyendo el estado ocupado leído desde la BD
'             para reflejar el estado real tras accidentes
' ============================================
Public Sub TableViewProyectos_Click()

  ' --- 1. Obtener fila seleccionada ---
  Dim iRow As Integer = TableViewProyectos.Row

  If iRow < 0 Then Return
  If Not hConnServidor Or Not hConnServidor.Opened Then Return

  ' --- 2. Consultar estado real desde BD ---
  ' SE LEEN ACTIVO Y OCUPADO EN UNA SOLA CONSULTA
  ' OCUPADO SE LEE DESDE BD Y NO DEL GRID PARA REFLEJAR EL ESTADO REAL
  ' ESPECIALMENTE ÚTIL TRAS CORTES DE ENERGÍA O CUELGUES DE LA APP
  Dim iProyectoID As Integer = Val(TableViewProyectos[iRow, 0].Text)
  Dim rs As Result

  rs = hConnServidor.Exec("SELECT activo, ocupado FROM proyectos WHERE id = " & iProyectoID & ";")

  If rs.Available Then
    Dim bActivo As Boolean = rs["activo"]
    RadioButtonEnCurso.Value = bActivo
    RadioButtonArchivar.Value = Not bActivo
    ' CARGAR ESTADO OCUPADO EN EL CHECKBOX
    chkOcupado.Value = rs["ocupado"] = True
  Endif

Catch

End

' ============================================
' Función   : btnGuardarCambiosProyecto_Click
' Propósito : ACTUALIZAR EL ESTADO DE UN PROYECTO, INCLUIDO ocupado PARA
'             LIBERAR PROYECTOS BLOQUEADOS POR CORTES O CUELGUES. ARCHIVAR UN
'             PROYECTO CIERRA LAS NOTAS ABIERTAS DE SU GRUPO EN LA MISMA
'             TRANSACCIÓN, FIRMADAS CON EL NOMBRE DEL ADMINISTRADOR. REACTIVARLO
'             NO LAS REABRE.
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnGuardarCambiosProyecto_Click()

  ' --- 0. INICIALIZACIÓN ---
  Dim iRow As Integer
  Dim iProyectoID As Integer
  Dim sNombreProyecto As String
  Dim bNuevoEstado As Boolean
  Dim sError As String

  ' --- 1. VERIFICAR SELECCIÓN Y CONEXIÓN ---
  iRow = TableViewProyectos.Row
  If iRow < 0 Then
    m_Sonido.sonar("Warning")
    Message.Warning("Debe seleccionar un proyecto de la tabla para modificar.")
    Return
  Endif

  ' NULL Y Opened EN If SEPARADOS: Or NO ES SHORT-CIRCUIT (RC-GM-17)
  If Not hConnServidor Then
    m_Sonido.sonar("Warning")
    Message.Warning("No hay conexión al servidor.")
    Return
  Endif
  If Not hConnServidor.Opened Then
    m_Sonido.sonar("Warning")
    Message.Warning("No hay conexión al servidor.")
    Return
  Endif

  ' --- 2. DATOS DEL PROYECTO ---
  iProyectoID = Val(TableViewProyectos[iRow, 0].Text)
  sNombreProyecto = TableViewProyectos[iRow, 1].Text
  bNuevoEstado = RadioButtonEnCurso.Value

  ' --- 3. ESTADO DEL PROYECTO Y, SI SE ARCHIVA, CIERRE DE SUS NOTAS ---
  ' UNA SOLA TRANSACCIÓN (SC-07): SI EL CIERRE FALLA, EL PROYECTO NO QUEDA
  ' ARCHIVADO CON NOTAS ABIERTAS. OCUPADO SE INCLUYE SIEMPRE PARA PERMITIR
  ' LIBERAR PROYECTOS BLOQUEADOS
  Try hConnServidor.Begin()
  If Error Then Goto FALLA_SQL

  Try hConnServidor.Exec("UPDATE proyectos SET activo = &2, ocupado = &3, fecha_modificacion = NOW() WHERE id = &1",
    iProyectoID, If(bNuevoEstado, 1, 0), If(chkOcupado.Value, 1, 0))
  If Error Then Goto FALLA_SQL

  If Not bNuevoEstado Then
    ' EL CIERRE ES ACTIVIDAD: LOS MIEMBROS LO VEN COMO NOVEDAD
    Try hConnServidor.Exec("UPDATE notas n JOIN notas_grupos g ON g.id = n.id_grupo " &
      "SET n.fecha_cierre = NOW(), n.cierre_sistema = &2, n.ultima_actividad = NOW(6) " &
      "WHERE g.id_proyecto = &1 AND n.fecha_cierre IS NULL", iProyectoID, sUsuarioActual)
    If Error Then Goto FALLA_SQL
  Endif

  Try hConnServidor.Commit()
  If Error Then Goto FALLA_SQL

  ' --- 4. RESULTADO ---
  m_Sonido.sonar("Info")
  Message.Info("Estado del proyecto <b>'" & sNombreProyecto & "'</b> actualizado correctamente.")
  CargarProyectosDelServidor()
  ' ARCHIVAR CAMBIA LAS NOTAS ABIERTAS DE LA PESTAÑA «Notas»
  CargarNotasAdmin()
  Return

FALLA_SQL:
  ' EL TEXTO SE GUARDA ANTES DEL Rollback, QUE PODRÍA PISARLO
  sError = Error.Text
  Try hConnServidor.Rollback()
  m_Sonido.sonar("Error")
  Message.Error("Error guardando cambios: " & sError)

End

' ============================================
' Función   : CargarListaRespaldos
' Propósito : Lista los archivos .sql del directorio de
'             respaldo en el ListBox correspondiente
' ============================================
Private Sub CargarListaRespaldos()

  ' --- 1. Obtener archivos SQL del directorio de respaldo ---
  Dim sRutaRespaldo As String = User.Home &/ ".gbpublisher/respaldo"
  Dim aArchivos As String[] = RDir(sRutaRespaldo, "*.sql")

  If aArchivos.Count = 0 Then Return

  ' --- 2. Ordenar y mostrar los más recientes primero ---
  aArchivos.Sort(gb.Descent)

  ListarBases.Clear()
  Dim sArchivo As String
  For Each sArchivo In aArchivos
    ListarBases.Add(sArchivo, sArchivo)
  Next

End

' ============================================
' Función   : ListarBases_Select
' Propósito : Al seleccionar un archivo de respaldo, extrae
'             y muestra las tablas que contiene
' ============================================
Public Sub ListarBases_Select()

  ' --- 1. Verificar selección ---
  If Not ListarBases.Current Then Return

  ' --- 2. Leer y parsear el archivo SQL ---
  Dim sRutaRespaldo As String = User.Home &/ ".gbpublisher/respaldo"
  Dim sArchivoSQL As String = sRutaRespaldo &/ ListarBases.Current.Key
  Dim sContenido As String = File.Load(sArchivoSQL)
  Dim aLineas As String[] = Split(sContenido, "\n")

  ListarTablas.Clear()

  ' --- 3. Buscar y extraer nombres de tablas ---
  Dim sLinea As String
  Dim sNombreTabla As String
  Dim iPos As Integer

  For Each sLinea In aLineas
    sLinea = Trim(sLinea)
    If InStr(UCase(sLinea), "CREATE TABLE") > 0 Then
      sLinea = Replace(sLinea, "`", "")
      iPos = InStr(UCase(sLinea), "CREATE TABLE ")
      If iPos > 0 Then
        sNombreTabla = Trim(Mid(sLinea, iPos + 13))
        iPos = InStr(sNombreTabla, " ")
        If iPos > 0 Then sNombreTabla = Left(sNombreTabla, iPos - 1)
        iPos = InStr(sNombreTabla, "(")
        If iPos > 0 Then sNombreTabla = Left(sNombreTabla, iPos - 1)
        If Trim(sNombreTabla) <> "" Then ListarTablas.Add(Trim(sNombreTabla))
      Endif
    Endif
  Next

  ' --- 4. Limpiar el TableView de contenido ---
  ListarContenido.Rows.Count = 0
  ListarContenido.Columns.Count = 0

End

' ============================================
' Función   : ListarTablas_Select
' Propósito : Al seleccionar una tabla, muestra su contenido
' ============================================
Public Sub ListarTablas_Select()

  LlenaGrid()

End

' ============================================
' Función   : LlenaGrid
' Propósito : Extrae la estructura y datos de la tabla
'             seleccionada y los muestra en el TableView
' ============================================
Private Sub LlenaGrid()

  If ListarTablas.Index < 0 Then Return
  If Not ListarBases.Current Then Return

  Dim sTablaSeleccionada As String = ListarTablas[ListarTablas.Index].Text
  Dim sRutaRespaldo As String = User.Home &/ ".gbpublisher/respaldo"
  Dim sArchivoSQL As String = sRutaRespaldo &/ ListarBases.Current.Key
  Dim sContenido As String = File.Load(sArchivoSQL)

  ExtraerEstructuraYDatos(sContenido, sTablaSeleccionada)

  ListarContenido.Clear()

  If $aColumnas.Count = 0 Then Return

  ' --- CONFIGURAR COLUMNAS ---
  ListarContenido.Columns.Count = $aColumnas.Count
  Dim i As Integer
  For i = 0 To $aColumnas.Max
    ListarContenido.Columns[i].Title = $aColumnas[i]
    ListarContenido.Columns[i].Width = -1
  Next

  ' --- LLENAR FILAS ---
  If $aRegistros.Count > 0 Then
    ListarContenido.Rows.Count = $aRegistros.Count
    Dim j As Integer
    For i = 0 To $aRegistros.Max
      For j = 0 To Min($aRegistros[i].Max, $aColumnas.Max)
        ListarContenido[i, j].Text = $aRegistros[i][j]
      Next
    Next
  Endif

End

' ============================================
' Función   : ExtraerEstructuraYDatos
' Propósito : Parsea el SQL del respaldo extrayendo columnas
'             e INSERTs de la tabla indicada
' Parámetros: sContenido As String — contenido del archivo SQL
'             sTabla     As String — nombre de la tabla a extraer
' ============================================
Private Sub ExtraerEstructuraYDatos(sContenido As String, sTabla As String)

  Dim aLineas As String[] = Split(sContenido, "\n")
  Dim sLinea As String
  Dim bDentroCreate As Boolean = False
  Dim iPosInicio As Integer
  Dim iPosFin As Integer
  Dim sCampo As String

  $aColumnas = New String[]
  $aRegistros = New String[][]

  For Each sLinea In aLineas
    sLinea = Trim(sLinea)

    ' DETECTAR INICIO DE CREATE TABLE
    If InStr(UCase(sLinea), "CREATE TABLE") > 0 And InStr(sLinea, "`" & sTabla & "`") > 0 Then
      bDentroCreate = True
      Continue
    Endif

    If bDentroCreate Then
      ' EXTRAER DEFINICIONES DE COLUMNAS
      If Left(Trim(sLinea), 1) = "`" Then
        If Not InStr(UCase(sLinea), "PRIMARY KEY") And
            Not InStr(UCase(sLinea), "UNIQUE KEY") And
            Not InStr(UCase(sLinea), "CONSTRAINT") And
            Not InStr(UCase(sLinea), "FOREIGN KEY") And
            Not InStr(UCase(sLinea), "KEY `") Then
          iPosInicio = InStr(sLinea, "`")
          If iPosInicio > 0 Then
            iPosFin = InStr(sLinea, "`", iPosInicio + 1)
            If iPosFin > iPosInicio Then
              sCampo = Mid(sLinea, iPosInicio + 1, iPosFin - iPosInicio - 1)
              $aColumnas.Add(sCampo)
            Endif
          Endif
        Endif
      Endif
      ' DETECTAR FIN DE CREATE TABLE
      If InStr(sLinea, ") ENGINE=") > 0 Then bDentroCreate = False
    Endif

    ' EXTRAER DATOS DE INSERT INTO
    If InStr(UCase(sLinea), "INSERT INTO") > 0 Then
      If InStr(sLinea, "`" & sTabla & "`") > 0 Then
        If InStr(UCase(sLinea), "VALUES") > 0 Then
          ExtraerDatosInsert(sLinea)
        Endif
      Endif
    Endif
  Next

End

' ============================================
' Función   : ExtraerDatosInsert
' Propósito : Extrae los grupos de valores de un INSERT INTO
' Parámetros: sLinea As String — línea completa del INSERT
' ============================================
Private Sub ExtraerDatosInsert(sLinea As String)

  Dim iPosValues As Integer = InStr(UCase(sLinea), "VALUES")

  If iPosValues = 0 Then Return

  Dim sValores As String = Trim(Mid(sLinea, iPosValues + 6))
  Dim aGrupos As String[] = DividirRegistros(sValores)

  Dim sGrupo As String
  For Each sGrupo In aGrupos
    $aRegistros.Add(ParsearValores(sGrupo))
  Next

End

' ============================================
' Función   : DividirRegistros
' Propósito : Separa los grupos de valores de un INSERT
'             respetando comillas y paréntesis anidados
' Parámetros: sValores As String — parte VALUES del INSERT
' Retorna   : String[] — array con un elemento por registro
' ============================================
Private Function DividirRegistros(sValores As String) As String[]

  Dim aResultado As New String[]
  Dim sRegistro As String = ""
  Dim bDentroComilla As Boolean = False
  Dim iParentesis As Integer = 0
  Dim cAnterior As String = ""
  Dim i As Integer
  Dim c As String

  sValores = Trim(sValores)
  If Right(sValores, 1) = ";" Then sValores = Left(sValores, Len(sValores) - 1)

  For i = 1 To Len(sValores)
    c = Mid(sValores, i, 1)

    If c = "'" And cAnterior <> "\\" Then
      bDentroComilla = Not bDentroComilla
      sRegistro &= c
    Else If c = "(" And Not bDentroComilla Then
      Inc iParentesis
      If iParentesis > 1 Then sRegistro &= c
    Else If c = ")" And Not bDentroComilla Then
      Dec iParentesis
      If iParentesis > 0 Then
        sRegistro &= c
      Else
        If Trim(sRegistro) <> "" Then
          aResultado.Add(sRegistro)
          sRegistro = ""
        Endif
      Endif
    Else If c = "," And Not bDentroComilla And iParentesis = 0 Then
      Continue
    Else
      sRegistro &= c
    Endif

    cAnterior = c
  Next

  If Trim(sRegistro) <> "" Then aResultado.Add(sRegistro)

  Return aResultado

End

' ============================================
' Función   : ParsearValores
' Propósito : Separa los valores individuales de un registro
'             respetando comillas simples
' Parámetros: sRegistro As String — un grupo de valores
' Retorna   : String[] — array con un elemento por valor
' ============================================
Private Function ParsearValores(sRegistro As String) As String[]

  Dim aResultado As New String[]
  Dim sValor As String = ""
  Dim bDentroComilla As Boolean = False
  Dim cAnterior As String = ""
  Dim i As Integer
  Dim c As String

  For i = 1 To Len(sRegistro)
    c = Mid(sRegistro, i, 1)
    If c = "'" And cAnterior <> "\\" Then
      bDentroComilla = Not bDentroComilla
    Else If c = "," And Not bDentroComilla Then
      aResultado.Add(LimpiarValor(sValor))
      sValor = ""
    Else
      sValor &= c
    Endif
    cAnterior = c
  Next

  aResultado.Add(LimpiarValor(sValor))
  Return aResultado

End

' ============================================
' Función   : LimpiarValor
' Propósito : Elimina comillas y decodifica caracteres
'             escapados de un valor SQL
' Parámetros: sValor As String — valor crudo del SQL
' Retorna   : String — valor limpio y legible
' ============================================
Private Function LimpiarValor(sValor As String) As String

  sValor = Trim(sValor)

  If UCase(sValor) = "NULL" Then Return ""

  If Left(sValor, 1) = "'" And Right(sValor, 1) = "'" Then
    sValor = Mid(sValor, 2, Len(sValor) - 2)
  Endif

  sValor = Replace(sValor, "\\'", "'")
  sValor = Replace(sValor, "\\n", "\n")
  sValor = Replace(sValor, "\\t", "\t")
  sValor = Replace(sValor, "\\\\", "\\")

  Return sValor

End

' ============================================
' Función   : btnEliminarBase_Click
' Propósito : Elimina el archivo de respaldo seleccionado
'             tras confirmación del usuario
' ============================================
Public Sub btnEliminarBase_Click()

  ' --- 1. Verificar selección ---
  If Not ListarBases.Current Then
    m_Sonido.sonar("Warning")
    Message.Warning("Debe seleccionar un archivo de respaldo para eliminar.")
    Return
  Endif

  ' --- 2. Confirmar eliminación ---
  m_Sonido.sonar("Question")
  Dim iRespuesta As Integer = Message.Question(
    "¿Está seguro de que desea eliminar el archivo de respaldo?" & Chr(10) & Chr(10) &
    ListarBases.Current.Key & Chr(10) & Chr(10) &
    "Esta acción no se puede deshacer.",
    "Sí", "No")

  If iRespuesta <> 1 Then Return

  ' --- 3. Eliminar y actualizar vista ---
  Dim sRutaRespaldo As String = User.Home &/ ".gbpublisher/respaldo"
  Dim sArchivoSQL As String = sRutaRespaldo &/ ListarBases.Current.Key

  Try Kill sArchivoSQL
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al eliminar el archivo:" & Chr(10) & Error.Text)
    Return
  Endif

  CargarListaRespaldos()
  ListarTablas.Clear()
  ListarContenido.Rows.Count = 0
  ListarContenido.Columns.Count = 0

  m_Sonido.sonar("Info")
  Message.Info("Archivo de respaldo eliminado correctamente.")

End

' ============================================
' SECCIÓN: GESTIÓN DE CREDENCIALES DE API
' Las siguientes funciones gestionan el ABM de API Keys
' en la tabla api_credenciales de MySQL
' ============================================

' ============================================
' Función   : ConfigurarGridView
' Propósito : Establece la estructura del GridView de APIs
' ============================================
Private Sub ConfigurarGridView()

  With gvAPIkeys
    .Header = GridView.Horizontal
    .Grid = True
    .Mode = Select.Single
    .Columns.Count = 6

    .Columns[0].Title = "ID"
    .Columns[0].Width = 40
    .Columns[0].Alignment = Align.Center
    .Columns[1].Title = "Proveedor"
    .Columns[1].Width = 150
    .Columns[2].Title = "Identificador"
    .Columns[2].Width = 150
    .Columns[3].Title = "Región"
    .Columns[3].Width = 150
    .Columns[4].Title = "Activo"
    .Columns[4].Width = 50
    .Columns[4].Alignment = Align.Center
    .Columns[5].Title = "Última modificación"
    .Columns[5].Width = 150

    .Rows.Count = 0
  End With

End

' ============================================
' Función   : CargarCredenciales
' Propósito : Carga todas las credenciales de API en el GridView
' ============================================
Private Sub CargarCredenciales()

  Dim hResult As Result = m_ApiCredenciales.ListarCredenciales(False)

  If hResult = Null Then
    gvAPIkeys.Rows.Count = 0
    Return
  Endif

  gvAPIkeys.Rows.Count = hResult.Count
  If hResult.Count = 0 Then Return

  Dim iRow As Integer = 0
  For Each hResult
    gvAPIkeys[iRow, 0].Text = Str$(hResult!id)
    gvAPIkeys[iRow, 1].Text = hResult!proveedor
    gvAPIkeys[iRow, 2].Text = If(hResult!identificador, hResult!identificador, "")
    gvAPIkeys[iRow, 3].Text = If(hResult!region, hResult!region, "")
    gvAPIkeys[iRow, 4].Text = If(hResult!activo, "Sí", "No")
    gvAPIkeys[iRow, 5].Text = Format$(hResult!date_modif, "dd/mm/yyyy hh:nn")

    ' FILAS INACTIVAS CON FONDO GRIS
    If Not hResult!activo Then
      Dim k As Integer
      For k = 0 To 5
        gvAPIkeys[iRow, k].Background = Color.LightGray
      Next
    Endif

    Inc iRow
  Next

End

' ============================================
' Función   : LimpiarFormulario
' Propósito : Limpia el formulario de API Keys y lo prepara
'             para una nueva entrada
' ============================================
Private Sub LimpiarFormulario()

  $bModoEdicion = False
  ID_apis.Value = 0
  txtProveedor.Text = ""
  txtApiKey.Text = ""
  txtIdentificador.Text = ""
  txtRegion.Text = ""
  txtComentarios.Text = ""
  ckbActivo.Value = True
  btnGuardarAPI.Enabled = True
  btnGuardarCambiosAPI.Enabled = False
  txtProveedor.SetFocus()

End

' ============================================
' Función   : CargarCredencialEnFormulario
' Propósito : Carga los datos de una credencial existente
'             en el formulario para su edición
' Parámetros: iId As Integer — ID de la credencial a cargar
' ============================================
Private Sub CargarCredencialEnFormulario(iId As Integer)

  Dim hResult As Result = m_ApiCredenciales.ObtenerCredencialPorId(iId)

  If hResult = Null Or Not hResult.Available Then
    Message.Error("No se pudo cargar la credencial seleccionada.")
    Return
  Endif

  $bModoEdicion = True
  ID_apis.Value = hResult!id
  txtProveedor.Text = hResult!proveedor
  txtApiKey.Text = ""  ' NO SE MUESTRA LA API KEY POR SEGURIDAD
  txtIdentificador.Text = If(hResult!identificador, hResult!identificador, "")
  txtRegion.Text = If(hResult!region, hResult!region, "")
  txtComentarios.Text = If(hResult!comentarios, hResult!comentarios, "")
  ckbActivo.Value = hResult!activo
  btnGuardarAPI.Enabled = False
  btnGuardarCambiosAPI.Enabled = True

End

' ============================================
' Función   : ValidarFormulario
' Propósito : Verifica que los campos obligatorios del
'             formulario de API estén completos
' Retorna   : Boolean — True si la validación es correcta
' ============================================
Private Function ValidarFormulario() As Boolean

  If Not Trim$(txtProveedor.Text) Then
    Message.Warning("El nombre del proveedor es obligatorio.")
    txtProveedor.SetFocus()
    Return False
  Endif

  If Not $bModoEdicion And Not Trim$(txtApiKey.Text) Then
    Message.Warning("La API Key es obligatoria para nuevas credenciales.")
    txtApiKey.SetFocus()
    Return False
  Endif

  Return True

End

' ============================================
' Función   : btnNuevaAPI_Click
' Propósito : Prepara el formulario para una nueva credencial
' ============================================
Public Sub btnNuevaAPI_Click()

  LimpiarFormulario()

End

' ============================================
' Función   : btnGuardarAPI_Click
' Propósito : Guarda una nueva credencial de API en la BD
' ============================================
Public Sub btnGuardarAPI_Click()

  If Not ValidarFormulario() Then Return

  If m_ApiCredenciales.ExisteProveedor(Trim$(txtProveedor.Text)) Then
    Message.Warning("Ya existe una credencial para el proveedor: " & txtProveedor.Text)
    txtProveedor.SetFocus()
    Return
  Endif

  Dim iId As Integer = m_ApiCredenciales.GuardarNuevaAPI(
    Trim$(txtProveedor.Text), Trim$(txtApiKey.Text),
    Trim$(txtIdentificador.Text), Trim$(txtRegion.Text),
    Trim$(txtComentarios.Text))

  If iId > 0 Then
    Message.Info("Credencial guardada correctamente con ID: " & Str$(iId))
    CargarCredenciales()
    LimpiarFormulario()
  Else
    Message.Error("Error al guardar la credencial.")
  Endif

End

' ============================================
' Función   : btnGuardarCambiosAPI_Click
' Propósito : Actualiza una credencial de API existente
' ============================================
Public Sub btnGuardarCambiosAPI_Click()

  If Not ValidarFormulario() Then Return

  Dim iId As Integer = ID_apis.Value

  If iId <= 0 Then
    Message.Error("No hay una credencial seleccionada para actualizar.")
    Return
  Endif

  If m_ApiCredenciales.ExisteProveedor(Trim$(txtProveedor.Text), iId) Then
    Message.Warning("Ya existe otra credencial con el proveedor: " & txtProveedor.Text)
    txtProveedor.SetFocus()
    Return
  Endif

  If Not ckbActivo.Value Then
    If Message.Question("¿Está seguro de desactivar esta credencial?" & Chr(10) & Chr(10) &
        "Los servicios que la utilicen dejarán de funcionar.", "Sí", "No") = 2 Then
      Return
    Endif
  Endif

  If m_ApiCredenciales.ActualizarAPI(iId, Trim$(txtProveedor.Text), Trim$(txtApiKey.Text),
      Trim$(txtIdentificador.Text), Trim$(txtRegion.Text),
      Trim$(txtComentarios.Text), ckbActivo.Value) Then
    Message.Info("Credencial actualizada correctamente.")
    CargarCredenciales()
    LimpiarFormulario()
  Else
    Message.Error("Error al actualizar la credencial.")
  Endif

End

' ============================================
' Función   : gvAPIkeys_Click
' Propósito : Carga la credencial seleccionada en el formulario
' ============================================
Public Sub gvAPIkeys_Click()

  Dim iRow As Integer = gvAPIkeys.Row

  If iRow < 0 Or iRow >= gvAPIkeys.Rows.Count Then Return

  Dim iId As Integer = Val(gvAPIkeys[iRow, 0].Text)
  If iId > 0 Then CargarCredencialEnFormulario(iId)

End

' ============================================
' Función   : gvAPIkeys_DblClick
' Propósito : Doble clic carga la credencial (igual que clic)
' ============================================
Public Sub gvAPIkeys_DblClick()

  gvAPIkeys_Click()

End

' ============================================
' Función   : txtApiKey_Enter
' Propósito : Muestra tooltip contextual al entrar en el
'             campo de API Key según el modo activo
' ============================================
Public Sub txtApiKey_Enter()

  If $bModoEdicion Then
    txtApiKey.ToolTip = "Dejar vacío para mantener la API Key actual."
  Else
    txtApiKey.ToolTip = "Ingrese la API Key del proveedor."
  Endif

End

' ════════════════════════════════════════════════════════════════════════════
' Función   : ConfigurarGridViewColecciones
' Propósito : Define columnas y propiedades del GridView de colecciones.
'             Solo nombre + indicador de estado (el id queda implícito en
'             $aIdsColecciones, no es información útil al editor).
' ════════════════════════════════════════════════════════════════════════════
Private Sub ConfigurarGridViewColecciones()

  With gvColecciones
    .Header = GridView.Horizontal
    .Columns.Count = 2
    .Columns[0].Title = "Nombre"
    .Columns[0].Width = 380
    .Columns[1].Title = "Estado"
    .Columns[1].Width = 50
    .Rows.Count = 0
  End With

End

' ════════════════════════════════════════════════════════════════════════════
' Función   : CargarColecciones
' Propósito : Lee todas las colecciones de BD (activas e inactivas), pinta
'             el GridView con color gris en las inactivas, resetea editores
'             y listbox de series, y deshabilita botones contextuales.
' ════════════════════════════════════════════════════════════════════════════
Private Sub CargarColecciones()

  Dim $result As Result
  Dim sQuery As String
  Dim iRow As Integer
  Dim bActiva As Boolean

  ' --- 0. GUARD: CONEXIÓN MYSQL DEBE ESTAR ABIERTA ---
  If Not hConnServidor Or Not hConnServidor.Opened Then Return

  ' --- 1. RESET ARRAYS PARALELOS ---
  $aIdsColecciones.Clear()
  $aColeccionesActivas.Clear()

  ' --- 2. QUERY ORDENADO POR NOMBRE ---
  sQuery = "SELECT id_coleccion, nombre, activa FROM colecciones ORDER BY nombre"

  Try $result = hConnServidor.Exec(sQuery)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al cargar colecciones:" & Chr(10) & Error.Text)
    Return
  Endif

  ' --- 3. PRE-DIMENSIONAR EL GRIDVIEW ---
  If $result.Available Then
    gvColecciones.Rows.Count = $result.Count
  Else
    gvColecciones.Rows.Count = 0
  Endif

  ' --- 4. POBLAR ARRAYS PARALELOS Y CELDAS ---
  iRow = 0
  If $result.Available Then
    For Each $result
      $aIdsColecciones.Add($result!id_coleccion)
      ' RC-GM-01: TINYINT(1) DEVUELVE Boolean DIRECTAMENTE
      bActiva = $result!activa
      $aColeccionesActivas.Add(bActiva)

      gvColecciones[iRow, 0].Text = $result!nombre
      gvColecciones[iRow, 1].Text = If(bActiva, "Activa", "Inactiva")

      ' --- COLOR SEGÚN ESTADO: GRIS SI INACTIVA, DEFAULT SI ACTIVA ---
      ' EL RESET EXPLÍCITO A Color.Default ES OBLIGATORIO: EL GRIDVIEW NO
      ' LIMPIA EL FOREGROUND AL REDIMENSIONAR FILAS. SIN LA RAMA ELSE, UNA
      ' FILA QUE ESTUVO GRIS SE QUEDA GRIS AL REACTIVARSE.
      If bActiva Then
        gvColecciones[iRow, 0].Background = Color.Default
        gvColecciones[iRow, 1].Background = Color.Default
      Else
        gvColecciones[iRow, 0].Background = Color.Background
        gvColecciones[iRow, 1].Background = Color.Background
      Endif

      Inc iRow
    Next
  Endif

  ' --- 5. LIMPIAR ESTADO DE EDITORES Y SERIE ---
  LimpiarEditorColeccion()
  LimpiarEditorSerie()
  gvSeries.Rows.Count = 0
  $aIdsSeries.Clear()
  $iColeccionActual = 0
  $iSerieActual = 0
  HabilitarBotonesColeccion(False)
  HabilitarBotonesSerie(False, False)

End

' ════════════════════════════════════════════════════════════════════════════
' Función   : CargarSeriesDeColeccion
' Propósito : Lee las series de la colección indicada y las muestra en
'             gvSeries. Si la colección está inactiva, todas las series se
'             muestran en gris (heredan estado por cascada).
' Parámetros: iIdColeccion As Integer — id de la colección madre
'             bColeccionActiva As Boolean — estado de la colección madre
' ════════════════════════════════════════════════════════════════════════════
Private Sub CargarSeriesDeColeccion(iIdColeccion As Integer, bColeccionActiva As Boolean)

  Dim $result As Result
  Dim sQuery As String
  Dim iRow As Integer

  ' --- 1. RESET GRIDVIEW Y ARRAY PARALELO ---
  ' PONER LAS FILAS EN 0 GARANTIZA CELDAS NUEVAS SIN FORMATO HEREDADO
  gvSeries.Rows.Count = 0
  $aIdsSeries.Clear()

  ' --- 2. QUERY ORDENADA POR NOMBRE ---
  sQuery = "SELECT id_serie, nombre FROM series WHERE id_coleccion = &1 ORDER BY nombre"

  Try $result = hConnServidor.Exec(sQuery, iIdColeccion)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al cargar series:" & Chr(10) & Error.Text)
    Return
  Endif

  If Not $result.Available Then Return

  ' --- 3. PRE-DIMENSIONAR EL GRIDVIEW ---
  gvSeries.Rows.Count = $result.Count

  ' --- 4. POBLAR CELDAS Y COLOREAR SI LA COLECCIÓN ESTÁ INACTIVA ---
  iRow = 0
  For Each $result
    gvSeries[iRow, 0].Text = $result!nombre
    $aIdsSeries.Add($result!id_serie)

    ' COLOR POR CASCADA: GRIS SI LA COLECCIÓN MADRE ESTÁ INACTIVA, DEFAULT SI
    ' ACTIVA. EL ELSE ES OBLIGATORIO POR LA MISMA RAZÓN QUE EN COLECCIONES:
    ' EL GRIDVIEW NO RESETEA EL FOREGROUND AL REDIMENSIONAR FILAS.
    If bColeccionActiva Then
      gvSeries[iRow, 0].Background = Color.Default
    Else
      gvSeries[iRow, 0].Background = Color.Background
    Endif

    Inc iRow
  Next

End

' ════════════════════════════════════════════════════════════════════════════
' Función   : CargarColeccionEnEditor
' Propósito : Lee el registro completo de una colección y vuelca todos
'             los campos al editor del tabstrip 4.
' Parámetros: iIdColeccion As Integer — id de la colección a cargar
' ════════════════════════════════════════════════════════════════════════════
Private Sub CargarColeccionEnEditor(iIdColeccion As Integer)

  Dim $result As Result
  Dim sQuery As String

  ' --- 1. QUERY COMPLETA ---
  sQuery = "SELECT * FROM colecciones WHERE id_coleccion = &1"

  Try $result = hConnServidor.Exec(sQuery, iIdColeccion)
  If Error Or If Not $result.Available Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo cargar la colección.")
    Return
  Endif

  ' --- 2. VOLCAR CAMPOS AL EDITOR ---
  idColeccion.Value = $result!id_coleccion
  nombreColeccion.Text = If(IsNull($result!nombre), "", $result!nombre)
  nombreAbreviadoColeccion.Text = If(IsNull($result!nombre_abreviado), "", $result!nombre_abreviado)
  issnColeccion.Text = If(IsNull($result!issn), "", $result!issn)
  doiPrefixColeccion.Text = If(IsNull($result!doi_prefix), "", $result!doi_prefix)
  editorialColeccion.Text = If(IsNull($result!editorial), "", $result!editorial)
  directorColeccion.Text = If(IsNull($result!director_coleccion), "", $result!director_coleccion)
  emailContactoColeccion.Text = If(IsNull($result!email_contacto), "", $result!email_contacto)
  descripcionColeccion.Text = If(IsNull($result!descripcion), "", $result!descripcion)
  areaConocimientoColeccion.Text = If(IsNull($result!area_conocimiento), "", $result!area_conocimiento)
  disciplinaColeccion.Text = If(IsNull($result!disciplina), "", $result!disciplina)
  anoInicioColeccion.Text = If(IsNull($result!ano_inicio), "", CStr($result!ano_inicio))
  anoFinColeccion.Text = If(IsNull($result!ano_fin), "", CStr($result!ano_fin))

  ' RC-GM-01: TINYINT(1) ES Boolean
  activaColeccion.Value = $result!activa
  $bActivaColeccionOriginal = $result!activa

  urlColeccion.Text = If(IsNull($result!url_coleccion), "", $result!url_coleccion)
  urlLogoColeccion.Text = If(IsNull($result!url_logo), "", $result!url_logo)
  notasInternasColeccion.Text = If(IsNull($result!notas_internas), "", $result!notas_internas)

  ' --- 3. CAMPOS DE AUDITORÍA (READONLY) ---
  If $result!fecha_creacion Then fechaCreacionColeccion.Value = $result!fecha_creacion Else fechaCreacionColeccion.Value = Null
  If $result!fecha_actualizacion Then fechaActualizacionColeccion.Value = $result!fecha_actualizacion Else fechaActualizacionColeccion.Value = Null
  usuarioCreacionColeccion.Text = If(IsNull($result!usuario_creacion), "", $result!usuario_creacion)

End

' ════════════════════════════════════════════════════════════════════════════
' Función   : CargarSerieEnEditor
' Propósito : Lee el registro completo de una serie y vuelca los campos
'             al editor.
' Parámetros: iIdSerie As Integer — id de la serie a cargar
' ════════════════════════════════════════════════════════════════════════════
Private Sub CargarSerieEnEditor(iIdSerie As Integer)

  Dim $result As Result
  Dim sQuery As String

  sQuery = "SELECT * FROM series WHERE id_serie = &1"

  Try $result = hConnServidor.Exec(sQuery, iIdSerie)
  If Error Or If Not $result.Available Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo cargar la serie.")
    Return
  Endif

  idSerie.Value = $result!id_serie
  nombreSerie.Text = If(IsNull($result!nombre), "", $result!nombre)
  nombreAbreviadoSerie.Text = If(IsNull($result!nombre_abreviado), "", $result!nombre_abreviado)
  issnSerie.Text = If(IsNull($result!issn), "", $result!issn)
  coordinadorSerie.Text = If(IsNull($result!coordinador_serie), "", $result!coordinador_serie)
  descripcionSerie.Text = If(IsNull($result!descripcion), "", $result!descripcion)
  anoInicioSerie.Text = If(IsNull($result!ano_inicio), "", CStr($result!ano_inicio))
  anoFinSerie.Text = If(IsNull($result!ano_fin), "", CStr($result!ano_fin))
  notasInternasSerie.Text = If(IsNull($result!notas_internas), "", $result!notas_internas)

  ' --- AUDITORÍA ---
  If $result!fecha_creacion Then fechaCreacionSerie.Value = $result!fecha_creacion Else fechaCreacionSerie.Value = Null
  If $result!fecha_actualizacion Then fechaActualizacionSerie.Value = $result!fecha_actualizacion Else fechaActualizacionSerie.Value = Null
  usuarioCreacionSerie.Text = If(IsNull($result!usuario_creacion), "", $result!usuario_creacion)

End

' ════════════════════════════════════════════════════════════════════════════
' Función   : LimpiarEditorColeccion
' Propósito : Limpia todos los campos del editor de colección.
' ════════════════════════════════════════════════════════════════════════════
Private Sub LimpiarEditorColeccion()

  idColeccion.Value = 0
  nombreColeccion.Text = ""
  nombreAbreviadoColeccion.Text = ""
  issnColeccion.Text = ""
  doiPrefixColeccion.Text = ""
  editorialColeccion.Text = ""
  directorColeccion.Text = ""
  emailContactoColeccion.Text = ""
  descripcionColeccion.Text = ""
  areaConocimientoColeccion.Text = ""
  disciplinaColeccion.Text = ""
  anoInicioColeccion.Text = ""
  anoFinColeccion.Text = ""
  activaColeccion.Value = False
  $bActivaColeccionOriginal = False
  urlColeccion.Text = ""
  urlLogoColeccion.Text = ""
  notasInternasColeccion.Text = ""
  fechaCreacionColeccion.Value = Null
  fechaActualizacionColeccion.Value = Null
  usuarioCreacionColeccion.Text = ""

End

' ════════════════════════════════════════════════════════════════════════════
' Función   : LimpiarEditorSerie
' Propósito : Limpia todos los campos del editor de serie.
' ════════════════════════════════════════════════════════════════════════════
Private Sub LimpiarEditorSerie()

  idSerie.Value = 0
  nombreSerie.Text = ""
  nombreAbreviadoSerie.Text = ""
  issnSerie.Text = ""
  coordinadorSerie.Text = ""
  descripcionSerie.Text = ""
  anoInicioSerie.Text = ""
  anoFinSerie.Text = ""
  notasInternasSerie.Text = ""
  fechaCreacionSerie.Value = Null
  fechaActualizacionSerie.Value = Null
  usuarioCreacionSerie.Text = ""

End

' ════════════════════════════════════════════════════════════════════════════
' Función   : HabilitarBotonesColeccion
' Propósito : Habilita o deshabilita el botón Guardar Cambios de colección.
'             También gestiona los botones del bloque de serie en cascada.
' Parámetros: bHabilitar As Boolean — True = colección seleccionada
' ════════════════════════════════════════════════════════════════════════════
Private Sub HabilitarBotonesColeccion(bHabilitar As Boolean)

  btnGuardarCambiosColeccion.Visible = bHabilitar

End

' ════════════════════════════════════════════════════════════════════════════
' Función   : HabilitarBotonesSerie
' Propósito : Habilita o deshabilita los botones de serie según haya
'             colección activa y/o serie seleccionada.
' Parámetros: bNueva As Boolean    — True habilita btnNuevaSerie
'             bGuardar As Boolean  — True habilita btnGuardarCambiosSerie
' ════════════════════════════════════════════════════════════════════════════
Private Sub HabilitarBotonesSerie(bNueva As Boolean, bGuardar As Boolean)

  btnNuevaSerie.Enabled = bNueva
  btnGuardarCambiosSerie.Visible = bGuardar

End

' ════════════════════════════════════════════════════════════════════════════
' Función   : gvColecciones_Click
' Propósito : Al seleccionar una colección, carga su editor y muestra sus
'             series en lbSeries. Habilita btnNuevaSerie SOLO si la
'             colección está activa.
' ════════════════════════════════════════════════════════════════════════════
Public Sub gvColecciones_Click()

  Dim iRow As Integer
  Dim iIdColeccion As Integer
  Dim bColActiva As Boolean

  ' --- 1. VALIDAR FILA ---
  iRow = gvColecciones.Row
  If iRow < 0 Or If iRow >= $aIdsColecciones.Count Then Return

  ' --- 2. OBTENER ID Y ESTADO DE LA COLECCIÓN ---
  iIdColeccion = $aIdsColecciones[iRow]
  bColActiva = $aColeccionesActivas[iRow]
  $iColeccionActual = iIdColeccion

  ' --- 3. CARGAR EDITOR DE COLECCIÓN ---
  CargarColeccionEnEditor(iIdColeccion)

  ' --- 4. CARGAR SERIES EN LBSERIES (CON COLOR HEREDADO) ---
  CargarSeriesDeColeccion(iIdColeccion, bColActiva)
  $iSerieActual = 0
  LimpiarEditorSerie()

  ' --- 5. ESTADO DE BOTONES ---
  HabilitarBotonesColeccion(True)
  ' btnNuevaSerie SOLO SI LA COLECCIÓN ESTÁ ACTIVA
  ' btnGuardarCambiosSerie DESHABILITADO HASTA QUE SE ELIJA UNA SERIE
  HabilitarBotonesSerie(bColActiva, False)

End

' ════════════════════════════════════════════════════════════════════════════
' Función   : gvSeries_Click
' Propósito : Al seleccionar una serie del grid, carga su editor.
' ════════════════════════════════════════════════════════════════════════════
Public Sub gvSeries_Click()

  Dim iRow As Integer
  Dim iIdSerie As Integer

  ' --- 1. VALIDAR FILA ---
  iRow = gvSeries.Row
  If iRow < 0 Or If iRow >= $aIdsSeries.Count Then Return

  ' --- 2. OBTENER ID Y CARGAR EDITOR ---
  iIdSerie = $aIdsSeries[iRow]
  $iSerieActual = iIdSerie
  CargarSerieEnEditor(iIdSerie)

  ' --- 3. HABILITAR BOTÓN GUARDAR DE SERIE ---
  ' (btnNuevaSerie SIGUE SIENDO CONDICIONAL AL ESTADO DE LA COLECCIÓN)
  btnGuardarCambiosSerie.Visible = True

End

' ════════════════════════════════════════════════════════════════════════════
' Función   : btnNuevaColeccion_Click
' Propósito : INSERT mínimo de colección nueva con valores por defecto.
'             Refresca el grid y autoselecciona el nuevo registro.
' ════════════════════════════════════════════════════════════════════════════
Public Sub btnNuevaColeccion_Click()

  Dim iNuevoId As Integer
  Dim iRow As Integer

  ' --- 1. INSERT MÍNIMO ---
  Try hConnServidor.Exec(
    "INSERT INTO colecciones (nombre, activa, usuario_creacion) " &
    "VALUES (&1, 1, &2)",
    "(Nueva colección)", sUsuarioActual)

  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al crear colección:" & Chr(10) & Error.Text)
    Return
  Endif

  iNuevoId = hConnServidor.LastInsertId

  ' --- 2. REFRESH ---
  CargarColecciones()

  ' --- 3. AUTOSELECT DEL NUEVO REGISTRO ---
  For iRow = 0 To $aIdsColecciones.Count - 1
    If $aIdsColecciones[iRow] = iNuevoId Then
      gvColecciones.Row = iRow
      gvColecciones_Click()
      Break
    Endif
  Next

  m_Sonido.sonar("Info")
  nombreColeccion.SetFocus()
  nombreColeccion.SelectAll()

End

' ════════════════════════════════════════════════════════════════════════════
' Función   : btnNuevaSerie_Click
' Propósito : INSERT mínimo de serie nueva en la colección actualmente
'             seleccionada. La colección debe estar activa (validado por
'             el botón deshabilitado, pero doble check por seguridad).
' ════════════════════════════════════════════════════════════════════════════
Public Sub btnNuevaSerie_Click()

  Dim iNuevoId As Integer
  Dim iIndex As Integer
  Dim iRow As Integer

  ' --- 1. VALIDAR COLECCIÓN ACTIVA ---
  If $iColeccionActual <= 0 Then
    m_Sonido.sonar("Warning")
    Message.Warning("Seleccione primero una colección.")
    Return
  Endif

  iRow = gvColecciones.Row
  If iRow < 0 Or If Not $aColeccionesActivas[iRow] Then
    m_Sonido.sonar("Warning")
    Message.Warning("No se pueden crear series en una colección inactiva.")
    Return
  Endif

  ' --- 2. INSERT MÍNIMO ---
  Try hConnServidor.Exec(
    "INSERT INTO series (id_coleccion, nombre, activa, usuario_creacion) " &
    "VALUES (&1, &2, 1, &3)",
    $iColeccionActual, "(Nueva serie)", sUsuarioActual)

  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al crear serie:" & Chr(10) & Error.Text)
    Return
  Endif

  iNuevoId = hConnServidor.LastInsertId

  ' --- 3. REFRESH SERIES (COLECCIÓN ACTIVA) ---
  CargarSeriesDeColeccion($iColeccionActual, True)

  ' --- 4. AUTOSELECT ---
  For iIndex = 0 To $aIdsSeries.Count - 1
    If $aIdsSeries[iIndex] = iNuevoId Then
      gvSeries.Row = iIndex
      gvSeries_Click()
      Break
    Endif
  Next

  m_Sonido.sonar("Info")
  nombreSerie.SetFocus()
  nombreSerie.SelectAll()

End

' ════════════════════════════════════════════════════════════════════════════
' Función   : btnGuardarCambiosColeccion_Click
' Propósito : UPDATE de la colección usando patrón Edit+Update. Si `activa`
'             cambió respecto del estado original, aplica cascada a `series`
'             dentro de una transacción atómica.
' ════════════════════════════════════════════════════════════════════════════
Public Sub btnGuardarCambiosColeccion_Click()

  Dim rColec As Result
  Dim bActivaNueva As Boolean
  Dim bCambioCascada As Boolean
  Dim iRowGuardado As Integer

  ' --- 1. VALIDAR COLECCIÓN ACTIVA ---
  If $iColeccionActual <= 0 Then
    m_Sonido.sonar("Warning")
    Message.Warning("No hay colección seleccionada.")
    Return
  Endif

  ' --- 2. VALIDACIONES DE CAMPO ---
  If Trim(nombreColeccion.Text) = "" Then
    m_Sonido.sonar("Warning")
    Message.Warning("El nombre de la colección no puede quedar vacío.")
    nombreColeccion.SetFocus()
    Return
  Endif

  ' --- 3. DETERMINAR SI HAY CAMBIO DE ESTADO (PARA CASCADA) ---
  bActivaNueva = activaColeccion.Value
  bCambioCascada = (bActivaNueva <> $bActivaColeccionOriginal)

  iRowGuardado = gvColecciones.Row

  ' --- 4. EJECUTAR TRANSACCIÓN ---
  Try hConnServidor.Begin()
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al iniciar transacción:" & Chr(10) & Error.Text)
    Return
  Endif

  ' --- 4.1 EDIT + UPDATE COLECCIÓN ---
  Try rColec = hConnServidor.Edit("colecciones", "id_coleccion = &1", $iColeccionActual)
  If Error Then
    hConnServidor.Rollback()
    m_Sonido.sonar("Error")
    Message.Error("Error al abrir la colección para edición:" & Chr(10) & Error.Text)
    Return
  Endif

  With rColec
    !nombre = Trim(nombreColeccion.Text)
    !nombre_abreviado = If(Trim(nombreAbreviadoColeccion.Text) = "", Null, Trim(nombreAbreviadoColeccion.Text))
    !issn = If(Trim(issnColeccion.Text) = "", Null, Trim(issnColeccion.Text))
    !doi_prefix = If(Trim(doiPrefixColeccion.Text) = "", Null, Trim(doiPrefixColeccion.Text))
    !editorial = If(Trim(editorialColeccion.Text) = "", Null, Trim(editorialColeccion.Text))
    !director_coleccion = If(Trim(directorColeccion.Text) = "", Null, Trim(directorColeccion.Text))
    !email_contacto = If(Trim(emailContactoColeccion.Text) = "", Null, Trim(emailContactoColeccion.Text))
    !descripcion = If(Trim(descripcionColeccion.Text) = "", Null, descripcionColeccion.Text)
    !area_conocimiento = If(Trim(areaConocimientoColeccion.Text) = "", Null, Trim(areaConocimientoColeccion.Text))
    !disciplina = If(Trim(disciplinaColeccion.Text) = "", Null, Trim(disciplinaColeccion.Text))

    ' AÑOS (YEAR EN BD): NULL SI VACÍO
    If Trim(anoInicioColeccion.Text) = "" Then
      !ano_inicio = Null
    Else
      !ano_inicio = Val(Trim(anoInicioColeccion.Text))
    Endif

    If Trim(anoFinColeccion.Text) = "" Then
      !ano_fin = Null
    Else
      !ano_fin = Val(Trim(anoFinColeccion.Text))
    Endif

    !activa = If(bActivaNueva, 1, 0)
    !url_coleccion = If(Trim(urlColeccion.Text) = "", Null, Trim(urlColeccion.Text))
    !url_logo = If(Trim(urlLogoColeccion.Text) = "", Null, Trim(urlLogoColeccion.Text))
    !notas_internas = If(Trim(notasInternasColeccion.Text) = "", Null, notasInternasColeccion.Text)

    Try .Update()
    If Error Then
      hConnServidor.Rollback()
      m_Sonido.sonar("Error")
      Message.Error("Error al guardar colección:" & Chr(10) & Error.Text)
      Return
    Endif
  End With

  ' --- 4.2 CASCADA A SERIES SI EL ESTADO CAMBIÓ ---
  If bCambioCascada Then
    Try hConnServidor.Exec(
      "UPDATE series SET activa = &1 WHERE id_coleccion = &2",
      If(bActivaNueva, 1, 0), $iColeccionActual)

      If Error Then
        hConnServidor.Rollback()
        m_Sonido.sonar("Error")
        Message.Error("Error al actualizar series en cascada:" & Chr(10) & Error.Text)
        Return
      Endif
    Endif

    ' --- 4.3 COMMIT ---
    Try hConnServidor.Commit()
    If Error Then
      hConnServidor.Rollback()
      m_Sonido.sonar("Error")
      Message.Error("Error al confirmar cambios:" & Chr(10) & Error.Text)
      Return
    Endif

    ' --- 5. REFRESH MANTENIENDO SELECCIÓN ---
    m_Sonido.sonar("Info")
    CargarColecciones()

    If iRowGuardado >= 0 And If iRowGuardado < $aIdsColecciones.Count Then
      gvColecciones.Row = iRowGuardado
      gvColecciones_Click()
    Endif

    ' --- 6. MENSAJE FINAL CON CONTEXTO ---
    If bCambioCascada Then
      If bActivaNueva Then
        Message.Info("Colección guardada y reactivada (con sus series).")
      Else
        Message.Info("Colección guardada y desactivada (con sus series).")
      Endif
    Endif

End

' ════════════════════════════════════════════════════════════════════════════
' Función   : btnGuardarCambiosSerie_Click
' Propósito : UPDATE de la serie usando patrón Edit+Update. Sin cascadas.
' ════════════════════════════════════════════════════════════════════════════
Public Sub btnGuardarCambiosSerie_Click()

  Dim rSerie As Result
  Dim iIndexGuardado As Integer
  Dim iRow As Integer
  Dim bColActiva As Boolean

  ' --- 1. VALIDAR SERIE ACTIVA ---
  If $iSerieActual <= 0 Then
    m_Sonido.sonar("Warning")
    Message.Warning("No hay serie seleccionada.")
    Return
  Endif

  ' --- 2. VALIDACIONES DE CAMPO ---
  If Trim(nombreSerie.Text) = "" Then
    m_Sonido.sonar("Warning")
    Message.Warning("El nombre de la serie no puede quedar vacío.")
    nombreSerie.SetFocus()
    Return
  Endif

  iIndexGuardado = gvSeries.Row

  ' --- 3. EDIT + UPDATE ---
  Try rSerie = hConnServidor.Edit("series", "id_serie = &1", $iSerieActual)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al abrir la serie para edición:" & Chr(10) & Error.Text)
    Return
  Endif

  With rSerie
    !nombre = Trim(nombreSerie.Text)
    !nombre_abreviado = If(Trim(nombreAbreviadoSerie.Text) = "", Null, Trim(nombreAbreviadoSerie.Text))
    !issn = If(Trim(issnSerie.Text) = "", Null, Trim(issnSerie.Text))
    !coordinador_serie = If(Trim(coordinadorSerie.Text) = "", Null, Trim(coordinadorSerie.Text))
    !descripcion = If(Trim(descripcionSerie.Text) = "", Null, descripcionSerie.Text)

    If Trim(anoInicioSerie.Text) = "" Then
      !ano_inicio = Null
    Else
      !ano_inicio = Val(Trim(anoInicioSerie.Text))
    Endif

    If Trim(anoFinSerie.Text) = "" Then
      !ano_fin = Null
    Else
      !ano_fin = Val(Trim(anoFinSerie.Text))
    Endif

    !notas_internas = If(Trim(notasInternasSerie.Text) = "", Null, notasInternasSerie.Text)

    Try .Update()
    If Error Then
      m_Sonido.sonar("Error")
      Message.Error("Error al guardar serie:" & Chr(10) & Error.Text)
      Return
    Endif
  End With

  ' --- 4. REFRESH MANTENIENDO SELECCIÓN ---
  m_Sonido.sonar("Info")

  iRow = gvColecciones.Row
  If iRow >= 0 And If iRow < $aColeccionesActivas.Count Then
    bColActiva = $aColeccionesActivas[iRow]
  Else
    bColActiva = True
  Endif

  CargarSeriesDeColeccion($iColeccionActual, bColActiva)

  If iIndexGuardado >= 0 And If iIndexGuardado < gvSeries.Rows.Count Then
    gvSeries.Row = iIndexGuardado
    gvSeries_Click()
  Endif

End

' ============================================
' Función   : btnGuardarUsuario_Click
' Propósito : Inserta un nuevo usuario en la tabla MySQL
'             con los datos ingresados en el formulario
' ============================================
Public Sub btnGuardarUsuario_Click()

  ' --- 1. Verificar conexión activa ---
  If Not hConnServidor Or Not hConnServidor.Opened Then
    m_Sonido.sonar("Warning")
    Message.Warning("Debe validarse primero como administrador.")
    Return
  Endif

  ' --- 2. Obtener y validar datos ---
  Dim sUsuario As String = Trim(txtUsuario.Text)
  Dim sClave As String = Trim(txtClaveUsuario.Text)
  Dim sEmail As String = Trim(txtEmailUsuario.Text)
  Dim bActivo As Boolean = RadioButtonSi.Value
  Dim sHash As String

  If Not sUsuario Then
    m_Sonido.sonar("Warning")
    Message.Warning("Debe ingresar un nombre de usuario.")
    txtUsuario.SetFocus()
    Return
  Endif

  ' VALIDACIÓN ESTRICTA DEL PATRÓN abcd1234 ANTES DE TOCAR LA BD
  If Not ValidarPatronUsuario(sUsuario) Then
    m_Sonido.sonar("Warning")
    Message.Warning("El nombre de usuario debe ser 4 letras minúsculas seguidas de 4 números, sin mezclar (ej.: abcd1234).")
    txtUsuario.SetFocus()
    Return
  Endif

  If Not sClave Or Len(sClave) < 8 Then
    m_Sonido.sonar("Warning")
    Message.Warning("La contraseña debe tener al menos 8 caracteres, una mayúscula y un número.")
    txtClaveUsuario.SetFocus()
    Return
  Endif

  If Not sEmail Then
    m_Sonido.sonar("Warning")
    Message.Warning("El email es obligatorio.")
    txtEmailUsuario.SetFocus()
    Return
  Endif

  ' --- 3. Insertar usuario ---
  sHash = Hash.SHA256(sClave)
  hConnServidor.Exec("INSERT INTO usuarios (usuario, clave, email, activo, metodo, fecha_creacion) " &
    "VALUES ('" & sUsuario & "', '" & sHash & "', '" & sEmail & "', " &
    If(bActivo, "TRUE", "FALSE") & ", 'local', NOW());")

    m_Sonido.sonar("Info")
    Message.Info("Usuario <b>'" & sUsuario & "'</b> creado exitosamente.")

    ' --- 4. Restaurar estado del formulario ---
    LimpiarControlesUsuario()
    btnCrearUsuario.Visible = True
    btnGuardarUsuario.Visible = False
    btnGuardarCambiosUsuario.Visible = False
    CargarUsuariosDelServidor()

  Catch
    m_Sonido.sonar("Error")
    Message.Error("Error creando usuario: " & Error.Text)

End

' ============================================
' Función   : btnGuardarCambiosUsuario_Click
' Propósito : Actualiza los datos de un usuario MySQL
'             existente, incluyendo el estado en_linea
'             para resolver bloqueos por corte de energía
'             o cuelgue de la aplicación
' ============================================
Public Sub btnGuardarCambiosUsuario_Click()

  ' --- 1. Verificar selección y conexión ---
  If TableViewUsuarios.Row < 0 Then
    m_Sonido.sonar("Warning")
    Message.Warning("Debe seleccionar un usuario de la tabla para modificar.")
    Return
  Endif

  If Not hConnServidor Or Not hConnServidor.Opened Then
    m_Sonido.sonar("Warning")
    Message.Warning("No hay conexión al servidor.")
    Return
  Endif

  ' --- 2. Obtener datos del formulario ---
  Dim iID As Integer = Val(TableViewUsuarios[TableViewUsuarios.Row, 0].Text)
  Dim sNuevoUsuario As String = Trim(txtUsuario.Text)
  Dim sNuevaClave As String = Trim(txtClaveUsuario.Text)
  Dim sNuevoEmail As String = Trim(txtEmailUsuario.Text)
  Dim bActivo As Boolean = RadioButtonSi.Value
  Dim sHash As String

  ' --- 3. Validaciones ---
  If Not sNuevoUsuario Then
    m_Sonido.sonar("Warning")
    Message.Warning("El nombre de usuario no puede estar vacío.")
    txtUsuario.SetFocus()
    Return
  Endif

  ' VALIDACIÓN ESTRICTA DEL PATRÓN abcd1234 ANTES DE TOCAR LA BD
  If Not ValidarPatronUsuario(sNuevoUsuario) Then
    m_Sonido.sonar("Warning")
    Message.Warning("El nombre de usuario debe ser 4 letras minúsculas seguidas de 4 números, sin mezclar (ej.: abcd1234).")
    txtUsuario.SetFocus()
    Return
  Endif

  If Not sNuevoEmail Then
    m_Sonido.sonar("Warning")
    Message.Warning("El email es obligatorio.")
    txtEmailUsuario.SetFocus()
    Return
  Endif

  ' --- 4. Actualizar con o sin cambio de contraseña ---
  ' EN_LINEA SE INCLUYE SIEMPRE PARA PERMITIR LIBERAR USUARIOS BLOQUEADOS
  If sNuevaClave And Len(sNuevaClave) > 0 Then
    If Len(sNuevaClave) < 8 Then
      m_Sonido.sonar("Warning")
      Message.Warning("La contraseña debe tener al menos 8 caracteres.")
      txtClaveUsuario.SetFocus()
      Return
    Endif
    sHash = Hash.SHA256(sNuevaClave)
    hConnServidor.Exec("UPDATE usuarios SET usuario = '" & sNuevoUsuario &
      "', clave = '" & sHash &
      "', email = '" & sNuevoEmail &
      "', activo = " & If(bActivo, "TRUE", "FALSE") &
      ", en_linea = " & If(chkEnLinea.Value, "1", "0") &
      " WHERE id = " & iID & ";")
  Else
    hConnServidor.Exec("UPDATE usuarios SET usuario = '" & sNuevoUsuario &
      "', email = '" & sNuevoEmail &
      "', activo = " & If(bActivo, "TRUE", "FALSE") &
      ", en_linea = " & If(chkEnLinea.Value, "1", "0") &
      " WHERE id = " & iID & ";")
  Endif

  m_Sonido.sonar("Info")
  Message.Info("Cambios guardados correctamente.")

  ' --- 5. Restaurar estado del formulario ---
  btnCrearUsuario.Visible = True
  btnGuardarUsuario.Visible = False
  btnGuardarCambiosUsuario.Visible = False
  LimpiarControlesUsuario()
  CargarUsuariosDelServidor()

Catch
  m_Sonido.sonar("Error")
  Message.Error("Error guardando cambios: " & Error.Text)

End

' ============================================
' Función   : txtUsuario_KeyPress
' Propósito : Filtra caracteres permitidos y fuerza el nombre
'             al patrón posicional abcd1234
' ============================================
Public Sub txtUsuario_KeyPress()

  Dim iPos As Integer

  ' --- 1. PERMITIR TECLAS DE CONTROL ---
  If Key.Code = Key.BackSpace Or Key.Code = Key.Delete Or
      Key.Code = Key.Left Or Key.Code = Key.Right Or
      Key.Code = Key.Tab Or Key.Code = Key.Enter Or
      Key.Code = Key.Home Or Key.Code = Key.End Then
    Return
  Endif

  ' --- 2. VALIDAR LONGITUD MÁXIMA (8 CARACTERES: 4 LETRAS + 4 DÍGITOS) ---
  If String.Len(txtUsuario.Text) = 8 Then
    m_Sonido.sonar("Warning")
    Message.Warning("El nombre de usuario debe tener exactamente 8 caracteres: 4 letras minúsculas seguidas de 4 números.")
    Stop Event
    Return
  Endif
  ' --- 3. POSICIONES 0 A 3: SOLO LETRAS MINÚSCULAS ---
  ' Pos ES 0-INDEXED: 0,1,2,3 SON EL BLOQUE DE LETRAS
  iPos = txtUsuario.Pos
  If iPos >= 0 And iPos <= 3 Then
    If Key.Text < "a" Or Key.Text > "z" Then
      m_Sonido.sonar("Warning")
      Stop Event
      Return
    Endif
    Return
  Endif
  ' --- 4. POSICIONES 4 A 7: SOLO DÍGITOS ---
  If iPos >= 4 And iPos <= 7 Then
    If Key.Text < "0" Or Key.Text > "9" Then
      m_Sonido.sonar("Warning")
      Stop Event
      Return
    Endif
    Return
  Endif

  ' --- 5. BLOQUEAR CUALQUIER OTRO CARÁCTER ---
  Stop Event

End

' ============================================
' Función   : txtUsuario_KeyRelease
' Propósito : Fuerza mayúsculas, valida longitud y actualiza el preview
'             del nombre final con el prefijo de tipo seleccionado.
' ============================================
Public Sub txtUsuario_KeyRelease()

  Dim sTexto As String
  Dim iPosicionCursor As Integer

  ' --- 1. GUARDAR POSICIÓN DEL CURSOR ---
  iPosicionCursor = txtUsuario.Pos

  ' --- 2. CONVERTIR A MINÚSCULAS ---
  sTexto = LCase(txtUsuario.Text)

  ' --- 3. TRUNCAR SILENCIOSAMENTE SI EXCEDE (NO MOLESTAR EN EL CASO VÁLIDO) ---
  If String.Len(sTexto) > 8 Then
    sTexto = String.Left(sTexto, 8)
    iPosicionCursor = 8
  Endif

  ' --- 4. ACTUALIZAR TEXTO Y RESTAURAR CURSOR ---
  txtUsuario.Text = sTexto
  txtUsuario.Pos = iPosicionCursor

End

' ============================================
' Función   : ValidarPatronUsuario
' Propósito : Verifica que el texto cumpla EXACTAMENTE el patrón
'             abcd1234 — 4 letras minúsculas SEGUIDAS de 4 dígitos.
'             No admite mezcla, ni otros caracteres, ni longitud distinta.
' Parámetros: sUsuario As String — texto a validar
' Retorna   : Boolean — True si cumple el patrón estricto, False si no
' ============================================
Public Function ValidarPatronUsuario(sUsuario As String) As Boolean

  Dim iIndice As Integer
  Dim sCaracter As String
  ' --- 1. VALIDAR LONGITUD EXACTA (NI MÁS NI MENOS QUE 8) ---
  If String.Len(sUsuario) <> 8 Then Return False
  ' --- 2. PRIMERAS 4 POSICIONES: SOLO LETRAS MINÚSCULAS ---
  ' String.Mid ES 1-INDEXED: 1 A 4 ES EL BLOQUE DE LETRAS
  For iIndice = 1 To 4
    sCaracter = String.Mid(sUsuario, iIndice, 1)
    If sCaracter < "a" Or sCaracter > "z" Then Return False
  Next
  ' --- 3. ÚLTIMAS 4 POSICIONES: SOLO DÍGITOS ---
  For iIndice = 5 To 8
    sCaracter = String.Mid(sUsuario, iIndice, 1)
    If sCaracter < "0" Or sCaracter > "9" Then Return False
  Next
  ' --- 4. CUMPLE EL PATRÓN COMPLETO ---
  Return True

End

' ============================================
' Función   : lbClasificacion_Click
' Propósito : Al elegir una clasificación, cargar sus formatos
'             en el ColumnView y resetear el detalle.
' ============================================
Public Sub lbClasificacion_Click()

  ' --- 1. GUARD: DEBE HABER CLASIFICACIÓN SELECCIONADA ---
  If lbClasificacion.Index < 0 Then Return

  ' --- 2. CARGAR FORMATOS DE ESA CLASIFICACIÓN ---
  m_FormatosPDF.CargarFormatosDe(cvFormatos, lbClasificacion.Text)

  ' --- 3. RESET DEL DETALLE (AÚN NO HAY FORMATO SELECCIONADO) ---
  LimpiarDetalleFormato()

End

' ============================================
' Función   : cvFormatos_Click
' Propósito : Al seleccionar un formato, poblar los controles de
'             detalle y fijar editabilidad según el origen.
' ============================================
Public Sub cvFormatos_Click()

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim rs As Result

  ' --- 2. GUARD: DEBE HABER FILA SELECCIONADA ---
  If Not cvFormatos.Current Then Return

  ' --- 3. ID DESDE LA CLAVE DE LA FILA (RC-GM-16: id en variable) ---
  $iFormatoActual = CInt(cvFormatos.Current.Key)

  ' --- 4. LEER REGISTRO COMPLETO ---
  rs = m_FormatosPDF.LeerFormato($iFormatoActual)
  If IsNull(rs) Then Return
  If Not rs.Available Then Return

  ' --- 5. POBLAR CAMPOS (Str => PUNTO DECIMAL, ROUND-TRIP SEGURO) ---
  ancho_formato_pdf.Text = Str(rs["ancho"])
  alto_formato_pdf.Text = Str(rs["alto"])
  margen_interior.Text = Str(rs["margen_interior"])
  margen_exterior.Text = Str(rs["margen_exterior"])
  margen_superior.Text = Str(rs["margen_superior"])
  margen_inferior.Text = Str(rs["margen_inferior"])
  txtComentarioFormatoPDF.Text = If(rs["comentario"], rs["comentario"], "")
  ' RC-GM-01: activo es TINYINT(1) => Boolean.
  chbActivoFormatoPDF.Value = (rs["activo"] = True)

  ' --- 6. EDITABILIDAD SEGÚN ORIGEN ---
  ' SISTEMA => campos readonly (solo 'activo' editable).
  ' CUSTOM  => todo editable.
  $bFormatoEsCustom = (rs["origen"] = "custom")
  EstablecerEdicionCampos($bFormatoEsCustom)

  ' --- 7. BOTONES: MODO EDICIÓN ---
  btnNuevoFormatoPDF.Visible = True
  btnGuardarFormatoPDF.Visible = False
  btnGuardarCambiosFormatoPDF.Visible = True

End

' ============================================
' Función   : btnNuevoFormatoPDF_Click
' Propósito : Entrar en modo ALTA de un formato CUSTOM: limpia
'             campos, habilita edición y ajusta botones.
' ============================================
Public Sub btnNuevoFormatoPDF_Click()

  ' --- 1. MODO ALTA: UN ALTA SIEMPRE ES CUSTOM ---
  $iFormatoActual = 0
  $bFormatoEsCustom = True

  ' --- 2. LIMPIAR CAMPOS Y HABILITAR EDICIÓN ---
  ancho_formato_pdf.Text = ""
  alto_formato_pdf.Text = ""
  margen_interior.Text = ""
  margen_exterior.Text = ""
  margen_superior.Text = ""
  margen_inferior.Text = ""
  txtComentarioFormatoPDF.Text = ""
  chbActivoFormatoPDF.Value = True
  EstablecerEdicionCampos(True)

  ' --- 3. BOTONES: MODO ALTA (OCULTAR NUEVO PARA NO ABANDONAR A MEDIAS) ---
  btnNuevoFormatoPDF.Visible = False
  btnGuardarFormatoPDF.Visible = True
  btnGuardarCambiosFormatoPDF.Visible = False

  ' --- 4. FOCO EN EL PRIMER CAMPO ---
  ancho_formato_pdf.SetFocus()

End

' ============================================
' Función   : btnGuardarFormatoPDF_Click
' Propósito : Persistir un formato CUSTOM nuevo (modo ALTA).
'             El nombre CUSTOMxx lo genera el módulo.
' ============================================
Public Sub btnGuardarFormatoPDF_Click()

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim rAncho As Float
  Dim rAlto As Float
  Dim rMargInt As Float
  Dim rMargExt As Float
  Dim rMargSup As Float
  Dim rMargInf As Float
  Dim iNuevoId As Integer

  ' --- 2. LEER Y NORMALIZAR NÚMEROS (COMA O PUNTO -> PUNTO) ---
  rAncho = LeerNumero(ancho_formato_pdf.Text)
  rAlto = LeerNumero(alto_formato_pdf.Text)
  rMargInt = LeerNumero(margen_interior.Text)
  rMargExt = LeerNumero(margen_exterior.Text)
  rMargSup = LeerNumero(margen_superior.Text)
  rMargInf = LeerNumero(margen_inferior.Text)

  ' --- 3. VALIDACIÓN ---
  If rAncho <= 0 Or rAlto <= 0 Then
    m_Sonido.sonar("Warning")
    Message.Warning("Ancho y alto deben ser mayores que cero.")
    Return
  Endif
  If rMargInt < 0 Or rMargExt < 0 Or rMargSup < 0 Or rMargInf < 0 Then
    m_Sonido.sonar("Warning")
    Message.Warning("Los márgenes no pueden ser negativos.")
    Return
  Endif

  ' --- 4. ALTA VÍA MÓDULO ---
  iNuevoId = m_FormatosPDF.CrearFormatoCustom(rAncho, rAlto, rMargInt, rMargExt, rMargSup, rMargInf, Trim(txtComentarioFormatoPDF.Text), chbActivoFormatoPDF.Value)
  ' -1 => FALLÓ EL ALTA (EL MÓDULO YA MOSTRÓ EL ERROR).
  If iNuevoId = -1 Then Return

  ' --- 5. REFRESCO: 'Custom' PUEDE SER CLASIFICACIÓN NUEVA ---
  m_FormatosPDF.CargarClasificaciones(lbClasificacion)
  SeleccionarClasificacion("Custom")
  m_FormatosPDF.CargarFormatosDe(cvFormatos, "Custom")

  ' --- 6. RESET DE ESTADO Y AVISO ---
  LimpiarDetalleFormato()
  m_Sonido.sonar("Info")
  Message.Info("Formato personalizado creado.")

End

' ============================================
' Función   : btnGuardarCambiosFormatoPDF_Click
' Propósito : Guardar cambios del formato seleccionado. Si es
'             CUSTOM actualiza todo; si es SISTEMA, solo 'activo'.
' ============================================
Public Sub btnGuardarCambiosFormatoPDF_Click()

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim rAncho As Float
  Dim rAlto As Float
  Dim rMargInt As Float
  Dim rMargExt As Float
  Dim rMargSup As Float
  Dim rMargInf As Float
  Dim bOk As Boolean

  ' --- 2. GUARD: DEBE HABER FORMATO SELECCIONADO ---
  If $iFormatoActual <= 0 Then
    m_Sonido.sonar("Warning")
    Message.Warning("Seleccione un formato para modificar.")
    Return
  Endif

  ' --- 3. RAMA SEGÚN ORIGEN ---
  If $bFormatoEsCustom Then

    ' CUSTOM: LEER, VALIDAR Y ACTUALIZAR TODOS LOS CAMPOS.
    rAncho = LeerNumero(ancho_formato_pdf.Text)
    rAlto = LeerNumero(alto_formato_pdf.Text)
    rMargInt = LeerNumero(margen_interior.Text)
    rMargExt = LeerNumero(margen_exterior.Text)
    rMargSup = LeerNumero(margen_superior.Text)
    rMargInf = LeerNumero(margen_inferior.Text)

    If rAncho <= 0 Or rAlto <= 0 Then
      m_Sonido.sonar("Warning")
      Message.Warning("Ancho y alto deben ser mayores que cero.")
      Return
    Endif
    If rMargInt < 0 Or rMargExt < 0 Or rMargSup < 0 Or rMargInf < 0 Then
      m_Sonido.sonar("Warning")
      Message.Warning("Los márgenes no pueden ser negativos.")
      Return
    Endif

    bOk = m_FormatosPDF.ActualizarFormatoCustom($iFormatoActual, rAncho, rAlto, rMargInt, rMargExt, rMargSup, rMargInf, Trim(txtComentarioFormatoPDF.Text), chbActivoFormatoPDF.Value)

  Else

    ' SISTEMA: SOLO EL ESTADO ACTIVO ES MODIFICABLE.
    bOk = m_FormatosPDF.ActualizarEstadoActivo($iFormatoActual, chbActivoFormatoPDF.Value)

  Endif

  ' EL MÓDULO YA MOSTRÓ EL ERROR SI bOk = False.
  If Not bOk Then Return

  ' --- 4. REFRESCO DE LA CLASIFICACIÓN ACTUAL ---
  If lbClasificacion.Index >= 0 Then
    m_FormatosPDF.CargarFormatosDe(cvFormatos, lbClasificacion.Text)
  Endif

  ' --- 5. RESET DE ESTADO Y AVISO ---
  LimpiarDetalleFormato()
  m_Sonido.sonar("Info")
  Message.Info("Cambios guardados correctamente.")

End

' ============================================
' Función   : EstablecerEdicionCampos
' Propósito : Alternar readonly + fondo de los campos de detalle.
'             chbActivoFormatoPDF queda SIEMPRE editable (activo
'             es modificable en sistema y en custom).
' Parámetros: bEditable As Boolean — True: editable; False: readonly
' ============================================
Private Sub EstablecerEdicionCampos(bEditable As Boolean)

  ' --- 1. FONDO: BLANCO SI EDITABLE, GRIS (Color.Background) SI READONLY ---
  Dim iBg As Integer

  If bEditable Then
    iBg = Color.TextBackground
  Else
    iBg = Color.Background
  Endif

  ' --- 2. APLICAR A LOS 6 NUMÉRICOS + COMENTARIO ---
  ancho_formato_pdf.ReadOnly = Not bEditable
  ancho_formato_pdf.Background = iBg
  alto_formato_pdf.ReadOnly = Not bEditable
  alto_formato_pdf.Background = iBg
  margen_interior.ReadOnly = Not bEditable
  margen_interior.Background = iBg
  margen_exterior.ReadOnly = Not bEditable
  margen_exterior.Background = iBg
  margen_superior.ReadOnly = Not bEditable
  margen_superior.Background = iBg
  margen_inferior.ReadOnly = Not bEditable
  margen_inferior.Background = iBg
  txtComentarioFormatoPDF.ReadOnly = Not bEditable
  txtComentarioFormatoPDF.Background = iBg

End

' ============================================
' Función   : LimpiarDetalleFormato
' Propósito : Dejar el panel de detalle en estado inicial:
'             campos vacíos, readonly, sin selección y botones
'             en su disposición base.
' ============================================
Private Sub LimpiarDetalleFormato()

  ' --- 1. VACIAR CAMPOS ---
  ancho_formato_pdf.Text = ""
  alto_formato_pdf.Text = ""
  margen_interior.Text = ""
  margen_exterior.Text = ""
  margen_superior.Text = ""
  margen_inferior.Text = ""
  txtComentarioFormatoPDF.Text = ""
  chbActivoFormatoPDF.Value = True

  ' --- 2. RESET DE ESTADO INTERNO ---
  $iFormatoActual = 0
  $bFormatoEsCustom = False

  ' --- 3. CAMPOS READONLY ---
  EstablecerEdicionCampos(False)

  ' --- 4. BOTONES: DISPOSICIÓN BASE ---
  btnNuevoFormatoPDF.Visible = True
  btnGuardarFormatoPDF.Visible = False
  btnGuardarCambiosFormatoPDF.Visible = False

End

' ============================================
' Función   : SeleccionarClasificacion
' Propósito : Posicionar el ListBox en la clasificación indicada
'             (usada tras crear un CUSTOM para saltar a 'Custom').
' Parámetros: sClasif As String — texto de la clasificación.
' ============================================
Private Sub SeleccionarClasificacion(sClasif As String)

  Dim i As Integer

  For i = 0 To lbClasificacion.List.Max
    If lbClasificacion.List[i] = sClasif Then
      lbClasificacion.Index = i
      Break
    Endif
  Next

End

' ============================================
' Función   : LeerNumero
' Propósito : Convertir texto a Float aceptando coma o punto
'             como separador decimal. Normaliza a punto y
'             convierte con CFloat, que es locale-independiente.
' Parámetros: sTexto As String — texto del textbox.
' Retorna   : Float — valor numérico (0 si vacío o inválido).
' ============================================
Private Function LeerNumero(sTexto As String) As Float

  ' --- 1. INICIALIZACIÓN ---
  Dim sNormalizado As String
  Dim rValor As Float

  ' --- 2. NORMALIZAR: COMA O PUNTO -> PUNTO ---
  sNormalizado = Replace(Trim(sTexto), ",", ".")
  ' VACÍO: CFloat("") LANZA TYPE MISMATCH
  If sNormalizado = "" Then Return 0

  ' --- 3. CONVERSIÓN ---
  ' NO Val: DEPENDE DEL LOCALE. CON es_AR "15.5" DA NULL Y "1.234" DA 1234
  Try rValor = CFloat(sNormalizado)
  If Error Then Return 0

  ' --- 4. RETORNO ---
  Return rValor

End

Public Sub SplitterPDF_Resize()

  SplitterPDF.Layout = [1, 3]

End

' ════════════════════════════════════════════════════════════════════════════
' Función   : ConfigurarGridViewSeries
' Propósito : Define la única columna del GridView de series. El estado no
'             se muestra como columna: las series heredan el estado de la
'             colección madre por cascada y se reflejan con color de fila.
' ════════════════════════════════════════════════════════════════════════════
Private Sub ConfigurarGridViewSeries()

  With gvSeries
    .Header = GridView.Horizontal
    .Columns.Count = 1
    .Columns[0].Title = "Serie"
    .Columns[0].Width = 380
    .Rows.Count = 0
  End With

End

' ════════════════════════════════════════════════════════════════════════════
' PESTAÑA «Notas» (tsFSysAdmin, ÍNDICE 6): ADMINISTRACIÓN DE NOTAS INTERNAS
' ----------------------------------------------------------------------------
' LO QUE SOLO HACE EL ADMINISTRADOR SOBRE LAS NOTAS (claude/notas-rediseno.md):
'   - TRANSFERIR EL ROL DE CREADOR DE UN GRUPO CUYO CREADOR QUEDÓ INACTIVO,
'     A UN MIEMBRO ACTIVO DEL GRUPO;
'   - CERRAR LAS NOTAS ABIERTAS DE UN USUARIO INACTIVO.
' EL TERCER CASO, ARCHIVAR UN PROYECTO, LO HACE btnGuardarCambiosProyecto_Click.
' USA hConnServidor: EL ADMINISTRADOR NO ES UN USUARIO DE gbpublisher. LO QUE
' CIERRA QUEDA FIRMADO CON SU NOMBRE EN notas.cierre_sistema.
' ════════════════════════════════════════════════════════════════════════════

' ============================================
' Función   : ConexionServidorLista
' Propósito : GUARDA COMÚN DE LA PESTAÑA «Notas»: hConnServidor ABIERTA.
'             NULL Y Opened EN If SEPARADOS (RC-GM-17).
' Parámetros: ninguno
' Retorna   : Boolean — TRUE SI SE PUEDE CONSULTAR
' ============================================
Private Function ConexionServidorLista() As Boolean

  If Not hConnServidor Then Return False
  Return hConnServidor.Opened

End

' ============================================
' Función   : ConfigurarGridsNotas
' Propósito : COLUMNAS FIJAS DE LAS DOS GRILLAS DE LA PESTAÑA «Notas». LA
'             CARGA NO VUELVE A TOCAR Columns.Count (GV-58).
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub ConfigurarGridsNotas()

  ' --- 1. GRUPOS: UNO POR PROYECTO QUE TENGA GRUPO ---
  With gvNotasGrupos
    .Header = GridView.Horizontal
    .Grid = True
    .Columns.Count = COLUMNAS_NOTAS_GRUPOS
    .Columns[0].Title = "Proyecto"
    .Columns[0].Width = 300
    .Columns[1].Title = "Creador"
    .Columns[1].Width = 150
    .Columns[2].Title = "Creador activo"
    .Columns[2].Width = 150
    .Columns[3].Title = "Miembros activos"
    .Columns[3].Width = 150
    .Columns[4].Title = "Notas abiertas"
    .Columns[4].Width = 150
    .Rows.Count = 0
  End With

  ' --- 2. USUARIOS INACTIVOS CON NOTAS ABIERTAS ---
  With gvNotasAutores
    .Header = GridView.Horizontal
    .Grid = True
    .Columns.Count = COLUMNAS_NOTAS_AUTORES
    .Columns[0].Title = "Usuario (inactivo)"
    .Columns[0].Width = 200
    .Columns[1].Title = "Notas abiertas"
    .Columns[1].Width = 120
    .Rows.Count = 0
  End With

End

' ============================================
' Función   : CargarNotasAdmin
' Propósito : LLENAR LAS DOS GRILLAS DE LA PESTAÑA «Notas» Y VACIAR LOS
'             CANDIDATOS A CREADOR. LOS GRUPOS CON CREADOR INACTIVO VAN
'             PRIMERO Y CON FONDO DE AVISO: SON LOS QUE PIDEN TRANSFERENCIA.
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub CargarNotasAdmin()

  ' --- 0. INICIALIZACIÓN ---
  Dim rGrupos As Result
  Dim rAutores As Result
  Dim iFila As Integer
  Dim iColumna As Integer
  Dim bActivo As Boolean
  Dim iFondo As Integer

  ' --- 1. VALIDACIÓN: SIN CONEXIÓN NO HAY NADA QUE MOSTRAR ---
  If Not ConexionServidorLista() Then Return

  ' --- 2. GRUPOS (activo ES TINYINT(1): SE CONVIERTE EN SQL, RC-GM-01) ---
  Try rGrupos = hConnServidor.Exec("SELECT g.id, p.nombre AS proyecto, u.usuario AS creador, " &
    "CAST(u.activo AS SIGNED) AS creador_activo, " &
    "(SELECT COUNT(*) FROM notas_miembros m WHERE m.id_grupo = g.id AND m.fecha_baja IS NULL) AS miembros, " &
    "(SELECT COUNT(*) FROM notas n WHERE n.id_grupo = g.id AND n.fecha_cierre IS NULL) AS abiertas " &
    "FROM notas_grupos g JOIN proyectos p ON p.id = g.id_proyecto JOIN usuarios u ON u.id = g.id_creador " &
    "ORDER BY u.activo, p.nombre")
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudieron cargar los grupos de notas:" & Chr(10) & Error.Text)
    Return
  Endif

  gvNotasGrupos.Rows.Count = 0
  $aNotasGrupos.Clear()
  $aNotasCreadorActivo.Clear()
  gvNotasGrupos.Rows.Count = rGrupos.Count
  iFila = 0
  For Each rGrupos
    bActivo = (rGrupos["creador_activo"] = 1)
    $aNotasGrupos.Add(CInt(rGrupos["id"]))
    $aNotasCreadorActivo.Add(bActivo)
    gvNotasGrupos[iFila, 0].Text = rGrupos["proyecto"]
    gvNotasGrupos[iFila, 1].Text = rGrupos["creador"]
    gvNotasGrupos[iFila, 2].Text = If(bActivo, "Sí", "No")
    gvNotasGrupos[iFila, 3].Text = CStr(rGrupos["miembros"])
    gvNotasGrupos[iFila, 4].Text = CStr(rGrupos["abiertas"])
    ' FONDO EXPLÍCITO EN TODAS LAS CELDAS: VOLVER Rows.Count A 0 NO BORRA EL
    ' FORMATO, Y UN FONDO DE LA CARGA ANTERIOR REAPARECERÍA
    If bActivo Then
      iFondo = Color.Default
    Else
      iFondo = Color.RGB(255, 200, 200)
    Endif
    For iColumna = 0 To COLUMNAS_NOTAS_GRUPOS - 1
      gvNotasGrupos[iFila, iColumna].Background = iFondo
    Next
    Inc iFila
  Next

  ' --- 3. USUARIOS INACTIVOS CON NOTAS ABIERTAS ---
  Try rAutores = hConnServidor.Exec("SELECT u.id, u.usuario, COUNT(*) AS abiertas " &
    "FROM notas n JOIN usuarios u ON u.id = n.id_autor " &
    "WHERE u.activo = 0 AND n.fecha_cierre IS NULL GROUP BY u.id, u.usuario ORDER BY u.usuario")
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudieron cargar los usuarios con notas abiertas:" & Chr(10) & Error.Text)
    Return
  Endif

  gvNotasAutores.Rows.Count = 0
  $aNotasAutores.Clear()
  gvNotasAutores.Rows.Count = rAutores.Count
  iFila = 0
  For Each rAutores
    $aNotasAutores.Add(CInt(rAutores["id"]))
    gvNotasAutores[iFila, 0].Text = rAutores["usuario"]
    gvNotasAutores[iFila, 1].Text = CStr(rAutores["abiertas"])
    Inc iFila
  Next

  ' --- 4. SIN GRUPO ELEGIDO NO HAY CANDIDATOS ---
  cmbNotasCreador.Clear()
  $aNotasCandidatos.Clear()
  btnNotasTransferir.Enabled = False

End

' ============================================
' Función   : tsFSysAdmin_Click
' Propósito : AL ENTRAR A UNA PESTAÑA QUE MUESTRA DATOS DEL SERVIDOR, RELEERLOS.
'             «Notas»: UN USUARIO DADO DE BAJA EN «Usuarios» CAMBIA LAS DOS
'             GRILLAS. «Editorial»: LAS EDITORIALES Y SUS CRÉDITOS.
'             «Catálogos»: LOS ROLES CRediT Y LAS LICENCIAS
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub tsFSysAdmin_Click()

  If tsFSysAdmin.Index = PESTANA_NOTAS Then CargarNotasAdmin()
  If tsFSysAdmin.Index = PESTANA_EDITORIAL Then CargarPestanaEditorial()
  If tsFSysAdmin.Index = PESTANA_CATALOGOS Then CargarPestanaCatalogos()

End

' ============================================
' Función   : btnNotasActualizar_Click
' Propósito : RELEER GRUPOS Y USUARIOS DESDE EL SERVIDOR.
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnNotasActualizar_Click()

  ' --- 1. VALIDACIÓN ---
  If Not ConexionServidorLista() Then
    m_Sonido.sonar("Warning")
    Message.Warning("No hay conexión al servidor.")
    Return
  Endif

  ' --- 2. CARGA ---
  CargarNotasAdmin()

End

' ============================================
' Función   : gvNotasGrupos_Click
' Propósito : AL ELEGIR UN GRUPO CON CREADOR INACTIVO, LISTAR COMO CANDIDATOS
'             A SUS MIEMBROS ACTIVOS QUE SON USUARIOS ACTIVOS. CON EL CREADOR
'             ACTIVO NO HAY TRANSFERENCIA: EL ROL LO CEDE QUIEN LO TIENE.
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub gvNotasGrupos_Click()

  ' --- 0. INICIALIZACIÓN ---
  Dim rCandidatos As Result
  Dim iFila As Integer

  ' --- 1. VALIDACIÓN DE LA FILA ---
  cmbNotasCreador.Clear()
  $aNotasCandidatos.Clear()
  btnNotasTransferir.Enabled = False
  iFila = gvNotasGrupos.Row
  If iFila < 0 Then Return
  If iFila >= $aNotasGrupos.Count Then Return
  If Not ConexionServidorLista() Then Return

  ' --- 2. CREADOR ACTIVO: NADA QUE TRANSFERIR ---
  If $aNotasCreadorActivo[iFila] Then Return

  ' --- 3. CANDIDATOS ---
  Try rCandidatos = hConnServidor.Exec("SELECT u.id, u.usuario FROM notas_miembros m JOIN usuarios u ON u.id = m.id_usuario " &
    "WHERE m.id_grupo = &1 AND m.fecha_baja IS NULL AND u.activo = 1 ORDER BY u.usuario", $aNotasGrupos[iFila])
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudieron cargar los miembros del grupo:" & Chr(10) & Error.Text)
    Return
  Endif

  For Each rCandidatos
    cmbNotasCreador.Add(rCandidatos["usuario"])
    $aNotasCandidatos.Add(CInt(rCandidatos["id"]))
  Next

  ' --- 4. SIN MIEMBROS ACTIVOS NO HAY A QUIÉN TRANSFERIR ---
  ' LAS NOTAS DEL GRUPO SE CIERRAN ARCHIVANDO EL PROYECTO O POR USUARIO
  If $aNotasCandidatos.Count = 0 Then
    m_Sonido.sonar("Warning")
    Message.Warning("El grupo no tiene miembros activos a quienes transferir el rol de creador.")
    Return
  Endif
  cmbNotasCreador.Index = 0
  btnNotasTransferir.Enabled = True

End

' ============================================
' Función   : btnNotasTransferir_Click
' Propósito : PASAR EL ROL DE CREADOR AL CANDIDATO ELEGIDO. LA SENTENCIA SOLO
'             ACTÚA SI EL CREADOR SIGUE INACTIVO Y EL CANDIDATO SIGUE SIENDO
'             MIEMBRO ACTIVO (SC-07: EL FILTRO VA EN LA SENTENCIA, NO EN LA
'             PANTALLA).
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnNotasTransferir_Click()

  ' --- 0. INICIALIZACIÓN ---
  Dim iFila As Integer
  Dim iCandidato As Integer
  Dim sCandidato As String

  ' --- 1. VALIDACIÓN ---
  iFila = gvNotasGrupos.Row
  If iFila < 0 Or iFila >= $aNotasGrupos.Count Then
    m_Sonido.sonar("Warning")
    Message.Warning("Elegí un grupo.")
    Return
  Endif
  iCandidato = cmbNotasCreador.Index
  If iCandidato < 0 Or iCandidato >= $aNotasCandidatos.Count Then
    m_Sonido.sonar("Warning")
    Message.Warning("Elegí el nuevo creador.")
    Return
  Endif
  If Not ConexionServidorLista() Then
    m_Sonido.sonar("Warning")
    Message.Warning("No hay conexión al servidor.")
    Return
  Endif
  sCandidato = cmbNotasCreador.Text

  ' --- 2. CONFIRMACIÓN ---
  m_Sonido.sonar("Question")
  If Message.Question("¿Pasar el rol de creador del grupo de «" & gvNotasGrupos[iFila, 0].Text & "» a " & sCandidato & "?" & Chr(10) &
      "Desde ahí es quien suma y da de baja a los miembros.", "Transferir", "Cancelar") <> 1 Then Return

    ' --- 3. TRANSFERENCIA ---
    Try hConnServidor.Exec("UPDATE notas_grupos SET id_creador = &2 WHERE id = &1 " &
      "AND id_creador IN (SELECT u.id FROM usuarios u WHERE u.activo = 0) " &
      "AND EXISTS (SELECT 1 FROM notas_miembros m WHERE m.id_grupo = &1 AND m.id_usuario = &2 AND m.fecha_baja IS NULL)",
      $aNotasGrupos[iFila], $aNotasCandidatos[iCandidato])
    If Error Then
      m_Sonido.sonar("Error")
      Message.Error("No se pudo transferir el rol de creador:" & Chr(10) & Error.Text)
      Return
    Endif

    ' --- 4. RESULTADO Y RECARGA ---
    m_Sonido.sonar("Info")
    Message.Info("El rol de creador pasó a " & sCandidato & ".")
    CargarNotasAdmin()

End

' ============================================
' Función   : btnNotasCerrarAutor_Click
' Propósito : CERRAR Y ARCHIVAR TODAS LAS NOTAS ABIERTAS DEL USUARIO INACTIVO
'             ELEGIDO, FIRMADAS CON EL NOMBRE DEL ADMINISTRADOR. LA SENTENCIA
'             SOLO ACTÚA SI EL USUARIO SIGUE INACTIVO (SC-07).
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnNotasCerrarAutor_Click()

  ' --- 0. INICIALIZACIÓN ---
  Dim iFila As Integer

  ' --- 1. VALIDACIÓN ---
  iFila = gvNotasAutores.Row
  If iFila < 0 Or iFila >= $aNotasAutores.Count Then
    m_Sonido.sonar("Warning")
    Message.Warning("Elegí un usuario.")
    Return
  Endif
  If Not ConexionServidorLista() Then
    m_Sonido.sonar("Warning")
    Message.Warning("No hay conexión al servidor.")
    Return
  Endif

  ' --- 2. CONFIRMACIÓN ---
  m_Sonido.sonar("Question")
  If Message.Question("¿Cerrar y archivar las " & gvNotasAutores[iFila, 1].Text & " notas abiertas de " & gvNotasAutores[iFila, 0].Text & "?" & Chr(10) &
      "Quedan firmadas como cerradas por la administración.", "Cerrar", "Cancelar") <> 1 Then Return

    ' --- 3. CIERRE. ES ACTIVIDAD: LOS DESTINATARIOS LO VEN COMO NOVEDAD ---
    Try hConnServidor.Exec("UPDATE notas SET fecha_cierre = NOW(), cierre_sistema = &2, ultima_actividad = NOW(6) " &
      "WHERE id_autor = &1 AND fecha_cierre IS NULL AND id_autor IN (SELECT u.id FROM usuarios u WHERE u.activo = 0)",
      $aNotasAutores[iFila], sUsuarioActual)
    If Error Then
      m_Sonido.sonar("Error")
      Message.Error("No se pudieron cerrar las notas:" & Chr(10) & Error.Text)
      Return
    Endif

    ' --- 4. RESULTADO Y RECARGA ---
    m_Sonido.sonar("Info")
    Message.Info("Notas cerradas.")
    CargarNotasAdmin()

End

' ════════════════════════════════════════════════════════════════════════════
' PESTAÑA «Editorial» (tsFSysAdmin, ÍNDICE 7): LA EDITORIAL Y SUS CRÉDITOS.
' ESQUEMA 1.26.0 (ETAPA B2). LA EDITORIAL ES LA MADRE DE SUS REVISTAS: LAS
' REVISTAS Y SUS SECCIONES SE EDITAN EN FRevistas, QUE SE ABRE CON EL BOTÓN
' «Revistas». ACÁ VAN LOS CONTROLES Y LOS MANEJADORES; LAS CONSULTAS, LAS
' VALIDACIONES Y LAS GRABACIONES ESTÁN EN m_Editorial
' ════════════════════════════════════════════════════════════════════════════

' ============================================
' Función   : CargarPestanaEditorial
' Propósito : Al entrar a la pestaña: prepara grillas y combo (una vez por
'             apertura del formulario) y relee las editoriales del servidor
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub CargarPestanaEditorial()

  ' --- 1. GUARD: LA CONEXIÓN DEL ADMINISTRADOR TIENE QUE ESTAR ABIERTA ---
  If Not hConnServidor Then Return
  If Not hConnServidor.Opened Then Return

  ' --- 2. PREPARACIÓN, UNA SOLA VEZ ---
  If Not $bEditorialPreparada Then
    ConfigurarGridsEditorial()
    ' LICENCIAS: DE SOLO LECTURA, SE ELIGE DEL CATÁLOGO (DECISIÓN DE
    ' ALBERTO, 14/11: LOS TEXTOS SE CONFIGURAN EN «Catálogos»). SIN EL CUARTO
    ' ARGUMENTO, LlenarCombo LO DEJABA EDITABLE Y PISABA EL ReadOnly DEL
    ' DISEÑADOR. CON LA CONEXIÓN DEL FORMULARIO: FSysAdmin SE ABRE SIN SESIÓN
    ' Y mConn PUEDE NO EXISTIR
    m_Licencias.LlenarCombo(cmbLicenciaEditorial, False, hConnServidor, True)
    $bEditorialPreparada = True
  Endif

  ' --- 3. DATOS FRESCOS ---
  CargarEditoriales()

End

' ============================================
' Función   : ConfigurarGridsEditorial
' Propósito : Columnas de las grillas de editoriales y de créditos (GV-58:
'             conteo fijo)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub ConfigurarGridsEditorial()

  ' --- 1. EDITORIALES ---
  With gvEditoriales
    .Header = GridView.Horizontal
    .Columns.Count = COLUMNAS_EDITORIALES
    .Columns[0].Title = "Editorial"
    .Columns[0].Width = 700
    .Columns[1].Title = "Revistas"
    .Columns[1].Width = 90
    .Rows.Count = 0
  End With

  ' --- 2. CRÉDITOS ---
  With gvCreditos
    .Header = GridView.Horizontal
    .Columns.Count = COLUMNAS_CREDITOS
    .Columns[0].Title = "Cargo"
    .Columns[0].Width = 260
    .Columns[1].Title = "Nombre"
    .Columns[1].Width = 300
    .Columns[2].Title = "Orden"
    .Columns[2].Width = 60
    .Columns[3].Title = "Desde"
    .Columns[3].Width = 100
    .Columns[4].Title = "Hasta"
    .Columns[4].Width = 100
    .Rows.Count = 0
  End With

End

' ============================================
' Función   : CargarEditoriales
' Propósito : Llena la grilla de editoriales, limpia los dos editores y deja
'             los botones como corresponde a «nada elegido»
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub CargarEditoriales()

  Dim rDatos As Result
  Dim iFila As Integer

  ' --- 1. LECTURA ---
  $aIdsEditoriales.Clear()
  $aRevistasEditoriales.Clear()
  gvEditoriales.Rows.Count = 0
  rDatos = m_Editorial.ListarEditoriales(hConnServidor)

  ' --- 2. GRILLA, CON UN id POR FILA EN EL MISMO ORDEN ---
  If rDatos Then
    gvEditoriales.Rows.Count = rDatos.Count
    iFila = 0
    While rDatos.Available
      $aIdsEditoriales.Add(rDatos!id_editorial)
      $aRevistasEditoriales.Add(rDatos!revistas)
      gvEditoriales[iFila, 0].Text = rDatos!nombre
      ' COUNT LLEGA COMO Long
      gvEditoriales[iFila, 1].Text = CStr(rDatos!revistas)
      Inc iFila
      rDatos.MoveNext
    Wend
  Endif

  ' --- 3. NADA ELEGIDO ---
  $iEditorialActual = 0
  LimpiarEditorEditorial()
  LimpiarCreditos()
  btnGuardarEditorial.Enabled = False
  btnBorrarEditorial.Enabled = False
  btnRevistasEditorial.Enabled = False

End

' ============================================
' Función   : gvEditoriales_Click
' Propósito : Al elegir una editorial, carga su editor y sus créditos
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub gvEditoriales_Click()

  Dim iFila As Integer

  ' --- 1. FILA VÁLIDA ---
  iFila = gvEditoriales.Row
  If iFila < 0 Or iFila >= $aIdsEditoriales.Count Then Return

  ' --- 2. EDITOR Y CRÉDITOS ---
  $iEditorialActual = $aIdsEditoriales[iFila]
  If Not CargarEditorialEnEditor($iEditorialActual) Then Return
  CargarCreditos()

  ' --- 3. BOTONES ---
  btnGuardarEditorial.Enabled = True
  ' SOLO SIN REVISTAS: LA QUE TIENE REVISTAS NO SE BORRA
  btnBorrarEditorial.Enabled = $aRevistasEditoriales[iFila] = 0
  btnRevistasEditorial.Enabled = True
  btnNuevoCredito.Enabled = True

End

' ============================================
' Función   : CargarEditorialEnEditor
' Propósito : Vuelca el registro de la editorial a la pestaña «Editorial»
' Parámetros: iIdEditorial As Integer — editorial
' Retorna   : Boolean — True si se cargó
' ============================================
Private Function CargarEditorialEnEditor(iIdEditorial As Integer) As Boolean

  Dim rDatos As Result
  Dim sLicencia As String

  ' --- 1. LECTURA ---
  rDatos = m_Editorial.CargarEditorial(hConnServidor, iIdEditorial)
  If Not rDatos Then Return False

  ' --- 2. CAMPOS ---
  txtNombreEditorial.Text = m_Revistas.TextoDe(rDatos, "nombre")
  txtInstitucionEditorial.Text = m_Revistas.TextoDe(rDatos, "institucion")
  txtRorEditorial.Text = m_Revistas.TextoDe(rDatos, "ror")
  txtDireccionEditorial.Text = m_Revistas.TextoDe(rDatos, "direccion")
  txtRegionEditorial.Text = m_Revistas.TextoDe(rDatos, "region")
  txtCiudadEditorial.Text = m_Revistas.TextoDe(rDatos, "ciudad")
  txtPaisEditorial.Text = m_Revistas.TextoDe(rDatos, "pais")
  txtUrlPortalEditorial.Text = m_Revistas.TextoDe(rDatos, "url_portal")
  txtEmailEditorial.Text = m_Revistas.TextoDe(rDatos, "email")
  txtDoiPrefixEditorial.Text = m_Revistas.TextoDe(rDatos, "doi_prefix")
  ' EL COMBO ES DE SOLO LECTURA: UNA LICENCIA QUE NO ESTÁ EN EL CATÁLOGO NO
  ' SE PUEDE MOSTRAR, Y AL GUARDAR SE PERDERÍA SIN AVISO. SE AVISA ACÁ
  sLicencia = m_Revistas.TextoDe(rDatos, "licencia_defecto")
  cmbLicenciaEditorial.Text = sLicencia
  If sLicencia <> "" Then
    If cmbLicenciaEditorial.Find(sLicencia) < 0 Then
      m_Sonido.sonar("Warning")
      Message.Warning("La licencia de la editorial, «" & sLicencia & "», no está en el catálogo (o está inactiva)." & gb.NewLine & gb.NewLine &
        "Elegí una de la lista antes de guardar: si guardás así, la editorial queda sin licencia.")
    Endif
  Endif
  txtUrlLicenciaEditorial.Text = m_Revistas.TextoDe(rDatos, "url_licencia_defecto")
  ' LA URL YA NO SE ESCRIBE A MANO (SOLO LECTURA): UNA EDITORIAL GUARDADA SIN
  ' ELLA LA TOMA DEL CATÁLOGO, Y QUEDA AL GUARDAR
  If txtUrlLicenciaEditorial.Text = "" Then m_Licencias.CompletarUrl(cmbLicenciaEditorial, txtUrlLicenciaEditorial, hConnServidor)
  txtTitularCopyrightEditorial.Text = m_Revistas.TextoDe(rDatos, "titular_copyright_defecto")
  txtLeyendaDistribucionEditorial.Text = m_Revistas.TextoDe(rDatos, "leyenda_distribucion")
  txaAvisoResponsabilidadEditorial.Text = m_Revistas.TextoDe(rDatos, "aviso_responsabilidad")

  ' --- 3. AUDITORÍA, SOLO LECTURA ---
  txtAuditoriaEditorial.Text = m_Revistas.TextoDe(rDatos, "fecha_creacion")

  Return True

End

' ============================================
' Función   : LimpiarEditorEditorial
' Propósito : Deja vacía la pestaña «Editorial»
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub LimpiarEditorEditorial()

  txtNombreEditorial.Text = ""
  txtInstitucionEditorial.Text = ""
  txtRorEditorial.Text = ""
  txtDireccionEditorial.Text = ""
  txtRegionEditorial.Text = ""
  txtCiudadEditorial.Text = ""
  txtPaisEditorial.Text = ""
  txtUrlPortalEditorial.Text = ""
  txtEmailEditorial.Text = ""
  txtDoiPrefixEditorial.Text = ""
  ' SOLO LECTURA: SE VACÍA POR ÍNDICE, NO POR TEXTO
  cmbLicenciaEditorial.Index = -1
  txtUrlLicenciaEditorial.Text = ""
  txtTitularCopyrightEditorial.Text = ""
  txtLeyendaDistribucionEditorial.Text = ""
  txaAvisoResponsabilidadEditorial.Text = ""
  txtAuditoriaEditorial.Text = ""

End

' ============================================
' Función   : btnNuevaEditorial_Click
' Propósito : Alta mínima y selección de la editorial nueva, como las revistas
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnNuevaEditorial_Click()

  Dim iNueva As Integer

  ' --- 1. ALTA ---
  iNueva = m_Editorial.CrearEditorial(hConnServidor)
  If iNueva = 0 Then Return

  ' --- 2. RELECTURA Y SELECCIÓN DE LA NUEVA ---
  CargarEditoriales()
  SeleccionarEditorial(iNueva)
  tsEditorial.Index = 0
  txtNombreEditorial.SetFocus()
  txtNombreEditorial.SelectAll()

End

' ============================================
' Función   : SeleccionarEditorial
' Propósito : Ubica la grilla en una editorial y la carga
' Parámetros: iIdEditorial As Integer — editorial
' Retorna   : nada
' ============================================
Private Sub SeleccionarEditorial(iIdEditorial As Integer)

  Dim iFila As Integer

  iFila = $aIdsEditoriales.Find(iIdEditorial)
  If iFila < 0 Then Return
  gvEditoriales.Row = iFila
  gvEditoriales_Click()

End

' ============================================
' Función   : btnGuardarEditorial_Click
' Propósito : Junta los valores del editor y los graba por m_Editorial
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnGuardarEditorial_Click()

  Dim cDatos As New Collection
  Dim iEditorial As Integer

  ' --- 1. HAY EDITORIAL ELEGIDA ---
  If $iEditorialActual <= 0 Then Return

  ' --- 2. VALORES, POR NOMBRE DE COLUMNA; Null DONDE NO HAY DATO ---
  cDatos["nombre"] = m_Revistas.NuloSiVacio(txtNombreEditorial.Text)
  cDatos["institucion"] = m_Revistas.NuloSiVacio(txtInstitucionEditorial.Text)
  cDatos["ror"] = m_Revistas.NuloSiVacio(txtRorEditorial.Text)
  cDatos["direccion"] = m_Revistas.NuloSiVacio(txtDireccionEditorial.Text)
  cDatos["region"] = m_Revistas.NuloSiVacio(txtRegionEditorial.Text)
  cDatos["ciudad"] = m_Revistas.NuloSiVacio(txtCiudadEditorial.Text)
  cDatos["pais"] = m_Revistas.NuloSiVacio(txtPaisEditorial.Text)
  cDatos["url_portal"] = m_Revistas.NuloSiVacio(txtUrlPortalEditorial.Text)
  cDatos["email"] = m_Revistas.NuloSiVacio(txtEmailEditorial.Text)
  cDatos["doi_prefix"] = m_Revistas.NuloSiVacio(txtDoiPrefixEditorial.Text)
  cDatos["licencia_defecto"] = m_Revistas.NuloSiVacio(cmbLicenciaEditorial.Text)
  cDatos["url_licencia_defecto"] = m_Revistas.NuloSiVacio(txtUrlLicenciaEditorial.Text)
  cDatos["titular_copyright_defecto"] = m_Revistas.NuloSiVacio(txtTitularCopyrightEditorial.Text)
  cDatos["leyenda_distribucion"] = m_Revistas.NuloSiVacio(txtLeyendaDistribucionEditorial.Text)
  cDatos["aviso_responsabilidad"] = m_Revistas.NuloSiVacio(txaAvisoResponsabilidadEditorial.Text)

  ' --- 3. GRABACIÓN ---
  If Not m_Editorial.GuardarEditorial(hConnServidor, $iEditorialActual, cDatos) Then Return

  ' --- 4. RELECTURA MANTENIENDO LA SELECCIÓN ---
  ' EL NOMBRE PUEDE HABER CAMBIADO EL ORDEN DE LA GRILLA
  m_Sonido.sonar("Info")
  iEditorial = $iEditorialActual
  CargarEditoriales()
  SeleccionarEditorial(iEditorial)

End

' ============================================
' Función   : btnBorrarEditorial_Click
' Propósito : Borra la editorial elegida si no tiene revistas, con sus
'             créditos, después de confirmar (por ejemplo, una «(Nueva
'             editorial)» creada por error)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnBorrarEditorial_Click()

  Dim iFila As Integer
  Dim sCreditos As String

  ' --- 1. HAY EDITORIAL ELEGIDA ---
  If $iEditorialActual <= 0 Then Return
  iFila = $aIdsEditoriales.Find($iEditorialActual)
  If iFila < 0 Then Return

  ' --- 2. CONFIRMACIÓN; SE NOMBRAN LOS CRÉDITOS QUE SE VAN CON ELLA ---
  If gvCreditos.Rows.Count > 0 Then sCreditos = Chr(10) & Chr(10) & "También se borran sus " & CStr(gvCreditos.Rows.Count) & " créditos."
  m_Sonido.sonar("Question")
  If Message.Question("¿Borrar la editorial «" & gvEditoriales[iFila, 0].Text & "»?" & sCreditos, "Borrar", "Cancelar") <> 1 Then Return

  ' --- 3. BORRADO Y RELECTURA ---
  If Not m_Editorial.BorrarEditorial(hConnServidor, $iEditorialActual) Then Return
  m_Sonido.sonar("Info")
  CargarEditoriales()

End

' ============================================
' Función   : cmbLicenciaEditorial_Click
' Propósito : Al elegir una licencia del catálogo, completa su URL
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub cmbLicenciaEditorial_Click()

  ' CON LA CONEXIÓN DEL FORMULARIO (VER CargarPestanaEditorial)
  m_Licencias.CompletarUrl(cmbLicenciaEditorial, txtUrlLicenciaEditorial, hConnServidor)

End

' ============================================
' Función   : btnRevistasEditorial_Click
' Propósito : Abre las revistas de la editorial elegida y, al volver, relee
'             la grilla (la cantidad de revistas puede haber cambiado)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnRevistasEditorial_Click()

  Dim iFila As Integer
  Dim iEditorial As Integer

  ' --- 1. HAY EDITORIAL ELEGIDA ---
  If $iEditorialActual <= 0 Then Return
  iFila = $aIdsEditoriales.Find($iEditorialActual)

  ' --- 2. FORMULARIO HIJO, CON LA CONEXIÓN DEL FORMULARIO (PUEDE NO HABER
  ' SESIÓN). EL NOMBRE SALE DE LA GRILLA, QUE ES LO GUARDADO ---
  FRevistas.hConn = hConnServidor
  FRevistas.iIdEditorial = $iEditorialActual
  If iFila >= 0 Then FRevistas.sEditorial = gvEditoriales[iFila, 0].Text
  FRevistas.sUsuario = sUsuarioActual
  FRevistas.ShowModal()

  ' --- 3. RELECTURA MANTENIENDO LA SELECCIÓN ---
  iEditorial = $iEditorialActual
  CargarEditoriales()
  SeleccionarEditorial(iEditorial)

End

' ============================================
' Función   : CargarCreditos
' Propósito : Llena la grilla de créditos de la editorial elegida y deja el
'             editor de la fila vacío
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub CargarCreditos()

  Dim rDatos As Result
  Dim iFila As Integer

  ' --- 1. LIMPIEZA ---
  LimpiarCreditos()
  If $iEditorialActual <= 0 Then Return

  ' --- 2. LECTURA ---
  rDatos = m_Editorial.ListarCreditos(hConnServidor, $iEditorialActual)
  If Not rDatos Then Return

  ' --- 3. GRILLA; «Hasta» VACÍO ES UN CRÉDITO VIGENTE ---
  gvCreditos.Rows.Count = rDatos.Count
  iFila = 0
  While rDatos.Available
    $aIdsCreditos.Add(rDatos!id_credito)
    gvCreditos[iFila, 0].Text = rDatos!cargo
    gvCreditos[iFila, 1].Text = rDatos!nombre
    gvCreditos[iFila, 2].Text = CStr(rDatos!orden)
    gvCreditos[iFila, 3].Text = m_Editorial.TextoFecha(rDatos, "desde")
    gvCreditos[iFila, 4].Text = m_Editorial.TextoFecha(rDatos, "hasta")
    Inc iFila
    rDatos.MoveNext
  Wend

End

' ============================================
' Función   : LimpiarCreditos
' Propósito : Vacía la grilla y el editor de créditos; los botones quedan como
'             corresponde a «nada elegido»
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub LimpiarCreditos()

  ' --- 1. GRILLA ---
  gvCreditos.Rows.Count = 0
  $aIdsCreditos.Clear()

  ' --- 2. EDITOR DE LA FILA ---
  LimpiarEditorCredito()
  $iCreditoActual = -1

  ' --- 3. BOTONES: SIN EDITORIAL NO HAY ALTA; SIN CRÉDITO NO HAY GUARDAR NI BORRAR ---
  btnNuevoCredito.Enabled = $iEditorialActual > 0
  btnGuardarCredito.Enabled = False
  btnBorrarCredito.Enabled = False

End

' ============================================
' Función   : LimpiarEditorCredito
' Propósito : Deja vacíos los campos del crédito
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub LimpiarEditorCredito()

  txtCargoCredito.Text = ""
  txtNombreCredito.Text = ""
  spnOrdenCredito.Value = 0
  dtbDesdeCredito.Value = Null
  dtbHastaCredito.Value = Null

End

' ============================================
' Función   : gvCreditos_Click
' Propósito : Al elegir un crédito, lo carga en el editor de la fila
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub gvCreditos_Click()

  Dim iFila As Integer
  Dim rDatos As Result

  ' --- 1. FILA VÁLIDA ---
  iFila = gvCreditos.Row
  If iFila < 0 Or iFila >= $aIdsCreditos.Count Then Return

  ' --- 2. LECTURA ---
  rDatos = m_Editorial.CargarCredito(hConnServidor, $aIdsCreditos[iFila])
  If Not rDatos Then Return

  ' --- 3. CAMPOS ---
  $iCreditoActual = $aIdsCreditos[iFila]
  txtCargoCredito.Text = rDatos!cargo
  txtNombreCredito.Text = rDatos!nombre
  spnOrdenCredito.Value = rDatos!orden
  dtbDesdeCredito.Value = rDatos!desde
  ' NULL: VIGENTE. EL DateBox ACEPTA Null (MISMO USO QUE FMetadatosArticulo)
  dtbHastaCredito.Value = rDatos!hasta

  ' --- 4. BOTONES ---
  btnGuardarCredito.Enabled = True
  btnBorrarCredito.Enabled = True

End

' ============================================
' Función   : btnNuevoCredito_Click
' Propósito : Prepara el editor para un crédito nuevo. No graba nada: el alta
'             la hace «Guardar», porque cargo, nombre y desde son obligatorios
'             y un alta mínima necesitaría inventarlos
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnNuevoCredito_Click()

  ' --- 1. HAY EDITORIAL ELEGIDA ---
  If $iEditorialActual <= 0 Then Return

  ' --- 2. EDITOR VACÍO EN MODO ALTA (0) ---
  LimpiarEditorCredito()
  $iCreditoActual = 0
  btnGuardarCredito.Enabled = True
  btnBorrarCredito.Enabled = False
  txtCargoCredito.SetFocus()

End

' ============================================
' Función   : btnGuardarCredito_Click
' Propósito : Junta los valores del crédito y los graba por m_Editorial (alta
'             si es nuevo, edición si no)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnGuardarCredito_Click()

  Dim cDatos As New Collection
  Dim iCredito As Integer

  ' --- 1. HAY EDITORIAL Y UN CRÉDITO EN EDICIÓN (0 = ALTA) ---
  If $iEditorialActual <= 0 Then Return
  If $iCreditoActual < 0 Then Return

  ' --- 2. VALORES ---
  cDatos["cargo"] = m_Revistas.NuloSiVacio(txtCargoCredito.Text)
  cDatos["nombre"] = m_Revistas.NuloSiVacio(txtNombreCredito.Text)
  cDatos["orden"] = spnOrdenCredito.Value
  cDatos["desde"] = dtbDesdeCredito.Value
  cDatos["hasta"] = dtbHastaCredito.Value

  ' --- 3. GRABACIÓN ---
  iCredito = m_Editorial.GuardarCredito(hConnServidor, $iCreditoActual, $iEditorialActual, cDatos)
  If iCredito = 0 Then Return

  ' --- 4. RELECTURA Y SELECCIÓN DEL GRABADO ---
  m_Sonido.sonar("Info")
  CargarCreditos()
  SeleccionarCredito(iCredito)

End

' ============================================
' Función   : SeleccionarCredito
' Propósito : Ubica la grilla en un crédito y lo carga
' Parámetros: iIdCredito As Integer — crédito
' Retorna   : nada
' ============================================
Private Sub SeleccionarCredito(iIdCredito As Integer)

  Dim iFila As Integer

  iFila = $aIdsCreditos.Find(iIdCredito)
  If iFila < 0 Then Return
  gvCreditos.Row = iFila
  gvCreditos_Click()

End

' ============================================
' Función   : btnBorrarCredito_Click
' Propósito : Borra el crédito elegido, con confirmación (decisión de
'             Alberto, 12/11). La pregunta recuerda que una persona que deja
'             el cargo se cierra con «hasta»: borrarla la quita también de la
'             página legal de los números en que figuraba
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnBorrarCredito_Click()

  Dim iFila As Integer

  ' --- 1. HAY CRÉDITO GRABADO ELEGIDO ---
  If $iCreditoActual <= 0 Then Return
  iFila = $aIdsCreditos.Find($iCreditoActual)
  If iFila < 0 Then Return

  ' --- 2. CONFIRMACIÓN ---
  m_Sonido.sonar("Question")
  If Message.Question("¿Borrar el crédito «" & gvCreditos[iFila, 0].Text & ": " & gvCreditos[iFila, 1].Text & "»?" & Chr(10) & Chr(10) &
      "Si la persona dejó el cargo, conviene cargar «hasta» en lugar de borrar: así sigue figurando en los números en que estuvo.", "Borrar", "Cancelar") <> 1 Then Return

    ' --- 3. BORRADO Y RELECTURA ---
    If Not m_Editorial.BorrarCredito(hConnServidor, $iCreditoActual) Then Return
    m_Sonido.sonar("Info")
    CargarCreditos()

End

' ============================================
' Función   : btnVaciarHastaCredito_Click
' Propósito : Deja vacía la fecha «hasta»: el crédito queda vigente (se graba
'             NULL)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnVaciarHastaCredito_Click()

  dtbHastaCredito.Value = Null

End

' ============================================
' Función   : CargarPestanaCatalogos
' Propósito : Al entrar a la pestaña «Catálogos»: prepara grillas y combos
'             (una vez por apertura del formulario) y relee los roles y las
'             licencias del servidor
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub CargarPestanaCatalogos()

  Dim aIdiomas As String[]

  ' --- 1. GUARD: LA CONEXIÓN DEL ADMINISTRADOR TIENE QUE ESTAR ABIERTA ---
  If Not hConnServidor Then Return
  If Not hConnServidor.Opened Then Return

  ' --- 2. PREPARACIÓN, UNA SOLA VEZ ---
  If Not $bCatalogosPreparada Then
    ConfigurarGridsCatalogos()
    ' LOS IDIOMAS ACTIVOS, CON LA CONEXIÓN DEL FORMULARIO: FSysAdmin SE ABRE
    ' SIN SESIÓN Y m_Idiomas.LlenarCombo LEE DE mConn
    aIdiomas = m_Vocabularios.IdiomasActivos(hConnServidor)
    cmbIdiomaNombreRol.List = aIdiomas.Copy()
    cmbIdiomaTextoLicencia.List = aIdiomas.Copy()
    ' EL IDIOMA DEL VOCABULARIO EMPIEZA EN es, SI ESTÁ ACTIVO
    $bCargandoVoc = True
    cmbIdiomaVoc.List = aIdiomas.Copy()
    If aIdiomas.Find("es") >= 0 Then
      cmbIdiomaVoc.Index = aIdiomas.Find("es")
    Else If aIdiomas.Count > 0 Then
      cmbIdiomaVoc.Index = 0
    Endif
    $bCargandoVoc = False
    $bCatalogosPreparada = True
  Endif

  ' --- 3. DATOS FRESCOS ---
  CargarRolesCredit()
  CargarLicenciasTexto()
  CargarVocabulariosVoc()

End

' ============================================
' Función   : ConfigurarGridsCatalogos
' Propósito : Columnas de las cinco grillas de «Catálogos» (GV-58: conteo
'             fijo)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub ConfigurarGridsCatalogos()

  ' --- 1. ROLES ---
  With gvRolesCredit
    .Header = GridView.Horizontal
    .Columns.Count = COLUMNAS_ROLES_CREDIT
    .Columns[0].Title = "Rol (término de CRediT)"
    .Columns[0].Width = 300
    .Columns[1].Title = "URI"
    .Columns[1].Width = 560
    .Rows.Count = 0
  End With

  ' --- 2. NOMBRES DEL ROL ---
  With gvNombresRol
    .Header = GridView.Horizontal
    .Columns.Count = COLUMNAS_NOMBRES_ROL
    .Columns[0].Title = "Idioma"
    .Columns[0].Width = 90
    .Columns[1].Title = "Nombre"
    .Columns[1].Width = 700
    .Rows.Count = 0
  End With

  ' --- 3. LICENCIAS ---
  With gvLicenciasTexto
    .Header = GridView.Horizontal
    .Columns.Count = COLUMNAS_LICENCIAS_TEXTO
    .Columns[0].Title = "Licencia"
    .Columns[0].Width = 300
    .Columns[1].Title = "URL"
    .Columns[1].Width = 560
    .Rows.Count = 0
  End With

  ' --- 4. TEXTOS DE LA LICENCIA ---
  With gvTextosLicencia
    .Header = GridView.Horizontal
    .Columns.Count = COLUMNAS_TEXTOS_LICENCIA
    .Columns[0].Title = "Idioma"
    .Columns[0].Width = 90
    .Columns[1].Title = "Texto"
    .Columns[1].Width = 700
    .Rows.Count = 0
  End With

  ' --- 5. TÉRMINOS DEL VOCABULARIO ---
  With gvTerminosVoc
    .Header = GridView.Horizontal
    .Columns.Count = COLUMNAS_TERMINOS_VOC
    .Columns[0].Title = "Término"
    .Columns[0].Width = 520
    .Columns[1].Title = "Identificador"
    .Columns[1].Width = 160
    .Columns[2].Title = "Usos"
    .Columns[2].Width = 80
    .Rows.Count = 0
  End With

End

' ============================================
' Función   : CargarRolesCredit
' Propósito : Llena la grilla de roles y deja vacío lo de abajo
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub CargarRolesCredit()

  Dim rDatos As Result
  Dim iFila As Integer

  ' --- 1. LECTURA ---
  $aIdsRoles.Clear()
  gvRolesCredit.Rows.Count = 0
  rDatos = m_CreditRoles.ListarRoles(hConnServidor)

  ' --- 2. GRILLA, CON UN id POR FILA EN EL MISMO ORDEN ---
  If rDatos Then
    gvRolesCredit.Rows.Count = rDatos.Count
    iFila = 0
    While rDatos.Available
      $aIdsRoles.Add(rDatos!id)
      gvRolesCredit[iFila, 0].Text = rDatos!nombre
      ' SIN URI: UN ROL QUE NO ES DE CRediT; EL CANÓNICO LO ESCRIBE SIN vocab
      gvRolesCredit[iFila, 1].Text = m_Revistas.TextoDe(rDatos, "uri")
      Inc iFila
      rDatos.MoveNext
    Wend
  Endif

  ' --- 3. NADA ELEGIDO ---
  $iRolActual = 0
  LimpiarNombresRol()

End

' ============================================
' Función   : gvRolesCredit_Click
' Propósito : Al elegir un rol, muestra sus nombres por idioma
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub gvRolesCredit_Click()

  Dim iFila As Integer

  ' --- 1. FILA VÁLIDA ---
  iFila = gvRolesCredit.Row
  If iFila < 0 Or iFila >= $aIdsRoles.Count Then Return

  ' --- 2. NOMBRES DEL ROL ---
  $iRolActual = $aIdsRoles[iFila]
  CargarNombresRol()

End

' ============================================
' Función   : CargarNombresRol
' Propósito : Llena la grilla de nombres del rol elegido
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub CargarNombresRol()

  Dim rDatos As Result
  Dim iFila As Integer

  ' --- 1. LIMPIEZA ---
  LimpiarNombresRol()
  If $iRolActual <= 0 Then Return

  ' --- 2. LECTURA ---
  rDatos = m_CreditRoles.ListarNombres(hConnServidor, $iRolActual)
  If Not rDatos Then Return

  ' --- 3. GRILLA, CON UN IDIOMA POR FILA EN EL MISMO ORDEN ---
  gvNombresRol.Rows.Count = rDatos.Count
  iFila = 0
  While rDatos.Available
    $aIdiomasNombresRol.Add(rDatos!idioma)
    gvNombresRol[iFila, 0].Text = rDatos!idioma
    gvNombresRol[iFila, 1].Text = rDatos!nombre
    Inc iFila
    rDatos.MoveNext
  Wend

End

' ============================================
' Función   : LimpiarNombresRol
' Propósito : Vacía la grilla y el editor de nombres; los botones quedan como
'             corresponde a «nada elegido»
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub LimpiarNombresRol()

  ' --- 1. GRILLA ---
  gvNombresRol.Rows.Count = 0
  $aIdiomasNombresRol.Clear()

  ' --- 2. EDITOR ---
  EditorNombreRol(MODO_NINGUNO, "", "")

  ' --- 3. ALTA: SOLO CON UN ROL ELEGIDO ---
  btnNuevoNombreRol.Enabled = $iRolActual > 0

End

' ============================================
' Función   : EditorNombreRol
' Propósito : Pone el editor del nombre en un modo, con sus valores y sus
'             botones. En edición el idioma no se cambia: es la clave
'             (cambiarlo es borrar y dar de alta)
' Parámetros: iModo As Integer — MODO_NINGUNO, MODO_ALTA o MODO_EDICION
'             sIdioma As String — el idioma (vacío en alta y en ninguno)
'             sNombre As String — el nombre
' Retorna   : nada
' ============================================
Private Sub EditorNombreRol(iModo As Integer, sIdioma As String, sNombre As String)

  ' --- 1. ESTADO ---
  $iModoNombreRol = iModo
  $sIdiomaNombreRol = sIdioma

  ' --- 2. VALORES ---
  ' UN IDIOMA QUE YA NO ESTÁ ACTIVO NO ESTÁ EN EL COMBO (ReadOnly): SE VE EN
  ' LA GRILLA, Y LA CLAVE SALE DE $sIdiomaNombreRol
  If cmbIdiomaNombreRol.Find(sIdioma) >= 0 Then
    cmbIdiomaNombreRol.Text = sIdioma
  Else
    cmbIdiomaNombreRol.Index = -1
  Endif
  txtNombreRol.Text = sNombre

  ' --- 3. CONTROLES ---
  cmbIdiomaNombreRol.Enabled = iModo = MODO_ALTA
  txtNombreRol.Enabled = iModo <> MODO_NINGUNO
  btnGuardarNombreRol.Enabled = iModo <> MODO_NINGUNO
  btnBorrarNombreRol.Enabled = iModo = MODO_EDICION

End

' ============================================
' Función   : gvNombresRol_Click
' Propósito : Al elegir un nombre, lo carga en el editor para cambiarlo
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub gvNombresRol_Click()

  Dim iFila As Integer

  ' --- 1. FILA VÁLIDA ---
  iFila = gvNombresRol.Row
  If iFila < 0 Or iFila >= $aIdiomasNombresRol.Count Then Return

  ' --- 2. EDITOR EN MODO EDICIÓN ---
  EditorNombreRol(MODO_EDICION, $aIdiomasNombresRol[iFila], gvNombresRol[iFila, 1].Text)

End

' ============================================
' Función   : btnNuevoNombreRol_Click
' Propósito : Prepara el editor para el nombre del rol en otro idioma. No
'             graba nada: el alta la hace «Guardar»
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnNuevoNombreRol_Click()

  ' --- 1. HAY ROL ELEGIDO ---
  If $iRolActual <= 0 Then Return

  ' --- 2. EDITOR VACÍO EN MODO ALTA ---
  EditorNombreRol(MODO_ALTA, "", "")
  cmbIdiomaNombreRol.SetFocus()

End

' ============================================
' Función   : btnGuardarNombreRol_Click
' Propósito : Graba el nombre por m_CreditRoles (alta o edición) y lo deja
'             elegido en la grilla
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnGuardarNombreRol_Click()

  Dim sIdioma As String

  ' --- 1. HAY ROL Y UN NOMBRE EN EDICIÓN ---
  If $iRolActual <= 0 Then Return
  If $iModoNombreRol = MODO_NINGUNO Then Return

  ' --- 2. LA CLAVE: EN ALTA, EL COMBO; EN EDICIÓN, LA FILA ---
  If $iModoNombreRol = MODO_ALTA Then
    sIdioma = cmbIdiomaNombreRol.Text
  Else
    sIdioma = $sIdiomaNombreRol
  Endif

  ' --- 3. GRABACIÓN ---
  If Not m_CreditRoles.GuardarNombre(hConnServidor, $iRolActual, sIdioma, txtNombreRol.Text, $iModoNombreRol = MODO_ALTA) Then Return

  ' --- 4. RELECTURA Y SELECCIÓN DEL GRABADO ---
  m_Sonido.sonar("Info")
  CargarNombresRol()
  SeleccionarNombreRol(sIdioma)

End

' ============================================
' Función   : SeleccionarNombreRol
' Propósito : Ubica la grilla de nombres en un idioma y lo carga
' Parámetros: sIdioma As String — el idioma
' Retorna   : nada
' ============================================
Private Sub SeleccionarNombreRol(sIdioma As String)

  Dim iFila As Integer

  iFila = $aIdiomasNombresRol.Find(sIdioma)
  If iFila < 0 Then Return
  gvNombresRol.Row = iFila
  gvNombresRol_Click()

End

' ============================================
' Función   : btnBorrarNombreRol_Click
' Propósito : Borra el nombre del rol en el idioma elegido, con confirmación.
'             Lo publicado no cambia; lo que se componga después en ese
'             idioma lleva el término en inglés
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnBorrarNombreRol_Click()

  ' --- 1. HAY UN NOMBRE GRABADO ELEGIDO ---
  If $iRolActual <= 0 Then Return
  If $iModoNombreRol <> MODO_EDICION Then Return

  ' --- 2. CONFIRMACIÓN ---
  m_Sonido.sonar("Question")
  If Message.Question("¿Borrar el nombre en «" & $sIdiomaNombreRol & "»: «" & txtNombreRol.Text & "»?" & Chr(10) & Chr(10) &
      "Lo que se componga después en ese idioma va a llevar el término en inglés. Lo ya publicado no cambia.", "Borrar", "Cancelar") <> 1 Then Return

    ' --- 3. BORRADO Y RELECTURA ---
    If Not m_CreditRoles.BorrarNombre(hConnServidor, $iRolActual, $sIdiomaNombreRol) Then Return
    m_Sonido.sonar("Info")
    CargarNombresRol()

End

' ============================================
' Función   : CargarLicenciasTexto
' Propósito : Llena la grilla de licencias (las de contenido con url: sin url
'             no hay clave para el texto) y deja vacío lo de abajo
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub CargarLicenciasTexto()

  Dim rDatos As Result
  Dim iFila As Integer

  ' --- 1. LECTURA ---
  $aUrlsLicencias.Clear()
  gvLicenciasTexto.Rows.Count = 0
  rDatos = m_Licencias.ListarConUrl(hConnServidor)

  ' --- 2. GRILLA, CON UNA url POR FILA EN EL MISMO ORDEN ---
  If rDatos Then
    gvLicenciasTexto.Rows.Count = rDatos.Count
    iFila = 0
    While rDatos.Available
      $aUrlsLicencias.Add(rDatos!url)
      ' UNA INACTIVA SIGUE ACÁ: LA PUEDE TENER UN ARTÍCULO VIEJO
      If CBool(rDatos!activo) Then
        gvLicenciasTexto[iFila, 0].Text = rDatos!etiqueta
      Else
        gvLicenciasTexto[iFila, 0].Text = rDatos!etiqueta & " (inactiva)"
      Endif
      gvLicenciasTexto[iFila, 1].Text = rDatos!url
      Inc iFila
      rDatos.MoveNext
    Wend
  Endif

  ' --- 3. NADA ELEGIDO ---
  $sUrlLicenciaActual = ""
  LimpiarTextosLicencia()

End

' ============================================
' Función   : gvLicenciasTexto_Click
' Propósito : Al elegir una licencia, muestra sus textos por idioma
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub gvLicenciasTexto_Click()

  Dim iFila As Integer

  ' --- 1. FILA VÁLIDA ---
  iFila = gvLicenciasTexto.Row
  If iFila < 0 Or iFila >= $aUrlsLicencias.Count Then Return

  ' --- 2. TEXTOS DE LA LICENCIA ---
  $sUrlLicenciaActual = $aUrlsLicencias[iFila]
  CargarTextosLicencia()

End

' ============================================
' Función   : CargarTextosLicencia
' Propósito : Llena la grilla de textos de la licencia elegida
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub CargarTextosLicencia()

  Dim rDatos As Result
  Dim iFila As Integer

  ' --- 1. LIMPIEZA ---
  LimpiarTextosLicencia()
  If $sUrlLicenciaActual = "" Then Return

  ' --- 2. LECTURA ---
  rDatos = m_Licencias.ListarTextos(hConnServidor, $sUrlLicenciaActual)
  If Not rDatos Then Return

  ' --- 3. GRILLA, CON UN IDIOMA POR FILA EN EL MISMO ORDEN ---
  gvTextosLicencia.Rows.Count = rDatos.Count
  iFila = 0
  While rDatos.Available
    $aIdiomasTextosLicencia.Add(rDatos!idioma)
    gvTextosLicencia[iFila, 0].Text = rDatos!idioma
    gvTextosLicencia[iFila, 1].Text = rDatos!texto
    Inc iFila
    rDatos.MoveNext
  Wend

End

' ============================================
' Función   : LimpiarTextosLicencia
' Propósito : Vacía la grilla y el editor de textos; los botones quedan como
'             corresponde a «nada elegido»
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub LimpiarTextosLicencia()

  ' --- 1. GRILLA ---
  gvTextosLicencia.Rows.Count = 0
  $aIdiomasTextosLicencia.Clear()

  ' --- 2. EDITOR ---
  EditorTextoLicencia(MODO_NINGUNO, "", "")

  ' --- 3. ALTA: SOLO CON UNA LICENCIA ELEGIDA ---
  btnNuevoTextoLicencia.Enabled = $sUrlLicenciaActual <> ""

End

' ============================================
' Función   : EditorTextoLicencia
' Propósito : Pone el editor del texto en un modo, con sus valores y sus
'             botones. En edición el idioma no se cambia: es la clave
' Parámetros: iModo As Integer — MODO_NINGUNO, MODO_ALTA o MODO_EDICION
'             sIdioma As String — el idioma (vacío en alta y en ninguno)
'             sTexto As String — el texto
' Retorna   : nada
' ============================================
Private Sub EditorTextoLicencia(iModo As Integer, sIdioma As String, sTexto As String)

  ' --- 1. ESTADO ---
  $iModoTextoLicencia = iModo
  $sIdiomaTextoLicencia = sIdioma

  ' --- 2. VALORES ---
  ' UN IDIOMA QUE YA NO ESTÁ ACTIVO NO ESTÁ EN EL COMBO (ReadOnly): LA CLAVE
  ' SALE DE $sIdiomaTextoLicencia
  If cmbIdiomaTextoLicencia.Find(sIdioma) >= 0 Then
    cmbIdiomaTextoLicencia.Text = sIdioma
  Else
    cmbIdiomaTextoLicencia.Index = -1
  Endif
  txaTextoLicencia.Text = sTexto

  ' --- 3. CONTROLES ---
  cmbIdiomaTextoLicencia.Enabled = iModo = MODO_ALTA
  txaTextoLicencia.Enabled = iModo <> MODO_NINGUNO
  btnGuardarTextoLicencia.Enabled = iModo <> MODO_NINGUNO
  btnBorrarTextoLicencia.Enabled = iModo = MODO_EDICION

End

' ============================================
' Función   : gvTextosLicencia_Click
' Propósito : Al elegir un texto, lo carga en el editor para cambiarlo
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub gvTextosLicencia_Click()

  Dim iFila As Integer

  ' --- 1. FILA VÁLIDA ---
  iFila = gvTextosLicencia.Row
  If iFila < 0 Or iFila >= $aIdiomasTextosLicencia.Count Then Return

  ' --- 2. EDITOR EN MODO EDICIÓN ---
  EditorTextoLicencia(MODO_EDICION, $aIdiomasTextosLicencia[iFila], gvTextosLicencia[iFila, 1].Text)

End

' ============================================
' Función   : btnNuevoTextoLicencia_Click
' Propósito : Prepara el editor para el texto de la licencia en otro idioma.
'             No graba nada: el alta la hace «Guardar»
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnNuevoTextoLicencia_Click()

  ' --- 1. HAY LICENCIA ELEGIDA ---
  If $sUrlLicenciaActual = "" Then Return

  ' --- 2. EDITOR VACÍO EN MODO ALTA ---
  EditorTextoLicencia(MODO_ALTA, "", "")
  cmbIdiomaTextoLicencia.SetFocus()

End

' ============================================
' Función   : btnGuardarTextoLicencia_Click
' Propósito : Graba el texto por m_Licencias (alta o edición) y lo deja
'             elegido en la grilla
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnGuardarTextoLicencia_Click()

  Dim sIdioma As String

  ' --- 1. HAY LICENCIA Y UN TEXTO EN EDICIÓN ---
  If $sUrlLicenciaActual = "" Then Return
  If $iModoTextoLicencia = MODO_NINGUNO Then Return

  ' --- 2. LA CLAVE: EN ALTA, EL COMBO; EN EDICIÓN, LA FILA ---
  If $iModoTextoLicencia = MODO_ALTA Then
    sIdioma = cmbIdiomaTextoLicencia.Text
  Else
    sIdioma = $sIdiomaTextoLicencia
  Endif

  ' --- 3. GRABACIÓN ---
  If Not m_Licencias.GuardarTexto(hConnServidor, $sUrlLicenciaActual, sIdioma, txaTextoLicencia.Text, $iModoTextoLicencia = MODO_ALTA) Then Return

  ' --- 4. RELECTURA Y SELECCIÓN DEL GRABADO ---
  m_Sonido.sonar("Info")
  CargarTextosLicencia()
  SeleccionarTextoLicencia(sIdioma)

End

' ============================================
' Función   : SeleccionarTextoLicencia
' Propósito : Ubica la grilla de textos en un idioma y lo carga
' Parámetros: sIdioma As String — el idioma
' Retorna   : nada
' ============================================
Private Sub SeleccionarTextoLicencia(sIdioma As String)

  Dim iFila As Integer

  iFila = $aIdiomasTextosLicencia.Find(sIdioma)
  If iFila < 0 Then Return
  gvTextosLicencia.Row = iFila
  gvTextosLicencia_Click()

End

' ============================================
' Función   : btnBorrarTextoLicencia_Click
' Propósito : Borra el texto de la licencia en el idioma elegido, con
'             confirmación. Lo que se componga después en ese idioma lleva la
'             etiqueta
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnBorrarTextoLicencia_Click()

  ' --- 1. HAY UN TEXTO GRABADO ELEGIDO ---
  If $sUrlLicenciaActual = "" Then Return
  If $iModoTextoLicencia <> MODO_EDICION Then Return

  ' --- 2. CONFIRMACIÓN ---
  m_Sonido.sonar("Question")
  If Message.Question("¿Borrar el texto en «" & $sIdiomaTextoLicencia & "» de esta licencia?" & Chr(10) & Chr(10) &
      "Lo que se componga después en ese idioma va a llevar solo la etiqueta de la licencia. Lo ya publicado no cambia.", "Borrar", "Cancelar") <> 1 Then Return

    ' --- 3. BORRADO Y RELECTURA ---
    If Not m_Licencias.BorrarTexto(hConnServidor, $sUrlLicenciaActual, $sIdiomaTextoLicencia) Then Return
    m_Sonido.sonar("Info")
    CargarTextosLicencia()

End

' ============================================
' Función   : CargarVocabulariosVoc
' Propósito : Al entrar a la pestaña: relee la lista de vocabularios (uno
'             nuevo, escrito en otra sesión, aparece) sin perder el elegido,
'             y lista sus términos
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub CargarVocabulariosVoc()

  Dim sVocabulario As String

  ' --- 1. LA LISTA, CONSERVANDO EL ELEGIDO ---
  ' EL COMBO ES EDITABLE: UN VOCABULARIO NUEVO (TAMBIÉN UNO PROPIO) SE
  ' ESCRIBE, Y EXISTE CUANDO SE GUARDA SU PRIMER TÉRMINO (m_Vocabularios)
  $bCargandoVoc = True
  sVocabulario = Trim(cmbVocabularioVoc.Text)
  cmbVocabularioVoc.List = m_Vocabularios.Vocabularios(hConnServidor)
  If sVocabulario <> "" Then
    cmbVocabularioVoc.Text = sVocabulario
  Else If cmbVocabularioVoc.Count > 0 Then
    cmbVocabularioVoc.Index = 0
  Endif
  $bCargandoVoc = False

  ' --- 2. LOS TÉRMINOS ---
  CargarTerminosVoc(0)

End

' ============================================
' Función   : CargarTerminosVoc
' Propósito : Llena la grilla con los términos del vocabulario e idioma
'             elegidos que contienen lo buscado, y elige uno
' Parámetros: iElegido As Integer — id a dejar elegido; 0 ninguno
' Retorna   : nada
' ============================================
Private Sub CargarTerminosVoc(iElegido As Integer)

  Dim rDatos As Result
  Dim iFila As Integer

  ' --- 1. GRILLA, CON UN id POR FILA EN EL MISMO ORDEN ---
  $aIdsTerminosVoc.Clear()
  gvTerminosVoc.Rows.Count = 0
  If Trim(cmbVocabularioVoc.Text) <> "" And cmbIdiomaVoc.Index >= 0 Then
    rDatos = m_Vocabularios.ListarTerminos(hConnServidor, Trim(cmbVocabularioVoc.Text), cmbIdiomaVoc.Text, Trim(txtBuscarVoc.Text))
  Endif
  If rDatos Then
    gvTerminosVoc.Rows.Count = rDatos.Count
    While rDatos.Available
      $aIdsTerminosVoc.Add(rDatos!id_termino)
      gvTerminosVoc[iFila, 0].Text = rDatos!termino
      ' UN NULL VA A LA CELDA COMO VACÍO
      gvTerminosVoc[iFila, 1].Text = rDatos!identificador
      gvTerminosVoc[iFila, 2].Text = CStr(rDatos!usos)
      Inc iFila
      rDatos.MoveNext
    Wend
  Endif

  ' --- 2. ELEGIDO O EDITOR VACÍO ---
  iFila = $aIdsTerminosVoc.Find(iElegido)
  If iFila >= 0 Then
    gvTerminosVoc.Row = iFila
    MostrarFilaVoc(iFila)
  Else
    LimpiarEditorVoc()
  Endif

End

' ============================================
' Función   : LimpiarEditorVoc
' Propósito : Editor del término vacío y apagado
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub LimpiarEditorVoc()

  $iIdTerminoVoc = 0
  $bEditandoVoc = False
  txtTerminoVoc.Text = ""
  txtIdentificadorVoc.Text = ""
  lblEstadoVoc.Text = ""
  FijarEditorVoc(False)

End

' ============================================
' Función   : FijarEditorVoc
' Propósito : Habilita o apaga el editor del término
' Parámetros: bHabilitado As Boolean — True: hay término en edición
' Retorna   : nada
' ============================================
Private Sub FijarEditorVoc(bHabilitado As Boolean)

  hbxTerminoVoc.Enabled = bHabilitado
  hbxIdentificadorVoc.Enabled = bHabilitado
  btnGuardarTerminoVoc.Enabled = bHabilitado
  ' SOLO SE BORRA UN TÉRMINO QUE YA ESTÁ EN EL CATÁLOGO
  btnBorrarTerminoVoc.Enabled = bHabilitado And $iIdTerminoVoc > 0

End

' ============================================
' Función   : MostrarFilaVoc
' Propósito : Pone en el editor el término de una fila de la grilla
' Parámetros: iFila As Integer — fila
' Retorna   : nada
' ============================================
Private Sub MostrarFilaVoc(iFila As Integer)

  $iIdTerminoVoc = $aIdsTerminosVoc[iFila]
  $bEditandoVoc = True
  txtTerminoVoc.Text = gvTerminosVoc[iFila, 0].Text
  txtIdentificadorVoc.Text = gvTerminosVoc[iFila, 1].Text
  lblEstadoVoc.Text = "En " & gvTerminosVoc[iFila, 2].Text & " palabra(s) clave de artículos."
  FijarEditorVoc(True)

End

' ============================================
' Función   : gvTerminosVoc_Click
' Propósito : Elige un término para corregirlo
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub gvTerminosVoc_Click()

  If gvTerminosVoc.Row < 0 Or gvTerminosVoc.Row >= $aIdsTerminosVoc.Count Then Return
  MostrarFilaVoc(gvTerminosVoc.Row)

End

' ============================================
' Función   : cmbVocabularioVoc_Click
' Propósito : Otro vocabulario elegido de la lista: vuelve a listar
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub cmbVocabularioVoc_Click()

  If $bCargandoVoc Then Return
  CargarTerminosVoc(0)

End

' ============================================
' Función   : cmbVocabularioVoc_Change
' Propósito : Un vocabulario escrito a mano (también uno propio): vuelve a
'             listar
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub cmbVocabularioVoc_Change()

  If $bCargandoVoc Then Return
  CargarTerminosVoc(0)

End

' ============================================
' Función   : cmbIdiomaVoc_Click
' Propósito : Otro idioma: vuelve a listar
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub cmbIdiomaVoc_Click()

  If $bCargandoVoc Then Return
  CargarTerminosVoc(0)

End

' ============================================
' Función   : txtBuscarVoc_Change
' Propósito : Filtra la grilla mientras se tipea
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub txtBuscarVoc_Change()

  If $bCargandoVoc Then Return
  CargarTerminosVoc(0)

End

' ============================================
' Función   : btnNuevoTerminoVoc_Click
' Propósito : Prepara el alta de un término en el vocabulario e idioma
'             elegidos; se crea al guardar
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnNuevoTerminoVoc_Click()

  ' --- 1. HAY VOCABULARIO E IDIOMA ---
  If Trim(cmbVocabularioVoc.Text) = "" Or cmbIdiomaVoc.Index < 0 Then
    m_Sonido.sonar("Warning")
    Message.Warning("Elegí primero el vocabulario y el idioma.")
    Return
  Endif

  ' --- 2. EDITOR EN ALTA ---
  $iIdTerminoVoc = 0
  $bEditandoVoc = True
  ' LO BUSCADO SE PROPONE COMO TÉRMINO NUEVO
  txtTerminoVoc.Text = Trim(txtBuscarVoc.Text)
  txtIdentificadorVoc.Text = ""
  lblEstadoVoc.Text = "Término nuevo en " & Trim(cmbVocabularioVoc.Text) & " (" & cmbIdiomaVoc.Text & ")."
  FijarEditorVoc(True)
  txtTerminoVoc.SetFocus()

End

' ============================================
' Función   : btnGuardarTerminoVoc_Click
' Propósito : Graba el alta o la corrección por m_Vocabularios e informa
'             cuántos artículos no publicados se corrigieron
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnGuardarTerminoVoc_Click()

  Dim iCorregidos As Integer
  Dim sTermino As String
  Dim i As Integer

  ' --- 1. HAY QUÉ GUARDAR ---
  If Not $bEditandoVoc Then Return
  sTermino = Trim(txtTerminoVoc.Text)

  ' --- 2. GRABACIÓN ---
  iCorregidos = m_Vocabularios.GuardarTermino(hConnServidor, $iIdTerminoVoc, Trim(cmbVocabularioVoc.Text), cmbIdiomaVoc.Text, sTermino, Trim(txtIdentificadorVoc.Text))
  If iCorregidos < 0 Then Return

  ' --- 3. RELECTURA, CON EL TÉRMINO GRABADO ELEGIDO ---
  ' UN VOCABULARIO NUEVO ENTRA A LA LISTA CON SU PRIMER TÉRMINO. SE BUSCA
  ' POR SU FORMA EXACTA: LA BÚSQUEDA PUEDE TRAER OTROS QUE LO CONTIENEN
  m_Sonido.sonar("Info")
  $bCargandoVoc = True
  txtBuscarVoc.Text = sTermino
  $bCargandoVoc = False
  CargarVocabulariosVoc()
  For i = 0 To $aIdsTerminosVoc.Count - 1
    If gvTerminosVoc[i, 0].Text = sTermino Then
      gvTerminosVoc.Row = i
      MostrarFilaVoc(i)
      Break
    Endif
  Next
  If iCorregidos > 0 Then lblEstadoVoc.Text = "Guardado. Se corrigieron " & CStr(iCorregidos) & " palabra(s) clave de artículos no publicados."

End

' ============================================
' Función   : btnBorrarTerminoVoc_Click
' Propósito : Borra el término elegido, si ningún artículo lo usa
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnBorrarTerminoVoc_Click()

  ' --- 1. HAY UN TÉRMINO GRABADO ELEGIDO ---
  If $iIdTerminoVoc <= 0 Then Return

  ' --- 2. CONFIRMACIÓN ---
  m_Sonido.sonar("Question")
  If Message.Question("¿Borrar «" & txtTerminoVoc.Text & "» del catálogo?", "Borrar", "Cancelar") <> 1 Then Return

  ' --- 3. BORRADO Y RELECTURA ---
  If Not m_Vocabularios.BorrarTermino(hConnServidor, $iIdTerminoVoc) Then Return
  CargarTerminosVoc(0)

End
