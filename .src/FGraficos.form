          { cmbClase ComboBox
            Move(126,0,180,36)
            Expand = True
            ReadOnly = True
          }
          { cmbPaleta ComboBox
            Move(315,0,180,36)
            Expand = True
            ReadOnly = True
          }
          { Panel1 Panel
            Move(504,0,8,36)
          }
          { chkLeyenda CheckBox
            Move(522,0,99,36)
            AutoResize = True
            Text = ("Leyenda")
          }
        }
        { hbxEjeX HBox
          Move(9,81,756,36)
          { lblEjeX Label
            Move(0,0,126,36)
            Alignment = Align.Right
            Text = ("Eje horizontal ")
          }
          { txtEjeX TextBox
            Move(126,0,198,36)
            Expand = True
            Placeholder = ("Título del eje horizontal; vacío, sin título")
          }
        }
        { hbxEjeY HBox
          Move(9,117,756,36)
          { lblEjeY Label
            Move(0,0,126,36)
            Alignment = Align.Right
            Text = ("Eje vertical ")
          }
          { txtEjeY TextBox
            Move(126,0,198,36)
            Expand = True
            Placeholder = ("Título del eje vertical; vacío, sin título")
          }
        }
        { hbxOpciones HBox
          Move(9,153,756,36)
          { lblUnidad Label
            Move(0,0,126,36)
            Alignment = Align.Right
            Text = ("Unidad ")
          }
          { txtUnidad TextBox
            Move(126,0,126,36)
