            Text = ("Tipo ")
          }
          { cmbTipo ComboBox
            Move(126,0,180,36)
            Expand = True
            ReadOnly = True
          }
          { lblProporcion Label
            Move(315,0,126,36)
            Alignment = Align.Right
            Text = ("Proporción ")
          }
          { cmbProporcion ComboBox
            Move(441,0,126,36)
            Expand = True
