# Gambas Form File 3.0

{ Form Form
  Move(0,0,1048,720)
  #Scaled = False
  Text = ("Gráficos del proyecto")
  Arrangement = Arrange.Vertical
  Spacing = True
  Margin = True
  Padding = 4
  { mnuFila Menu
    Text = ("Fila")
    Visible = False
    { mnuFilaArriba Menu
      Text = ("Insertar una fila arriba")
    }
    { mnuFilaAbajo Menu
      Text = ("Insertar una fila abajo")
    }
    { mnuFilaQuitar Menu
      Text = ("Quitar la fila")
    }
  }
  { mnuColumna Menu
    Text = ("Columna")
    Visible = False
    { mnuColIzquierda Menu
      Text = ("Insertar una columna a la izquierda")
    }
    { mnuColDerecha Menu
      Text = ("Insertar una columna a la derecha")
    }
    { mnuColQuitar Menu
      Text = ("Quitar la columna")
    }
  }
  { hbxCuerpo HBox
    Move(9,9,1030,600)
    Expand = True
    Spacing = True
    { vbxLista VBox
      Move(0,9,207,378)
      Spacing = True
      Padding = 4
      { lblGraficos Label
        Move(9,9,180,36)
        Alignment = Align.Center
        Border = Border.Plain
        Text = ("Disponibles")
      }
      { lstGraficos ListBox
        Move(9,54,180,135)
        Expand = True
      }
      { hbxLista HBox
        Move(9,297,189,36)
        { btnNuevo Button
          Move(0,0,36,36)
          ToolTip = ("Agregar gráfico nuevo")
          Picture = Picture["iconos/+nuevo.png"]
        }
        { btnBorrarArchivo Button
          Move(36,0,36,36)
          ToolTip = ("Borrar el gráfico seleccionado y sus salidas")
          Picture = Picture["iconos/borrar.png"]
        }
        { btnDuplicar Button
          Move(72,0,36,36)
          ToolTip = ("Duplicar gráfico")
          Picture = Picture["iconos/duplicardocumento.png"]
        }
        { Spring1 Spring
          Move(117,0,36,36)
        }
      }
    }
    { vbxGrafico VBox
      Move(216,9,810,576)
      Expand = True
      Spacing = True
      Padding = 4
      { lblArchivo Label
        Move(9,0,792,36)
        Foreground = &H0000FF
        Alignment = Align.Center
        Border = Border.Plain
      }
      { tabGrafico TabStrip
        Move(9,36,792,531)
        Expand = True
        Arrangement = Arrange.Vertical
        Spacing = True
        Margin = True
        Padding = 4
        Count = 3
        Index = 0
        Text = ("Datos")
        Picture = Picture["iconos/datos.png"]
        { hbxDatos HBox
          Move(9,9,756,36)
          { btnFila MenuButton
            Move(0,0,144,36)
            Text = ("Fila")
            Menu = "mnuFila"
            MenuOnly = True
          }
          { btnColumna MenuButton
            Move(144,0,144,36)
            Text = ("Columna")
            Menu = "mnuColumna"
            MenuOnly = True
          }
          { spDatos Spring
            Move(288,0,36,36)
          }
          { btnImportarCSV Button
            Move(333,0,180,36)
            ToolTip = ("Reemplazar la tabla con los datos de un archivo CSV")
            Text = ("Importar CSV")
            Picture = Picture["iconos/abrirBuscar.png"]
          }
          { btnPasarFormulario Button
            Move(513,0,180,36)
            ToolTip = ("Volver al formulario si el archivo ya encaja en el formato")
            Text = ("Pasar al formulario")
            Picture = Picture["iconos/grilla.png"]
          }
          { btnColorear Button
            Move(693,0,144,36)
            Text = ("Colorear")
            Picture = Picture["iconos/colorear.png"]
          }
        }
        { txaTexto TextEdit
          Move(9,45,441,99)
          Visible = False
          Expand = True
        }
        { tvDatos TableView
          Move(9,153,351,126)
          Expand = True
          PopupMenu = "mnuFila"
        }
        Index = 1
        Text = ("Diseño")
        Picture = Picture["iconos/disenio.png"]
        { hbxTipo HBox
          Move(9,9,756,36)
          { lblTipo Label
            Move(0,0,126,36)
