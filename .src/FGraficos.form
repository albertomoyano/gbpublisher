          }
          { Panel2 Panel
            Move(261,0,8,36)
          }
          { chkApilado CheckBox
            Move(279,0,99,36)
            AutoResize = True
            Text = ("Apilado")
          }
          { chkCero CheckBox
            Move(387,0,153,36)
