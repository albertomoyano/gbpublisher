            Text = ("Eje desde cero")
          }
        }
        { lblSeries Label
          Move(9,198,756,36)
          Font = Font["Bold"]
          Text = ("Series que se dibujan (ninguna elegida: todas)")
        }
        { lstSeries ListBox
          Move(9,234,756,126)
