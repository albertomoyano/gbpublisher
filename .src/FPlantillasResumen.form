# Gambas Form File 3.0

{ Form Form
  Move(0,0,960,720)
  #Scaled = False
  Text = ("Plantillas de resumen estructurado")
  Resizable = False
  Centered = True
  Arrangement = Arrange.Vertical
  Spacing = True
  Margin = True
  Padding = 4
  { lblRevistaPlantillas Label
    Move(9,9,936,36)
    Foreground = &H0000FF
    Alignment = Align.Center
    Border = Border.Plain
  }
  { hbxPlantillas HBox
    Move(9,54,936,153)
    Spacing = True
    { gvPlantillas GridView
      Move(0,0,846,153)
      Expand = True
      Mode = Select.Single
      ShowCursor = True
      Header = GridView.Horizontal
    }
    { vbxBotonesPlantillas VBox
      Move(855,0,36,153)
      { btnNuevaPlantilla Button
        Move(0,0,36,36)
        ToolTip = ("Nueva plantilla")
        Picture = Picture["iconos/+nuevo.png"]
      }
      { btnBorrarPlantilla Button
        Move(0,36,36,36)
        ToolTip = ("Borrar la plantilla elegida (solo si ninguna sección la usa)")
        Picture = Picture["iconos/borrar.png"]
      }
    }
  }
  { hbxNombrePlantilla HBox
    Move(9,216,936,36)
    { lblNombrePlantilla Label
      Move(0,0,170,36)
      Alignment = Align.Right
      Text = ("nombre: ")
    }
    { txtNombrePlantilla TextBox
      Move(173,0,450,36)
      Expand = True
      Placeholder = ("Por ejemplo: IMRyD")
    }
    { chkActivaPlantilla CheckBox
      Move(630,0,200,36)
      Text = ("Activa")
    }
  }
  { hbxIdiomaPlantilla HBox
    Move(9,261,936,36)
    { lblIdiomaPlantilla Label
      Move(0,0,170,36)
      Alignment = Align.Right
      Text = ("idioma-de-los-títulos: ")
    }
    { cmbIdiomaPlantilla ComboBox
      Move(173,0,144,36)
      ReadOnly = True
    }
  }
  { hbxSeccionesPlantilla HBox
    Move(9,306,936,198)
    Expand = True
    Spacing = True
    { gvSeccionesPlantilla GridView
      Move(0,0,846,198)
      Expand = True
      Mode = Select.Single
      ShowCursor = True
      Header = GridView.Horizontal
    }
    { vbxBotonesSeccionesPlantilla VBox
      Move(855,0,36,144)
      { btnNuevaSeccionPlantilla Button
        Move(0,0,36,36)
        ToolTip = ("Agregar una sección al final")
        Picture = Picture["iconos/+nuevo.png"]
      }
      { btnQuitarSeccionPlantilla Button
        Move(0,36,36,36)
        ToolTip = ("Quitar la sección elegida")
        Picture = Picture["iconos/borrar.png"]
      }
      { btnSubirSeccionPlantilla Button
        Move(0,72,36,36)
        Text = ("▲")
      }
      { btnBajarSeccionPlantilla Button
        Move(0,108,36,36)
        Text = ("▼")
      }
    }
  }
  { hbxCodigoSeccionPlantilla HBox
    Move(9,513,936,36)
    { lblCodigoSeccionPlantilla Label
      Move(0,0,170,36)
      Alignment = Align.Right
      Text = ("código: ")
    }
    { txtCodigoSeccionPlantilla TextBox
      Move(173,0,450,36)
      Expand = True
      Placeholder = ("minúsculas, dígitos y guiones: introduccion, metodos, resultados")
    }
  }
  { hbxTituloSeccionPlantilla HBox
    Move(9,558,936,36)
    { lblTituloSeccionPlantilla Label
      Move(0,0,170,36)
      Alignment = Align.Right
      Text = ("título: ")
    }
    { txtTituloSeccionPlantilla TextBox
      Move(173,0,450,36)
      Expand = True
      Placeholder = ("Lo que se imprime en el idioma elegido: Métodos, Methods…")
    }
  }
  { hbxBotonesPlantilla HBox
    Move(9,603,936,36)
    { lblAvisoPlantilla Label
      Move(0,0,450,36)
      Foreground = &H0000FF
      Expand = True
      Text = ("Todas las secciones son obligatorias en el artículo.")
    }
    { btnGuardarPlantilla Button
      Move(630,0,144,36)
      Text = ("Guardar")
      Picture = Picture["iconos/guardarComo.png"]
    }
    { btnCerrar Button
      Move(783,0,144,36)
      Text = ("Cerrar")
      Picture = Picture["iconos/salir.png"]
    }
  }
}
