# Gambas Form File 3.0

{ Form Form
  Move(0,0,960,600)
  #Scaled = False
  Resizable = False
  Arrangement = Arrange.Vertical
  Spacing = True
  Margin = True
  Padding = 4
  { hbxEncabezado HBox
    Move(18,18,783,36)
    { lblEncabezado Label
      Move(441,0,225,36)
      Expand = True
    }
  }
  { gvVariantes GridView
    Move(405,180,144,144)
    Expand = True
  }
  { txtOraciones TextArea
    Move(387,351,144,144)
    Background = Color.Background
    Expand = True
    ReadOnly = True
    Wrap = True
    ScrollBar = Scroll.Vertical
  }
  { hbxBotones HBox
    Move(63,540,783,36)
    { Spring1 Spring
      Move(279,0,45,36)
    }
    { btnCerrar Button
      Move(630,0,144,36)
      Text = ("Cerrar")
      Picture = Picture["iconos/salir.png"]
    }
  }
}
