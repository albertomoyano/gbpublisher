    }
  }
  { gvVariantes GridView
    MoveScaled(26,8,16,16)
    Expand = True
  }
  { hbxEjemplos HBox
    MoveScaled(1,26,87,4)
    { lblEjemplos Label
      MoveScaled(27,0,46,4)
      Expand = True
    }
  }
  { gvEjemplos GridView
    MoveScaled(43,39,16,16)
    Expand = True
  }
  { hbxBotones HBox
