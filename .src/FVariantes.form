# Gambas Form File 3.0

{ Form Form
  Move(0,0,960,640)
  #Scaled = False
  Resizable = False
  Arrangement = Arrange.Vertical
  Spacing = True
  Margin = True
  Padding = 4
  { hbxEncabezado HBox
    Move(18,18,783,36)
    { lblEncabezado Label
      Move(441,0,225,36)
      Expand = True
    }
  }
  { gvVariantes GridView
    Move(405,180,144,144)
    Expand = True
  }
  { lblEjemplos Label
    Move(18,330,783,28)
  }
  { gvEjemplos GridView
    Move(387,351,144,144)
    Expand = True
  }
  { hbxBotones HBox
    Move(63,540,783,36)
    { Spring1 Spring
      Move(279,0,45,36)
    }
    { btnActualizar Button
      Move(486,0,144,36)
      Font = Font["Bold"]
      Background = &H9FFF7F
      Text = ("Actualizar")
      Picture = Picture["iconos/enviar.png"]
    }
    { btnCerrar Button
      Move(630,0,144,36)
      Text = ("Cerrar")
      Picture = Picture["iconos/salir.png"]
    }
  }
}
