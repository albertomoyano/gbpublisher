# Gambas Form File 3.0

{ Form Form
  Move(0,0,960,720)
  #Scaled = False
  Text = ("Contribuyente del artículo")
  Resizable = False
  Arrangement = Arrange.Vertical
  AutoResize = True
  Centered = True
  Spacing = True
  Margin = True
  Padding = 4
  { lblNombreContribuyente Label
    Move(9,9,774,36)
    Foreground = &H0000FF
    Alignment = Align.Center
    Border = Border.Plain
  }
  { hbxColectivoContribuyente HBox
    Move(9,45,774,36)
    { lblColectivoContribuyente Label
      Move(0,0,170,36)
      Alignment = Align.Right
      Text = ("colectivo: ")
    }
    { txtColectivoContribuyente TextBox
      Move(173,0,590,36)
      Expand = True
      Placeholder = ("collab: nombre del grupo o institución autora")
    }
  }
  { hbxRolContribuyente HBox
    Move(9,81,774,36)
    { lblRolContribuyente Label
      Move(0,0,170,36)
      Alignment = Align.Right
      Text = ("rol: ")
    }
    { cmbRolContribuyente ComboBox
      Move(173,0,590,36)
      Expand = True
      ReadOnly = True
    }
  }
  { hbxCorrespondenciaContribuyente HBox
    Move(9,117,774,36)
    { lblCorrespondenciaContribuyente Label
      Move(0,0,170,36)
      Alignment = Align.Right
      Text = ("correspondencia: ")
    }
    { chkCorrespondenciaContribuyente CheckBox
      Move(173,0,590,36)
      Expand = True
      Text = ("Autor de correspondencia (el email es obligatorio)")
    }
  }
  { hbxEmailContribuyente HBox
    Move(9,153,774,36)
    { lblEmailContribuyente Label
      Move(0,0,170,36)
      Alignment = Align.Right
      Text = ("email: ")
    }
    { txtEmailContribuyente TextBox
      Move(173,0,590,36)
      Expand = True
      Placeholder = ("Email en este artículo")
    }
  }
  { hbxCreditContribuyente HBox
    Move(9,189,774,36)
    { lblCreditContribuyente Label
      Move(0,0,170,36)
      Alignment = Align.Right
      Text = ("CRediT: ")
    }
    { btnCreditContribuyente Button
      Move(170,0,36,36)
      ToolTip = ("Elegir los roles CRediT")
      Picture = Picture["iconos/autores-varios.png"]
    }
    { txtCreditContribuyente TextBox
      Move(234,0,529,36)
      Background = Color.Background
      Foreground = &H0000FF
      Expand = True
      ReadOnly = True
    }
  }
  { hbxNotasContribuyente HBox
    Move(9,225,774,36)
    { lblNotasContribuyente Label
      Move(0,0,170,36)
      Alignment = Align.Right
      Text = ("notas: ")
    }
    { txtNotasContribuyente TextBox
      Move(173,0,590,36)
      Expand = True
      Placeholder = ("Opcional: nota interna sobre este contribuyente")
    }
  }
  { lblAfiliacionesContribuyente Label
    Move(9,270,774,36)
    Foreground = &H0000FF
    Text = ("Afiliaciones en este artículo")
  }
  { hbxAfiliaciones HBox
    Move(9,306,774,144)
    Spacing = True
    Padding = 4
    { gvAfiliaciones GridView
      Move(0,0,684,108)
      Expand = True
      Mode = Select.Single
      Padding = 0
      ShowCursor = True
      Header = GridView.Horizontal
    }
    { vbxBotonesAfiliacion VBox
      Move(720,0,36,144)
      { btnNuevaAfiliacion Button
        Move(0,0,36,36)
        ToolTip = ("Agregar una afiliación")
        Picture = Picture["iconos/+nuevo.png"]
      }
      { btnQuitarAfiliacion Button
        Move(0,36,36,36)
        ToolTip = ("Quitar la afiliación elegida")
        Picture = Picture["iconos/borrar.png"]
      }
      { btnSubirAfiliacion Button
        Move(0,72,36,36)
        Text = ("▲")
      }
      { btnBajarAfiliacion Button
        Move(9,108,36,36)
        Text = ("▼")
      }
    }
  }
  { hbxInstitucionAfiliacion HBox
    Move(9,450,774,36)
    { lblInstitucionAfiliacion Label
      Move(0,0,170,36)
      Alignment = Align.Right
      Text = ("institución: ")
    }
    { txtInstitucionAfiliacion TextBox
      Move(173,0,590,36)
      Expand = True
      Placeholder = ("Obligatoria")
    }
  }
  { hbxDepartamentoAfiliacion HBox
    Move(9,486,774,36)
    { lblDepartamentoAfiliacion Label
      Move(0,0,170,36)
      Alignment = Align.Right
      Text = ("departamento: ")
    }
    { txtDepartamentoAfiliacion TextBox
      Move(173,0,590,36)
      Expand = True
    }
  }
  { hbxLugarAfiliacion HBox
    Move(9,522,774,36)
    { lblCiudadAfiliacion Label
      Move(0,0,170,36)
      Alignment = Align.Right
      Text = ("ciudad: ")
    }
    { txtCiudadAfiliacion TextBox
      Move(173,0,234,36)
      Expand = True
    }
    { lblPaisAfiliacion Label
      Move(414,0,90,36)
      Alignment = Align.Right
      Text = ("país: ")
    }
    { txtPaisAfiliacion TextBox
      Move(504,0,234,36)
      Expand = True
    }
  }
  { hbxRorAfiliacion HBox
    Move(9,558,774,36)
    { lblRorAfiliacion Label
      Move(0,0,170,36)
      Alignment = Align.Right
      Text = ("ROR: ")
    }
    { txtRorAfiliacion TextBox
      Move(173,0,590,36)
      Expand = True
      Placeholder = ("https://ror.org/0xxxxxxNN (también se acepta el id solo)")
    }
  }
  { hbxBotonesContribuyente HBox
    Move(9,594,952,36)
    { Spring1 Spring
      Move(369,0,36,36)
    }
    { btnAceptarContribuyente Button
      Move(468,0,144,36)
      Text = ("Aceptar")
      Picture = Picture["iconos/ok.png"]
    }
    { btnCerrar Button
      Move(612,0,144,36)
      Text = ("Cerrar")
      Picture = Picture["iconos/salir.png"]
    }
  }
}
