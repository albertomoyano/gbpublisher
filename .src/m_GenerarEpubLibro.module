' Gambas module file

' ==========================================================
' MÓDULO    : m_GenerarEpubLibro
' PROPÓSITO : Prepara el EPUB 3 del libro desde la base y lo entrega a
'             engine/generar_epub_libro.sh (SC-13).
'
' LA FRONTERA
' ----------------------------------------------------------
'   En Gambas queda solo lo que sale de la base: las páginas de portada,
'   créditos y colofón, el nav.xhtml, el content.opf y la lista de piezas.
'   Todo se escribe a disco, en tmp/epub-work/, ANTES de lanzar el script.
'
'   El script hace lo demás: copia recursos, transforma cada capítulo, escribe
'   mimetype y container.xml, verifica que cada archivo que el OPF declara
'   exista, empaqueta y valida. Si el OPF declara algo que no se generó, no
'   empaqueta.
'
' QUÉ PIEZAS LLEVA EL EPUB
' ----------------------------------------------------------
'   Lo decide la matriz editorial, m_PiezasLibro. El EPUB toma de su canónico
'   las piezas con cuerpo. De las sin cuerpo: los índices y las listas se
'   omiten; el colofón es la página propia que se escribe acá. La
'   bibliografía depende de lugar_bibliografia: por capítulo, viaja dentro
'   de cada capítulo; consolidada, es una página propia,
'   chapters/bibliografia.xhtml, en el lugar de la pieza bibliografia si el
'   libro la declara y con su título, o al final, antes del colofón, como en
'   el PDF (SC-31). Gambas deja la bibliografía del libro con el título
'   puesto en tmp/epub-bibliografia.xml; el script la transforma y los
'   capítulos enlazan sus citas a esa página.
'
' LAS PRIMERAS (SC-25)
' ----------------------------------------------------------
'   La portadilla no va. La portada (titlepage) va solo si el libro la
'   declara, igual que en el PDF. Los créditos (copyright-page) van siempre:
'   con los textos digitales si el libro declara la pieza y los tiene; si no,
'   el bloque genérico. La tapa (cover) va siempre, en front-tapa.xhtml.
'   Los nombres de la portada van en mayúsculas y minúsculas, sin
'   versalitas: los lectores de EPUB no las respetan de forma pareja.
'
' ANTES DE ESTA VERSIÓN
' ----------------------------------------------------------
'   Cada página leía los metadatos por su cuenta —cinco lecturas de la base
'   por EPUB—, los datos se insertaban sin escapar —una editorial con «&»
'   dejaba el OPF mal formado—, el estilo de cita se resolvía con el nombre
'   del .csl en vez de su ruta, el id del proyecto salía de un control de
'   FMain (RC-GM-16) y el OPF listaba todas las piezas de la base, incluidas
'   las que nunca se generan.
' ==========================================================

' PLAZO EN SEGUNDOS ANTES DE PREGUNTAR SI SEGUIR ESPERANDO
Private Const PLAZO_EPUB As Float = 900.0

' NOMBRES FIJOS DEL PAQUETE. DEBEN COINCIDIR CON engine/generar_epub_libro.sh:
' SI DIVERGEN, LA VERIFICACIÓN DEL OPF DEL SCRIPT LO ATRAPA
Private Const CSS_EPUB As String = "gbpublisher-epub-libro.css"
' PÁGINA DE LA BIBLIOGRAFÍA CONSOLIDADA: TAMBIÉN EN docbook-to-epub.xsl
' ($archivoBibliografia) Y EN EL SCRIPT
Private Const PAGINA_BIBLIOGRAFIA As String = "bibliografia.xhtml"
' LA BIBLIOGRAFÍA DEL LIBRO CON EL TÍTULO DE LA PÁGINA, EN tmp/. SU PRESENCIA
' LE DICE AL SCRIPT QUE LA BIBLIOGRAFÍA ES CONSOLIDADA
Private Const ARCHIVO_BIBLIO_EPUB As String = "epub-bibliografia.xml"
' TÍTULO DE LA PÁGINA SI EL LIBRO NO DECLARA LA PIEZA: EL DE LA BIBLIOGRAFÍA
' QUE ESCRIBE GenerarBiblioLibroXML, EL MISMO QUE MUESTRA EL HTML
Private Const TITULO_BIBLIOGRAFIA As String = "Referencias"

' RUTAS Y LIBRO DE LA GENERACIÓN EN CURSO
Private $sRutaProyecto As String
Private $sRutaEpubWork As String
Private $sRutaOEBPS As String
Private $iIdLibro As Integer

' PRIMERAS DECLARADAS EN EL LIBRO. LAS DEJA ListaPiezasEpub, QUE YA RECORRE
' LAS PIEZAS
Private $bHayPortada As Boolean
Private $bHayCreditos As Boolean

' PIEZAS QUE VAN EN EL SPINE PERO NO EN EL NAV, COMO LA DEDICATORIA, QUE EN EL
' PDF NO ENTRA AL SUMARIO (SC-31). CLAVE: nombre_archivo. LA LLENA
' ListaPiezasEpub CON m_PiezasLibro.VaEnIndice
Private $cSinIndice As Collection

' BIBLIOGRAFÍA CONSOLIDADA. LA POSICIÓN Y EL TÍTULO LOS DEJA ListaPiezasEpub:
' ÍNDICE EN LA LISTA DE PIEZAS ANTES DEL CUAL VA LA PÁGINA, O -1 SI EL LIBRO
' NO DECLARA LA PIEZA (VA AL FINAL). $bPaginaBibliografia LO DECIDE
' PrepararBibliografia: SOLO SI ES CONSOLIDADA Y TIENE ENTRADAS
Private $iPosBibliografia As Integer
Private $sTituloBibliografia As String
Private $bPaginaBibliografia As Boolean

' ============================================
' Función   : GenerarEpubLibro
' Propósito : Punto de entrada de la salida EPUB del libro.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub GenerarEpubLibro()

  ' --- 1. INICIALIZACIÓN ---
  Dim aPiezas As String[]
  Dim aArgumentos As New String[]
  Dim cMeta As Collection
  Dim cValores As Collection
  Dim sAutores As String
  Dim sPagina As String
  Dim sNombreEpub As String
  Dim sEstiloCita As String
  Dim iResultado As Integer

  ' --- 2. PROYECTO Y LIBRO ---
  $sRutaProyecto = m_InicioCierre.RutaProyectoEnCurso
  If $sRutaProyecto = "" Then
    m_Sonido.sonar("Warning")
    Message.Warning("No hay ningún proyecto abierto.")
    Return
  Endif

  $sRutaEpubWork = $sRutaProyecto &/ "tmp" &/ "epub-work"
  $sRutaOEBPS = $sRutaEpubWork &/ "OEBPS"

  ' EL ID DEL PROYECTO SALE DE LA GLOBAL DE SESIÓN Y NO DEL ValueBox DE FMain
  ' (RC-GM-16)
  $iIdLibro = m_XML.ObtenerIdLibro(m_InicioCierre.IdProyectoEnCurso)
  If $iIdLibro = 0 Then
    m_Sonido.sonar("Warning")
    Message.Warning("No hay libro asociado a este proyecto.")
    Return
  Endif

  ' --- 3. PIEZAS SEGÚN LA MATRIZ EDITORIAL ---
  aPiezas = ListaPiezasEpub()
  If Not aPiezas Then Return
  If aPiezas.Count = 0 Then
    m_Sonido.sonar("Warning")
    Message.Warning("El libro no tiene piezas con cuerpo para el EPUB.")
    Return
  Endif

  ' --- 4. METADATOS: UNA SOLA LECTURA PARA TODO EL PAQUETE ---
  cMeta = LeerMetadatosLibro()
  If Not cMeta Then Return
  sAutores = LeerAutoresLibro()

  ' LOS VALORES DE LAS PRIMERAS: AUTORÍA, LEYENDA Y MARCADORES (SC-25)
  cValores = m_PrimerasLibro.LeerValores($iIdLibro)
  If Not cValores Then
    m_Sonido.sonar("Error")
    Message.Error(m_PrimerasLibro.UltimoError())
    Return
  Endif

  ' LOS LOGOS SE VERIFICAN ANTES DE ESCRIBIR NADA
  If Not VerificarLogo(cMeta["logo_portada"], "de portada") Then Return
  If Not VerificarLogo(cMeta["logo_coleccion"], "de colección") Then Return

  ' BIBLIOGRAFÍA CONSOLIDADA: ANTES DEL NAV Y DEL OPF, QUE LA DECLARAN
  If Not PrepararBibliografia(cMeta) Then Return

  ' --- 5. ÁRBOL DE TRABAJO ---
  If Not PrepararArbol() Then Return

  ' --- 6. LO QUE SALE DE LA BASE, A DISCO ---
  ' EL OPF VA ÚLTIMO SOLO POR LEGIBILIDAD: NO DEPENDE DE LOS DEMÁS. EL SCRIPT
  ' VERIFICA DESPUÉS QUE TODO LO QUE DECLARA EXISTA
  If Not EscribirArchivo($sRutaOEBPS &/ "chapters" &/ "front-tapa.xhtml", ArmarTapa(cMeta, sAutores)) Then Return

  If $bHayPortada Then
    If Not EscribirArchivo($sRutaOEBPS &/ "chapters" &/ "front-portada.xhtml", ArmarPortada(cMeta, cValores)) Then Return
  Endif

  ' LOS CRÉDITOS PUEDEN FALLAR AL CONVERTIR LOS TEXTOS: EN ESE CASO YA
  ' AVISARON Y DEVUELVEN VACÍO
  sPagina = ArmarCreditos(cMeta, sAutores, cValores)
  If sPagina = "" Then Return
  If Not EscribirArchivo($sRutaOEBPS &/ "chapters" &/ "front-creditos.xhtml", sPagina) Then Return
  If Not EscribirArchivo($sRutaOEBPS &/ "chapters" &/ "bm-99-colofon.xhtml", ArmarColofon(cMeta)) Then Return
  If Not EscribirArchivo($sRutaOEBPS &/ "nav.xhtml", ArmarNav(cMeta, aPiezas)) Then Return
  If Not EscribirArchivo($sRutaOEBPS &/ "content.opf", ArmarOPF(cMeta, aPiezas)) Then Return

  ' LA LISTA QUE EL SCRIPT TRANSFORMA: LAS MISMAS PIEZAS, EN EL MISMO ORDEN,
  ' QUE EL OPF DECLARA
  If Not EscribirArchivo($sRutaProyecto &/ "tmp" &/ "epub-capitulos.txt", aPiezas.Join(Chr(10)) & Chr(10)) Then Return

  ' --- 7. NOMBRE DEL ARCHIVO Y ESTILO DE CITA ---
  sNombreEpub = NombreArchivoEpub(cMeta)
  sEstiloCita = m_GenerarSalidasLibro.ResolverEstiloCita($iIdLibro)

  ' --- 8. GENERACIÓN ---
  aArgumentos.Add($sRutaProyecto)
  aArgumentos.Add(sNombreEpub)
  aArgumentos.Add(sEstiloCita)

  iResultado = m_GenerarSalidasLibro.EjecutarScriptSalida("generar_epub_libro.sh", aArgumentos, PLAZO_EPUB)

  ' --- 9. INFORME ---
  m_GenerarSalidasLibro.InformarResultado(iResultado, "El EPUB del libro",
    $sRutaProyecto &/ "salidas" &/ "epub" &/ sNombreEpub)

End

' ============================================
' Función   : ListaPiezasEpub
' Propósito : Las piezas que el EPUB toma de su canónico, en orden editorial
'             fm → a → bm. Es la fuente única del spine, el manifest, el nav y
'             la lista que transforma el script.
' Parámetros: (ninguno)
' Retorna   : String[] — nombre_archivo de cada pieza, o Null si falló la
'             consulta; en ese caso el motivo ya se informó
' ============================================
Private Function ListaPiezasEpub() As String[]

  ' --- 1. INICIALIZACIÓN ---
  Dim aPiezas As New String[]
  Dim hPiezas As Result
  Dim sTipo As String

  ' --- 2. CONSULTA ---
  ' POR id_libro, COMO EL MANIFIESTO DEL CANÓNICO. EL ORDEN ES EL MISMO.
  ' nombre_archivo IS NOT NULL: EL ABM PERMITE GUARDAR UNA PIEZA SIN NOMBRE
  Try hPiezas = m_ConexionBD.mConn.Exec(
    "SELECT nombre_archivo, tipo_capitulo, titulo_capitulo FROM capitulos " &
    "WHERE id_libro = &1 " &
    "AND nombre_archivo IS NOT NULL " &
    "ORDER BY " & m_OrdenPiezas.ClausulaOrden("nombre_archivo"), $iIdLibro)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudieron leer las piezas del libro:" & gb.NewLine & Error.Text)
    Return Null
  Endif

  ' --- 3. FILTRO POR LA MATRIZ ---
  ' SOLO LAS QUE EL EPUB TOMA DE SU CANÓNICO. LAS DERIVADAS SE RESUELVEN
  ' APARTE Y LAS OMITIDAS NO VAN. LA DECISIÓN ES DE m_PiezasLibro, NO DE UNA
  ' LISTA ESCRITA ACÁ. DE PASO SE ANOTA SI EL LIBRO DECLARA PORTADA Y
  ' CRÉDITOS, QUE EL EPUB RESUELVE COMO PÁGINAS PROPIAS (SC-25)
  $bHayPortada = False
  $bHayCreditos = False
  $cSinIndice = New Collection
  $iPosBibliografia = -1
  $sTituloBibliografia = ""

  While hPiezas.Available
    sTipo = "capitulo"
    If Not IsNull(hPiezas["tipo_capitulo"]) Then
      If m_XML.TrimUTF8(hPiezas["tipo_capitulo"]) <> "" Then sTipo = m_XML.TrimUTF8(hPiezas["tipo_capitulo"])
    Endif

    If m_PiezasLibro.Tratamiento(sTipo, m_PiezasLibro.SALIDA_EPUB) = m_PiezasLibro.TRATAMIENTO_CUERPO Then
      aPiezas.Add(m_XML.TrimUTF8(hPiezas["nombre_archivo"]))
      ' EN LA LECTURA SÍ, EN EL ÍNDICE NO: LA DEDICATORIA (VaEnIndice)
      If Not m_PiezasLibro.VaEnIndice(sTipo) Then
        $cSinIndice[m_XML.TrimUTF8(hPiezas["nombre_archivo"])] = True
      Endif
    Endif

    If sTipo = "portada" Then $bHayPortada = True
    If sTipo = "creditos" Then $bHayCreditos = True

    ' LA PIEZA bibliografia FIJA DÓNDE VA LA PÁGINA Y CÓMO SE TITULA, COMO EN
    ' EL PDF: ANTES DE LA PRÓXIMA PIEZA CON CUERPO. SI HAY MÁS DE UNA, MANDA
    ' LA PRIMERA
    If sTipo = "bibliografia" And $iPosBibliografia = -1 Then
      $iPosBibliografia = aPiezas.Count
      If Not IsNull(hPiezas["titulo_capitulo"]) Then
        $sTituloBibliografia = m_XML.TrimUTF8(hPiezas["titulo_capitulo"])
      Endif
    Endif

    hPiezas.MoveNext
  Wend

  Return aPiezas

End

' ============================================
' Función   : LeerMetadatosLibro
' Propósito : Carga los metadatos del libro desde libros_md, fuente de verdad
'             (RC-XJ-02). Los valores quedan SIN escapar: se escapan al
'             escribirlos en cada archivo.
' Parámetros: (ninguno)
' Retorna   : Collection — claves fijas, NULL convertido en cadena vacía; o
'             Null si falló la consulta, con el motivo ya informado
' ============================================
Private Function LeerMetadatosLibro() As Collection

  ' --- 1. INICIALIZACIÓN ---
  Dim cMeta As New Collection
  Dim hLibro As Result

  ' --- 2. CONSULTA ---
  Try hLibro = m_ConexionBD.mConn.Exec(
    "SELECT titulo_libro, subtitulo, titulo_abreviado, isbn_impreso, " &
    "isbn_electronico, doi_libro, editorial, ciudad_publicacion, " &
    "ano_publicacion, idioma_principal, url_licencia, licencia_defecto, " &
    "descripcion_libro, imagen_tapa, logo_portada, logo_coleccion, " &
    "texto_catalogacion_digital, texto_legal_digital, tipo_libro, " &
    "lugar_bibliografia " &
    "FROM libros_md WHERE id_libro = &1 LIMIT 1", $iIdLibro)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudieron leer los datos del libro:" & gb.NewLine & Error.Text)
    Return Null
  Endif

  If Not hLibro.Available Then
    m_Sonido.sonar("Error")
    Message.Error("No se encontraron los datos del libro (id " & CStr($iIdLibro) & ").")
    Return Null
  Endif

  ' --- 3. VOLCADO ---
  ' LOS TÍTULOS VAN PLANOS: EL EPUB NO CORTA. LA MARCA DEL EDITOR PASA A
  ' ESPACIO ACÁ, UNA SOLA VEZ, Y LLEGA ASÍ A LA TAPA, LA PORTADA, LOS
  ' CRÉDITOS, EL OPF Y EL NOMBRE DEL ARCHIVO (SC-28)
  cMeta["titulo"] = m_CorteTitulo.Plano(m_Metadatos.NullToString(hLibro["titulo_libro"]))
  cMeta["subtitulo"] = m_CorteTitulo.Plano(m_Metadatos.NullToString(hLibro["subtitulo"]))
  cMeta["titulo_abreviado"] = m_CorteTitulo.Plano(m_Metadatos.NullToString(hLibro["titulo_abreviado"]))
  cMeta["isbn_impreso"] = m_Metadatos.NullToString(hLibro["isbn_impreso"])
  cMeta["isbn_electronico"] = m_Metadatos.NullToString(hLibro["isbn_electronico"])
  cMeta["doi"] = m_Metadatos.NullToString(hLibro["doi_libro"])
  cMeta["editorial"] = m_Metadatos.NullToString(hLibro["editorial"])
  cMeta["ciudad"] = m_Metadatos.NullToString(hLibro["ciudad_publicacion"])
  cMeta["anio"] = m_Metadatos.NullToString(hLibro["ano_publicacion"])
  cMeta["idioma"] = m_Metadatos.NullToString(hLibro["idioma_principal"])
  cMeta["url_licencia"] = m_Metadatos.NullToString(hLibro["url_licencia"])
  cMeta["licencia"] = m_Metadatos.NullToString(hLibro["licencia_defecto"])
  cMeta["descripcion"] = m_Metadatos.NullToString(hLibro["descripcion_libro"])
  cMeta["imagen_tapa"] = m_Metadatos.NullToString(hLibro["imagen_tapa"])
  cMeta["logo_portada"] = m_Metadatos.NullToString(hLibro["logo_portada"])
  cMeta["logo_coleccion"] = m_Metadatos.NullToString(hLibro["logo_coleccion"])
  cMeta["texto_catalogacion_digital"] = m_Metadatos.NullToString(hLibro["texto_catalogacion_digital"])
  cMeta["texto_legal_digital"] = m_Metadatos.NullToString(hLibro["texto_legal_digital"])
  cMeta["tipo_libro"] = m_Metadatos.NullToString(hLibro["tipo_libro"])
  cMeta["lugar_bibliografia"] = m_Metadatos.NullToString(hLibro["lugar_bibliografia"])

  If cMeta["idioma"] = "" Then cMeta["idioma"] = "es"

  Return cMeta

End

' ============================================
' Función   : LeerAutoresLibro
' Propósito : La autoría del libro —autor, compilador, editor, coordinador—
'             como texto legible, para la tapa y los créditos genéricos. El
'             OPF no la usa: arma una persona por elemento (PersonasOpf).
'             Los roles secundarios (traductor, ilustrador, prologuista
'             externo, director de colección) no encabezan la obra.
' Parámetros: (ninguno)
' Retorna   : String — «Nombre Apellidos, Nombre Apellidos», sin escapar; vacío
'             si no hay autoría o falló la consulta
' ============================================
Private Function LeerAutoresLibro() As String

  ' --- 1. INICIALIZACIÓN ---
  Dim hAutores As Result
  Dim sAutores As String

  ' --- 2. CONSULTA ---
  ' UN FALLO ACÁ NO IMPIDE EL EPUB: LAS PÁGINAS SALEN SIN LÍNEA DE AUTORÍA
  Try hAutores = m_ConexionBD.mConn.Exec(
    "SELECT a.nombre, a.apellidos " &
    "FROM libro_autor la " &
    "JOIN autores a ON a.id_autor = la.id_autor " &
    "WHERE la.id_libro = &1 " &
    "AND la.rol_libro IN ('autor','compilador','editor','coordinador') " &
    "ORDER BY la.orden_autoria ASC", $iIdLibro)
  If Error Then Return ""

  ' --- 3. ARMADO ---
  While hAutores.Available
    If sAutores <> "" Then sAutores &= ", "
    sAutores &= m_Metadatos.NullToString(hAutores["nombre"]) & " " &
      m_Metadatos.NullToString(hAutores["apellidos"])
    hAutores.MoveNext
  Wend

  Return sAutores

End

' ============================================
' Función   : PrepararArbol
' Propósito : Vacía y recrea el árbol de trabajo del EPUB. Todo lo que el
'             paquete contiene se regenera en cada corrida.
' Parámetros: (ninguno)
' Retorna   : Boolean — False si no se pudo, con el motivo ya informado
' ============================================
Private Function PrepararArbol() As Boolean

  ' --- 1. INICIALIZACIÓN ---
  Dim aDirs As New String[]
  Dim sDir As String

  ' --- 2. LIMPIEZA ---
  ' Exec CON ARRAY Y NO Shell: LA RUTA NO PASA POR sh -c (SC-05)
  If Exist($sRutaEpubWork) Then
    Try Exec ["rm", "-rf", $sRutaEpubWork] Wait
    If Error Then
      m_Sonido.sonar("Error")
      Message.Error("No se pudo limpiar el directorio de trabajo:" & gb.NewLine & Error.Text)
      Return False
    Endif
  Endif

  ' --- 3. ÁRBOL EPUB 3 ---
  aDirs.Add($sRutaEpubWork &/ "META-INF")
  aDirs.Add($sRutaOEBPS &/ "css")
  aDirs.Add($sRutaOEBPS &/ "fonts")
  aDirs.Add($sRutaOEBPS &/ "images")
  aDirs.Add($sRutaOEBPS &/ "chapters")

  For Each sDir In aDirs
    Try Exec ["mkdir", "-p", sDir] Wait
    If Error Then
      m_Sonido.sonar("Error")
      Message.Error("No se pudo crear " & sDir & ":" & gb.NewLine & Error.Text)
      Return False
    Endif
  Next

  ' --- 4. VERIFICACIÓN ---
  ' Exec ... Wait NO INFORMA SI mkdir FALLÓ: SE COMPRUEBA EL RESULTADO
  If Not Exist($sRutaOEBPS &/ "chapters") Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo crear el árbol de trabajo en:" & gb.NewLine & $sRutaEpubWork)
    Return False
  Endif

  Return True

End

' ============================================
' Función   : EscribirArchivo
' Propósito : Guarda un archivo y avisa si no pudo.
' Parámetros: sRuta As String — destino
'             sContenido As String — contenido
' Retorna   : Boolean — False si falló, con el motivo ya informado
' ============================================
Private Function EscribirArchivo(sRuta As String, sContenido As String) As Boolean

  Try File.Save(sRuta, sContenido)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo escribir:" & gb.NewLine & sRuta & gb.NewLine & gb.NewLine & Error.Text)
    Return False
  Endif

  Return True

End

' ============================================
' Función   : EscaparXml
' Propósito : Escapa un texto para insertarlo en contenido o en un atributo
'             XML. El & primero: si fuera después, escaparía los & de las
'             entidades recién escritas.
' Parámetros: sTexto As String — texto plano, tal como sale de la base
' Retorna   : String — texto escapado
' ============================================
Private Function EscaparXml(sTexto As String) As String

  Dim sSalida As String

  sSalida = Replace(sTexto, "&", "&amp;")
  sSalida = Replace(sSalida, "<", "&lt;")
  sSalida = Replace(sSalida, ">", "&gt;")
  sSalida = Replace(sSalida, Chr(34), "&quot;")

  Return sSalida

End

' ============================================
' Función   : Comillas
' Propósito : Envuelve un valor de atributo entre comillas dobles (SC-01).
' Parámetros: sValor As String — valor ya escapado
' Retorna   : String — el valor entre comillas
' ============================================
Private Function Comillas(sValor As String) As String

  Return Chr(34) & sValor & Chr(34)

End

' ============================================
' Función   : CabeceraXhtml
' Propósito : Declaración, html y head comunes a las páginas propias del EPUB.
' Parámetros: sIdioma As String — idioma del libro
'             sTitulo As String — título de la página, SIN escapar
'             bConHojaDeEstilos As Boolean — si enlaza la hoja del EPUB
' Retorna   : String — desde la declaración XML hasta <body> inclusive
' ============================================
Private Function CabeceraXhtml(sIdioma As String, sTitulo As String, bConHojaDeEstilos As Boolean) As String

  Dim s As String

  s = "<?xml version=" & Comillas("1.0") & " encoding=" & Comillas("UTF-8") & "?>" & Chr(10)
  s &= "<!DOCTYPE html>" & Chr(10)
  s &= "<html xmlns=" & Comillas("http://www.w3.org/1999/xhtml") &
    " xmlns:epub=" & Comillas("http://www.idpf.org/2007/ops") &
    " xml:lang=" & Comillas(EscaparXml(sIdioma)) & ">" & Chr(10)
  s &= "<head>" & Chr(10)
  s &= "<meta charset=" & Comillas("UTF-8") & "/>" & Chr(10)
  s &= "<title>" & EscaparXml(sTitulo) & "</title>" & Chr(10)
  If bConHojaDeEstilos Then
    s &= "<link rel=" & Comillas("stylesheet") & " type=" & Comillas("text/css") &
      " href=" & Comillas("../css/" & CSS_EPUB) & "/>" & Chr(10)
  Endif
  s &= "</head>" & Chr(10)
  s &= "<body>" & Chr(10)

  Return s

End

' ============================================
' Función   : ArmarTapa
' Propósito : La tapa (cover): la imagen si la hay; si no, una tapa de texto.
'             Hasta SC-25 este archivo se llamaba front-portada.xhtml: la
'             portada es ahora otra página, la titlepage.
' Parámetros: cMeta As Collection — metadatos del libro
'             sAutores As String — autoría, sin escapar
' Retorna   : String — el XHTML completo
' ============================================
Private Function ArmarTapa(cMeta As Collection, sAutores As String) As String

  Dim s As String
  Dim sNombreTapa As String

  If cMeta["imagen_tapa"] <> "" Then sNombreTapa = File.Name(cMeta["imagen_tapa"])

  s = CabeceraXhtml(cMeta["idioma"], cMeta["titulo"], True)
  s &= "<section epub:type=" & Comillas("cover") & " class=" & Comillas("tapa") & ">" & Chr(10)

  If sNombreTapa <> "" Then
    s &= "<img class=" & Comillas("tapa-img") &
      " src=" & Comillas("../images/" & EscaparXml(sNombreTapa)) &
      " alt=" & Comillas("Cubierta") & "/>" & Chr(10)
  Else
    ' SIN IMAGEN: TAPA DE TEXTO
    s &= "<h1 class=" & Comillas("tapa-titulo") & ">" & EscaparXml(cMeta["titulo"]) & "</h1>" & Chr(10)
    If cMeta["subtitulo"] <> "" Then
      s &= "<p class=" & Comillas("tapa-subtitulo") & ">" & EscaparXml(cMeta["subtitulo"]) & "</p>" & Chr(10)
    Endif
    If sAutores <> "" Then
      s &= "<p class=" & Comillas("tapa-autor") & ">" & EscaparXml(sAutores) & "</p>" & Chr(10)
    Endif
    If cMeta["editorial"] <> "" Then
      s &= "<p class=" & Comillas("tapa-editorial") & ">" & EscaparXml(cMeta["editorial"]) & "</p>" & Chr(10)
    Endif
  Endif

  s &= "</section>" & Chr(10)
  s &= "</body>" & Chr(10) & "</html>" & Chr(10)

  Return s

End

' ============================================
' Función   : ArmarPortada
' Propósito : La portada del libro (titlepage), en el orden del PDF: autoría,
'             leyenda, título, subtítulo y logo de portada al pie (SC-25).
' Parámetros: cMeta As Collection — metadatos del libro
'             cValores As Collection — lo que devolvió
'             m_PrimerasLibro.LeerValores
' Retorna   : String — el XHTML completo
' Nota      : LOS NOMBRES EN MAYÚSCULAS Y MINÚSCULAS, COMO ESTÁN EN LA BASE:
'             LAS VERSALITAS NO SE RESPETAN DE FORMA PAREJA EN LOS LECTORES.
'             EL alt DEL LOGO ES EL NOMBRE DE LA EDITORIAL, O VACÍO SI NO
'             HAY: UN alt VACÍO DECLARA LA IMAGEN COMO DECORATIVA.
' ============================================
Private Function ArmarPortada(cMeta As Collection, cValores As Collection) As String

  Dim s As String
  Dim aNombres As String[]
  Dim sNombres As String = ""
  Dim sLeyenda As String
  Dim i As Integer

  ' --- 1. AUTORÍA ---
  aNombres = cValores["nombres_autoria"]
  For i = 0 To aNombres.Max
    sNombres &= m_PrimerasLibro.SeparadorAutoria(i, aNombres.Count, aNombres[i]) & aNombres[i]
  Next
  sLeyenda = m_PrimerasLibro.ValorDe(cValores, "leyenda_autoria")

  ' --- 2. PÁGINA ---
  s = CabeceraXhtml(cMeta["idioma"], cMeta["titulo"], True)
  s &= "<section epub:type=" & Comillas("titlepage") & " class=" & Comillas("portada") & ">" & Chr(10)

  If sNombres <> "" Then
    s &= "<p class=" & Comillas("portada-autores") & ">" & EscaparXml(sNombres) & "</p>" & Chr(10)
  Endif
  If sLeyenda <> "" Then
    s &= "<p class=" & Comillas("portada-leyenda") & ">" & EscaparXml(sLeyenda) & "</p>" & Chr(10)
  Endif

  s &= "<h1 class=" & Comillas("portada-titulo") & ">" & EscaparXml(cMeta["titulo"]) & "</h1>" & Chr(10)
  If cMeta["subtitulo"] <> "" Then
    s &= "<p class=" & Comillas("portada-subtitulo") & ">" & EscaparXml(cMeta["subtitulo"]) & "</p>" & Chr(10)
  Endif

  If cMeta["logo_portada"] <> "" Then
    s &= "<p class=" & Comillas("portada-logo") & "><img src=" &
      Comillas("../images/" & EscaparXml(cMeta["logo_portada"])) &
      " alt=" & Comillas(EscaparXml(cMeta["editorial"])) & "/></p>" & Chr(10)
  Endif

  s &= "</section>" & Chr(10)
  s &= "</body>" & Chr(10) & "</html>" & Chr(10)

  Return s

End

' ============================================
' Función   : ArmarCreditos
' Propósito : La página de créditos (copyright-page). Con los textos digitales
'             si el libro declara la pieza y los tiene (SC-25); si no, el bloque
'             genérico: título, autoría, editorial, año, ISBN, DOI y licencia.
' Parámetros: cMeta As Collection — metadatos del libro
'             sAutores As String — autoría, sin escapar
'             cValores As Collection — lo que devolvió
'             m_PrimerasLibro.LeerValores
' Retorna   : String — el XHTML completo; "" si falló la conversión de los
'             textos, con el motivo ya informado
' Nota      : LOS TEXTOS DIGITALES NUNCA SE REEMPLAZAN POR LOS DEL IMPRESO, QUE
'             TRAEN TIRADA E IMPRENTA (SC-25). VACÍOS LOS DOS, VA EL GENÉRICO.
' ============================================
Private Function ArmarCreditos(cMeta As Collection, sAutores As String, cValores As Collection) As String

  Dim s As String

  ' --- 0. CRÉDITOS CON LOS TEXTOS DEL LIBRO ---
  If $bHayCreditos Then
    If cMeta["texto_catalogacion_digital"] <> "" Or cMeta["texto_legal_digital"] <> "" Then
      Return ArmarCreditosPropios(cMeta, cValores)
    Endif
  Endif

  s = CabeceraXhtml(cMeta["idioma"], "Créditos", True)
  s &= "<section epub:type=" & Comillas("copyright-page") & " class=" & Comillas("creditos") & ">" & Chr(10)

  ' --- 1. TÍTULO Y AUTORÍA ---
  s &= "<h1 class=" & Comillas("creditos-titulo") & ">" & EscaparXml(cMeta["titulo"]) & "</h1>" & Chr(10)
  If cMeta["subtitulo"] <> "" Then
    s &= "<p class=" & Comillas("creditos-subtitulo") & ">" & EscaparXml(cMeta["subtitulo"]) & "</p>" & Chr(10)
  Endif
  If sAutores <> "" Then
    s &= "<p class=" & Comillas("creditos-autor") & ">" & EscaparXml(sAutores) & "</p>" & Chr(10)
  Endif

  ' --- 2. DATOS EDITORIALES ---
  s &= "<div class=" & Comillas("creditos-datos") & ">" & Chr(10)
  If cMeta["editorial"] <> "" Then
    s &= "<p>" & EscaparXml(cMeta["editorial"])
    If cMeta["ciudad"] <> "" Then s &= ", " & EscaparXml(cMeta["ciudad"])
    s &= "</p>" & Chr(10)
  Endif
  If cMeta["anio"] <> "" Then s &= "<p>" & EscaparXml(cMeta["anio"]) & "</p>" & Chr(10)
  If cMeta["isbn_electronico"] <> "" Then
    s &= "<p>ISBN (digital): " & EscaparXml(cMeta["isbn_electronico"]) & "</p>" & Chr(10)
  Endif
  If cMeta["isbn_impreso"] <> "" Then
    s &= "<p>ISBN (impreso): " & EscaparXml(cMeta["isbn_impreso"]) & "</p>" & Chr(10)
  Endif
  If cMeta["doi"] <> "" Then s &= "<p>DOI: " & EscaparXml(cMeta["doi"]) & "</p>" & Chr(10)

  ' --- 3. LICENCIA ---
  If cMeta["url_licencia"] <> "" Then
    s &= "<p class=" & Comillas("creditos-licencia") & "><a href=" &
      Comillas(EscaparXml(cMeta["url_licencia"])) & ">" &
      EscaparXml(cMeta["licencia"]) & "</a></p>" & Chr(10)
  Else If cMeta["licencia"] <> "" Then
    s &= "<p class=" & Comillas("creditos-licencia") & ">" & EscaparXml(cMeta["licencia"]) & "</p>" & Chr(10)
  Endif
  s &= "</div>" & Chr(10)

  s &= "</section>" & Chr(10)
  s &= "</body>" & Chr(10) & "</html>" & Chr(10)

  Return s

End

' ============================================
' Función   : ArmarCreditosPropios
' Propósito : Los créditos con los textos digitales del libro: logo de la
'             colección arriba, ficha de catalogación y texto legal (SC-25).
' Parámetros: cMeta As Collection — metadatos del libro
'             cValores As Collection — valores de los marcadores
' Retorna   : String — el XHTML completo; "" si falló la conversión, con el
'             motivo ya informado
' Nota      : LOS TEXTOS PASAN POR m_PrimerasLibro.TextoParaSalida A html:
'             PANDOC ESCAPA & Y <, Y ESCRIBE LOS CARACTERES COMO TALES, SIN
'             ENTIDADES CON NOMBRE (VERIFICADO: EL RESULTADO ES XML BIEN
'             FORMADO). EL SCRIPT LO VUELVE A COMPROBAR CON xmllint.
'             bDigital EN True: {paginas} Y {formato} DETIENEN LA GENERACIÓN.
' ============================================
Private Function ArmarCreditosPropios(cMeta As Collection, cValores As Collection) As String

  Dim s As String
  Dim sFicha As String
  Dim sLegal As String

  ' --- 1. TEXTOS ---
  sFicha = m_PrimerasLibro.TextoParaSalida(cMeta["texto_catalogacion_digital"], cValores, "html", True)
  If m_PrimerasLibro.UltimoError() <> "" Then
    m_Sonido.sonar("Error")
    Message.Error("Ficha de catalogación del EPUB: " & m_PrimerasLibro.UltimoError())
    Return ""
  Endif

  sLegal = m_PrimerasLibro.TextoParaSalida(cMeta["texto_legal_digital"], cValores, "html", True)
  If m_PrimerasLibro.UltimoError() <> "" Then
    m_Sonido.sonar("Error")
    Message.Error("Texto legal del EPUB: " & m_PrimerasLibro.UltimoError())
    Return ""
  Endif

  ' --- 2. PÁGINA ---
  s = CabeceraXhtml(cMeta["idioma"], "Créditos", True)
  s &= "<section epub:type=" & Comillas("copyright-page") & " class=" & Comillas("creditos") & ">" & Chr(10)

  If cMeta["logo_coleccion"] <> "" Then
    ' EL NOMBRE DE LA COLECCIÓN ES PARTE DE LA IMAGEN: VA EN EL alt
    s &= "<p class=" & Comillas("creditos-logo") & "><img src=" &
      Comillas("../images/" & EscaparXml(cMeta["logo_coleccion"])) &
      " alt=" & Comillas(EscaparXml(m_PrimerasLibro.ValorDe(cValores, "coleccion"))) & "/></p>" & Chr(10)
  Endif

  If sFicha <> "" Then
    s &= "<div class=" & Comillas("creditos-ficha") & ">" & Chr(10) & sFicha & Chr(10) & "</div>" & Chr(10)
  Endif
  If sLegal <> "" Then
    s &= "<div class=" & Comillas("creditos-legal") & ">" & Chr(10) & sLegal & Chr(10) & "</div>" & Chr(10)
  Endif

  s &= "</section>" & Chr(10)
  s &= "</body>" & Chr(10) & "</html>" & Chr(10)

  Return s

End

' ============================================
' Función   : VerificarLogo
' Propósito : Comprueba que un logo cargado sea PNG o JPG y esté en media/.
' Parámetros: sNombre As String — libros_md.logo_portada o logo_coleccion
'             sCual As String — «de portada» o «de colección», para el mensaje
' Retorna   : Boolean — True si no hay logo o si está bien; False con mensaje
' Nota      : MISMA REGLA QUE EL PDF (RutaLogo). SIN ESTO, UN LOGO FALTANTE
'             SALE COMO IMAGEN ROTA Y EL SCRIPT LO DETECTA RECIÉN AL VERIFICAR
'             EL PAQUETE, SIN DECIR DE QUÉ CAMPO VIENE.
' ============================================
Private Function VerificarLogo(sNombre As String, sCual As String) As Boolean

  If sNombre = "" Then Return True

  If Not m_PrimerasLibro.EsFormatoLogo(sNombre) Then
    m_Sonido.sonar("Error")
    Message.Error("El logo " & sCual & " tiene que ser PNG o JPG:" & gb.NewLine &
      sNombre & gb.NewLine & "Volvé a elegirlo en la ficha del libro.")
    Return False
  Endif

  If Not Exist($sRutaProyecto &/ m_PrimerasLibro.CARPETA_MEDIA &/ sNombre) Then
    m_Sonido.sonar("Error")
    Message.Error("El logo " & sCual & " no está en la carpeta media del proyecto:" &
      gb.NewLine & sNombre)
    Return False
  Endif

  Return True

End

' ============================================
' Función   : ArmarColofon
' Propósito : El colofón del EPUB, que la matriz resuelve como página propia.
'             El texto es el digital, compartido con el pie del HTML
'             (m_PiezasLibro.ColofonDigital): sin tipografías, porque el lector
'             de EPUB deja cambiar la fuente.
' Parámetros: cMeta As Collection — metadatos del libro
' Retorna   : String — el XHTML completo
' ============================================
Private Function ArmarColofon(cMeta As Collection) As String

  Dim s As String

  s = CabeceraXhtml(cMeta["idioma"], "Colofón", True)
  s &= "<section class=" & Comillas("colofon") & ">" & Chr(10)
  s &= "<p>" & m_PiezasLibro.ColofonDigital() & "</p>" & Chr(10)
  s &= "</section>" & Chr(10)
  s &= "</body>" & Chr(10) & "</html>" & Chr(10)

  Return s

End

' ============================================
' Función   : ArmarNav
' Propósito : El nav.xhtml, tabla de contenidos de navegación de EPUB 3, con
'             el título de cada pieza leído de su canónico.
' Parámetros: cMeta As Collection — metadatos del libro
'             aPiezas As String[] — piezas del EPUB, en orden
' Retorna   : String — el XHTML completo
' ============================================
Private Function ArmarNav(cMeta As Collection, aPiezas As String[]) As String

  Dim s As String
  Dim sPieza As String
  Dim sTitulo As String
  Dim i As Integer

  s = CabeceraXhtml(cMeta["idioma"], "Tabla de contenidos", False)
  s &= "<nav epub:type=" & Comillas("toc") & " id=" & Comillas("toc") & ">" & Chr(10)
  s &= "<h1>Contenido</h1>" & Chr(10)
  s &= "<ol>" & Chr(10)

  For i = 0 To aPiezas.Max
    ' LA BIBLIOGRAFÍA CONSOLIDADA, EN EL LUGAR DE SU PIEZA
    If $bPaginaBibliografia And i = $iPosBibliografia Then s &= ItemNavBibliografia()

    sPieza = aPiezas[i]
    ' UNA PIEZA SIN ENTRADA EN EL ÍNDICE SIGUE EN EL SPINE: SE LEE, PERO NO SE
    ' LISTA. LA BIBLIOGRAFÍA DE ARRIBA YA SALIÓ EN SU LUGAR
    If $cSinIndice.Exist(sPieza) Then Continue
    ' EL TÍTULO YA VIENE ESCAPADO: SE LEE DE UN XML. SI NO SE PUEDE LEER, EL
    ' NOMBRE DEL ARCHIVO, QUE SÍ HAY QUE ESCAPAR
    sTitulo = LeerTituloCanonico(sPieza)
    If sTitulo = "" Then sTitulo = EscaparXml(sPieza)
    s &= "<li><a href=" & Comillas("chapters/h-" & sPieza & ".xhtml") & ">" & sTitulo & "</a></li>" & Chr(10)
  Next

  ' SIN PIEZA DECLARADA, O DECLARADA DESPUÉS DE LA ÚLTIMA CON CUERPO: AL FINAL
  If $bPaginaBibliografia And ($iPosBibliografia = -1 Or $iPosBibliografia > aPiezas.Max) Then
    s &= ItemNavBibliografia()
  Endif

  s &= "</ol>" & Chr(10)
  s &= "</nav>" & Chr(10)
  s &= "</body>" & Chr(10) & "</html>" & Chr(10)

  Return s

End

' ============================================
' Función   : LeerTituloCanonico
' Propósito : El texto del primer <title> del canónico de una pieza, sin las
'             marcas internas —una cursiva dentro del título dejaría en el nav
'             un <emphasis>, que no es XHTML—.
' Parámetros: sPieza As String — nombre_archivo de la pieza
' Retorna   : String — el título, todavía con sus entidades XML; vacío si no se
'             pudo leer
' ============================================
Private Function LeerTituloCanonico(sPieza As String) As String

  ' --- 1. INICIALIZACIÓN ---
  Dim sCanonico As String
  Dim sContenido As String
  Dim sTitulo As String
  Dim sLimpio As String
  Dim iIni As Integer
  Dim iFin As Integer
  Dim iAbre As Integer
  Dim iCierra As Integer

  ' --- 2. LECTURA ---
  sCanonico = $sRutaProyecto &/ "jats" &/ "c-" & sPieza & ".xml"
  If Not Exist(sCanonico) Then Return ""

  ' EL CANÓNICO ES UTF-8 (SC-02). String.* Y NO InStr/Mid: LAS POSICIONES VAN
  ' A String.Mid (RC-GM-12)
  Try sContenido = File.Load(sCanonico)
  If Error Then Return ""

  iIni = String.InStr(sContenido, "<title>")
  If iIni = 0 Then Return ""
  iIni += String.Len("<title>")
  iFin = String.InStr(sContenido, "</title>", iIni)
  If iFin = 0 Then Return ""

  sTitulo = String.Mid(sContenido, iIni, iFin - iIni)

  ' --- 3. QUITAR LAS MARCAS INTERNAS ---
  ' SE CONSERVA EL TEXTO ENTRE MARCAS. LAS ENTIDADES QUEDAN COMO ESTÁN: EL
  ' RESULTADO VA A OTRO XML
  Do
    iAbre = String.InStr(sTitulo, "<")
    If iAbre = 0 Then Break
    iCierra = String.InStr(sTitulo, ">", iAbre)
    If iCierra = 0 Then Break
    sLimpio = String.Left(sTitulo, iAbre - 1) & String.Mid(sTitulo, iCierra + 1)
    sTitulo = sLimpio
  Loop

  Return Trim(sTitulo)

End

' ============================================
' Función   : PersonasOpf
' Propósito : Los dc:creator y dc:contributor del OPF: un elemento por
'             persona, con su rol MARC y su forma de ordenamiento.
' Parámetros: sTipoLibro As String — libros_md.tipo_libro
' Retorna   : String — los elementos y sus meta refines, listos para el
'             bloque metadata; vacío si no hay personas o falló la consulta
' Nota      : EPUB 3.3 §5.5.3.2.3: UN dc:creator POR PERSONA; EL ORDEN DEL
'             DOCUMENTO FIJA LA PRIORIDAD Y EL PRIMERO ES LA AUTORÍA
'             PRINCIPAL. QUIÉN ES CREADOR LO DECIDE LA MISMA REGLA QUE LA
'             PORTADA DEL PDF (m_GenerarPDFLibro.RolesDeAutoriaSegunTipo).
'             LOS ROLES SECUNDARIOS VAN EN dc:contributor (§5.5.3.2.2). EL
'             DIRECTOR DE COLECCIÓN NO: ES UN DATO DE LA COLECCIÓN.
'             UN FALLO ACÁ NO IMPIDE EL EPUB: SALE SIN PERSONAS.
' ============================================
Private Function PersonasOpf(sTipoLibro As String) As String

  ' --- 1. INICIALIZACIÓN ---
  Dim hRes As Result
  Dim s As String
  Dim sId As String
  Dim sElemento As String
  Dim sRolesCreador As String
  Dim sFileAs As String
  Dim iCreador As Integer
  Dim iContribuidor As Integer

  sRolesCreador = m_GenerarPDFLibro.RolesDeAutoriaSegunTipo(sTipoLibro)

  ' --- 2. CONSULTA ---
  ' PRIMERO LOS CREADORES, DESPUÉS LOS CONTRIBUIDORES; DENTRO DE CADA
  ' GRUPO, EL ORDEN DE AUTORÍA DE LA BASE
  Try hRes = m_ConexionBD.mConn.Exec(
    "SELECT a.nombre, a.apellidos, a.apellidos_nombre, la.rol_libro, " &
    "(la.rol_libro IN (" & sRolesCreador & ")) AS es_creador " &
    "FROM libro_autor la " &
    "JOIN autores a ON a.id_autor = la.id_autor " &
    "WHERE la.id_libro = &1 " &
    "AND (la.rol_libro IN (" & sRolesCreador & ") " &
    "OR la.rol_libro IN ('traductor','ilustrador','prologuista_externo')) " &
    "ORDER BY es_creador DESC, la.orden_autoria ASC", $iIdLibro)
  If Error Then Return ""

  ' --- 3. UN ELEMENTO POR PERSONA ---
  While hRes.Available
    ' CInt: EL DRIVER PUEDE DEVOLVER LA EXPRESIÓN COMO ENTERO O COMO BOOLEAN,
    ' Y EN GAMBAS True VALE -1, NO 1
    If CInt(hRes["es_creador"]) <> 0 Then
      Inc iCreador
      sId = "creador" & CStr(iCreador)
      sElemento = "dc:creator"
    Else
      Inc iContribuidor
      sId = "contribuidor" & CStr(iContribuidor)
      sElemento = "dc:contributor"
    Endif

    s &= "<" & sElemento & " id=" & Comillas(sId) & ">" &
      EscaparXml(Trim(m_Metadatos.NullToString(hRes["nombre"]) & " " &
      m_Metadatos.NullToString(hRes["apellidos"]))) & "</" & sElemento & ">" & Chr(10)
    s &= "<meta refines=" & Comillas("#" & sId) & " property=" & Comillas("role") &
      " scheme=" & Comillas("marc:relators") & ">" &
      RolMarc(m_Metadatos.NullToString(hRes["rol_libro"])) & "</meta>" & Chr(10)

    ' FORMA DE ORDENAMIENTO: LA DE LA BASE, O ARMADA SI FALTA
    sFileAs = Trim(m_Metadatos.NullToString(hRes["apellidos_nombre"]))
    If sFileAs = "" Then
      sFileAs = m_Metadatos.NullToString(hRes["apellidos"]) & ", " &
        m_Metadatos.NullToString(hRes["nombre"])
    Endif
    s &= "<meta refines=" & Comillas("#" & sId) & " property=" & Comillas("file-as") & ">" &
      EscaparXml(sFileAs) & "</meta>" & Chr(10)

    hRes.MoveNext
  Wend

  Return s

End

' ============================================
' Función   : RolMarc
' Propósito : Código MARC del rol de una persona en el libro.
' Parámetros: sRol As String — libro_autor.rol_libro
' Retorna   : String — código de marc:relators
' Nota      : CÓDIGOS Y DEFINICIONES DE loc.gov/marc/relators. EDITOR,
'             COMPILADOR Y COORDINADOR SON edc («editor of compilation»: QUIEN
'             SELECCIONA Y REÚNE OBRAS DE OTROS). edt Y com DESCRIBEN EN MARC
'             OTRAS TAREAS Y «COORDINADOR» NO TIENE CÓDIGO. EL MATIZ EN
'             CASTELLANO LO DA LA LEYENDA DE AUTORÍA, NO EL METADATO.
'             EL PRÓLOGO EXTERNO ES wfw («writer of foreword»).
' ============================================
Private Function RolMarc(sRol As String) As String

  Select Case LCase(Trim(sRol))
    Case "editor", "compilador", "coordinador"
      Return "edc"
    Case "traductor"
      Return "trl"
    Case "ilustrador"
      Return "ill"
    Case "prologuista_externo"
      Return "wfw"
    Case Else
      Return "aut"
  End Select

End

' ============================================
' Función   : ArmarOPF
' Propósito : El content.opf: metadatos, manifest y spine. Declara los archivos
'             que el script va a producir o copiar; el script verifica que
'             todos existan antes de empaquetar.
' Parámetros: cMeta As Collection — metadatos del libro
'             aPiezas As String[] — piezas del EPUB, en orden
' Retorna   : String — el OPF completo
' ============================================
Private Function ArmarOPF(cMeta As Collection, aPiezas As String[]) As String

  ' --- 1. INICIALIZACIÓN ---
  Dim aFuentes As New String[]
  Dim s As String
  Dim sIdentificador As String
  Dim sNombreTapa As String
  Dim sRutaMedia As String
  Dim sImagen As String
  Dim sFuente As String
  Dim sPieza As String
  Dim sId As String
  Dim i As Integer

  aFuentes.Add("NotoSerif-Regular.ttf")
  aFuentes.Add("NotoSerif-Bold.ttf")
  aFuentes.Add("NotoSerif-Italic.ttf")
  aFuentes.Add("NotoSerif-BoldItalic.ttf")

  If cMeta["imagen_tapa"] <> "" Then sNombreTapa = File.Name(cMeta["imagen_tapa"])

  ' --- 2. IDENTIFICADOR ---
  ' ISBN DIGITAL, O DOI, O UN URN PROPIO. EL URN NO LLEVA «uuid:»: ANTES
  ' DECÍA urn:uuid:gbpublisher-libro-N, QUE PROMETE UN UUID SIN SERLO, Y
  ' epubcheck LO SEÑALABA (OPF-085)
  If cMeta["isbn_electronico"] <> "" Then
    sIdentificador = "urn:isbn:" & cMeta["isbn_electronico"]
  Else If cMeta["doi"] <> "" Then
    sIdentificador = "urn:doi:" & cMeta["doi"]
  Else
    sIdentificador = "urn:gbpublisher:libro-" & CStr($iIdLibro)
  Endif

  ' --- 3. CABECERA Y METADATOS ---
  s = "<?xml version=" & Comillas("1.0") & " encoding=" & Comillas("UTF-8") & "?>" & Chr(10)
  s &= "<package xmlns=" & Comillas("http://www.idpf.org/2007/opf") & " version=" & Comillas("3.0") &
    " unique-identifier=" & Comillas("pub-id") & " xml:lang=" & Comillas(EscaparXml(cMeta["idioma"])) & ">" & Chr(10)
  s &= "<metadata xmlns:dc=" & Comillas("http://purl.org/dc/elements/1.1/") & ">" & Chr(10)
  s &= "<dc:identifier id=" & Comillas("pub-id") & ">" & EscaparXml(sIdentificador) & "</dc:identifier>" & Chr(10)
  s &= "<dc:title>" & EscaparXml(cMeta["titulo"]) & "</dc:title>" & Chr(10)
  s &= "<dc:language>" & EscaparXml(cMeta["idioma"]) & "</dc:language>" & Chr(10)
  ' UNA PERSONA POR ELEMENTO, CON SU ROL (EPUB 3.3 §5.5.3.2.3)
  s &= PersonasOpf(cMeta["tipo_libro"])
  If cMeta["editorial"] <> "" Then s &= "<dc:publisher>" & EscaparXml(cMeta["editorial"]) & "</dc:publisher>" & Chr(10)
  If cMeta["anio"] <> "" Then s &= "<dc:date>" & EscaparXml(cMeta["anio"]) & "</dc:date>" & Chr(10)
  If cMeta["descripcion"] <> "" Then s &= "<dc:description>" & EscaparXml(cMeta["descripcion"]) & "</dc:description>" & Chr(10)
  If cMeta["url_licencia"] <> "" Then s &= "<dc:rights>" & EscaparXml(cMeta["url_licencia"]) & "</dc:rights>" & Chr(10)
  s &= "<meta property=" & Comillas("dcterms:modified") & ">" &
    Format(Now, "yyyy-mm-dd") & "T" & Format(Now, "hh:nn:ss") & "Z</meta>" & Chr(10)
  If sNombreTapa <> "" Then
    s &= "<meta name=" & Comillas("cover") & " content=" & Comillas("cover-image") & "/>" & Chr(10)
  Endif
  s &= "</metadata>" & Chr(10)

  ' --- 4. MANIFEST ---
  s &= "<manifest>" & Chr(10)
  s &= "<item id=" & Comillas("nav") & " href=" & Comillas("nav.xhtml") &
    " media-type=" & Comillas("application/xhtml+xml") & " properties=" & Comillas("nav") & "/>" & Chr(10)
  s &= "<item id=" & Comillas("css") & " href=" & Comillas("css/" & CSS_EPUB) &
    " media-type=" & Comillas("text/css") & "/>" & Chr(10)

  For Each sFuente In aFuentes
    s &= "<item id=" & Comillas("font-" & LCase(File.BaseName(sFuente))) &
      " href=" & Comillas("fonts/" & sFuente) & " media-type=" & Comillas("font/ttf") & "/>" & Chr(10)
  Next

  ' IMÁGENES: LAS DE media/, LAS MISMAS QUE COPIA EL SCRIPT. SE SALTEAN LOS
  ' SUBDIRECTORIOS, LOS OCULTOS Y LO QUE NO ES UNA IMAGEN QUE EL EPUB ADMITA,
  ' CON LA MISMA LISTA QUE EL SCRIPT: UN PDF EN media/ SE DECLARABA COMO
  ' image/jpeg Y DEJABA EL PAQUETE INVÁLIDO. Dir() SOBRE UNA RUTA QUE NO ES
  ' CARPETA FALLA (GV-01): SE COMPRUEBA ANTES
  sRutaMedia = $sRutaProyecto &/ "media"
  If Exist(sRutaMedia) Then
    If IsDir(sRutaMedia) Then
      For Each sImagen In Dir(sRutaMedia)
        If IsDir(sRutaMedia &/ sImagen) Then Continue
        If String.Left(sImagen, 1) = "." Then Continue
        If Not EsImagenEpub(sImagen) Then Continue
        If sImagen = sNombreTapa Then
          s &= "<item id=" & Comillas("cover-image") & " href=" & Comillas("images/" & EscaparXml(sImagen)) &
            " media-type=" & Comillas(MediaTypeDeImagen(sImagen)) & " properties=" & Comillas("cover-image") & "/>" & Chr(10)
        Else
          ' EL id SALE DEL NOMBRE COMPLETO, CON EXTENSIÓN: foto.png Y foto.jpg
          ' NO PUEDEN COMPARTIR UNO, Y UN id DUPLICADO INVALIDA EL OPF
          sId = "img-" & LCase(Replace(Replace(sImagen, ".", "-"), " ", "-"))
          s &= "<item id=" & Comillas(EscaparXml(sId)) & " href=" & Comillas("images/" & EscaparXml(sImagen)) &
            " media-type=" & Comillas(MediaTypeDeImagen(sImagen)) & "/>" & Chr(10)
        Endif
      Next
    Endif
  Endif

  s &= "<item id=" & Comillas("tapa") & " href=" & Comillas("chapters/front-tapa.xhtml") &
    " media-type=" & Comillas("application/xhtml+xml") & "/>" & Chr(10)
  If $bHayPortada Then
    s &= "<item id=" & Comillas("portada") & " href=" & Comillas("chapters/front-portada.xhtml") &
      " media-type=" & Comillas("application/xhtml+xml") & "/>" & Chr(10)
  Endif
  s &= "<item id=" & Comillas("creditos") & " href=" & Comillas("chapters/front-creditos.xhtml") &
    " media-type=" & Comillas("application/xhtml+xml") & "/>" & Chr(10)

  For Each sPieza In aPiezas
    s &= "<item id=" & Comillas("cap-" & sPieza) & " href=" & Comillas("chapters/h-" & sPieza & ".xhtml") &
      " media-type=" & Comillas("application/xhtml+xml") & "/>" & Chr(10)
  Next

  ' LA BIBLIOGRAFÍA CONSOLIDADA: LA ESCRIBE EL SCRIPT, Y SU VERIFICACIÓN DEL
  ' OPF EXIGE QUE EXISTA
  If $bPaginaBibliografia Then
    s &= "<item id=" & Comillas("bibliografia") & " href=" & Comillas("chapters/" & PAGINA_BIBLIOGRAFIA) &
      " media-type=" & Comillas("application/xhtml+xml") & "/>" & Chr(10)
  Endif

  s &= "<item id=" & Comillas("colofon") & " href=" & Comillas("chapters/bm-99-colofon.xhtml") &
    " media-type=" & Comillas("application/xhtml+xml") & "/>" & Chr(10)
  s &= "</manifest>" & Chr(10)

  ' --- 5. SPINE: ORDEN DE LECTURA ---
  s &= "<spine>" & Chr(10)
  s &= "<itemref idref=" & Comillas("tapa") & "/>" & Chr(10)
  If $bHayPortada Then s &= "<itemref idref=" & Comillas("portada") & "/>" & Chr(10)
  s &= "<itemref idref=" & Comillas("creditos") & "/>" & Chr(10)
  ' EL MISMO ORDEN QUE EL NAV: LA BIBLIOGRAFÍA EN EL LUGAR DE SU PIEZA, O AL
  ' FINAL ANTES DEL COLOFÓN
  For i = 0 To aPiezas.Max
    If $bPaginaBibliografia And i = $iPosBibliografia Then
      s &= "<itemref idref=" & Comillas("bibliografia") & "/>" & Chr(10)
    Endif
    s &= "<itemref idref=" & Comillas("cap-" & aPiezas[i]) & "/>" & Chr(10)
  Next
  If $bPaginaBibliografia And ($iPosBibliografia = -1 Or $iPosBibliografia > aPiezas.Max) Then
    s &= "<itemref idref=" & Comillas("bibliografia") & "/>" & Chr(10)
  Endif
  s &= "<itemref idref=" & Comillas("colofon") & "/>" & Chr(10)
  s &= "</spine>" & Chr(10)

  s &= "</package>" & Chr(10)

  Return s

End

' ============================================
' Función   : PrepararBibliografia
' Propósito : Con bibliografía consolidada y entradas, deja en tmp/ la
'             bibliografía del libro con el título de la página puesto, que es
'             la señal para el script. Con bibliografía por capítulo, o sin
'             entradas, borra ese archivo si quedó de una corrida anterior.
' Parámetros: cMeta As Collection — metadatos del libro (lugar_bibliografia)
' Retorna   : Boolean — False si algo falló, con el motivo ya informado
' ============================================
Private Function PrepararBibliografia(cMeta As Collection) As Boolean

  ' --- 1. INICIALIZACIÓN ---
  Dim sDestino As String
  Dim sOrigen As String
  Dim sXml As String
  Dim iIni As Integer
  Dim iFin As Integer

  $bPaginaBibliografia = False
  sDestino = $sRutaProyecto &/ "tmp" &/ ARCHIVO_BIBLIO_EPUB

  ' --- 2. UN ARCHIVO DE UNA CORRIDA ANTERIOR NO PUEDE QUEDAR ---
  ' SU PRESENCIA ES LO QUE EL SCRIPT LEE COMO «CONSOLIDADA»
  If Exist(sDestino) Then
    Try Kill sDestino
    If Error Then
      m_Sonido.sonar("Error")
      Message.Error("No se pudo borrar " & sDestino & ":" & gb.NewLine & Error.Text)
      Return False
    Endif
  Endif

  ' --- 3. POR CAPÍTULO: NADA MÁS QUE HACER ---
  If cMeta["lugar_bibliografia"] <> "consolidada" Then Return True

  ' --- 4. LA BIBLIOGRAFÍA DEL LIBRO, LA MISMA DEL HTML Y DEL CANÓNICO ---
  ' GenerarBiblioLibroXML MUESTRA SU PROPIO MENSAJE AL FALLAR. EL NOMBRE ES EL
  ' QUE USA m_GenerarSalidasLibro.PrepararInsumosLibro
  If Not m_XML.GenerarBiblioLibroXML($iIdLibro) Then Return False
  sOrigen = $sRutaProyecto &/ "tmp" &/ "biblio-libro-" &
    File.BaseName(m_InicioCierre.NombreProyectoEnCurso) & ".xml"

  Try sXml = File.Load(sOrigen)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo leer la bibliografía del libro:" & gb.NewLine & sOrigen & gb.NewLine & Error.Text)
    Return False
  Endif

  ' --- 5. SIN ENTRADAS NO HAY PÁGINA ---
  ' NO HAY CITAS QUE ENLACEN A ELLA, Y UNA PÁGINA SOLO CON EL TÍTULO NO DICE
  ' NADA. EL CANÓNICO DEL LIBRO HACE LO MISMO
  If String.InStr(sXml, "<biblioentry") = 0 Then Return True

  ' --- 6. TÍTULO DE LA PÁGINA ---
  ' EL DE LA PIEZA SI EL LIBRO LA DECLARA, COMO EL PDF; SI NO, EL QUE TRAE EL
  ' ARCHIVO. SE REEMPLAZA EL PRIMER <title>, QUE ES EL DE LA BIBLIOGRAFÍA: VA
  ' ANTES DE LA PRIMERA ENTRADA. String.* POR RC-GM-12
  If $sTituloBibliografia <> "" Then
    iIni = String.InStr(sXml, "<title>")
    If iIni > 0 And iIni < String.InStr(sXml, "<biblioentry") Then
      iIni += String.Len("<title>")
      iFin = String.InStr(sXml, "</title>", iIni)
      If iFin > 0 Then
        sXml = String.Left(sXml, iIni - 1) & EscaparXml(m_CorteTitulo.Plano($sTituloBibliografia)) & String.Mid(sXml, iFin)
      Endif
    Endif
  Endif

  ' --- 7. ESCRITURA ---
  If Not EscribirArchivo(sDestino, sXml) Then Return False
  $bPaginaBibliografia = True
  Return True

End

' ============================================
' Función   : ItemNavBibliografia
' Propósito : La entrada del índice de navegación para la página de
'             bibliografía consolidada.
' Parámetros: (ninguno)
' Retorna   : String — el <li> listo
' ============================================
Private Function ItemNavBibliografia() As String

  Dim sTitulo As String

  sTitulo = TITULO_BIBLIOGRAFIA
  If $sTituloBibliografia <> "" Then sTitulo = m_CorteTitulo.Plano($sTituloBibliografia)
  Return "<li><a href=" & Comillas("chapters/" & PAGINA_BIBLIOGRAFIA) & ">" & EscaparXml(sTitulo) & "</a></li>" & Chr(10)

End

' ============================================
' Función   : EsImagenEpub
' Propósito : Dice si un archivo de media/ es una imagen que el EPUB admite.
' Parámetros: sNombre As String — nombre del archivo
' Retorna   : Boolean — True para jpg, jpeg, png, gif, svg y webp
' Nota      : SON LOS TIPOS DE IMAGEN DE EPUB 3.3. LA MISMA LISTA ESTÁ EN
'             engine/generar_epub_libro.sh: SI DIVERGEN, EL SCRIPT COPIA UN
'             ARCHIVO QUE EL OPF NO DECLARA, O EL OPF DECLARA UNO QUE NO SE
'             COPIÓ, Y LA VERIFICACIÓN DEL OPF LO ATRAPA.
' ============================================
Private Function EsImagenEpub(sNombre As String) As Boolean

  Select Case LCase(File.Ext(sNombre))
    Case "jpg", "jpeg", "png", "gif", "svg", "webp"
      Return True
    Case Else
      Return False
  End Select

End

' ============================================
' Función   : MediaTypeDeImagen
' Propósito : El media-type de una imagen según su extensión.
' Parámetros: sNombre As String — nombre del archivo
' Retorna   : String — media-type; image/jpeg si la extensión no se reconoce
' ============================================
Private Function MediaTypeDeImagen(sNombre As String) As String

  Select Case LCase(File.Ext(sNombre))
    Case "jpg", "jpeg"
      Return "image/jpeg"
    Case "png"
      Return "image/png"
    Case "gif"
      Return "image/gif"
    Case "svg"
      Return "image/svg+xml"
    Case "webp"
      Return "image/webp"
  End Select

  Return "image/jpeg"

End

' ============================================
' Función   : NombreArchivoEpub
' Propósito : El nombre del .epub, desde el título abreviado o el título:
'             minúsculas, espacios como guiones, solo [a-z0-9-_].
' Parámetros: cMeta As Collection — metadatos del libro
' Retorna   : String — nombre con extensión .epub
' ============================================
Private Function NombreArchivoEpub(cMeta As Collection) As String

  ' --- 1. INICIALIZACIÓN ---
  Dim sBase As String
  Dim sLimpio As String
  Dim sCaracter As String
  Dim iPos As Integer

  sBase = cMeta["titulo_abreviado"]
  If sBase = "" Then sBase = cMeta["titulo"]
  If sBase = "" Then sBase = "libro"
  sBase = LCase(sBase)

  ' --- 2. LIMPIEZA ---
  ' String.Mid ENTREGA UN CARÁCTER. UN CARÁCTER MULTIBYTE NUNCA COINCIDE CON
  ' EL CONJUNTO, QUE ES ASCII, Y SE DESCARTA: «canción» DA «cancin». ES EL
  ' COMPORTAMIENTO QUE YA TENÍA; SI MOLESTA, PLEGAR ANTES LOS ACENTOS
  For iPos = 1 To String.Len(sBase)
    sCaracter = String.Mid(sBase, iPos, 1)
    If sCaracter = " " Then
      sLimpio &= "-"
    Else If InStr("abcdefghijklmnopqrstuvwxyz0123456789-_", sCaracter) > 0 Then
      sLimpio &= sCaracter
    Endif
  Next

  If sLimpio = "" Then sLimpio = "libro"

  Return sLimpio & ".epub"

End
