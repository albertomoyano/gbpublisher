' Gambas class file

' ============================================
' Clase     : CAnalisisArchivo
' Propósito : Los conteos de UN archivo del proyecto, o del TOTAL, en la
'             solapa «Escanear» (gvAnalizarProyecto). Los llena
'             m_AnalizarProyecto a partir de los registros que emite
'             engine/analizar_proyecto.lua. Es una clase y no una
'             Collection de campos: los campos tienen tipo y nombre, y
'             una Collection pierde la clave a la que se le asigna "" (GV-68).
' ============================================

' --- IDENTIDAD Y ESTADO ---
Public sNombre As String
Public bError As Boolean
Public sError As String

' --- VOLUMEN: PALABRAS POR DESTINO ---
Public iPalCuerpo As Integer
Public iPalNotas As Integer
Public iPalCitas As Integer
Public iPalLeyendas As Integer
Public iPalTablas As Integer
Public iPalTitulos As Integer
Public iPalEspeciales As Integer

' --- VOLUMEN: CARACTERES DE TODO EL TEXTO ---
Public iCaracteresCon As Integer
Public iCaracteresSin As Integer

' --- PÁRRAFOS: PALABRAS DE CADA UNO, PARA PROMEDIO Y MEDIANA ---
Public aParrafos As New Integer[]
Public iParrafoMax As Integer
Public sInicioParrafoMax As String

' --- TÍTULOS: ÍNDICE 1 A 6 = NIVEL (EL 0 NO SE USA) ---
' SE DIMENSIONA EN _new CON New Integer[7], LA FORMA DE m_FuncionesGenericas
Public aTitulos As Integer[]
Public iSaltos As Integer
Public iUltimoNivel As Integer

' --- NOTAS Y CITAS ---
Public iNotas As Integer
Public iCitas As Integer
Public aClaves As New String[]

' --- ELEMENTOS ---
Public iFiguras As Integer
Public iImagenes As Integer
Public iTablas As Integer
Public iMathLinea As Integer
Public iMathDestacada As Integer
Public iCitasBloque As Integer
Public iItems As Integer
Public iCodigo As Integer
Public iEnlaces As Integer

' --- SHORTCODES: CLAVE = CLASE, VALOR = CANTIDAD (Integer) ---
Public cShortcodes As New Collection

' --- LÉXICO: ORACIONES DEL CUERPO (LOS CALCULA engine/analizar_lexico.pl) ---
' NO SE SUMAN EN Sumar: LA MEDIANA DEL PROYECTO NO SALE DE LAS MEDIANAS DE
' LOS ARCHIVOS. EL TOTAL LO MANDA EL SCRIPT EN SU PROPIO REGISTRO (OT)
Public bLexico As Boolean
Public iOraciones As Integer
Public iPalOraciones As Integer
' LA MEDIANA POR DOS: SIEMPRE ENTERA, SIN SEPARADOR DECIMAL REGIONAL
Public iMedianaX2 As Integer
Public iOracionMax As Integer
Public sInicioOracionMax As String
Public iParrafosLexico As Integer
Public iParrafosUnaOracion As Integer

' ============================================
' Función   : _new
' Propósito : DIMENSIONA EL ARRAY DE TÍTULOS (NIVELES 1 A 6)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub _new()

  aTitulos = New Integer[7]

End

' ============================================
' Función   : PalabrasTotal
' Propósito : SUMA DE LAS PALABRAS DE TODOS LOS DESTINOS
' Parámetros: ninguno
' Retorna   : Integer — palabras
' ============================================
Public Function PalabrasTotal() As Integer

  Return iPalCuerpo + iPalNotas + iPalCitas + iPalLeyendas + iPalTablas + iPalTitulos + iPalEspeciales

End

' ============================================
' Función   : PalabrasEnParrafos
' Propósito : SUMA DE LAS PALABRAS DE LOS PÁRRAFOS DEL CUERPO, PARA EL
'             PROMEDIO. NO ES iPalCuerpo: ESE INCLUYE LISTAS Y SECCIONES
'             ESTRUCTURALES SIN PÁRRAFO
' Parámetros: ninguno
' Retorna   : Integer — palabras
' ============================================
Public Function PalabrasEnParrafos() As Integer

  ' --- 1. INICIALIZACIÓN ---
  Dim iSuma As Integer
  Dim iPalabras As Integer

  ' --- 2. SUMA ---
  For Each iPalabras In aParrafos
    iSuma += iPalabras
  Next

  Return iSuma

End

' ============================================
' Función   : ClavesDistintas
' Propósito : LAS CLAVES CITADAS SIN REPETIR, ORDENADAS
' Parámetros: ninguno
' Retorna   : String[] — claves
' ============================================
Public Function ClavesDistintas() As String[]

  ' --- 1. INICIALIZACIÓN ---
  Dim aSalida As New String[]
  Dim sClave As String

  ' --- 2. UNA SOLA VEZ CADA CLAVE ---
  For Each sClave In aClaves
    If aSalida.Find(sClave) < 0 Then aSalida.Add(sClave)
  Next

  aSalida.Sort()
  Return aSalida

End

' ============================================
' Función   : Sumar
' Propósito : ACUMULA LOS CONTEOS DE UN ARCHIVO EN ESTE OBJETO (EL TOTAL)
' Parámetros: oOtro As CAnalisisArchivo — el archivo a sumar
' Retorna   : nada
' ============================================
Public Sub Sumar(oOtro As CAnalisisArchivo)

  ' --- 1. INICIALIZACIÓN ---
  Dim i As Integer
  Dim iCantidad As Integer

  ' --- 2. VOLUMEN ---
  iPalCuerpo += oOtro.iPalCuerpo
  iPalNotas += oOtro.iPalNotas
  iPalCitas += oOtro.iPalCitas
  iPalLeyendas += oOtro.iPalLeyendas
  iPalTablas += oOtro.iPalTablas
  iPalTitulos += oOtro.iPalTitulos
  iPalEspeciales += oOtro.iPalEspeciales
  iCaracteresCon += oOtro.iCaracteresCon
  iCaracteresSin += oOtro.iCaracteresSin

  ' --- 3. PÁRRAFOS: EL MÁS LARGO DEL PROYECTO LLEVA EL NOMBRE DEL ARCHIVO ---
  aParrafos.Insert(oOtro.aParrafos)
  If oOtro.iParrafoMax > iParrafoMax Then
    iParrafoMax = oOtro.iParrafoMax
    sInicioParrafoMax = oOtro.sNombre & ": " & oOtro.sInicioParrafoMax
  Endif

  ' --- 4. TÍTULOS ---
  ' LOS SALTOS SE SUMAN: CADA UNO SE DETECTÓ DENTRO DE SU ARCHIVO
  For i = 1 To 6
    aTitulos[i] = aTitulos[i] + oOtro.aTitulos[i]
  Next
  iSaltos += oOtro.iSaltos

  ' --- 5. NOTAS Y CITAS ---
  iNotas += oOtro.iNotas
  iCitas += oOtro.iCitas
  aClaves.Insert(oOtro.aClaves)

  ' --- 6. ELEMENTOS ---
  iFiguras += oOtro.iFiguras
  iImagenes += oOtro.iImagenes
  iTablas += oOtro.iTablas
  iMathLinea += oOtro.iMathLinea
  iMathDestacada += oOtro.iMathDestacada
  iCitasBloque += oOtro.iCitasBloque
  iItems += oOtro.iItems
  iCodigo += oOtro.iCodigo
  iEnlaces += oOtro.iEnlaces

  ' --- 7. SHORTCODES ---
  For Each iCantidad In oOtro.cShortcodes
    If cShortcodes.Exist(oOtro.cShortcodes.Key) Then
      cShortcodes[oOtro.cShortcodes.Key] = cShortcodes[oOtro.cShortcodes.Key] + iCantidad
    Else
      cShortcodes[oOtro.cShortcodes.Key] = iCantidad
    Endif
  Next

End
