' Gambas module file


' ============================================
' Función   : ExportarBibTeX2JSON
' Propósito : Exporta las referencias del proyecto en curso a
'             {proyecto}/referencias/ref-{proyecto}.json
' Parámetros: (ninguno)
' Retorna   : Boolean — True si se escribió el archivo
' Nota      : DESDE LA 2.0.0 CADA ENTRADA LLEVA tipo_de_entrada, clave_bibtex Y
'             SUS CAMPOS CON EL NOMBRE DE biblatex (journaltitle, langid…). LOS
'             JSON VIEJOS, CON NOMBRES DE COLUMNA, LOS SIGUE LEYENDO ImportarJSON.
'             NO SE EXPORTAN id, id_proyecto, id_origen NI fecha_modificacion:
'             SON DE ESTA BASE Y NO DE LA QUE IMPORTE
' ============================================
Public Sub ExportarBibTeX2JSON() As Boolean

  Dim hEntradas As Result
  Dim hPares As Result
  Dim aEntradas As New Collection[]
  Dim dEntrada As Collection
  Dim sJSON As String
  Dim outputFile As String
  Dim iId As Integer

  ' --- 1. CONSULTAS: ENTRADAS Y PARES, EN EL MISMO ORDEN ---
  ' ID DEL PROYECTO DESDE LA GLOBAL DE SESIÓN (RC-GM-16), PARAMETRIZADO
  Try hEntradas = m_ConexionBD.mConn.Exec("SELECT id, tipo_de_entrada, clave_bibtex FROM bibtex " &
    "WHERE id_proyecto = &1 ORDER BY clave_bibtex, id", m_InicioCierre.IdProyectoEnCurso)
  If Error Then Goto FalloLectura
  Try hPares = m_ConexionBD.mConn.Exec("SELECT c.id_bibtex, c.campo, c.valor FROM bibtex b " &
    "JOIN bibtex_campo c ON c.id_bibtex = b.id JOIN bibtex_campo_catalogo k ON k.campo = c.campo " &
    "WHERE b.id_proyecto = &1 ORDER BY b.clave_bibtex, b.id, k.orden", m_InicioCierre.IdProyectoEnCurso)
  If Error Then Goto FalloLectura

  ' --- 2. UNA COLECCIÓN POR ENTRADA ---
  While hEntradas.Available
    dEntrada = New Collection
    iId = hEntradas["id"]
    If Not IsNull(hEntradas["tipo_de_entrada"]) Then dEntrada["tipo_de_entrada"] = hEntradas["tipo_de_entrada"]
    If Not IsNull(hEntradas["clave_bibtex"]) Then dEntrada["clave_bibtex"] = hEntradas["clave_bibtex"]
    ' LOS PARES DE ESTA ENTRADA
    While hPares.Available
      If hPares["id_bibtex"] <> iId Then Break
      dEntrada[hPares["campo"]] = hPares["valor"]
      hPares.MoveNext
    Wend
    aEntradas.Add(dEntrada)
    hEntradas.MoveNext
  Wend

  ' CREAR ESTRUCTURA JSON CON METADATOS
  Dim dFinal As New Collection
  Dim fecha As String

  fecha = Format(Now, "dd/mm/yyyy hh:nn:ss")

  dFinal["entries"] = aEntradas
  dFinal["metadata"] = New Collection
  dFinal["metadata"]["generator"] = "gbpublisher"
  dFinal["metadata"]["databaseType"] = "mysql"
  dFinal["metadata"]["creationDate"] = fecha
  dFinal["metadata"]["tableName"] = "bibtex"
  ' FORMATO DE LOS NOMBRES DE CAMPO: biblatex DESDE LA 2.0.0
  dFinal["metadata"]["schema"] = "2.0.0"

  ' CONVERTIR A JSON Y FORMATEAR
  sJSON = JSON.Encode(dFinal)
  sJSON = FormatearJSON(sJSON)

  ' GUARDAR ARCHIVO
  outputFile = m_InicioCierre.RutaProyectoEnCurso & "/referencias/ref-" & File.BaseName(m_InicioCierre.NombreProyectoEnCurso) & ".json"
  File.Save(outputFile, sJSON)

  ' VERIFICAR QUE EL ARCHIVO SE HAYA CREADO
  If Exist(outputFile) Then
    Return True
  Else
    Return False
  Endif

FalloLectura:
  m_Sonido.sonar("Error")
  Message.Error("No se pudieron leer las referencias del proyecto:" & gb.NewLine & Error.Text)
  Return False

End

Private Function FormatearJSON(jsonCompacto As String) As String

  Dim resultado As String
  Dim nivel As Integer = 0
  Dim i As Integer
  Dim c As String
  Dim enCadena As Boolean = False
  Dim escapado As Boolean = False

  For i = 1 To Len(jsonCompacto)
    c = Mid(jsonCompacto, i, 1)

    ' DETECTAR SI ESTAMOS DENTRO DE UNA CADENA
    If c = "\"" And Not escapado Then
      enCadena = Not enCadena
    Endif

    ' MANEJAR CARACTERES DE ESCAPE
    If c = "\\" And Not escapado Then
      escapado = True
    Else
      escapado = False
    Endif

    ' SOLO FORMATEAR SI NO ESTAMOS DENTRO DE UNA CADENA
    If Not enCadena Then
      Select Case c
        Case "{"
          resultado &= c & "\n" & String(2 * (nivel + 1), " ")
          nivel += 1
        Case "}"
          nivel -= 1
          resultado &= "\n" & String(2 * nivel, " ") & c
        Case "["
          resultado &= c & "\n" & String(2 * (nivel + 1), " ")
          nivel += 1
        Case "]"
          nivel -= 1
          resultado &= "\n" & String(2 * nivel, " ") & c
        Case ","
          resultado &= c & "\n" & String(2 * nivel, " ")
        Case ":"
          resultado &= c & " "
        Default
          resultado &= c
      End Select
    Else
      resultado &= c
    Endif
  Next

  Return resultado

End

' ============================================
' Función   : ImportarJSON
' Propósito : Importar entradas desde un archivo JSON al proyecto en curso
' Parámetros: (ninguno)
' Retorna   : Boolean — True si se importó al menos una entrada
' Nota      : ACEPTA LOS DOS FORMATOS: EL DE LA 2.0.0 (CAMPOS CON SU NOMBRE DE
'             biblatex) Y EL ANTERIOR (NOMBRES DE COLUMNA: journal_title,
'             hyphenation…), QUE SE TRADUCE CON EL CATÁLOGO. CADA ENTRADA SE
'             ESCRIBE CON m_Bibtex.EscribirEntrada, EN SU TRANSACCIÓN. ANTES SE
'             ARMABA UN INSERT CON LOS VALORES PEGADOS AL SQL Y UNA ENTRADA
'             QUE FALLABA SE PERDÍA CON UN Debug: AHORA SE INFORMA
' ============================================
Public Sub ImportarJSON() As Boolean

  Dim jsonFile As String
  Dim jsonContent As String
  Dim dDatos As Collection
  Dim aEntradas As Collection[]
  Dim entrada As Collection
  Dim cValores As Collection
  Dim aClavesEntrada As String[]
  Dim aDescartados As New String[]
  Dim aFallidas As New String[]
  Dim aIdiomas As New String[]
  Dim sNombre As String
  Dim sCampo As String
  Dim sDestino As String
  Dim sValor As String
  Dim sTipo As String
  Dim sClave As String
  Dim contador As Integer = 0
  Dim i As Integer

  ' --- 1. ABRIR DIÁLOGO PARA SELECCIONAR ARCHIVO JSON ---
  Dialog.Title = "Seleccionar archivo JSON para importar"
  Dialog.Filter = ["*.json", "Archivos JSON"]
  If Not Dialog.OpenFile() Then
    jsonFile = Dialog.Path
  Else
    Return False
  Endif

  If Not Exist(jsonFile) Then
    Message.Error("El archivo seleccionado no existe")
    Return False
  Endif

  ' --- 2. LEER Y DECODIFICAR EL JSON ---
  jsonContent = File.Load(jsonFile)

  Try dDatos = JSON.Decode(jsonContent)
  If Error Then
    Message.Error("El archivo JSON no es válido: " & Error.Text)
    Return False
  Endif

  If Not dDatos.Exist("entries") Then
    Message.Error("El archivo JSON no tiene la estructura correcta (falta " & Chr(34) & "entries" & Chr(34) & ")")
    Return False
  Endif

  aEntradas = dDatos["entries"]

  ' --- 3. EL CATÁLOGO DE CAMPOS ---
  If Not m_Bibtex.CargarCatalogo() Then Return False

  ' --- 4. CADA ENTRADA ---
  For Each entrada In aEntradas
    sTipo = ""
    sClave = ""
    cValores = New Collection
    aClavesEntrada = entrada.Keys

    For i = 0 To aClavesEntrada.Max
      sCampo = aClavesEntrada[i]
      ' NULL Y VACÍO NO SON DATOS: SIN DATO, SIN PAR
      If IsNull(entrada[sCampo]) Then Continue
      sValor = Trim(CStr(entrada[sCampo]))
      If sValor = "" Then Continue

      ' COLUMNAS DE LA ENTRADA
      If sCampo = "tipo_de_entrada" Then
        sTipo = sValor
        Continue
      Endif
      If sCampo = "clave_bibtex" Then
        sClave = sValor
        Continue
      Endif

      ' CAMPO DE biblatex O, EN UN JSON VIEJO, NOMBRE DE COLUMNA
      sDestino = ""
      If m_Bibtex.EsCampo(sCampo) Then
        sDestino = sCampo
      Else
        sDestino = m_Bibtex.CampoDeNombreAnterior(sCampo)
      Endif
      If sDestino = "" Then
        If Not aDescartados.Exist(sCampo) Then aDescartados.Add(sCampo)
        Continue
      Endif

      ' hyphenation Y lang_id DAN LOS DOS langid: GANA EL PRIMERO, COMO EN
      ' LA MIGRACIÓN 2.0.0
      If Not cValores.Exist(sDestino) Then cValores[sDestino] = sValor
    Next

    ' SIN TIPO NO HAY ENTRADA: LA EXIGE EL FORMULARIO Y biblatex
    If sTipo = "" Then
      aFallidas.Add(IIf(sClave = "", "(sin clave)", sClave) & ": no tiene tipo_de_entrada")
      Continue
    Endif

    ' EL IDIOMA SE INFORMA, NO SE CORRIGE: SE ARREGLA DESPUÉS CON «Corregir»
    If cValores.Exist("langid") Then
      If Not m_Idiomas.EsNombreBabel(cValores["langid"]) Then aIdiomas.Add(sClave & ": langid " & cValores["langid"])
    Endif
    ' language Y origlanguage: CLAVES DE biblatex UNIDAS POR « and » (SC-102).
    ' EL CORTE ES POR Chr(1): Split CORTA POR CADA CARÁCTER DEL SEPARADOR (GV-185)
    For Each sCampo In ["language", "origlanguage"]
      If cValores.Exist(sCampo) Then
        For Each sNombre In Split(Replace(cValores[sCampo], " and ", Chr(1)), Chr(1))
          If Not m_Bibtex.EsClaveIdiomaBiblatex(Trim(sNombre)) Then
            aIdiomas.Add(sClave & ": " & sCampo & " " & cValores[sCampo])
            Break
          Endif
        Next
      Endif
    Next

    If m_Bibtex.EscribirEntrada(0, sTipo, sClave, cValores) = 0 Then
      aFallidas.Add(IIf(sClave = "", "(sin clave)", sClave) & ": " & m_Bibtex.UltimoErrorEscritura())
      Continue
    Endif

    contador += 1
  Next

  ' --- 5. INFORMAR RESULTADO ---
  ' LO QUE NO SE IMPORTÓ SE NOMBRA SIEMPRE (GV-23)
  If aDescartados.Count > 0 Then
    Message.Warning("Se ignoraron campos del JSON que no son campos de la bibliografía:" & Chr(10) & Chr(10) & aDescartados.Join(", "))
  Endif
  If aFallidas.Count > 0 Then
    m_Sonido.sonar("Error")
    Message.Error("No se importaron estas entradas:" & Chr(10) & Chr(10) & aFallidas.Join(Chr(10)))
  Endif
  If aIdiomas.Count > 0 Then
    m_Sonido.sonar("Warning")
    Message.Warning("Estas entradas se importaron con un idioma no admitido (langid: nombre de babel; language y origlanguage: claves de biblatex). Corríjalo antes de componer:" & Chr(10) & Chr(10) & aIdiomas.Join(Chr(10)))
  Endif

  If contador > 0 Then
    m_Bibtex.RefrescarTableViewBibtexEnCurso()
    Return True
  Else
    Return False
  Endif

End
