# Gambas Form File 3.0

{ Form Form
  Move(0,0,900,690)
  #Scaled = False
  Expand = True
  Text = ("Metadatos del número")
  Resizable = False
  Arrangement = Arrange.Vertical
  Centered = True
  Spacing = True
  Margin = True
  Padding = 4
  { lblAvisoNumero Label
    Move(9,9,880,36)
    Foreground = &H0000FF
    Border = Border.Plain
  }
  { svwNumero ScrollView
    Move(9,54,882,585)
    Expand = True
    Arrangement = Arrange.Vertical
    Spacing = True
    Margin = True
    Padding = 4
    ScrollBar = Scroll.Vertical
    { hbxRevistaNumero HBox
      Move(9,9,729,36)
      { lblRevistaNumero Label
        Move(0,0,200,36)
        Alignment = Align.Right
        Text = ("revista: ")
      }
      { cmbRevistaNumero ComboBox
        Move(207,0,450,36)
        Expand = True
        ReadOnly = True
      }
    }
    { hbxVolumenNumero HBox
      Move(9,45,729,36)
      { lblVolumenNumero Label
        Move(0,0,200,36)
        Alignment = Align.Right
        Text = ("volumen: ")
      }
      { txtVolumenNumero TextBox
        Move(207,0,450,36)
        Background = Color.Background
        Foreground = &H0000FF
        Expand = True
        ReadOnly = True
        Placeholder = ("Por ejemplo: 12")
      }
    }
    { hbxNumeroNumero HBox
      Move(9,81,729,36)
      { lblNumeroNumero Label
        Move(0,0,200,36)
        Alignment = Align.Right
        Text = ("número: ")
      }
      { txtNumeroNumero TextBox
        Move(207,0,450,36)
        Background = Color.Background
        Foreground = &H0000FF
        Expand = True
        ReadOnly = True
        Placeholder = ("Por ejemplo: 1")
      }
    }
    { hbxSuplementoNumero HBox
      Move(9,117,729,36)
      { lblSuplementoNumero Label
        Move(0,0,200,36)
        Alignment = Align.Right
        Text = ("suplemento: ")
      }
      { txtSuplementoNumero TextBox
        Move(207,0,450,36)
        Expand = True
        Placeholder = ("Solo si es un suplemento")
      }
    }
    { hbxTituloEspecialNumero HBox
      Move(9,153,729,36)
      { lblTituloEspecialNumero Label
        Move(0,0,200,36)
        Alignment = Align.Right
        Text = ("título-especial: ")
      }
      { txtTituloEspecialNumero TextBox
        Move(207,0,450,36)
        Expand = True
        Placeholder = ("Número temático completo: issue-title")
      }
    }
    { hbxAnioNumero HBox
      Move(9,189,729,36)
      { lblAnioNumero Label
        Move(0,0,200,36)
        Alignment = Align.Right
        Text = ("año: ")
      }
      { txtAnioNumero TextBox
        Move(207,0,450,36)
        Expand = True
        Placeholder = ("aaaa")
      }
    }
    { hbxMesNumero HBox
      Move(9,225,729,36)
      { lblMesNumero Label
        Move(0,0,200,36)
        Alignment = Align.Right
        Text = ("mes: ")
      }
      { cmbMesNumero ComboBox
        Move(207,0,450,36)
        Expand = True
        ReadOnly = True
      }
    }
    { hbxPaginaInicialNumero HBox
      Move(9,261,729,36)
      { lblPaginaInicialNumero Label
        Move(0,0,200,36)
        Alignment = Align.Right
        Text = ("página-inicial: ")
      }
      { txtPaginaInicialNumero TextBox
        Move(207,0,450,36)
        Expand = True
        Placeholder = ("Dónde arranca este número dentro del volumen")
      }
    }
    { hbxEstadoNumero HBox
      Move(9,297,729,36)
      { lblEstadoNumero Label
        Move(0,0,200,36)
        Alignment = Align.Right
        Text = ("estado: ")
      }
      { cmbEstadoNumero ComboBox
        Move(207,0,450,36)
        Expand = True
        ReadOnly = True
      }
    }
    { hbxTapaNumero HBox
      Move(9,333,729,36)
      { lblTapaNumero Label
        Move(0,0,200,36)
        Alignment = Align.Right
        Text = ("imagen-tapa: ")
      }
      { btnBuscarTapaNumero Button
        Move(207,0,36,36)
        ToolTip = ("Elegir la imagen de tapa")
        Picture = Picture["iconos/image.png"]
      }
      { txtTapaNumero TextBox
        Move(270,0,225,36)
        Expand = True
        ReadOnly = True
        Placeholder = ("Se copia a media/ como foto-tapa.jpg o .png")
      }
      { btnQuitarTapaNumero Button
        Move(621,0,36,36)
        ToolTip = ("Quitar la tapa del número")
        Picture = Picture["iconos/borrar.png"]
      }
    }
    { hbxEditoresNumero HBox
      Move(9,369,837,153)
      Expand = True
      { lblEditoresNumero Label
        Move(0,0,200,36)
        Alignment = Align.Right
        Text = ("editores-del-número: ")
      }
      { lstEditoresNumero ListBox
        Move(207,0,450,135)
        Expand = True
      }
      { vbxEditoresBotones VBox
        Move(675,0,36,189)
        { btnAgregarEditorNumero Button
          Move(0,0,36,36)
          ToolTip = ("Agregar un editor (de la tabla de autores)")
          Picture = Picture["iconos/+nuevo.png"]
        }
        { btnQuitarEditorNumero Button
          Move(0,36,36,36)
          ToolTip = ("Quitar el editor elegido")
          Picture = Picture["iconos/borrar.png"]
        }
        { btnSubirEditorNumero Button
          Move(0,72,36,36)
          ToolTip = ("Subir")
          Text = ("▲")
        }
        { btnBajarEditorNumero Button
          Move(0,108,36,36)
          ToolTip = ("Bajar")
          Text = ("▼")
        }
        { Spring1 Spring
          Move(0,144,36,36)
        }
      }
    }
  }
  { hbxBotonesNumero HBox
    Move(9,648,880,36)
    { sprBotonesNumero Spring
      Move(0,0,36,36)
    }
    { btnDossiersNumero Button
      Move(0,0,144,36)
      ToolTip = ("Dossiers del número")
      Text = ("Dossiers")
      Picture = Picture["iconos/partes.png"]
    }
    { btnGuardarNumero Button
      Move(585,0,144,36)
      Text = ("Guardar")
      Picture = Picture["iconos/guardarComo.png"]
    }
    { btnCerrar Button
      Move(729,0,144,36)
      Text = ("Cerrar")
      Picture = Picture["iconos/salir.png"]
    }
  }
}
