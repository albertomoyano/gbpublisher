' Gambas class file

' ============================================
' Clase     : CRelacion
' Propósito : Una relación del artículo con otro (JATS related-article):
'             el tipo y el destino, que es un artículo de la base o uno
'             externo (DOI o datos de cita). Entrega D3
' Tabla     : articulo_relacion (chk_rel_destino: al menos un destino).
' ============================================

' CÓDIGO JATS DE related-article-type (m_Articulo.TiposRelacionCodigos)
Public sTipo As String
' ARTÍCULO DE LA BASE; 0 = EXTERNO
Public iIdLocal As Integer
' CÓMO SE MUESTRA EL DESTINO LOCAL EN LA GRILLA
Public sLocal As String
' EXTERNO: DOI Y DATOS DE CITA ("" = SIN DATO)
Public sDoi As String
Public sRevista As String
Public sAnio As String
Public sVolumen As String
Public sNumero As String
Public sFpage As String
Public sLpage As String
