' Gambas module file

' ============================================
' Módulo    : m_RegexResultados
' Propósito : PESTAÑA «RESULTADOS» DEL BUSCADOR REGEX (tsRegExp, ÍNDICE 1,
'             DENTRO DE LA PESTAÑA RegExp DE FMain). Muestra las coincidencias
'             de una búsqueda sobre una lista de archivos ya resuelta y, si hay
'             reemplazo, lo aplica a las filas seleccionadas: guard de git,
'             regla de vigencia, escritura de atrás para adelante y log. Es
'             dueño del estado de la pestaña; los handlers de FMain solo
'             delegan acá (patrón módulo-dueño-del-estado, como
'             m_BuscarReemplazar y m_AnalizarProyecto). Reemplaza al formulario
'             modal FRegexResultados.
'
'             LA PESTAÑA NO ES MODAL (SC-51). Entre la búsqueda y el click (o
'             el reemplazo) el usuario puede editar y guardar, y las posiciones
'             de la grilla quedarían viejas. REGLA DE VIGENCIA: las
'             coincidencias de un archivo siguen valiendo si su firma
'             mtime|size es la capturada al lanzar la búsqueda y, si es el
'             archivo abierto, el editor no tiene cambios sin guardar
'             (m_EditorPrincipal.HayCambios). Si no valen, no se salta ni se
'             escribe: se vuelve a buscar (Rebuscar). No se compara el texto
'             en el offset contra el campo «antes»: .Text normaliza el espacio
'             duro (GV-47) y la comparación fallaría siempre.
'
'             La búsqueda corre como PROCESO ASÍNCRONO (perl): la salida se
'             acumula por el evento Read y el usuario puede cancelar en
'             cualquier momento (Process.Kill). La UI no se congela ni con el
'             peor patrón, porque el trabajo pesado vive en otro proceso — es
'             la razón por la que se eligió perl externo sobre gb.pcre.
'
'             La grilla es VIRTUAL (evento Data): el array de coincidencias que
'             devuelve perl ES el modelo, la grilla solo lo pinta bajo demanda.
'             No se duplica estado; las filas son índices en ese array. Es lo
'             que usa el reemplazo: las filas seleccionadas son índices
'             directos en la lista de coincidencias.
'
' Controles de la pestaña (FMain):
'   lblRegexEncabezado   — patrón y cantidad de archivos de la búsqueda
'   lblRegexContador     — "N coincidencias en M archivos" / estado
'   gvRegexResultados    — la grilla de coincidencias (Select.Multiple)
'   txaRegexContexto     — preview de la coincidencia actual (solo lectura)
'   btnRegexReemplazar   — aplica el reemplazo a las filas seleccionadas
'   btnRegexCancelar     — corta la búsqueda en curso
' ============================================

' --- PARÁMETROS DE LA ÚLTIMA BÚSQUEDA (los recibe Buscar) ---
' EL REEMPLAZO Y EL LOG USAN ESTOS, NO LO QUE HAYA EN LOS CAMPOS DE LA PESTAÑA:
' SI EL USUARIO LOS EDITÓ DESPUÉS DE BUSCAR, LAS POSICIONES NO LES CORRESPONDEN
Private $aArchivos As String[]
Private $sPatron As String
Private $sReemplazo As String
Private $sFlags As String
Private $sAplicar As String
Private $sRutaScript As String

' --- PROCESO DE BÚSQUEDA Y SU ESTADO ---
Private $hProc As Process
Private $sBuffer As String            ' ACUMULA LA SALIDA CRUDA DEL PROCESO
Private $bCancelado As Boolean        ' EL Kill FUE PEDIDO (MT-B)
Private $bBuscando As Boolean

' --- LA GRILLA SE VUELVE A LLENAR DESDE EL CÓDIGO ---
' CAMBIAR Rows.Count PUEDE MOVER LA FILA ACTUAL Y EMITIR Change (GV-78). EL
' PREVIEW NO SE ACTUALIZA ENTONCES. EL EDITOR NO CORRE RIESGO: SE MUEVE DESDE
' Click, QUE EL CÓDIGO NUNCA DISPARA
Private $bRepoblando As Boolean

' --- MODELO DE RESULTADOS ---
' Cada coincidencia es un String[] de 8 campos, en el orden del protocolo del
' script: archivo, offset, linea, columna, largo, antes, despues, linea_texto.
Private $aResultados As New Object[]

' --- SNAPSHOT DE CADA ARCHIVO AL LANZAR LA BÚSQUEDA ---
' Clave: ruta absoluta. Valor: "mtime|size" capturado con Stat. Se captura
' ANTES de lanzar perl y para todos los archivos buscados: un guardado durante
' la búsqueda deja una firma distinta y las coincidencias de ese archivo no
' valen. Es la mitad de disco de la regla de vigencia.
Private $cSnapshot As New Collection

' --- ÍNDICES DE CAMPO EN CADA REGISTRO (deben coincidir con el .pl) ---
Private Const C_ARCHIVO As Integer = 0
Private Const C_OFFSET As Integer = 1
Private Const C_LINEA As Integer = 2
Private Const C_COLUMNA As Integer = 3
Private Const C_LARGO As Integer = 4
Private Const C_ANTES As Integer = 5
Private Const C_DESPUES As Integer = 6
Private Const C_LINEA_TEXTO As Integer = 7

' ============================================
' Función   : InicializarTab
' Propósito : Deja la pestaña en blanco: corta la búsqueda en curso si la hay,
'             configura la grilla y vacía modelo, snapshot y etiquetas. La
'             llaman FMain.AbrirProyecto (junto a InicializarTabRegex) y
'             m_InicioCierre al cerrar el proyecto: las rutas de otro proyecto
'             no pueden quedar en la grilla ni un perl corriendo sobre ellas
'             (RC-GM-16).
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub InicializarTab()

  ' --- 1. CORTAR LA BÚSQUEDA EN CURSO ---
  ' EL Kill LLEGA DESPUÉS COMO EVENTO Y, CON $bCancelado, SOLO VACÍA
  Cancelar()

  ' --- 2. CONFIGURAR LA GRILLA VIRTUAL ---
  $bRepoblando = True
  With FMain.gvRegexResultados
    .Rows.Count = 0
    .Columns.Count = 5
    .Columns[0].Title = "Archivo"
    .Columns[0].Width = 200
    .Columns[1].Title = "Línea"
    .Columns[1].Width = 60
    .Columns[2].Title = "Col"
    .Columns[2].Width = 50
    .Columns[3].Title = "Coincidencia"
    .Columns[3].Width = 240
    .Columns[4].Title = "Reemplazo"
    ' EL ANCHO DE «REEMPLAZO» SE DECIDE EN CADA BÚSQUEDA (Buscar)
    .Columns[4].Width = 0
    .Mode = Select.Multiple
    .Header = True
  End With
  $bRepoblando = False

  ' --- 3. MODELO Y PARÁMETROS VACÍOS ---
  $aResultados.Clear
  $cSnapshot.Clear
  $sBuffer = ""
  $aArchivos = New String[]
  $sPatron = ""
  $sReemplazo = ""
  $sFlags = ""
  $sAplicar = "0"

  ' --- 4. ETIQUETAS, PREVIEW Y BOTONES ---
  FMain.lblRegexEncabezado.Text = ""
  FMain.lblRegexContador.Text = ""
  FMain.txaRegexContexto.Text = ""
  ActualizarBotones()

End

' ============================================
' Función   : Buscar
' Propósito : Recibe de m_BuscarRegex.BuscarRegex todo lo necesario para buscar
'             y lanza la búsqueda. No lee ningún control de la pestaña de
'             entrada: el ámbito, el patrón y los flags ya vienen resueltos. Se
'             llama con el editor igual al disco (SC-06 y
'             m_BuscarRegex.AlinearEditorConDisco), condición de la regla de
'             vigencia.
' Parámetros: aArchivos As String[] — rutas absolutas a buscar (ya resueltas
'               según el ámbito)
'             sPatron, sReemplazo, sFlags, sAplicar As String — parámetros del
'               script (sFlags "-" si ninguno; sAplicar "1"/"0")
'             sRutaScript As String — ruta del motor perl
' Retorna   : Boolean — True si la búsqueda quedó lanzada
' ============================================
Public Function Buscar(aArchivos As String[], sPatron As String, sReemplazo As String, sFlags As String, sAplicar As String, sRutaScript As String) As Boolean

  ' --- 1. UNA BÚSQUEDA POR VEZ ---
  ' NO SE CANCELA Y RELANZA EN EL ACTO: EL Kill DEL PROCESO VIEJO LLEGA COMO
  ' EVENTO MÁS TARDE Y SE TOMARÍA COMO FIN DEL NUEVO
  If $bBuscando Then
    m_Sonido.sonar("Warning")
    Message.Warning("Hay una búsqueda en curso." & Chr(10) & "Esperá a que termine o cancelala antes de buscar de nuevo.")
    Return False
  Endif

  ' --- 2. GUARDAR LOS PARÁMETROS ---
  $aArchivos = aArchivos
  $sPatron = sPatron
  $sReemplazo = sReemplazo
  $sFlags = sFlags
  $sAplicar = sAplicar
  $sRutaScript = sRutaScript

  ' --- 3. COLUMNA «REEMPLAZO» SOLO SI HAY REEMPLAZO ---
  ' GridView.Columns NO TIENE Visible: SE OCULTA CON ANCHO 0 (IGUAL QUE EN
  ' FProyectosParcial)
  If $sAplicar = "1" Then
    FMain.gvRegexResultados.Columns[4].Width = 240
  Else
    FMain.gvRegexResultados.Columns[4].Width = 0
  Endif

  ' --- 4. ENCABEZADO INFORMATIVO ---
  FMain.lblRegexEncabezado.Text = "Patrón: " & $sPatron & "   ·   Archivos: " & $aArchivos.Count

  ' --- 5. LANZAR ---
  Return IniciarBusqueda()

End

' ============================================
' Función   : IniciarBusqueda
' Propósito : Captura el snapshot y lanza el proceso perl en modo 'buscar' de
'             forma asíncrona. La lista de archivos va como argumentos después
'             de los parámetros fijos. La salida llega por ProcRegex_Read y se
'             procesa al terminar, en ProcRegex_Kill.
' Parámetros: ninguno
' Retorna   : Boolean — True si el proceso quedó lanzado
' ============================================
Private Function IniciarBusqueda() As Boolean

  Dim aComando As New String[]

  ' --- 1. ESTADO INICIAL ---
  $aResultados.Clear
  $sBuffer = ""
  $bCancelado = False
  $bRepoblando = True
  FMain.gvRegexResultados.Rows.Count = 0
  $bRepoblando = False
  FMain.txaRegexContexto.Text = ""
  FMain.lblRegexContador.Text = "Buscando…"

  ' --- 2. SNAPSHOT ANTES DE QUE perl LEA ---
  CapturarSnapshot()

  ' --- 3. ARMAR EL COMANDO: perl -CSA script buscar patron reemplazo flags aplicar <archivos...> ---
  ' Se arma como String[] y se agregan los archivos uno a uno: así la lista no
  ' tiene límite y ningún nombre con espacios necesita comillas (no hay shell).
  aComando.Add("perl")
  aComando.Add("-CSA")
  aComando.Add($sRutaScript)
  aComando.Add("buscar")
  aComando.Add($sPatron)
  aComando.Add($sReemplazo)
  aComando.Add($sFlags)
  aComando.Add($sAplicar)
  aComando.Insert($aArchivos)   ' AGREGA TODAS LAS RUTAS AL FINAL

  ' --- 4. LANZAR ASÍNCRONO CON LECTURA ---
  ' EL OBSERVADOR ES ESTE MÓDULO (PRECEDENTE: m_AnalizarProyecto, ProcAnalizar)
  Try $hProc = Exec aComando For Read As "ProcRegex"
  If Error Then
    FMain.lblRegexContador.Text = "Error al lanzar la búsqueda: " & Error.Text
    m_Sonido.sonar("Error")
    ActualizarBotones()
    Return False
  Endif

  $bBuscando = True
  ActualizarBotones()
  Return True

End

' ============================================
' Función   : ProcRegex_Read
' Propósito : LLEGA SALIDA DEL PROCESO. SE ACUMULA CRUDA Y SE PARSEA AL FINAL:
'             UNA COINCIDENCIA (O UN CARÁCTER MULTIBYTE) PUEDE QUEDAR PARTIDA
'             ENTRE DOS LECTURAS. Read #Last, -N ES LA FORMA DE MT-B: LEE HASTA
'             N BYTES DE LO DISPONIBLE SIN BLOQUEAR
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub ProcRegex_Read()

  Dim sTrozo As String

  Try sTrozo = Read #Last, -4096
  If Not Error Then $sBuffer &= sTrozo

End

' ============================================
' Función   : ProcRegex_Kill
' Propósito : EL PROCESO TERMINÓ, SOLO O POR Cancelar; $bCancelado DISTINGUE
'             CUÁL FUE (PATRÓN DE MT-B). SIN CANCELACIÓN, PARSEA EL BUFFER,
'             PUEBLA LA GRILLA Y CUENTA
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub ProcRegex_Kill()

  ' --- 1. FIN DE LA BÚSQUEDA ---
  $bBuscando = False

  ' --- 2. SI FUE CANCELADA, DESCARTAR TODO ---
  If $bCancelado Then
    $aResultados.Clear
    $bRepoblando = True
    FMain.gvRegexResultados.Rows.Count = 0
    $bRepoblando = False
    FMain.lblRegexContador.Text = "Búsqueda cancelada."
    ActualizarBotones()
    m_Sonido.sonar("Info")
    Return
  Endif

  ' --- 3. PARSEAR EL BUFFER COMPLETO A REGISTROS ---
  ' CUANDO Kill SE DISPARA, Read YA ENTREGÓ TODO HASTA EOF
  ParsearResultados()

  ' --- 4. VOLCAR A LA GRILLA Y CONTAR ---
  $bRepoblando = True
  FMain.gvRegexResultados.Rows.Count = $aResultados.Count
  FMain.gvRegexResultados.Refresh
  $bRepoblando = False
  ActualizarContador()
  ActualizarBotones()

  If $aResultados.Count = 0 Then
    m_Sonido.sonar("Warning")
  Else
    m_Sonido.sonar("Info")
  Endif

End

' ============================================
' Función   : Cancelar
' Propósito : ATIENDE btnRegexCancelar Y EL CIERRE DEL PROYECTO. LEVANTA LA
'             BANDERA Y MATA EL PROCESO; ProcRegex_Kill DESCARTA LO JUNTADO
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub Cancelar()

  ' --- 1. SIN BÚSQUEDA EN CURSO NO HAY NADA QUE CORTAR ---
  If Not $bBuscando Then Return

  ' --- 2. BANDERA Y Kill ---
  ' LA BANDERA VA PRIMERO: Kill EMITE EL MISMO EVENTO QUE UNA TERMINACIÓN
  ' NORMAL Y LA BANDERA ES LO QUE LAS DISTINGUE (MT-B)
  $bCancelado = True
  ' If ANIDADOS: And NO CORTOCIRCUITA (RC-GM-17)
  If Not IsNull($hProc) Then
    If Object.IsValid($hProc) Then
      If $hProc.State = Process.Running Then Try $hProc.Kill
    Endif
  Endif

End

' ============================================
' Función   : CapturarSnapshot
' Propósito : Guarda "mtime|size" de cada archivo que se va a buscar. Es el
'             estado contra el que la regla de vigencia compara antes de saltar
'             o de escribir.
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub CapturarSnapshot()

  Dim sRuta As String

  $cSnapshot.Clear

  ' UNA RUTA REPETIDA EN LA LISTA SE CAPTURA UNA SOLA VEZ
  For Each sRuta In $aArchivos
    If Not $cSnapshot.Exist(sRuta) Then $cSnapshot[sRuta] = FirmaArchivo(sRuta)
  Next

End

' ============================================
' Función   : FirmaArchivo
' Propósito : Devuelve "mtime|size" de un archivo, o "" si no se puede leer.
'             Stat().Time es el mtime (verificado en el fuente: info.mtime);
'             Stat().Size el tamaño en bytes. Juntos detectan tanto ediciones
'             que cambian el tamaño como las que solo tocan el mtime.
' Parámetros: sRuta As String — ruta absoluta
' Retorna   : String — "mtime|size" o "" si Stat falla
' ============================================
Private Function FirmaArchivo(sRuta As String) As String

  Dim hStat As Stat

  Try hStat = Stat(sRuta)
  If Error Then Return ""
  Return CStr(hStat.Time) & "|" & CStr(hStat.Size)

End

' ============================================
' Función   : ArchivoVigente
' Propósito : REGLA DE VIGENCIA (SC-51). Las coincidencias de un archivo valen
'             si su firma es la del snapshot y, si es el abierto, el editor no
'             tiene cambios sin guardar. Con eso el disco es el que leyó perl y
'             el editor es igual al disco (lo dejó así la búsqueda).
' Parámetros: sRuta As String — ruta absoluta del archivo
' Retorna   : Boolean — True si sus posiciones siguen valiendo
' ============================================
Private Function ArchivoVigente(sRuta As String) As Boolean

  Dim sAhora As String

  ' --- 1. DISCO: LA FIRMA DE AHORA CONTRA LA DEL SNAPSHOT ---
  ' FIRMA VACÍA (Stat FALLÓ) O AUSENTE DEL SNAPSHOT: NO SE PUEDE AFIRMAR NADA
  If Not $cSnapshot.Exist(sRuta) Then Return False
  sAhora = FirmaArchivo(sRuta)
  If sAhora = "" Then Return False
  If sAhora <> $cSnapshot[sRuta] Then Return False

  ' --- 2. EDITOR: EL ABIERTO NO PUEDE TENER CAMBIOS SIN GUARDAR ---
  If sRuta = FMain.sRutaArchivoAbierto Then
    If m_EditorPrincipal.HayCambios() Then Return False
  Endif

  Return True

End

' ============================================
' Función   : Rebuscar
' Propósito : Vuelve a buscar con los mismos parámetros cuando la regla de
'             vigencia falló. Pasa por las mismas condiciones que la primera
'             búsqueda: aviso de cambios sin guardar (SC-06) y editor igual al
'             disco; sin ellas, perl volvería a leer un disco distinto del
'             editor.
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub Rebuscar()

  ' --- 1. AVISO Y CONDICIONES DE LA BÚSQUEDA ---
  m_Sonido.sonar("Info")
  Message.Info("El texto cambió desde la búsqueda." & Chr(10) & "Se vuelve a buscar.")
  If Not FMain.ConfirmarDescartarCambios() Then Return
  If Not m_BuscarRegex.AlinearEditorConDisco() Then Return

  ' --- 2. RELANZAR ---
  IniciarBusqueda()

End

' ============================================
' Función   : ParsearResultados
' Propósito : Convierte el buffer crudo (campos separados por NUL, 8 por
'             registro) en $aResultados: una lista de String[] de 8 campos.
'             El script termina cada campo con NUL, incluido el último de cada
'             registro, así que el total de campos es múltiplo de 8.
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub ParsearResultados()

  Dim aCampos As String[]
  Dim iBase As Integer
  Dim aRegistro As String[]
  Dim j As Integer

  $aResultados.Clear
  If $sBuffer = "" Then Return

  ' Split por NUL. El buffer termina en NUL, lo que genera un último elemento
  ' vacío; se descarta al iterar por bloques exactos de 8.
  aCampos = Split($sBuffer, Chr(0), "", False)

  ' Se recorre en bloques de 8. Si el último bloque está incompleto (proceso
  ' cortado a la mitad pese a no ser cancelación), se descarta.
  iBase = 0
  While iBase + 8 <= aCampos.Count
    aRegistro = New String[]
    For j = 0 To 7
      aRegistro.Add(aCampos[iBase + j])
    Next
    $aResultados.Add(aRegistro)
    iBase += 8
  Wend

End

' ============================================
' Función   : TextoCelda
' Propósito : TEXTO DE LA CELDA (Row, Column) DE LA GRILLA VIRTUAL, LEÍDO DEL
'             MODELO. LO ASIGNA FMain.gvRegexResultados_Data: EL OBJETO .Data
'             SOLO SE TOCA DENTRO DEL HANDLER DEL EVENTO
' Parámetros: Row As Integer — fila (índice en $aResultados)
'             Column As Integer — columna
' Retorna   : String — el texto; "" fuera de rango
' ============================================
Public Function TextoCelda(Row As Integer, Column As Integer) As String

  Dim aReg As String[]

  ' If SEPARADOS: Or NO CORTOCIRCUITA (RC-GM-17)
  If Row < 0 Then Return ""
  If Row >= $aResultados.Count Then Return ""
  aReg = $aResultados[Row]

  Select Case Column
    Case 0
      ' SOLO EL NOMBRE, NO LA RUTA ENTERA (LA COLUMNA ES ANGOSTA)
      Return File.Name(aReg[C_ARCHIVO])
    Case 1
      ' LÍNEA EN BASE 1 PARA EL USUARIO (EL SCRIPT LA DA EN BASE 0)
      Return CStr(CInt(aReg[C_LINEA]) + 1)
    Case 2
      Return CStr(CInt(aReg[C_COLUMNA]) + 1)
    Case 3
      Return aReg[C_ANTES]
    Case 4
      Return aReg[C_DESPUES]
  End Select

  Return ""

End

' ============================================
' Función   : CambioDeFila
' Propósito : MUESTRA EN txaRegexContexto EL PREVIEW DE LA FILA ACTUAL. LA LLAMA
'             FMain.gvRegexResultados_Change: MoveTo LO EMITE CADA VEZ QUE CAMBIA
'             LA FILA, CON EL MOUSE O CON LAS FLECHAS, EN CUALQUIER MODO DE
'             SELECCIÓN (GV-78). NO MUEVE EL EDITOR
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub CambioDeFila()

  ' UNA FILA MOVIDA POR EL CÓDIGO AL VOLVER A LLENAR LA GRILLA NO SE MUESTRA
  If $bRepoblando Then Return

  MostrarPreview(FMain.gvRegexResultados.Row)

End

' ============================================
' Función   : IrACoincidencia
' Propósito : LLEVA EL EDITOR A LA COINCIDENCIA DE LA FILA CLICKEADA (SC-51), SI
'             SU ARCHIVO PASA LA REGLA DE VIGENCIA; SI NO, VUELVE A BUSCAR. LA
'             LLAMA FMain.gvRegexResultados_Click: Click Y NO Select (GV-78). EN
'             Select.Multiple, Select AVISA QUE CAMBIÓ LA SELECCIÓN, NO QUE SE
'             ELIGIÓ UNA FILA; Click SALE ÚNICAMENTE DEL MOUSE SOBRE UNA CELDA,
'             DIFERIDO, Y LLENAR LA GRILLA DESDE EL CÓDIGO NUNCA LO DISPARA
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub IrACoincidencia()

  Dim iFila As Integer
  Dim aReg As String[]

  ' --- 1. LA FILA CLICKEADA ---
  iFila = FMain.gvRegexResultados.Row
  If iFila < 0 Then Return
  If iFila >= $aResultados.Count Then Return
  aReg = $aResultados[iFila]

  ' --- 2. EL PREVIEW TAMBIÉN, POR SI Change NO CORRIÓ (CLICK SOBRE LA FILA ACTUAL) ---
  MostrarPreview(iFila)

  ' --- 3. POSICIÓN VIEJA: NO SE SALTA A CIEGAS (REGLA DE VIGENCIA, SC-51) ---
  If Not ArchivoVigente(aReg[C_ARCHIVO]) Then
    Rebuscar()
    Return
  Endif

  ' --- 4. EL EDITOR: ARCHIVO, PÁRRAFO ARRIBA Y SELECCIÓN ---
  ' LÍNEA Y COLUMNA BASE 0, TAL COMO LAS DA EL SCRIPT
  m_BuscarRegex.MostrarCoincidencia(aReg[C_ARCHIVO], CInt(aReg[C_LINEA]), CInt(aReg[C_COLUMNA]), CInt(aReg[C_LARGO]))

End

' ============================================
' Función   : MostrarPreview
' Propósito : ESCRIBE EN txaRegexContexto EL ARCHIVO, LA POSICIÓN Y LA LÍNEA
'             ANTES Y DESPUÉS DEL REEMPLAZO DE UNA COINCIDENCIA
' Parámetros: iFila As Integer — fila de la grilla (índice en $aResultados)
' Retorna   : nada
' ============================================
Private Sub MostrarPreview(iFila As Integer)

  Dim aReg As String[]
  Dim sLineaOriginal As String
  Dim sLineaResultante As String
  Dim sTexto As String

  If iFila < 0 Then Return
  If iFila >= $aResultados.Count Then Return
  aReg = $aResultados[iFila]

  ' --- 1. ENCABEZADO: ARCHIVO Y POSICIÓN ---
  sTexto = File.Name(aReg[C_ARCHIVO]) & "  ·  línea " & CStr(CInt(aReg[C_LINEA]) + 1) &
    ", columna " & CStr(CInt(aReg[C_COLUMNA]) + 1) & Chr(10) & Chr(10)

  ' --- 2. LÍNEA ORIGINAL ---
  sLineaOriginal = aReg[C_LINEA_TEXTO]
  sTexto &= "ANTES:" & Chr(10) & sLineaOriginal & Chr(10) & Chr(10)

  ' --- 3. LÍNEA RESULTANTE (SOLO SI HAY REEMPLAZO) ---
  ' Se reconstruye la línea aplicando el reemplazo SOLO a esta coincidencia,
  ' usando la columna dentro de la línea. Es un preview de una coincidencia, no
  ' del archivo entero. TextArea es texto plano, sin resaltado; el contraste
  ' ANTES/DESPUÉS lo da la comparación visual línea a línea.
  If $sAplicar = "1" Then
    sLineaResultante = ReemplazarEnLinea(sLineaOriginal, CInt(aReg[C_COLUMNA]), CInt(aReg[C_LARGO]), aReg[C_DESPUES])
    sTexto &= "DESPUÉS:" & Chr(10) & sLineaResultante
  Endif

  FMain.txaRegexContexto.Text = sTexto

End

' ============================================
' Función   : ReemplazarEnLinea
' Propósito : Devuelve la línea con el reemplazo aplicado en una posición. Es
'             solo para el preview de UNA coincidencia: corta la línea en la
'             columna, inserta el texto nuevo y pega el resto. Usa String.Mid
'             (por caracteres, UTF-8, SC-02) coherente con los offsets del
'             script.
' Parámetros: sLinea As String — la línea completa original
'             iColumna As Integer — columna 0-based donde empieza la coincidencia
'             iLargo As Integer — largo en caracteres de la coincidencia
'             sNuevo As String — texto de reemplazo ya expandido
' Retorna   : String — la línea con el reemplazo
' ============================================
Private Function ReemplazarEnLinea(sLinea As String, iColumna As Integer, iLargo As Integer, sNuevo As String) As String

  Dim sAntes As String
  Dim sDespues As String

  ' String.Mid ES 1-BASED; LA COLUMNA DEL SCRIPT ES 0-BASED
  sAntes = String.Mid(sLinea, 1, iColumna)
  sDespues = String.Mid(sLinea, iColumna + iLargo + 1)
  Return sAntes & sNuevo & sDespues

End

' ============================================
' Función   : ActualizarContador
' Propósito : "N coincidencias en M archivos". M es la cantidad de archivos
'             DISTINTOS que aparecen en los resultados, no la cantidad buscada.
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub ActualizarContador()

  Dim aReg As String[]
  Dim cArchivos As New Collection

  For Each aReg In $aResultados
    ' LA CLAVE DE LA COLECCIÓN HACE DE CONJUNTO: ARCHIVOS DISTINTOS
    cArchivos[aReg[C_ARCHIVO]] = True
  Next

  FMain.lblRegexContador.Text = CStr($aResultados.Count) & " coincidencia(s) en " & CStr(cArchivos.Count) & " archivo(s)"

End

' ============================================
' Función   : ActualizarBotones
' Propósito : Habilita los botones según el estado: Cancelar solo mientras
'             busca; Reemplazar solo con reemplazo escrito, sin búsqueda en
'             curso y con coincidencias.
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub ActualizarBotones()

  FMain.btnRegexCancelar.Enabled = $bBuscando
  FMain.btnRegexReemplazar.Enabled = ($sAplicar = "1") And (Not $bBuscando) And ($aResultados.Count > 0)

End

' ============================================
' Función   : Reemplazar
' Propósito : Aplica el reemplazo a las coincidencias SELECCIONADAS en la grilla.
'             Es la única acción destructiva de la pestaña. La llama
'             FMain.btnRegexReemplazar_Click. Flujo:
'               1. validar que haya reemplazo y selección
'               2. guard de git ACOTADO a los archivos afectados
'               3. regla de vigencia de TODOS los afectados (todo o nada)
'               4. escribir cada archivo (coincidencias de atrás para adelante)
'               5. recargar lo escrito: editor, árbol y referencias (SC-51)
'               6. el editor queda en el último archivo cambiado
'               7. log en log/ del proyecto
'               8. re-correr la búsqueda para confirmar convergencia
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub Reemplazar()

  Dim aSel As Integer[]
  Dim cPorArchivo As Collection
  Dim sHead As String
  Dim aArchivosAfectados As String[]
  Dim sArchivoTocado As String
  Dim iTotalReemplazos As Integer
  Dim aEscritos As New String[]

  ' --- 1. VALIDACIONES DE ENTRADA ---
  ' EL BOTÓN YA ESTÁ DESHABILITADO EN ESTOS CASOS (ActualizarBotones); LA
  ' VALIDACIÓN QUEDA COMO DEFENSA
  If $bBuscando Then Return
  If $sAplicar <> "1" Then
    m_Sonido.sonar("Warning")
    Message.Warning("No hay texto de reemplazo: esta fue una búsqueda pura.")
    Return
  Endif

  aSel = FilasSeleccionadas()
  If aSel.Count = 0 Then
    m_Sonido.sonar("Warning")
    Message.Warning("Seleccioná al menos una coincidencia para reemplazar." & Chr(10) &
      "Podés usar Ctrl+A para seleccionar todas.")
    Return
  Endif

  ' --- 2. AGRUPAR LAS SELECCIONADAS POR ARCHIVO ---
  cPorArchivo = AgruparPorArchivo(aSel)
  aArchivosAfectados = ClavesColeccion(cPorArchivo)

  ' --- 3. GUARD DE GIT ACOTADO A LOS ARCHIVOS AFECTADOS ---
  If Not m_BuscarRegex.PasarGuardGit(aArchivosAfectados) Then Return

  ' --- 4. REGLA DE VIGENCIA: TODO O NADA (SC-51) ---
  ' VA DESPUÉS DEL GUARD, LO MÁS CERCA POSIBLE DE LA ESCRITURA. SI UN ARCHIVO
  ' AFECTADO CAMBIÓ EN DISCO O EL ABIERTO TIENE CAMBIOS SIN GUARDAR, NO SE
  ' ESCRIBE NINGUNO: LA RECARGA POSTERIOR (TrasReemplazo) PISARÍA ESOS CAMBIOS
  For Each sArchivoTocado In aArchivosAfectados
    If Not ArchivoVigente(sArchivoTocado) Then
      Rebuscar()
      Return
    Endif
  Next

  ' --- 5. CAPTURAR EL HEAD PARA EL LOG (ANTES DE ESCRIBIR) ---
  sHead = m_Git.ObtenerHead(m_InicioCierre.RutaProyectoEnCurso)

  ' --- 6. ESCRIBIR CADA ARCHIVO ---
  iTotalReemplazos = 0
  For Each sArchivoTocado In aArchivosAfectados
    If Not EscribirArchivo(sArchivoTocado, cPorArchivo[sArchivoTocado]) Then
      ' UN FALLO A MITAD ES EL PEOR CASO: SE INFORMA Y SE FRENA. LOS ARCHIVOS YA
      ' ESCRITOS QUEDAN ESCRITOS; git ES EL DESHACER. NO SE SIGUE ESCRIBIENDO.
      ' LO YA ESCRITO SE RECARGA IGUAL: EL EDITOR NO PUEDE QUEDAR CON LO VIEJO
      m_BuscarRegex.TrasReemplazo(aEscritos)
      m_Sonido.sonar("Error")
      Message.Error("Error al escribir " & File.Name(sArchivoTocado) & "." & Chr(10) &
        "Se detuvo el reemplazo. Revisá el estado con git." & Chr(10) &
        "Los archivos ya modificados se pueden revertir con:" & Chr(10) &
        "git checkout " & sHead & " -- .")
      ' LAS POSICIONES DE LO ESCRITO YA NO VALEN: SE VUELVE A BUSCAR
      IniciarBusqueda()
      Return
    Endif
    aEscritos.Add(sArchivoTocado)
    iTotalReemplazos += cPorArchivo[sArchivoTocado].Count
  Next

  ' --- 7. RECARGAR LO ESCRITO: EDITOR, ÁRBOL Y REFERENCIAS (SC-51) ---
  ' EN EL ACTO: SE SIGUE NAVEGANDO SOBRE EL TEXTO NUEVO. NO POR EL Click DEL
  ' COMBO, QUE SALE SIN HACER NADA SI EL ARCHIVO YA ESTÁ ABIERTO (GV-53)
  m_BuscarRegex.TrasReemplazo(aEscritos)

  ' --- 8. EL EDITOR QUEDA EN EL ÚLTIMO ARCHIVO CAMBIADO, EN SU PRIMER CAMBIO ---
  MostrarUltimoReemplazo(aEscritos, cPorArchivo)

  ' --- 9. LOG ---
  EscribirLog(aArchivosAfectados, cPorArchivo, sHead, iTotalReemplazos)

  ' --- 10. AVISO Y RE-CORRIDA ---
  m_Sonido.sonar("Info")
  Message.Info(CStr(iTotalReemplazos) & " reemplazo(s) en " & CStr(aArchivosAfectados.Count) & " archivo(s)." & Chr(10) &
    "Se relanza la búsqueda para confirmar el resultado.")

  ' RE-CORRER: confirma convergencia y detecta patrones que no convergen (si el
  ' reemplazo vuelve a matchear, el contador no baja). EL EDITOR QUEDÓ IGUAL AL
  ' DISCO POR LA RECARGA: NO HACE FALTA EL AVISO DE Rebuscar
  IniciarBusqueda()

End

' ============================================
' Función   : MostrarUltimoReemplazo
' Propósito : Deja el editor en el ÚLTIMO archivo escrito (orden de la grilla,
'             que es el editorial), con el PRIMER cambio de ese archivo
'             seleccionado y su párrafo arriba (decisión de Alberto, SC-51). El
'             primer cambio no se corrió: los reemplazos van de atrás para
'             adelante y ninguno queda antes que él, así que su línea y su
'             columna siguen valiendo; el largo es el del texto nuevo.
' Parámetros: aEscritos As String[] — rutas escritas, en orden
'             cPorArchivo As Collection — ruta → Integer[] de índices en
'                                         $aResultados (las filas reemplazadas)
' Retorna   : nada
' ============================================
Private Sub MostrarUltimoReemplazo(aEscritos As String[], cPorArchivo As Collection)

  Dim sUltimo As String
  Dim aIdx As Integer[]
  Dim iIdx As Integer
  Dim iPrimero As Integer
  Dim aReg As String[]

  ' --- 1. SIN ARCHIVOS ESCRITOS NO HAY NADA QUE MOSTRAR ---
  If aEscritos.Count = 0 Then Return
  sUltimo = aEscritos[aEscritos.Max]
  aIdx = cPorArchivo[sUltimo]

  ' --- 2. LA COINCIDENCIA DE MENOR OFFSET DE ESE ARCHIVO ---
  iPrimero = aIdx[0]
  For Each iIdx In aIdx
    If CInt($aResultados[iIdx][C_OFFSET]) < CInt($aResultados[iPrimero][C_OFFSET]) Then iPrimero = iIdx
  Next
  aReg = $aResultados[iPrimero]

  ' --- 3. ABRIR (SI HACE FALTA) Y SELECCIONAR EL TEXTO NUEVO ---
  m_BuscarRegex.MostrarCoincidencia(aReg[C_ARCHIVO], CInt(aReg[C_LINEA]), CInt(aReg[C_COLUMNA]), String.Len(aReg[C_DESPUES]))

End

' ============================================
' Función   : FilasSeleccionadas
' Propósito : Devuelve los índices de las filas seleccionadas en la grilla.
' Parámetros: ninguno
' Retorna   : Integer[] — índices en $aResultados
' ============================================
Private Function FilasSeleccionadas() As Integer[]

  Dim aSel As New Integer[]
  Dim i As Integer

  For i = 0 To $aResultados.Count - 1
    If FMain.gvRegexResultados.Rows[i].Selected Then aSel.Add(i)
  Next

  Return aSel

End

' ============================================
' Función   : AgruparPorArchivo
' Propósito : Agrupa los índices seleccionados por archivo. Clave: ruta
'             absoluta. Valor: Integer[] con los índices de $aResultados de ese
'             archivo.
' Parámetros: aSel As Integer[] — índices seleccionados
' Retorna   : Collection de Integer[]
' ============================================
Private Function AgruparPorArchivo(aSel As Integer[]) As Collection

  Dim c As New Collection
  Dim iIdx As Integer
  Dim sArchivo As String
  Dim aIdx As Integer[]

  For Each iIdx In aSel
    sArchivo = $aResultados[iIdx][C_ARCHIVO]
    If c.Exist(sArchivo) Then
      aIdx = c[sArchivo]
    Else
      aIdx = New Integer[]
      c[sArchivo] = aIdx
    Endif
    aIdx.Add(iIdx)
  Next

  Return c

End

' ============================================
' Función   : ClavesColeccion
' Propósito : Devuelve las claves de una Collection como String[]. Gambas no
'             expone las claves directamente como array; se recorre con el
'             enumerador y se usa Collection.Key.
' Parámetros: c As Collection
' Retorna   : String[]
' ============================================
Private Function ClavesColeccion(c As Collection) As String[]

  Dim aClaves As New String[]
  Dim v As Variant

  For Each v In c
    aClaves.Add(c.Key)
  Next

  Return aClaves

End

' ============================================
' Función   : EscribirArchivo
' Propósito : Aplica al archivo todas sus coincidencias seleccionadas, de atrás
'             para adelante (offset descendente), para que los offsets anteriores
'             no se corran. Un solo File.Load y un solo File.Save por archivo.
' Parámetros: sRuta As String — ruta absoluta del archivo
'             aIndices As Integer[] — índices en $aResultados de este archivo
' Retorna   : Boolean — True si se escribió sin error
' ============================================
Private Function EscribirArchivo(sRuta As String, aIndices As Integer[]) As Boolean

  Dim sContenido As String
  Dim aOrdenados As Integer[]
  Dim iIdx As Integer
  Dim aReg As String[]
  Dim iOffset As Integer
  Dim iLargo As Integer
  Dim sDespues As String
  Dim sAntes As String
  Dim sResto As String

  ' --- 1. CARGAR EL ARCHIVO ENTERO ---
  Try sContenido = File.Load(sRuta)
  If Error Then Return False

  ' --- 2. ORDENAR LOS ÍNDICES POR OFFSET DESCENDENTE ---
  ' Aplicar de atrás para adelante mantiene válidos los offsets de las
  ' coincidencias anteriores (que están antes en el texto).
  aOrdenados = OrdenarPorOffsetDesc(aIndices)

  ' --- 3. APLICAR CADA COINCIDENCIA ---
  ' String.Mid es 1-based y por caracteres (UTF-8, SC-02), coherente con los
  ' offsets del script, que están en caracteres (no bytes).
  For Each iIdx In aOrdenados
    aReg = $aResultados[iIdx]
    iOffset = CInt(aReg[C_OFFSET])
    iLargo = CInt(aReg[C_LARGO])
    sDespues = aReg[C_DESPUES]

    sAntes = String.Mid(sContenido, 1, iOffset)
    sResto = String.Mid(sContenido, iOffset + iLargo + 1)
    sContenido = sAntes & sDespues & sResto
  Next

  ' --- 4. GUARDAR ---
  ' File.Save es UTF-8 nativo (SC-02): preserva acentos, NBSP y demás.
  Try File.Save(sRuta, sContenido)
  If Error Then Return False

  Return True

End

' ============================================
' Función   : OrdenarPorOffsetDesc
' Propósito : Devuelve los índices ordenados por el offset de su coincidencia,
'             de mayor a menor. Selection sort simple: la cantidad de
'             coincidencias por archivo es chica (decenas), no justifica más.
' Parámetros: aIndices As Integer[]
' Retorna   : Integer[] — mismos índices, orden descendente por offset
' ============================================
Private Function OrdenarPorOffsetDesc(aIndices As Integer[]) As Integer[]

  Dim a As Integer[] = aIndices.Copy()
  Dim i As Integer
  Dim j As Integer
  Dim iMax As Integer
  Dim iTmp As Integer

  For i = 0 To a.Count - 2
    iMax = i
    For j = i + 1 To a.Count - 1
      If CInt($aResultados[a[j]][C_OFFSET]) > CInt($aResultados[a[iMax]][C_OFFSET]) Then iMax = j
    Next
    If iMax <> i Then
      iTmp = a[i]
      a[i] = a[iMax]
      a[iMax] = iTmp
    Endif
  Next

  Return a

End

' ============================================
' Función   : EscribirLog
' Propósito : Registra la operación en log/ del proyecto (ignorado por git). El
'             log es la hoja de ruta LOCAL: qué se cambió y con qué hash volver
'             atrás. Formato texto plano legible, acumulativo (se agrega al
'             final del mismo archivo).
' Parámetros: aArchivos As String[] — rutas afectadas
'             cPorArchivo As Collection — ruta → Integer[] de índices
'             sHead As String — commit previo al reemplazo; "" sin repo
'             iTotal As Integer — total de reemplazos
' Retorna   : nada
' ============================================
Private Sub EscribirLog(aArchivos As String[], cPorArchivo As Collection, sHead As String, iTotal As Integer)

  Dim sRutaLog As String
  Dim sLog As String
  Dim sArchivo As String
  Dim sLinea As String
  Dim hArchivo As File

  sRutaLog = m_InicioCierre.RutaProyectoEnCurso &/ "log" &/ "reemplazos-regex.log"

  ' --- 1. CONSTRUIR EL BLOQUE ---
  sLog = "════════════════════════════════════════" & Chr(10)
  sLog &= "Operación de reemplazo regex" & Chr(10)
  sLog &= "Fecha:     " & Format(Now(), "yyyy-mm-dd hh:nn:ss") & Chr(10)
  sLog &= "Usuario:   " & m_InicioCierre.UsuarioEnCurso & Chr(10)
  If sHead <> "" Then sLog &= "Commit:    " & sHead & Chr(10)
  sLog &= "Patrón:    " & $sPatron & Chr(10)
  sLog &= "Reemplazo: " & $sReemplazo & Chr(10)
  sLog &= "Flags:     " & $sFlags & Chr(10)
  sLog &= "────────────────────────────────────────" & Chr(10)
  For Each sArchivo In aArchivos
    sLinea = File.Name(sArchivo) & ": " & CStr(cPorArchivo[sArchivo].Count) & " reemplazo(s)"
    sLog &= sLinea & Chr(10)
  Next
  sLog &= "────────────────────────────────────────" & Chr(10)
  sLog &= "Total: " & CStr(iTotal) & " reemplazo(s) en " & CStr(aArchivos.Count) & " archivo(s)" & Chr(10)
  If sHead <> "" Then sLog &= "Para deshacer: git checkout " & sHead & " -- ." & Chr(10)
  sLog &= "════════════════════════════════════════" & Chr(10) & Chr(10)

  ' --- 2. APENDER AL ARCHIVO (CREAR SI NO EXISTE) ---
  ' Un fallo de log NO debe abortar nada: el reemplazo ya se hizo. Se avisa
  ' suave y se sigue. Try por línea (patrón del proyecto), no Try de bloque.
  If Exist(sRutaLog) Then
    Try hArchivo = Open sRutaLog For Append
  Else
    Try hArchivo = Open sRutaLog For Create
  Endif
  If Error Then
    m_Sonido.sonar("Warning")
    Return
  Endif

  Try Print #hArchivo, sLog;
  Try Close #hArchivo

End
