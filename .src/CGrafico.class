' Gambas class file

' UN GRÁFICO (SC-69): EL ARCHIVO graficos/fig-….md YA LEÍDO. LO LLENA
' m_Graficos.Leer Y LO ESCRIBE m_Graficos.Escribir; FGraficos LO EDITA.
'
' LOS VALORES SON LOS DEL ARCHIVO, SIN TRADUCIR: «sí» ES True, UNA CLAVE QUE
' FALTA TIENE SU VALOR POR OMISIÓN. ESTA CLASE NO VALIDA: LO QUE FRENA AL
' GENERAR LO DICE m_Graficos.Controlar.
'
' LA TABLA ES SIEMPRE UNA PIPE TABLE, CELDA POR CELDA: UN GRÁFICO NO TIENE
' CELDAS UNIDAS. LA PRIMERA COLUMNA SON LAS CATEGORÍAS (EN dispersion, LAS x);
' CADA COLUMNA SIGUIENTE ES UNA SERIE.

' --- EL ENCABEZADO ---
Public Tipo As String = "barras"
Public Paleta As String = "Dark2"
Public Leyenda As Boolean = True
' LAS SERIES QUE SE DIBUJAN, CONTADAS DESDE 1 (LA PRIMERA COLUMNA DE DATOS);
' VACÍA: TODAS
Public Series As New Integer[]
Public EjeX As String
Public EjeY As String
Public Unidad As String
Public Apilado As Boolean
Public Cero As Boolean = True
Public Proporcion As String = "16:10"

' --- LA TABLA ---
Public Encabezado As New String[]
Public Filas As New String[][]
