' Gambas module file

'''
''' MÓDULO: m_Hunspell
''' DESCRIPCIÓN: INTERFAZ CON HUNSPELL PARA VERIFICACIÓN ORTOGRÁFICA
''' PROYECTO: gbpublisher
'''
''' CONSUMIDORES: FOrtografia (editor de texto .md) y m_EditorRTF (editor RTF).
''' EL MÓDULO DETECTA; CADA EDITOR DECIDE CÓMO MARCAR.
'''
''' REESCRITURA 2026-09. QUÉ CAMBIÓ Y POR QUÉ:
'''
''' 1. TODO EL RECORRIDO DE TEXTO PASA A String.Len / String.Mid / String.Code.
'''    LA VERSIÓN ANTERIOR USABA Len / Mid / Asc, QUE OPERAN EN BYTES
'''    (RC-GM-12, SC-02, GV-03). CONSECUENCIA MEDIDA: EsCaracterDePalabra
'''    RECIBÍA UN BYTE SUELTO Y PARTÍA EN DOS TODO CARÁCTER MULTIBYTE. LAS
'''    CATORCE LETRAS DEL CASTELLANO SOBREVIVÍAN POR UNA COINCIDENCIA —EL
'''    InStr, TAMBIÉN BYTE-ORIENTADO, ENCONTRABA SUS BYTES DE CONTINUACIÓN
'''    DENTRO DE LOS LITERALES "ÁÉÍÓÚÑÜ" Y "áéíóúñü"— PERO 34 CARACTERES MÁS
'''    (à â ã ä ç è ê ë ì ï ò ô õ ö ø ù û Y SUS MAYÚSCULAS) SE PARTÍAN. UNA
'''    PALABRA PARTIDA LLEGA A HUNSPELL COMO UTF-8 INVÁLIDO, VUELVE DISTINTA
'''    DE COMO SE GUARDÓ, Y EL ERROR SE DESCARTA EN SILENCIO: FALSO NEGATIVO.
'''    VERIFICADO CON "camàra", QUE NO SE DETECTABA COMO ERROR.
'''
''' 2. LAS POSICIONES QUE DEVUELVE ExtraerPalabras SON AHORA EN CARACTERES.
'''    ES LA UNIDAD QUE YA USAN LA COLUMNA DEL TextEditor (VERIFICADO 2026-09)
'''    Y LA PROPIEDAD Pos DEL TextEdit. NO HAY QUE CONVERTIR EN NINGÚN LADO.
'''
''' 3. SE ELIMINA gb.pcre. SC-05 FIJÓ QUE EL MOTOR DE EXPRESIONES REGULARES DEL
'''    PROYECTO ES perl EXTERNO. ACÁ NO HACE FALTA NINGUNO: LOS PATRONES SON
'''    FIJOS Y SE RESUELVEN CON UN SOLO RECORRIDO LINEAL DEL TEXTO.
'''
''' 4. Shell PASA A Exec CON ARRAY (SC-05). COMO HACE FALTA REDIRECCIÓN, SE USA
'''    EL PATRÓN DE PARÁMETROS POSICIONALES DE GV-06: EL SCRIPT NO CONCATENA
'''    NOMBRES, LOS RECIBE COMO "$1", "$2", "$3".
'''
''' 5. LOS FALLOS SE INFORMAN. ANTES, SI FALTABA HUNSPELL O EL DICCIONARIO, LA
'''    SALIDA ERA CADENA VACÍA Y EL LLAMADOR LO LEÍA COMO "NO HAY ERRORES"
'''    (GV-20, GV-23). AHORA TODA FUNCIÓN QUE HABLE CON HUNSPELL DEJA EL
'''    DIAGNÓSTICO EN UltimoError, Y EL LLAMADOR DEBE CONSULTARLO.
'''

' ============================================
' ESTADO PÚBLICO DEL MÓDULO
' ============================================

' CANAL DE DIAGNÓSTICO. CADENA VACÍA = LA ÚLTIMA OPERACIÓN SALIÓ BIEN.
' ES LA ALTERNATIVA 4 DE GV-24: VARIABLE DE MÓDULO CUANDO EL DATO ES UN
' SUBPRODUCTO Y NO EL RESULTADO. SE LIMPIA AL INICIO DE CADA OPERACIÓN.
Public UltimoError As String

' ============================================
' CONSTANTES
' ============================================

' RUTAS ESTÁNDAR DE DICCIONARIOS HUNSPELL EN LINUX
Private Const RUTA_HUNSPELL As String = "/usr/share/hunspell/"
Private Const RUTA_MYSPELL As String = "/usr/share/myspell/"

' CARPETA DE CONFIGURACIÓN DEL USUARIO PARA LOS DICCIONARIOS PERSONALES
Private Const CARPETA_CONFIG As String = ".config/gbpublisher"

' CODEPOINTS DE LOS CARACTERES QUE SOLO VALEN DENTRO DE UNA PALABRA
Private Const COD_GUION As Integer = 45           ' -
Private Const COD_APOSTROFO_RECTO As Integer = 39 ' '
Private Const COD_APOSTROFO_CURVO As Integer = 8217 ' ’ U+2019, EL QUE EMITE PANDOC

' RANGO LATIN EXTENDED-A, PARA APELLIDOS DE EUROPA CENTRAL
' (Žižek, Kołakowski, Szmukler). m_FuncionesGenericas.EsLetra CUBRE ASCII Y
' LATIN-1 SUPPLEMENT (GV-03); ESTE RANGO SE SUMA ACÁ PARA NO TOCAR UNA FUNCIÓN
' COMPARTIDA POR OTROS MÓDULOS.
Private Const COD_EXT_A_INICIO As Integer = 256   ' U+0100
Private Const COD_EXT_A_FIN As Integer = 383      ' U+017F

' ============================================
' ESTADO PRIVADO
' ============================================

Private $bBinarioVerificado As Boolean
Private $bBinarioPresente As Boolean

' ============================================
' Función   : HunspellDisponible
' Propósito : Verifica una sola vez por sesión que el ejecutable hunspell exista
' Parámetros: ninguno
' Retorna   : Boolean — True si el binario está en el PATH
' ============================================

Public Function HunspellDisponible() As Boolean

  Dim aComando As New String[]
  Dim sSalida As String

  ' --- 1. RESULTADO CACHEADO: NO RELANZAR UN PROCESO POR CADA PALABRA ---
  If $bBinarioVerificado Then
    Return $bBinarioPresente
  Endif

  ' --- 2. CONSULTA AL SISTEMA ---
  ' command -v ES BUILTIN DE POSIX sh; which VIVE EN debianutils Y PUEDE FALTAR (GV-07)
  aComando.Add("sh")
  aComando.Add("-c")
  aComando.Add("command -v hunspell")

  Try Exec aComando To sSalida
  If Error Then
    $bBinarioVerificado = True
    $bBinarioPresente = False
    Return False
  Endif

  ' --- 3. REGISTRO DEL RESULTADO ---
  $bBinarioVerificado = True
  $bBinarioPresente = (Trim(sSalida) <> "")

  Return $bBinarioPresente

End

' ============================================
' Función   : ObtenerDiccionariosDisponibles
' Propósito : Lista los códigos de idioma con diccionario instalado
' Parámetros: ninguno
' Retorna   : String[] — códigos ordenados alfabéticamente (ej: "es_AR", "es_ES")
' ============================================

Public Function ObtenerDiccionariosDisponibles() As String[]

  Dim aDiccionarios As New String[]
  Dim aArchivos As String[]
  Dim sRuta As String
  Dim sArchivo As String
  Dim sIdioma As String

  ' --- 1. RECORRIDO DE LAS DOS RUTAS ESTÁNDAR ---
  For Each sRuta In [RUTA_HUNSPELL, RUTA_MYSPELL]

    ' Exist() DEVUELVE True TAMBIÉN PARA ARCHIVOS REGULARES, Y Dir() SOBRE UN
    ' ARCHIVO LANZA EL ERROR 49 (GV-01). EL IsDir VA EN If ANIDADO PORQUE
    ' And NO CORTOCIRCUITA (RC-GM-17).
    If Exist(sRuta) Then
      If IsDir(sRuta) Then

        Try aArchivos = Dir(sRuta, "*.dic")
        If Error Then Continue

        ' --- 2. EL NOMBRE DEL ARCHIVO ES EL CÓDIGO DE IDIOMA ---
        For Each sArchivo In aArchivos
          sIdioma = File.BaseName(sArchivo)
          If aDiccionarios.Find(sIdioma) < 0 Then
            aDiccionarios.Add(sIdioma)
          Endif
        Next

      Endif
    Endif

  Next

  ' --- 3. ORDEN ESTABLE PARA LA INTERFAZ ---
  aDiccionarios.Sort()

  Return aDiccionarios

End

' ============================================
' Función   : ObtenerRutaDiccionario
' Propósito : Devuelve la ruta base del diccionario de un idioma, sin extensión
' Parámetros: sIdioma As String — código de idioma (ej: "es_ES")
' Retorna   : String — ruta sin extensión, o cadena vacía si no existe
' ============================================

Public Function ObtenerRutaDiccionario(sIdioma As String) As String

  Dim sRuta As String

  For Each sRuta In [RUTA_HUNSPELL, RUTA_MYSPELL]
    If Exist(sRuta & sIdioma & ".dic") Then
      Return sRuta & sIdioma
    Endif
  Next

  Return ""

End

' ============================================
' Función   : ObtenerRutaDiccionarioPersonal
' Propósito : Devuelve la ruta del diccionario personal del usuario para un idioma
' Parámetros: sIdioma As String — código de idioma
' Retorna   : String — ruta completa al archivo (puede no existir todavía)
' ============================================

Public Function ObtenerRutaDiccionarioPersonal(sIdioma As String) As String

  Return User.Home &/ CARPETA_CONFIG &/ "diccionario_personal_" & sIdioma & ".txt"

End

' ============================================
' Función   : AsegurarDirectorioConfig
' Propósito : Crea la carpeta de configuración del usuario si no existe
' Parámetros: ninguno
' Retorna   : Boolean — True si la carpeta existe o pudo crearse
' ============================================

Public Function AsegurarDirectorioConfig() As Boolean

  Dim sRuta As String

  UltimoError = ""
  sRuta = User.Home &/ CARPETA_CONFIG

  If Exist(sRuta) Then
    If IsDir(sRuta) Then Return True
    UltimoError = "La ruta de configuración existe pero no es una carpeta: " & sRuta
    Return False
  Endif

  Try Mkdir sRuta
  If Error Then
    UltimoError = "No se pudo crear la carpeta de configuración: " & Error.Text
    Return False
  Endif

  Return True

End

' ============================================
' Función   : EjecutarHunspell
' Propósito : Núcleo de invocación. Manda un texto a hunspell en modo tubería
'             y devuelve su salida cruda. Único punto del módulo que lanza
'             el proceso externo.
' Parámetros: sEntrada As String — una palabra por línea
'             sIdioma As String — código de idioma
' Retorna   : String — salida de hunspell, o cadena vacía con UltimoError cargado
' ============================================

Private Function EjecutarHunspell(sEntrada As String, sIdioma As String) As String

  Dim aComando As New String[]
  Dim sRutaDic As String
  Dim sRutaPersonal As String
  Dim sArchivoTemp As String
  Dim sSalida As String
  Dim sComilla As String

  ' --- 1. VALIDACIÓN DE ENTORNO ---
  UltimoError = ""

  If sEntrada = "" Then
    Return ""
  Endif

  If Not HunspellDisponible() Then
    UltimoError = "No se encontró el ejecutable hunspell en el sistema."
    Return ""
  Endif

  sRutaDic = ObtenerRutaDiccionario(sIdioma)
  If sRutaDic = "" Then
    UltimoError = "No hay diccionario instalado para el idioma " & sIdioma & "."
    Return ""
  Endif

  ' --- 2. ARCHIVO TEMPORAL CON LA ENTRADA ---
  ' Exec ... To NO EXPONE stdin (SC-05): EL TEXTO VA POR ARCHIVO TEMPORAL.
  ' File.Save OPERA EN UTF-8 NATIVAMENTE Y NO HAY QUE RECODIFICAR (SC-02).
  sArchivoTemp = Temp$("hunspell_entrada")

  Try File.Save(sArchivoTemp, sEntrada)
  If Error Then
    UltimoError = "No se pudo escribir el archivo temporal: " & Error.Text
    Return ""
  Endif

  ' --- 3. ARMADO DEL COMANDO ---
  ' NUNCA Shell: EL SCRIPT RECIBE LAS RUTAS COMO PARÁMETROS POSICIONALES Y NO
  ' LAS CONCATENA (SC-05, GV-06). LAS COMILLAS VAN CON Chr(34) Y NO CON
  ' ESCAPES, POR LA REGLA DE ESTILO DE SC-01.
  ' EL MODO -a ES EXPLÍCITO: ES EL QUE PRODUCE EL FORMATO &/#/* QUE SE PARSEA
  ' MÁS ABAJO, Y NO CONVIENE DEPENDER DE QUE HUNSPELL LO DEDUZCA SOLO.
  sComilla = Chr(34)
  sRutaPersonal = ObtenerRutaDiccionarioPersonal(sIdioma)

  aComando.Add("sh")
  aComando.Add("-c")

  If Exist(sRutaPersonal) Then
    aComando.Add("hunspell -a -d " & sComilla & "$1" & sComilla &
      " -p " & sComilla & "$2" & sComilla &
      " < " & sComilla & "$3" & sComilla)
    aComando.Add("sh")
    aComando.Add(sRutaDic)
    aComando.Add(sRutaPersonal)
    aComando.Add(sArchivoTemp)
  Else
    aComando.Add("hunspell -a -d " & sComilla & "$1" & sComilla &
      " < " & sComilla & "$2" & sComilla)
    aComando.Add("sh")
    aComando.Add(sRutaDic)
    aComando.Add(sArchivoTemp)
  Endif

  ' --- 4. EJECUCIÓN ---
  ' FORMA SÍNCRONA: EL RESULTADO VIENE POR STDOUT Y NO NECESITAMOS LEER STDERR,
  ' ASÍ QUE NO CORRESPONDE EL APARATO ASÍNCRONO (GV-20).
  Try Exec aComando To sSalida
  If Error Then
    Try Kill sArchivoTemp
    UltimoError = "Falló la ejecución de hunspell: " & Error.Text
    Return ""
  Endif

  ' --- 5. LIMPIEZA ---
  ' LA LIBERACIÓN VA EXPLÍCITA Y NO EN UN Finally: Finally NO CORRE EN UN
  ' Return NORMAL (RC-GM-20).
  Try Kill sArchivoTemp

  ' --- 6. VERIFICACIÓN DE LA SALIDA ---
  ' Exec ... To NO CAPTURA STDERR (GV-20). SI HUNSPELL FALLÓ POR UN DICCIONARIO
  ' ILEGIBLE, LA SALIDA LLEGA VACÍA Y SIN ESO EL LLAMADOR LA LEERÍA COMO
  ' "NO HAY ERRORES" (GV-23). ACÁ SE DISTINGUE.
  If sSalida = "" Then
    UltimoError = "hunspell no devolvió salida. Verifique la instalación y el diccionario " & sIdioma & "."
    Return ""
  Endif

  Return sSalida

End

' ============================================
' Función   : VerificarPalabrasLote
' Propósito : Verifica muchas palabras en una sola invocación de hunspell
' Parámetros: aPalabras As String[] — palabras únicas a verificar
'             sIdioma As String — código de idioma
' Retorna   : String[] — las palabras incorrectas. Array vacío puede significar
'             "ninguna incorrecta" o "falló": consultar UltimoError.
' ============================================

Public Function VerificarPalabrasLote(aPalabras As String[], sIdioma As String) As String[]

  Dim aIncorrectas As New String[]
  Dim aLineas As String[]
  Dim sSalida As String
  Dim sLinea As String
  Dim sPalabra As String

  ' --- 1. VALIDACIÓN DE ENTRADA ---
  UltimoError = ""

  If IsNull(aPalabras) Then Return aIncorrectas
  If aPalabras.Count = 0 Then Return aIncorrectas

  ' --- 2. INVOCACIÓN, UNA SOLA VEZ PARA TODO EL LOTE ---
  ' NINGUNA PALABRA PUEDE EMPEZAR CON UN CARÁCTER DE CONTROL DE hunspell -a
  ' (* & @ # + - ~ % ! ^): ConstruirPalabra RECORTA GUIONES Y APÓSTROFOS DE
  ' LOS BORDES Y EXIGE AL MENOS UNA LETRA. POR ESO NO HACE FALTA PREFIJAR "^".
  sSalida = EjecutarHunspell(aPalabras.Join(gb.NewLine), sIdioma)

  If UltimoError <> "" Then
    Return aIncorrectas
  Endif

  ' --- 3. PARSEO DE LA SALIDA ---
  ' FORMATO DE hunspell -a:
  '   *                            PALABRA CORRECTA
  '   + raíz                       CORRECTA POR AFIJO
  '   - compuesta                  CORRECTA POR COMPOSICIÓN
  '   & palabra n desplaz: sugs    INCORRECTA CON SUGERENCIAS
  '   # palabra desplaz            INCORRECTA SIN SUGERENCIAS
  ' TODA OTRA LÍNEA —INCLUIDO EL RENGLÓN DE VERSIÓN Y LAS LÍNEAS EN BLANCO—
  ' SE DESCARTA. EL PARSEO ES DELIBERADAMENTE TOLERANTE.
  aLineas = Split(sSalida, gb.NewLine, "", False)

  For Each sLinea In aLineas

    If Left(sLinea, 2) = "& " Or If Left(sLinea, 2) = "# " Then
      sPalabra = ExtraerPalabraDeLinea(sLinea)
      If sPalabra <> "" Then
        If aIncorrectas.Find(sPalabra) < 0 Then
          aIncorrectas.Add(sPalabra)
        Endif
      Endif
    Endif

  Next

  Return aIncorrectas

End

' ============================================
' Función   : ExtraerPalabraDeLinea
' Propósito : Toma la palabra de una línea de resultado de hunspell
' Parámetros: sLinea As String — línea con formato "& palabra n desp: sugs"
' Retorna   : String — la palabra, o cadena vacía si la línea no tiene forma
' ============================================

Private Function ExtraerPalabraDeLinea(sLinea As String) As String

  Dim aPartes As String[]

  ' SE SALTEAN EL INDICADOR Y EL ESPACIO QUE LO SIGUE
  aPartes = Split(Mid$(sLinea, 3), " ", "", True)

  If aPartes.Count > 0 Then
    Return aPartes[0]
  Endif

  Return ""

End

' ============================================
' Función   : VerificarPalabra
' Propósito : Verifica una sola palabra
' Parámetros: sPalabra As String — palabra a verificar
'             sIdioma As String — código de idioma
' Retorna   : Boolean — True si es correcta. Ante un fallo devuelve True y deja
'             el motivo en UltimoError: el llamador debe consultarlo antes de
'             tomar el resultado como bueno.
' ============================================

Public Function VerificarPalabra(sPalabra As String, sIdioma As String) As Boolean

  Dim aLineas As String[]
  Dim sSalida As String
  Dim sLinea As String
  Dim sIndicador As String

  ' --- 1. INVOCACIÓN ---
  UltimoError = ""
  sSalida = EjecutarHunspell(sPalabra, sIdioma)

  If UltimoError <> "" Then
    Return True
  Endif

  ' --- 2. PARSEO ---
  ' EL INDICADOR SE LEE DEL PRIMER CARÁCTER DE LA LÍNEA, NO BUSCANDO * O + O -
  ' EN CUALQUIER PARTE DE LA SALIDA: LA LISTA DE SUGERENCIAS DE UNA PALABRA
  ' INCORRECTA PUEDE TRAER UN GUION Y DARÍA LA PALABRA POR BUENA.
  aLineas = Split(sSalida, gb.NewLine, "", False)

  For Each sLinea In aLineas

    sIndicador = Left(sLinea, 1)

    If sIndicador = "*" Or If sIndicador = "+" Or If sIndicador = "-" Then
      Return True
    Endif

    If sIndicador = "&" Or If sIndicador = "#" Then
      Return False
    Endif

  Next

  ' --- 3. SIN LÍNEA DE RESULTADO: NO SE PUDO DECIDIR ---
  UltimoError = "hunspell no devolvió un resultado reconocible para " & sPalabra & "."

  Return True

End

' ============================================
' Función   : ObtenerSugerencias
' Propósito : Obtiene las sugerencias de corrección para una palabra
' Parámetros: sPalabra As String — palabra incorrecta
'             sIdioma As String — código de idioma
' Retorna   : String[] — sugerencias en el orden que las da hunspell
' ============================================

Public Function ObtenerSugerencias(sPalabra As String, sIdioma As String) As String[]

  Dim aSugerencias As New String[]
  Dim aLineas As String[]
  Dim aTemporal As String[]
  Dim sSalida As String
  Dim sLinea As String
  Dim sSugerencia As String
  Dim iPos As Integer

  ' --- 1. INVOCACIÓN ---
  UltimoError = ""
  sSalida = EjecutarHunspell(sPalabra, sIdioma)

  If UltimoError <> "" Then
    Return aSugerencias
  Endif

  ' --- 2. LAS SUGERENCIAS VIENEN DESPUÉS DE LOS DOS PUNTOS ---
  aLineas = Split(sSalida, gb.NewLine, "", False)

  For Each sLinea In aLineas

    If Left(sLinea, 1) <> "&" Then Continue

    iPos = InStr(sLinea, ":")
    If iPos = 0 Then Continue

    aTemporal = Split(Mid$(sLinea, iPos + 1), ",", "", True)

    For Each sSugerencia In aTemporal
      sSugerencia = Trim(sSugerencia)
      If sSugerencia <> "" Then
        aSugerencias.Add(sSugerencia)
      Endif
    Next

  Next

  Return aSugerencias

End

' ============================================
' Función   : EstaEnDiccionarioPersonal
' Propósito : Indica si una palabra ya fue agregada al diccionario personal
' Parámetros: sPalabra As String — palabra a buscar
'             sIdioma As String — código de idioma
' Retorna   : Boolean — True si está
' ============================================

Public Function EstaEnDiccionarioPersonal(sPalabra As String, sIdioma As String) As Boolean

  Dim aLineas As String[]
  Dim sRuta As String
  Dim sContenido As String

  UltimoError = ""
  sRuta = ObtenerRutaDiccionarioPersonal(sIdioma)

  If Not Exist(sRuta) Then Return False

  Try sContenido = File.Load(sRuta)
  If Error Then
    UltimoError = "No se pudo leer el diccionario personal: " & Error.Text
    Return False
  Endif

  aLineas = Split(sContenido, gb.NewLine, "", True)

  Return aLineas.Find(sPalabra) >= 0

End

' ============================================
' Función   : AgregarAlDiccionarioPersonal
' Propósito : Agrega una palabra al diccionario personal del usuario
' Parámetros: sPalabra As String — palabra a agregar
'             sIdioma As String — código de idioma
' Retorna   : Boolean — True si quedó agregada (o ya estaba)
' ============================================

Public Function AgregarAlDiccionarioPersonal(sPalabra As String, sIdioma As String) As Boolean

  Dim hArchivo As File
  Dim sRuta As String

  ' --- 1. VALIDACIÓN DE ENTRADA ---
  UltimoError = ""
  sPalabra = Trim(sPalabra)

  If sPalabra = "" Then
    UltimoError = "No hay palabra para agregar."
    Return False
  Endif

  ' --- 2. CARPETA DE DESTINO ---
  If Not AsegurarDirectorioConfig() Then
    Return False
  Endif

  ' --- 3. NO DUPLICAR ---
  If EstaEnDiccionarioPersonal(sPalabra, sIdioma) Then
    Return True
  Endif

  ' --- 4. ESCRITURA ---
  sRuta = ObtenerRutaDiccionarioPersonal(sIdioma)

  Try hArchivo = Open sRuta For Append
  If Error Then
    UltimoError = "No se pudo abrir el diccionario personal para escritura: " & Error.Text
    Return False
  Endif

  Try Print #hArchivo, sPalabra
  If Error Then
    Try Close #hArchivo
    UltimoError = "No se pudo escribir en el diccionario personal: " & Error.Text
    Return False
  Endif

  Try Close #hArchivo

  Return True

End

' ============================================
' Función   : ExtraerPalabras
' Propósito : Recorre un texto y devuelve sus palabras con posición y longitud
' Parámetros: sTexto As String — texto a analizar
'             bLimpiarShortcodes As Boolean — si True, saltea URLs, DOIs,
'               correos y shortcodes. True para los .md; False para el RTF de
'               referencias, donde no hay shortcodes y saltear los corchetes
'               borraría texto legítimo.
' Retorna   : CPalabraHallada[] — en orden de aparición. Posiciones en
'             CARACTERES, base 1.
' ============================================

Public Function ExtraerPalabras(sTexto As String, Optional bLimpiarShortcodes As Boolean = True) As CPalabraHallada[]

  Dim aPalabras As New CPalabraHallada[]
  Dim oPalabra As CPalabraHallada
  Dim sCaracter As String
  Dim sBruta As String
  Dim iLargo As Integer
  Dim iInicio As Integer
  Dim iSalto As Integer
  Dim iCodigo As Integer
  Dim i As Integer
  Dim bEnPalabra As Boolean

  ' --- 1. INICIALIZACIÓN ---
  iLargo = String.Len(sTexto)
  bEnPalabra = False
  iInicio = 0
  i = 1

  ' --- 2. RECORRIDO CODEPOINT A CODEPOINT ---
  ' String.Mid Y String.Code, NUNCA Mid Y Asc: ESAS OPERAN EN BYTES Y PARTEN
  ' LOS CARACTERES MULTIBYTE (RC-GM-12, SC-02). EL BUCLE ESCALA LINEALMENTE:
  ' 40.000 CODEPOINTS EN 0,021 S (GV-03), ASÍ QUE NO HACE FALTA OPTIMIZARLO.
  While i <= iLargo

    ' ZONA IGNORADA: URL, DOI, CORREO O SHORTCODE. SE SALTEA ENTERA Y SE
    ' DESCARTA LA PALABRA EN CURSO, QUE PODRÍA SER SU PREFIJO.
    iSalto = 0
    If bLimpiarShortcodes Then
      iSalto = LargoZonaIgnorada(sTexto, i, iLargo)
    Endif

    If iSalto > 0 Then
      bEnPalabra = False
      i += iSalto
      Continue
    Endif

    sCaracter = String.Mid(sTexto, i, 1)
    iCodigo = String.Code(sCaracter)

    If EsCaracterDePalabra(iCodigo) Then

      ' INICIO DE PALABRA
      If Not bEnPalabra Then
        bEnPalabra = True
        iInicio = i
      Endif

    Else

      ' FIN DE PALABRA
      If bEnPalabra Then
        sBruta = String.Mid(sTexto, iInicio, i - iInicio)
        oPalabra = ConstruirPalabra(sBruta, iInicio)
        If Not IsNull(oPalabra) Then aPalabras.Add(oPalabra)
        bEnPalabra = False
      Endif

    Endif

    Inc i

  Wend

  ' --- 3. PALABRA PENDIENTE AL FINAL DEL TEXTO ---
  If bEnPalabra Then
    sBruta = String.Mid(sTexto, iInicio, iLargo - iInicio + 1)
    oPalabra = ConstruirPalabra(sBruta, iInicio)
    If Not IsNull(oPalabra) Then aPalabras.Add(oPalabra)
  Endif

  Return aPalabras

End

' ============================================
' Función   : ConstruirPalabra
' Propósito : Recorta guiones y apóstrofos de los bordes y valida la palabra
' Parámetros: sBruta As String — palabra tal como la cortó el recorrido
'             iPosicion As Integer — posición de inicio de sBruta, en caracteres
' Retorna   : CPalabraHallada — o Null si no es una palabra verificable
' ============================================

Private Function ConstruirPalabra(sBruta As String, iPosicion As Integer) As CPalabraHallada

  Dim oPalabra As CPalabraHallada
  Dim sPalabra As String
  Dim iDesplazamiento As Integer
  Dim iCodigo As Integer

  ' --- 1. RECORTE DEL BORDE IZQUIERDO ---
  ' EL GUION Y EL APÓSTROFO VALEN DENTRO DE LA PALABRA (bien-estar, l’État)
  ' PERO NO EN LOS BORDES. SIN ESTE RECORTE, UN "--particular" DEL TEXTO SE
  ' MANDA A HUNSPELL TAL CUAL Y VUELVE COMO ERROR.
  sPalabra = sBruta
  iDesplazamiento = 0

  While String.Len(sPalabra) > 0
    iCodigo = String.Code(String.Mid(sPalabra, 1, 1))
    If Not EsCaracterInterior(iCodigo) Then Break
    sPalabra = String.Mid(sPalabra, 2, String.Len(sPalabra) - 1)
    Inc iDesplazamiento
  Wend

  ' --- 2. RECORTE DEL BORDE DERECHO ---
  While String.Len(sPalabra) > 0
    iCodigo = String.Code(String.Mid(sPalabra, String.Len(sPalabra), 1))
    If Not EsCaracterInterior(iCodigo) Then Break
    sPalabra = String.Mid(sPalabra, 1, String.Len(sPalabra) - 1)
  Wend

  ' --- 3. VALIDACIÓN ---
  If Not EsPalabraValida(sPalabra) Then
    Return Null
  Endif

  ' --- 4. CONSTRUCCIÓN ---
  ' EL New CON ARGUMENTOS VA A UNA VARIABLE Y NO ANIDADO EN LA LLAMADA (GV-32)
  oPalabra = New CPalabraHallada(sPalabra, iPosicion + iDesplazamiento, String.Len(sPalabra))

  Return oPalabra

End

' ============================================
' Función   : EsCaracterDePalabra
' Propósito : Decide si un codepoint puede formar parte de una palabra
' Parámetros: iCodigo As Integer — codepoint Unicode
' Retorna   : Boolean — True si es letra, dígito, guion o apóstrofo
' ============================================

Private Function EsCaracterDePalabra(iCodigo As Integer) As Boolean

  ' --- 1. LETRAS ---
  ' EsLetra ES LOCALE-INDEPENDIENTE POR CONSTRUCCIÓN Y CUBRE ASCII Y LATIN-1
  ' SUPPLEMENT (GV-03): CASTELLANO, PORTUGUÉS, FRANCÉS E ITALIANO.
  If m_FuncionesGenericas.EsLetra(iCodigo) Then Return True

  ' --- 2. LATIN EXTENDED-A ---
  ' PARA APELLIDOS DE EUROPA CENTRAL (Žižek, Kołakowski, Szmukler). SE RESUELVE
  ' ACÁ Y NO AMPLIANDO EsLetra, QUE ES COMPARTIDA POR OTROS MÓDULOS.
  If iCodigo >= COD_EXT_A_INICIO Then
    If iCodigo <= COD_EXT_A_FIN Then Return True
  Endif

  ' --- 3. DÍGITOS ---
  If iCodigo >= 48 Then
    If iCodigo <= 57 Then Return True
  Endif

  ' --- 4. CARACTERES INTERIORES ---
  ' SE ACEPTAN ACÁ Y SE RECORTAN DESPUÉS EN ConstruirPalabra SI QUEDARON EN
  ' UN BORDE. ES MÁS SIMPLE QUE MIRAR HACIA ADELANTE DURANTE EL RECORRIDO.
  If EsCaracterInterior(iCodigo) Then Return True

  Return False

End

' ============================================
' Función   : EsCaracterInterior
' Propósito : Indica si un codepoint solo vale dentro de una palabra
' Parámetros: iCodigo As Integer — codepoint Unicode
' Retorna   : Boolean — True para guion y apóstrofos
' ============================================

Private Function EsCaracterInterior(iCodigo As Integer) As Boolean

  ' EL APÓSTROFO CURVO ES EL QUE EMITE PANDOC; EL RECTO SOBREVIVE EN TEXTO
  ' TIPEADO A MANO Y EN CITAS DE CÓDIGO.
  If iCodigo = COD_GUION Then Return True
  If iCodigo = COD_APOSTROFO_RECTO Then Return True
  If iCodigo = COD_APOSTROFO_CURVO Then Return True

  Return False

End

' ============================================
' Función   : EsPalabraValida
' Propósito : Decide si una cadena merece ir al corrector
' Parámetros: sPalabra As String — palabra ya recortada
' Retorna   : Boolean — True si tiene al menos dos caracteres y una letra
' ============================================

Private Function EsPalabraValida(sPalabra As String) As Boolean

  Dim iLargo As Integer
  Dim iCodigo As Integer
  Dim i As Integer

  ' --- 1. LARGO MÍNIMO, EN CARACTERES ---
  iLargo = String.Len(sPalabra)
  If iLargo < 2 Then Return False

  ' --- 2. AL MENOS UNA LETRA: DESCARTA NÚMEROS Y CÓDIGOS SUELTOS ---
  For i = 1 To iLargo

    iCodigo = String.Code(String.Mid(sPalabra, i, 1))

    If m_FuncionesGenericas.EsLetra(iCodigo) Then Return True

    If iCodigo >= COD_EXT_A_INICIO Then
      If iCodigo <= COD_EXT_A_FIN Then Return True
    Endif

  Next

  Return False

End

' ============================================
' Función   : LargoZonaIgnorada
' Propósito : Si en una posición arranca una zona que no debe verificarse,
'             devuelve cuántos caracteres hay que saltear
' Parámetros: sTexto As String — texto completo
'             iPos As Integer — posición a examinar, en caracteres, base 1
'             iLargo As Integer — largo total del texto, en caracteres
' Retorna   : Integer — caracteres a saltear, o 0 si acá no arranca ninguna zona
' ============================================

Private Function LargoZonaIgnorada(sTexto As String, iPos As Integer, iLargo As Integer) As Integer

  Dim sCaracter As String

  sCaracter = String.Mid(sTexto, iPos, 1)

  ' --- 1. DIRECCIONES WEB ---
  If EmpiezaCon(sTexto, iPos, "https://") Then Return LargoHastaEspacio(sTexto, iPos, iLargo)
  If EmpiezaCon(sTexto, iPos, "http://") Then Return LargoHastaEspacio(sTexto, iPos, iLargo)
  If EmpiezaCon(sTexto, iPos, "ftp://") Then Return LargoHastaEspacio(sTexto, iPos, iLargo)

  ' --- 2. IDENTIFICADORES DOI ---
  If EmpiezaCon(sTexto, iPos, "doi:") Then Return LargoHastaEspacio(sTexto, iPos, iLargo)
  If EmpiezaCon(sTexto, iPos, "10.") Then Return LargoHastaEspacio(sTexto, iPos, iLargo)

  ' --- 3. CORREOS Y SHORTCODES CON ARROBA ---
  ' LA ARROBA CUBRE LOS DOS CASOS: alguien@dominio.com Y @nombre(...). LA
  ' PALABRA EN CURSO SE DESCARTA EN EL LLAMADOR, QUE ES LO QUE HACE FALTA
  ' PARA QUE NO QUEDE EL PREFIJO DEL CORREO SUELTO.
  If sCaracter = "@" Then Return LargoHastaEspacio(sTexto, iPos, iLargo)

  ' --- 4. SHORTCODES ENTRE CORCHETES Y ENTRE LLAVES DOBLES ---
  If sCaracter = "[" Then Return LargoHastaCierre(sTexto, iPos, iLargo, "]")
  If EmpiezaCon(sTexto, iPos, "{{") Then Return LargoHastaCierre(sTexto, iPos, iLargo, "}")

  Return 0

End

' ============================================
' Función   : EmpiezaCon
' Propósito : Compara un patrón ASCII en una posición, sin distinguir caja
' Parámetros: sTexto As String — texto completo
'             iPos As Integer — posición a examinar, en caracteres, base 1
'             sPatron As String — patrón ASCII a comparar
' Retorna   : Boolean — True si el texto en esa posición empieza con el patrón
' ============================================

Private Function EmpiezaCon(sTexto As String, iPos As Integer, sPatron As String) As Boolean

  Dim iLargoPatron As Integer
  Dim i As Integer
  Dim iCodTexto As Integer
  Dim iCodPatron As Integer

  iLargoPatron = String.Len(sPatron)

  If iPos + iLargoPatron - 1 > String.Len(sTexto) Then Return False

  ' LOS PATRONES QUE USA ESTA FUNCIÓN SON ASCII PURO (https://, doi:, {{), ASÍ
  ' QUE EL PLEGADO ASCII ALCANZA Y NO HACE FALTA LA TABLA DE
  ' m_FuncionesGenericas. TAMPOCO LCase, QUE DEPENDE DEL LOCALE Y FUNCIONA EN
  ' LA MÁQUINA DEL DESARROLLADOR PERO NO EN UNA INSTALACIÓN CLIENTE CON LOCALE
  ' MÍNIMO (GV-03).
  For i = 1 To iLargoPatron
    iCodTexto = PlegarAsciiAMinuscula(String.Code(String.Mid(sTexto, iPos + i - 1, 1)))
    iCodPatron = PlegarAsciiAMinuscula(String.Code(String.Mid(sPatron, i, 1)))
    If iCodTexto <> iCodPatron Then Return False
  Next

  Return True

End

' ============================================
' Función   : PlegarAsciiAMinuscula
' Propósito : Pliega a minúscula un codepoint ASCII, dejando el resto intacto
' Parámetros: iCodigo As Integer — codepoint Unicode
' Retorna   : Integer — el codepoint plegado
' ============================================

Private Function PlegarAsciiAMinuscula(iCodigo As Integer) As Integer

  ' SOLO A-Z. NO TOCA NADA FUERA DE ASCII: ESTA FUNCIÓN COMPARA PATRONES
  ' FIJOS DEL PROYECTO, NO TEXTO DEL USUARIO.
  If iCodigo >= 65 Then
    If iCodigo <= 90 Then Return iCodigo + 32
  Endif

  Return iCodigo

End

' ============================================
' Función   : LargoHastaEspacio
' Propósito : Cuenta los caracteres desde una posición hasta el próximo espacio
' Parámetros: sTexto As String — texto completo
'             iPos As Integer — posición de inicio, en caracteres, base 1
'             iLargo As Integer — largo total del texto, en caracteres
' Retorna   : Integer — cantidad de caracteres a saltear, siempre 1 o más
' ============================================

Private Function LargoHastaEspacio(sTexto As String, iPos As Integer, iLargo As Integer) As Integer

  Dim iCodigo As Integer
  Dim i As Integer

  For i = iPos To iLargo
    iCodigo = String.Code(String.Mid(sTexto, i, 1))
    ' ESPACIO, TABULADOR, SALTO DE LÍNEA Y RETORNO DE CARRO
    If iCodigo = 32 Then Return i - iPos
    If iCodigo = 9 Then Return i - iPos
    If iCodigo = 10 Then Return i - iPos
    If iCodigo = 13 Then Return i - iPos
  Next

  Return iLargo - iPos + 1

End

' ============================================
' Función   : LargoHastaCierre
' Propósito : Cuenta los caracteres desde una posición hasta un carácter de
'             cierre, sin cruzar el fin de línea
' Parámetros: sTexto As String — texto completo
'             iPos As Integer — posición de inicio, en caracteres, base 1
'             iLargo As Integer — largo total del texto, en caracteres
'             sCierre As String — carácter de cierre
' Retorna   : Integer — caracteres a saltear. Si no hay cierre en la línea,
'             saltea solo el carácter de apertura y sigue analizando normal.
' ============================================

Private Function LargoHastaCierre(sTexto As String, iPos As Integer, iLargo As Integer, sCierre As String) As Integer

  Dim sCaracter As String
  Dim i As Integer

  For i = iPos + 1 To iLargo

    sCaracter = String.Mid(sTexto, i, 1)

    ' UN CORCHETE SIN CERRAR NO DEBE COMERSE EL RESTO DEL DOCUMENTO
    If String.Code(sCaracter) = 10 Then Break

    If sCaracter = sCierre Then Return i - iPos + 1

  Next

  Return 1

End

' ============================================
' Función   : ObtenerContexto
' Propósito : Devuelve el texto alrededor de una posición, sin cruzar párrafos
' Parámetros: sTexto As String — texto completo
'             iPosicion As Integer — posición de la palabra, en caracteres, base 1
'             iLongitudPalabra As Integer — largo de la palabra, en caracteres
'             iCaracteres As Integer — caracteres de contexto a cada lado
' Retorna   : String — el contexto, con puntos suspensivos si quedó truncado
' ============================================

Public Function ObtenerContexto(sTexto As String, iPosicion As Integer, iLongitudPalabra As Integer, Optional iCaracteres As Integer = 50) As String

  Dim sContexto As String
  Dim iLargo As Integer
  Dim iInicio As Integer
  Dim iFin As Integer
  Dim i As Integer

  ' --- 1. VENTANA INICIAL ---
  ' TODO EN CARACTERES. CON Mid Y Len EL CORTE CAÍA EN MEDIO DE UN CARÁCTER
  ' MULTIBYTE Y DEJABA UN BYTE HUÉRFANO, QUE LA INTERFAZ PINTABA COMO EL
  ' CARÁCTER DE REEMPLAZO (GV-03). SE VIO SOBRE UNA COMILLA LATINA DE CIERRE.
  iLargo = String.Len(sTexto)
  iInicio = iPosicion - iCaracteres
  iFin = iPosicion + iLongitudPalabra + iCaracteres

  If iInicio < 1 Then iInicio = 1
  If iFin > iLargo Then iFin = iLargo

  ' --- 2. RECORTE HACIA ATRÁS EN EL SALTO DE LÍNEA MÁS CERCANO ---
  For i = iPosicion To iInicio Step -1
    If String.Code(String.Mid(sTexto, i, 1)) = 10 Then
      iInicio = i + 1
      Break
    Endif
  Next

  ' --- 3. RECORTE HACIA ADELANTE ---
  For i = iPosicion + iLongitudPalabra To iFin
    If String.Code(String.Mid(sTexto, i, 1)) = 10 Then
      iFin = i - 1
      Break
    Endif
  Next

  If iFin < iInicio Then Return ""

  ' --- 4. EXTRACCIÓN E INDICADORES DE TRUNCADO ---
  sContexto = String.Mid(sTexto, iInicio, iFin - iInicio + 1)

  If iInicio > 1 Then sContexto = "..." & sContexto
  If iFin < iLargo Then sContexto = sContexto & "..."

  Return sContexto

End

' ============================================
' Función   : ConvertirPosicionALineaColumna
' Propósito : Convierte una posición absoluta en línea y columna
' Parámetros: sTexto As String — texto completo
'             iPosicion As Integer — posición absoluta, en caracteres, base 1
' Retorna   : CPosicionTexto — línea y columna, ambas base 0, columna en caracteres
' ============================================

Public Function ConvertirPosicionALineaColumna(sTexto As String, iPosicion As Integer) As CPosicionTexto

  Dim oPosicion As CPosicionTexto
  Dim iLargo As Integer
  Dim iLinea As Integer
  Dim iColumna As Integer
  Dim i As Integer

  ' --- 1. RECORRIDO HASTA LA POSICIÓN PEDIDA ---
  ' EL RESULTADO VUELVE COMO OBJETO Y NO POR PARÁMETROS ByRef: EN GAMBAS LOS
  ' PRIMITIVOS SE PASAN SIEMPRE POR VALOR Y LA VARIABLE DEL LLAMADOR QUEDA
  ' COMO ESTABA, SIN NINGÚN AVISO (GV-24).
  iLargo = String.Len(sTexto)
  iLinea = 0
  iColumna = 0

  For i = 1 To iLargo

    If i >= iPosicion Then Break

    If String.Code(String.Mid(sTexto, i, 1)) = 10 Then
      Inc iLinea
      iColumna = 0
    Else
      Inc iColumna
    Endif

  Next

  ' --- 2. CONSTRUCCIÓN DEL RESULTADO ---
  ' EL New CON ARGUMENTOS VA A UNA VARIABLE (GV-32)
  oPosicion = New CPosicionTexto(iLinea, iColumna)

  Return oPosicion

End
