' Gambas module file

' ==============================================================================
' Módulo    : m_Licencias
' Propósito : Catálogo de licencias (tabla licencias, actualización 1.2.0).
'             Reemplaza las listas y los Select Case que estaban repetidos en
'             FMetadatosArticulos, FMetadatosCapitulos y FMetadatosLibro.
'             El catálogo ALIMENTA los formularios; cada artículo, capítulo,
'             libro o revista sigue guardando su propio texto y su URL
'             (decisión de Alberto, camino B): lo publicado queda como se
'             publicó aunque el catálogo cambie después.
'             Desde la 1.28.0, también el texto que describe cada licencia
'             por idioma (licencia_texto), con la url como clave: el ABM lo
'             usa FSysAdmin (pestaña «Catálogos») y TextoLicencia los
'             volcados (revistas desde C2d; libros cuando le toque).
' Requiere  : esquema 1.2.0 (tabla licencias); 1.28.0 (licencia_texto).
' Dependencias: m_ConexionBD, m_Sonido.
' ==============================================================================

' ============================================
' Función   : LlenarCombo
' Propósito : Carga en un ComboBox las licencias activas de un ámbito, en el
'             orden del catálogo. Conserva el texto que el combo ya tenía
' Parámetros: hCombo As ComboBox — combo a llenar
'             bCodigo As Boolean — True: licencias de código
'             (para_codigo); False: licencias de contenido (para_contenido)
'             hConn As Connection — opcional: conexión a usar. Si falta,
'             m_ConexionBD.mConn. FSysAdmin pasa la suya: se abre sin sesión
'             de usuario y mConn puede no existir
'             bSoloLectura As Boolean — opcional: True deja el combo de solo
'             lectura (solo se elige del catálogo: la editorial, desde C2c);
'             False, editable (los registros, SC-23)
' Retorna   : nada
' ============================================
Public Sub LlenarCombo(hCombo As ComboBox, bCodigo As Boolean, Optional hConn As Connection, Optional bSoloLectura As Boolean = False)

  Dim rDatos As Result
  Dim sTexto As String
  Dim sColumna As String

  ' --- 1. INICIALIZACIÓN ---
  ' EL TEXTO PREVIO SE RESTAURA AL FINAL: LLENAR NO DEBE BORRAR UN VALOR YA CARGADO
  sTexto = hCombo.Text
  ' NOMBRE DE COLUMNA ELEGIDO EN CÓDIGO, NO POR EL USUARIO: NO HAY INYECCIÓN
  If bCodigo Then
    sColumna = "para_codigo"
  Else
    sColumna = "para_contenido"
  Endif

  ' --- 2. CONSULTA ---
  ' SIN CONEXIÓN EXPLÍCITA, LA DE LA SESIÓN
  If Not hConn Then hConn = m_ConexionBD.mConn
  Try rDatos = hConn.Exec("SELECT etiqueta FROM licencias WHERE activo = 1 AND " & sColumna & " = 1 ORDER BY orden, etiqueta")
  If Error Then
    m_Sonido.sonar("Warning")
    Message.Warning("No se pudo leer el catálogo de licencias (¿falta la actualización de esquema 1.2.0?):" & gb.NewLine & Error.Text)
    Return
  Endif

  ' --- 3. LLENADO ---
  ' EDITABLE SALVO QUE SE PIDA LO CONTRARIO: UN ComboBox ReadOnly PIERDE EN
  ' SILENCIO UN VALOR FUERA DE LA LISTA, Y LOS REGISTROS PUEDEN TENER
  ' LICENCIAS QUE NO ESTÁN EN EL CATÁLOGO. EL QUE PIDE SOLO LECTURA SE OCUPA
  ' DE ESE CASO (FSysAdmin.CargarEditorialEnEditor AVISA)
  hCombo.ReadOnly = bSoloLectura
  hCombo.Clear()
  While rDatos.Available
    hCombo.Add(rDatos["etiqueta"])
    rDatos.MoveNext
  Wend

  ' --- 4. RESTAURAR EL TEXTO PREVIO ---
  hCombo.Text = sTexto

End

' ============================================
' Función   : CompletarUrl
' Propósito : Al elegir una licencia del catálogo, escribe su URL en el campo
'             correspondiente (vacía si la licencia no tiene, como «Todos los
'             derechos reservados»). Si el texto no está en el catálogo (una
'             licencia escrita a mano), no toca el campo
' Parámetros: hCombo As ComboBox — combo de la licencia
'             hUrl As TextBox — campo de la URL
'             hConn As Connection — opcional: conexión a usar. Si falta,
'             m_ConexionBD.mConn (ver LlenarCombo)
' Retorna   : nada
' ============================================
Public Sub CompletarUrl(hCombo As ComboBox, hUrl As TextBox, Optional hConn As Connection)

  Dim rDatos As Result

  ' --- 1. BÚSQUEDA POR ETIQUETA ---
  ' SIN CONEXIÓN EXPLÍCITA, LA DE LA SESIÓN
  If Not hConn Then hConn = m_ConexionBD.mConn
  Try rDatos = hConn.Exec("SELECT url FROM licencias WHERE etiqueta = &1", Trim(hCombo.Text))
  If Error Then Return
  ' FUERA DEL CATÁLOGO: LA URL LA ESCRIBE EL USUARIO
  If Not rDatos.Available Then Return

  ' --- 2. URL DEL CATÁLOGO ---
  If IsNull(rDatos["url"]) Then
    hUrl.Text = ""
  Else
    hUrl.Text = rDatos["url"]
  Endif

End

' ============================================
' Función   : EsAbierta
' Propósito : Indica si una licencia es abierta según el catálogo, buscándola
'             por URL y no por nombre: los registros pueden guardar un nombre
'             largo («Licencia Creative Commons Atribución-…») con la URL
'             correcta. Una URL vacía o fuera del catálogo NO es abierta: no
'             se declara acceso abierto sin saberlo
' Parámetros: sUrl As String — URL de la licencia
' Retorna   : Boolean — True solo si la URL está en el catálogo con abierta = 1
' ============================================
Public Function EsAbierta(sUrl As String) As Boolean

  Dim rDatos As Result

  ' --- 1. VALIDACIÓN ---
  If Trim(sUrl) = "" Then Return False

  ' --- 2. CONSULTA ---
  Try rDatos = m_ConexionBD.mConn.Exec("SELECT COUNT(*) AS n FROM licencias WHERE url = &1 AND abierta = 1", Trim(sUrl))
  If Error Then Return False

  Return CInt(rDatos["n"]) > 0

End

' ============================================
' Función   : ListarConUrl
' Propósito : Las licencias de contenido que tienen url, para la grilla de
'             textos de Administración. Sin url no hay clave para el texto
'             (licencia_texto, 1.28.0)
' Parámetros: hConn As Connection — conexión abierta
' Retorna   : Result — etiqueta, url, activo; Null si falló (ya se informó)
' ============================================
Public Function ListarConUrl(hConn As Connection) As Result

  Dim rDatos As Result

  Try rDatos = hConn.Exec("SELECT etiqueta, url, activo FROM licencias WHERE para_contenido = 1 AND url IS NOT NULL AND url <> '' ORDER BY orden, etiqueta")
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo leer el catálogo de licencias:" & gb.NewLine & Error.Text)
    Return Null
  Endif

  Return rDatos

End

' ============================================
' Función   : ListarTextos
' Propósito : Los textos de una licencia, uno por idioma
' Parámetros: hConn As Connection — conexión abierta
'             sUrl As String — la url de la licencia
' Retorna   : Result — idioma, texto; Null si falló (ya se informó)
' ============================================
Public Function ListarTextos(hConn As Connection, sUrl As String) As Result

  Dim rDatos As Result

  Try rDatos = hConn.Exec("SELECT idioma, texto FROM licencia_texto WHERE url = &1 ORDER BY idioma", Trim(sUrl))
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudieron leer los textos de la licencia (¿falta la actualización de esquema 1.28.0?):" & gb.NewLine & Error.Text)
    Return Null
  Endif

  Return rDatos

End

' ============================================
' Función   : GuardarTexto
' Propósito : Graba el texto de una licencia en un idioma: alta si es nuevo,
'             edición si ya estaba
' Parámetros: hConn As Connection — conexión abierta
'             sUrl As String — la url de la licencia
'             sIdioma As String — código BCP 47 del catálogo de idiomas
'             sTexto As String — el texto (license-p del canónico)
'             bAlta As Boolean — True: alta (frena si el idioma ya tiene
'             texto); False: edición del texto existente
' Retorna   : Boolean — True si se grabó
' ============================================
Public Function GuardarTexto(hConn As Connection, sUrl As String, sIdioma As String, sTexto As String, bAlta As Boolean) As Boolean

  Dim rTexto As Result
  Dim rExiste As Result

  ' --- 1. VALIDACIÓN ---
  If Trim(sIdioma) = "" Then
    m_Sonido.sonar("Warning")
    Message.Warning("Elegí el idioma.")
    Return False
  Endif
  If Trim(sTexto) = "" Then
    m_Sonido.sonar("Warning")
    Message.Warning("Escribí el texto de la licencia.")
    Return False
  Endif

  ' --- 2. ALTA: EL IDIOMA NO PUEDE TENER YA UN TEXTO ---
  ' LA CLAVE PRIMARIA LO IMPIDE IGUAL; ACÁ SE AVISA CON UN MENSAJE CLARO
  If bAlta Then
    Try rExiste = hConn.Exec("SELECT COUNT(*) AS n FROM licencia_texto WHERE url = &1 AND idioma = &2", Trim(sUrl), Trim(sIdioma))
    If Error Then
      m_Sonido.sonar("Error")
      Message.Error("No se pudo consultar la licencia:" & gb.NewLine & Error.Text)
      Return False
    Endif
    If CInt(rExiste!n) > 0 Then
      m_Sonido.sonar("Warning")
      Message.Warning("La licencia ya tiene texto en «" & Trim(sIdioma) & "»: elegilo en la grilla para cambiarlo.")
      Return False
    Endif
    Try rTexto = hConn.Create("licencia_texto")
  Else
    Try rTexto = hConn.Edit("licencia_texto", "url = &1 AND idioma = &2", Trim(sUrl), Trim(sIdioma))
  Endif
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo abrir el texto de la licencia para grabarlo:" & gb.NewLine & Error.Text)
    Return False
  Endif

  ' --- 3. CAMPOS, POR NOMBRE (RC-GM-15) ---
  With rTexto
    If bAlta Then
      !url = Trim(sUrl)
      !idioma = Trim(sIdioma)
    Endif
    !texto = Trim(sTexto)
  End With

  ' --- 4. GRABACIÓN ---
  Try rTexto.Update()
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo guardar el texto de la licencia:" & gb.NewLine & Error.Text)
    Return False
  Endif

  Return True

End

' ============================================
' Función   : BorrarTexto
' Propósito : Borra el texto de una licencia en un idioma. Lo ya publicado no
'             cambia: el canónico guardó el texto que tenía
' Parámetros: hConn As Connection — conexión abierta
'             sUrl As String — la url de la licencia
'             sIdioma As String — el idioma
' Retorna   : Boolean — True si se borró
' ============================================
Public Function BorrarTexto(hConn As Connection, sUrl As String, sIdioma As String) As Boolean

  Try hConn.Exec("DELETE FROM licencia_texto WHERE url = &1 AND idioma = &2", Trim(sUrl), Trim(sIdioma))
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo borrar el texto de la licencia:" & gb.NewLine & Error.Text)
    Return False
  Endif

  Return True

End

' ============================================
' Función   : TextoLicencia
' Propósito : El texto de una licencia en un idioma, para los volcados.
'             Busca el idioma exacto y después su subetiqueta primaria
'             (pt-BR → pt)
' Parámetros: sUrl As String — la url de la licencia del artículo o la pieza
'             sIdioma As String — código BCP 47 del artículo o la pieza
'             hConn As Connection — opcional: si falta, m_ConexionBD.mConn
' Retorna   : String — el texto; vacío si no hay o si la consulta falla. El
'             que llama decide qué va en su lugar (en revistas, la etiqueta)
' ============================================
Public Function TextoLicencia(sUrl As String, sIdioma As String, Optional hConn As Connection) As String

  Dim rDatos As Result
  Dim sPrimaria As String

  ' --- 1. VALIDACIÓN ---
  If Not hConn Then hConn = m_ConexionBD.mConn
  If Trim(sUrl) = "" Then Return ""
  ' SIN IDIOMA NO HAY QUÉ BUSCAR (Y Split DE UNA CADENA VACÍA NO DA ELEMENTOS)
  If Trim(sIdioma) = "" Then Return ""
  ' LA SUBETIQUETA PRIMARIA: LO QUE VA ANTES DEL PRIMER GUION
  sPrimaria = Split(Trim(sIdioma), "-")[0]

  ' --- 2. CONSULTA: EL IDIOMA EXACTO PRIMERO ---
  Try rDatos = hConn.Exec("SELECT texto FROM licencia_texto WHERE url = &1 AND idioma IN (&2, &3) ORDER BY (idioma = &2) DESC LIMIT 1",
    Trim(sUrl), Trim(sIdioma), sPrimaria)
  If Error Then Return ""

  ' --- 3. RESULTADO ---
  If Not rDatos.Available Then Return ""
  Return rDatos!texto

End
