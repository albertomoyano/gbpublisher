' Gambas class file

' ============================================
' Clase     : CRelacionesArticulo
' Propósito : Relaciones y ubicaciones del artículo en memoria, mientras se
'             editan en la pestaña «Relaciones y ubicaciones» (entrega D3).
'             Se graban con el artículo, en su transacción (SC-73). Clase
'             chica por GV-24: viaja a m_Articulo.
' Tablas    : articulo_relacion, articulo_ubicacion.
' ============================================

' RELACIONES, EN ORDEN
Public aRelaciones As New CRelacion[]
' UBICACIONES: CLAVE EL TIPO (pagina | html | pdf | epub | xml), VALOR LA URL.
' UNA CLAVE AUSENTE ES «SIN URL»; ASIGNAR "" LA BORRA (GV-68)
Public cUbicaciones As New Collection

' ============================================
' Función   : MoverRelacion
' Propósito : Intercambia una relación con la vecina
' Parámetros: iIndice As Integer — posición
'             iPaso As Integer — -1 sube, 1 baja
' Retorna   : Integer — la nueva posición; la misma si no se pudo mover
' ============================================
Public Function MoverRelacion(iIndice As Integer, iPaso As Integer) As Integer

  Dim oRelacion As CRelacion
  Dim iDestino As Integer

  iDestino = iIndice + iPaso
  If iIndice < 0 Or iDestino < 0 Or iDestino >= aRelaciones.Count Then Return iIndice
  ' INTERCAMBIO A MANO: LOS ARREGLOS NO TIENEN Exchange (GV-148)
  oRelacion = aRelaciones[iIndice]
  aRelaciones[iIndice] = aRelaciones[iDestino]
  aRelaciones[iDestino] = oRelacion

  Return iDestino

End
