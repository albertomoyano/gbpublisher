' Gambas module file

' ==============================================================================
' Módulo    : m_GenerarPDFLibro
' Propósito : Generación de la salida PDF de LIBROS. Escribe los archivos
'             derivados que consume LuaLaTeX:
'               preambulo-proyecto.tex — valores que salen de la base
'               main.tex               — declarativo de piezas y zonas
'             Los preámbulos de contrato y estética, y los cita-*-config.tex,
'             son recursos de la app: los copia
'             m_InicioCierre.CopiarRecursosLatex sin modificarlos.
'
' Principio : ABORTAR ANTE CUALQUIER DATO FALTANTE. Un libro compuesto con un
'             formato que nadie eligió, o con un estilo de cita adivinado, es
'             peor que un error: sale mal y nadie se entera.
'
' Dependencias: m_ConexionBD, m_InicioCierre, m_Constantes, m_Bibtex, m_Sonido
' ==============================================================================

' --- CONSTANTES DE GENERACIÓN ---
Private Const NOMBRE_PREAMBULO_PROYECTO As String = "preambulo-proyecto.tex"
Private Const CARPETA_LATEX As String = "latex"
Private Const CARPETA_REFERENCIAS As String = "referencias"
Private Const CARPETA_CANONICOS As String = "jats"

' VERSIÓN DEL CONTRATO QUE ESTE GENERADOR REQUIERE. SI SE AGREGA VOCABULARIO
' AL XSLT, SUBE ACÁ Y EN preambulo-contrato.tex, Y UN PREÁMBULO DE EDITORIAL
' VIEJO FRENA EN LA PRIMERA LÍNEA EN VEZ DE DAR UN "Undefined control
' sequence" EN LA PÁGINA 140.
Public Const CONTRATO_VERSION As Integer = 1

' --- ZONAS DEL LIBRO ---
Private Const ZONA_FRONT As Integer = 1
Private Const ZONA_BODY As Integer = 2
Private Const ZONA_APENDICE As Integer = 3
Private Const ZONA_BACK As Integer = 4

' MARGEN QUE SE AGREGA POR LADO PARA LAS CRUCES DE CORTE, EN CENTÍMETROS.
' CUBRE EL SANGRADO —DE 3 A 5 mm— MÁS EL LARGO DE LA MARCA. LAS CRUCES SOLO
' NECESITAN LUGAR, Y ESE LUGAR ES EL MISMO PARA CUALQUIER FORMATO: 150×220
' DA 175×245, QUE ES LA PRÁCTICA CORRIENTE.
Private Const MARGEN_MONTAJE As Float = 1.25

' ============================================
' Función   : EscaparTeX
' Propósito : Escapa los diez caracteres activos de LaTeX en un texto que
'             viene de la base. Un título con & o % rompe la compilación
'             igual que si viniera del cuerpo del manuscrito.
' Parámetros: sTexto As String — texto crudo de la base
' Retorna   : String — texto seguro para modo texto de LaTeX
' Nota      : PASADA ÚNICA POR CODEPOINT, NO CADENA DE Replace().
'             ENCADENAR Replace() CON LA BARRA INVERTIDA PRIMERO ROMPE: EL
'             REEMPLAZO INYECTA \textbackslash{}, QUE CONTIENE LLAVES, Y EL
'             PASO SIGUIENTE LAS ESCAPA. NO TIENE ARREGLO POR REORDENAMIENTO.
'             ES EL MISMO BUG QUE SE CORRIGIÓ EN tex-comun.xsl Y EN LA
'             EXPORTACIÓN BibTeX.
'             SE RECORRE CON String.Mid Y String.Len, NO CON Mid Y Len, QUE
'             OPERAN EN BYTES Y CORTAN LOS MULTIBYTE (RC-GM-12, SC-02).
'             < > Y | NO SE ESCAPAN: BAJO LuaLaTeX CON fontspec Y UNA FUENTE
'             UNICODE SE COMPONEN COMO SÍ MISMOS.
' ============================================
Private Function EscaparTeX(sTexto As String) As String

  Dim iPos As Integer
  Dim sCar As String
  Dim sRes As String = ""

  ' --- 1. VALIDACIÓN DE ENTRADA ---
  If sTexto = "" Then Return ""

  ' --- 2. RECORRIDO POR CODEPOINT ---
  For iPos = 1 To String.Len(sTexto)
    sCar = String.Mid(sTexto, iPos, 1)
    Select Case sCar
      Case "\\"
        sRes &= "\\textbackslash{}"
      Case "{"
        sRes &= "\\{"
      Case "}"
        sRes &= "\\}"
      Case "$"
        sRes &= "\\$"
      Case "%"
        sRes &= "\\%"
      Case "&"
        sRes &= "\\&"
      Case "#"
        sRes &= "\\#"
      Case "_"
        sRes &= "\\_"
      Case "^"
        sRes &= "\\textasciicircum{}"
      Case "~"
        sRes &= "\\textasciitilde{}"
      Case Else
        sRes &= sCar
    End Select
  Next

  Return sRes

End

' ============================================
' Función   : EscaparURL
' Propósito : Escapa una URL para usarla dentro de \hypersetup o \href. Solo
'             % y # son problemáticos: el primero comenta el resto de la línea
'             y el segundo es el parámetro de destino.
' Parámetros: sURL As String — URL cruda de la base
' Retorna   : String — URL segura
' ============================================
Private Function EscaparURL(sURL As String) As String

  Dim sRes As String

  If sURL = "" Then Return ""

  sRes = Replace(sURL, "%", "\\%")
  sRes = Replace(sRes, "#", "\\#")

  Return sRes

End

' ============================================
' Función   : NuloAVacio
' Propósito : Convierte un valor NULL de la base en cadena vacía. Sin esto,
'             concatenar un campo NULL propaga el nulo a toda la expresión.
' Parámetros: vValor As Variant — valor leído de un Result
' Retorna   : String — el valor como texto, o "" si era NULL
' Nota      : NO USAR CStr() SOBRE UN Boolean: DEVUELVE "T" O CADENA VACÍA, Y
'             UN False SE VUELVE INDISTINGUIBLE DE UN NULL (GV-10).
' ============================================
Private Function NuloAVacio(vValor As Variant) As String

  If IsNull(vValor) Then Return ""
  Return Trim(CStr(vValor))

End

' ============================================
' Función   : CodigoABabel
' Propósito : Convierte un código ISO 639-1 al nombre de idioma que reconoce
'             babel. Lo consume \usepackage[\gbidiomas]{babel}.
' Parámetros: sCodigo As String — código ISO 639-1 (es, en, pt, ...)
' Retorna   : String — nombre para babel, o "" si no se reconoce
' Nota      : DEVUELVE VACÍO EN VEZ DE CAER A spanish: EL LLAMADOR DECIDE SI
'             ESO ES UN ERROR. UN IDIOMA ADIVINADO ROMPE LA PARTICIÓN DE
'             PALABRAS DE TODO EL LIBRO SIN QUE NADA AVISE.
' ============================================
Private Function CodigoABabel(sCodigo As String) As String

  Select Case LCase(Trim(sCodigo))
    Case "es"
      Return "spanish"
    Case "en"
      Return "english"
    Case "pt"
      Return "portuguese"
    Case "fr"
      Return "french"
    Case "de"
      Return "german"
    Case "it"
      Return "italian"
    Case "ca"
      Return "catalan"
    Case Else
      Return ""
  End Select

End

' ============================================
' Función   : RolesDeAutoriaSegunTipo
' Propósito : Devuelve la cláusula IN de roles que corresponde a la autoría
'             del LIBRO según su tipo. En obras de autoría van los autores;
'             en compilaciones va quien edita, con su rol.
'             No se usa el modelo anglosajón de poner un editor en libros de
'             un solo autor.
' Parámetros: sTipoLibro As String — libros_md.tipo_libro
' Retorna   : String — lista de roles entre comillas, lista para un IN
' ============================================
Private Function RolesDeAutoriaSegunTipo(sTipoLibro As String) As String

  Select Case LCase(Trim(sTipoLibro))
    Case "obra_colectiva", "compilacion", "actas", "referencia"
      Return "'editor','compilador','coordinador'"
    Case Else
      ' monografia, manual, traduccion
      Return "'autor'"
  End Select

End

' ============================================
' Función   : AbreviaturaDeRol
' Propósito : Abreviatura con la que se acompaña el nombre de quien edita.
'             Vacía para el rol de autor.
' Parámetros: sRol As String — libro_autor.rol_libro
' Retorna   : String — "comp.", "ed.", "coord." o ""
' ============================================
Private Function AbreviaturaDeRol(sRol As String) As String

  Select Case LCase(Trim(sRol))
    Case "editor"
      Return "ed."
    Case "compilador"
      Return "comp."
    Case "coordinador"
      Return "coord."
    Case Else
      Return ""
  End Select

End

' ============================================
' Función   : ZonaDeTipo
' Propósito : Zona de LaTeX que corresponde a un tipo_capitulo.
' Parámetros: sTipo As String — capitulos.tipo_capitulo
' Retorna   : Integer — una de las constantes ZONA_*
' Nota      : LA ZONA NO LA DECIDE LA CARPETA. Una pieza de bm/ puede terminar
'             en el cuerpo, en los apéndices o en los posliminares. Unas
'             conclusiones viven en bm/ pero van en el cuerpo, sin numerar,
'             ANTES de \appendix: con \appendix después de \backmatter los
'             apéndices dejan de numerarse con letra y sus figuras arrastran
'             el prefijo del último capítulo del cuerpo. Verificado.
'             LOS TIPOS QUE VAN EN EL CUERPO SIN NUMERAR devuelven ZONA_BODY
'             igual que capitulo; la diferencia entre numerado y no la
'             resuelve docbook-to-latex.xsl, que lee el mismo tipo-capitulo
'             del canónico. Acá solo importa el orden y la zona.
' ============================================
Private Function ZonaDeTipo(sTipo As String) As Integer

  Select Case LCase(Trim(sTipo))

      ' --- PRELIMINARES ---
    Case "prologo", "prefacio", "presentacion", "palabras_preliminares",
        "introduccion", "dedicatoria", "agradecimientos",
        "nota_traductor", "nota_editor",
        "lista_figuras", "lista_tablas", "lista_abreviaturas"
      Return ZONA_FRONT

      ' --- CUERPO: CAPÍTULOS Y PIEZAS DE CIERRE SIN NUMERAR ---
    Case "capitulo", "conclusiones", "epilogo", "posfacio", "post_scriptum"
      Return ZONA_BODY

      ' --- APÉNDICES ---
    Case "apendice"
      Return ZONA_APENDICE

      ' --- POSLIMINARES ---
    Case "glosario", "bibliografia", "sobre_autores", "cronologia",
        "indice_onomastico", "indice_concepto", "indice_autores", "colofon"
      Return ZONA_BACK

    Case Else
      ' otro Y CUALQUIER TIPO NUEVO QUE SE AGREGUE AL enum SIN TOCAR ESTA
      ' FUNCIÓN. VA AL CUERPO, QUE ES EL DESTINO MENOS SORPRENDENTE.
      Return ZONA_BODY

  End Select

End

' ============================================
' Función   : EsPiezaSinNumerar
' Propósito : Dice si una pieza del cuerpo va sin numerar, y por lo tanto
'             necesita \gbPiezaSinNumerar antes de su \include.
' Parámetros: sTipo As String — capitulos.tipo_capitulo
' Retorna   : Boolean
' ============================================
Private Function EsPiezaSinNumerar(sTipo As String) As Boolean

  Select Case LCase(Trim(sTipo))
    Case "conclusiones", "epilogo", "posfacio", "post_scriptum"
      Return True
    Case Else
      Return False
  End Select

End

' ============================================
' Función   : ComandoGenerado
' Propósito : Comando de LaTeX que corresponde a una pieza SIN CUERPO PROPIO.
'             Esas piezas no tienen .md ni canónico: las produce LaTeX, así
'             que NO llevan \include. Si el generador las tratara como piezas
'             normales, el main.tex declararía un archivo inexistente y LaTeX
'             fallaría con un "I can't find file" que no dice de dónde salió
'             la referencia.
' Parámetros: sTipo As String — capitulos.tipo_capitulo
' Retorna   : String — el comando, "" si la pieza tiene cuerpo, o "ABORTAR"
'
' LOS TRES ÍNDICES DEL PREÁMBULO
'   names       lo llena biblatex vía esindex con los autores del aparato
'               bibliográfico. El editor no escribe nada.
'   onomastico  lo carga el editor con \index[onomastico]{...}
'   concepto    lo carga el editor con \index[concepto]{...}
'
' LOS TRES ÍNDICES DEL LIBRO. LOS DOS PRIMEROS LOS CARGA EL EDITOR CON
' \index[onomastico]{} Y \index[concepto]{}; EL TERCERO LO LLENA biblatex
' CON indexing=true, Y EL EDITOR NO ESCRIBE NADA.
'
' PENDIENTE MAYOR: el canónico no tiene ningún <indexterm>, así que hoy los dos
' índices manuales saldrían vacíos aunque se pida la pieza. Falta el shortcode,
' con su representación en DocBook y su plantilla en las dos ramas.
'
' PENDIENTE: lista_abreviaturas y glosario se tratan como piezas CON cuerpo,
' porque el ABM de siglas todavía no se encaró. Si esas piezas pasan a
' generarse desde glossaries, hay que moverlas acá con \printglossary.
' ============================================
Private Function ComandoGenerado(sTipo As String, sTitulo As String) As String

  Select Case LCase(Trim(sTipo))

    Case "lista_figuras"
      Return "\\listoffigures"
    Case "lista_tablas"
      Return "\\listoftables"
      ' LOS TRES ÍNDICES DEL LIBRO. LOS DOS PRIMEROS LOS CARGA EL EDITOR CON
      ' \index[onomastico]{} Y \index[concepto]{}; EL TERCERO LO LLENA biblatex
      ' CON indexing=true, Y EL EDITOR NO ESCRIBE NADA.
      ' LOS TRES ÍNDICES LLEVAN ENCABEZADO PROPIO. EL \makeindex DE LA ESTÉTICA
      ' LOS DECLARA CON title={} A PROPÓSITO: EL TÍTULO SALE DE
      ' capitulos.titulo_capitulo, QUE ES DONDE EL EDITOR LO ESCRIBE, Y NO DEL
      ' PREÁMBULO. SIN EL ENCABEZADO, \printindex IMPRIME LA LISTA DE NOMBRES
      ' SIN DECIR QUÉ ES.
    Case "indice_onomastico"
      Return "\\gbIndice{" & EscaparTeX(sTitulo) & "}{onomastico}"

    Case "indice_concepto"
      Return "\\gbIndice{" & EscaparTeX(sTitulo) & "}{concepto}"

    Case "indice_autores"
      Return "\\gbIndice{" & EscaparTeX(sTitulo) & "}{names}"

      ' LA BIBLIOGRAFÍA LA CONSTRUYE biblatex Y NO SALE DE UN .md. DECLARAR LA
      ' PIEZA ES LA FORMA DE ELEGIR DÓNDE VA Y CÓMO SE TITULA: CON heading=none
      ' EL TÍTULO SALE DE capitulos.titulo_capitulo, IGUAL QUE EN LOS ÍNDICES,
      ' Y NO DE LA CADENA LOCALIZADA DE biblatex.
    Case "bibliografia"
      Return "\\gbEncabezadoPieza{" & EscaparTeX(sTitulo) & "}" & gb.NewLine &
        "\\printbibliography[heading=none]"

      ' EL COLOFÓN LO EMITE EL GENERADOR Y NO SALE DE UN .md: CADA RAMA DE SALIDA
      ' PRODUCE EL SUYO, Y EL DEL PDF DECLARA CON QUÉ FUENTES Y CON QUÉ VERSIÓN
      ' SE COMPUSO. DECLARAR LA PIEZA ES LA FORMA DE ELEGIR DÓNDE VA.
    Case "colofon"
      Return "\\begin{gbcolofon}" & gb.NewLine & "\\gbTextoColofon" &
        gb.NewLine & "\\end{gbcolofon}"

    Case Else
      Return ""

  End Select

End

' ============================================
' Función   : ObtenerAutoresLibro
' Propósito : Arma la cadena de autoría del libro para los metadatos del PDF,
'             ordenada por orden_autoria.
' Parámetros: iIdLibro   As Integer — libros_md.id_libro
'             sTipoLibro As String  — libros_md.tipo_libro
' Retorna   : String — "Apellidos, Nombre; Apellidos, Nombre (comp.)" o ""
'             si no hay ninguno, que el llamador trata como error.
' Nota      : SE USAN apellidos Y nombre, QUE SON NOT NULL, Y NO
'             apellidos_nombre NI nombre_publicaciones, QUE SON ANULABLES.
' ============================================
Private Function ObtenerAutoresLibro(iIdLibro As Integer, sTipoLibro As String) As String

  Dim hRes As Result
  Dim sSQL As String
  Dim sNombre As String
  Dim sAbrev As String
  Dim aNombres As New String[]

  ' --- 1. CONSULTA ---
  ' EL IN DE ROLES SE INTERPOLA PORQUE ES UN LITERAL CONSTRUIDO POR NOSOTROS A
  ' PARTIR DE UN enum CERRADO, NO UN DATO DEL USUARIO. EL ÚNICO VALOR EXTERNO
  ' VA POR PLACEHOLDER.
  sSQL = "SELECT a.apellidos, a.nombre, la.rol_libro " &
    "FROM libro_autor la " &
    "JOIN autores a ON a.id_autor = la.id_autor " &
    "WHERE la.id_libro = &1 " &
    "AND la.rol_libro IN (" & RolesDeAutoriaSegunTipo(sTipoLibro) & ") " &
    "ORDER BY la.orden_autoria"

  Try hRes = m_ConexionBD.mConn.Exec(sSQL, iIdLibro)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo leer la autoría del libro:" & gb.NewLine & Error.Text)
    Return ""
  Endif

  ' --- 2. RECORRIDO Y ARMADO ---
  If Not hRes.Available Then Return ""

  For Each hRes
    sNombre = Trim(hRes["apellidos"]) & ", " & Trim(hRes["nombre"])
    sAbrev = AbreviaturaDeRol(hRes["rol_libro"])
    If sAbrev <> "" Then
      sNombre &= " (" & sAbrev & ")"
    Endif
    aNombres.Add(sNombre)
  Next

  Return aNombres.Join("; ")

End

' ============================================
' Función   : GenerarPreambuloProyecto
' Propósito : Escribe {proyecto}/latex/preambulo-proyecto.tex con los valores
'             que salen de libros_md, formatos_pdf y libro_autor.
'
'             El archivo es DERIVADO: se reescribe en cada generación sin
'             preguntar. Pero SÍ se versiona, porque el commit es la garantía
'             de traza de qué se publicó. Por eso no lleva marca de tiempo ni
'             nada que cambie entre dos generaciones iguales: compilar dos
'             veces sin tocar datos debe dejar git status limpio.
'
'             Va PRIMERO en el orden de \input porque geometry y fontspec
'             necesitan los valores en el momento del \usepackage.
'
' Parámetros: (ninguno — trabaja sobre m_InicioCierre.IdProyectoEnCurso)
' Retorna   : Boolean — True si se escribió, False si abortó con mensaje
' ============================================
Public Function GenerarPreambuloProyecto() As Boolean

  Dim hLibro As Result
  Dim sSQL As String
  Dim s As String
  Dim sRutaLatex As String
  Dim sRutaArchivo As String
  Dim sEstilo As String
  Dim sAutores As String
  Dim sIdiomaPrincipal As String
  Dim sIdiomasBabel As String
  Dim sCodigo As String
  Dim aCodigos As String[]
  Dim aIdiomas As New String[]
  Dim aPrest As String[]
  Dim iIdLibro As Integer
  Dim iFormato As Integer

  ' --- 1. VALIDACIÓN DE PROYECTO ABIERTO ---
  If m_InicioCierre.IdProyectoEnCurso = 0 Then
    m_Sonido.sonar("Info")
    Message.Info("Abrí un proyecto antes de generar la salida PDF.")
    Return False
  Endif

  sRutaLatex = m_InicioCierre.RutaProyectoEnCurso &/ CARPETA_LATEX

  If Not Exist(sRutaLatex) Then
    Try Mkdir sRutaLatex
    If Error Then
      m_Sonido.sonar("Error")
      Message.Error("No se pudo crear el directorio:" & gb.NewLine & sRutaLatex &
        gb.NewLine & Error.Text)
      Return False
    Endif
  Endif

  ' --- 2. LECTURA DEL LIBRO Y SU FORMATO ---
  ' UN SOLO Exec CON JOIN: SI EL LIBRO NO TIENE FORMATO ASIGNADO, EL LEFT JOIN
  ' DEVUELVE NULL EN LAS COLUMNAS DEL FORMATO Y SE DETECTA EN EL APARTADO 3.
  sSQL = "SELECT l.id_libro, l.titulo_libro, l.subtitulo, l.titulo_abreviado, " &
    "       l.tipo_libro, l.lugar_bibliografia, l.estado_libro, " &
    "       l.estilo_cita, l.idioma_principal, l.idiomas_publicacion, " &
    "       l.isbn_impreso, l.isbn_electronico, l.doi_libro, " &
    "       l.editorial, l.ciudad_publicacion, l.ano_publicacion, " &
    "       l.licencia_defecto, l.url_licencia, l.palabras_clave_libro, " &
    "       l.id_formato_pdf, " &
    "       f.nombre_formato, f.ancho, f.alto, " &
    "       f.margen_interior, f.margen_exterior, " &
    "       f.margen_superior, f.margen_inferior " &
    "FROM libros_md l " &
    "LEFT JOIN formatos_pdf f ON f.id_formato_pdf = l.id_formato_pdf " &
    "WHERE l.id_proyecto = &1 LIMIT 1"

  Try hLibro = m_ConexionBD.mConn.Exec(sSQL, m_InicioCierre.IdProyectoEnCurso)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo leer el libro del proyecto:" & gb.NewLine & Error.Text)
    Return False
  Endif

  ' RC-GM-17: And NO CORTOCIRCUITA. EL CHEQUEO DE Available VA EN UN If
  ' ANIDADO, NO ENCADENADO CON EL DE Error.
  If Not hLibro.Available Then
    m_Sonido.sonar("Error")
    Message.Error("El proyecto abierto no tiene un libro asociado en la base.")
    Return False
  Endif

  iIdLibro = hLibro["id_libro"]

  ' --- 3. VALIDACIÓN DEL FORMATO DE PÁGINA ---
  ' SIN FORMATO NO HAY PÁGINA. ABORTAR ES LA SALIDA CORRECTA: UN LIBRO
  ' COMPUESTO EN UN FORMATO QUE NADIE ELIGIÓ SALE MAL Y NADIE SE ENTERA.
  If IsNull(hLibro["id_formato_pdf"]) Then
    m_Sonido.sonar("Error")
    Message.Error("El libro no tiene formato de página asignado." & gb.NewLine &
      "Cargalo en la ficha del libro antes de generar el PDF.")
    Return False
  Endif

  iFormato = hLibro["id_formato_pdf"]

  If IsNull(hLibro["ancho"]) Then
    m_Sonido.sonar("Error")
    Message.Error("El formato de página " & CStr(iFormato) &
      " no existe en formatos_pdf.")
    Return False
  Endif

  ' --- 4. PRESTACIONES DE SALIDA ---
  ' SE EMITEN PRESTACIONES Y NO UN «MODO»: ASÍ, AGREGAR UN ESTADO EDITORIAL
  ' NUEVO NO OBLIGA A TOCAR EL PREÁMBULO, Y CADA BANDERA DICE QUÉ HACE EN VEZ
  ' DE CÓMO SE LLAMA.
  aPrest = PrestacionesDeSalida(hLibro["estado_libro"])

  ' --- 5. ESTILO DE CITA ---
  ' EL CANÓNICO TAMBIÉN LO TRAE, PERO LA FUENTE ES LA BASE: EL XML ES COPIA.
  If IsNull(hLibro["estilo_cita"]) Then
    m_Sonido.sonar("Error")
    Message.Error("El libro no tiene estilo de cita asignado.")
    Return False
  Endif

  sEstilo = m_InicioCierre.LeerTipoCSL(hLibro["estilo_cita"])
  If sEstilo = "" Then Return False   ' LeerTipoCSL YA AVISÓ

  ' vancouver VA POR bibtex Y LA RAMA NO ESTÁ IMPLEMENTADA. EL XSLT TAMBIÉN
  ' CORTA, PERO CONVIENE FRENAR ACÁ Y NO DESPUÉS DE HABER ESCRITO ARCHIVOS.
  If sEstilo = "vancouver" Then
    m_Sonido.sonar("Error")
    Message.Error("El estilo vancouver usa bibtex y todavía no está " &
      "implementado para libros." & gb.NewLine &
      "Los estilos disponibles son apa, iso690 e ieee.")
    Return False
  Endif

  ' --- 6. IDIOMAS ---
  sIdiomaPrincipal = CodigoABabel(hLibro["idioma_principal"])

  If sIdiomaPrincipal = "" Then
    m_Sonido.sonar("Error")
    Message.Error("El idioma principal del libro no está entre los " &
      "reconocidos por babel: " & hLibro["idioma_principal"])
    Return False
  Endif

  ' LOS SECUNDARIOS SON OPCIONALES. SE CARGA babel SOLO CON LOS DEL LIBRO Y NO
  ' CON SIETE SIEMPRE. EL PRINCIPAL VA CON main= PARA QUE NO DEPENDA DEL ORDEN.
  If Not IsNull(hLibro["idiomas_publicacion"]) Then
    aCodigos = Split(hLibro["idiomas_publicacion"], ",")
    For Each sCodigo In aCodigos
      sCodigo = CodigoABabel(sCodigo)
      If sCodigo <> "" Then
        If sCodigo <> sIdiomaPrincipal Then
          If Not aIdiomas.Exist(sCodigo) Then aIdiomas.Add(sCodigo)
        Endif
      Endif
    Next
  Endif

  aIdiomas.Add("main=" & sIdiomaPrincipal)
  sIdiomasBabel = aIdiomas.Join(",")

  ' --- 7. AUTORÍA ---
  sAutores = ObtenerAutoresLibro(iIdLibro, hLibro["tipo_libro"])

  If sAutores = "" Then
    m_Sonido.sonar("Error")
    Message.Error("El libro no tiene cargada la autoría que corresponde a su " &
      "tipo (" & hLibro["tipo_libro"] & ").")
    Return False
  Endif

  ' --- 8. ARMADO DEL ARCHIVO ---
  s = "% ============================================================" & gb.NewLine
  s &= "% preambulo-proyecto.tex" & gb.NewLine
  s &= "% ------------------------------------------------------------" & gb.NewLine
  s &= "% ARCHIVO DERIVADO — GENERADO POR gbpublisher" & gb.NewLine
  s &= "% NO EDITAR A MANO: SE REESCRIBE EN CADA GENERACIÓN DEL" & gb.NewLine
  s &= "% main.tex. LOS CAMBIOS SE HACEN EN LA BASE." & gb.NewLine
  s &= "%" & gb.NewLine
  s &= "% SÍ SE VERSIONA: EL COMMIT ES LA GARANTÍA DE TRAZA DE QUÉ SE" & gb.NewLine
  s &= "% PUBLICÓ. POR ESO NO LLEVA MARCA DE TIEMPO." & gb.NewLine
  s &= "% ------------------------------------------------------------" & gb.NewLine
  s &= "% ESTA CAPA SOLO DEFINE VALORES. NO CARGA NINGÚN PAQUETE." & gb.NewLine
  s &= "% VA PRIMERA PORQUE geometry Y fontspec NECESITAN LOS VALORES" & gb.NewLine
  s &= "% EN EL MOMENTO DEL \\usepackage." & gb.NewLine
  s &= "% ============================================================" & gb.NewLine
  s &= gb.NewLine

  ' 8.1 PRESTACIONES DE SALIDA
  ' aPrest YA VIENE CARGADO DEL APARTADO 4. NO SE VUELVE A LLAMAR A
  ' PrestacionesDeSalida: DOS LLAMADAS SON DOS LUGARES QUE ALGUIEN PUEDE
  ' CAMBIAR POR SEPARADO, Y EL DERIVADO SALDRÍA CON BANDERAS INCONSISTENTES.
  s &= "% --- PRESTACIONES DE SALIDA (derivadas de estado_libro) ---" & gb.NewLine
  s &= "\\newif\\ifgbshowframe    \\gbshowframe" & aPrest[0] & gb.NewLine
  s &= "\\newif\\ifgbhomeoarchy   \\gbhomeoarchy" & aPrest[1] & gb.NewLine
  s &= "\\newif\\ifgbenlaces      \\gbenlaces" & aPrest[2] & gb.NewLine
  s &= "\\newif\\ifgbcruces       \\gbcruces" & aPrest[3] & gb.NewLine
  s &= gb.NewLine

  ' 8.2 FORMATO DE PÁGINA
  s &= "% --- FORMATO DE PÁGINA (formatos_pdf id=" & CStr(iFormato) & ") ---" & gb.NewLine
  s &= "\\def\\gbanchopagina{" & NumeroLatex(hLibro["ancho"]) & "cm}" & gb.NewLine
  s &= "\\def\\gbaltopagina{" & NumeroLatex(hLibro["alto"]) & "cm}" & gb.NewLine
  s &= "\\def\\gbmargeninterior{" & NumeroLatex(hLibro["margen_interior"]) & "cm}" & gb.NewLine
  s &= "\\def\\gbmargenexterior{" & NumeroLatex(hLibro["margen_exterior"]) & "cm}" & gb.NewLine
  s &= "\\def\\gbmargensuperior{" & NumeroLatex(hLibro["margen_superior"]) & "cm}" & gb.NewLine
  s &= "\\def\\gbmargeninferior{" & NumeroLatex(hLibro["margen_inferior"]) & "cm}" & gb.NewLine
  s &= "\\def\\gbnombreformato{" & EscaparTeX(hLibro["nombre_formato"]) & "}" & gb.NewLine

  ' LA HOJA DE MONTAJE ES EL FORMATO FINAL MÁS EL MARGEN DE CRUCES POR LADO.
  ' NO SE GUARDA EN LA BASE PORQUE NO HACE FALTA: LAS CRUCES SOLO NECESITAN
  ' LUGAR, Y ESE LUGAR ES EL MISMO PARA CUALQUIER FORMATO. 15x23 DA 17,5x25,5.
  ' truecm Y NO cm: ES LA UNIDAD INMUNE A \mag, QUE ES LO QUE CORRESPONDE EN
  ' UNA MEDIDA DE MONTAJE.
  s &= "\\def\\gbanchomontaje{" &
    NumeroLatex(hLibro["ancho"] + 2 * MARGEN_MONTAJE) & "truecm}" & gb.NewLine
  s &= "\\def\\gbaltomontaje{" &
    NumeroLatex(hLibro["alto"] + 2 * MARGEN_MONTAJE) & "truecm}" & gb.NewLine
  s &= gb.NewLine

  ' 8.3 IDIOMA
  s &= "% --- IDIOMA ---" & gb.NewLine
  s &= "\\def\\gbidiomas{" & sIdiomasBabel & "}" & gb.NewLine
  s &= "\\def\\gbidiomaprincipal{" & sIdiomaPrincipal & "}" & gb.NewLine
  s &= "\\newif\\ifgbcjk   \\gbcjkfalse" & gb.NewLine
  s &= gb.NewLine

  ' 8.4 BIBLIOGRAFÍA
  s &= "% --- BIBLIOGRAFÍA ---" & gb.NewLine
  s &= "\\def\\estandar{" & sEstilo & "}" & gb.NewLine
  s &= "\\newif\\ifgbbibporcapitulo   \\gbbibporcapitulo" &
    IIf(LCase(Trim(hLibro["lugar_bibliografia"])) = "consolidada",
    "false", "true") & gb.NewLine
  s &= "\\def\\gbarchivobib{./" & CARPETA_REFERENCIAS & "/" &
    m_Bibtex.NombreArchivoBib() & "}" & gb.NewLine
  s &= gb.NewLine

  ' 8.5 METADATOS DEL PDF
  s &= "% --- METADATOS DEL PDF ---" & gb.NewLine
  s &= "\\def\\gbtitulo{" & EscaparTeX(hLibro["titulo_libro"]) & "}" & gb.NewLine
  s &= "\\def\\gbsubtitulo{" & EscaparTeX(NuloAVacio(hLibro["subtitulo"])) & "}" & gb.NewLine
  s &= "\\def\\gbtituloabreviado{" & EscaparTeX(NuloAVacio(hLibro["titulo_abreviado"])) & "}" & gb.NewLine
  s &= "\\def\\gbautores{" & EscaparTeX(sAutores) & "}" & gb.NewLine
  s &= "\\def\\gbeditorial{" & EscaparTeX(NuloAVacio(hLibro["editorial"])) & "}" & gb.NewLine
  s &= "\\def\\gbciudad{" & EscaparTeX(NuloAVacio(hLibro["ciudad_publicacion"])) & "}" & gb.NewLine
  s &= "\\def\\gbanio{" & NuloAVacio(hLibro["ano_publicacion"]) & "}" & gb.NewLine
  s &= "\\def\\gbisbn{" & EscaparTeX(NuloAVacio(hLibro["isbn_impreso"])) & "}" & gb.NewLine
  s &= "\\def\\gbisbnelectronico{" & EscaparTeX(NuloAVacio(hLibro["isbn_electronico"])) & "}" & gb.NewLine
  s &= "\\def\\gbdoi{" & EscaparTeX(NuloAVacio(hLibro["doi_libro"])) & "}" & gb.NewLine
  s &= "\\def\\gblicencia{" & EscaparTeX(NuloAVacio(hLibro["licencia_defecto"])) & "}" & gb.NewLine
  s &= "\\def\\gburllicencia{" & EscaparURL(NuloAVacio(hLibro["url_licencia"])) & "}" & gb.NewLine
  s &= "\\def\\gbpalabrasclave{" & EscaparTeX(NuloAVacio(hLibro["palabras_clave_libro"])) & "}" & gb.NewLine
  s &= gb.NewLine

  ' 8.6 VERSIÓN
  ' NO ES UNA MARCA DE TIEMPO: CAMBIA SOLO CUANDO CAMBIA LA APP, Y ESE CAMBIO
  ' ES SEÑAL LEGÍTIMA EN EL DIFF, NO RUIDO.
  s &= "% --- VERSIÓN DE gbpublisher ---" & gb.NewLine
  s &= "\\def\\gbversion{" & Application.Version & "}" & gb.NewLine

  ' --- 9. ESCRITURA ---
  ' File.Save OPERA EN UTF-8 NATIVAMENTE: NO PASAR PARÁMETROS DE CODIFICACIÓN
  ' NI RECODIFICAR (SC-02).
  sRutaArchivo = sRutaLatex &/ NOMBRE_PREAMBULO_PROYECTO

  Try File.Save(sRutaArchivo, s)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo escribir el preámbulo del proyecto:" & gb.NewLine &
      sRutaArchivo & gb.NewLine & Error.Text)
    Return False
  Endif

  Return True

End

' ============================================
' Función   : BorrarTexHuerfanos
' Propósito : Elimina de {proyecto}/latex los c-*.tex que no corresponden a
'             ninguna pieza declarada en la base.
' Parámetros: sDirLatex   As String     — {proyecto}/latex
'             cDeclarados As Collection — claves = nombres de archivo esperados
' Retorna   : (Sub, sin retorno)
' Nota      : SI NO SE BORRAN, LA CARPETA MIENTE SOBRE QUÉ ES EL LIBRO. Y HAY
'             UN CASO PEOR QUE EL RUIDO: SI SE BORRA UNA PIEZA DE LA BASE, SU
'             .tex VIEJO QUEDA, ALGUIEN LO AGREGA AL main.tex A MANO Y COMPILA
'             CONTENIDO QUE YA NO ES PARTE DEL PROYECTO.
' ============================================
Private Sub BorrarTexHuerfanos(sDirLatex As String, cDeclarados As Collection)

  Dim aArchivos As String[]
  Dim sArchivo As String

  Try aArchivos = Dir(sDirLatex, "c-*.tex", gb.File)
  If Error Then Return

  For Each sArchivo In aArchivos
    If Not cDeclarados.Exist(sArchivo) Then
      Try Kill sDirLatex &/ sArchivo
      If Error Then
        ' NO SE ABORTA POR ESTO: UN HUÉRFANO QUE NO SE PUDO BORRAR NO IMPIDE
        ' COMPILAR. PERO SE INFORMA, PORQUE UN Try MUDO ES UN CANAL MUDO
        ' (GV-23).
        Message.Warning("No se pudo borrar el archivo huérfano " & sArchivo &
          ":" & gb.NewLine & Error.Text)
      Endif
    Endif
  Next

End

' ============================================
' Función   : GenerarTexDePieza
' Propósito : Corre docbook-to-latex.xsl sobre el canónico de una pieza.
' Parámetros: sNombreArchivo As String — capitulos.nombre_archivo
'             sRutaProyecto  As String — raíz del proyecto
' Retorna   : Boolean — True si generó
' Nota      : Exec CON ARRAY Y NUNCA Shell: LOS NOMBRES DE ARCHIVO PUEDEN
'             TENER CARACTERES QUE sh -c INTERPRETARÍA (SC-05).
'             EL ARRAY SE ARMA CON .Add Y NO COMO LITERAL MULTILÍNEA: UN
'             LITERAL PARTIDO CON COMA FINAL SE LEE COMO String Y DA
'             Type mismatch (SC-05, GV-06).
'             SI LA HOJA ABORTA POR VOCABULARIO NO PREVISTO, EL CÓDIGO DE
'             SALIDA NO ES CERO Y EL Try LO ATRAPA.
' PENDIENTE : NO VERIFIQUÉ QUE "Exec ... Wait" SEA LA SINTAXIS CORRECTA EN
'             GAMBAS 3.22. SI NO COMPILA, LA ALTERNATIVA DOCUMENTADA ES
'             "Exec ... To sSalidaStd" (GV-20).
' ============================================
Private Function GenerarTexDePieza(sNombreArchivo As String, sRutaProyecto As String) As Boolean

  Dim sCanonico As String
  Dim sSalida As String
  Dim sHoja As String
  Dim aComando As New String[]

  sCanonico = sRutaProyecto &/ CARPETA_CANONICOS &/ "c-" & sNombreArchivo & ".xml"
  sSalida = sRutaProyecto &/ CARPETA_LATEX &/ "c-" & sNombreArchivo & ".tex"
  sHoja = User.Home &/ ".gbpublisher" &/ "xslt" &/ "docbook-to-latex.xsl"

  ' --- 1. VALIDACIONES ---
  If Not Exist(sCanonico) Then
    m_Sonido.sonar("Error")
    Message.Error("No existe el canónico de la pieza:" & gb.NewLine & sCanonico &
      gb.NewLine & gb.NewLine &
      "Generá primero el DocBook canónico de " & sNombreArchivo & ".")
    Return False
  Endif

  If Not Exist(sHoja) Then
    m_Sonido.sonar("Error")
    Message.Error("No se encontró la hoja de transformación:" & gb.NewLine & sHoja)
    Return False
  Endif

  ' --- 2. INVOCACIÓN ---
  aComando.Add("java")
  aComando.Add("-jar")
  aComando.Add(m_Constantes.RUTA_SAXON)
  aComando.Add("-s:" & sCanonico)
  aComando.Add("-xsl:" & sHoja)
  aComando.Add("-o:" & sSalida)

  Try Exec aComando Wait
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Falló la transformación de " & sNombreArchivo & ":" &
      gb.NewLine & Error.Text & gb.NewLine & gb.NewLine &
      "Si el mensaje habla de vocabulario no previsto, hay un elemento del " &
      "canónico que la hoja todavía no contempla.")
    Return False
  Endif

  If Not Exist(sSalida) Then
    m_Sonido.sonar("Error")
    Message.Error("La transformación de " & sNombreArchivo &
      " no produjo salida.")
    Return False
  Endif

  Return True

End

' ============================================
' Función   : AbrirZona
' Propósito : Texto que abre una zona del libro en el main.tex.
' Parámetros: iZona As Integer — una de las constantes ZONA_*
' Retorna   : String
' Nota      : secnumdepth EN 0 Y NO EN -1: ALCANZA PARA APAGAR LOS NÚMEROS DE
'             SECCIÓN Y NO DEJA \part SIN NUMERAR. VERIFICADO.
' ============================================
Private Function AbrirZona(iZona As Integer) As String

  Dim s As String

  Select Case iZona

    Case ZONA_FRONT
      s = gb.NewLine & "%%GB:FRONT:INICIO" & gb.NewLine
      s &= "\\frontmatter" & gb.NewLine
      s &= "\\setcounter{secnumdepth}{0}" & gb.NewLine
      s &= "\\gbContadoresSinCapitulo" & gb.NewLine
      ' LAS HOJAS DE CORTESÍA VAN ANTES DE TODO Y CUENTAN EN LA PAGINACIÓN:
      ' SON i Y ii, Y EL SUMARIO EMPIEZA EN iii.
      s &= "\\gbHojasCortesia" & gb.NewLine
      s &= "\\tableofcontents" & gb.NewLine

    Case ZONA_BODY
      s = gb.NewLine & "%%GB:BODY:INICIO" & gb.NewLine
      s &= "\\mainmatter" & gb.NewLine
      s &= "\\setcounter{secnumdepth}{3}" & gb.NewLine

    Case ZONA_APENDICE
      ' LOS APÉNDICES VAN ANTES DE \backmatter: CON \appendix DESPUÉS QUEDAN
      ' SIN NUMERAR Y SUS FIGURAS ARRASTRAN EL PREFIJO DEL ÚLTIMO CAPÍTULO DEL
      ' CUERPO. VERIFICADO.
      ' SE VUELVE A ENCENDER LA NUMERACIÓN QUE PUDO HABER APAGADO
      ' \gbPiezaSinNumerar EN LAS CONCLUSIONES.
      s = gb.NewLine & "%%GB:APENDICES:INICIO" & gb.NewLine
      s &= "\\setcounter{secnumdepth}{3}" & gb.NewLine
      s &= "\\appendix" & gb.NewLine

    Case ZONA_BACK
      s = gb.NewLine & "%%GB:BACK:INICIO" & gb.NewLine
      s &= "\\backmatter" & gb.NewLine
      s &= "\\setcounter{secnumdepth}{0}" & gb.NewLine
      s &= "\\gbContadoresSinCapitulo" & gb.NewLine

  End Select

  Return s

End

' ============================================
' Función   : CerrarZona
' Propósito : Marcador de cierre de una zona del libro.
' Parámetros: iZona As Integer — zona que se cierra, 0 si no hay
' Retorna   : String
' ============================================
Private Function CerrarZona(iZona As Integer) As String

  Select Case iZona
    Case ZONA_FRONT
      Return "%%GB:FRONT:FIN" & gb.NewLine
    Case ZONA_BODY
      Return "%%GB:BODY:FIN" & gb.NewLine
    Case ZONA_APENDICE
      Return "%%GB:APENDICES:FIN" & gb.NewLine
    Case ZONA_BACK
      Return "%%GB:BACK:FIN" & gb.NewLine
    Case Else
      Return ""
  End Select

End

' ============================================
' Función   : GenerarMainTeX
' Propósito : Orquesta la generación completa de los archivos LaTeX del libro
'             y escribe el main.tex declarativo.
'
' ORDEN, Y POR QUÉ
'   1. Validar proyecto y libro
'   2. Copiar los recursos de ~/.gbpublisher/latex/ al proyecto
'   3. Leer la lista de piezas declaradas en la base
'   4. Generar los .tex de cada pieza con Saxon y borrar los huérfanos
'   5. Generar preambulo-proyecto.tex y exportar el .bib
'   6. Escribir el main.tex — ÚLTIMO
'
' El main.tex va último porque es lo que DECLARA la existencia de todo lo
' demás, y es el testigo de fecha de la guarda de desactualización. Si algo
' falla antes, se aborta sin escribirlo: el proyecto queda con piezas nuevas y
' sin declarativo —estado detectable— en vez de con un declarativo que promete
' \include de archivos que no existen. Es el criterio de SC-07.
'
' Parámetros: (ninguno — trabaja sobre m_InicioCierre.IdProyectoEnCurso)
' Retorna   : Boolean — True si se escribió el main.tex
' ============================================
Public Function GenerarMainTeX() As Boolean

  Dim hLibro As Result
  Dim hPiezas As Result
  Dim cDeclarados As New Collection
  Dim s As String
  Dim sRutaProyecto As String
  Dim sDirLatex As String
  Dim sNombre As String
  Dim sTipo As String
  Dim sComando As String
  Dim iIdLibro As Integer
  Dim iZona As Integer
  Dim iZonaActual As Integer
  Dim iParteActual As Integer
  Dim i As Integer
  Dim bConsolidada As Boolean
  Dim bHayBibliografia As Boolean
  Dim bHayColofon As Boolean

  ' LOS DATOS DE LAS PIEZAS SE VUELCAN A ARRAYS PARALELOS EN UNA SOLA PASADA.
  ' ASÍ SE RECORREN DOS VECES —UNA PARA GENERAR LOS .tex Y OTRA PARA ARMAR EL
  ' main.tex— SIN DEPENDER DE REPOSICIONAR EL CURSOR DEL Result.
  Dim aNombre As New String[]
  Dim aTipo As New String[]
  Dim aTitulo As New String[]
  Dim aIdParte As New String[]
  Dim aTituloParte As New String[]
  Dim aSubtituloParte As New String[]

  ' --- 1. VALIDACIÓN DE PROYECTO Y LIBRO ---
  If m_InicioCierre.IdProyectoEnCurso = 0 Then
    m_Sonido.sonar("Info")
    Message.Info("Abrí un proyecto antes de generar la salida PDF.")
    Return False
  Endif

  sRutaProyecto = m_InicioCierre.RutaProyectoEnCurso
  sDirLatex = sRutaProyecto &/ CARPETA_LATEX

  Try hLibro = m_ConexionBD.mConn.Exec(
    "SELECT id_libro, lugar_bibliografia FROM libros_md " &
    "WHERE id_proyecto = &1 LIMIT 1", m_InicioCierre.IdProyectoEnCurso)

  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo leer el libro del proyecto:" & gb.NewLine & Error.Text)
    Return False
  Endif

  If Not hLibro.Available Then
    m_Sonido.sonar("Error")
    Message.Error("El proyecto abierto no tiene un libro asociado en la base.")
    Return False
  Endif

  iIdLibro = hLibro["id_libro"]
  bConsolidada = (LCase(Trim(hLibro["lugar_bibliografia"])) = "consolidada")

  ' --- 2. LISTA DE PIEZAS DECLARADAS ---
  ' EL ORDEN SALE DEL NOMBRE DE ARCHIVO Y NO DE UN id: UN id REFLEJA CUÁNDO SE
  ' CARGÓ LA PIEZA, NO DÓNDE VA. LOS CAPÍTULOS NO LLEGAN JUNTOS NI EN ORDEN.
  ' LA NUMERACIÓN DE DOS DÍGITOS HACE QUE EL ORDEN ALFABÉTICO EQUIVALGA AL
  ' NUMÉRICO.
  Try hPiezas = m_ConexionBD.mConn.Exec(
    "SELECT c.nombre_archivo, c.tipo_capitulo, c.titulo_capitulo, c.id_parte, " &
    "       p.titulo AS titulo_parte, p.subtitulo AS subtitulo_parte " &
    "FROM capitulos c " &
    "LEFT JOIN partes_libro p ON p.id_parte = c.id_parte " &
    "WHERE c.id_libro = &1 AND c.nombre_archivo IS NOT NULL " &
    "ORDER BY CASE " &
    "  WHEN c.nombre_archivo LIKE 'fm-%' THEN 1 " &
    "  WHEN c.nombre_archivo LIKE 'a-%'  THEN 2 " &
    "  WHEN c.nombre_archivo LIKE 'bm-%' THEN 3 " &
    "  ELSE 9 END, c.nombre_archivo", iIdLibro)

  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo leer la lista de piezas del libro:" & gb.NewLine &
      Error.Text)
    Return False
  Endif

  If Not hPiezas.Available Then
    m_Sonido.sonar("Error")
    Message.Error("El libro no tiene piezas declaradas.")
    Return False
  Endif

  For Each hPiezas
    aNombre.Add(Trim(hPiezas["nombre_archivo"]))
    aTipo.Add(Trim(hPiezas["tipo_capitulo"]))
    aTitulo.Add(NuloAVacio(hPiezas["titulo_capitulo"]))
    aIdParte.Add(NuloAVacio(hPiezas["id_parte"]))
    aTituloParte.Add(NuloAVacio(hPiezas["titulo_parte"]))
    aSubtituloParte.Add(NuloAVacio(hPiezas["subtitulo_parte"]))
  Next

  ' --- 3. GENERACIÓN DE LOS .tex DE CADA PIEZA ---
  ' LAS PIEZAS SIN CUERPO NO TIENEN CANÓNICO NI .tex: LAS PRODUCE LaTeX.
  For i = 0 To aNombre.Max
    sComando = ComandoGenerado(aTipo[i], aTitulo[i])
    If sComando = "ABORTAR" Then Return False
    If sComando = "" Then
      If Not GenerarTexDePieza(aNombre[i], sRutaProyecto) Then Return False
      cDeclarados["c-" & aNombre[i] & ".tex"] = True
    Endif
  Next

  BorrarTexHuerfanos(sDirLatex, cDeclarados)

  ' --- 4. PREÁMBULO DERIVADO Y BIBLIOGRAFÍA ---
  If Not GenerarPreambuloProyecto() Then Return False
  If Not m_Bibtex.ExportarBibTeX() Then Return False

  ' --- 5. PIEZAS QUE EL GENERADOR NO DEBE DUPLICAR ---
  ' SI EL EDITOR DECLARÓ UNA PIEZA DE BIBLIOGRAFÍA O DE COLOFÓN, ESA
  ' DECLARACIÓN ES LA QUE MANDA Y FIJA DÓNDE VAN. SIN ESTE CHEQUEO SALDRÍAN
  ' DOS VECES.
  bHayBibliografia = False
  bHayColofon = False

  For i = 0 To aTipo.Max
    If LCase(aTipo[i]) = "bibliografia" Then bHayBibliografia = True
    If LCase(aTipo[i]) = "colofon" Then bHayColofon = True
  Next

  ' --- 6. CABECERA DEL main.tex ---
  s = "%%GB:MAIN:1" & gb.NewLine
  s &= "% ============================================================" & gb.NewLine
  s &= "% main.tex — GENERADO POR gbpublisher" & gb.NewLine
  s &= "% ------------------------------------------------------------" & gb.NewLine
  s &= "% ARCHIVO DECLARATIVO. NO CONTIENE TEXTO DEL LIBRO: SOLO" & gb.NewLine
  s &= "% DECLARA QUÉ SE COMPILA Y EN QUÉ ORDEN." & gb.NewLine
  s &= "%" & gb.NewLine
  s &= "% LA LISTA DE PIEZAS SALE DE LA BASE, NO DE UN LISTADO DE LA" & gb.NewLine
  s &= "% CARPETA. UN CANÓNICO QUE ESTÉ EN " & CARPETA_CANONICOS & "/ Y NO" & gb.NewLine
  s &= "% ESTÉ DECLARADO EN EL PROYECTO NO ENTRA." & gb.NewLine
  s &= "%" & gb.NewLine
  s &= "% LOS MARCADORES %%GB: SON CONTRATO CON LOS SCRIPTS EXTERNOS" & gb.NewLine
  s &= "% DE PERSONALIZACIÓN, NO COMENTARIOS DECORATIVOS. %%GB:MAIN:1" & gb.NewLine
  s &= "% ES LA VERSIÓN DEL FORMATO: UN SCRIPT QUE ENTIENDE LA 1 Y" & gb.NewLine
  s &= "% ENCUENTRA UNA 2 DEBE FRENAR EN VEZ DE HACER UN REEMPLAZO A" & gb.NewLine
  s &= "% MEDIAS." & gb.NewLine
  s &= "%" & gb.NewLine
  s &= "% ESTE ARCHIVO Y TODO LO QUE DECLARA SON AUTÓNOMOS: LLEVANDO" & gb.NewLine
  s &= "% LA CARPETA DEL PROYECTO A OTRA MÁQUINA CON TeX Live COMPLETO," & gb.NewLine
  s &= "% Y SIN gbpublisher, COMPILA. NINGUNA RUTA ABSOLUTA, NINGÚN" & gb.NewLine
  s &= "% PAQUETE FUERA DE TeX Live, NINGÚN --shell-escape." & gb.NewLine
  s &= "% ============================================================" & gb.NewLine
  s &= gb.NewLine
  s &= "\\documentclass[twoside,openright]{book}" & gb.NewLine
  s &= gb.NewLine
  s &= "%%GB:PREAMBULO:INICIO" & gb.NewLine
  s &= "\\input{preambulo-proyecto}" & gb.NewLine
  s &= "\\input{preambulo-contrato}" & gb.NewLine
  s &= "\\input{preambulo-estetica}" & gb.NewLine
  s &= "\\input{preambulo-hyperref}" & gb.NewLine
  s &= "%%GB:PREAMBULO:FIN" & gb.NewLine
  s &= gb.NewLine
  s &= "\\gbRequiereContrato{" & CStr(CONTRATO_VERSION) & "}" & gb.NewLine
  s &= gb.NewLine
  s &= "%%GB:SELECCION:INICIO" & gb.NewLine
  s &= "% PARA COMPILAR UNA SOLA PIEZA, DESCOMENTAR Y EDITAR." & gb.NewLine
  s &= "% ATENCIÓN: CON \\includeonly LA PAGINACIÓN Y LAS REFERENCIAS" & gb.NewLine
  s &= "% CRUZADAS SALEN DE LOS .aux EXISTENTES. SI EL LIBRO NUNCA SE" & gb.NewLine
  s &= "% COMPILÓ ENTERO, LOS NÚMEROS ESTÁN MAL." & gb.NewLine
  s &= "% \\includeonly{}" & gb.NewLine
  s &= "%%GB:SELECCION:FIN" & gb.NewLine
  s &= gb.NewLine
  s &= "%%GB:MODO:INICIO" & gb.NewLine
  s &= "% COMPILACIÓN RÁPIDA SIN TOCAR EL PREÁMBULO." & gb.NewLine
  s &= "% \\setkeys{Gin}{draft}" & gb.NewLine
  s &= "% \\overfullrule=5pt" & gb.NewLine
  s &= "%%GB:MODO:FIN" & gb.NewLine
  s &= gb.NewLine
  s &= "\\begin{document}" & gb.NewLine
  s &= gb.NewLine
  s &= "% ============================================================" & gb.NewLine
  s &= "% CONTADORES EN PRELIMINARES Y POSLIMINARES" & gb.NewLine
  s &= "% ------------------------------------------------------------" & gb.NewLine
  s &= "% EN ESAS ZONAS \\chapter NO EJECUTA \\refstepcounter{chapter}," & gb.NewLine
  s &= "% QUE ES LO ÚNICO QUE REINICIA section, footnote, figure, table" & gb.NewLine
  s &= "% Y equation. SIN LOS AJUSTES DE ABAJO, UNA SECCIÓN DE" & gb.NewLine
  s &= "% PRELIMINARES SALE «0.1», UNA DE POSLIMINARES CONTINÚA «1.3»," & gb.NewLine
  s &= "% LA NOTA DE LA SEGUNDA PIEZA ARRANCA EN 2 Y UNA FIGURA DE" & gb.NewLine
  s &= "% POSLIMINARES SALE «Figura 1.2». ES CÓMO ESTÁ ESCRITA LA CLASE" & gb.NewLine
  s &= "% book, NO UN ERROR DEL GENERADOR." & gb.NewLine
  s &= "% ============================================================" & gb.NewLine

  ' --- 7. RECORRIDO DE LAS PIEZAS POR ZONA ---
  iZonaActual = 0
  iParteActual = -1

  For i = 0 To aNombre.Max

    sNombre = aNombre[i]
    sTipo = aTipo[i]
    iZona = ZonaDeTipo(sTipo)
    sComando = ComandoGenerado(sTipo, aTitulo[i])

    ' 7.1 CAMBIO DE ZONA
    If iZona <> iZonaActual Then
      s &= CerrarZona(iZonaActual)
      s &= AbrirZona(iZona)
      iZonaActual = iZona
    Endif

    ' 7.2 APERTURA DE PARTE
    ' LAS PARTES NO SON ARCHIVOS: SON METADATOS DE partes_libro Y NO LLEVAN
    ' TEXTO PROPIO. LAS EMITE EL GENERADOR ANTES DEL PRIMER CAPÍTULO DE CADA
    ' UNA.
    If aIdParte[i] <> "" Then
      If CInt(aIdParte[i]) <> iParteActual Then
        iParteActual = CInt(aIdParte[i])
        s &= gb.NewLine & "\\gbParte{" & EscaparTeX(aTituloParte[i]) & "}{" &
          EscaparTeX(aSubtituloParte[i]) & "}" & gb.NewLine
      Endif
    Endif

    ' 7.3 LA PIEZA
    If sComando <> "" Then
      ' PIEZA SIN CUERPO: LA PRODUCE LaTeX, NO HAY ARCHIVO QUE INCLUIR
      s &= sComando & gb.NewLine
    Else
      ' EN PRELIMINARES Y POSLIMINARES LA NOTA AL PIE SE REINICIA POR PIEZA:
      ' \thefootnote ES ARÁBIGO PELADO Y NO HAY PREFIJO QUE COLISIONE.
      If iZona = ZONA_FRONT Or If iZona = ZONA_BACK Then
        s &= "\\setcounter{footnote}{0}" & gb.NewLine
      Endif

      ' UNA PIEZA DEL CUERPO SIN NUMERAR NECESITA CORTAR EL ARRASTRE DE
      ' CONTADORES Y APAGAR LA NUMERACIÓN DE SECCIONES: SIN ESO SU PRIMERA
      ' SECCIÓN SALE «1.1» Y COLISIONA CON LA DEL CAPÍTULO 1.
      If iZona = ZONA_BODY Then
        If EsPiezaSinNumerar(sTipo) Then
          s &= "\\gbPiezaSinNumerar" & gb.NewLine
        Endif
      Endif

      s &= "\\include{c-" & sNombre & "}" & gb.NewLine
    Endif

  Next

  ' --- 8. CIERRE ---
  ' SI FALTA ALGO QUE VA EN POSLIMINARES Y NO SE DECLARÓ COMO PIEZA, SE ABRE LA
  ' ZONA ACÁ.
  If Not bHayColofon Or If (bConsolidada And Not bHayBibliografia) Then
    If iZonaActual <> ZONA_BACK Then
      s &= CerrarZona(iZonaActual)
      s &= AbrirZona(ZONA_BACK)
      iZonaActual = ZONA_BACK
    Endif
  Endif

  ' BIBLIOGRAFÍA CONSOLIDADA NO DECLARADA COMO PIEZA: VA AL FINAL.
  ' CON bibliografía POR CAPÍTULO NO VA NADA ACÁ: CADA PIEZA ABRE SU refsection
  ' Y EMITE SU PROPIA LISTA.
  If bConsolidada Then
    If Not bHayBibliografia Then
      s &= "\\printbibliography[heading=bibintoc]" & gb.NewLine
    Endif
  Endif

  ' COLOFÓN NO DECLARADO COMO PIEZA: VA SIEMPRE ÚLTIMO.
  If Not bHayColofon Then
    s &= gb.NewLine & "\\begin{gbcolofon}" & gb.NewLine
    s &= "\\gbTextoColofon" & gb.NewLine
    s &= "\\end{gbcolofon}" & gb.NewLine
  Endif

  s &= CerrarZona(iZonaActual)
  s &= gb.NewLine & "\\end{document}" & gb.NewLine

  ' --- 10. ESCRITURA ---
  ' EL main.tex SE ESCRIBE ÚLTIMO: ES LO QUE DECLARA LA EXISTENCIA DE TODO LO
  ' DEMÁS Y EL TESTIGO DE FECHA DE LA GUARDA DE DESACTUALIZACIÓN.
  Try File.Save(sDirLatex &/ "main.tex", s)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo escribir el main.tex:" & gb.NewLine & Error.Text)
    Return False
  Endif

  Return True

End

' ============================================
' Función   : NumeroLatex
' Propósito : Formatea un número decimal con DOS DECIMALES Y PUNTO, sin
'             importar el locale del sistema.
' Parámetros: vValor As Variant — valor numérico leído de un Result
' Retorna   : String — "15.00"
' Nota      : Format() USA EL SEPARADOR DECIMAL DEL LOCALE. EN es_AR ES LA
'             COMA, ASÍ QUE Format(15, "0.00") DEVUELVE "15,00" Y EL PREÁMBULO
'             SALÍA CON \def\gbanchopagina{15,00cm}. geometry LEE ENTONCES
'             paperwidth=15 Y TOMA "00cm" COMO UNA CLAVE DESCONOCIDA:
'               Package keyval Error: 00cm undefined
'             QUE NO DICE NADA SOBRE LA CAUSA.
'             LaTeX SIEMPRE ESPERA PUNTO. ES LA MISMA FAMILIA QUE GV-03:
'             COMPORTAMIENTO DEPENDIENTE DEL ENTORNO EN UNA SALIDA QUE DEBE
'             SER REPRODUCIBLE ENTRE MÁQUINAS.
' ============================================
Private Function NumeroLatex(vValor As Variant) As String

  If IsNull(vValor) Then Return "0.00"
  Return Replace(Format(vValor, "0.00"), ",", ".")

End

' ============================================
' Función   : PrestacionesDeSalida
' Propósito : Deriva las cuatro prestaciones del estado editorial del libro.
'             Se emiten PRESTACIONES y no un «modo»: así agregar un estado
'             nuevo no obliga a tocar el preámbulo, y cada bandera dice qué
'             hace en vez de qué nombre tiene.
' Parámetros: sEstado As String — libros_md.estado_libro
' Retorna   : String[] — cuatro "true"/"false" en el orden
'             showframe, homeoarchy, enlaces, cruces
' ============================================
Private Function PrestacionesDeSalida(sEstado As String) As String[]

  Select Case LCase(Trim(sEstado))
    Case "borrador"
      Return ["true", "true", "true", "false"]
    Case "en_correccion"
      Return ["false", "true", "true", "false"]
    Case "en_produccion"
      Return ["false", "false", "true", "false"]
    Case "publicado"
      Return ["false", "false", "false", "true"]
    Case Else
      ' SIN ESTADO RECONOCIDO SE ASUME PRODUCCIÓN: SIN MARCAS DE TRABAJO
      ' Y SIN CRUCES DE CORTE, QUE ES LO MENOS DESTRUCTIVO.
      Return ["false", "false", "true", "false"]
  End Select

End

