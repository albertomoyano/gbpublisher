# Gambas Form File 3.0

{ Form Form
  Move(0,0,1048,720)
  #Scaled = False
  Text = ("Cuadros del proyecto")
  Arrangement = Arrange.Vertical
  Spacing = True
  Margin = True
  Padding = 4
  { mnuFila Menu
    Text = ("Fila")
    Visible = False
    { mnuFilaArriba Menu
      Text = ("Insertar una fila arriba")
    }
    { mnuFilaAbajo Menu
      Text = ("Insertar una fila abajo")
    }
    { mnuFilaQuitar Menu
      Text = ("Quitar la fila")
    }
    { mnuFilaSep Menu
    }
    { mnuFilaCorte Menu
      Text = ("Cortar el cuadro después de esta fila")
    }
    { mnuFilaBloque Menu
      Text = ("Filete doble después de esta fila")
    }
  }
  { mnuColumna Menu
    Text = ("Columna")
    Visible = False
    { mnuColIzquierda Menu
      Text = ("Insertar una columna a la izquierda")
    }
    { mnuColDerecha Menu
      Text = ("Insertar una columna a la derecha")
    }
    { mnuColQuitar Menu
      Text = ("Quitar la columna")
    }
  }
  { hbxCuerpo HBox
    Move(9,9,1060,600)
