        }
        { btnDuplicar Button
          Move(72,0,36,36)
          ToolTip = ("Duplicar cuadro")
          Picture = Picture["iconos/duplicardocumento.png"]
        }
        { Spring1 Spring
          Move(117,0,36,36)
        }
      }
    }
    { vbxCuadro VBox
