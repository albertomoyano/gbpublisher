' Gambas class file

' ============================================
' Clase     : CEditorialesLibro
' Propósito : Las editoriales de un libro tal como las usan las salidas
'             (esquema 2.2.0, libro_editorial; claude/crossref-libros.md,
'             F1): los nombres en orden y la ciudad de la principal. La arma
'             m_EditorialLibro.Resumen.
'             Clase y no parámetros de salida: en Gambas un primitivo no se
'             puede devolver por parámetro (GV-24).
' ============================================

' LOS NOMBRES EN EL ORDEN DE libro_editorial: EL PRIMERO ES LA PRINCIPAL.
' VACÍO SI EL LIBRO NO TIENE EDITORIAL
Public aNombres As New String[]

' LA CIUDAD DE LA PRINCIPAL: EL LUGAR DE EDICIÓN DEL LIBRO ({ciudad}, \gbciudad
' Y LOS CRÉDITOS DEL EPUB). VACÍA SI NO HAY PRINCIPAL O NO TIENE CIUDAD
Public sCiudad As String

' ============================================
' Función   : Unidos
' Propósito : Los nombres unidos como en la autoría de la ficha: «A», «A y B»,
'             «A, B y C», «A e Ibáñez»
' Parámetros: (ninguno)
' Retorna   : String — "" si el libro no tiene editorial
' ============================================
Public Function Unidos() As String

  Dim sRes As String = ""
  Dim i As Integer

  ' LA MISMA REGLA QUE {autoria} (SC-26): COMAS Y LA CONJUNCIÓN ANTES DEL ÚLTIMO
  For i = 0 To aNombres.Max
    sRes &= m_PrimerasLibro.SeparadorAutoria(i, aNombres.Count, aNombres[i]) & aNombres[i]
  Next

  Return sRes

End
