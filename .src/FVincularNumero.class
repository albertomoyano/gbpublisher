' Gambas class file

' ============================================
' Formulario : FVincularNumero
' Propósito  : Vincula un r-*.md con un número de una revista de la base
'              antes de abrirlo: revista, volumen, número y suplemento. Lo
'              llama m_Numero.PedirVinculo desde AbrirProyectoMD (decisión de
'              Alberto, 25/10: vincular y confirmar siempre). Lo elegido vuelve
'              por m_Numero.cVinculo (RC-GM-13); la decisión, por el valor de
'              Me.Close: 1 vincular, 0 cancelar.
' ============================================

' UNA ENTRADA POR ÍTEM DEL COMBO, EN EL MISMO ORDEN
Private $aIdsRevistas As New Integer[]

' ============================================
' Función   : Form_Show
' Propósito : Aplicar la configuración de botones del marco (SC-20)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub Form_Show()

  m_Ventana.FijarBotones(Me)

End

' ============================================
' Función   : Form_Open
' Propósito : Muestra el archivo y carga las revistas
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub Form_Open()

  Dim rDatos As Result

  ' --- 1. QUÉ SE ESTÁ VINCULANDO ---
  lblArchivoVinculo.Text = "El archivo «" & m_Numero.sArchivoVinculo & "» no está vinculado a ningún número. Elija la revista y su identificación para poder abrirlo."

  ' --- 2. REVISTAS ---
  rDatos = m_Numero.ListarRevistas()
  If rDatos Then
    While rDatos.Available
      cmbRevistaVinculo.Add(rDatos!titulo)
      $aIdsRevistas.Add(rDatos!id_revista)
      rDatos.MoveNext
    Wend
  Endif

  ' --- 3. SIN REVISTAS NO HAY VÍNCULO POSIBLE ---
  If $aIdsRevistas.Count = 0 Then
    lblArchivoVinculo.Text &= gb.NewLine & gb.NewLine & "Todavía no hay revistas cargadas: créela en Administración, pestaña «Revistas»."
    btnVincular.Enabled = False
  Endif

End

' ============================================
' Función   : btnVincular_Click
' Propósito : Valida lo elegido con las reglas del número y lo deja en
'             m_Numero.cVinculo
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnVincular_Click()

  Dim cDatos As New Collection

  ' --- 1. VALORES; UN CAMPO VACÍO NO CREA SU CLAVE (GV-68) Y SE LEE Null ---
  If cmbRevistaVinculo.Index < 0 Then
    cDatos["id_revista"] = 0
  Else
    cDatos["id_revista"] = $aIdsRevistas[cmbRevistaVinculo.Index]
  Endif
  cDatos["volumen"] = Trim(txtVolumenVinculo.Text)
  cDatos["numero"] = Trim(txtNumeroVinculo.Text)
  cDatos["suplemento"] = Trim(txtSuplementoVinculo.Text)

  ' --- 2. LAS MISMAS REGLAS QUE FMetadatosNumero: REVISTA, IDENTIDAD, NO REPETIDO ---
  If Not m_Numero.ValidarNumero(0, cDatos) Then Return

  ' --- 3. RETORNO ---
  m_Numero.cVinculo = cDatos
  Me.Close(1)

End

' ============================================
' Función   : btnCancelarVinculo_Click
' Propósito : No vincula: la apertura se aborta sin crear nada
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnCancelarVinculo_Click()

  Me.Close(0)

End
