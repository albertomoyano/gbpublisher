' Gambas class file

' ============================================
' Clase     : COcurrencia
' Propósito : Registra la aparición de UN código de hallazgo en UN
'             archivo concreto, con su cantidad de repeticiones y su
'             ubicación. Es el nivel más fino del modelo.
'
'             Un hallazgo NO genera una ocurrencia por cada aparición
'             física: genera UNA ocurrencia por archivo, con iVeces
'             como contador. Los 67 títulos envueltos en <bold> de un
'             artículo son una ocurrencia con iVeces = 67, no 67
'             ocurrencias. Sin esto el grid se ahoga y la frecuencia
'             pierde sentido.
' ============================================

' --- 1. IDENTIFICACIÓN DEL ARCHIVO ---
' SE GUARDA EL ID INTERNO ("a1", "a2"), NO LA RUTA: LA RUTA VIVE UNA
' SOLA VEZ EN CArchivoAuditado Y ACÁ SERÍA REDUNDANTE.

Public sIdArchivo As String

' --- 2. CANTIDAD DE APARICIONES EN ESE ARCHIVO ---

Public iVeces As Integer = 1

' --- 3. UBICACIÓN ---
' CONVIVEN DOS TIPOS SEGÚN EL ORIGEN DEL HALLAZGO:
'   - xmllint REPORTA LÍNEA (iLinea > 0, sXPath VACÍO)
'   - Schematron REPORTA XPath (iLinea = 0, sXPath CON VALOR)
' NO SE INTENTA DERIVAR UNA DESDE LA OTRA: SAXON-HE NO EXPONE NINGUNA
' FUNCIÓN DE EXTENSIÓN saxon:, VERIFICADO EMPÍRICAMENTE (SaxonJ-HE 12.9,
' ERROR XPST0017 "Saxon extension functions are not available under
' Saxon-HE"). LA COLUMNA UBICACIÓN MUESTRA LO QUE HAYA.

Public iLinea As Integer = 0
Public sXPath As String


' ============================================
' Función   : Ubicacion
' Propósito : Devuelve la ubicación en el formato que corresponda al
'             origen del hallazgo, para la columna del grid y para el
'             informe.
' Parámetros: ninguno
' Retorna   : String — "línea 23", un XPath, o cadena vacía
' ============================================
Public Function Ubicacion() As String

  ' --- 1. PRIORIDAD AL XPath, QUE ES ESTABLE FRENTE A REFORMATEOS ---
  If sXPath <> "" Then Return sXPath

  ' --- 2. LÍNEA SOLO SI NO HAY XPath (CASO xmllint) ---
  If iLinea > 0 Then Return "línea " & CStr(iLinea)

  Return ""

End
