' Gambas class file

' --- 0. ESTADO LOCAL DEL DIÁLOGO ---
' DISTINGUE CERRAR-APLICANDO DE CERRAR-CANCELANDO (LA X Y btnCerrar CANCELAN)
Private $bAplicado As Boolean = False

' ============================================
' Función   : Form_Open
' Propósito : TOMAR LA COPIA PRÍSTINA Y DEJAR LOS SLIDERS EN NEUTRO.
' ============================================
Public Sub Form_Open()

  ' --- 1. INICIAR EL PATRÓN begin/apply/cancel EN EL MÓDULO ---
  If Not m_GestionImagenes.IniciarBalance() Then
    m_Sonido.sonar("Error")
    Message.Warning(("No hay ninguna imagen cargada."))
    Me.Close()
    Return
  Endif

  ' --- 2. SLIDERS EN NEUTRO ---
  SliderBrillo.Value = 0
  SliderContraste.Value = 0
  SliderGamma.Value = 0

  ' --- 3. INFORME INICIAL ---
  ActualizarInforme()

End

' ============================================
' Función   : ActualizarInforme
' Propósito : MOSTRAR EN lblInforme LOS TRES VALORES ACTUALES.
' ============================================
Private Sub ActualizarInforme()

  lblInforme.Text = ("Brillo: ") & SliderBrillo.Value &
    ("  ·  Contraste: ") & SliderContraste.Value &
    ("  ·  Gamma: ") & SliderGamma.Value

End

' ============================================
' Función   : AplicarPreview
' Propósito : ENVIAR LOS TRES VALORES AL MÓDULO, ESCALADOS DE -100..100 A -1..1.
' ============================================
Private Sub AplicarPreview()

  ' --- 1. ESCALAR Y PREVISUALIZAR ---
  m_GestionImagenes.PreviewBalance(SliderBrillo.Value / 100,
    SliderContraste.Value / 100,
    SliderGamma.Value / 100)

  ' --- 2. REFLEJAR VALORES EN EL INFORME ---
  ActualizarInforme()

End

' ============================================
' Función   : SliderBrillo_Change
' ============================================
Public Sub SliderBrillo_Change()

  AplicarPreview()

End

' ============================================
' Función   : SliderContraste_Change
' ============================================
Public Sub SliderContraste_Change()

  AplicarPreview()

End

' ============================================
' Función   : SliderGamma_Change
' ============================================
Public Sub SliderGamma_Change()

  AplicarPreview()

End

' ============================================
' Función   : btnAplicar_Click
' Propósito : CONFIRMAR EL BALANCE Y CERRAR SIN QUE Form_Close LO DESHAGA.
' ============================================
Public Sub btnAplicar_Click()

  ' --- 1. CONFIRMAR EN EL MÓDULO ---
  m_GestionImagenes.AplicarBalance()

  ' --- 2. MARCAR QUE SE APLICÓ PARA QUE Form_Close NO CANCELE ---
  $bAplicado = True
  Me.Close()

End

' ============================================
' Función   : btnCerrar_Click
' Propósito : CERRAR DESCARTANDO (Form_Close HACE LA CANCELACIÓN EFECTIVA).
' ============================================
Public Sub btnCerrar_Click()

  Me.Close()

End

' ============================================
' Función   : Form_Close
' Propósito : SI NO SE APLICÓ (btnCerrar O LA X), RESTAURAR LA IMAGEN PREVIA.
'             NO LLAMA A Me.Close(): NO HAY RIESGO DE RECURSIÓN.
' ============================================
Public Sub Form_Close()

  If Not $bAplicado Then m_GestionImagenes.CancelarBalance()

End