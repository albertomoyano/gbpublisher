' Gambas module file

' ==============================================================================
' Módulo: m_Constantes
' ------------------------------------------------------------------------------
' Descripción general:
'   Define constantes globales que representan los diferentes tipos de documentos
'   manejados por la aplicación gbpublisher. Estas constantes se utilizan para
'   identificar el tipo de proyecto o archivo que se está procesando (MD o LaTeX).
'
' Objetivo:
'   Centralizar valores fijos para evitar "números mágicos" dentro del código y
'   dar mayor claridad semántica en funciones que requieren distinguir tipos.
'
' Uso típico:
'   If tipo = TIPO_REVISTA_MD Then ...
'   Select tipoLibro
'     Case TIPO_LIBRO_MD
'     Case TIPO_LIBRO_LATEX
'
' ==============================================================================

' ------------------------------------------------------------------------------
' Constante: TIPO_REVISTA_MD
' Valor: 1
' Descripción:
'   Indica que el documento corresponde al tipo "revista" redactado en formato
'   Markdown (.md). Utilizado en la generación de artículos para revistas.
' ------------------------------------------------------------------------------

Public Const TIPO_REVISTA_MD As Integer = 1

' ------------------------------------------------------------------------------
' Constante: TIPO_LIBRO_MD
' Valor: 2
' Descripción:
'   Representa un proyecto de tipo "libro" cuyo contenido fuente está escrito
'   en Markdown (.md). Utilizado en pipelines de conversión y armado de libros.
' ------------------------------------------------------------------------------

Public Const TIPO_LIBRO_MD As Integer = 2

' ------------------------------------------------------------------------------
' Constante: TIPO_LIBRO_LATEX
' Valor: 3
' Descripción:
'   Indica que el documento corresponde a un "libro" cuyo origen está escrito
'   en LaTeX (.tex). Este tipo de proyectos requiere un flujo distinto de
'   compilación, manejo de entornos y generación de PDF.
' ------------------------------------------------------------------------------
Public Const TIPO_LIBRO_LATEX As Integer = 3

' Constantes que determinan que componentes se ven según que tipo de archivo se abra
Public Const ABRIR_PARCIAL_REVISTA As Integer = 4

Public Const ABRIR_PARCIAL_LIBRO As Integer = 5

' ============================================
Public Const MODO_RESULTADOS_NORMAL As Integer = 0
Public Const MODO_RESULTADOS_CROSSREF As Integer = 1
' RESERVADOS PARA FUTURAS ACCIONES: DOAJ, SCIELO, ETC.

Public Const FOOTNOTE_PLACEHOLDER As String = "Texto del footnote aquí"

' --- UMBRALES DE RESOLUCIÓN PARA SEMÁFORO (ANCHO EN PX, CAJA DE 11 cm) ---
Public Const RES_PX_VERDE As Integer = 1300      ' >= 300 DPI @ 11 cm
Public Const RES_PX_AMARILLO As Integer = 650    ' >= 150 DPI @ 11 cm

' --- CALIDAD JPEG AL GUARDAR FIGURAS RETOCADAS (SOLO APLICA A jpg/jpeg) ---
Public Const CALIDAD_JPEG_FIGURA As Integer = 90

' ' LISTA CANÓNICA DE LA FAMILIA IBM PLEX EMBEBIDA EN EL PAQUETE.
' Public Const NO ADMITE ARRAYS: SE DECLARA COMO STRING Y SE PARTE CON Split()
Public Const FUENTES_IBMPLEX As String = "IBMPlexSans-Regular.otf,IBMPlexSans-Bold.otf,IBMPlexSans-Italic.otf,IBMPlexSans-BoldItalic.otf,IBMPlexMono-Regular.otf,IBMPlexMono-Bold.otf,IBMPlexMono-Italic.otf,IBMPlexMono-BoldItalic.otf"

' RUTA RELATIVA AL HOME DEL USUARIO — SE USA TANTO PARA ARMAR LA RUTA
' COMO PARA CREAR EL ÁRBOL NIVEL POR NIVEL
Public Const DIR_FUENTES_USUARIO As String = ".local/share/fonts/gbpublisher"

' NOMBRES DE FAMILIA TAL COMO LOS RESUELVE fontconfig
Public Const FAMILIA_IBMPLEX_SANS As String = "IBM Plex Sans"
Public Const FAMILIA_IBMPLEX_MONO As String = "IBM Plex Mono"

' ==============================================================================
' AUDITOR DE XML JATS EXTERNOS
' ------------------------------------------------------------------------------
' Todas las constantes del auditor llevan prefijo GBA_ para no colisionar con
' el resto del proyecto, y están agrupadas en cuatro bloques:
'
'   1. VOCABULARIO   los valores que clasifican un hallazgo
'   2. RUTAS         dónde viven los recursos
'   3. PARÁMETROS    umbrales y perfiles
'   4. CÓDIGOS       uno por regla, agrupados por capa y en orden
'
' Los valores de texto del vocabulario son los mismos que aparecen como
' atributos en el informe canónico XML, para que el XSLT del informe pueda
' compararlos sin traducción intermedia.
' ==============================================================================

' ==============================================================================
' 1. VOCABULARIO DE CLASIFICACIÓN
' ==============================================================================

' --- IMPACTO: CUATRO NIVELES ---
' 'vacio' es la categoría que ningún validador del mercado reporta y la que más
' valor tiene: el documento procesa perfecto y produce una salida sin artículo.
' Cinco de los diecisiete archivos del corpus de referencia caían acá.
Public Const GBA_IMPACTO_BLOQUEANTE As String = "bloqueante"
Public Const GBA_IMPACTO_VACIO As String = "vacio"
Public Const GBA_IMPACTO_DEGRADANTE As String = "degradante"
Public Const GBA_IMPACTO_REUTILIZACION As String = "reutilizacion"

' --- CORRECCIÓN: QUIÉN LO ARREGLA Y CON CUÁNTO ESFUERZO ---
' Este eje es INDEPENDIENTE del impacto y no un sustituto: el encoding mal
' declarado es corrección automática de cuatro caracteres y a la vez el defecto
' más grave posible, porque el archivo no lo abre ningún parser. Ordenar solo
' por esfuerzo mandaría ese caso al fondo de la lista.
Public Const GBA_CORRECCION_AUTOMATICA As String = "automatica"
Public Const GBA_CORRECCION_EDITORIAL As String = "editorial"
Public Const GBA_CORRECCION_ORIGEN As String = "origen"

' --- ORIGEN: QUÉ CAPA O HERRAMIENTA DETECTÓ EL HALLAZGO ---
Public Const GBA_ORIGEN_IDENTIFICACION As String = "identificacion"
Public Const GBA_ORIGEN_XMLLINT_WF As String = "xmllint-wf"
Public Const GBA_ORIGEN_XMLLINT_DTD As String = "xmllint-dtd"
Public Const GBA_ORIGEN_SCHEMATRON As String = "schematron"
Public Const GBA_ORIGEN_RECURSOS As String = "recursos"
Public Const GBA_ORIGEN_COHERENCIA As String = "coherencia"

' --- CERTEZA ---
' Que el auditor distinga lo que sabe de lo que sospecha es parte de lo que lo
' hace creíble. Los hallazgos heurísticos se muestran con 'Posible' delante.
Public Const GBA_CERTEZA_CIERTO As String = "cierto"
Public Const GBA_CERTEZA_PROBABLE As String = "probable"

' ==============================================================================
' 2. RUTAS
' ==============================================================================

' --- INFRAESTRUCTURA: NO SE COPIA A LA CARPETA DEL USUARIO ---
' Modificar estos recursos invalidaría lo que la aplicación afirma (SC-11).
Public Const GBA_RUTA_SAXON As String = "/opt/Saxon-HE/saxon-he.jar"

' --- CATÁLOGO DE DTD PARA LA VALIDACIÓN DE CAPA C ---
' Encadena los catálogos de las cinco versiones de JATS Publishing presentes en
' el corpus. Lo genera tools-auditor.sh. Se pasa a xmllint por la variable de
' entorno XML_CATALOG_FILES, y con él xmllint resuelve solo el identificador
' público que declara cada archivo: no hay que elegir versión en el código.
Public Const GBA_RUTA_CATALOGO_DTD As String = "/usr/share/gbpublisher/dtd/catalog-auditor.xml"

' --- RECURSOS AJUSTABLES: ORIGINALES EN EL SISTEMA ---
' NO se leen para trabajar: son la referencia inmutable contra la cual se
' compara la copia local para saber si fue modificada (SC-11).
Public Const GBA_RUTA_SISTEMA_CATALOGO As String = "/usr/share/gbpublisher/auditor/mensajes.xml"
Public Const GBA_RUTA_SISTEMA_INFORME_XSL As String = "/usr/share/gbpublisher/auditor/auditoria-html.xsl"

' --- SUBRUTAS DE TRABAJO, RELATIVAS A ~/.gbpublisher ---
' La ruta completa la arman m_AuditarJats.RutaCatalogoMensajes() y
' RutaInformeXsl(), porque una constante no puede llamar a User.Home y Gambas
' no expande la tilde.
Public Const GBA_SUBRUTA_CATALOGO As String = "auditor/mensajes.xml"
Public Const GBA_SUBRUTA_INFORME_XSL As String = "auditor/auditoria-html.xsl"

' ==============================================================================
' 3. PARÁMETROS
' ==============================================================================

' --- PERFIL DE DESTINO POR DEFECTO ---
Public Const GBA_PERFIL_POR_DEFECTO As String = "jats4r-base+crossref"

' --- UMBRAL DE VACÍO ESTRUCTURAL, EN CARACTERES DEL <body> ---
' Se mide en caracteres y no en palabras porque xmllint devuelve
' string-length() como un número corto, sin volcar el cuerpo entero por la
' tubería. Medido sobre el corpus: los artículos reales van de 5.700 a 72.000
' caracteres, y los archivos sin artículo dan exactamente 0.
Public Const GBA_MINIMO_CARACTERES_BODY As Integer = 1000

' --- TIEMPO MÁXIMO POR INVOCACIÓN DE HERRAMIENTA, EN SEGUNDOS ---
' Un XML de un tercero desconocido puede colgar una herramienta. El auditor NO
' puede congelarse: se usa delante de un cliente.
Public Const GBA_TIMEOUT_HERRAMIENTA As Float = 30.0

' ==============================================================================
' 4. CÓDIGOS DE HALLAZGO
'
' Son la interfaz entre el motor y el catálogo de mensajes. Van como constantes
' y no como literales sueltos para que un error de tipeo lo detecte el
' compilador y no aparezca como un hallazgo mudo en el informe.
'
' Agregar una regla nueva: la constante va en el bloque de su capa, en orden.
' ==============================================================================

' --- CAPA A · IDENTIFICACIÓN ---
Public Const GBA_COD_NO_LEGIBLE As String = "GBA-IO-01"
Public Const GBA_COD_ENC_DESFASAJE As String = "GBA-ENC-01"
Public Const GBA_COD_ENC_NO_DECLARADO As String = "GBA-ENC-02"
Public Const GBA_COD_DTD_BORRADOR As String = "GBA-DTD-01"
Public Const GBA_COD_DTD_CONTRADICTORIA As String = "GBA-DTD-02"

' --- CAPA B · BUENA FORMACIÓN ---
Public Const GBA_COD_NO_BIEN_FORMADO As String = "GBA-WF-01"

' --- CAPA C · VALIDEZ CONTRA LA GRAMÁTICA DECLARADA ---
Public Const GBA_COD_INVALIDO As String = "GBA-VAL-01"
Public Const GBA_COD_SIN_GRAMATICA As String = "GBA-VAL-02"
Public Const GBA_COD_GRAMATICA_AUSENTE As String = "GBA-VAL-03"

' --- CAPA D · CONFORMIDAD CON JATS4R ---
Public Const GBA_COD_SIN_ALT_TEXT As String = "GBA-J4R-01"
Public Const GBA_COD_TABLA_IMAGEN As String = "GBA-J4R-02"
Public Const GBA_COD_CITA_SIN_TIPO As String = "GBA-J4R-03"
Public Const GBA_COD_AUTORES_SIN_TIPO As String = "GBA-J4R-04"
Public Const GBA_COD_FUNDING As String = "GBA-J4R-05"

' --- CAPA E · RECURSOS EXTERNOS ---
Public Const GBA_COD_RECURSO_FALTANTE As String = "GBA-RES-01"

' --- CAPA F · COHERENCIA INTERNA ---
Public Const GBA_COD_LICENCIA_DISCORDANTE As String = "GBA-COH-01"
Public Const GBA_COD_NOMBRE_INVERTIDO As String = "GBA-COH-02"
Public Const GBA_COD_FECHAS_IGUALES As String = "GBA-COH-03"
Public Const GBA_COD_IDIOMA_NO_CODIGO As String = "GBA-COH-04"
Public Const GBA_COD_ENTIDAD_DOBLE As String = "GBA-COH-05"
Public Const GBA_COD_REF_SIN_DOI As String = "GBA-COH-06"
Public Const GBA_COD_AFF_SIN_ID As String = "GBA-COH-07"
Public Const GBA_COD_ALT_DECORATIVO As String = "GBA-COH-08"
Public Const GBA_COD_TITULO_INVERTIDO As String = "GBA-COH-09"
Public Const GBA_COD_TABLA_SIN_ALT As String = "GBA-COH-10"

' --- CAPA G · VACÍO ESTRUCTURAL ---
Public Const GBA_COD_BODY_VACIO As String = "GBA-BODY-01"
Public Const GBA_COD_BODY_MINIMO As String = "GBA-BODY-02"
