' ============================================
' Función   : btnGuardarCambiosEditor_Click
' Propósito : Persiste el contenido del editor al archivo abierto, refresca
'             el snapshot de contenido original, extrae las referencias
'             citadas a la base de datos, actualiza el grid de comentarios
'             y deja el foco en el editor para continuar la edición.
' Parámetros: (Evento de botón, sin parámetros)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub btnGuardarCambiosEditor_Click()

  Dim sContenidoActual As String

  ' --- 1. VALIDACIÓN DE ARCHIVO ABIERTO ---
  ' SE REQUIERE UNA RUTA NO VACÍA Y QUE EL ARCHIVO EXISTA EN DISCO
  If sRutaArchivoAbierto = "" Or Not Exist(sRutaArchivoAbierto) Then
    m_Sonido.sonar("Warning")
    Message.Warning("No hay un archivo válido cargado para guardar.")
    Return
  Endif

  ' --- 2. GUARDAR EN DISCO ---
  ' SE CAPTURA EL CONTENIDO UNA SOLA VEZ PARA EVITAR LECTURAS REDUNDANTES
  ' DEL EDITOR EN LOS PASOS POSTERIORES
  sContenidoActual = m_EditorPrincipal.Texto()
  Try File.Save(sRutaArchivoAbierto, sContenidoActual)
  If Error Then
    ' SIN REFRESCO: SI LA ESCRITURA FALLÓ, EL HISTORIAL DE DESHACER ES LO ÚNICO
    ' QUE QUEDA DEL TRABAJO (SC-18)
    m_Sonido.sonar("Error")
    Message.Error("Error al guardar el archivo: " & Error.Text)
    Return
  Endif

  ' --- 3. PUNTO DE REFRESCO 3 DE SC-18 Y PUNTO DE CONTROL ---
  ' EL MARCADO NUEVO SE COLOREA ACÁ. SI EL REFRESCO FALLA, EL ARCHIVO YA ESTÁ
  ' EN DISCO Y EL TEXTO SIGUE EN EL EDITOR: SOLO QUEDA SIN RECOLOREAR (YA INFORMADO)
  m_EditorPrincipal.Refrescar()
  m_EditorPrincipal.MarcarGuardado()

  ' LOS TÍTULOS DE ESTE ARCHIVO SE REHACEN DESDE LO GUARDADO; EL RESTO DEL ÁRBOL NO SE TOCA
  m_Estructura.ActualizarArchivo(sRutaArchivoAbierto, sContenidoActual)

  ' --- 4. EXTRAER REFERENCIAS Y REFRESCAR GRID DE COMENTARIOS ---
  ' SON PROCESOS DE VALOR AGREGADO: SI FALLAN, EL ARCHIVO YA ESTÁ EN DISCO,
  ' POR LO QUE SE INFORMA AL USUARIO PERO NO SE ABORTA LA FUNCIÓN
  Try m_Bibtex.ExtraerYGuardarReferenciasDelEditor(sContenidoActual, sRutaArchivoAbierto)
  If Error Then
    m_Sonido.sonar("Warning")
    Message.Warning("El archivo se guardó, pero falló la extracción de referencias:" & gb.NewLine & Error.Text)
  Endif

  Try m_GestorComentarios.ActualizarGridComentarios(gvComentarios, sContenidoActual)
  If Error Then
    m_Sonido.sonar("Warning")
    Message.Warning("El archivo se guardó, pero falló la actualización del grid de comentarios:" & gb.NewLine & Error.Text)
  Endif

  ' --- 5. FEEDBACK AL USUARIO Y ACTUALIZACIÓN DE CONTADOR DE LÍNEAS ---
  m_Sonido.sonar("Info")
  ActualizarContadorLineas()

  ' --- 6. RESTAURAR FOCO EN EL EDITOR ---
  ' EL CLICK EN EL BOTÓN Y EL Message.Info SUCESIVO QUITAN EL FOCO;
  ' SE DEVUELVE AL EDITOR PARA QUE EL USUARIO PUEDA SEGUIR TIPEANDO
  txtEditorProyecto.SetFocus()

End

