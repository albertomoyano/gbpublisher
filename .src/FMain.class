Public Sub IniciarTimerArchivosXML()

  ' EL TIMER YA EXISTE EN EL DISEÑADOR, SOLO CONFIGURARLO
  hTimerXML.Delay = 5000  ' 5 SEGUNDOS
  hTimerXML.Start()

End

Public Sub TimerTemp_Timer()

  Dim sOutput As String
  Dim Tctl As String = ""
  Dim Tccd1 As String = ""
  Dim Tccd2 As String = ""
  Dim linea As String
  Dim partes As String[]

  ' EJECUTAR SENSORS Y OBTENER TODA LA SALIDA
  sOutput = ""
  Exec ["sensors"] To sOutput

  ' PROCESAR LÍNEA POR LÍNEA
  For Each linea In Split(sOutput, "\n")
    linea = Trim(linea)

    ' BUSCAR TCTL
    If Left(linea, 5) = "Tctl:" And InStr(linea, "+") > 0 Then
      partes = Split(linea, "+")
      If partes.Count > 1 Then
        partes = Split(partes[1], "°")
        If partes.Count > 0 Then
          Tctl = Trim(partes[0])
        Endif
      Endif

      ' BUSCAR TCCD1
    Else If Left(linea, 6) = "Tccd1:" And InStr(linea, "+") > 0 Then
      partes = Split(linea, "+")
      If partes.Count > 1 Then
        partes = Split(partes[1], "°")
        If partes.Count > 0 Then
          Tccd1 = Trim(partes[0])
        Endif
      Endif

      ' BUSCAR TCCD2
    Else If Left(linea, 6) = "Tccd2:" And InStr(linea, "+") > 0 Then
      partes = Split(linea, "+")
      If partes.Count > 1 Then
        partes = Split(partes[1], "°")
        If partes.Count > 0 Then
          Tccd2 = Trim(partes[0])
        Endif
      Endif
    Endif
  Next

End

' EN FMAIN - EVENTO FORM_CLOSE()
Public Sub Form_Close()

  ' MOSTRAR MENSAJE INFORMATIVO
  m_Sonido.sonar("info")
  Message.Info("Para cerrar la aplicación correctamente,\nuse el menú <b>Cerrar el programa</b> o el botón con la <b>X</b> (abajo a la derecha) según corresponda.")

  ' CANCELAR EL CIERRE
  Stop Event

End

Public Sub BtnNuevoBib_Click()
  ' VERIFICAR SI HAY UN PROYECTO ACTIVO

  If Trim(txtProyecto.Text) = "" Then
    m_Sonido.sonar("Info")
    Message.Info("No hay un proyecto en curso. Por favor, abra o cree un proyecto antes de continuar.")
    Return
  Endif

  ' OCULTAR/MOSTRAR BOTONES Y FORZAR REFRESCO INMEDIATO
  BtnNuevoBib.Visible = False
  btnGuardarBib.Visible = True
  btnGuardarCambiosBib.Visible = False
  BtnEliminarBib.Visible = False
  Wait   ' PROCESA EVENTOS PENDIENTES PARA ACTUALIZAR LA INTERFAZ
  ' RESTAURAR EL GRID COMPLETO DEL PROYECTO ANTES DE LA ENTRADA NUEVA.
  ' MostrarEntradasEnGrilla PUDO DEJAR ContenidoBib FILTRADO CON SOLO LOS
  ' DUPLICADOS; IniciarBibtex RECONSULTA WHERE id_proyecto COMPLETO Y
  ' RESIEMBRA LA HUELLA. TAMBIÉN LIMPIA LOS TEXTBOX, POR ESO EL Limpiar DE ABAJO
  ' ES REDUNDANTE PERO SE DEJA POR CLARIDAD DEL FLUJO
  m_Bibtex.IniciarBibtex()
  ' LIMPIAMOS LOS TEXTBOX
  m_Bibtex.LimpiarTextboxBibtex()

  ' ID PROVISORIO: SOLO PARA ARMAR LA CLAVE (btnGenerarClaveBib). EL id REAL
  ' LO DA AUTO_INCREMENT AL GUARDAR, Y SI ES OTRO, m_Bibtex.EscribirEntrada
  ' CORRIGE EL PREFIJO DE LA CLAVE (2.0.0). ANTES ESTE id SE ESCRIBÍA EN LA
  ' FILA Y DOS ALTAS SIMULTÁNEAS CHOCABAN EN LA CLAVE PRIMARIA
  Dim Idn As Integer
  Dim MaxId As Result
  Try MaxId = m_ConexionBD.mConn.Exec("SELECT MAX(id) AS m FROM bibtex")
  If Error Then
    Idn = 0
  Else If IsNull(MaxId["m"]) Then
    Idn = 0
  Else
    Idn = CInt(MaxId["m"]) + 1
  Endif
  id_bibtex.Value = Idn

  ' CONFIGURAR INTERFAZ
  TabPanel5.Index = 1
  txtTMPbiblio.Enabled = True
  txtTMPbiblio.Font = Font["Monospace"]
  txtTMPbiblio.Background = Color.White
  txtTMPbiblio.Clear
  txtTMPbiblio.SetFocus
  TabPanelBibliografia.Index = 0

  ' MODO LLM: CONSULTAR SOLO SI ESTÁ IMPLEMENTADO; SE REPONE EL DE LA SESIÓN ANTERIOR
  ' ASIGNAR Value DISPARA Click SOLO SI CAMBIA (VERIFICADO EN BANCO, 3.19): EL LLENADO DEL COMBO VA APARTE
  rdbConsultar.Enabled = m_LLM.ConsultarDisponible()
  If m_LLM.ModoGuardado() = m_LLM.MODO_CONSULTAR Then
    rdbConsultar.Value = True
  Else
    rdbFormatear.Value = True
  Endif

  ' PROVEEDORES LLM: SE RELEEN CADA VEZ, ASÍ UN .conf O UNA CREDENCIAL NUEVA APARECEN SIN REINICIAR
  m_LLM.LlenarCombo(cmbLLM, ModoLLM())

End

