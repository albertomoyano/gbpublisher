' ============================================
' Función   : btnAbrirDirectorio_Click
' Propósito : Abre el gestor de archivos del proyecto (FFileManager, modal).
'             Al volver, refresca el retocador y el visor de PDF por si se
'             renombró o se borró lo que tenían abierto.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' Nota      : Midnight Commander dejó de estar vinculado a la aplicación
'             (21/11/2026): se usa por fuera para las copias grandes.
' ============================================
Public Sub btnAbrirDirectorio_Click()

  ' --- 1. VALIDACIÓN: PROYECTO ABIERTO ---
  If m_FileManager.RaizProyecto() = "" Then
    m_Sonido.sonar("Warning")
    Message.Warning("No hay un proyecto abierto, o la carpeta del proyecto no está accesible.")
    Return
  Endif

  ' --- 2. GESTOR DE ARCHIVOS ---
  FFileManager.ShowModal()

  ' --- 3. LO QUE FMain TIENE ABIERTO SOBRE ARCHIVOS DEL PROYECTO ---
  ' SE LLAMA SIEMPRE: LAS DOS FUNCIONES COMPARAN LA FIRMA DE SU CARPETA Y NO
  ' TOCAN NADA SI NO CAMBIÓ (SC-27). ASÍ NO DEPENDE DE CÓMO SE CERRÓ EL
  ' FORMULARIO NI DE SI LOS Timer DE FMain CORREN DURANTE ShowModal
  m_GestionImagenes.RefrescarComboSiCambio()
  m_RevisarPDF.RefrescarComboSiCambio()

End

Public Sub gvReferenciasEnCurso_Data(Row As Integer, Column As Integer)

  If m_Bibtex.ContenidoBib <> Null And Row >= 0 And Row < m_Bibtex.ContenidoBib.Count Then
