' ============================================
' Función   : AbrirProyectoMD
' Propósito : Función única para abrir un proyecto Markdown (revista o libro).
'             Centraliza el flujo común y despacha por tipo en los pocos puntos
'             donde el comportamiento difiere (IDs, metadatos, lista de
'             artículos, menú de salidas, configuración de botones).
' Parámetros: iTipoEsperado As Integer — m_Constantes.TIPO_REVISTA_MD o
'             m_Constantes.TIPO_LIBRO_MD; valida que el archivo elegido
'             coincida con el tipo que disparó el menú.
' Retorna   : Boolean — True si el proyecto quedó efectivamente abierto y
'             cargado en el editor; False si la apertura abortó por cualquier
'             motivo (nomenclatura, tipo, BD, lock, archivo ilegible). EL
'             LLAMADOR DEBE RESPETARLO: si es False no puede inicializar los
'             paneles del área de edición, porque describirían un proyecto
'             que no se abrió
'
' CAMBIOS DE ESTA REVISIÓN
' ------------------------
' 1. MIGRACIÓN DE GLOBALES. NombreProyecto y RutaProyecto (públicas de FMain)
'    PASAN A m_InicioCierre.NombreProyectoEnCurso y RutaProyectoEnCurso. EL ID
'    DEL PROYECTO SALE DEL CONTROL id_proyecto.Value Y PASA A
'    m_InicioCierre.IdProyectoEnCurso (RC-GM-16). txtProyecto E id_proyecto
'    SIGUEN EXISTIENDO Y SE SIGUEN ESCRIBIENDO, PERO COMO ESPEJO: LA FUENTE DE
'    VERDAD SON LAS GLOBALES.
'
' 2. PUNTO ÚNICO DE ASIGNACIÓN (APARTADO 9). ANTES LAS GLOBALES SE ASIGNABAN EN
'    EL APARTADO 3, ANTES DE CUATRO Return POSIBLES. CUALQUIER ABORTO DEJABA EL
'    ESTADO PARTIDO: LAS GLOBALES APUNTANDO AL PROYECTO NUEVO QUE NUNCA SE
'    ABRIÓ Y LOS CONTROLES AL VIEJO, QUE SEGUÍA EN EL EDITOR. LOS APARTADOS 3
'    A 8 TRABAJAN AHORA CON EL LOCAL sNombreProyectoNuevo.
'
' 3. LA LIBERACIÓN DEL PROYECTO PREVIO SE MUEVE DEL APARTADO 6 AL 7, O SEA
'    DESPUÉS DE VERIFICAR QUE EL NUEVO SE PUEDE ABRIR. ANTES, SI EL NUEVO
'    ESTABA OCUPADO EN OTRA MÁQUINA (VIEJO 7.3), EL USUARIO SEGUÍA EDITANDO SU
'    PROYECTO ANTERIOR CON EL REGISTRO YA LIBERADO EN BD Y OTRO MAQUETADOR
'    PODÍA ABRIRLO EN PARALELO.
'
' 4. LA LIBERACIÓN PASA A LA FORMA DE SC-07: FILTRA POR usuario_propietario Y
'    NO POR nombre, EN UNA SOLA SENTENCIA. ANTES ERAN DOS Try SEGUIDOS DE UN
'    ÚNICO If Error QUE SOLO EVALUABA EL ÚLTIMO (EL Commit): SI FALLABAN LOS
'    DOS UPDATE, EL AVISO NUNCA APARECÍA (RC-GM-02).
'
' 5. EXENCIÓN NUEVA EN 6.3. SI EL PROYECTO OCUPADO ES EL QUE ESTE USUARIO YA
'    TIENE ABIERTO, SE PERMITE LA REAPERTURA. ES CONSECUENCIA OBLIGADA DEL
'    CAMBIO 3: ANTES SE LIBERABA ANTES DE VERIFICAR Y LA REAPERTURA FUNCIONABA
'    SOLA. LA EXENCIÓN ES ESTRICTA (MISMO PROYECTO QUE EL PREVIO DE ESTA
'    INSTANCIA) Y NO OTORGA NINGÚN PERMISO NUEVO.
'
' 6. Dim sContenidoArchivo MOVIDO AL BLOQUE DE DECLARACIONES.
'
' 7. RENUMERACIÓN: EL VIEJO 7 (VERIFICAR EN BD) ES AHORA EL 6, Y EL VIEJO 6
'    (LIBERAR PREVIO) ES AHORA EL 7. DEL 8 EN ADELANTE LA NUMERACIÓN NO CAMBIA.
' ============================================
Public Sub AbrirProyectoMD(iTipoEsperado As Integer) As Boolean

  Dim iTipoSeleccionado As Integer
  Dim sProyectoPrevio As String
  Dim sSQL As String
  Dim Contenido As Result
  Dim rLast As Result
  Dim nuevoID As Integer
  Dim sContenidoArchivo As String
  Dim sRutaSeleccionada As String
  Dim sMotivoInvalido As String
  Dim sNombreProyectoNuevo As String
  Dim sArchivoBiblio As String

  ' --- 1. CAPTURAR LA RUTA ELEGIDA EN EL DIÁLOGO ---
  sRutaSeleccionada = Dialog.Path
  If sRutaSeleccionada = "" Then Return False

  ' --- 2. CAPTURAR EL PROYECTO PREVIO ---
  ' SE USA PARA LIBERAR EL REGISTRO EN BD (APARTADO 7) Y PARA DETECTAR LA
  ' REAPERTURA DEL MISMO PROYECTO (APARTADO 6.3). SI ES LA PRIMERA APERTURA DE
  ' LA SESIÓN QUEDA VACÍO Y EL BLOQUE DE LIBERACIÓN SE SALTA LIMPIAMENTE
  sProyectoPrevio = m_InicioCierre.NombreProyectoEnCurso

  ' --- 3. DERIVAR LOS DATOS DEL ARCHIVO ELEGIDO (SOLO LOCALES) ---
  ' NO SE TOCA NINGUNA GLOBAL ACÁ: LOS APARTADOS 4 A 8 PUEDEN ABORTAR Y HASTA
  ' QUE EL PROYECTO NUEVO NO ESTÉ EFECTIVAMENTE ABIERTO, EL ESTADO GLOBAL DEBE
  ' SEGUIR DESCRIBIENDO EL PROYECTO QUE REALMENTE HAY EN EL EDITOR
  sNombreProyectoNuevo = File.Name(sRutaSeleccionada)

  ' --- 4. VALIDAR NOMENCLATURA DEL ARCHIVO ELEGIDO ---
  ' LA VALIDACIÓN CORRE SOBRE EL NOMBRE ORIGINAL, SIN LCase: LA CAJA ES PARTE
  ' DE LA NORMA. REGLA DURA, SIN EXCEPCIÓN POR HISTORIAL: UN NOMBRE FUERA DE
  ' NORMA NO SE ABRE AUNQUE YA TENGA REGISTRO EN BD
  sMotivoInvalido = m_FuncionesGenericas.MotivoNombreProyectoInvalido(sNombreProyectoNuevo)
  If sMotivoInvalido <> "" Then
    m_Sonido.sonar("Error")
    Message.Error("El archivo seleccionado no cumple las normas de nomenclatura." & gb.NewLine & gb.NewLine &
      sMotivoInvalido & gb.NewLine & gb.NewLine &
      "Forma obligatoria:" & gb.NewLine &
      "• Revista Markdown: r-CUERPO.md" & gb.NewLine &
      "• Libro Markdown:   l-CUERPO.md" & gb.NewLine &
      "El cuerpo admite A-Z, 0-9 y guion medio, sin guiones dobles" & gb.NewLine &
      "ni guion al principio o al final." & gb.NewLine & gb.NewLine &
      "Ejemplos: l-ALGO.md o r-ALGO-V99-N01.md" & gb.NewLine & gb.NewLine &
      "Archivo recibido: " & sNombreProyectoNuevo)
    Return False
  Endif

  ' EL NOMBRE YA ESTÁ VALIDADO, ASÍ QUE EL PRIMER CARÁCTER ALCANZA PARA
  ' DETERMINAR EL TIPO. SI POR ALGUNA RAZÓN NO MATCHEA, iTipoSeleccionado QUEDA
  ' EN -1 Y EL APARTADO 5 ABORTA
  iTipoSeleccionado = -1
  Select Case String.Mid(sNombreProyectoNuevo, 1, 1)
    Case "l"
      iTipoSeleccionado = m_Constantes.TIPO_LIBRO_MD
    Case "r"
      iTipoSeleccionado = m_Constantes.TIPO_REVISTA_MD
  End Select

  ' --- 5. VERIFICAR QUE EL TIPO DETECTADO COINCIDE CON EL ESPERADO ---
  ' SI EL USUARIO ENTRÓ POR "ABRIR REVISTA" Y ELIGIÓ UN l-*.md, AVISAR Y ABORTAR
  If iTipoSeleccionado <> iTipoEsperado Then
    m_Sonido.sonar("Error")
    Message.Error("El archivo elegido no corresponde al tipo de proyecto solicitado." & gb.NewLine &
      "Se esperaba: " & ObtenerDescripcionTipo(iTipoEsperado) & gb.NewLine &
      "Se encontró: " & ObtenerDescripcionTipo(iTipoSeleccionado))
    Return False
  Endif
  ' --- 6. BUSCAR EL NUEVO PROYECTO EN BD O CREAR REGISTRO NUEVO ---
  ' TODA LA VERIFICACIÓN DEL PROYECTO NUEVO OCURRE ANTES DE TOCAR NADA DEL
  ' PROYECTO ANTERIOR: SI ALGO ACÁ ABORTA, EL USUARIO SE QUEDA EXACTAMENTE
  ' COMO ESTABA, CON SU PROYECTO ABIERTO Y TOMADO EN BD
  sSQL = "SELECT * FROM proyectos WHERE nombre = &1"
  Try Contenido = m_ConexionBD.mConn.Exec(sSQL, sNombreProyectoNuevo)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo consultar la base de datos para verificar el proyecto:" & gb.NewLine &
      Error.Text & gb.NewLine & gb.NewLine &
      "Abortando apertura.")
    Return False
  Endif

  If Contenido.Available Then
    ' VALIDACIONES SOBRE EL REGISTRO EXISTENTE

    ' 6.1 COINCIDENCIA DE TIPO ENTRE ARCHIVO Y BD
    If Contenido["tipo_producto"] <> iTipoSeleccionado Then
      m_Sonido.sonar("Error")
      Message.Error("El tipo de archivo no coincide con el tipo registrado en la base de datos." & gb.NewLine &
        "Se esperaba: " & ObtenerDescripcionTipo(iTipoSeleccionado) & gb.NewLine &
        "Se encontró: " & ObtenerDescripcionTipo(Contenido["tipo_producto"]))
      Return False
    Endif

    ' 6.2 PROYECTO ACTIVO (RC-GM-01: TINYINT(1) ES Boolean EN GAMBAS)
    If Not Contenido["activo"] Then
      m_Sonido.sonar("Warning")
      Message.Warning("El proyecto '" & sNombreProyectoNuevo & "' está archivado." & gb.NewLine &
        "Debe solicitar al editor que lo reactive para poder abrirlo.")
      Return False
    Endif

    ' 6.3 PROYECTO NO OCUPADO EN OTRA MÁQUINA
    ' EXCEPCIÓN: SI EL OCUPADO ES EL PROYECTO QUE ESTA MISMA INSTANCIA YA TIENE
    ' ABIERTO, LO QUE HAY ES UNA REAPERTURA Y NO UN CONFLICTO. EL APARTADO 7 LO
    ' LIBERA Y EL 8 LO VUELVE A TOMAR. LA EXENCIÓN ES ESTRICTA: NO ALCANZA CON
    ' QUE EL PROPIETARIO SEA ESTE USUARIO, TIENE QUE SER EL PROYECTO PREVIO DE
    ' ESTA SESIÓN. IF ANIDADO PORQUE And NO ES SHORT-CIRCUIT (RC-GM-17)
    If Contenido["ocupado"] Then
      If sProyectoPrevio <> sNombreProyectoNuevo Then
        m_Sonido.sonar("Warning")
        Message.Warning("El proyecto '" & sNombreProyectoNuevo & "' está ocupado en otra máquina." & gb.NewLine &
          "Lo puede abrir en modo parcial o espere a que se libere.")
        Return False
      Endif
    Endif

    ' EL REGISTRO EXISTE Y PASÓ LAS TRES VALIDACIONES: SE REUSA SU ID.
    ' ESTAS DOS LÍNEAS VAN FUERA DEL If DE 6.3 PORQUE APLICAN TANTO AL PROYECTO
    ' LIBRE COMO AL CASO DE REAPERTURA EXENTA
    nuevoID = Contenido["id"]
    m_Sonido.sonar("Info")

    ' 6.4 REVISTA: EL r-*.md TIENE QUE ESTAR VINCULADO A UN NÚMERO DE UNA
    ' REVISTA DE LA BASE, Y CADA APERTURA SE CONFIRMA MOSTRANDO CUÁL ES
    ' (DECISIÓN DE ALBERTO, 25/10). UN PROYECTO SIN NÚMERO SE VINCULA ACÁ.
    ' SI SE CANCELA, NO SE TOCÓ NADA DEL PROYECTO ANTERIOR (APARTADO 7)
    If iTipoSeleccionado = m_Constantes.TIPO_REVISTA_MD Then
      If Not m_Numero.ConfirmarOVincular(nuevoID, sNombreProyectoNuevo) Then Return False
    Endif

  Else If iTipoSeleccionado = m_Constantes.TIPO_REVISTA_MD Then

    ' NO EXISTE EN BD Y ES REVISTA: VÍNCULO PRIMERO, Y PROYECTO Y NÚMERO EN UNA
    ' SOLA TRANSACCIÓN (m_Numero). SI SE CANCELA, NO QUEDA NADA CREADO
    nuevoID = m_Numero.RegistrarProyectoConNumero(sNombreProyectoNuevo)
    If nuevoID = 0 Then Return False
    m_Sonido.sonar("Info")
    Message.Info("Proyecto nuevo registrado y vinculado:" & gb.NewLine & gb.NewLine & m_Numero.DescripcionNumero(nuevoID))

  Else

    ' NO EXISTE EN BD: CREAR REGISTRO NUEVO
    Try m_ConexionBD.mConn.Exec(
      "INSERT INTO proyectos (nombre, tipo_producto, usuario_propietario, activo, ocupado) VALUES (&1, &2, &3, 1, 0)",
      sNombreProyectoNuevo, iTipoSeleccionado, m_InicioCierre.UsuarioEnCurso)
    If Error Then
      m_Sonido.sonar("Error")
      Message.Error("No se pudo registrar el nuevo proyecto en la base de datos:" & gb.NewLine &
        Error.Text & gb.NewLine & gb.NewLine &
        "Abortando apertura.")
      Return False
    Endif

    Try rLast = m_ConexionBD.mConn.Exec("SELECT LAST_INSERT_ID()")
    If Error Or If Not rLast.Available Then
      Try m_ConexionBD.mConn.Rollback
      m_Sonido.sonar("Error")
      Message.Error("No se pudo obtener el ID del proyecto insertado." & gb.NewLine &
        "Abortando apertura.")
      Return False
    Endif

    nuevoID = rLast[0]

    Try m_ConexionBD.mConn.Commit
    If Error Then
      m_Sonido.sonar("Error")
      Message.Error("No se pudo confirmar la inserción del proyecto:" & gb.NewLine &
        Error.Text)
      Return False
    Endif

    m_Sonido.sonar("Info")
    Message.Info("Proyecto nuevo registrado en la base de datos.")
  Endif

  ' --- 7. LIBERAR EN BD EL PROYECTO PREVIO, SI HABÍA UNO ---
  ' SE HACE RECIÉN ACÁ: DESPUÉS DEL APARTADO 6 YA SABEMOS QUE EL PROYECTO NUEVO
  ' SE PUEDE ABRIR. SI SE LIBERARA ANTES Y EL 6 ABORTARA, EL USUARIO SEGUIRÍA
  ' EDITANDO UN PROYECTO QUE EN BD FIGURA COMO LIBRE Y OTRO PODRÍA TOMARLO.
  ' EL UPDATE FILTRA POR PROPIETARIO Y NO POR NOMBRE (SC-07): LIBERA LO QUE
  ' ESTE USUARIO TIENE EFECTIVAMENTE TOMADO EN BD, NO LO QUE DIGA UNA VARIABLE.
  ' SI ALGO FALLA, EL PREVIO PUEDE QUEDAR MARCADO COMO OCUPADO, PERO NO IMPIDE
  ' QUE EL FLUJO ACTUAL CONTINÚE: EL NUEVO YA ESTÁ VERIFICADO
  If sProyectoPrevio <> "" Then
    DetenerTimerArchivosProyecto()
    Try m_ConexionBD.mConn.Exec(
      "UPDATE proyectos SET usuario_propietario = NULL, ocupado = 0 " &
      "WHERE usuario_propietario = &1 AND ocupado = 1",
      m_InicioCierre.UsuarioEnCurso)
    If Error Then
      m_Sonido.sonar("Warning")
      Message.Warning("No se pudo liberar el proyecto anterior en la base de datos:" & gb.NewLine &
        Error.Text & gb.NewLine & gb.NewLine &
        "El proyecto '" & sProyectoPrevio & "' puede quedar marcado como ocupado." & gb.NewLine &
        "La apertura del nuevo proyecto continúa.")
    Else
      Try m_ConexionBD.mConn.Commit
    Endif
    m_Timer.DetenerContador()
  Endif

  ' --- 8. INICIALIZAR ESTRUCTURAS Y MARCAR EL PROYECTO COMO OCUPADO ---
  ' SE COMBINA EN UN ÚNICO UPDATE PARA QUE LA OPERACIÓN SEA ATÓMICA
  ' (ANTES SE HACÍAN DOS UPDATES CON DOS COMMITS, INNECESARIO)
  Try m_ConexionBD.mConn.Exec(
    "UPDATE proyectos SET ocupado = 1, usuario_propietario = &1 WHERE id = &2",
    m_InicioCierre.UsuarioEnCurso, nuevoID)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo marcar el proyecto como ocupado:" & gb.NewLine &
      Error.Text & gb.NewLine & gb.NewLine &
      "Abortando apertura.")
    Return False
  Endif

  ' REGISTRAR EL PROYECTO ABIERTO COMO PROYECTO ACTUAL DEL USUARIO.
  ' ES EL ESPEJO PER-USUARIO DEL LOCK (proyectos.ocupado ES PER-PROYECTO;
  ' usuarios.id_proyecto_actual ES PER-USUARIO) Y ES EL DATO QUE ALIMENTA
  ' EL PANEL DE USUARIOS EN LÍNEA. VA EN EL MISMO BLOQUE, ANTES DEL MISMO
  ' Commit, PARA CONFIRMARSE JUNTO A LA TOMA DEL PROYECTO. SI FALLA, NO SE
  ' ABORTA LA APERTURA: EL PROYECTO YA QUEDÓ TOMADO Y EDITABLE; SOLO EL DATO
  ' DEL PANEL QUEDA SIN ACTUALIZAR (Y EL PANEL LO OCULTA IGUAL SI en_linea ES 0)
  Try m_ConexionBD.mConn.Exec(
    "UPDATE usuarios SET id_proyecto_actual = &1 WHERE usuario = &2",
    nuevoID, m_InicioCierre.UsuarioEnCurso)
  If Error Then
    m_Sonido.sonar("Warning")
    Message.Warning("El proyecto se abrió, pero no se pudo registrar como proyecto actual del usuario:" & gb.NewLine &
      Error.Text & gb.NewLine & gb.NewLine &
      "El panel de usuarios en línea podría no mostrar este proyecto.")
  Endif

  Try m_ConexionBD.mConn.Commit

  If Error Then
    m_Sonido.sonar("Warning")
    Message.Warning("No se pudo confirmar el bloqueo del proyecto:" & gb.NewLine &
      Error.Text & gb.NewLine & gb.NewLine &
      "La apertura continúa pero verificá el estado en BD al cerrar.")
  Endif

  ' --- 9. FIJAR EL ESTADO DEL PROYECTO ABIERTO Y LA UI BASE DEL EDITOR ---
  ' EL RESET DE IDs DE ARTÍCULO/CAPÍTULO VA ACÁ Y NO EN EL LLAMADOR: SI CORRE
  ' ANTES, LAS DOCE RUTAS DE ABORTO DE ESTA FUNCIÓN DEJAN AL USUARIO EN SU
  ' PROYECTO ANTERIOR CON LOS IDs YA BORRADOS (RC-GM-16). ADEMÁS NO PUEDE
  ' CORRER ANTES DEL APARTADO 2, QUE LEE NombreProyectoEnCurso COMO PREVIO
  m_InicioCierre.ResetearEstadoDeProyecto()
  m_InicioCierre.NombreProyectoEnCurso = sNombreProyectoNuevo
  m_InicioCierre.RutaProyectoEnCurso = File.Dir(sRutaSeleccionada)
  m_InicioCierre.IdProyectoEnCurso = nuevoID

  txtProyecto.Text = sRutaSeleccionada
  id_proyecto.Value = nuevoID
  txtBuscarPalabra.Text = ""
  tbGoTo.Value = False
  hbGoTo.Visible = False
  vLinea.Text = ""

  HBoxGuardarTextArea.Visible = True
  HBoxBotones.Visible = True
  PanelXML.Visible = True
  SplitterPrincipal.Visible = True
  ' NOTAS: PESTAÑA E INDICADOR DEL PROYECTO RECIÉN ABIERTO (IdProyectoEnCurso
  ' YA FIJADO ARRIBA)
  m_Notas.CambioDeProyecto()

  ' --- 10. LIMPIAR FORMULARIOS ---
  ' (LA LIMPIEZA DE CACHÉ EN ~/.local/share/org.gambas.* ERA RESIDUO DE LA
  ' ETAPA gtk; YA NO APLICA CON qt5 Y LA CARPETA TARGET NO EXISTE)
  m_Bibtex.LimpiarTextboxBibtex()

  ' --- 11. ASEGURAR ARCHIVOS BASE DEL PROYECTO ---
  ' EL TIPO VA COMO PARÁMETRO: EsLibroEnCurso RECIÉN SE FIJA EN EL APARTADO 12
  m_FuncionesGenericas.CopiarArchivosBase_MD(iTipoSeleccionado)

  ' --- 12. ASIGNAR IDs DERIVADOS Y CARGAR SCRIPTS DE MANIPULACIÓN ---
  ' id_proyecto YA QUEDÓ ESCRITO EN EL APARTADO 9. LAS CONSULTAS DERIVADAS LEEN
  ' LA GLOBAL Y NO EL CONTROL (RC-GM-16)
  id_revista.Value = 0
  id_libro.Value = 0
  Select Case iTipoSeleccionado
    Case m_Constantes.TIPO_REVISTA_MD
      id_revista.Value = m_XML.ObtenerIdRevista(m_InicioCierre.IdProyectoEnCurso)
    Case m_Constantes.TIPO_LIBRO_MD
      id_libro.Value = m_XML.ObtenerIdLibro(m_InicioCierre.IdProyectoEnCurso)
  End Select
  ' SIGLAS SOLO EN LIBROS (BOTÓN Y F2): LA GLOBAL Y NO EL CONTROL (RC-GM-16)
  m_InicioCierre.EsLibroEnCurso = (iTipoSeleccionado = m_Constantes.TIPO_LIBRO_MD)
  HabilitarSiglas()
  m_InicioCierre.CargarScripts()

  ' --- 13. CARGAR REFERENCIAS BIBTEX ---
  ' LAS SIGLAS YA NO SE CARGAN AL ABRIR: LA TABLA siglas SE RETIRÓ EN LA 1.18.0
  ' Y EL FORMULARIO NUEVO LEE libro_sigla CUANDO SE ABRE
  m_Bibtex.ConfigurarTableViewBibtexEnCurso(gvReferenciasEnCurso)
  m_Bibtex.IniciarBibtex()
  TimerReferencias.Start()

  ' --- 14. INICIAR CONTADOR Y MODO DE APERTURA COMPLETO ---
  m_Timer.IniciarContadorReloj(m_InicioCierre.IdProyectoEnCurso)
  FMain.ValueBoxParcial.Value = 0

  ' --- 15. CARGAR LISTA DE ARCHIVOS DEL PROYECTO (REVISTAS Y LIBROS) Y COMBOBOXES ---
  ' AMBOS TIPOS USAN LA MISMA ESTRUCTURA front-matter/articulos/back-matter, ASÍ QUE
  ' EL POBLADO INICIAL DEL COMBOBOX APLICA A LOS DOS. NO DELEGAR EL PRIMER POBLADO AL
  ' TIMER: SI EL PROYECTO NO TIENE ARCHIVOS, EL TIMER NO DETECTA CAMBIO DE CANTIDAD Y
  ' EL COMBOBOX QUEDA CON EL PROYECTO ANTERIOR.
  CargarListaArticulosMD()
  IniciarTimerArchivosProyecto()
  m_ComboBox.CargarTodosLosComboBox()
  IniciarTimerArchivosXML()

  ' --- 16. CARGAR EL PRIMER ARCHIVO XML O LIMPIAR EL EDITOR XML ---
  If cmbArchivosXML.Count > 0 Then
    cmbArchivosXML.Index = 0
    cmbArchivosXML_Click()
    txtEditorXML.ReadOnly = True
    txtEditorXML.Enabled = True
  Else
    ' EL VISOR DESCARTA TAMBIÉN EL ANÁLISIS GUARDADO DEL ARCHIVO ANTERIOR
    If $hVisorXML Then
      $hVisorXML.Limpiar()
    Else
      txtEditorXML.Clear()
    Endif
    txtEditorXML.ReadOnly = True
    txtEditorXML.Enabled = False
  Endif

  ' --- 17. CARGAR EL ARCHIVO DEL PROYECTO Y ACTUALIZAR EL SNAPSHOT ---
  ' SI EL ARCHIVO DESAPARECIÓ ENTRE EL Dialog Y ESTE PUNTO (CASO RARO PERO
  ' POSIBLE: BORRADO POR OTRA APP, USB DESCONECTADO, ETC.), ABORTAMOS LA
  ' CARGA DEL EDITOR PERO YA QUEDÓ EL REGISTRO EN BD DEL PROYECTO NUEVO
  Try sContenidoArchivo = File.Load(sRutaSeleccionada)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo cargar el archivo del proyecto:" & gb.NewLine &
      sRutaSeleccionada & gb.NewLine & gb.NewLine &
      Error.Text & gb.NewLine & gb.NewLine &
      "El proyecto quedó registrado en BD pero el editor no se cargó.")
    ' False AUNQUE EL PROYECTO YA ESTÉ TOMADO EN BD Y LAS GLOBALES FIJADAS: NO
    ' HAY CONTENIDO QUE MAQUETAR, Y LOS PANELES DEL ÁREA DE EDICIÓN APUNTANDO A
    ' UN PROYECTO SIN ARCHIVO CARGADO CONFUNDEN MÁS QUE SI QUEDAN OCULTOS
    Return False
  Endif

  ' PUNTO DE REFRESCO 1 DE SC-18; Cargar TOMA TAMBIÉN EL PUNTO DE CONTROL
  If Not m_EditorPrincipal.Cargar(sContenidoArchivo) Then Return False
  txtEditorProyecto.ReadOnly = False
  txtEditorProyecto.Enabled = True
  sRutaArchivoAbierto = sRutaSeleccionada

  ' ÁRBOL DE ESTRUCTURA DEL PROYECTO NUEVO, DESDE LOS ARCHIVOS EN DISCO
  m_Estructura.Construir()

  ' --- 18. ACTUALIZAR GRID DE COMENTARIOS Y CONTADOR DE LÍNEAS ---
  m_GestorComentarios.ActualizarGridComentarios(gvComentarios, m_EditorPrincipal.Texto())
  TabPanelIzquierdaInferior.Visible = False
  ActualizarContadorLineas()
  tbMostrarPanelInferior.Visible = True
  tbMostrarPanelInferior.Value = False

  ' --- 19. CONFIGURAR MENÚ DE SALIDAS Y BOTONES DEL TIPO DE PROYECTO ---
  MenuButtonSalidas.Visible = True
  SpringTemporal.Visible = False
  FMain.Splitter1.Visible = True

  ' EL BOTÓN «Validar» DEL VISOR XML: SIEMPRE, EN LIBROS Y EN REVISTAS. SE
  ' DECIDE CON EL TIPO YA RESUELTO EN EL APARTADO 4, NO MIRANDO OTRA VEZ EL
  ' PREFIJO
  Select Case iTipoSeleccionado
    Case m_Constantes.TIPO_REVISTA_MD
      FMain.MenuButtonSalidas.Menu = "menuSalidaRevistaMD"
      m_FuncionesGenericas.BotonesLibroRevista(True)
      ' menuJats, «Validar» Y LAS SALIDAS DEL NÚMERO
      m_GenerarSalidasRevista.ConfigurarControles()
    Case m_Constantes.TIPO_LIBRO_MD
      FMain.MenuButtonSalidas.Menu = "mnuSalidaLibroMD"
      m_FuncionesGenericas.BotonesLibroRevista(False)
      m_Lanzadora.HabilitarValidacion(True)
  End Select

  ' --- 20. ASEGURAR LA RUTA EN LA TERMINAL ---
  ' SE LEE LA GLOBAL, YA FIJADA EN EL APARTADO 9
  InicializarTerminalProyecto(m_InicioCierre.RutaProyectoEnCurso)

  ' --- 21. CARGAMOS EL EDITOR DE BIBLIOGRAFÍA ---
  ' LA GLOBAL YA ESTÁ FIJADA EN EL APARTADO 9 (RC-GM-16). EL MÓDULO LE AGREGA
  ' POR SU CUENTA LA SUBCARPETA /originales.
  txtEditorHTML.Clear()
  m_EditorHTML.Iniciar(txtEditorHTML, m_InicioCierre.RutaProyectoEnCurso)
  m_EditorHTML.bCargandoLista = True
  cmbArchivosHTML.Clear()

  For Each sArchivoBiblio In m_EditorHTML.ListarArchivos()
    cmbArchivosHTML.Add(sArchivoBiblio)
  Next
  m_EditorHTML.bCargandoLista = False

  ' --- 22. VIGENCIA DE LOS CANÓNICOS (SOLO LIBROS) ---
  ' ¿CORRESPONDEN TODAVÍA A SUS .md Y SUS CUADROS? EL CASO: UN .md QUE VUELVE
  ' DE OTRA MÁQUINA (SC-75). DESPUÉS DEL APARTADO 21, PORQUE EL SCRIPT SE
  ' TIPEA EN LA TERMINAL DEL PROYECTO. EL PROYECTO YA QUEDÓ ABIERTO: UN
  ' RESULTADO MALO SE INFORMA, NO DESHACE LA APERTURA
  If iTipoSeleccionado = m_Constantes.TIPO_LIBRO_MD Then
    m_GenerarSalidasLibro.RevisarVigenciaLibro()
  Endif

  ' --- 23. RETORNO ---
  ' ÚNICA SALIDA CON True: SE LLEGA ACÁ SOLO SI EL PROYECTO QUEDÓ TOMADO EN BD,
  ' LAS GLOBALES FIJADAS Y EL ARCHIVO CARGADO EN EL EDITOR
  Return True

End

Public Sub menuSysAdmin_Click()

  FSysAdmin.ShowModal()

End

' ============================================
' Función   : btnProbar_Click
' Propósito : BANCO DE PRUEBAS EN SECO DEL PATRÓN SOBRE areaEditor
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnProbar_Click()

  m_BuscarRegex.Probar()

End

' ============================================
' Función   : btnBuscarRegex_Click
' Propósito : LANZA LA BÚSQUEDA (Y EL REEMPLAZO) SOBRE LOS ARCHIVOS DEL ÁMBITO
'             EN LA PESTAÑA «RESULTADOS» (tsRegExp, ÍNDICE 1)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnBuscarRegex_Click()

  ' --- GUARD: EL ARCHIVO EN CURSO NO DEBE TENER CAMBIOS SIN GUARDAR ---
  ' perl busca en disco; si el editor tiene cambios pendientes sobre el archivo
  ' en curso, las posiciones no le corresponderían y el reemplazo escribiría en
  ' disco lo que el próximo Ctrl+S pisaría. Es la condición de partida de la
  ' regla de vigencia de m_RegexResultados (SC-51).
  If Not FMain.ConfirmarDescartarCambios() Then Return

  m_BuscarRegex.BuscarRegex()

End

' ============================================
' Función   : gvRegexResultados_Data
' Propósito : PINTA BAJO DEMANDA UNA CELDA DE LA GRILLA VIRTUAL DE RESULTADOS
'             REGEX. EL TEXTO LO DA EL MODELO DE m_RegexResultados; .Data SE
'             TOCA SOLO ACÁ, DENTRO DEL HANDLER DEL EVENTO
' Parámetros: Row As Integer — fila
'             Column As Integer — columna
' Retorna   : nada
' ============================================
Public Sub gvRegexResultados_Data(Row As Integer, Column As Integer)

  gvRegexResultados.Data.Text = m_RegexResultados.TextoCelda(Row, Column)

End

' ============================================
' Función   : gvRegexResultados_Change
' Propósito : ACTUALIZA EL PREVIEW DE LA FILA ACTUAL (MOUSE O FLECHAS, GV-78)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub gvRegexResultados_Change()

  m_RegexResultados.CambioDeFila()

End

' ============================================
' Función   : gvRegexResultados_Click
' Propósito : LLEVA EL EDITOR A LA COINCIDENCIA CLICKEADA. Click Y NO Select
'             (GV-78). EL FOCO QUEDA EN LA GRILLA: EL USUARIO RECORRE
'             RESULTADOS Y ELIGE FILAS PARA REEMPLAZAR, NO ESCRIBE
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub gvRegexResultados_Click()

  m_RegexResultados.IrACoincidencia()

End

' ============================================
' Función   : btnRegexReemplazar_Click
' Propósito : APLICA EL REEMPLAZO A LAS COINCIDENCIAS SELECCIONADAS
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnRegexReemplazar_Click()

  m_RegexResultados.Reemplazar()

  ' EL BOTÓN SE QUEDÓ CON EL FOCO; LA REVISIÓN SIGUE EN LA GRILLA (RC-GM-07)
  gvRegexResultados.SetFocus()

End

' ============================================
' Función   : btnRegexCancelar_Click
' Propósito : CORTA LA BÚSQUEDA REGEX EN CURSO
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnRegexCancelar_Click()

  m_RegexResultados.Cancelar()

End

' ============================================
' Función   : btnRemBuscar_Click
' Propósito : BUSCA EL TÉRMINO LITERAL EN LOS ARCHIVOS DE CONTENIDO
'             (PESTAÑA «REEMPLAZAR», m_BuscarReemplazar)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnRemBuscar_Click()

  Dim iResultados As Integer

  ' LOS TOGGLES NO SON PÚBLICOS: SU VALOR VIAJA POR PARÁMETRO
  iResultados = m_BuscarReemplazar.Buscar(txtRemBuscar.Text, btnRemMayMin.Value, btnRemExacta.Value)

  ' FOCO AL FINAL DEL EVENTO (RC-GM-07): A LA GRILLA SI HAY QUÉ RECORRER,
  ' AL CUADRO SI HAY QUE CORREGIR EL TÉRMINO
  If iResultados > 0 Then
    gvReemplazar.SetFocus()
  Else
    txtRemBuscar.SetFocus()
  Endif

End

' ============================================
' Función   : gvReemplazar_Click
' Propósito : LLEVA EL EDITOR A LA COINCIDENCIA DE LA FILA ELEGIDA. Click Y NO
'             Select: ASIGNAR Row DESDE EL CÓDIGO NO DEBE NAVEGAR (GV-78)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub gvReemplazar_Click()

  m_BuscarReemplazar.IrACoincidencia()

  ' EL Click LLEGA DIFERIDO, DESPUÉS DE QUE LA GRILLA TOMÓ EL FOCO: ESTE
  ' SetFocus GANA (MISMO CASO QUE gvResultados_Click, RC-GM-07)
  txtEditorProyecto.SetFocus()

End

' ============================================
' Función   : btnRemAplicar_Click
' Propósito : REEMPLAZA LA COINCIDENCIA DE LA FILA ELEGIDA
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnRemAplicar_Click()

  m_BuscarReemplazar.Aplicar(txtRemReemplazo.Text)

  ' EL TEXTO NUEVO QUEDA SELECCIONADO EN EL EDITOR (RC-GM-07)
  txtEditorProyecto.SetFocus()

End

' ============================================
' Función   : btnRemAplicarTodo_Click
' Propósito : REEMPLAZA TODAS LAS COINCIDENCIAS DE LA GRILLA
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnRemAplicarTodo_Click()

  m_BuscarReemplazar.AplicarTodo(txtRemReemplazo.Text)

  ' FOCO AL EDITOR AL FINAL DEL EVENTO (RC-GM-07)
  txtEditorProyecto.SetFocus()

End

