' ============================================
' Función   : RespaldarBaseDatos
' Propósito : Respaldo diario de la base local al arrancar la aplicación, en
'             ~/.gbpublisher/respaldo/gbpublisher_AAMMDD.sql. El archivo del
'             día se reemplaza solo por un respaldo COMPLETO: mysqldump tiene
'             que salir con 0 y el archivo, cerrar con «Dump completed». Si
'             no, se avisa y el respaldo anterior queda intacto
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
'
' HISTORIA: HASTA LA 1.34.0 CORTABA EN LA PRIMERA VIEW DE gbWeb (app_user SIN
' SHOW VIEW) Y DEJABA UN ARCHIVO INCOMPLETO, SIN AVISO: SE CORRÍA CON
' Try Shell ... Wait Y NADIE MIRABA EL RESULTADO
' ============================================
Public Sub RespaldarBaseDatos()

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim sHost As String
  Dim sBaseDatos As String = "gbpublisher"
  Dim sRutaRespaldo As String
  Dim sArchivoRespaldo As String
  Dim sTemporal As String
  Dim sRegistro As String
  Dim sMotivo As String
  Dim sCola As String
  Dim hConexion As Connection
  Dim hProceso As Process
  Dim hArchivo As File

  ' EL RESPALDO ES DE LA BASE LOCAL
  sHost = "localhost"

  ' --- 2. SOLO SI LA BASE ES LOCAL Y EXISTE ---
  ' SIN ARCHIVO DE CONEXIÓN NO SE RESPALDA NI SE AVISA ACÁ: EL AVISO LO DA EL
  ' INICIO DE SESIÓN, QUE TAMPOCO PUEDE CONECTAR (SC-106)
  hConexion = New Connection
  If Not m_ConexionBD.PrepararConexion(hConexion, sHost) Then Return
  Try hConexion.Open()
  If Error Then Return
  hConexion.Close()

  ' --- 3. RUTAS ---
  ' EL TEMPORAL VA EN LA MISMA CARPETA QUE EL DESTINO: Move ES UN RENOMBRADO
  ' Y EL ARCHIVO DEL DÍA NUNCA QUEDA A MEDIO ESCRIBIR
  sRutaRespaldo = User.Home &/ ".gbpublisher/respaldo"
  If Not Exist(sRutaRespaldo) Then Try Mkdir sRutaRespaldo
  sArchivoRespaldo = sRutaRespaldo &/ "gbpublisher_" & Format(Now, "yymmdd") & ".sql"
  sTemporal = sArchivoRespaldo & ".parcial"
  sRegistro = Temp$("mysqldump") & ".log"

  ' --- 4. LA CREDENCIAL: EL ARCHIVO DE CONEXIÓN, NO LA LÍNEA DE COMANDOS ---
  ' EN LA LÍNEA DE COMANDOS LA VE CUALQUIER USUARIO EN LA LISTA DE PROCESOS
  ' (SC-101). conexion.conf YA ES UN ARCHIVO DE OPCIONES DE MySQL ([client]
  ' CON user Y password, PERMISOS 600): mysqldump LO LEE DIRECTO, SIN COPIA
  ' TEMPORAL (SC-106)

  ' --- 5. mysqldump ---
  ' --defaults-extra-file    TIENE QUE IR PRIMERO (REGLA DE mysqldump); DE AHÍ
  '                          SALEN EL USUARIO Y LA CONTRASEÑA
  ' --no-tablespaces         EVITA QUE app_user NECESITE EL PRIVILEGIO PROCESS
  ' --skip-lock-tables       EVITA QUE app_user NECESITE EL PRIVILEGIO LOCK TABLES
  ' --single-transaction     UNA FOTO CONSISTENTE DE LAS TABLAS InnoDB
  ' --skip-triggers          A PROPÓSITO: app_user NO TIENE EL PERMISO TRIGGER
  '                          (CON ÉL PODRÍA BORRAR LOS DISPARADORES DE
  '                          articulo_reapertura). TRAS RESTAURAR, SE REPONEN
  '                          CORRIENDO OTRA VEZ actualizar-esquema-1.23.0.sh
  ' --result-file Y --log-error: SIN Shell NI REDIRECCIONES; EL MOTIVO DE UN
  '                          ERROR QUEDA EN EL REGISTRO
  Try hProceso = Exec ["mysqldump", "--defaults-extra-file=" & m_ConexionBD.RutaConexion(),
    "-h", sHost,
    "--no-tablespaces", "--skip-lock-tables", "--single-transaction", "--skip-triggers",
    "--default-character-set=utf8mb4",
    "--result-file=" & sTemporal, "--log-error=" & sRegistro, sBaseDatos] Wait
  If Error Then sMotivo = "no se pudo ejecutar mysqldump: " & Error.Text

  ' --- 6. ¿QUEDÓ COMPLETO? ---
  ' LA SALIDA 0 NO ALCANZA SOLA: SE MIRA TAMBIÉN LA MARCA FINAL DEL ARCHIVO
  If sMotivo = "" Then
    If hProceso.Value <> 0 Then
      sMotivo = "mysqldump terminó con el código " & hProceso.Value
      Try sMotivo &= ":" & gb.NewLine & Trim(File.Load(sRegistro))
    Else If Not Exist(sTemporal) Then
      sMotivo = "mysqldump no escribió el archivo"
    Else
      ' SOLO LAS ÚLTIMAS LÍNEAS: EL ARCHIVO PUEDE PESAR DECENAS DE MEGAS
      Try hArchivo = Open sTemporal For Read
      If Not Error Then
        If Lof(hArchivo) > 200 Then Seek #hArchivo, Lof(hArchivo) - 200
        Try sCola = Read #hArchivo, -200
        Close #hArchivo
      Endif
      If InStr(sCola, "Dump completed") = 0 Then sMotivo = "el archivo quedó incompleto (falta la marca final)"
    Endif
  Endif
  Try Kill sRegistro

  ' --- 7. RESULTADO ---
  If sMotivo <> "" Then
    Try Kill sTemporal
    AvisarRespaldoFallido(sMotivo)
    Return
  Endif

  ' COMPLETO: REEMPLAZA EL DEL DÍA. SOLO LO LEE EL USUARIO: TIENE TODA LA
  ' BASE, INCLUIDAS LAS CLAVES (CIFRADAS) DE usuarios_sistema
  Try Chmod sTemporal To "rw-------"
  Try Kill sArchivoRespaldo
  Try Move sTemporal To sArchivoRespaldo
  If Error Then AvisarRespaldoFallido("no se pudo guardar el archivo: " & Error.Text)

End

' ============================================
' Función   : AvisarRespaldoFallido
' Propósito : Avisa que el respaldo del día no se hizo, y por qué. Es la única
'             forma de que se sepa: antes fallaba en silencio
' Parámetros: sMotivo As String — la causa, para quien da soporte
' Retorna   : (Sub, sin retorno)
' ============================================
Private Sub AvisarRespaldoFallido(sMotivo As String)

  m_Sonido.sonar("Warning")
  Message.Warning("No se pudo hacer el respaldo diario de la base de datos." & gb.NewLine & gb.NewLine &
    "El respaldo anterior quedó como estaba. Si se repite, enviá este mensaje a quien te da soporte:" & gb.NewLine & gb.NewLine &
    sMotivo)

End

