' ============================================
' Función   : Form_Show
' Propósito : APLICAR LA CONFIGURACIÓN DE BOTONES DEL MARCO
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub Form_Show()

  m_Ventana.FijarBotones(Me)

End

Public Sub Form_Open()

  ' ============================================
  ' Función   : Form_Open
  ' Propósito : Inicialización de la interfaz principal tras la aceptación
  '             del aviso legal. Configura shell, relojes, paneles y editores.
  ' Parámetros: (ninguno — evento de formulario)
  ' Retorna   : (nada)
  ' ============================================

  ' --- 1. Configuración de relojes ---
  TimerTemp.Enabled = True
  ' LAS NOTAS YA NO TIENEN RELOJ PROPIO: LAS SONDEA TimerRed (m_Notas)
  TimerHOY.Delay = 1000
  ' EL RELOJ DE HORA SE INICIA DETENIDO; ARRANCA CUANDO EL USUARIO ABRE UN PROYECTO
  TimerHOY.Stop
  TextHoraParcial.Text = "00:00:00"

  ' --- 2. Estado inicial de la interfaz ---
  ' SE ESTABLECE LA VISIBILIDAD Y DISPOSICIÓN DE PANELES ANTES DE MOSTRAR LA VENTANA
  txtEditorProyecto.Visible = True
  PanelXML.Visible = False
  SplitterPrincipal.Visible = False
  SplitterPrincipal.Layout = [1, 1]
  Splitter1.Layout = [1, 1]
  ' ACTUALIZAR TÍTULO
  FMain.Text = Application.Name & "  -  v" & Application.Version

  ' PESTAÑA «Notas»: GRILLA, VISTAS Y LEYENDA. SIN SESIÓN NI PROYECTO QUEDA
  ' VACÍA Y EL INDICADOR DE HBox3 OCULTO (m_Notas)
  m_Notas.InicializarTab()

  ' OCULTAR PANEL INFERIOR IZQUIERDO Y CAMPO DE IR A LÍNEA
  TabPanelIzquierdaInferior.Visible = False
  hbGoTo.Visible = False

  ' --- 4. EDITOR MARKDOWN: TextEdit CON RESALTADO POR HTML (SC-15, SC-18) ---
  ' EL COLOR, EL TEMA Y LA TIPOGRAFÍA LOS PONE m_ResaltadoSintaxis A TRAVÉS DEL
  ' VISOR QUE CREA m_EditorPrincipal. SI FALLA, YA INFORMÓ Y EL EDITOR SIGUE
  ' SIRVIENDO SIN COLOR: NO SE ABORTA EL ARRANQUE
  txtEditorProyecto.Wrap = True
  m_EditorPrincipal.Iniciar(txtEditorProyecto)

  ' ÁRBOL DE ESTRUCTURA (SC-18): SE ARMA AL ABRIR EL PROYECTO; ACÁ SOLO SE
  ' ASOCIA EL CONTROL Y SE TOMAN LOS FILTROS QUE TRAEN LOS RadioButton
  m_Estructura.Iniciar(tvEstructura)
  AplicarFiltroEstructura()

  ' --- 5. VISOR XML CON RESALTADO DE SINTAXIS ---
  ' EL COLOR VA POR HTML (RichText) Y NO POR Format, QUE ENTRA EN LA PILA DE DESHACER.
  ' SI NO SE PUEDE CREAR (FALTA LA CARPETA DE TEMAS), EL VISOR MUESTRA TEXTO PLANO.
  $hVisorXML = m_ResaltadoSintaxis.CrearVisor(txtEditorXML, "xml")
  ' REEMPLAZA LAS ENTRADAS DEL DISEÑADOR POR UNA POR TEMA DISPONIBLE
  m_ResaltadoSintaxis.LlenarMenu(menuTheme)

  ' --- 6. Configuración del grid de comentarios ---
  m_GestorComentarios.ConfigurarGridComentarios(gvComentarios)

  ' --- 7. Aplicar preferencias guardadas del usuario ---
  ' SOBREESCRIBE LOS VALORES POR DEFECTO SI EXISTEN PREFERENCIAS PERSISTIDAS
  LoadFontSettings()

  ' --- 8. FUENTE DEL TERMINAL: EXPLÍCITA, NO HEREDADA ---
  ' SI SE DEJA EN «FUENTE POR DEFECTO», QT SINTETIZA EL BOLD Y SE VE MAL
  TerminalViewProyecto.Font.Name = "IBM Plex Mono"
  TerminalViewProyecto.Font.Size = 12
  TerminalViewProyecto.Background = Color.RGB(45, 30, 20)   ' MARRÓN OSCURO
  TerminalViewProyecto.Foreground = Color.RGB(230, 220, 210)

End

