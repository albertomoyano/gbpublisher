' ============================================
' Función   : btnAgregarImagen_Click
' Propósito : Botón de la barra del editor: inserta una figura
' Parámetros: (ninguno)
' Retorna   : (ninguno)
' ============================================
Public Sub btnAgregarImagen_Click()

  InsertarFigura(False)

End

' ============================================
' Función   : InsertarFigura
' Propósito : Inserta el bloque Markdown de una figura en el editor.
'             Si la imagen seleccionada no reside en /media del proyecto,
'             se copia ahí (con confirmación de sobrescritura).
'             Es el único camino para insertar una figura: lo usan el
'             botón de la barra y el shortcode de figura del panel.
'             Precondición: el proyecto está abierto y /media existe
'             (garantizado al abrir el proyecto).
' Parámetros: bAnchoCompleto As Boolean — agrega .fullwidth (revistas)
' Retorna   : (ninguno)
' ============================================
Public Sub InsertarFigura(bAnchoCompleto As Boolean)

  ' --- 1. Inicialización de variables ---
  Dim sRutaImagen As String
  Dim sNombreArchivo As String
  Dim sRutaMedia As String
  Dim sRutaDestino As String
  Dim sCodigoMarkdown As String
  Dim iRespuesta As Integer

  ' RUTA CANÓNICA DE LA CARPETA /MEDIA DEL PROYECTO, SIN BARRA FINAL.
  ' SE USA TANTO PARA APUNTAR EL DIÁLOGO COMO PARA COMPARAR ORIGEN/DESTINO.
  sRutaMedia = m_InicioCierre.RutaProyectoEnCurso &/ "media"

  ' --- 2. Validación de posición del cursor ---
  ' EL BLOQUE DE FIGURA DEBE INSERTARSE EN UNA LÍNEA PROPIA Y VACÍA,
  ' PARA NO ROMPER PÁRRAFOS NI ESTRUCTURAS MARKDOWN ADYACENTES.
  If Not m_EditorPrincipal.CursorEnLineaVaciaAlInicio() Then
    m_Sonido.sonar("Error")
    Message.Title = "Error de posición."
    Message.Error("No se puede insertar una imagen dentro de una línea o párrafo." & Chr(10) & "El cursor debe estar al inicio de una línea vacía.")
    Return
  Endif

  ' --- 3. Selección de imagen ---
  Dialog.Title = "Seleccionar imagen"
  Dialog.Filter = ["*.png;*.jpg;*.jpeg", "Archivos de imagen (PNG, JPG)", "*", "Todos los archivos"]
  Dialog.Path = sRutaMedia

  ' SI EL USUARIO CANCELA, SALIR SILENCIOSAMENTE.
  If Dialog.OpenFile() Then Return

  sRutaImagen = Dialog.Path
  sNombreArchivo = File.Name(sRutaImagen)
  sRutaDestino = sRutaMedia &/ sNombreArchivo

  ' --- 4. Copia condicional a /media ---
  ' SI LA IMAGEN YA RESIDE EN /MEDIA NO SE COPIA NADA.
  ' SI VIENE DE OTRA UBICACIÓN SE COPIA, CONFIRMANDO ANTES DE SOBRESCRIBIR.
  If File.Dir(sRutaImagen) <> sRutaMedia Then

    If Exist(sRutaDestino) Then
      m_Sonido.sonar("Question")
      iRespuesta = Message.Question("Ya existe una imagen con el nombre '" & sNombreArchivo & "' en la carpeta media." & Chr(10) & "¿Desea sobrescribirla?", "Sí", "No")
      ' EL USUARIO ELIGIÓ "NO" → SE ABORTA LA INSERCIÓN COMPLETA.
      If iRespuesta <> 1 Then Return
    Endif

    Try Copy sRutaImagen To sRutaDestino
    If Error Then
      m_Sonido.sonar("Error")
      Message.Error("No se pudo copiar la imagen: " & Error.Text)
      Return
    Endif

  Endif

  ' --- 5. Construcción del bloque Markdown ---
  ' EL BLOQUE LO ARMA BloqueFigura: ES EL MISMO PARA LA FIGURA DE UN GRÁFICO
  ' (btnDisenarFigura_Click, SC-69)
  sCodigoMarkdown = BloqueFigura(sNombreArchivo, bAnchoCompleto)

  ' --- 6. Inserción y cierre ---
  InsertarCodigoImagen(sCodigoMarkdown)
  txtEditorProyecto.SetFocus

End

' ============================================
' Función   : BloqueFigura
' Propósito : El bloque Markdown de una figura de media/ (SC-32). Lo usan
'             InsertarFigura y la figura de un gráfico (SC-69)
' Parámetros: sNombreArchivo As String — la imagen, con extensión, en media/
'             bAnchoCompleto As Boolean — agrega .fullwidth (revistas)
' Retorna   : String — el bloque, sin salto final
' ============================================
Private Function BloqueFigura(sNombreArchivo As String, bAnchoCompleto As Boolean) As String

  Dim sClases As String
  Dim sAtributos As String
  Dim sCodigo As String

  ' LA CLASE ES .fig, LA QUE RECONOCEN LOS FILTROS DE LIBRO Y DE REVISTA.
  ' EL id SALE DEL NOMBRE DE LA IMAGEN —LAS FIGURAS DE /media LLEVAN EL
  ' PREFIJO fig- (m_GestionImagenes)—: fig-mapa.png DA #fig-mapa, QUE ES
  ' LO QUE SE ESCRIBE PARA REFERIRLA (@fig-mapa). EL PIE ES UN MARCADOR
  ' QUE EL EDITOR REEMPLAZA.
  ' CIERRA CON EL ANCLA NOMBRADA, PRECEDIDA DE LÍNEA EN BLANCO (SC-33)
  sClases = ".fig"
  If bAnchoCompleto Then sClases &= " .fullwidth"

  ' EN UN LIBRO LA APERTURA OFRECE LOS DOS ATRIBUTOS (SC-76):
  '   ancho=100  EL ANCHO DE LA COLUMNA, QUE ES EL DE SIEMPRE: QUEDA A LA
  '              VISTA PARA AJUSTARLO
  '   alt=""     EL TEXTO ALTERNATIVO, OBLIGATORIO. VACÍO Y NO CON UN TEXTO
  '              PROVISORIO: UN alt VACÍO LO SEÑALA gbp-alt AL GENERAR EL
  '              CANÓNICO; UN TEXTO PROVISORIO OLVIDADO SALDRÍA PUBLICADO
  ' EN UNA REVISTA LA APERTURA NO CAMBIA: ancho NO TIENE EFECTO TODAVÍA, Y
  ' CÓMO LLEGA alt AL JATS NO ESTÁ VERIFICADO
  sAtributos = ""
  If TipoProyectoActual = m_Constantes.TIPO_LIBRO_MD Then
    sAtributos = " ancho=100 alt=" & Chr(34) & Chr(34)
  Endif

  sCodigo = "::: {" & sClases & " #" & IdFiguraDesdeArchivo(sNombreArchivo) & sAtributos & "}" & Chr(10)
  sCodigo &= "![" & m_Constantes.FIGURA_PIE_PLACEHOLDER & "](media/" & sNombreArchivo & ")" & Chr(10)
  sCodigo &= Chr(10)
  sCodigo &= m_Shortcodes.AnclaCierre("fig") & Chr(10)
  sCodigo &= ":::"
  Return sCodigo

End

' ============================================
' Función   : IdFiguraDesdeArchivo
' Propósito : Arma el id de una figura a partir del nombre de su imagen:
'             fig-mapa.png → fig-mapa. El nombre se sanea (letras, dígitos
'             y guiones), porque el id va a xml:id, a \label y al id del HTML
' Parámetros: sNombreArchivo As String — nombre de la imagen con extensión
' Retorna   : String — id con el prefijo fig-
' ============================================
Private Function IdFiguraDesdeArchivo(sNombreArchivo As String) As String

  Dim sBase As String

  ' --- 1. SIN EXTENSIÓN Y SIN EL PREFIJO, QUE SE VUELVE A PONER ---
  sBase = File.BaseName(sNombreArchivo)
  If sBase Begins "fig-" Then sBase = String.Mid(sBase, 5)

  ' --- 2. SANEADO: SanearNombreArchivo NUNCA DEVUELVE VACÍO ---
  Return "fig-" & m_FuncionesGenericas.SanearNombreArchivo(sBase)

End

' ============================================================================
' FUNCIÓN AUXILIAR PARA VALIDAR POSICIÓN DEL CURSOR
' ============================================================================
' VERIFICA QUE EL CURSOR ESTÉ EN FMAIN.TXTEDITORPROYECTO EN POSICIÓN VÁLIDA
' RETORNA TRUE SI EL CURSOR ESTÁ AL INICIO DE UNA LÍNEA VACÍA
' ============================================================================

' ============================================================================
' FUNCIÓN AUXILIAR PARA INSERTAR EL CÓDIGO DE IMAGEN
' ============================================================================
' INSERTA EL CÓDIGO MARKDOWN EN LA POSICIÓN ACTUAL DEL CURSOR
' ASEGURANDO LÍNEAS VACÍAS ANTES Y DESPUÉS SI ES NECESARIO
' ============================================================================

' ============================================
' Función   : InsertarCodigoImagen
' Propósito : Inserta el bloque de una figura en el cursor, agregando las
'             líneas en blanco que falten antes y después
' Parámetros: sCodigo As String — bloque Markdown de la figura
' Retorna   : nada
' ============================================
Private Sub InsertarCodigoImagen(sCodigo As String)

  Dim iLinea As Integer
  Dim sInsercion As String

  ' --- 1. LÍNEA DEL CURSOR: Paragraph ES EL EQUIVALENTE DE TextEditor.Line (SC-18) ---
  iLinea = m_EditorPrincipal.ParrafoActual()
  sInsercion = ""

  ' --- 2. LÍNEA ANTERIOR CON TEXTO: HACE FALTA UNA LÍNEA VACÍA ANTES ---
  If iLinea > 0 Then
    If Trim(m_EditorPrincipal.TextoParrafo(iLinea - 1)) <> "" Then sInsercion = gb.NewLine
  Endif

  sInsercion &= sCodigo

  ' --- 3. LÍNEA SIGUIENTE: UNA LÍNEA VACÍA DESPUÉS SI TIENE TEXTO ---
  If iLinea < m_EditorPrincipal.CantidadParrafos() - 1 Then
    If Trim(m_EditorPrincipal.TextoParrafo(iLinea + 1)) <> "" Then
      sInsercion &= gb.NewLine & gb.NewLine
    Else
      sInsercion &= gb.NewLine
    Endif
  Else
    ' ÚLTIMA LÍNEA
    sInsercion &= gb.NewLine
  Endif

  ' --- 4. INSERCIÓN PUNTUAL: CONSERVA EL DESHACER; SI FALLA, EL MÓDULO YA INFORMÓ ---
  m_EditorPrincipal.Insertar(sInsercion)

End

' ============================================
' Función   : vLinea_KeyPress
' Propósito : Lleva el editor a la línea que el usuario escribió en vLinea,
'             con la línea en la primera fila de la vista (GV-52)
' Parámetros: ninguno (usa vLinea.Value, en base 1)
' Retorna   : nada
' ============================================
Public Sub vLinea_KeyPress()

  Dim iLinea As Integer

  ' --- 1. SOLO CON ENTER O RETURN ---
  If Key.Code <> Key.Enter And Key.Code <> Key.Return Then Return

  ' --- 2. VALIDACIÓN: EL USUARIO ESCRIBE EN BASE 1 ---
  iLinea = CInt(vLinea.Value)
  If iLinea < 1 Or iLinea > m_EditorPrincipal.CantidadParrafos() Then
    Message.Info("Línea no disponible")
    Return
  Endif

  ' --- 3. SALTO: REEMPLAZA A GotoCenter, QUE TextEdit NO TIENE ---
  m_EditorPrincipal.IrA(m_EditorPrincipal.PosicionDe(iLinea - 1, 0))
  txtEditorProyecto.SetFocus()

End

' ============================================
' Función   : RecargarArchivoAbierto
' Propósito : RELEE DEL DISCO EL ARCHIVO ABIERTO Y LO DEJA EN EL EDITOR CON SU
'             ÁRBOL, SUS COMENTARIOS Y SU CONTADOR AL DÍA. ES EL CAMINO CUANDO EL
'             DISCO CAMBIÓ POR FUERA DEL EDITOR (REEMPLAZO REGEX, SC-51) O CUANDO
'             EL EDITOR QUEDÓ DISTINTO DEL DISCO DESPUÉS DE «DESCARTAR». NO PASA
'             POR EL COMBO: SU Click SALE SIN HACER NADA SI LA RUTA ES LA DEL
'             ARCHIVO ABIERTO (GV-53). PUNTO DE REFRESCO 2 DE SC-18: CORTA EL
'             DESHACER, Y m_EditorPrincipal.Cargar TOMA EL PUNTO DE CONTROL
' Parámetros: ninguno
' Retorna   : Boolean — True si quedó cargado; False si no había archivo o
'             falló la lectura (YA INFORMADO)
' ============================================
Public Function RecargarArchivoAbierto() As Boolean

  Dim sContenido As String

  ' --- 1. SIN ARCHIVO ABIERTO NO HAY NADA QUE RECARGAR ---
  If sRutaArchivoAbierto = "" Then Return False

  ' --- 2. LEER DEL DISCO ---
  Try sContenido = File.Load(sRutaArchivoAbierto)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo releer el archivo:" & gb.NewLine & sRutaArchivoAbierto & gb.NewLine & Error.Text)
    Return False
  Endif

  ' --- 3. EDITOR: COLOREADO Y PUNTO DE CONTROL ---
  ' SI FALLA, m_EditorPrincipal YA INFORMÓ
  If Not m_EditorPrincipal.Cargar(sContenido) Then Return False

  ' --- 4. LO QUE DEPENDE DEL TEXTO: ÁRBOL, COMENTARIOS Y CONTADOR ---
  ' LO MISMO QUE HACE EL GUARDADO DESPUÉS DE ESCRIBIR (btnGuardarCambiosEditor_Click)
  m_Estructura.ActualizarArchivo(sRutaArchivoAbierto, sContenido)
  Try m_GestorComentarios.ActualizarGridComentarios(gvComentarios, sContenido)
  If Error Then
    m_Sonido.sonar("Warning")
    Message.Warning("El archivo se recargó, pero falló la actualización del grid de comentarios:" & gb.NewLine & Error.Text)
  Endif
  ActualizarContadorLineas()

  Return True

End

' ==============================================================================
' FUNCIÓN: ActualizarContadorLineas
' DESCRIPCIÓN: MUESTRA EL NÚMERO TOTAL DE LÍNEAS DEL DOCUMENTO EN txtLineas.
' ==============================================================================
Public Sub ActualizarContadorLineas()

  txtLineas.Text = CStr(m_EditorPrincipal.CantidadParrafos()) & " líneas"

End

