' ============================================
' Evento    : cmbShortcodes_Click
' Propósito : Al cambiar el tipo de marcado: explica en el rótulo qué es
'             ese tipo y recarga la lista. La ayuda queda vacía porque la
'             selección anterior ya no está en la lista.
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub cmbShortcodes_Click()

  Dim sTipo As String

  ' --- 1. TIPO DE MARCADO DE LA OPCIÓN ---
  If cmbShortcodes.Index < 0 Then Return
  sTipo = m_Shortcodes.TipoDeOpcion(cmbShortcodes.Text)
  If sTipo = "" Then Return

  ' --- 2. RÓTULO Y LISTA ---
  txtDescripcion.Text = m_Shortcodes.DescripcionDeTipo(sTipo)
  m_Shortcodes.CargarShortcodesPorTipo(sTipo, lbDefiniciones)

End

' ============================================
' Evento    : lbDefiniciones_Click
' Propósito : Muestra la ayuda del shortcode elegido; un separador la vacía
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub lbDefiniciones_Click()

  Dim sKey As String

  ' --- 1. KEY DEL ÍTEM ---
  sKey = lbDefiniciones.Key
  If sKey = "" Then Return

  ' --- 2. UN SEPARADOR NO ES UN SHORTCODE ---
  If Not m_Shortcodes.cShortcodesActuales.Exist(sKey) Then
    m_Shortcodes.LimpiarAyuda()
    Return
  Endif

  ' --- 3. AYUDA ---
  m_Shortcodes.RenderizarInfoShortcode(m_Shortcodes.cShortcodesActuales[sKey])

End

' ============================================
' Evento    : lbDefiniciones_Activate
' Propósito : Doble clic o Enter sobre un shortcode: lo inserta en el editor
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub lbDefiniciones_Activate()

  Dim sKey As String

  ' --- 1. KEY DEL ÍTEM ---
  sKey = lbDefiniciones.Key
  If sKey = "" Then Return

  ' --- 2. ACTIVAR UN SEPARADOR NO HACE NADA ---
  If Not m_Shortcodes.cShortcodesActuales.Exist(sKey) Then Return

  ' --- 3. INSERCIÓN ---
  m_Shortcodes.InsertarShortcode(m_Shortcodes.cShortcodesActuales[sKey])

End

