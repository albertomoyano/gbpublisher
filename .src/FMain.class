' ============================================
' Función   : btnBuscar_Click
' Propósito : Busca la siguiente coincidencia; el foco lo decide EjecutarBusqueda
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnBuscar_Click()

  EjecutarBusqueda()

End

' ============================================
' Función   : EjecutarBusqueda
' Propósito : Busca el término en el editor y salta a la primera coincidencia
'             posterior a la referencia; si no hay ninguna más adelante,
'             vuelve a la primera del documento y lo avisa. Marca en la
'             grilla la fila elegida. Cada llamada busca de nuevo sobre el
'             texto actual. Decide el foco final: el editor si hubo salto,
'             para escribir sobre la coincidencia; el cuadro si no lo hubo.
'             La llaman btnBuscar_Click, txtBuscarPalabra_KeyPress, Ctrl+F,
'             F3 en el editor y gvResultados_Click.
' Parámetros: iDesde As Integer — posición desde la que buscar, base 0
'             (opcional). Sin ella, la referencia es el cursor o el inicio
'             de la selección del editor.
' Retorna   : nada
' ============================================
Private Sub EjecutarBusqueda(Optional iDesde As Integer = -1)

  Dim sTermino As String
  Dim sContenido As String
  Dim aTextos As New String[]
  Dim aLineas As String[]
  Dim aInicioLinea As New Integer[]
  Dim iResultados As Integer
  Dim iFila As Integer
  Dim iAcumulado As Integer
  Dim iReferencia As Integer
  Dim iPosCoincidencia As Integer
  Dim iIndice As Integer
  Dim bHaySeleccion As Boolean
  Dim bEncontrada As Boolean
  Dim i As Integer

  ' --- 1. VALIDACIÓN DEL TÉRMINO DE BÚSQUEDA ---
  sTermino = Trim(txtBuscarPalabra.Text)
  If sTermino = "" Then
    m_Sonido.sonar("Warning")
    Message.Warning("Debe ingresar un término de búsqueda.")
    txtBuscarPalabra.SetFocus()
    Return
  Endif

  ' --- 2. LIMPIEZA DE RESULTADOS PREVIOS ---
  ' NO SE CONSERVA NADA DE LA BÚSQUEDA ANTERIOR: SI EL TEXTO SE EDITÓ, SUS
  ' POSICIONES YA NO VALEN (ESE FUE EL DEFECTO DEL BOTÓN «SIGUIENTE» DESCARTADO)
  LimpiarBusqueda()
  ' EL LARGO VA DESPUÉS DE LA LIMPIEZA, QUE LO RESETEA. EN CARACTERES (SC-02, RC-GM-21)
  $iBusqLargoTermino = String.Len(sTermino)

  ' --- 3. OBTENCIÓN DEL CONTENIDO Y DEL PUNTO DE REFERENCIA ---
  sContenido = m_EditorPrincipal.Texto()
  If sContenido = "" Then
    m_Sonido.sonar("Info")
    Message.Info("El editor está vacío.")
    Return
  Endif

  ' FOTO DEL TEXTO: gvResultados_Click LA COMPARA PARA SABER SI LA GRILLA ESTÁ VIEJA
  $sBusqTextoBase = sContenido

  If iDesde >= 0 Then
    ' REFERENCIA EXPLÍCITA (DESDE LA GRILLA): CUENTA UNA COINCIDENCIA QUE EMPIECE AHÍ
    bHaySeleccion = False
    iReferencia = iDesde
  Else
    ' LA REFERENCIA SE LEE ANTES DE CUALQUIER SALTO. SIN SELECCIÓN,
    ' selectionStart() DE QT DEVUELVE LA POSICIÓN DEL CURSOR
    bHaySeleccion = m_EditorPrincipal.HaySeleccion()
    iReferencia = m_EditorPrincipal.InicioSeleccion()
  Endif

  ' --- 4. CONFIGURACIÓN DEL GRIDVIEW ---
  With gvResultados
    .Columns.Count = 2
    .Rows.Count = 0
    .Header = GridView.Horizontal
    .Grid = True
    .Mode = Select.Single
    .Columns[0].Title = "Línea"
    .Columns[0].Width = 100
    .Columns[1].Title = "Coincidencia"
    .Columns[1].Width = 500
  End With

  ' --- 5. INVOCACIÓN DE LA BÚSQUEDA GENÉRICA ---
  ' LOS ARRAYS DEL FORM SE LLENAN POR REFERENCIA; aTextos SOLO ALIMENTA EL GRIDVIEW
  iResultados = m_FuncionesGenericas.BuscarEnTexto(sContenido, sTermino, btnMayMin.Value, btnExacta.Value, $aBusqNumeroLinea, $aBusqPosicionEnLinea, aTextos)

  ' --- 6. VOLCADO DE RESULTADOS AL GRIDVIEW ---
  For i = 0 To iResultados - 1
    iFila = gvResultados.Rows.Count
    gvResultados.Rows.Count = iFila + 1
    gvResultados[iFila, 0].Text = Str($aBusqNumeroLinea[i])
    gvResultados[iFila, 1].Text = aTextos[i]
  Next

  ' --- 7. ACTUALIZACIÓN DEL CONTEO ---
  vConteo.Value = iResultados

  ' --- 8. ELECCIÓN DE LA COINCIDENCIA SIGUIENTE A LA REFERENCIA ---
  ' INICIO ABSOLUTO DE CADA LÍNEA EN UN SOLO RECORRIDO: PosicionDe POR CADA
  ' COINCIDENCIA VOLVERÍA A PARTIR EL TEXTO ENTERO EN CADA LLAMADA
  aLineas = Split(sContenido, Chr(10))
  For i = 0 To aLineas.Max
    aInicioLinea.Add(iAcumulado)
    iAcumulado += String.Len(aLineas[i]) + 1
  Next

  ' SI NINGUNA ESTÁ MÁS ADELANTE, QUEDA 0 Y bEncontrada EN FALSE: RECORRIDO CIRCULAR
  iIndice = 0
  bEncontrada = False
  For i = 0 To iResultados - 1
    ' BuscarEnTexto DEVUELVE LÍNEA Y COLUMNA BASE 1; LAS POSICIONES DEL EDITOR SON BASE 0
    iPosCoincidencia = aInicioLinea[$aBusqNumeroLinea[i] - 1] + $aBusqPosicionEnLinea[i] - 1

    ' CON SELECCIÓN SE EXIGE ESTRICTAMENTE MAYOR: LA SELECCIÓN ES LA COINCIDENCIA
    ' ACTUAL Y HAY QUE PASAR A LA SIGUIENTE. SIN SELECCIÓN, O CON REFERENCIA
    ' EXPLÍCITA, UNA COINCIDENCIA QUE EMPIEZA JUSTO AHÍ CUENTA
    If bHaySeleccion Then
      If iPosCoincidencia > iReferencia Then
        iIndice = i
        bEncontrada = True
        Break
      Endif
    Else
      If iPosCoincidencia >= iReferencia Then
        iIndice = i
        bEncontrada = True
        Break
      Endif
    Endif
  Next

  ' --- 9. RUTAS DE UI SEGÚN CANTIDAD DE RESULTADOS ---
  Select Case iResultados

    Case 0
      ' NO HAY COINCIDENCIAS: AVISAR, OCULTAR EL PANEL Y DEJAR EL FOCO EN EL
      ' CUADRO PARA CORREGIR EL TÉRMINO (RC-GM-07)
      m_Sonido.sonar("Info")
      Message.Info("No se encontraron coincidencias.")
      btnResultados.Value = False
      TabPanelIzquierdaInferior[m_Constantes.PESTANA_INFERIOR_RESULTADOS].Visible = False
      txtBuscarPalabra.SetFocus()

    Case 1
      ' UNA SOLA COINCIDENCIA: IR DIRECTO Y OCULTAR EL PANEL. SIN AVISO DE
      ' VUELTA: CON UNA SOLA, «VOLVER AL INICIO» NO SIGNIFICA NADA
      $iBusqIndiceActual = 0
      IrAResultadoBusqueda(0)
      btnResultados.Value = False
      TabPanelIzquierdaInferior[m_Constantes.PESTANA_INFERIOR_RESULTADOS].Visible = False
      ' FOCO AL EDITOR: SE ESCRIBE DIRECTAMENTE SOBRE LA COINCIDENCIA (RC-GM-07)
      txtEditorProyecto.SetFocus()

    Case Else
      ' VARIAS COINCIDENCIAS: IR A LA SIGUIENTE A LA REFERENCIA Y MOSTRAR LA LISTA
      $iBusqIndiceActual = iIndice
      IrAResultadoBusqueda(iIndice)
      btnResultados.Value = True
      TabPanelIzquierdaInferior[m_Constantes.PESTANA_INFERIOR_RESULTADOS].Visible = True

      ' MARCA EN LA GRILLA LA COINCIDENCIA ACTUAL. ASIGNAR Row EMITE Change Y
      ' Select, NUNCA Click (GV-78): NO HAY SEGUNDO SALTO
      gvResultados.Row = iIndice

      ' NO HABÍA NINGUNA MÁS ADELANTE: SE VOLVIÓ A LA PRIMERA. EL AVISO VA
      ' DESPUÉS DEL SALTO PARA QUE LA SELECCIÓN YA ESTÉ A LA VISTA
      If Not bEncontrada Then
        m_Sonido.sonar("Info")
        Message.Info("Se llegó al final del documento.\nLa búsqueda continúa desde la primera coincidencia.")
      Endif

      ' FOCO AL EDITOR, TAMBIÉN DESPUÉS DEL MODAL: SE ESCRIBE SOBRE LA
      ' COINCIDENCIA Y F3 SIGUE AVANZANDO DESDE AHÍ (RC-GM-07)
      txtEditorProyecto.SetFocus()

  End Select

End

' ============================================
' Función   : txtBuscarPalabra_KeyPress
' Propósito : Enter o F3 en el cuadro lanzan la búsqueda. Si hay salto, el
'             foco pasa al editor: desde ahí se avanza solo con F3
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub txtBuscarPalabra_KeyPress()

  ' DESPUÉS DE ESTO EL FOCO QUEDA EN EL EDITOR: UN SEGUNDO ENTER YA NO
  ' LLEGA ACÁ, Y EN EL EDITOR REEMPLAZARÍA LA COINCIDENCIA SELECCIONADA
  If Key.Code = Key.Return Or Key.Code = Key.F3 Then
    Stop Event  ' LA TECLA NO DEBE LLEGAR AL CONTROL
    EjecutarBusqueda()
  Endif

End

