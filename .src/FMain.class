'             cada palabra en mayúscula, resto en minúscula).
' ============================================
Public Sub btnConvertirMayMin_Click()

  AplicarCapitalizacion()

End

' ============================================
' Función   : AplicarCapitalizacion
' Propósito : Reemplaza la selección del editor por su versión capitalizada,
'             conservando la selección para poder encadenar otra acción.
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub AplicarCapitalizacion()

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim sOriginal As String
  Dim sTransformado As String
  Dim iInicio As Integer
  Dim iLargo As Integer

  ' --- 2. VALIDACIÓN DE ENTRADA: HAY TEXTO SELECCIONADO ---
  If Not m_EditorPrincipal.HaySeleccion() Then
    m_Sonido.sonar("Warning")
    Message.Warning("Debe seleccionar texto para capitalizar.")
    ' RC-GM-07: EL Message REFUERZA LA PÉRDIDA DE FOCO, HAY QUE DEVOLVERLO
    txtEditorProyecto.SetFocus()
    Return
  Endif

  ' --- 3. TRAMO SELECCIONADO ---
  ' Selection.Start ES SIEMPRE EL EXTREMO MENOR, HAYA SIDO HECHA LA SELECCIÓN
  ' HACIA ADELANTE O HACIA ATRÁS: YA NO HACE FALTA COMPARAR LOS DOS EXTREMOS
  sOriginal = m_EditorPrincipal.TextoSeleccionado()
  iInicio = m_EditorPrincipal.InicioSeleccion()
  iLargo = m_EditorPrincipal.LargoSeleccion()

  ' --- 4. TRANSFORMAR Y REEMPLAZAR: CAMBIO PUNTUAL, CONSERVA EL DESHACER ---
  sTransformado = m_FuncionesGenericas.CapitalizarTexto(sOriginal)
  If Not m_EditorPrincipal.ReemplazarTramo(iInicio, iLargo, sTransformado) Then
    txtEditorProyecto.SetFocus()
    Return
  Endif

  ' --- 5. RESELECCIONAR EL TEXTO NUEVO; EL LARGO EN CARACTERES (RC-GM-21) ---
  m_EditorPrincipal.Seleccionar(iInicio, String.Len(sTransformado))

  ' --- 6. RESTAURAR FOCO EN EL EDITOR ---
  txtEditorProyecto.SetFocus()

End

