' ============================================
' Evento    : btnChequearCrossref_Click
' Propósito : Consulta en Crossref el DOI que está en txtDoi y compara sus
'             metadatos con la ficha de bibtex. Muestra la comparación en
'             FEstructuraResultados, desde donde FAplicarCrossRef aplica.
'             La consulta la hace engine/consultar_doi.sh por m_Crossref
'             (modo crossref): acá quedan la base y la interfaz (SC-13).
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub btnChequearCrossref_Click()

  ' --- 1. INICIALIZACIÓN ---
  Dim sDoi As String
  Dim cCrossref As Collection
  Dim sTituloCr As String
  Dim sDoiCr As String
  Dim sAnioCr As String
  Dim sIssnCr As String
  Dim sPaginaCr As String
  Dim sAutorCr As String
  Dim sTituloLocal As String
  Dim sDoiLocal As String
  Dim sAnioLocal As String
  Dim sIssnLocal As String
  Dim sPaginaLocal As String
  Dim sAutorLocal As String
  Dim hLocal As Result
  Dim aResultadosTSV As New String[]
  Dim aColores As New Collection
  Dim cValores As New Collection

  ' --- 2. VALIDAR QUE HAY UN DOI CARGADO ---
  sDoi = Trim(txtDoi.Text)
  If sDoi = "" Then
    m_Sonido.sonar("Error")
    Message.Error("No hay ningún DOI cargado en el campo.")
    Return
  Endif

  ' --- 3. CONSULTAR CROSSREF ---
  ' EL SCRIPT NORMALIZA EL DOI, LO CONTROLA Y DICE EN LA TERMINAL SI NO
  ' EXISTE O SI CROSSREF NO RESPONDE. SI NO SE COMPLETÓ, m_Crossref YA
  ' INFORMÓ POR QUÉ
  cCrossref = m_Crossref.DatosPorDOI(sDoi)
  If IsNull(cCrossref) Then Return

  ' UN DATO QUE CROSSREF NO TIENE NO CREA SU CLAVE: LEERLA DA Null, QUE COMO
  ' String ES "" (GV-98)
  sDoiCr = cCrossref["doi"]
  sTituloCr = cCrossref["titulo"]
  sAnioCr = cCrossref["anio"]
  sPaginaCr = cCrossref["paginas"]
  sIssnCr = cCrossref["issn"]
  sAutorCr = cCrossref["autor"]

  ' --- 4. LEER LOS DATOS LOCALES DE LA BD, POR id_bibtex ---
  sDoiLocal = sDoi
  If id_bibtex.Value > 0 Then
    ' LOS CAMPOS SALEN DE bibtex_campo (2.0.0)
    Try hLocal = m_ConexionBD.mConn.Exec(
      "SELECT " & m_Bibtex.SubconsultaCampo("title") & ", " & m_Bibtex.SubconsultaCampo("author") & ", " &
      m_Bibtex.SubconsultaCampo("editor") & ", " & m_Bibtex.SubconsultaCampo("year") & ", " &
      m_Bibtex.SubconsultaCampo("pages") & ", " & m_Bibtex.SubconsultaCampo("issn") & ", " &
      m_Bibtex.SubconsultaCampo("doi") & " FROM bibtex b WHERE b.id = &1 LIMIT 1",
      CInt(id_bibtex.Value))
    ' If ANIDADO: And NO CORTOCIRCUITA, Y CON LA CONSULTA FALLIDA hLocal ES Null
    If Error Then hLocal = Null
    If Not IsNull(hLocal) Then
      If hLocal.Available Then
        sTituloLocal = If(IsNull(hLocal["title"]), "", Trim(CStr(hLocal["title"])))
        sAnioLocal = If(IsNull(hLocal["year"]), "", Trim(CStr(hLocal["year"])))
        sPaginaLocal = If(IsNull(hLocal["pages"]), "", Trim(CStr(hLocal["pages"])))
        sIssnLocal = If(IsNull(hLocal["issn"]), "", Trim(CStr(hLocal["issn"])))
        ' AUTOR: PRIORIDAD author, FALLBACK editor
        If Not IsNull(hLocal["author"]) And Trim(CStr(hLocal["author"])) <> "" Then
          sAutorLocal = Trim(CStr(hLocal["author"]))
        Else If Not IsNull(hLocal["editor"]) And Trim(CStr(hLocal["editor"])) <> "" Then
          sAutorLocal = Trim(CStr(hLocal["editor"]))
        Endif
      Endif
    Endif
  Endif

  ' --- 5. FILAS DE COMPARACIÓN ---
  ' CADA LLAMADA ACUMULA UNA FILA EN aResultadosTSV Y SUS COLORES EN aColores
  AgregarFilaComparacion("DOI", sDoiLocal, sDoiCr, aResultadosTSV, aColores)
  AgregarFilaComparacion("Título", sTituloLocal, sTituloCr, aResultadosTSV, aColores)
  AgregarFilaComparacion("Año", sAnioLocal, sAnioCr, aResultadosTSV, aColores)
  AgregarFilaComparacion("Páginas", sPaginaLocal, sPaginaCr, aResultadosTSV, aColores)
  AgregarFilaComparacion("ISSN", sIssnLocal, sIssnCr, aResultadosTSV, aColores)
  AgregarFilaComparacion("Primer autor", sAutorLocal, sAutorCr, aResultadosTSV, aColores)

  ' --- 6. CONFIGURAR FEstructuraResultados ---
  ' EL MODO SE FIJA RECIÉN ACÁ: ANTES SE FIJABA AL ENTRAR, Y UNA SALIDA
  ' TEMPRANA LO DEJABA PUESTO PARA EL PRÓXIMO QUE ABRIERA EL FORMULARIO
  FEstructuraResultados.iModo = m_Constantes.MODO_RESULTADOS_CROSSREF
  FEstructuraResultados.blTitulo.Text = "Verificación Crossref — DOI: " & sDoi
  FEstructuraResultados.aResultados = aResultadosTSV
  FEstructuraResultados.aColores = aColores

  ' LA COLLECTION QUE LEE FAplicarCrossRef: CLAVES CANÓNICAS COMPARTIDAS
  ' ENTRE LLAMADOR Y FORMULARIO RECEPTOR
  cValores["titulo"] = sTituloCr
  cValores["autor"] = sAutorCr
  cValores["anio"] = sAnioCr
  cValores["paginas"] = sPaginaCr
  cValores["issn"] = sIssnCr
  cValores["doi"] = sDoiCr
  FEstructuraResultados.cValoresAplicar = cValores

  With FEstructuraResultados.gvResultados
    .Rows.Count = aResultadosTSV.Count
    .Columns.Count = 5
    .ScrollBar = Scroll.Both
    .Resizable = True
    .Header = TableView.Horizontal
    .Columns[0].Title = "Campo"
    .Columns[0].Width = 130
    .Columns[1].Title = "BD local"
    .Columns[1].Width = 365
    .Columns[2].Title = "Crossref"
    .Columns[2].Width = 365
    .Columns[3].Title = "Estado"
    .Columns[3].Width = 80
    .Columns[4].Title = ""
    .Columns[4].Width = 2
  End With

  ' --- 7. MOSTRAR ---
  FEstructuraResultados.gvResultados.Refresh
  m_Sonido.sonar("Info")
  FEstructuraResultados.ShowModal

End Sub

' ============================================
' Función   : AgregarFilaComparacion
' Propósito : Acumula una fila de comparación en los arrays
'             aResultadosTSV y aColores para su posterior
'             renderizado por el evento Data del TableView.
'             Verde = coincide, Amarillo = difiere, Gris = vacío.
' Parámetros: sCampo       As String     — nombre del campo
'             sLocal       As String     — valor de la BD local
'             sCrossref    As String     — valor de Crossref
'             aResultadosTSV As String[] — acumulador de filas TSV
'             aColores     As Collection — acumulador de colores por celda
' ============================================
Private Sub AgregarFilaComparacion(sCampo As String, sLocal As String, sCrossref As String, aResultadosTSV As String[], aColores As Collection)

  ' --- 1. Determinar estado y color de fondo ---
  Dim sLocalNorm As String = LCase(Trim(sLocal))
  Dim sCrossNorm As String = LCase(Trim(sCrossref))
  Dim cFondo As Integer
  Dim sEstado As String

  If sLocal = "" Or sCrossref = "" Then
    cFondo = Color.RGB(240, 240, 240)
    sEstado = "—"
  Else If sLocalNorm = sCrossNorm Then
    cFondo = Color.RGB(232, 245, 233)
    sEstado = "OK"
  Else
    cFondo = Color.SoftYellow
    sEstado = "DIFIERE"
  Endif

  ' --- 2. Acumular fila TSV ---
  Dim iFila As Integer = aResultadosTSV.Count
  aResultadosTSV.Add(sCampo & Chr(9) & sLocal & Chr(9) & sCrossref & Chr(9) & sEstado)

  ' --- 3. Registrar color para todas las columnas de la fila ---
  ' EL COLOR SE APLICA A LAS 4 COLUMNAS DE DATOS (0 A 3)
  Dim j As Integer
  For j = 0 To 3
    aColores[CStr(iFila) & "," & CStr(j)] = cFondo
  Next

End Sub

' ============================================
' Evento    : btnCrossrefTitulo_Click
' Propósito : Busca en Crossref por título y muestra hasta 5 candidatos en
'             FEstructuraResultados, con el tipo de documento y el score de
'             relevancia para que el editor evalúe cada uno.
'             La búsqueda la hace engine/consultar_doi.sh por m_Crossref
'             (modo titulo), con query.bibliographic: query.title, que usaba
'             la versión anterior, está bloqueado en Crossref desde 2019.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub btnCrossrefTitulo_Click()

  ' --- 1. INICIALIZACIÓN ---
  Dim sTitulo As String
  Dim aCandidatos As String[]

  ' --- 2. VALIDAR QUE HAY UN TÍTULO CARGADO ---
  sTitulo = Trim(txtTitle.Text)
  If sTitulo = "" Then
    m_Sonido.sonar("Error")
    Message.Error("No hay ningún título cargado en el campo.")
    Return
  Endif

  ' --- 3. BUSCAR EN CROSSREF ---
  ' SI NO SE COMPLETÓ, m_Crossref YA INFORMÓ POR QUÉ
  aCandidatos = m_Crossref.BuscarPorTitulo(sTitulo)
  If IsNull(aCandidatos) Then Return

  If aCandidatos.Count = 0 Then
    m_Sonido.sonar("Warning")
    Message.Warning("No se encontraron resultados para ese título.")
    Return
  Endif

  ' --- 4. CONFIGURAR FEstructuraResultados ---
  FEstructuraResultados.blTitulo.Text = "Búsqueda en Crossref: " &
    Left(sTitulo, 60) & If(Len(sTitulo) > 60, "...", "")

  ' PASAR LOS DATOS AL FORMULARIO ANTES DE CONFIGURAR EL TABLEVIEW. LOS
  ' COLORES SE VACÍAN: FEstructuraResultados NO LOS REPONE AL CERRAR, Y LOS
  ' DE UNA VERIFICACIÓN ANTERIOR PINTARÍAN ESTAS FILAS
  FEstructuraResultados.aResultados = aCandidatos
  FEstructuraResultados.aColores = New Collection

  With FEstructuraResultados.gvResultados
    .Rows.Count = FEstructuraResultados.aResultados.Count
    .Columns.Count = 8
    .ScrollBar = Scroll.Both
    .Resizable = True
    .Header = TableView.Horizontal
    ' SCORE PRIMERO — INDICA CONFIANZA DE CROSSREF EN EL RESULTADO
    .Columns[0].Title = "Score"
    .Columns[0].Width = 60
    ' TIPO SEGUNDO — PERMITE DESCARTAR RESULTADOS IRRELEVANTES DE INMEDIATO
    .Columns[1].Title = "Tipo"
    .Columns[1].Width = 80
    .Columns[2].Title = "DOI"
    .Columns[2].Width = 220
    .Columns[3].Title = "Título"
    .Columns[3].Width = 290
    .Columns[4].Title = "Año"
    .Columns[4].Width = 50
    .Columns[5].Title = "Primer autor"
    .Columns[5].Width = 140
    .Columns[6].Title = "Revista"
    .Columns[6].Width = 150
    .Columns[7].Title = ""
    .Columns[7].Width = 2
  End With

  ' --- 5. REFRESCAR Y MOSTRAR ---
  ' REFRESH FORZADO PARA QUE EL EVENTO Data SE DISPARE CON LOS NUEVOS DATOS
  FEstructuraResultados.gvResultados.Refresh
  m_Sonido.sonar("Info")
  FEstructuraResultados.ShowModal

End Sub

' ============================================
' Función   : btnDisenarFigura_Click
' Propósito : Abre los gráficos del proyecto (FGraficos) e inserta en el
'             cursor la figura del gráfico elegido (SC-69): una figura común
'             de SC-32, con su PNG de media/
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnDisenarFigura_Click()

  Dim hGraficos As FGraficos
  Dim sId As String

  ' --- 1. LA POSICIÓN: LA FIGURA VA EN UNA LÍNEA VACÍA (COMO InsertarFigura) ---
  If Not m_EditorPrincipal.CursorEnLineaVaciaAlInicio() Then
    Message.Warning("El cursor debe estar al inicio de una línea vacía para insertar la figura.")
    Return
  Endif
  If m_InicioCierre.RutaProyectoEnCurso = "" Then
    m_Sonido.sonar("Info")
    Message.Info("Abrí un proyecto antes de trabajar con los gráficos.")
    Return
  Endif

  ' --- 2. EL FORMULARIO; LO ELEGIDO VUELVE POR m_Graficos (RC-GM-13) ---
  hGraficos = New FGraficos
  If hGraficos.ShowModal() = 1 Then
    sId = m_Graficos.IdElegido()
    ' LA FIGURA NOMBRA EL PNG: EL GRÁFICO EN SÍ ESTÁ EN graficos/ (SC-69)
    If sId <> "" Then InsertarCodigoImagen(BloqueFigura(sId & ".png", False))
  Endif
  txtEditorProyecto.SetFocus()

End

