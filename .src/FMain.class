  Endif

End

' VERIFICA SI HAY NUEVOS ARCHIVOS .MD EN LAS CARPETAS DEL PROYECTO
' RECARGA EL COMBOBOX SOLO SI DETECTA CAMBIOS
Public Sub hTimerRefrescarProyecto_Timer()

  Dim sRutaFrontMatter As String
  Dim sRutaArticulos As String
  Dim sRutaBackMatter As String
  Dim aArchivosFront As String[]
  Dim aArchivosArticulos As String[]
  Dim aArchivosBack As String[]
  Dim iCantidadActual As Integer
  Dim iCantidadNueva As Integer

  ' SI NO HAY PROYECTO ABIERTO, SALIR
  If m_InicioCierre.RutaProyectoEnCurso = "" Then Return

  ' CONSTRUIR RUTAS
  sRutaFrontMatter = m_InicioCierre.RutaProyectoEnCurso &/ "front-matter"
  sRutaArticulos = m_InicioCierre.RutaProyectoEnCurso &/ "articulos"
  sRutaBackMatter = m_InicioCierre.RutaProyectoEnCurso &/ "back-matter"

  ' CONTAR ARCHIVOS ACTUALES EN EL COMBOBOX (MENOS EL ARCHIVO PRINCIPAL)
  iCantidadActual = cmbArticulosRevista.Count - 1

  ' CONTAR ARCHIVOS EN LOS DIRECTORIOS
  iCantidadNueva = 0

  If Exist(sRutaFrontMatter) Then
    aArchivosFront = Dir(sRutaFrontMatter, "*.md")
    If aArchivosFront Then iCantidadNueva += aArchivosFront.Count
  Endif

  If Exist(sRutaArticulos) Then
    aArchivosArticulos = Dir(sRutaArticulos, "*.md")
    If aArchivosArticulos Then iCantidadNueva += aArchivosArticulos.Count
  Endif

  If Exist(sRutaBackMatter) Then
    aArchivosBack = Dir(sRutaBackMatter, "*.md")
    If aArchivosBack Then iCantidadNueva += aArchivosBack.Count
  Endif

  ' SOLO RECARGAR SI LA CANTIDAD DE ARCHIVOS CAMBIÓ
  If iCantidadNueva <> iCantidadActual Then
    CargarListaArticulosMD(True)  ' PRESERVAR LA SELECCIÓN ACTUAL
    ' CAMBIÓ LA LISTA DE ARCHIVOS: EL ÁRBOL SE ARMA DE NUEVO
    m_Estructura.Construir()
  Endif

End

Public Sub hTimerXML_Timer()
  ' REFRESCA LA LISTA DE ARCHIVOS XML SOLO SI HAY CAMBIOS EN EL DIRECTORIO

  Dim sRutaXML As String
  Dim aArchivosActuales As String[]
  Dim aArchivosCombo As String[]
  Dim sSeleccionActual As String
  Dim i As Integer

  ' CONSTRUIR RUTA A LA CARPETA XML
  sRutaXML = m_InicioCierre.RutaProyectoEnCurso &/ "jats"

  ' VERIFICAR QUE EL DIRECTORIO EXISTE
  If Not IsDir(sRutaXML) Then
    Return
  Endif

  ' OBTENER LISTA ACTUAL DE ARCHIVOS EN DISCO
  aArchivosActuales = Dir(sRutaXML, "*.xml")
  aArchivosActuales.Sort()

  ' OBTENER LISTA ACTUAL DEL COMBOBOX
  aArchivosCombo = New String[]
  For i = 0 To cmbArchivosXML.Count - 1
    aArchivosCombo.Add(cmbArchivosXML[i].Text)
  Next

  ' COMPARAR SI HAY DIFERENCIAS
  If aArchivosActuales.Count = aArchivosCombo.Count Then
    Dim bIguales As Boolean = True
    For i = 0 To aArchivosActuales.Count - 1
      If aArchivosActuales[i] <> aArchivosCombo[i] Then
        bIguales = False
        Break
      Endif
    Next
    If bIguales Then Return  ' NO HAY CAMBIOS, SALIR SIN REFRESCAR
  Endif

  ' GUARDAR LA SELECCIÓN ACTUAL
  If cmbArchivosXML.Index >= 0 Then
    sSeleccionActual = cmbArchivosXML.Text
  Endif

  ' RECARGAR LA LISTA
  m_ComboBox.CargarListaArchivosXML()

  ' RESTAURAR LA SELECCIÓN SI EL ARCHIVO AÚN EXISTE
  If sSeleccionActual <> "" Then
    For i = 0 To cmbArchivosXML.Count - 1
      If cmbArchivosXML[i].Text = sSeleccionActual Then
        cmbArchivosXML.Index = i
        Return
      Endif
    Next
  Endif

End

' ARRAYS PARALELOS PARA ALMACENAR LAS COINCIDENCIAS DE BÚSQUEDA
Private $aBusqNumeroLinea As New Integer[]    ' NÚMERO DE LÍNEA (BASE 1)
Private $aBusqPosicionEnLinea As New Integer[] ' POSICIÓN DENTRO DE LA LÍNEA

' ÍNDICE DE LA COINCIDENCIA ACTUAL: LA FILA MARCADA EN LA GRILLA
Private $iBusqIndiceActual As Integer

' TEXTO SOBRE EL QUE SE HIZO LA ÚLTIMA BÚSQUEDA. SI EL EDITOR YA NO COINCIDE,
' LAS POSICIONES DE LA GRILLA ESTÁN VIEJAS Y gvResultados_Click BUSCA DE NUEVO
Private $sBusqTextoBase As String

' ============================================================================
' LIMPIARBUSQUEDA - LIMPIA LOS ARRAYS Y RESETEA EL ÍNDICE
' ============================================================================
Private Sub LimpiarBusqueda()

  $aBusqNumeroLinea.Clear()
  $aBusqPosicionEnLinea.Clear()
  $iBusqIndiceActual = 0
  gvResultados.Rows.Count = 0
  vConteo.Value = 0

  ' EL LARGO DEL TÉRMINO ES PARTE DEL ESTADO DE LA BÚSQUEDA Y SE RESETEA CON
  ' EL RESTO: SIN ESTO, UN Select POSTERIOR USARÍA EL LARGO DE LA BÚSQUEDA
  ' ANTERIOR
  $iBusqLargoTermino = 0

  ' LA FOTO DEL TEXTO ES PARTE DEL ESTADO DE LA BÚSQUEDA
  $sBusqTextoBase = ""

End

' ============================================
' Función   : IrAResultadoBusqueda
' Propósito : Lleva el editor a una coincidencia, la deja seleccionada y
'             pone su párrafo en la primera fila de la vista (GV-52).
' Parámetros: iIndice As Integer — índice en los arrays de resultados, base 0
' Retorna   : nada
' ============================================
Private Sub IrAResultadoBusqueda(iIndice As Integer)

  Dim iLinea As Integer
  Dim iColumna As Integer

  ' --- 1. VALIDACIÓN DEL ÍNDICE Y DE LA LÍNEA ---
  If iIndice < 0 Then Return
  If iIndice > $aBusqNumeroLinea.Max Then Return

  ' LOS ARRAYS DE BuscarEnTexto SON BASE 1; LAS POSICIONES DEL EDITOR, BASE 0
  iLinea = $aBusqNumeroLinea[iIndice] - 1
  iColumna = $aBusqPosicionEnLinea[iIndice] - 1

  If iLinea < 0 Then Return
  If iLinea > m_EditorPrincipal.CantidadParrafos() - 1 Then Return

  ' --- 2. SALTO Y SELECCIÓN ---
  ' REEMPLAZA AL CÁLCULO CON CursorAt + ScrollY, QUE TextEdit NO TIENE. EL LARGO
  ' VA EN CARACTERES (RC-GM-21)
  m_EditorPrincipal.IrA(m_EditorPrincipal.PosicionDe(iLinea, iColumna), $iBusqLargoTermino)

End

' ============================================
' Función   : gvResultados_Click
' Propósito : Salta a la coincidencia de la fila elegida y deja el foco en el
'             editor para escribir sobre ella. Si el texto se editó desde la
'             búsqueda, traduce la posición de la fila al texto actual y busca
'             de nuevo desde ahí, porque las posiciones de la grilla ya no valen.
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub gvResultados_Click()

  Dim iFila As Integer
  Dim sTextoActual As String
  Dim aViejas As String[]
  Dim aNuevas As String[]
  Dim iLinea As Integer
  Dim iColumna As Integer
  Dim iDesde As Integer

  ' --- 1. VALIDACIÓN DE LA FILA ---
  iFila = gvResultados.Row
  If iFila < 0 Then Return
  If iFila > $aBusqNumeroLinea.Max Then Return

  ' --- 2. TEXTO SIN CAMBIOS: LAS POSICIONES DE LA GRILLA VALEN ---
  sTextoActual = m_EditorPrincipal.Texto()
  If sTextoActual = $sBusqTextoBase Then
    $iBusqIndiceActual = iFila
    IrAResultadoBusqueda(iFila)
    ' EL Click LLEGA DIFERIDO (After Do), DESPUÉS DE QUE LA GRILLA TOMÓ EL FOCO
    ' EN MouseDown: ESTE SetFocus GANA (GridView.class, gb.gui.base 3.22.1)
    txtEditorProyecto.SetFocus()
    Return
  Endif

  ' --- 3. TEXTO EDITADO: POSICIÓN DE LA FILA TRADUCIDA AL TEXTO ACTUAL ---
  ' BuscarEnTexto DEVUELVE LÍNEA Y COLUMNA BASE 1; EL EDITOR CUENTA BASE 0
  iLinea = $aBusqNumeroLinea[iFila] - 1
  iColumna = $aBusqPosicionEnLinea[iFila] - 1
  aViejas = Split($sBusqTextoBase, Chr(10))
  aNuevas = Split(sTextoActual, Chr(10))

  If aViejas.Count = aNuevas.Count Then
    ' MISMA CANTIDAD DE LÍNEAS: LA LÍNEA ES LA MISMA Y SOLO LA COLUMNA PUEDE
    ' HABERSE CORRIDO POR UNA EDICIÓN ANTERIOR EN ESA MISMA LÍNEA
    iColumna = ColumnaTrasEdicion(aViejas[iLinea], aNuevas[iLinea], iColumna)
  Else
    ' CAMBIÓ LA CANTIDAD DE LÍNEAS: NO HAY CORRESPONDENCIA SEGURA. APROXIMACIÓN
    ' ACEPTADA: DESDE EL COMIENZO DE LA LÍNEA CON EL MISMO NÚMERO
    iColumna = 0
  Endif

  ' PosicionDe ACOTA LÍNEA Y COLUMNA AL TEXTO ACTUAL
  iDesde = m_EditorPrincipal.PosicionDe(iLinea, iColumna)

  ' --- 4. NUEVA BÚSQUEDA DESDE ESA POSICIÓN ---
  ' REARMA LA GRILLA, MARCA LA FILA Y DEJA EL FOCO EN EL EDITOR
  EjecutarBusqueda(iDesde)

End

' ============================================
' Función   : ColumnaTrasEdicion
' Propósito : Traduce una columna de la versión vieja de una línea a la nueva,
'             suponiendo una sola zona editada: lo que está antes de la zona
'             no se mueve, lo que está después se corre por la diferencia de
'             largo, y lo que cae dentro va al comienzo de la zona.
' Parámetros: sVieja As String — la línea en el texto de la búsqueda
'             sNueva As String — la misma línea en el texto actual
'             iColumna As Integer — columna en sVieja, base 0, en caracteres
' Retorna   : Integer — columna equivalente en sNueva, base 0
' ============================================
Private Function ColumnaTrasEdicion(sVieja As String, sNueva As String, iColumna As Integer) As Integer

  Dim iLargoVieja As Integer
  Dim iLargoNueva As Integer
  Dim iMinimo As Integer
  Dim iPrefijo As Integer
  Dim iSufijo As Integer
  Dim i As Integer

  ' --- 1. LÍNEA SIN CAMBIOS: LA EDICIÓN FUE EN OTRA LÍNEA ---
  If sVieja = sNueva Then Return iColumna

  ' --- 2. LARGOS EN CARACTERES (RC-GM-12) ---
  iLargoVieja = String.Len(sVieja)
  iLargoNueva = String.Len(sNueva)
  iMinimo = Min(iLargoVieja, iLargoNueva)

  ' --- 3. PREFIJO COMÚN: LO QUE NO CAMBIÓ AL PRINCIPIO ---
  For i = 1 To iMinimo
    If String.Mid(sVieja, i, 1) <> String.Mid(sNueva, i, 1) Then Break
    iPrefijo = i
  Next

  ' --- 4. SUFIJO COMÚN: LO QUE NO CAMBIÓ AL FINAL, SIN PISAR EL PREFIJO ---
  For i = 1 To iMinimo - iPrefijo
    If String.Mid(sVieja, iLargoVieja - i + 1, 1) <> String.Mid(sNueva, iLargoNueva - i + 1, 1) Then Break
    iSufijo = i
  Next

  ' --- 5. TRADUCCIÓN DE LA COLUMNA ---
  ' ANTES DE LA ZONA EDITADA: NO SE MOVIÓ
  If iColumna < iPrefijo Then Return iColumna
  ' DESPUÉS DE LA ZONA EDITADA: SE CORRE POR LA DIFERENCIA DE LARGO
  If iColumna >= iLargoVieja - iSufijo Then Return iColumna + iLargoNueva - iLargoVieja
  ' DENTRO DE LA ZONA: LA COINCIDENCIA FUE TOCADA; SE BUSCA DESDE EL COMIENZO
  Return iPrefijo

End

