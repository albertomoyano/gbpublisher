' ============================================================
' HANDLERS DEL PANEL DE BIBLIOGRAFÍA — VAN EN FMain
'
' TODOS SIGUEN EL MISMO PATRÓN: EL MÓDULO HACE EL TRABAJO Y DEVUELVE UN
' BOOLEAN; EL HANDLER MUESTRA m_EditorHTML.UltimoError SI ALGO FALLÓ Y
' RESTITUYE EL FOCO AL EDITOR (RC-GM-07).
'
' EL PUNTO CRÍTICO ES EL MENSAJE DE ERROR. UN Try SEGUIDO DE UN Return MUDO
' ES UN CANAL MUDO: EL FALLO SE MANIFIESTA LEJOS DE SU CAUSA, COMO UN
' RESULTADO VACÍO QUE PARECE UN DATO LEGÍTIMO (GV-23).
' ============================================================

' ============================================
' Función   : cmbArchivosHTML_Click
' Propósito : Abre la bibliografía elegida, importándola si es la primera vez
' Parámetros: ninguno
' Retorna   : nada
' ============================================

Public Sub cmbArchivosHTML_Click()

  Dim sNombre As String
  Dim bAbierto As Boolean

  ' --- 1. SUPRESIÓN DURANTE EL POBLADO POR CÓDIGO ---
  ' ASIGNAR Index DISPARA ESTE MISMO EVENTO. LA BANDERA EVITA QUE EL GUARD
  ' VUELVA A PREGUNTAR CUANDO LA ACCIÓN RAÍZ YA LO EVALUÓ (SC-06).
  If m_EditorHTML.bCargandoLista Then Return

  sNombre = cmbArchivosHTML.Text
  If sNombre = "" Then Return

  ' --- 2. GUARD DE CAMBIOS SIN GUARDAR ---
  ' AL INICIO Y ANTES DE CUALQUIER CAMBIO VISIBLE EN LA INTERFAZ (SC-06)
  If Not m_EditorHTML.ConfirmarDescartarCambios() Then Return

  ' --- 3. APERTURA ---
  ' LA PRIMERA VEZ SOBRE UN .rtf ESTO LANZA engine/convertir_bibliografia.sh
  ' POR LA LANZADORA (SC-53) Y PUEDE TARDAR VARIOS SEGUNDOS: EL AVANCE LO DAN
  ' EL PUNTERO OCUPADO Y lblMensajes.
  ' MIENTRAS TANTO EL PANEL QUEDA DESHABILITADO: LA ESPERA DEJA CORRER LOS
  ' EVENTOS (GV-17) Y, SIN ESTO, SE PODÍA ELEGIR OTRO ARCHIVO, GUARDAR O
  ' MARCAR EN MEDIO DE LA CONVERSIÓN (SC-12). SE REHABILITA SIEMPRE, ANTES
  ' DE MIRAR EL RESULTADO
  Panel2.Enabled = False
  bAbierto = m_EditorHTML.AbrirArchivo(sNombre)
  Panel2.Enabled = True
  If Not bAbierto Then
    ' SIN UltimoError, EL FALLO YA LO INFORMÓ LA LANZADORA: UN SOLO MENSAJE
    If m_EditorHTML.UltimoError <> "" Then
      m_Sonido.sonar("Error")
      Message.Error("No se pudo abrir la bibliografía:" & gb.NewLine & gb.NewLine &
        m_EditorHTML.UltimoError)
    Endif
    Return
  Endif

  ' --- 4. REFRESCO DE LA LISTA Y DEL CONTADOR ---
  ' TRAS IMPORTAR, EL ORIGINAL DEJA SU LUGAR AL .html DE TRABAJO EN EL COMBO
  RecargarComboBibliografia()
  ActualizarContadorMarcas()

  txtEditorHTML.SetFocus()

End

' ============================================
' Función   : RecargarComboBibliografia
' Propósito : Vuelve a poblar el combo de archivos de bibliografía
' Parámetros: ninguno
' Retorna   : nada
' ============================================

Public Sub RecargarComboBibliografia()

  Dim aArchivos As String[]
  Dim sArchivo As String
  Dim sSeleccionado As String

  sSeleccionado = cmbArchivosHTML.Text

  ' LA BANDERA SUPRIME EL GUARD INTERNO DEL HANDLER MIENTRAS SE POBLA (SC-06)
  m_EditorHTML.bCargandoLista = True

  cmbArchivosHTML.Clear()
  aArchivos = m_EditorHTML.ListarArchivos()

  For Each sArchivo In aArchivos
    cmbArchivosHTML.Add(sArchivo)
  Next

  ' SE REPONE LA SELECCIÓN SI EL ARCHIVO SIGUE EN LA LISTA. TRAS UNA
  ' IMPORTACIÓN NO ESTARÁ, PORQUE EL ORIGINAL FUE REEMPLAZADO POR SU .html
  If sSeleccionado <> "" Then
    Try cmbArchivosHTML.Text = sSeleccionado
  Endif

  m_EditorHTML.bCargandoLista = False

End

' ============================================
' Función   : ActualizarContadorMarcas
' Propósito : Muestra cuántos tramos llevan cada semáforo
' Parámetros: ninguno
' Retorna   : nada
' ============================================

Public Sub ActualizarContadorMarcas()

  ' SIRVE DE VERIFICACIÓN: SI AL REABRIR AL DÍA SIGUIENTE EL NÚMERO BAJÓ,
  ' ALGO PASÓ Y SE NOTA EN EL ACTO Y NO TRES ENTRADAS DESPUÉS
  lblMarcasHTML.Text = "Amarillos: " & CStr(m_EditorHTML.ContarMarcas("#ffff00")) &
    "   Rojos: " & CStr(m_EditorHTML.ContarMarcas("#ff0000"))

End

