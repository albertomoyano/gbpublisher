' ============================================
' Función   : menuCerrarProyecto_Click
' Propósito : Cierra el proyecto actualmente abierto desde el menú. Verifica
'             cambios sin guardar y pide confirmación explícita antes de
'             ejecutar el cierre.
' ============================================
Public Sub menuCerrarProyecto_Click()

  ' --- 1. GUARD: CAMBIOS SIN GUARDAR EN EL EDITOR ---
  If Not ConfirmarDescartarCambios() Then Return

  ' --- 2. SIN PROYECTO ABIERTO: NADA QUE HACER ---
  If txtProyecto.Text = "" Then Return

  ' --- 3. CONFIRMAR CIERRE ---
  m_Sonido.sonar("Question")
  If Message.Question("¿Está seguro que desea cerrar este proyecto?", "Sí", "No") <> 1 Then Return

  ' --- 4. EJECUTAR EL CIERRE ---
  m_GestionImagenes.ResetearEstado()
  m_InicioCierre.CerrarProyecto()
  FMain.tbMostrarPanelInferior.Visible = False

End

' ============================================
' Función   : menuSanitizar_Click
' Propósito : Ejecuta el flujo de sanitización de caracteres invisibles en
'             los archivos .md del proyecto. Valida que haya proyecto abierto
'             y que no haya cambios sin guardar en el editor antes de abrir
'             el formulario de selección de tipos.
' ============================================
Public Sub menuSanitizar_Click()

  ' --- 1. GUARD: PROYECTO ABIERTO ---
  If txtProyecto.Text = "" Then
    m_Sonido.sonar("Warning")
    Message.Warning("Debe abrir un proyecto antes de ejecutar la sanitización.")
    Return
  Endif

  ' --- 2. GUARD: CAMBIOS SIN GUARDAR EN EL EDITOR ---
  If Not ConfirmarDescartarCambios() Then Return

  ' --- 3. MOSTRAR FORMULARIO DE SELECCIÓN DE TIPOS ---
  FSanitizarUTF8.ShowModal

End

