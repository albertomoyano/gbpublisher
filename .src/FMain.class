End

' ============================================
' Función   : btnFootnote_Click
' Propósito : Inserta una marca de footnote en la posición actual del cursor
'             y agrega su definición correspondiente al final del archivo.
'             Deja el placeholder seleccionado y el foco en el editor para
'             que el usuario reemplace el texto al escribir.
' Parámetros: (Evento de botón, sin parámetros)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub btnFootnote_Click()

  Dim iNumeroFootnote As Integer
  Dim sMarcaFootnote As String
  Dim sPrefijoDef As String
  Dim iInicioPlaceholder As Integer

  ' --- 1. CALCULAR EL SIGUIENTE NÚMERO DE FOOTNOTE ---
  ' SE BUSCA EL MÁXIMO NÚMERO YA USADO Y SE SUMA 1, PARA EVITAR
  ' COLISIONES SI EL USUARIO BORRA UNA NOTA INTERMEDIA (RC-GM-09)
  iNumeroFootnote = ObtenerSiguienteNumeroFootnote(m_EditorPrincipal.Texto())

  ' --- 2. CONSTRUIR MARCA Y PREFIJO DE LA DEFINICIÓN ---
  ' SC-01: SEPARADORES Y COMILLAS COMO Chr(...), NUNCA COMO ESCAPES "\n"
  sMarcaFootnote = "[^" & CStr(iNumeroFootnote) & "]"
  sPrefijoDef = sMarcaFootnote & ": "

  ' --- 3. INSERTAR LA MARCA EN LA POSICIÓN ACTUAL DEL CURSOR ---
  ' CAMBIO PUNTUAL: CONSERVA EL DESHACER. SI FALLA, EL MÓDULO YA INFORMÓ
  If Not m_EditorPrincipal.Insertar(sMarcaFootnote) Then
    txtEditorProyecto.SetFocus()
    Return
  Endif

  ' --- 4. AL FINAL DEL ARCHIVO: SEPARADOR Y PREFIJO DE LA DEFINICIÓN ---
  m_EditorPrincipal.IrAlFinal()
  If Not m_EditorPrincipal.Insertar(Chr(10) & Chr(10) & sPrefijoDef) Then
    txtEditorProyecto.SetFocus()
    Return
  Endif

  ' --- 5. PLACEHOLDER: SU INICIO ES LA POSICIÓN DEL CURSOR TRAS EL PREFIJO ---
  ' LEER Pos ES CONFIABLE (GV-44); LO QUE NO SE HACE ES ESCRIBIRLO
  iInicioPlaceholder = m_EditorPrincipal.Posicion()
  If Not m_EditorPrincipal.Insertar(m_Constantes.FOOTNOTE_PLACEHOLDER) Then
    txtEditorProyecto.SetFocus()
    Return
  Endif

  ' --- 6. SELECCIONAR EL PLACEHOLDER PARA EDICIÓN INMEDIATA ---
  ' EL LARGO EN CARACTERES, NO EN BYTES (RC-GM-21)
  m_EditorPrincipal.Seleccionar(iInicioPlaceholder, String.Len(m_Constantes.FOOTNOTE_PLACEHOLDER))

  ' --- 7. RESTAURAR FOCO EN EL EDITOR (RC-GM-07) ---
  txtEditorProyecto.SetFocus()

End

' ============================================
' Función   : btnEnmarcar_Click
' Propósito : Enmarca el texto seleccionado con el par de signos que se elija
'             (paréntesis, comillas angulares, pregunta, admiración, corchetes,
'             rayas). La lógica está en m_Enmarcar
' Parámetros: (Evento de botón, sin parámetros)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub btnEnmarcar_Click()

  m_Enmarcar.Enmarcar()

  ' EL FOCO VUELVE AL EDITOR EN TODOS LOS CASOS: ENMARCADO, AVISO O CANCELACIÓN
  ' (RC-GM-07)
  txtEditorProyecto.SetFocus()

End

' ============================================
' Función   : ObtenerSiguienteNumeroFootnote
' Propósito : Recorre el texto buscando todas las marcas [^N] y devuelve
'             el siguiente número disponible (máximo + 1). Inmune a borrados
'             intermedios: nunca colisiona con una marca preexistente.
' Parámetros: sTexto As String — contenido completo del editor
' Retorna   : Integer — siguiente número de footnote a usar (≥ 1)
' ============================================
Public Function ObtenerSiguienteNumeroFootnote(sTexto As String) As Integer

  Dim iPosBusqueda As Integer
  Dim iInicio As Integer
  Dim iFin As Integer
  Dim iMaximo As Integer
  Dim iNumero As Integer
  Dim sCandidato As String

  ' --- 1. INICIALIZACIÓN ---
  ' SI NO SE ENCUENTRA NINGUNA MARCA, EL PRIMER NÚMERO A USAR SERÁ 1
  iMaximo = 0
  iPosBusqueda = 1

  ' --- 2. BÚSQUEDA ITERATIVA DE PATRONES [^N] EN EL TEXTO ---
  ' EN CADA VUELTA SE BUSCA EL SIGUIENTE "[^", LUEGO SU "]" DE CIERRE,
  ' Y SE EVALÚA SI EL CONTENIDO ENTRE AMBOS ES UN ENTERO VÁLIDO
  Do
    ' UBICAR EL SIGUIENTE INICIO DE MARCA
    iInicio = String.InStr(sTexto, "[^", iPosBusqueda)
    If iInicio = 0 Then Break

    ' UBICAR EL CIERRE "]" CORRESPONDIENTE
    iFin = String.InStr(sTexto, "]", iInicio + 2)
    If iFin = 0 Then Break

    ' EXTRAER EL TEXTO ENTRE "[^" Y "]" Y VALIDAR QUE SEA UN ENTERO
    sCandidato = String.Mid(sTexto, iInicio + 2, iFin - iInicio - 2)
    Try iNumero = CInt(sCandidato)
    If Error Then
      ' NO ERA UN ENTERO: PROBABLEMENTE NO ES UNA MARCA REAL ("[^abc]")
      ' AVANZAMOS Y CONTINUAMOS LA BÚSQUEDA SIN ACTUALIZAR EL MÁXIMO
      iPosBusqueda = iFin + 1
      Continue
    Endif

    ' ACTUALIZAR EL MÁXIMO SI CORRESPONDE
    If iNumero > iMaximo Then iMaximo = iNumero

    ' AVANZAR EL PUNTERO DE BÚSQUEDA MÁS ALLÁ DEL "]" ACTUAL
    iPosBusqueda = iFin + 1
  Loop

  ' --- 3. RETORNO ---
  Return iMaximo + 1

End

' ============================================
' Función   : btnCrearCuadro_Click
' Propósito : Abre los cuadros del proyecto (FTabla) e inserta en el cursor
'             el bloque del cuadro elegido (SC-66, SC-67)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnCrearCuadro_Click()

  Dim hTabla As FTabla
  Dim sId As String

  ' --- 1. LA POSICIÓN: EL BLOQUE DEL CUADRO VA EN UNA LÍNEA VACÍA ---
  If Not m_EditorPrincipal.CursorEnLineaVaciaAlInicio() Then
    Message.Warning("El cursor debe estar al inicio de una línea vacía para insertar el cuadro.")
    Return
  Endif
  If m_InicioCierre.RutaProyectoEnCurso = "" Then
    m_Sonido.sonar("Info")
    Message.Info("Abrí un proyecto antes de trabajar con los cuadros.")
    Return
  Endif

  ' --- 2. EL FORMULARIO; LO ELEGIDO VUELVE POR m_Cuadros (RC-GM-13) ---
  hTabla = New FTabla
  If hTabla.ShowModal() = 1 Then
    sId = m_Cuadros.IdElegido()
    ' EL .md SOLO NOMBRA EL CUADRO: LA TABLA ESTÁ EN cuadros/ (SC-66)
    If sId <> "" Then m_EditorPrincipal.Insertar(m_Cuadros.Marca(sId))
  Endif
  txtEditorProyecto.SetFocus()

End

Public Sub btnResultados_Click()

  ' Primero verificar si hay resultados suficientes
  If vConteo.Value > 1 Then
    ' Si hay resultados, el estado del botón controla la visibilidad
    TabPanelIzquierdaInferior[m_Constantes.PESTANA_INFERIOR_RESULTADOS].Visible = btnResultados.Value

    If btnResultados.Value Then
      ' Si se activa el botón, mostrar la solapa
      TabPanelIzquierdaInferior.Index = m_Constantes.PESTANA_INFERIOR_RESULTADOS
    Endif

  Else
    ' Si no hay suficientes resultados
    ' Solo mostrar mensaje si el botón estaba activado (intentando activarse)
    If btnResultados.Value = True Then
      m_Sonido.sonar("Info")
      Message.Info("El resultado de la búsqueda debe ser mayor a 2.")
    Endif
    btnResultados.Value = False  ' Desactivar el botón
    TabPanelIzquierdaInferior[m_Constantes.PESTANA_INFERIOR_RESULTADOS].Visible = False
  Endif

End

' ============================================
' Función   : txtEditorProyecto_KeyPress
' Propósito : Intercepta atajos de teclado dentro del editor.
'             Actualmente: Ctrl+S dispara el guardado del archivo abierto.
' Parámetros: (Evento de teclado, sin parámetros)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub txtEditorProyecto_KeyPress()

  Dim sSeleccion As String

  ' --- 1. Ctrl + s → DISPARAR EL EVENTO DEL BOTÓN GUARDAR ---
  ' Stop Event EVITA QUE EL EDITOR PROCESE Ctrl+S COMO CARÁCTER DE CONTROL
  ' Y QUE INSERTE ALGO RARO EN EL TEXTO
  If Key.Control And Key.Code = Key["s"] Then
    Stop Event
    btnGuardarCambiosEditor_Click()
    Return
  Endif

  ' --- 2. Ctrl + f → ABRIR EL PANEL DE BÚSQUEDA PROPIO ---
  ' TextEdit NO TIENE PANEL DE BÚSQUEDA PROPIO (EL TextEditor SÍ LO TENÍA). EL
  ' Stop Event QUEDA IGUAL: EL ATAJO ES NUESTRO Y NO DEBE LLEGAR AL CONTROL
  If Key.Control And Key.Code = Key["f"] Then
    Stop Event

    ' SI HAY TEXTO SELECCIONADO EN EL EDITOR, PASA AL CUADRO DE BÚSQUEDA:
    ' SELECCIONAR Y APRETAR CTRL+F ES LA FORMA MÁS CORTA DE BUSCAR UNA
    ' PALABRA QUE SE TIENE A LA VISTA
    If m_EditorPrincipal.HaySeleccion() Then
      sSeleccion = Trim(m_EditorPrincipal.TextoSeleccionado())

      ' UNA SELECCIÓN DE VARIAS LÍNEAS NO ES UN TÉRMINO DE BÚSQUEDA:
      ' BuscarEnTexto TRABAJA LÍNEA POR LÍNEA Y NUNCA ENCONTRARÍA NADA
      If String.InStr(sSeleccion, Chr(10)) = 0 Then
        If sSeleccion <> "" Then txtBuscarPalabra.Text = sSeleccion
      Endif
    Endif

    ' SI NO HUBO SELECCIÓN, QUEDA EL TÉRMINO ANTERIOR SELECCIONADO PARA
    ' ESCRIBIR ENCIMA SIN TENER QUE BORRARLO
    txtBuscarPalabra.SelectAll()
    txtBuscarPalabra.SetFocus()

    ' CON UNA SELECCIÓN DE UNA LÍNEA SE BUSCA SIN PEDIR ENTER: SELECCIONAR Y
    ' APRETAR CTRL+F PASA A SER UNA SOLA OPERACIÓN. VA AL FINAL, DESPUÉS DE
    ' HABER LEÍDO LA SELECCIÓN, PORQUE EjecutarBusqueda MUEVE EL CURSOR Y
    ' CAMBIA LA SELECCIÓN DEL EDITOR
    If sSeleccion <> "" Then
      If String.InStr(sSeleccion, Chr(10)) = 0 Then EjecutarBusqueda()
    Endif

    Return
  Endif

  ' --- 3. Ctrl + Tab → EXPANDIR EL SNIPPET ANTES DEL CURSOR (SC-21) ---
  ' Stop Event SIEMPRE, SE EXPANDA O NO: EL TAB NO DEBE LLEGAR AL CONTROL
  If Key.Control Then
    If Key.Code = Key.Tab Then
      Stop Event
      m_Snippets.Expandir()
      ' EL Message DE UN FALLO SE LLEVA EL FOCO (RC-GM-07)
      txtEditorProyecto.SetFocus()
      Return
    Endif
  Endif

  ' --- 4. Alt + q → SELECCIONAR HASTA EL SIGNO PAR ---
  ' EL ATAJO VA ACÁ Y NO EN EL MENÚ: menuPopUp ESTÁ OCULTO (Visible = False)
  ' Y SU Shortcut NO SE DISPARA. LETRA POR Key["q"] (RC-GM-10)
  If Key.Alt Then
    If Key.Code = Key["q"] Then
      Stop Event
      m_ParesDelimitadores.SeleccionarPar()
      ' EL Message DE UN FALLO SE LLEVA EL FOCO (RC-GM-07)
      txtEditorProyecto.SetFocus()
      Return
    Endif
  Endif

  ' --- 5. F3 → BUSCAR LA SIGUIENTE COINCIDENCIA DEL TÉRMINO DEL CUADRO ---
  ' EQUIVALE AL BOTÓN BUSCAR. BUSCA SOBRE EL TEXTO ACTUAL, ASÍ QUE SIRVE
  ' DESPUÉS DE EDITAR SIN QUE SE CORRAN LAS POSICIONES
  If Key.Code = Key.F3 Then
    Stop Event
    ' EL FOCO FINAL LO DECIDE EjecutarBusqueda: EL EDITOR SI HUBO SALTO,
    ' EL CUADRO SI FALTA EL TÉRMINO O NO HAY COINCIDENCIAS
    EjecutarBusqueda()
    Return
  Endif

  ' --- 6. F2 → INSERTAR UNA SIGLA DEL CATÁLOGO (SOLO LIBROS) ---
  ' LA VENTANITA DEVUELVE LA MARCA POR m_Siglas (RC-GM-13). UNA SELECCIÓN DE
  ' UNA LÍNEA, SIN ESPACIOS DE BORDE Y DEL LARGO DE UNA SIGLA, ES LO QUE SE
  ' BUSCA Y LA MARCA LA REEMPLAZA; CUALQUIER OTRA NO SE TOCA: EL CURSOR PASA
  ' A SU FINAL
  If Key.Code = Key.F2 Then
    Stop Event
    If m_InicioCierre.EsLibroEnCurso Then
      sSeleccion = m_EditorPrincipal.TextoSeleccionado()
      m_Siglas.TextoInicial = ""
      If sSeleccion <> "" Then
        If sSeleccion = Trim(sSeleccion) And InStr(sSeleccion, Chr(10)) = 0 And String.Len(sSeleccion) <= m_Siglas.LARGO_SIGLA Then
          m_Siglas.TextoInicial = sSeleccion
        Else
          m_EditorPrincipal.Seleccionar(m_EditorPrincipal.InicioSeleccion() + m_EditorPrincipal.LargoSeleccion(), 0)
        Endif
      Endif
      If FSiglaRapida.ShowModal() = 1 Then m_EditorPrincipal.Insertar(m_Siglas.MarcaElegida)
    Endif
    ' EL Message DE UN FALLO SE LLEVA EL FOCO (RC-GM-07)
    txtEditorProyecto.SetFocus()
    Return
  Endif

  ' --- 7. F4 → BUSCAR LA COINCIDENCIA DE LA NOTA A PIE ---
  If Key.Code = Key.F4 Then
    Stop Event
    ' EL FOCO FINAL LO DECIDE IrAParFootnote
    m_FuncionesGenericas.IrAParFootnote()
    Return
  Endif

End

