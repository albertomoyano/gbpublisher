' ============================================
' Función   : btnAnalizar_Click
' Propósito : Analiza la referencia de txtTMPbiblio: primero la busca entre
'             las entradas ya cargadas (todos los proyectos); si no está, o
'             si el usuario lo pide, consulta al modelo elegido
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnAnalizar_Click()

  Dim hForm As FRespuestaLLM
  Dim hCandidatos As FCandidatosBib
  Dim aIds As Integer[]
  Dim iAccion As Integer
  Dim sReferencia As String
  Dim sId As String
  Dim sAnioCitado As String
  Dim sAnioElegido As String
  Dim bOtraEdicion As Boolean

  ' --- 1. VALIDACIÓN: REFERENCIA ---
  ' txtTMPbiblio SOLO ESTÁ HABILITADO DURANTE LA CARGA DE UNA REFERENCIA NUEVA
  sReferencia = Trim(txtTMPbiblio.Text)
  If Not txtTMPbiblio.Enabled Or If sReferencia = "" Then
    m_Sonido.sonar("Info")
    Message.Info("Pegue la referencia en la caja de texto temporal antes de analizarla.")
    Return
  Endif

  ' --- 2. BÚSQUEDA EN LA PROPIA BASE, ANTES DEL LLM ---
  ' NO DEPENDE DE QUE HAYA UN PROVEEDOR CONFIGURADO. UNA REFERENCIA NUEVA
  ' EMPIEZA SIN ORIGEN: SE DESCARTA EL DE UNA COPIA ANTERIOR NO GUARDADA
  m_BuscarBib.OlvidarOrigen()
  aIds = m_BuscarBib.Buscar(sReferencia)
  If m_BuscarBib.UltimoError() <> "" Then
    ' LA BÚSQUEDA FALLÓ: SE AVISA Y SE SIGUE CON EL LLM (GV-23)
    m_Sonido.sonar("Warning")
    Message.Warning("No se pudo buscar en la base; se sigue con el LLM." & gb.NewLine & m_BuscarBib.UltimoError())
  Endif

  If aIds.Count > 0 Then
    hCandidatos = New FCandidatosBib
    hCandidatos.Iniciar(aIds, m_BuscarBib.UltimoMotivo())
    ' LA DECISIÓN VUELVE COMO VALOR DE ShowModal; LA FILA ELEGIDA, EN m_BuscarBib.
    ' DESPUÉS DE CERRARSE, hCandidatos YA NO ES VÁLIDO: NO SE LO LEE MÁS
    iAccion = hCandidatos.ShowModal()

    Select Case iAccion
      Case m_BuscarBib.ACCION_CANCELAR
        Return

      Case m_BuscarBib.ACCION_USAR
        ' OTRA EDICIÓN O REIMPRESIÓN: EL AÑO CITADO Y EL DE LA ENTRADA ELEGIDA
        ' EXISTEN Y DIFIEREN. UN AÑO FALTANTE NO DESCARTA, MISMO CRITERIO QUE EL
        ' CONTROL DE DUPLICADOS AL GUARDAR (m_BuscarBib.DuplicadosEnProyecto)
        sAnioCitado = m_BuscarBib.AnioDeReferencia(sReferencia)
        sAnioElegido = m_BuscarBib.AnioDeEntrada(m_BuscarBib.ElegidoId())
        bOtraEdicion = sAnioCitado <> "" And sAnioElegido <> "" And sAnioCitado <> sAnioElegido

        If m_BuscarBib.ElegidoProyecto() = m_InicioCierre.IdProyectoEnCurso And Not bOtraEdicion Then
          ' MISMO PROYECTO Y MISMA EDICIÓN: ES UN DUPLICADO. SE CITA LA CLAVE EXISTENTE
          m_Sonido.sonar("Info")
          Message.Info("La referencia ya está cargada en este proyecto como «" & m_BuscarBib.ElegidoClave() & "»." & gb.NewLine & "Se muestra en la grilla de referencias en curso.")
          m_Bibtex.MostrarEntradasEnGrilla([m_BuscarBib.ElegidoId()], False)
        Else
          ' OTRO PROYECTO, U OTRA EDICIÓN DEL MISMO: SE COPIA COMO ENTRADA NUEVA,
          ' SIN GUARDAR. id_origen APUNTA A LA ENTRADA ELEGIDA
          If Not m_BuscarBib.UsarEntrada(m_BuscarBib.ElegidoId()) Then
            If m_BuscarBib.UltimoError() <> "" Then
              m_Sonido.sonar("Error")
              Message.Error(m_BuscarBib.UltimoError())
            Endif
            Return
          Endif
          ' EL AÑO NO SE CORRIGE SOLO (DECISIÓN DE ALBERTO): OTRA EDICIÓN PUEDE
          ' TRAER MÁS DIFERENCIAS QUE EL AÑO, Y LA ENTRADA SE REVISA ENTERA
          If bOtraEdicion Then
            ' TEXTO ENRIQUECIDO: LOS SALTOS VAN COMO <br>, PORQUE CON ETIQUETAS
            ' EL MENSAJE SE INTERPRETA COMO HTML Y gb.NewLine NO CORTA LÍNEA
            m_Sonido.sonar("Warning")
            Message.Warning("<b>ESTA ES OTRA EDICIÓN O REIMPRESIÓN</b><br><br>" &
              "El año citado (<b>" & sAnioCitado & "</b>) difiere del de la entrada copiada (<b>" & sAnioElegido & "</b>). " &
              "Los campos muestran todavía los datos de la edición de " & sAnioElegido & ".<br><br>" &
              "<b>Antes de guardar, revise y corrija en los campos todo lo que cambie en esta edición:</b><br>" &
              "• año o fecha<br>" &
              "• editorial y lugar<br>" &
              "• número de edición<br>" &
              "• paginación<br>" &
              "• prólogo, introducción, traducción, notas, corpus o anexos nuevos<br><br>" &
              "<b>Lo que no se corrija quedará guardado con los datos de la edición de " & sAnioElegido & ".</b>")
          Endif
        Endif
        Return
    End Select
    ' ACCION_LLM: NINGÚN CANDIDATO ES LA OBRA, SE SIGUE
  Endif

  ' --- 3. VALIDACIÓN: PROVEEDOR ---
  sId = m_LLM.IdSeleccionado(cmbLLM.Index)
  If sId = "" Then
    m_Sonido.sonar("Info")
    Message.Info("No hay ningún proveedor LLM disponible." & gb.NewLine & "Revise el catálogo de proveedores instalado (llm/proveedores/) y las credenciales en el panel de administración.")
    Return
  Endif

  ' --- 4. CONSULTA Y RESPUESTA ---
  hForm = New FRespuestaLLM
  hForm.Iniciar(sId, sReferencia, ModoLLM())
  hForm.ShowModal()

End

' ============================================
' Función   : ModoLLM
' Propósito : Modo elegido en los radio buttons
' Parámetros: ninguno
' Retorna   : String — m_LLM.MODO_FORMATEAR o m_LLM.MODO_CONSULTAR
' ============================================
Private Function ModoLLM() As String

  If rdbConsultar.Value Then Return m_LLM.MODO_CONSULTAR

  Return m_LLM.MODO_FORMATEAR

End

' ============================================
' Función   : rdbFormatear_Click
' Propósito : Cambio al modo Formatear
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub rdbFormatear_Click()

  CambiarModoLLM(m_LLM.MODO_FORMATEAR)

End

' ============================================
' Función   : rdbConsultar_Click
' Propósito : Cambio al modo Consultar
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub rdbConsultar_Click()

  CambiarModoLLM(m_LLM.MODO_CONSULTAR)

End

' ============================================
' Función   : CambiarModoLLM
' Propósito : Recuerda el modo y vuelve a llenar el combo: en Consultar solo
'             aparecen los proveedores con búsqueda
' Parámetros: sModo As String — modo recién elegido
' Retorna   : nada
' ============================================
Private Sub CambiarModoLLM(sModo As String)

  ' Click SE DISPARA SOLO EN EL RADIO QUE QUEDA MARCADO (VERIFICADO EN BANCO, 3.19)
  m_LLM.RecordarModo(sModo)
  m_LLM.LlenarCombo(cmbLLM, sModo)

End

