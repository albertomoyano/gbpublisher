Public Sub cmbArchivosXML_Click()
  ' MUESTRA EL CONTENIDO DEL ARCHIVO XML SELECCIONADO EN EL EDITOR
  ' EL EDITOR ES DE SOLO LECTURA (SIN EDICIÓN)

  Dim sArchivoSeleccionado As String
  Dim sRutaCompleta As String
  Dim sContenido As String

  ' VERIFICAR QUE HAY ALGO SELECCIONADO
  If cmbArchivosXML.Index = -1 Then Return

  ' OBTENER EL ARCHIVO SELECCIONADO
  sArchivoSeleccionado = cmbArchivosXML.Text

  If sArchivoSeleccionado = "" Then Return

  ' CONSTRUIR LA RUTA COMPLETA
  sRutaCompleta = m_InicioCierre.RutaProyectoEnCurso &/ "jats" &/ sArchivoSeleccionado

  ' VERIFICAR QUE EL ARCHIVO EXISTE
  If Not Exist(sRutaCompleta) Then
    m_Sonido.sonar("Error")
    Message.Error("El archivo no existe:" & gb.NewLine & sRutaCompleta)
    Return
  Endif

  ' CARGAR EL CONTENIDO EN EL EDITOR
  sContenido = File.Load(sRutaCompleta)

  If sContenido Then
    ' SIN VISOR, O SI EL COLOREO FALLA (YA INFORMADO), SE MUESTRA COMO TEXTO PLANO
    If Not $hVisorXML Then
      txtEditorXML.Text = sContenido
    Else If Not $hVisorXML.Mostrar(sContenido) Then
      txtEditorXML.Text = sContenido
    Endif
  Else
    m_Sonido.sonar("Error")
    Message.Error("No se pudo cargar el contenido del archivo XML")
  Endif

End

