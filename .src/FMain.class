' ============================================
' Función   : btnTipografiaHTML_Click
' Propósito : Elige la tipografía y el cuerpo con que se ve la bibliografía
' Parámetros: ninguno
' Retorna   : nada
' ============================================

Public Sub btnTipografiaHTML_Click()

  ' --- 1. DIÁLOGO ---
  ' ATENCIÓN A LA CONVENCIÓN DE GAMBAS, AL REVÉS DE LO QUE SUGIERE EL INSTINTO:
  ' LOS Dialog.Select* DEVUELVEN True CUANDO EL USUARIO CANCELÓ (GV-16).
  Dialog.Title = "Tipografía del editor de bibliografía"
  Dialog.Font = txtEditorHTML.Font

  If Dialog.SelectFont() Then Return

  ' --- 2. APLICACIÓN ---
  ' SOLO FAMILIA Y CUERPO: LA NEGRITA Y LA ITÁLICA SON CONTENIDO DEL DOCUMENTO
  ' Y NO AJUSTE DE VISTA, ASÍ QUE NO SE TOMAN DEL DIÁLOGO.
  m_EditorHTML.AplicarFuenteVista(Dialog.Font.Name, Dialog.Font.Size)

  ' LA PERSISTENCIA LA HACE EL MÓDULO: LA PREFERENCIA ES SUYA Y LA REAPLICA
  ' DESPUÉS DE CADA CARGA DE DOCUMENTO. EL HANDLER NO ESCRIBE CONFIGURACIÓN.

  txtEditorHTML.SetFocus()

End

' ============================================
' Función   : InicializarPanelPares
' Propósito : Puebla el combo de pares y deja el panel en estado inicial.
'             Se invoca UNA vez, desde Form_Open.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub InicializarPanelPares()

  ' --- 1. INICIALIZACIÓN ---
  ' LAS COMILLAS CURVAS INGLESAS CON String.Chr$ PARA QUE EL .class NO DEPENDA
  ' DE QUE LA CODIFICACIÓN SOBREVIVA A UN COPIAR Y PEGAR
  $aParesIzquierdos.Clear()
  $aParesDerechos.Clear()

  ' --- 2. ENTRADA NEUTRA, SIN PAR ASOCIADO ---
  $aParesIzquierdos.Add("")
  $aParesDerechos.Add("")

  ' --- 3. PARES PREDEFINIDOS ---
  $aParesIzquierdos.Add("«")
  $aParesDerechos.Add("»")

  $aParesIzquierdos.Add(String.Chr$(8220))
  $aParesDerechos.Add(String.Chr$(8221))

  $aParesIzquierdos.Add("¿")
  $aParesDerechos.Add("?")

  $aParesIzquierdos.Add("¡")
  $aParesDerechos.Add("!")

  $aParesIzquierdos.Add("(")
  $aParesDerechos.Add(")")

  $aParesIzquierdos.Add("[")
  $aParesDerechos.Add("]")

  $aParesIzquierdos.Add("{")
  $aParesDerechos.Add("}")

  ' --- 4. POBLAR EL COMBO SIN DISPARAR EL ANÁLISIS ---
  $bPoblandoPares = True

  cmbTipoDePar.Clear()
  cmbTipoDePar.Add("(personalizado)")
  cmbTipoDePar.Add("«  »   comillas latinas")
  cmbTipoDePar.Add(String.Chr$(8220) & "  " & String.Chr$(8221) & "   comillas inglesas")
  cmbTipoDePar.Add("¿  ?   interrogación")
  cmbTipoDePar.Add("¡  !   exclamación")
  cmbTipoDePar.Add("(  )   paréntesis")
  cmbTipoDePar.Add("[  ]   corchetes")
  cmbTipoDePar.Add("{  }   llaves")
  cmbTipoDePar.Index = 0

  $bPoblandoPares = False

  ' --- 5. COLUMNAS DEL GRID ---
  ' SIN ESTO, Columns.Count ES 0: ASIGNAR Rows.Count NO PRODUCE NINGUNA CELDA,
  ' EL EVENTO Data NO SE DISPARA Y EL GRID QUEDA VACÍO AUNQUE EL ANÁLISIS HAYA
  ' ENCONTRADO ERRORES
  With gvTipoDePar
    .Columns.Count = COLUMNAS_PARES
    .Rows.Count = 0
    .Header = GridView.Horizontal
    .ScrollBar = Scroll.Both
    .Resizable = True

    .Columns[0].Title = "Párrafo"
    .Columns[0].Width = 80
    .Columns[0].Alignment = Align.Right

    .Columns[1].Title = "Pos."
    .Columns[1].Width = 60
    .Columns[1].Alignment = Align.Center

    .Columns[2].Title = "Car."
    .Columns[2].Width = 60
    .Columns[2].Alignment = Align.Center

    .Columns[3].Title = "Prof."
    .Columns[3].Width = 60
    .Columns[3].Alignment = Align.Center

    .Columns[4].Title = "Falla"
    .Columns[4].Width = 260
    .Columns[4].Alignment = Align.Left
  End With

  ' --- 6. ESTADO INICIAL ---
  LimpiarPanelPares()
  lblMensajesPares.Text = "Elija un par o escriba uno propio."

End

' ============================================
' Función   : LimpiarPanelPares
' Propósito : Vacía grid, hallazgos y mensaje. Se invoca AL INICIO de cada
'             análisis, antes de producir nada nuevo: un mensaje que sobrevive
'             a la acción siguiente miente.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub LimpiarPanelPares()

  $aHallazgosPares.Clear()
  $aCeldasPares.Clear()

  gvTipoDePar.Rows.Count = 0
  lblMensajesPares.Text = ""

End

' ============================================
' Función   : cmbTipoDePar_Click
' Propósito : Analiza el par elegido. El combo tiene precedencia sobre los
'             textbox: al elegir, los vacía, para no dejar huella de un par
'             ad hoc que ya no es el que se está analizando.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub cmbTipoDePar_Click()

  ' --- 1. SUPRESIÓN DE REENTRADA (SC-06) ---
  If $bPoblandoPares Then Return

  ' --- 2. EL COMBO MANDA: SE BORRA EL PAR AD HOC ---
  txtParIzquierdo.Text = ""
  txtParDerecho.Text = ""

  ' --- 3. LA ENTRADA NEUTRA NO ANALIZA NADA ---
  If cmbTipoDePar.Index <= 0 Then
    LimpiarPanelPares()
    lblMensajesPares.Text = "Elija un par o escriba uno propio."
    Return
  Endif

  ' --- 4. ANÁLISIS ---
  AnalizarParesEnPanel($aParesIzquierdos[cmbTipoDePar.Index], $aParesDerechos[cmbTipoDePar.Index])

End

' ============================================
' Función   : txtParDerecho_KeyPress
' Propósito : Dispara el análisis del par ad hoc con Return o Enter. Es el
'             segundo textbox el que dispara, porque es el último que se
'             completa al tipear.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub txtParDerecho_KeyPress()

  ' --- 1. SOLO RESPONDE A LAS DOS TECLAS DE CONFIRMACIÓN ---
  ' Key.Return ES LA DEL BLOQUE PRINCIPAL Y Key.Enter LA DEL PAD NUMÉRICO:
  ' SON CONSTANTES DISTINTAS Y HAY QUE CONTEMPLAR LAS DOS (RC-GM-10)
  If Key.Code <> Key.Return Then
    If Key.Code <> Key.Enter Then Return
  Endif

  Stop Event

  ' --- 2. EL COMBO PASA A NEUTRO PARA NO MENTIR ---
  ' EL ÚLTIMO ANÁLISIS YA NO ES EL DEL PAR QUE EL COMBO MUESTRA.
  ' CON LA BANDERA LEVANTADA PARA QUE EL CAMBIO NO RELANCE EL ANÁLISIS
  $bPoblandoPares = True
  cmbTipoDePar.Index = 0
  $bPoblandoPares = False

  ' --- 3. ANÁLISIS ---
  AnalizarParesEnPanel(txtParIzquierdo.Text, txtParDerecho.Text)

End

' ============================================
' Función   : AnalizarParesEnPanel
' Propósito : Corre el emparejamiento sobre el texto que está EN PANTALLA y
'             vuelca el resultado al grid y al label. Es el único punto donde
'             el panel habla con m_Pares.
' Parámetros: sIzquierdo As String — carácter de apertura
'             sDerecho As String — carácter de cierre
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub AnalizarParesEnPanel(sIzquierdo As String, sDerecho As String)

  ' --- 1. INICIALIZACIÓN ---
  Dim oResumen As CResumenPares
  Dim oHallazgo As CHallazgoPar
  Dim sTexto As String
  Dim sMensaje As String
  Dim iIndice As Integer

  ' --- 2. LIMPIEZA PREVIA ---
  ' ANTES DE CUALQUIER TRABAJO: SI SE LIMPIARA DESPUÉS, UN RETORNO TEMPRANO
  ' DEJARÍA EN PANTALLA EL RESULTADO DEL ANÁLISIS ANTERIOR
  LimpiarPanelPares()

  ' --- 3. EL TEXTO ES EL DEL EDITOR, NO EL DEL DISCO ---
  ' SI SE ANALIZARA EL ARCHIVO GUARDADO, CORREGIR UNA COMILLA Y REANALIZAR
  ' SEGUIRÍA MOSTRANDO EL ERROR HASTA GUARDAR. INUTILIZABLE PARA CORREGIR
  sTexto = m_EditorPrincipal.Texto()

  If String.Len(sTexto) = 0 Then
    lblMensajesPares.Text = "No hay texto en el editor."
    Return
  Endif

  ' --- 4. ANÁLISIS ---
  oResumen = m_Pares.AnalizarPar(sTexto, sIzquierdo, sDerecho, $aHallazgosPares)

  If Not oResumen.bValido Then
    lblMensajesPares.Text = oResumen.sMotivo
    Return
  Endif

  ' --- 5. FORMATEO DE LAS CELDAS ---
  ' TODO EL FORMATEO OCURRE ACÁ, UNA VEZ. EL EVENTO Data SOLO INDEXA (GV-15).
  ' EL +1 CONVIERTE DE LA NUMERACIÓN DE LA API (0-INDEXADA) A LA QUE LEE UNA
  ' PERSONA. SI LA BARRA DE ESTADO DEL EDITOR MUESTRA EL VALOR CRUDO, EL
  ' AJUSTE SE SACA ACÁ Y SOLO ACÁ: EL DATO GUARDADO NO SE TOCA NUNCA
  For iIndice = 0 To $aHallazgosPares.Max
    oHallazgo = $aHallazgosPares[iIndice]
    $aCeldasPares.Add(CStr(oHallazgo.iParrafo + 1))
    $aCeldasPares.Add(CStr(oHallazgo.iPos + 1))
    $aCeldasPares.Add(oHallazgo.sCaracter)

    ' PROFUNDIDAD EN BLANCO CUANDO NO APLICA —UN CIERRE SIN APERTURA NO TIENE
    ' NIVEL—, PARA NO MOSTRAR UN CERO QUE SE LEERÍA COMO DATO
    If oHallazgo.iProfundidad > 0 Then
      $aCeldasPares.Add(CStr(oHallazgo.iProfundidad))
    Else
      $aCeldasPares.Add("")
    Endif
    $aCeldasPares.Add(m_Pares.DescribirClase(oHallazgo.iClase))
  Next

  gvTipoDePar.Rows.Count = $aHallazgosPares.Count

  ' --- 6. MENSAJE DE ESTADO ---
  ' EL LABEL HABLA SIEMPRE, TAMBIÉN CUANDO NO HAY ERRORES: UN GRID VACÍO NO
  ' DISTINGUE «SIN ERRORES» DE «NO SE ANALIZÓ NADA» (GV-23).
  ' EMPIEZA NOMBRANDO EL PAR PORQUE CON LOS TEXTBOX VACÍOS NO HAY OTRO MODO
  ' DE CONFIRMAR QUÉ SE ESTÁ BUSCANDO
  sMensaje = sIzquierdo & " " & sDerecho & "  ·  " & CStr(oResumen.iPares) & " pares"
  sMensaje &= "  ·  profundidad " & CStr(oResumen.iProfundidadMax)

  ' LA PROFUNDIDAD INUSUAL NO ES UN ERROR NI TIENE POSICIÓN: AVISA QUE ALGO
  ' PASA AUNQUE LA PILA CIERRE, Y POR ESO VA EN EL MENSAJE Y NO EN EL GRID
  If oResumen.bProfundidadInusual Then sMensaje &= " (inusual)"

  If oResumen.iTotalErrores = 0 Then
    sMensaje &= "  ·  sin errores"
  Else
    sMensaje &= "  ·  " & CStr(oResumen.iTotalErrores) & " errores"
    ' EL CORTE SE AVISA: UNA LISTA TRUNCADA SIN AVISO ES OTRA FORMA DE MENTIR
    If $aHallazgosPares.Count < oResumen.iTotalErrores Then
      sMensaje &= " (se muestran " & CStr($aHallazgosPares.Count) & ")"
    Endif
  Endif

  lblMensajesPares.Text = sMensaje

End

' ============================================
' Función   : gvTipoDePar_Data
' Propósito : Entrega el texto de una celda visible del grid.
' Parámetros: iFila As Integer — fila que el control está pintando
'             iColumna As Integer — columna que el control está pintando
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub gvTipoDePar_Data(iFila As Integer, iColumna As Integer)

  ' RUTA CALIENTE: SOLO INDEXACIÓN (GV-15).
  ' LA FIRMA LLEVA LOS DOS PARÁMETROS Y SE VALIDA AL LANZAR, NO AL COMPILAR:
  ' DECLARARLA SIN ELLOS HACE FALLAR LA INSTANCIACIÓN DEL FORMULARIO CON UN
  ' MENSAJE QUE APUNTA A OTRO ARCHIVO (GV-18)
  gvTipoDePar.Data.Text = $aCeldasPares[iFila * COLUMNAS_PARES + iColumna]

End

' ============================================
' Función   : gvTipoDePar_Click
' Propósito : Lleva el cursor del editor al carácter huérfano de la fila
'             elegida y lo deja seleccionado.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub gvTipoDePar_Click()

  ' --- 1. INICIALIZACIÓN ---
  Dim oHallazgo As CHallazgoPar

  If gvTipoDePar.Row < 0 Then Return
  If gvTipoDePar.Row > $aHallazgosPares.Max Then Return

  oHallazgo = $aHallazgosPares[gvTipoDePar.Row]

  ' --- 2. POSICIONAR Y SELECCIONAR EL CARÁCTER HUÉRFANO ---
  ' PÁRRAFO Y POSICIÓN SON BASE 0 (CHallazgoPar). IrA DEJA EL PÁRRAFO EN LA
  ' PRIMERA FILA DE LA VISTA (GV-52) Y REEMPLAZA A GotoCenter + Select
  m_EditorPrincipal.IrA(m_EditorPrincipal.PosicionDe(oHallazgo.iParrafo, oHallazgo.iPos), 1)

  ' --- 3. DEVOLVER EL FOCO AL EDITOR ---
  ' EL CLICK EN EL GRID SE LLEVÓ EL FOCO Y EL FLUJO NATURAL ES SEGUIR
  ' ESCRIBIENDO EN EL EDITOR (RC-GM-07). VA AL FINAL, Y SIN Try: SU FALLO NO
  ' COMPROMETE NINGÚN DATO (RC-GM-08)
  txtEditorProyecto.SetFocus()

End

