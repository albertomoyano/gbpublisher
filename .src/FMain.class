' ============================================
' Función   : cmbImagenes_Click
' Propósito : AL CAMBIAR LA SELECCIÓN, CARGAR LA IMAGEN VÍA EL MÓDULO. SI EL USUARIO
'             CANCELA EL DESCARTE DE CAMBIOS, REVERTIR EL Index SIN DISPARAR OTRO _Click.
' Parámetros: (NINGUNO — EVENTO DE UI)
' Retorna   : (NADA)
' ============================================
Public Sub cmbImagenes_Click()

  ' --- 1. SUPRESIÓN: SI ESTAMOS REVIRTIENDO EL Index, NO REPROCESAR (ANTI-LOOP) ---
  If bRevirtiendoComboImagen Then Return

  ' --- 1.1 SUPRESIÓN: REPOBLADO EN CALIENTE DE PoblarComboImagenes ---
  ' EL Click VIENE DE REPONER EL Index (GV-53), NO DEL USUARIO: LA FIGURA EN
  ' MEMORIA NO SE RECARGA NI SE PREGUNTA POR SUS CAMBIOS
  If bPoblandoComboImagen Then Return

  ' --- 2. INTENTAR CARGAR LA IMAGEN SELECCIONADA ---
  ' CargarImagen APLICA EL GUARD ConfirmarDescartarCambios INTERNAMENTE.
  ' DEVUELVE True SOLO SI LA CARGA SE CONCRETÓ; False SI EL USUARIO CANCELÓ O FALLÓ.
  If m_GestionImagenes.CargarImagen() Then
    ' --- 2.1 ÉXITO: RECORDAR EL ÍNDICE EFECTIVAMENTE CARGADO ---
    iIndiceImagenCargada = cmbImagenes.Index
  Else
    ' --- 2.2 CANCELADO/FALLIDO: REVERTIR EL Index AL DE LA IMAGEN EN MEMORIA ---
    ' LA BANDERA EVITA QUE ESTA REASIGNACIÓN VUELVA A DISPARAR EL _Click
    bRevirtiendoComboImagen = True
    cmbImagenes.Index = iIndiceImagenCargada
    bRevirtiendoComboImagen = False
  Endif

End

