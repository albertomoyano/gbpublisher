' ============================================
' Función   : AplicarTransformacionCase
' Propósito : Convierte la selección del editor a mayúsculas o minúsculas,
'             conservando la selección para encadenar acciones.
' Parámetros: bAMayusculas As Boolean — True para mayúsculas, False para minúsculas
'             sNombreFormato As String — etiqueta legible ("mayúsculas" / "minúsculas")
' Retorna   : nada
' ============================================
Private Sub AplicarTransformacionCase(bAMayusculas As Boolean, sNombreFormato As String)

  ' --- 1. VALIDACIÓN DE ENTRADA: HAY TEXTO SELECCIONADO ---
  ' EVITAR LA TRANSFORMACIÓN SOBRE UNA SELECCIÓN VACÍA, QUE NO TIENE EFECTO ÚTIL
  If m_EditorPrincipal.LargoSeleccion() = 0 Then
    m_Sonido.sonar("Warning")
    Message.Warning("Debe seleccionar texto para convertir a " & sNombreFormato & ".")
    txtEditorProyecto.SetFocus()
    Return
  Endif

  ' --- 2. TRANSFORMACIÓN ---
  ' TextEdit NO TIENE UpperCase / LowerCase. CambiarCaja USA LAS TABLAS DE GV-03,
  ' NO UCase / LCase, QUE DEPENDEN DEL LOCALE. SI FALLA, EL MÓDULO YA INFORMÓ
  m_EditorPrincipal.CambiarCaja(bAMayusculas)

  ' --- 3. RESTAURAR FOCO EN EL EDITOR (RC-GM-07) ---
  txtEditorProyecto.SetFocus()

End

' ============================================
' Función   : btnUpperCase_Click
' Propósito : Convierte el texto seleccionado del editor a mayúsculas.
' ============================================
Public Sub btnUpperCase_Click()

  AplicarTransformacionCase(True, "mayúsculas")

End

' ============================================
' Función   : btnConvertirMinusculas_Click
' Propósito : Convierte el texto seleccionado del editor a minúsculas.
' ============================================
Public Sub btnConvertirMinusculas_Click()

  AplicarTransformacionCase(False, "minúsculas")

End

