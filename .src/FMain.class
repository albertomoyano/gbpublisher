  If tbGoTo.Value Then
    hbGoTo.Visible = True
  Else
    hbGoTo.Visible = False
    vLinea.Text = ""
  Endif

End

' ============================================
' Función   : LoadFontSettings
' Propósito : Lee la configuración tipográfica guardada y la
'             aplica a la interfaz y a los editores
' ============================================
Private Sub LoadFontSettings()

  ' --- 1. Abrir archivo de configuración ---
  Dim sConfigPath As String = m_InicioCierre.RutaConfiguracion()
  Dim hSettings As New Settings(sConfigPath)

  ' --- 2. Tipografía de la interfaz ---
  Dim iInterfaceSize As Integer = 13  ' VALOR POR DEFECTO

  Try iInterfaceSize = CInt(hSettings["Interface/FontSize"])
  If Error Or iInterfaceSize < 8 Or iInterfaceSize > 20 Then iInterfaceSize = 10

  ' --- 3. Tipografía de los editores ---
  Dim sEditorFont As String = "IBM Plex Mono"  ' VALOR POR DEFECTO
  Dim iEditorSize As Integer = 13               ' VALOR POR DEFECTO
  Try sEditorFont = CStr(hSettings["Editor/FontName"])
  If Error Or sEditorFont = "" Then sEditorFont = "IBM Plex Mono"
  Try iEditorSize = CInt(hSettings["Editor/FontSize"])
  If Error Or iEditorSize < 8 Or iEditorSize > 24 Then iEditorSize = 13

End Sub

' ============================================
' Función   : menuTypo_Click
' Propósito : Elegir la tipografía de los editores coloreados (Markdown y XML)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub menuTypo_Click()

  Dim hFuente As Font

  ' --- 1. DIÁLOGO CON LA FUENTE ACTUAL ---
  Dialog.Font = m_ResaltadoSintaxis.FuenteActual()
  If Dialog.SelectFont() Then Return  ' EL USUARIO CANCELÓ

  ' --- 2. EL MÓDULO LA APLICA A TODOS LOS VISORES, LA GUARDA EN gbpublisher.conf ---
  ' Y LA REPONE DESPUÉS DE CADA CARGA (GV-37, SC-15)
  hFuente = Dialog.Font
  m_ResaltadoSintaxis.AplicarFuente(hFuente.Name, hFuente.Size)

  ' --- 3. FOCO AL EDITOR (RC-GM-07) ---
  txtEditorProyecto.SetFocus()

End

