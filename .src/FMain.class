Private Function ObtenerDescripcionTipo(iTipo As Integer) As String

  Select Case iTipo
    Case m_Constantes.TIPO_REVISTA_MD
      Return "Revista MD"
    Case m_Constantes.TIPO_LIBRO_MD
      Return "Libro MD"
    Case m_Constantes.TIPO_LIBRO_LATEX
      Return "Libro LaTeX"
    Default
      Return "Tipo desconocido (" & iTipo & ")"
  End Select

End

' ============================================
' Función   : DetenerBashEnCurso
' Propósito : Punto único para detener el proceso bash de la terminal
'             embebida. Reintenta Kill hasta 20 veces con pausas de 50 ms,
'             avisa si no lo logra y anula siempre la referencia.
'             Reemplaza las cuatro copias que existían en FMain,
'             m_ConexionBD, m_InicioCierre y FProyectosParcial.
' Parámetros: (ninguno)
' Retorna   : nada
' ============================================
Public Sub DetenerBashEnCurso()

  Dim iIntentos As Integer

  ' --- 1. VALIDAR QUE EXISTE Y ESTÁ CORRIENDO ---
  If Not $Bash Then Return
  If Not Object.IsValid($Bash) Then
    $Bash = Null
    Return
  Endif
  If $Bash.State <> Process.Running Then
    $Bash = Null
    Return
  Endif

  ' --- 2. REINTENTAR Kill ---
  ' WAIT PROCESA EVENTOS PARA QUE State SE ACTUALICE ENTRE INTENTOS.
  ' TRY: EL PROCESO PUEDE MORIR ENTRE LA COMPROBACIÓN Y EL Kill
  While $Bash.State = Process.Running And iIntentos < 20
    Try $Bash.Kill
    Wait 0.05
    Inc iIntentos
  Wend

  ' --- 3. AVISAR SI NO SE DETUVO ---
  ' KILL ENVÍA SIGKILL: NO HAY SEÑAL MÁS FUERTE A LA QUE RECURRIR.
  ' PROCESS NO TIENE Terminate (DETECTADO CON gbc3 -p)
  If $Bash.State = Process.Running Then
    m_Sonido.sonar("Warning")
    Message.Warning("El proceso bash no pudo ser detenido.")
  Endif

  ' --- 4. ANULAR LA REFERENCIA ---
  $Bash = Null

End

' ============================================
' Función   : InicializarTerminalProyecto
' Propósito : Crear (o recrear) el proceso bash
'             de la terminal embebida, matando
'             el anterior si existiera
' Parámetros: sRutaDirectorio As String — directorio de trabajo inicial
' Retorna   : nada
' ============================================
Public Sub InicializarTerminalProyecto(sRutaDirectorio As String)

  ' --- 1. CERRAR PROCESO ANTERIOR SI EXISTE ---
  DetenerBashEnCurso()

  ' --- 2. INICIAR PROCESO NUEVO ---
  $Bash = TerminalViewProyecto.Shell("/usr/bin/bash")
  Wait 0.1
  ' --- 3. POSICIONAR EN EL DIRECTORIO DEL PROYECTO ---
  TerminalViewProyecto.Input("cd " & Quote$(sRutaDirectorio) & "\n")
  TerminalViewProyecto.Input("clear\n")

End

' CARGA LA LISTA DE ARCHIVOS MARKDOWN DEL PROYECTO EN EL COMBOBOX
' INCLUYE: ARCHIVO PRINCIPAL + ARCHIVOS DE FRONT-MATTER + ARTÍCULOS + BACK-MATTER
' PARÁMETRO OPCIONAL: bPreservarSeleccion - SI ES TRUE, INTENTA MANTENER EL ARCHIVO SELECCIONADO
Public Sub CargarListaArticulosMD(Optional bPreservarSeleccion As Boolean = False)

  Dim sRutaFrontMatter As String
  Dim sRutaArticulos As String
  Dim sRutaBackMatter As String
  Dim aArchivosFront As String[]
  Dim aArchivosArticulos As String[]
  Dim aArchivosBack As String[]
  Dim sArchivo As String
  Dim sSeleccionAnterior As String
  Dim iIndiceAnterior As Integer

  ' GUARDAR LA SELECCIÓN ACTUAL SI SE REQUIERE PRESERVARLA
  If bPreservarSeleccion And cmbArticulosRevista.Count > 0 Then
    iIndiceAnterior = cmbArticulosRevista.Index
    If iIndiceAnterior >= 0 Then
      sSeleccionAnterior = cmbArticulosRevista.Text
    Endif
  Endif

  ' LIMPIAR EL COMBOBOX
  cmbArticulosRevista.Clear()
  cmbArticulosRevista.Text = ""
  cmbArticulosRevista.Refresh

  ' AGREGAR PRIMERO EL ARCHIVO PRINCIPAL DEL PROYECTO
  cmbArticulosRevista.Add(m_InicioCierre.NombreProyectoEnCurso)

  ' CONSTRUIR RUTAS A LAS TRES CARPETAS
  sRutaFrontMatter = m_InicioCierre.RutaProyectoEnCurso &/ "front-matter"
  sRutaArticulos = m_InicioCierre.RutaProyectoEnCurso &/ "articulos"
  sRutaBackMatter = m_InicioCierre.RutaProyectoEnCurso &/ "back-matter"

  ' CARGAR ARCHIVOS DE FRONT-MATTER
  If Exist(sRutaFrontMatter) Then
    aArchivosFront = Dir(sRutaFrontMatter, "*.md")
    If aArchivosFront Then
      aArchivosFront.Sort()
      For Each sArchivo In aArchivosFront
        cmbArticulosRevista.Add("front-matter/" & sArchivo)
      Next
    Endif
  Endif

  ' CARGAR ARCHIVOS DE ARTÍCULOS
  If Exist(sRutaArticulos) Then
    aArchivosArticulos = Dir(sRutaArticulos, "*.md")
    If aArchivosArticulos Then
      aArchivosArticulos.Sort()
      For Each sArchivo In aArchivosArticulos
        cmbArticulosRevista.Add("articulos/" & sArchivo)
      Next
    Endif
  Endif

  ' CARGAR ARCHIVOS DE BACK-MATTER
  If Exist(sRutaBackMatter) Then
    aArchivosBack = Dir(sRutaBackMatter, "*.md")
    If aArchivosBack Then
      aArchivosBack.Sort()
      For Each sArchivo In aArchivosBack
        cmbArticulosRevista.Add("back-matter/" & sArchivo)
      Next
    Endif
  Endif

  ' --- RESTAURAR SELECCIÓN O SELECCIONAR EL ARCHIVO PRINCIPAL ---
  ' EL EDITOR SE CARGA EN cmbArticulosRevista_Click AL ASIGNAR EL Index. PARA
  ' PROYECTOS RECIÉN ABIERTOS EL Index PASA DE -1 (POST-Clear) A iDestino, LO QUE
  ' SIEMPRE ES UNA TRANSICIÓN REAL Y DISPARA EL EVENTO SIN NECESIDAD DE FORZARLA.
  Dim i As Integer
  Dim iDestino As Integer = 0

  If bPreservarSeleccion Then
    If sSeleccionAnterior <> "" Then
      For i = 0 To cmbArticulosRevista.Count - 1
        If cmbArticulosRevista[i].Text = sSeleccionAnterior Then
          iDestino = i
          Break
        Endif
      Next
    Endif
  Endif

  cmbArticulosRevista.Index = iDestino

End

