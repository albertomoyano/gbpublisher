Public Sub txtPages_Change()

  Dim curpos As Integer

  curpos = txtPages.pos

  Dim texto As String

  texto = Trim(txtPages.Text)

  texto = Replace(texto, "  ", " ")
  texto = Replace(texto, "–", "-")
  texto = Replace(texto, "--", "-")
  texto = Replace(texto, " -", "-")
  texto = Replace(texto, "- ", "-")
  texto = Replace(texto, " a ", "-")
  texto = Replace(texto, ".", "")
  texto = Replace(texto, " al ", "-")

  txtPages.Text = Trim(texto)

  ' Restaura la posición del cursor
  txtPages.pos = curpos

End

