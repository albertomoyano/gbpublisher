' ============================================
' Función   : AplicarFiltroEstructura
' Propósito : Pasar al árbol los filtros elegidos en los RadioButton
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub AplicarFiltroEstructura()

  Dim iNivelMax As Integer
  Dim sPrefijo As String

  ' --- 1. PROFUNDIDAD: 1 SOLO CAPÍTULOS, 2 HASTA ##, 3 HASTA ###, 6 TODO ---
  iNivelMax = 6
  If rbCapitulo.Value Then iNivelMax = 1
  If rbH2.Value Then iNivelMax = 2
  If rbH3.Value Then iNivelMax = 3

  ' --- 2. ALCANCE: PREFIJO DEL NOMBRE DE ARCHIVO; VACÍO ES TODOS ---
  sPrefijo = ""
  If rbAlcFM.Value Then sPrefijo = "fm-"
  If rbAlcA.Value Then sPrefijo = "a-"
  If rbAlcBM.Value Then sPrefijo = "bm-"

  m_Estructura.Filtrar(iNivelMax, sPrefijo)

End

