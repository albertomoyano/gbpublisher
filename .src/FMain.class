' ============================================
' Función   : ConfirmarDescartarCambios
' Propósito : Si hay cambios sin guardar en el archivo abierto en el editor,
'             pregunta al usuario si guardar, descartar o cancelar. Encapsula
'             el patrón canónico de "guard antes de cambiar de contexto".
' Parámetros: (ninguno)
' Retorna   : Boolean — True si se puede continuar (guardó o descartó),
'             False si el usuario canceló y el flujo debe abortar.
' ============================================
Public Function ConfirmarDescartarCambios() As Boolean

  Dim iRespuesta As Integer

  ' --- 1. SIN ARCHIVO ABIERTO: NO HAY NADA QUE GUARDAR ---
  If sRutaArchivoAbierto = "" Then Return True

  ' --- 2. SIN CAMBIOS: NO HAY NADA QUE PREGUNTAR ---
  If Not m_EditorPrincipal.HayCambios() Then Return True

  ' --- 3. HAY CAMBIOS: PREGUNTAR AL USUARIO ---
  m_Sonido.sonar("Warning")
  iRespuesta = Message.Question("Hay cambios sin guardar en " & gb.NewLine &
    File.Name(sRutaArchivoAbierto) & gb.NewLine & gb.NewLine &
    "¿Desea guardar los cambios antes de continuar?",
    "Guardar", "Descartar", "Cancelar")

  ' --- 4. PROCESAR LA RESPUESTA ---
  Select Case iRespuesta
    Case 1
      ' GUARDAR: DELEGAMOS AL EVENTO DEL BOTÓN, QUE YA TIENE TODO EL FLUJO
      ' (FILE.SAVE, ACTUALIZAR SNAPSHOT, REFRESCAR REFERENCIAS Y GRID)
      btnGuardarCambiosEditor_Click()
      Return True

    Case 2
      ' DESCARTAR: SINCRONIZAR EL SNAPSHOT PARA QUE FUTUROS CHEQUEOS
      ' NO VUELVAN A DETECTAR DIFERENCIAS HASTA UNA NUEVA EDICIÓN
      m_EditorPrincipal.MarcarGuardado()
      Return True

    Case Else
      ' CANCELAR O CERRAR DIÁLOGO (0)
      Return False

  End Select

End

' ============================================
' Función   : AbrirFormularioModoMedia
' Propósito : Punto de entrada al modo parcial (solo BBDD, sin editor).
'             Antes de abrir el formulario de selección de proyecto parcial,
'             verifica que no haya cambios sin guardar en el proyecto actual.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub AbrirFormularioModoMedia()

  Dim rs As Result
  Dim sSQL As String
  Dim iCantidadProyectos As Integer

  ' --- 1. GUARD: CAMBIOS SIN GUARDAR EN EL PROYECTO PREVIO ---
  ' SE EVALÚA ANTES DE TOCAR NADA. SI EL USUARIO CANCELA, EL FLUJO ABORTA
  ' SIN ABRIR NI EL FORMULARIO DE SELECCIÓN NI HACER CONSULTAS A BD
  If Not ConfirmarDescartarCambios() Then Return

  ' --- 2. VERIFICAR QUE EXISTEN PROYECTOS ACTIVOS EN BD ---
  sSQL = "SELECT COUNT(*) AS total FROM proyectos WHERE activo = 1"
  Try rs = m_ConexionBD.mConn.Exec(sSQL)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo consultar la base de datos:" & gb.NewLine & Error.Text)
    Return
  Endif

  iCantidadProyectos = rs["total"]
  If iCantidadProyectos = 0 Then
    m_Sonido.sonar("Warning")
    Message.Warning("No hay proyectos activos para abrir en modo parcial.")
    Return
  Endif

  ' --- 3. ABRIR EL FORMULARIO DE SELECCIÓN DE PROYECTO PARCIAL ---
  FProyectosParcial.ShowModal()

End

' ============================================
' Función   : AbrirProyecto
' Propósito : Punto de entrada único para abrir un proyecto desde el menú.
'             Verifica cambios sin guardar del proyecto previo, configura el
'             diálogo según el tipo, y delega la carga al handler específico.
' Parámetros: nTipoProyecto As Integer — uno de m_Constantes.TIPO_*
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub AbrirProyecto(nTipoProyecto As Integer)

  ' --- 1. GUARD: CAMBIOS SIN GUARDAR EN EL PROYECTO PREVIO ---
  ' SE VERIFICA ANTES DE TODO LO DEMÁS PARA QUE LA PREGUNTA APAREZCA
  ' EN EL CONTEXTO CORRECTO (PROYECTO ANTERIOR, NO EL NUEVO)
  If Not ConfirmarDescartarCambios() Then Return

  ' --- 2. CONFIGURAR EL DIÁLOGO SEGÚN EL TIPO DE PROYECTO ---
  ' RC-GM-19: EL FILTRO ES COMODIDAD VISUAL Y NO VALIDACIÓN. EN Qt5 ES
  ' CASE-INSENSITIVE, ASÍ QUE l-*.md LISTA TAMBIÉN l-LIBRO.MD.
  Select Case nTipoProyecto
    Case m_Constantes.TIPO_REVISTA_MD
      Dialog.Title = "Abrir proyecto en Markdown"
      Dialog.Filter = ["r-*.md", "Markdown"]
    Case m_Constantes.TIPO_LIBRO_MD
      Dialog.Title = "Abrir libro (Markdown)"
      Dialog.Filter = ["l-*.md", "Libro en Markdown"]
    Case Else
      m_Sonido.sonar("Error")
      Message.Error("Tipo de proyecto no contemplado: " & CStr(nTipoProyecto))
      Return
  End Select

  m_Sonido.sonar("Info")
  Dialog.AutoExt = False
  Dialog.Path = User.Home

  ' --- 3. MOSTRAR EL DIÁLOGO Y MANEJAR CANCELACIÓN ---
  ' Dialog.OpenFile RETORNA True CUANDO EL USUARIO CANCELA
  If Dialog.OpenFile() Then Return

  ' --- 4. GUARDAR EL TIPO ELEGIDO PARA QUE OTRAS RUTINAS LO USEN ---
  TipoProyectoActual = nTipoProyecto

  ' --- 5. ACTIVAR LA BANDERA DE APERTURA EN CURSO ---
  ' EVITA QUE EL Click DE cmbArticulosRevista DISPARE OTRA VEZ EL GUARD
  ' CUANDO CargarListaArticulosMD ASIGNE EL Index DEL COMBOBOX
  bAbriendoProyecto = True

  ' --- 6. DELEGAR LA CARGA AL HANDLER ESPECÍFICO DEL TIPO ---
  ' SI LA APERTURA ABORTÓ, SE SALE SIN TOCAR NADA DE LA UI: EL USUARIO SIGUE
  ' EN SU PROYECTO ANTERIOR Y LOS PANELES DEBEN SEGUIR DESCRIBIÉNDOLO.
  ' bAbriendoProyecto SE APAGA ACÁ PORQUE ESTE Return SALTEA EL APARTADO 8:
  ' SI QUEDARA EN True, EL PRÓXIMO cmbArticulosRevista_Click SUPRIMIRÍA EL
  ' GUARD DE CAMBIOS SIN GUARDAR Y EL USUARIO PERDERÍA TRABAJO SIN AVISO
  If Not AbrirProyectoMD(nTipoProyecto) Then
    bAbriendoProyecto = False
    Return
  Endif

  m_Shortcodes.InicializarTabShortcodes(cmbShortcodes, lbDefiniciones, txtAyudaShortcode)
  m_RevisarPDF.PoblarComboPDF()
  m_GestionImagenes.PoblarComboImagenes()
  m_BuscarRegex.InicializarTabRegex()
  m_RegexResultados.InicializarTab()
  m_BuscarReemplazar.InicializarTab()
  m_AnalizarProyecto.InicializarTabAnalizar()
  m_Validaciones.InicializarTab()

  FMain.PanelRetocarImagenes.Visible = True
  FMain.PanelRevisarPDF.Visible = True
  FMain.PanelShortCodes.Visible = True
  FMain.pREGEX.Visible = True

  ' --- 7. COPIA DE RECURSOS LaTeX (SOLO LIBROS) ---
  ' LA SALIDA PDF DE REVISTAS NO SALE DE LA APP Y NO NECESITA LOS PREÁMBULOS
  ' EN LA CARPETA DEL PROYECTO.
  ' SE COPIA TAMBIÉN AL GENERAR EL main.tex, PORQUE UNA ACTUALIZACIÓN DE
  ' gbpublisher ENTRE LA APERTURA Y LA COMPILACIÓN DEJARÍA EL PROYECTO CON
  ' PREÁMBULOS VIEJOS, Y \gbRequiereContrato NO FRENARÍA: LA COPIA LOCAL SERÍA
  ' VIEJA PERO CONSISTENTE.
  ' NO SE ABORTA SI FALLA: EL PROYECTO SE ABRE IGUAL Y EL PROBLEMA SE DETECTA
  ' AL GENERAR, QUE ES DONDE IMPORTA.
  If nTipoProyecto = m_Constantes.TIPO_LIBRO_MD Then
    m_InicioCierre.CopiarRecursosLatex(m_InicioCierre.RutaProyectoEnCurso &/ "latex", True)
  Endif

  ' PANEL DE ANÁLISIS DE PARES
  InicializarPanelPares()

  ' --- REFRESCAMOS EL COMBOBOX ---
  cmbArticulosRevista.Refresh

  ' --- 8. DESACTIVAR LA BANDERA AL TERMINAR LA APERTURA ---
  bAbriendoProyecto = False

End

' MANEJA LA SELECCIÓN DE ARCHIVOS MARKDOWN DEL COMBOBOX
' VERIFICA CAMBIOS SIN GUARDAR ANTES DE CAMBIAR DE ARCHIVO
' CARGA EL CONTENIDO DEL ARCHIVO SELECCIONADO EN EL EDITOR
Public Sub cmbArticulosRevista_Click()

  Dim sArchivoSeleccionado As String
  Dim sRutaCompleta As String
  Dim sContenido As String

  ' VERIFICAR QUE HAY ALGO SELECCIONADO
  If cmbArticulosRevista.Index = -1 Then Return

  ' OBTENER EL ARCHIVO SELECCIONADO
  sArchivoSeleccionado = cmbArticulosRevista.Text
  If sArchivoSeleccionado = "" Then Return

  ' DETERMINAR LA RUTA COMPLETA SEGÚN LA SELECCIÓN
  If cmbArticulosRevista.Index = 0 Then
    ' ES EL ARCHIVO PRINCIPAL DEL PROYECTO
    sRutaCompleta = txtProyecto.Text
  Else
    ' ES UN ARCHIVO DE ALGUNA DE LAS SUBCARPETAS
    ' EL TEXTO YA INCLUYE LA RUTA RELATIVA (front-matter/, articulos/, back-matter/)
    sRutaCompleta = m_InicioCierre.RutaProyectoEnCurso &/ sArchivoSeleccionado
  Endif

  ' --- EL ARCHIVO YA ESTÁ ABIERTO: NO SE RECARGA (GV-53) ---
  ' ASIGNAR Index DISPARA Click AUNQUE EL ÍNDICE NO CAMBIE. CUANDO EL TEMPORIZADOR
  ' DE ARCHIVOS RECARGA LA LISTA Y REPONE LA SELECCIÓN, ESTO RECARGABA EL MISMO
  ' ARCHIVO: PREGUNTABA POR CAMBIOS SIN GUARDAR Y VACIABA EL DESHACER (GV-46)
  If sRutaCompleta = sRutaArchivoAbierto Then Return

  ' --- VERIFICAR CAMBIOS SIN GUARDAR (SALVO QUE SE ESTÉ ABRIENDO UN PROYECTO) ---
  ' DURANTE LA APERTURA, EL GUARD YA SE EVALUÓ EN AbrirProyecto Y NO DEBE
  ' VOLVER A PREGUNTAR CUANDO CargarListaArticulosMD ASIGNE EL Index INICIAL.
  ' VA DESPUÉS DE LA RUTA: CALCULARLA NO TOCA NADA (SC-06)
  If Not bAbriendoProyecto Then
    If Not ConfirmarDescartarCambios() Then Return
  Endif

  ' VERIFICAR QUE EL ARCHIVO EXISTE
  If Not Exist(sRutaCompleta) Then
    m_Sonido.sonar("Error")
    Message.Error("El archivo no existe:" & gb.NewLine & sRutaCompleta)
    Return
  Endif

  ' CARGAR EL CONTENIDO EN EL EDITOR
  Try sContenido = File.Load(sRutaCompleta)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al cargar el archivo:" & gb.NewLine & Error.Text)
    Return
  Endif

  ' UN ARCHIVO VACÍO ES UN ESTADO VÁLIDO (CAPÍTULO RECIÉN CREADO, O UN l-*.md
  ' CUYO CONTENIDO VIVE EN LOS CAPÍTULOS) Y SE CARGA COMO CUALQUIER OTRO. EL
  ' FALLO DE LECTURA YA LO ATAJA EL Try DE ARRIBA. NO REINTRODUCIR UN
  ' If sContenido: CON EL ARCHIVO VACÍO DEJABA EL EDITOR MOSTRANDO EL ARCHIVO
  ' ANTERIOR MIENTRAS EL COMBO MOSTRABA EL NUEVO, Y EL GUARDADO IBA AL ANTERIOR.
  ' PUNTO DE REFRESCO 2 DE SC-18; Cargar TOMA TAMBIÉN EL PUNTO DE CONTROL.
  ' SI FALLA, YA INFORMÓ Y SE CONSERVA EL ARCHIVO ANTERIOR COMO ABIERTO
  If Not m_EditorPrincipal.Cargar(sContenido) Then Return
  sRutaArchivoAbierto = sRutaCompleta

  ' LLENAR EL GRID CON LAS MARCAS EXISTENTES
  m_GestorComentarios.ActualizarGridComentarios(gvComentarios, m_EditorPrincipal.Texto())

  ' ACTUALIZAMOS EL CONTEO DE LINEAS
  ActualizarContadorLineas()

  ' ====================================================
  ' ACTUALIZAR id_articulo (REVISTAS) O id_capitulo (LIBROS)
  ' SEGÚN EL ARCHIVO SELECCIONADO Y SU CARPETA DE ORIGEN.
  '
  ' LA FUENTE DE VERDAD DEL CAPÍTULO ES m_InicioCierre.IdCapituloEnCurso
  ' (RC-GM-11). LOS ValueBox id_articulo / id_capitulo SE ESCRIBEN SOLO
  ' POR REDUNDANCIA VISUAL (DEBUGGING).
  ' NO LEER LOS ValueBox EN OTROS HANDLERS — LEER LAS GLOBALES.
  ' ====================================================
  id_articulo.Value = 0
  id_capitulo.Value = 0
  m_InicioCierre.IdCapituloEnCurso = 0

  ' --- REVISTAS: SIN id ---
  ' EL ARTÍCULO DEL EDITOR LO DA EL ARCHIVO ABIERTO (m_GenerarSalidasRevista.
  ' ArticuloDelEditor, m_Cuadros). HASTA EL 18/11/2026 ACÁ SE BUSCABA EL id EN
  ' LA TABLA VIEJA articulos (SC-98)

  ' --- LIBROS: front-matter/, articulos/ Y back-matter/ TODOS POPULAN id_capitulo ---
  ' EL MISMO ARCHIVO articulos/a-NN-X.md SIRVE DE FUENTE EN REVISTAS Y EN LIBROS.
  ' AMBAS RAMAS PUEDEN POPULAR SUS RESPECTIVOS IDs SIN INTERFERENCIA: SOLO
  ' UNO DE LOS DOS RESOLVERÁ EN BD SEGÚN EL TIPO DEL PROYECTO.
  Dim sCarpeta As String = ""
  Dim sNombreArchivoCap As String = ""

  Select Case True
    Case Left(sArchivoSeleccionado, 13) = "front-matter/"
      sCarpeta = "front-matter/"
      sNombreArchivoCap = File.BaseName(Mid(sArchivoSeleccionado, 14))
    Case Left(sArchivoSeleccionado, 10) = "articulos/"
      sCarpeta = "articulos/"
      sNombreArchivoCap = File.BaseName(Mid(sArchivoSeleccionado, 11))
    Case Left(sArchivoSeleccionado, 12) = "back-matter/"
      sCarpeta = "back-matter/"
      sNombreArchivoCap = File.BaseName(Mid(sArchivoSeleccionado, 13))
  End Select

  If sCarpeta <> "" And sNombreArchivoCap <> "" Then
    ' VALIDAR PREFIJO Y EXCLUIR EL COLOFÓN RESERVADO
    Dim sPrefijoTres As String = Left(sNombreArchivoCap, 3)
    Dim sPrefijoDos As String = Left(sNombreArchivoCap, 2)
    Dim bPrefijoValido As Boolean
    bPrefijoValido = (sPrefijoTres = "fm-" Or sPrefijoTres = "bm-" Or sPrefijoDos = "a-")

    If bPrefijoValido And sNombreArchivoCap <> "bm-99-colofon" Then
      Dim hResultCap As Result
      Try hResultCap = m_ConexionBD.mConn.Exec(
        "SELECT id_capitulo FROM capitulos WHERE nombre_archivo = &1 AND id_proyecto = &2 LIMIT 1",
        sNombreArchivoCap,
        id_proyecto.Value)
      If Not Error Then
        If hResultCap.Available Then
          id_capitulo.Value = hResultCap["id_capitulo"]
          m_InicioCierre.IdCapituloEnCurso = hResultCap["id_capitulo"]
        Endif
      Endif
    Endif
  Endif

  ' --- ACTUALIZAR DISPONIBILIDAD DE rbEnCurso EN EL BUSCADOR REGEXP ---
  ' EL ÁMBITO "ARCHIVO EN CURSO" SOLO TIENE SENTIDO SI EL ARCHIVO CARGADO ES
  ' CONTENIDO (fm-/a-/bm-). AL CAMBIAR DE ARCHIVO SE REEVALÚA.
  m_BuscarRegex.ActualizarDisponibilidadEnCurso()

  ' --- EL ÁRBOL DESPLIEGA ESTE CAPÍTULO Y MARCA LA POSICIÓN DEL CURSOR ---
  m_Estructura.SeguirEditor(True)

  ' --- REFRESCAMOS EL COMOBOBOX ---
  cmbArticulosRevista.Refresh

End

' ============================================
' Función   : btnMetadatosLibro_Click
' Propósito : Abre los metadatos del libro y, al cerrarse, prepara la tapa
'             para el portal si se guardó (SC-81)
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub btnMetadatosLibro_Click()

  ' --- 1. LA MARCA EMPIEZA BAJA: SOLO LA LEVANTA UN GUARDADO ---
  m_TapaWeb.Pendiente = False
  FMetadatosLibro.ShowModal()

  ' --- 2. LA TAPA DEL PORTAL, CON EL FORMULARIO YA CERRADO ---
  ' LA LANZADORA ESCRIBE EN LA TERMINAL DE FMain, QUE EL FORMULARIO MODAL TAPA
  m_TapaWeb.AtenderPendiente()

End

