' ============================================
' Función   : AplicarMarcadorMarkdown
' Propósito : Envuelve el texto seleccionado en el editor con un marcador
'             Markdown (negrita, cursiva, etc.) tras validar la selección.
' Parámetros: sMarcador As String  — secuencia que envuelve el texto
'                                    (ej. "**" para Bold, "*" para Italic)
'             sNombreFormato As String — etiqueta legible para los mensajes
' Retorna   : nada
' ============================================
Private Sub AplicarMarcadorMarkdown(sMarcador As String, sNombreFormato As String)

  Dim sTextoSeleccionado As String
  Dim sNuevoTexto As String
  Dim sDobleLF As String
  Dim sDobleCRLF As String

  ' --- 1. INICIALIZACIÓN DE CONSTANTES LOCALES ---
  ' DEFINIMOS LOS PATRONES DE PÁRRAFO VACÍO PARA DETECTAR SELECCIONES MULTIPÁRRAFO
  sDobleLF = Chr(10) & Chr(10)
  sDobleCRLF = Chr(13) & Chr(10) & Chr(13) & Chr(10)

  ' --- 2. VALIDACIÓN DE ENTRADA: HAY TEXTO SELECCIONADO ---
  sTextoSeleccionado = m_EditorPrincipal.TextoSeleccionado()
  If String.Len(sTextoSeleccionado) = 0 Then
    m_Sonido.sonar("Warning")
    Message.Warning("Debe seleccionar texto para aplicar formato " & sNombreFormato & ".")
    Return
  Endif

  ' --- 3. VALIDACIÓN DE ENTRADA: SELECCIÓN NO ATRAVIESA PÁRRAFOS ---
  ' LOS MARCADORES MARKDOWN INLINE NO PUEDEN CRUZAR UN PÁRRAFO VACÍO
  If (String.InStr(sTextoSeleccionado, sDobleLF) > 0) Or (String.InStr(sTextoSeleccionado, sDobleCRLF) > 0) Then
    m_Sonido.sonar("Warning")
    Message.Warning("La selección contiene líneas vacías." & gb.NewLine &
      "No se puede aplicar formato " & sNombreFormato & " a través de párrafos separados.")
    Return
  Endif

  ' --- 4. APLICACIÓN DEL MARCADOR E INSERCIÓN ---
  sNuevoTexto = sMarcador & sTextoSeleccionado & sMarcador
  ' CAMBIO PUNTUAL: CONSERVA EL DESHACER; SI FALLA, EL MÓDULO YA INFORMÓ
  If Not m_EditorPrincipal.Insertar(sNuevoTexto) Then
    txtEditorProyecto.SetFocus()
    Return
  Endif

  ' --- 5. RESTAURAR FOCO EN EL EDITOR ---
  ' EL CLICK EN EL BOTÓN TRANSFIRIÓ EL FOCO; LO DEVOLVEMOS AL EDITOR PARA QUE
  ' EL CARET QUEDE TITILANDO AL FINAL DEL TEXTO RECIÉN INSERTADO
  txtEditorProyecto.SetFocus()

End

