' ============================================
' Función   : menuAcercaIntegridad_Click
' Propósito : Lanza engine/integridad.sh en la terminal del proyecto: controla
'             las herramientas de producción congeladas en /opt (Saxon-HE,
'             pandoc, epubcheck, veraPDF, packtools) e instala las que fallen.
'             La contraseña la pide el script en una ventana (pkexec).
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub menuAcercaIntegridad_Click()

  ' --- 1. INICIALIZACIÓN ---
  Dim aArgumentos As New String[]
  Dim iResultado As Integer

  ' --- 2. HACE FALTA UN PROYECTO ABIERTO ---
  ' EL SCRIPT CORRE EN LA TERMINAL DEL PROYECTO Y LA LANZADORA ESCRIBE SU
  ' ESTADO EN tmp/ DEL PROYECTO (SC-53). EN MODO PARCIAL NO HAY CARPETA
  If m_InicioCierre.RutaProyectoEnCurso = "" Then
    m_Sonido.sonar("Info")
    Message.Info("Para controlar la integridad del sistema, primero abrí cualquier proyecto: una revista o un libro." & gb.NewLine & gb.NewLine &
      "El control corre en la terminal del proyecto, donde vas a ver cada paso.")
    Return
  Endif

  ' --- 3. LANZAMIENTO ---
  ' 1800 SEGUNDOS: LAS DESCARGAS Y packtools PUEDEN TARDAR. AL VENCER, LA
  ' LANZADORA PREGUNTA SI SEGUIR ESPERANDO
  iResultado = m_Lanzadora.EjecutarScript("integridad.sh", aArgumentos, 1800, "Controlando la integridad del sistema")

  ' --- 4. RESULTADO ---
  ' InformarResultado HABLA DE UN PRODUCTO GENERADO: LOS DOS CÓDIGOS DEL
  ' SCRIPT SE INFORMAN ACÁ, LOS PROPIOS DE LA LANZADORA LOS EXPLICA ELLA
  Select Case iResultado
    Case m_Lanzadora.SALIDA_OK
      m_Sonido.sonar("Info")
      Message.Info("Las herramientas de producción están en orden.")
    Case m_Lanzadora.SALIDA_FALLO
      m_Sonido.sonar("Error")
      Message.Error("Quedaron herramientas sin resolver." & gb.NewLine & gb.NewLine &
        "El motivo está al final de la terminal.")
    Case Else
      m_Lanzadora.InformarResultado(iResultado, "El control de integridad", "")
  End Select

End

