# Gambas Form File 3.0

{ Form Form
  Move(0,0,860,600)
  #Scaled = False
  Resizable = False
  Arrangement = Arrange.Vertical
  Spacing = True
  Margin = True
  Padding = 4
  { hbxBotones2 HBox
    Move(0,18,828,36)
    #Translate = False
    { btnGuardar Button
      Move(0,0,36,36)
      #Translate = False
      Picture = Picture["iconos/guardar.png"]
    }
    { Panel2 Panel
      Move(342,0,36,36)
      Expand = True
    }
  }
  { lblRuta Label
    Move(9,63,828,36)
    #Translate = False
  }
  { txaPrompt TextArea
    Move(18,117,531,180)
    Font = Font["IBM Plex Mono"]
    Expand = True
    Wrap = True
    ScrollBar = Scroll.Vertical
  }
  { hbxBotones HBox
    Move(9,522,828,36)
    #Translate = False
    { btnRestaurar Button
      Move(0,0,180,36)
      #Translate = False
      Font = Font["Bold"]
      Background = &HFF0000
      Foreground = Color.White
      Text = "Restaurar original"
    }
    { Panel1 Panel
      Move(189,0,36,36)
      Expand = True
    }
    { btnCerrar Button
      Move(657,0,144,36)
      #Translate = False
      Text = "Cerrar"
      Picture = Picture["iconos/salir.png"]
    }
  }
}
