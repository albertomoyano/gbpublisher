# Gambas Form File 3.0

{ Form Form
  Move(0,0,450,153)
  #Scaled = False
  Text = ("Bloque de código")
  Icon = Picture["iconos/gbadoc.png"]
  Resizable = False
  Arrangement = Arrange.Vertical
  AutoResize = True
  Centered = True
  Spacing = True
  Margin = True
  Padding = 4
  { hbxLenguaje HBox
    Move(0,0,432,36)
    #Translate = False
    { lblLenguaje Label
      Move(0,0,189,36)
      #Translate = False
      Text = "  Lenguaje  "
    }
    { cmbLenguaje ComboBox
      Move(198,0,216,36)
      #Translate = False
      Expand = True
      ReadOnly = True
    }
  }
  { hbxNombre HBox
    Move(0,45,432,36)
    #Translate = False
    { lblNombre Label
      Move(0,0,189,36)
      #Translate = False
      Text = "  Nombre del listado  lst-"
    }
    { txtNombre TextBox
      Move(198,0,216,36)
      #Translate = False
      Expand = True
    }
  }
  { hbxBotones HBox
    Move(0,90,432,36)
    #Translate = False
    { Spring1 Spring
      Move(0,0,63,36)
      #Translate = False
    }
    { btnAceptar Button
      Move(135,0,144,36)
      #Translate = False
      Font = Font["Bold"]
      Background = &H9FFF7F
      Text = "Insertar"
      Picture = Picture["iconos/enviar.png"]
      Default = True
    }
    { btnCancelar Button
      Move(279,0,144,36)
      #Translate = False
      Text = "Cancelar"
      Picture = Picture["iconos/salir.png"]
      Cancel = True
    }
  }
}
