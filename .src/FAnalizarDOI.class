' Gambas class file

' ============================================
' Formulario : FAnalizarDOI
' Propósito  : Muestra lo que Crossref, OpenCitations y OpenAIRE saben de un
'              DOI, en una grilla de dos columnas dato/valor.
'              La consulta la hace engine/consultar_doi.sh (modo analisis),
'              por m_Crossref y la lanzadora: el avance se ve en la terminal
'              del proyecto, que se ve corriendo la ventana. Hace falta un
'              proyecto abierto (FMain.menuAnalizarDOI_Click lo controla).
'              Antes consultaba con Shell, con el DOI entre comillas simples,
'              y abría las URL de la grilla con Shell "xdg-open '…'": un valor
'              que llega de un servicio externo pasaba por sh -c (GV-06).
' Componentes: txtAnalizarDOI, btnBuscar, gvAnalizarDOI, btnCerrar
' ============================================

' LAS DOS COLUMNAS DE LA GRILLA, EN ARRAYS PARALELOS (PATRÓN Data)
Private $aDatos As New String[]
Private $aValores As New String[]

' FLAG PARA PERMITIR EL CIERRE DESDE EL BOTÓN
Private $bCierrePermitido As Boolean

' ============================================
' Función   : Form_Show
' Propósito : Aplicar la configuración de botones del marco
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub Form_Show()

  m_Ventana.FijarBotones(Me)

End

' ============================================
' Función   : Form_Open
' Propósito : Inicializa la grilla y pone el foco en el DOI
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub Form_Open()

  ' --- 1. ESTRUCTURA DE LA GRILLA ---
  With gvAnalizarDOI
    .Columns.Count = 2
    .Columns[0].Title = "Dato"
    .Columns[0].Width = 220
    .Columns[1].Title = "Valor"
    .Columns[1].Width = 560
    .Rows.Count = 0
    .ScrollBar = Scroll.Both
    .Resizable = True
    .Header = TableView.Horizontal
    .Mode = Select.None
  End With

  ' --- 2. ESTADO INICIAL ---
  ' EL FORMULARIO ES UNA INSTANCIA AUTOMÁTICA: LO DE LA VEZ ANTERIOR SE LIMPIA
  $aDatos.Clear
  $aValores.Clear
  $bCierrePermitido = False

  txtAnalizarDOI.SetFocus

End

' ============================================
' Función   : btnCerrar_Click
' Propósito : Habilita el cierre y cierra el formulario
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub btnCerrar_Click()

  $bCierrePermitido = True
  Me.Close()

End

' ============================================
' Función   : Form_Close
' Propósito : No deja cerrar con una consulta en curso, ni desde la X del
'             sistema
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub Form_Close()

  ' --- 1. NO SE CIERRA CON UNA CONSULTA EN CURSO ---
  ' EjecutarScript ESPERA CON Wait DENTRO DE btnBuscar_Click: SI EL FORMULARIO
  ' SE CERRARA, AL VOLVER EL MANEJADOR TOCARÍA CONTROLES DE UN OBJETO
  ' DESTRUIDO (SC-53, LANZAR CON UN FORMULARIO MODAL ABIERTO)
  If m_Lanzadora.HayScriptEnCurso() Then
    Stop Event
    $bCierrePermitido = False
    m_Sonido.sonar("Warning")
    Message.Warning("Hay una consulta en curso: esperá a que termine para cerrar.")
    Return
  Endif

  ' --- 2. SI EL CIERRE VIENE DEL BOTÓN, SE PERMITE ---
  If $bCierrePermitido Then Return

  ' --- 3. LA X DEL SISTEMA NO CIERRA ---
  m_Sonido.sonar("info")
  Message.Info("Para cerrar el formulario correctamente," & Chr(10) & "use el botón <b>Cerrar</b>.")
  Stop Event

End

' ============================================
' Función   : txtAnalizarDOI_KeyPress
' Propósito : Enter dispara la consulta
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub txtAnalizarDOI_KeyPress()

  If Key.Code = Key.Return Then
    Stop Event
    btnBuscar_Click()
  Endif

End

' ============================================
' Función   : btnBuscar_Click
' Propósito : Consulta el DOI por m_Crossref y llena la grilla con el TSV
'             que deja el script
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub btnBuscar_Click()

  ' --- 1. INICIALIZACIÓN ---
  Dim sDOI As String
  Dim sTextoBoton As String
  Dim aLineas As String[]
  Dim sLinea As String
  Dim aCampos As String[]

  ' --- 2. VALIDACIÓN ---
  ' LA FORMA DEL DOI LA CONTROLA EL SCRIPT, QUE ACEPTA https://doi.org/…,
  ' doi:… Y EL DOI SOLO: ACÁ SOLO SE CONTROLA QUE HAYA ALGO
  sDOI = Trim(txtAnalizarDOI.Text)
  If sDOI = "" Then
    m_Sonido.sonar("Warning")
    Message.Warning("Ingresá un DOI antes de buscar.")
    txtAnalizarDOI.SetFocus
    Return
  Endif

  ' --- 3. RESULTADOS ANTERIORES ---
  $aDatos.Clear
  $aValores.Clear
  gvAnalizarDOI.Rows.Count = 0

  ' --- 4. CONSULTA ---
  ' LOS CONTROLES SE APAGAN MIENTRAS LA LANZADORA ESPERA: EL FORMULARIO SIGUE
  ' RECIBIENDO CLICS (SC-53). EL TEXTO DEL BOTÓN SE GUARDA PARA REPONER EL
  ' DEL DISEÑO, SEA CUAL SEA
  sTextoBoton = btnBuscar.Text
  btnBuscar.Enabled = False
  txtAnalizarDOI.Enabled = False
  btnBuscar.Text = "Consultando…"

  aLineas = m_Crossref.AnalizarDOI(sDOI)

  btnBuscar.Text = sTextoBoton
  btnBuscar.Enabled = True
  txtAnalizarDOI.Enabled = True

  ' SI NO SE COMPLETÓ, m_Crossref YA INFORMÓ POR QUÉ
  If IsNull(aLineas) Then Return

  ' --- 5. GRILLA ---
  ' UNA LÍNEA QUE NO TIENE DOS CAMPOS NO ES DEL CONTRATO: SE IGNORA
  For Each sLinea In aLineas
    aCampos = Split(sLinea, Chr(9))
    If aCampos.Count = 2 Then
      $aDatos.Add(aCampos[0])
      $aValores.Add(aCampos[1])
    Endif
  Next

  gvAnalizarDOI.Rows.Count = $aDatos.Count
  gvAnalizarDOI.Refresh

End

' ============================================
' Función   : gvAnalizarDOI_Data
' Propósito : Provee los datos a la grilla (patrón Data)
' Parámetros: Row As Integer — fila solicitada
'             Column As Integer — columna solicitada
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub gvAnalizarDOI_Data(Row As Integer, Column As Integer)

  If Row >= $aDatos.Count Then Return

  Select Case Column
    Case 0
      ' COLUMNA DATO: FONDO GRIS PARA DISTINGUIRLA DEL VALOR
      gvAnalizarDOI.Data.Text = $aDatos[Row]
      gvAnalizarDOI.Data.Background = Color.RGB(235, 235, 235)
    Case 1
      gvAnalizarDOI.Data.Text = $aValores[Row]
      ' LAS FILAS CON URL SE PUEDEN ABRIR CON UN CLIC
      If $aValores[Row] Begins "http://" Or $aValores[Row] Begins "https://" Then
        gvAnalizarDOI.Data.Foreground = Color.Blue
      Endif
  End Select

End

' ============================================
' Función   : gvAnalizarDOI_Click
' Propósito : Abre en el navegador el valor de la fila, si es una URL
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub gvAnalizarDOI_Click()

  ' --- 1. INICIALIZACIÓN ---
  Dim iRow As Integer
  Dim sValor As String

  ' --- 2. LA FILA ---
  iRow = gvAnalizarDOI.Row
  If iRow < 0 Or iRow >= $aValores.Count Then Return
  sValor = $aValores[iRow]

  ' --- 3. SOLO UNA URL ---
  If Not (sValor Begins "http://" Or sValor Begins "https://") Then Return

  ' --- 4. APERTURA ---
  ' EL VALOR VIENE DE UN SERVICIO EXTERNO: Desktop.Open NO LO PASA POR sh
  ' (GV-06). SIN Wait, PARA NO CONGELAR LA INTERFAZ; EL Try SOLO ATRAPA
  ' ERRORES DE LANZAMIENTO (GV-43)
  Try Desktop.Open(sValor)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo abrir el enlace:" & gb.NewLine & sValor & gb.NewLine & gb.NewLine & Error.Text)
  Endif

End
