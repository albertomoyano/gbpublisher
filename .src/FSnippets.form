# Gambas Form File 3.0

{ Form Form
  Move(0,0,960,600)
  #Scaled = False
  Icon = Picture["iconos/gbadoc.png"]
  Resizable = False
  Arrangement = Arrange.Vertical
  Spacing = True
  Margin = True
  Padding = 4
  { hbxBarra HBox
    Move(9,9,882,36)
    { btnNuevo Button
      Move(0,0,36,36)
      #Translate = False
      NoTabFocus = True
      ToolTip = "Nuevo snippet"
      Picture = Picture["iconos/+nuevo.png"]
    }
    { btnGuardar Button
      Move(36,0,36,36)
      #Translate = False
      NoTabFocus = True
      ToolTip = "Guardar el snippet"
      Picture = Picture["iconos/guardar.png"]
    }
    { btnBorrar Button
      Move(72,0,36,36)
      #Translate = False
      NoTabFocus = True
      ToolTip = "Borrar el snippet"
      Picture = Picture["iconos/borrar.png"]
    }
    { lblNombre Label
      Move(117,0,108,36)
      #Translate = False
      Alignment = Align.Right
      Text = "Abreviatura: "
    }
    { txtNombre TextBox
      Move(234,0,63,36)
      #Translate = False
      Font = Font["Monospace"]
      MaxLength = 3
    }
    { lblAyuda Label
      Move(306,0,234,36)
      #Translate = False
      Expand = True
      Text = "  tres caracteres: a-z y 0-9"
    }
    { btnCerrar Button
      Move(702,0,144,36)
      #Translate = False
      NoTabFocus = True
      ToolTip = "Cerrar la ventana"
      Text = "Cerrar"
      Picture = Picture["iconos/salir.png"]
    }
  }
  { hbxCuerpo HBox
    Move(9,54,882,513)
    Expand = True
    Spacing = True
    { gvSnippets GridView
      Move(0,0,342,486)
      NoTabFocus = True
      Mode = Select.Single
      ShowCursor = True
      Header = GridView.Horizontal
    }
    { txaCuerpo TextArea
      Move(351,0,522,486)
      #Translate = False
      Font = Font["Monospace"]
      Expand = True
    }
  }
}
