# Gambas Form File 3.0

{ Form Form
  Move(0,0,960,640)
  #Scaled = False
  Text = ("Vocabularios controlados")
  Resizable = False
  Centered = True
  Arrangement = Arrange.Vertical
  Spacing = True
  Margin = True
  Padding = 4
  { lblAvisoVocabularios Label
    Move(9,9,936,36)
    Foreground = &H0000FF
    Alignment = Align.Center
    Border = Border.Plain
    Text = ("Catálogo común a todas las revistas. Corregir un término corrige los artículos no publicados que lo usan.")
  }
  { hbxFiltroVocabularios HBox
    Move(9,54,936,36)
    Spacing = True
    { lblVocabularioFiltro Label
      Move(0,0,117,36)
      Alignment = Align.Right
      Text = ("vocabulario: ")
    }
    { cmbVocabularioFiltro ComboBox
      Move(126,0,144,36)
      Placeholder = ("MeSH, DeCS…")
    }
    { lblIdiomaFiltro Label
      Move(279,0,72,36)
      Alignment = Align.Right
      Text = ("idioma: ")
    }
    { cmbIdiomaFiltro ComboBox
      Move(360,0,99,36)
      ReadOnly = True
    }
    { lblBuscarTermino Label
      Move(468,0,72,36)
      Alignment = Align.Right
      Text = ("buscar: ")
    }
    { txtBuscarTermino TextBox
      Move(549,0,378,36)
      Expand = True
      Placeholder = ("Sin distinguir tildes ni mayúsculas")
    }
  }
  { hbxTerminos HBox
    Move(9,99,936,324)
    Expand = True
    Spacing = True
    { gvTerminos GridView
      Move(0,0,846,324)
      Expand = True
      Mode = Select.Single
      ShowCursor = True
      Header = GridView.Horizontal
    }
    { vbxBotonesTerminos VBox
      Move(855,0,36,72)
      { btnNuevoTermino Button
        Move(0,0,36,36)
        ToolTip = ("Nuevo término en el vocabulario e idioma elegidos")
        Picture = Picture["iconos/+nuevo.png"]
      }
      { btnBorrarTermino Button
        Move(0,36,36,36)
        ToolTip = ("Borrar el término elegido (solo si ningún artículo lo usa)")
        Picture = Picture["iconos/borrar.png"]
      }
    }
  }
  { hbxTermino HBox
    Move(9,432,936,36)
    { lblTermino Label
      Move(0,0,170,36)
      Alignment = Align.Right
      Text = ("término: ")
    }
    { txtTermino TextBox
      Move(173,0,450,36)
      Expand = True
      Placeholder = ("La forma oficial: así se escribe en todos los artículos")
    }
  }
  { hbxIdentificador HBox
    Move(9,477,936,36)
    { lblIdentificador Label
      Move(0,0,170,36)
      Alignment = Align.Right
      Text = ("identificador: ")
    }
    { txtIdentificador TextBox
      Move(173,0,450,36)
      Expand = True
      Placeholder = ("Opcional: el código del vocabulario (MeSH: D006801)")
    }
  }
  { hbxBotonesVocabularios HBox
    Move(9,522,936,36)
    { lblEstadoTermino Label
      Move(0,0,450,36)
      Foreground = &H0000FF
      Expand = True
    }
    { btnGuardarTermino Button
      Move(630,0,144,36)
      Text = ("Guardar")
      Picture = Picture["iconos/guardarComo.png"]
    }
    { btnCerrar Button
      Move(783,0,144,36)
      Text = ("Cerrar")
      Picture = Picture["iconos/salir.png"]
    }
  }
}
