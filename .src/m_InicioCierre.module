' Gambas module file

' ==============================================================================
' Módulo    : m_InicioCierre
' Propósito : Setup inicial y teardown de la aplicación. Mantiene el estado
'             de sesión (UsuarioEnCurso e IdUsuarioEnCurso) y centraliza:
'             - Creación de directorios y copia de recursos al ~/.gbpublisher
'             - Verificación e instalación de fuentes IBM Plex
'             - Carga del TableView de usuarios conectados
'             - Carga del ComboBox de scripts disponibles
'             - Cierre de proyecto y cierre total de la aplicación
'             - Utility: ruta de recursos, mapeo de estilos CSL
' Dependencias: m_ConexionBD, m_Sonido, m_Timer, m_Bibtex, m_Siglas,
'             m_FuncionesGenericas, FMain.
' ==============================================================================

' --- ESTADO DE SESIÓN ACTIVA AL SERVIDOR ---
' SE ASIGNAN AL VALIDAR CREDENCIALES EN FLogin.btnConectarServer_Click Y
' SE LIMPIAN AL DESCONECTAR O CERRAR LA APP. SIRVEN COMO IDENTIDAD DEL
' USUARIO LOGUEADO PARA VALIDACIONES DE AUTORÍA EN TODA LA APP
Public UsuarioEnCurso As String
Public IdUsuarioEnCurso As Integer
Public IdArticuloEnCurso As Integer
Public IdCapituloEnCurso As Integer

' --- ESTADO DEL PROYECTO ABIERTO ---
' SE ASIGNAN EN UN ÚNICO PUNTO DE AbrirProyectoMD, DESPUÉS DE TODAS LAS
' VALIDACIONES, Y SE LIMPIAN EN CerrarProyecto Y EN CerrarTodoMySQL.
' MIGRADAS DESDE FMain (NombreProyecto, RutaProyecto) Y DESDE EL CONTROL
' id_proyecto.Value (RC-GM-16). txtProyecto E id_proyecto SIGUEN EXISTIENDO
' EN FMain COMO DISPLAY: DEJAN DE SER FUENTE DE VERDAD.
' RutaProyectoEnCurso ES LA RAÍZ DEL PROYECTO, QUE POR LA REGLA
' UN REPO = UN PROYECTO ES TAMBIÉN LA RAÍZ DEL REPOSITORIO GIT.
Public NombreProyectoEnCurso As String
Public RutaProyectoEnCurso As String
Public IdProyectoEnCurso As Integer
' RUTA COMPLETA DEL ARCHIVO DEL PROYECTO. ES LO QUE ANTES SE LEÍA DE
' FMain.txtProyecto.Text (RC-GM-16). SE DECLARA COMO Property Y NO COMO
' Function PARA QUE SE LEA IGUAL QUE LAS OTRAS TRES, SIN PARÉNTESIS: SIENDO
' Function, EL () OLVIDADO PASA DESAPERCIBIDO O REVIENTA EN RUNTIME SEGÚN EL
' CONTEXTO. TAMPOCO ES UNA CUARTA GLOBAL: ES UN DERIVADO, Y LO DERIVADO NO SE
' PUEDE DESINCRONIZAR DE SU ORIGEN
Property Read ArchivoProyectoEnCurso As String

' ============================================
' Función   : ResetearEstadoDeProyecto
' Propósito : ÚNICO LUGAR DONDE ESTÁ ESCRITO QUÉ SIGNIFICA "NO HAY PROYECTO".
'             LIMPIA LAS GLOBALES DE SESIÓN DEL PROYECTO Y SUS ESPEJOS EN LA
'             UI. LA LLAMAN LOS TRES CAMINOS QUE CAMBIAN DE PROYECTO:
'             FMain.AbrirProyecto (5.B), FProyectosParcial (6.B) Y
'             CerrarProyecto (7). ANTES CADA UNO LIMPIABA SU PROPIO SUBCONJUNTO
'             Y LOS TRES LIMPIABAN COSAS DISTINTAS: EL PARCIAL NO TOCABA LOS
'             IDs, EL COMPLETO NO TOCABA LOS ESPEJOS, Y EL CIERRE NO TOCABA
'             NINGUNO DE LOS CUATRO VALUEBOX.
'             NO LIMPIA id_proyecto NI txtProyecto: ESOS LOS DECIDE CADA
'             LLAMADOR, PORQUE AL ABRIR SE REEMPLAZAN Y AL CERRAR SE VACÍAN.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub ResetearEstadoDeProyecto()

  ' --- 1. GLOBALES DE SESIÓN ---
  IdArticuloEnCurso = 0
  IdCapituloEnCurso = 0

  ' --- 2. ESPEJOS EN LA UI ---
  ' SON DISPLAY, NO FUENTE DE VERDAD (RC-GM-16), PERO UN ESPEJO QUE MUESTRA
  ' EL ID DE UN PROYECTO QUE YA NO ESTÁ ABIERTO MIENTE IGUAL
  FMain.id_revista.Value = 0
  FMain.id_libro.Value = 0
  FMain.id_articulo.Value = 0
  FMain.id_capitulo.Value = 0

End

' ============================================
' Función   : DirectorioOcultoApp
' Propósito : Crea el directorio oculto ~/.gbpublisher con sus subcarpetas
'             de recursos, copia los archivos base desde el paquete instalado
'             (o desde .hidden/ si se ejecuta desde el IDE), crea el archivo
'             de IPs y asegura la existencia del buscador.py.
'             Esta función se llama una vez al inicio de la app.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub DirectorioOcultoApp()

  Dim sBase As String
  Dim carpetas As String[]
  Dim carpeta As String
  Dim sRutaIPs As String

  ' --- 1. CREAR DIRECTORIO BASE SI NO EXISTE ---
  sBase = User.Home &/ ".gbpublisher"
  If Not Exist(sBase) Then
    Try Mkdir sBase
    If Error Then
      m_Sonido.sonar("Error")
      Message.Error("No se pudo crear el directorio base de la aplicación:" & Chr(10) & sBase)
      Return
    Endif
  Endif

  ' --- 2. COPIAR CONTENIDO DE CARPETAS DEL SISTEMA ---
  carpetas = ["auditor", "biblatex", "chart", "csl", "dtd", "filters",
    "fonts", "github", "media", "ott", "schemas",
    "schematron", "scripts", "sonido", "xslt", "assets", "assets/css", "assets/js"]

  For Each carpeta In carpetas
    CopiarDirectorio(RutaRecursos() & "/" & carpeta, User.Home & "/.gbpublisher/" & carpeta)
    ' DESPUÉS DE COPIAR LA CARPETA fonts, AJUSTAR EL COLOR DE LOS ICONOS SVG
    If carpeta = "fonts" Then CopiarIconosSVG()
  Next

  ' --- 3. CREAR DIRECTORIO DE RESPALDO ---
  If Not Exist(User.Home & "/.gbpublisher/respaldo") Then
    Try Mkdir User.Home & "/.gbpublisher/respaldo"
    If Error Then
      m_Sonido.sonar("Error")
      Message.Error("Error al crear el directorio de respaldo.")
    Endif
  Endif

  ' --- 4. VERIFICAR Y CREAR ARCHIVO DE IPS SI NO EXISTE ---
  sRutaIPs = User.Home &/ ".gbpublisher/.ips.txt"
  If Not Exist(sRutaIPs) Then
    Try File.Save(sRutaIPs, "127.0.0.1" & Chr(10))
    If Error Then
      m_Sonido.sonar("Error")
      Message.Error("No se pudo crear el archivo de IPs:" & Chr(10) & Error.Text)
      Return
    Endif
  Endif

End

' ============================================
' Función   : CopiarIconosSVG
' Propósito : Copia los archivos .svg de la carpeta de recursos al directorio
'             del usuario reemplazando el color "currentColor" por el azul
'             institucional de la app. Útil para que los iconos hereden el
'             color de la app sin depender del navegador.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub CopiarIconosSVG()

  Dim srcDir As String
  Dim dstDir As String
  Dim f As String
  Dim sContenido As String

  ' --- 1. RUTAS ORIGEN Y DESTINO ---
  srcDir = RutaRecursos() &/ "fonts"
  dstDir = User.Home &/ ".gbpublisher" &/ "fonts"

  ' --- 2. PROCESAR CADA ARCHIVO SVG ---
  For Each f In Dir(srcDir, "*.svg")

    ' LEER CONTENIDO DEL SVG ORIGINAL
    Try sContenido = File.Load(srcDir &/ f)
    If Error Then Continue

    ' REEMPLAZAR COLOR DE RELLENO POR azulrevista
    sContenido = Replace(sContenido, "currentColor", "#2D5A8E")

    ' ESCRIBIR SVG COLOREADO EN DESTINO
    Try File.Save(dstDir &/ f, sContenido)
    If Error Then
      Message.Error("Error guardando: " & f & Chr(10) & Error.Text)
    Endif

  Next

End

' ============================================
' Función   : CopiarDirectorio
' Propósito : Copia recursivamente el contenido de un directorio hacia un
'             destino, preservando la estructura de subdirectorios y omitiendo
'             archivos ya existentes.
' Parámetros: srcDir As String — ruta absoluta del directorio origen
'             dstDir As String — ruta absoluta del directorio destino
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub CopiarDirectorio(srcDir As String, dstDir As String)

  Dim f As String

  ' --- 1. VERIFICAR QUE EL DIRECTORIO ORIGEN EXISTE ---
  If Not Exist(srcDir) Then
    ' DIAGNÓSTICO: REGISTRAR QUÉ DIRECTORIO ORIGEN FALTA EN LA TERMINAL
    FMain.TerminalViewProyecto.Input("echo 'FALTA srcDir: " & srcDir & "'" & Chr(10))
    Return
  Endif

  ' --- 2. CREAR CARPETA DESTINO SI NO EXISTE ---
  If Not Exist(dstDir) Then
    Mkdir dstDir
  Endif

  ' --- 3. PRIMERA PASADA: COPIAR SUBDIRECTORIOS RECURSIVAMENTE ---
  For Each f In Dir(srcDir, "*", gb.Directory)
    CopiarDirectorio(srcDir & "/" & f, dstDir & "/" & f)
  Next

  ' --- 4. SEGUNDA PASADA: COPIAR ARCHIVOS ---
  For Each f In Dir(srcDir, "*.*")
    If Not Exist(dstDir & "/" & f) Then
      Copy srcDir & "/" & f To dstDir & "/" & f
    Endif
  Next

End

' ============================================
' Función   : CargarScripts
' Propósito : Carga el ComboBox de scripts disponibles desde ~/.gbpublisher/scripts.
'             Soporta extensiones .py, .lua, .sh, .pl, .R. La descripción se
'             extrae de la primera línea de comentario del archivo (salteando
'             el shebang si existe).
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub CargarScripts()

  Dim rutaScripts As String
  Dim archivos As String[]
  Dim archivo As String
  Dim linea As String
  Dim descripcion As String
  Dim archivoBase As String
  Dim hFile As File
  Dim extension As String
  Dim extensionOriginal As String
  Dim prefijo As String
  Dim extensiones As String[]
  Dim todosArchivos As New String[]
  Dim rutaCompleta As String

  rutaScripts = User.Home &/ ".gbpublisher/scripts"

  ' --- 1. VERIFICAR QUE EL DIRECTORIO EXISTE ---
  If Not Exist(rutaScripts) Then
    m_Sonido.sonar("Error")
    Message.Error("El directorio de scripts no existe: " & rutaScripts)
    Return
  Endif

  FMain.ComboBoxScripts.Clear

  ' --- 2. RECOPILAR ARCHIVOS DE TODAS LAS EXTENSIONES SOPORTADAS ---
  extensiones = ["*.py", "*.lua", "*.sh", "*.pl", "*.R"]
  For Each extension In extensiones
    archivos = Dir(rutaScripts, extension)
    If Not Error Then
      For Each archivo In archivos
        todosArchivos.Add(archivo)
      Next
    Endif
  Next

  ' --- 3. SALIR SI NO HAY ARCHIVOS ---
  If todosArchivos.Count = 0 Then
    m_Sonido.sonar("Info")
    Message.Info("No se encontraron scripts en el directorio")
    Return
  Endif

  ' --- 4. PROCESAR CADA ARCHIVO Y EXTRAER SU DESCRIPCIÓN ---
  For Each archivo In todosArchivos
    descripcion = "Sin descripción"

    ' EXTENSIÓN ORIGINAL (PRESERVA CAPITALIZACIÓN, EJ. ".R")
    extensionOriginal = File.Ext(archivo)
    extension = LCase(extensionOriginal)

    ' PREFIJO DE COMENTARIO SEGÚN EL LENGUAJE
    Select Case extension
      Case "py"
        prefijo = "#"
      Case "lua"
        prefijo = "--"
      Case "sh"
        prefijo = "#"
      Case "pl"
        prefijo = "#"
      Case "r"
        prefijo = "#"
      Default
        prefijo = "#"
    End Select

    rutaCompleta = rutaScripts &/ archivo

    ' --- 5. LEER LA PRIMERA LÍNEA DE COMENTARIO PARA OBTENER DESCRIPCIÓN ---
    Try hFile = Open rutaCompleta For Read
    If Error Then
      descripcion = "Error al leer archivo"
    Else
      Try Line Input #hFile, linea
      If Not Error And If linea <> "" Then
        linea = Trim(linea)
        ' SALTAR SHEBANG (#!/...) SI ESTÁ EN LA PRIMERA LÍNEA
        If Left(linea, 2) = "#!" Then
          If Not Eof(hFile) Then
            Try Line Input #hFile, linea
            If Not Error Then
              linea = Trim(linea)
            Else
              linea = ""
            Endif
          Else
            linea = ""
          Endif
        Endif
        ' SI LA LÍNEA EMPIEZA CON EL PREFIJO DE COMENTARIO, EXTRAER DESCRIPCIÓN
        If linea <> "" And If Left(linea, Len(prefijo)) = prefijo Then
          If Len(linea) > Len(prefijo) Then
            descripcion = Trim(Mid(linea, Len(prefijo) + 1))
          Endif
        Endif
      Endif
      Close #hFile
    Endif

    ' --- 6. AGREGAR AL COMBOBOX CON DESCRIPCIÓN Y NOMBRE DE ARCHIVO ---
    archivoBase = File.BaseName(archivo) & "." & extensionOriginal
    FMain.ComboBoxScripts.Add(descripcion & " [" & archivoBase & "]")
  Next

End

' ============================================
' Función   : RutaRecursos
' Propósito : Devuelve la ruta base de los recursos del paquete. Si se está
'             ejecutando desde el IDE de Gambas, los recursos están en
'             .hidden/ dentro del proyecto. Si se está ejecutando instalado,
'             están en /usr/share/gbpublisher/.
' Parámetros: (ninguno)
' Retorna   : String — ruta absoluta a la carpeta de recursos
' ============================================
Public Function RutaRecursos() As String

  ' --- IDE DE GAMBAS: LOS RECURSOS ESTÁN EN .hidden/ DEL PROYECTO ---
  If Exist(Application.Path &/ ".hidden" &/ "fonts") Then
    Return Application.Path &/ ".hidden"
  Endif

  ' --- INSTALADO: LOS RECURSOS ESTÁN EN /usr/share/gbpublisher/ ---
  Return "/usr/share/gbpublisher"

End

' ============================================
' Función   : LeerTipoCSL
' Propósito : Mapea el nombre de un archivo CSL a su identificador interno
'             de estilo. gbpublisher soporta exactamente 4 estilos con nombres
'             fijos. Si el archivo no coincide con ninguno, avisa al usuario
'             y devuelve cadena vacía.
'             Nota: para soporte de CSLs personalizados habría que leer el
'             citation-format del XML del archivo, no solo el nombre.
' Parámetros: sRutaCSL As String — ruta al archivo .csl
' Retorna   : String — identificador del estilo ("apa", "ieee", "vancouver",
'             "iso690") o "" si no se reconoce
' ============================================
Public Function LeerTipoCSL(sRutaCSL As String) As String

  Select Case Lower(File.Name(sRutaCSL))
    Case "apa.csl"
      Return "apa"
    Case "ieee.csl"
      Return "ieee"
    Case "vancouver.csl"
      Return "vancouver"
    Case "iso690-author-date-es.csl"
      Return "iso690"
    Case Else
      m_Sonido.sonar("Error")
      Message.Error("Estilo de cita no reconocido: " & File.Name(sRutaCSL) & Chr(10) &
        "Los estilos soportados son: apa.csl, ieee.csl, vancouver.csl, iso690-author-date-es.csl")
      Return ""
  End Select

End

' ============================================
' Función   : DetenerProcesoBash
' Propósito : Helper privado que detiene el proceso bash asociado al proyecto
'             (FMain.$Bash). Intenta primero con Kill (hasta 20 intentos con
'             pausas de 50ms) y como fallback usa Terminate. Anula la
'             referencia al final.
'             DEUDA TÉCNICA: acceso directo a FMain.$Bash (variable privada
'             por convención $ en Gambas). Cuando se refactorice FMain,
'             mover esta lógica a una función pública FMain.DetenerBashEnCurso().
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Private Sub DetenerProcesoBash()

  Dim tries As Integer

  ' --- 1. VALIDAR QUE EXISTE Y ESTÁ CORRIENDO ---
  If Not FMain.$Bash Then Return
  If Not Object.IsValid(FMain.$Bash) Then
    FMain.$Bash = Null
    Return
  Endif
  If FMain.$Bash.State <> Process.Running Then
    FMain.$Bash = Null
    Return
  Endif

  ' --- 2. INTENTAR DETENER CON Kill HASTA 20 VECES ---
  tries = 0
  While FMain.$Bash.State = Process.Running And tries < 20
    FMain.$Bash.Kill
    Wait 0.05
    tries = tries + 1
  Wend

  ' --- 3. FALLBACK CON Terminate SI Kill NO ALCANZÓ ---
  If FMain.$Bash.State = Process.Running Then
    FMain.$Bash.Terminate
    Wait 0.2
    If FMain.$Bash.State = Process.Running Then
      m_Sonido.sonar("Warning")
      Message.Warning("El proceso bash no pudo ser detenido.")
    Endif
  Endif

  ' --- 4. ANULAR LA REFERENCIA ---
  FMain.$Bash = Null

End

' ============================================
' Función   : LimpiarTerminalProyecto
' Propósito : Helper privado que envía un comando "clear" a la terminal
'             embebida de FMain con una pequeña espera para que se procese.
'             Centraliza el patrón que aparecía duplicado en CerrarProyecto
'             y CerrarTodoMySQL.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Private Sub LimpiarTerminalProyecto()

  Try FMain.TerminalViewProyecto.Input("clear" & Chr(10))
  Wait 0.2

End

' ============================================
' Función   : CerrarProyecto
' Propósito : Libera el proyecto actualmente abierto: marca como no-ocupado
'             en BD, detiene timers, mata el proceso bash, limpia la UI
'             de FMain. NO pregunta al usuario — la decisión debe tomarla
'             el caller antes de invocar esta función. Tampoco toca
'             usuarios.en_linea — eso es responsabilidad del flujo de
'             desconexión, no del cierre de proyecto.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub CerrarProyecto()

  ' --- 1. SIN PROYECTO ABIERTO: NADA QUE HACER ---
  ' EL ID ES LO ÚNICO QUE EXISTE EN LOS DOS MODOS: EN MODO PARCIAL HAY
  ' PROYECTO PERO NO HAY ARCHIVOS, ASÍ QUE RutaProyectoEnCurso ESTÁ VACÍA Y
  ' NO SIRVE PARA PREGUNTAR SI HAY PROYECTO
  If IdProyectoEnCurso = 0 Then Return

  ' --- 2. LIBERAR EL PROYECTO EN BD ---
  ' SC-07: LIBERAR POR usuario_propietario, NO POR EL id QUE DIGA LA UI.
  ' SI FMain.id_proyecto.Value SE RESETEÓ POR UN EVENTO (RC-GM-16), UN
  ' WHERE id = <ese valor> LIBERARÍA EL PROYECTO EQUIVOCADO O NINGUNO. FILTRAR
  ' POR EL DUEÑO LIBERA LO QUE ESTE USUARIO TIENE OCUPADO, HAYA DESYNC O NO.
  Try m_ConexionBD.mConn.Exec(
    "UPDATE proyectos SET usuario_propietario = NULL, ocupado = 0 WHERE usuario_propietario = &1 AND ocupado = 1",
    UsuarioEnCurso)
  If Error Then
    m_Sonido.sonar("Warning")
    Message.Warning("No se pudo liberar el proyecto en la base de datos:" & gb.NewLine &
      Error.Text & gb.NewLine & gb.NewLine &
      "El cierre continúa, pero el proyecto puede quedar marcado como ocupado.")
  Else
    Try m_ConexionBD.mConn.Commit
  Endif

  ' --- 2.B. LIMPIAR EL PROYECTO ACTUAL DEL USUARIO ---
  ' SENTENCIA APARTE E INCONDICIONAL: LA LIBERACIÓN DE proyectos (APARTADO 2) SOLO
  ' MATCHEA EN MODO COMPLETO (DONDE EL USUARIO ES usuario_propietario). EN PARCIAL
  ' NO HAY LOCK, PERO id_proyecto_actual SÍ QUEDÓ ESCRITO Y HAY QUE BORRARLO IGUAL.
  ' FILTRA POR usuario (SC-07). CUBRE CIERRE-DE-PROYECTO Y LOGOUT (QUE LLAMA A ESTA).
  Try m_ConexionBD.mConn.Exec(
    "UPDATE usuarios SET id_proyecto_actual = NULL WHERE usuario = &1",
    UsuarioEnCurso)
  If Error Then
    m_Sonido.sonar("Warning")
    Message.Warning("No se pudo limpiar el proyecto actual del usuario en la base de datos:" & gb.NewLine & Error.Text)
  Else
    Try m_ConexionBD.mConn.Commit
  Endif

  ' --- 3. DETENER TIMERS Y CONTADORES ---
  m_Timer.DetenerContador()
  FMain.DetenerTimerArchivosXML()
  FMain.DetenerTimerArchivosProyecto()
  FMain.TimerReferencias.Stop()

  ' --- 4. LIMPIAR TERMINAL EMBEBIDA Y DETENER PROCESO BASH ---
  LimpiarTerminalProyecto()
  DetenerProcesoBash()

  ' --- 5. LIMPIAR FORMULARIOS DE BIBTEX Y SIGLAS ---
  m_Bibtex.LimpiarTextboxBibtex()
  m_Siglas.LimpiarTextboxSigla()

  ' --- 6. RESETEAR UI DE FMain Y CONTADORES VISUALES ---
  FMain.TimerHOY.Delay = 1000
  FMain.TimerHOY.Stop
  FMain.TextHoraParcial.Text = "00:00:00"
  FMain.TextHoraTotal.Text = ""
  FMain.txtProyecto.Text = ""
  FMain.id_proyecto.Value = ""
  FMain.DirViewProyecto.Root = User.Home
  FMain.SplitterPrincipal.Visible = False
  FMain.SpringTemporal.Visible = True
  m_RevisarPDF.ResetVisorPDF()

  ' --- 7. LIMPIAR ESTADO DEL PROYECTO ABIERTO ---
  ' YA NO HACE FALTA QUE VAYA AL FINAL: DESDE QUE EL APARTADO 2 LIBERA POR
  ' usuario_propietario (SC-07), NO NECESITA EL PROYECTO PARA NADA
  ResetearEstadoDeProyecto()
  NombreProyectoEnCurso = ""
  RutaProyectoEnCurso = ""
  IdProyectoEnCurso = 0

End

' ============================================
' Función   : CerrarTodoMySQL
' Propósito : Cierra completamente la aplicación: pregunta al usuario, libera
'             al usuario en BD (en_linea = 0), libera el proyecto si lo había,
'             detiene timers y proceso bash, cierra la conexión a la BD,
'             limpia el estado de sesión y termina el proceso con Quit.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub CerrarTodoMySQL()

  ' --- 1. CONFIRMACIÓN DE SALIDA ---
  m_Sonido.sonar("Question")
  If Message.Question("¿Está seguro que desea salir de la aplicación?", "Sí", "No") <> 1 Then Return

  Try m_ConexionBD.mConn.Exec(
    "UPDATE proyectos SET usuario_propietario = NULL, ocupado = 0 WHERE usuario_propietario = &1 AND ocupado = 1",
    UsuarioEnCurso)
  If Error Then
    m_Sonido.sonar("Warning")
    Message.Warning("No se pudo liberar el proyecto en la base de datos:" & gb.NewLine & Error.Text)
  Endif

  ' --- 2b. LIBERAR AL USUARIO EN BD (en_linea = 0) ---
  ' ESTA ERA LA LIBERACIÓN QUE EL DOCSTRING PROMETÍA Y EL CUERPO NO HACÍA:
  ' EL SEGUNDO UPDATE ERA UN COPY-PASTE DEL PRIMERO Y APUNTABA A proyectos,
  ' NO A usuarios. SC-07: FILTRAR POR usuario (STRING ESTABLE DE SESIÓN), NO
  ' POR IdUsuarioEnCurso, PARA NO DEPENDER DE QUE EL CACHÉ SIGA INTACTO AL
  ' CIERRE. VA ANTES DE CERRAR LA CONEXIÓN (APARTADO 6) Y ANTES DE VACIAR
  ' UsuarioEnCurso (APARTADO 7), CUANDO EL STRING TODAVÍA ESTÁ POBLADO.
  Try m_ConexionBD.mConn.Exec(
    "UPDATE usuarios SET en_linea = 0, id_proyecto_actual = NULL WHERE usuario = &1",
    UsuarioEnCurso)
  If Error Then
    m_Sonido.sonar("Warning")
    Message.Warning("No se pudo marcar al usuario como desconectado en la base de datos:" & gb.NewLine & Error.Text)
  Endif

  ' --- 2c. CONFIRMAR AMBAS LIBERACIONES EN UNA SOLA TRANSACCIÓN ---
  Try m_ConexionBD.mConn.Commit

  ' --- 3. DETENER TIMERS Y CONTADORES ---
  m_Timer.DetenerContador()
  FMain.DetenerTimerArchivosXML()
  FMain.DetenerTimerArchivosProyecto()
  FMain.TimerReferencias.Stop()

  ' --- 4. LIMPIAR TERMINAL EMBEBIDA Y DETENER PROCESO BASH ---
  LimpiarTerminalProyecto()
  DetenerProcesoBash()

  ' --- 5. LIMPIAR UI DE FMain ---
  FMain.txtProyecto.Clear
  FMain.DirViewProyecto.Root = User.Home
  FMain.TextBoxUsuario.Clear
  FMain.TextBoxServidor.Clear

  ' --- 5a ---
  m_GestionImagenes.ResetearEstado()

  ' --- 6. CERRAR LA CONEXIÓN A LA BD SI ESTÁ ABIERTA ---
  If Not IsNull(m_ConexionBD.mConn) Then
    If m_ConexionBD.mConn.Opened Then
      Try m_ConexionBD.mConn.Close()
    Endif
    m_ConexionBD.mConn = Null
  Endif

  ' --- 7. LIMPIAR ESTADO DE SESIÓN Y DE PROYECTO ---
  UsuarioEnCurso = ""
  IdUsuarioEnCurso = 0
  IdArticuloEnCurso = 0
  IdCapituloEnCurso = 0
  NombreProyectoEnCurso = ""
  RutaProyectoEnCurso = ""
  IdProyectoEnCurso = 0

  ' --- 8. FORZAR SALIDA PARA NO QUEDAR EN ESTADO INCONSISTENTE ---
  Quit

End

' ============================================
' Función   : ArchivoProyectoEnCurso_Read
' Propósito : IMPLEMENTACIÓN DE LA PROPIEDAD ArchivoProyectoEnCurso.
' Retorna   : String — RUTA COMPLETA DEL .md DEL PROYECTO, O CADENA VACÍA SI
'             NO HAY PROYECTO ABIERTO
' ============================================
Private Function ArchivoProyectoEnCurso_Read() As String

  ' --- 1. SIN PROYECTO ABIERTO NO HAY ARCHIVO ---
  If RutaProyectoEnCurso = "" Then Return ""

  ' --- 2. RECOMPONER ---
  Return RutaProyectoEnCurso &/ NombreProyectoEnCurso

End

' ============================================
' Función   : OtraInstanciaActiva
' Propósito : Determina si YA hay otra instancia viva de gbpublisher para
'             este usuario en esta máquina. Valida el PID guardado contra
'             /proc: comprueba que el proceso exista Y que su cmdline sea
'             la de la app (descarta locks huérfanos y PIDs reutilizados).
'             Si el lock está libre, lo reescribe con el PID propio.
' Retorna   : Boolean — True si hay otra instancia viva; False si libre.
' ============================================
Public Function OtraInstanciaActiva() As Boolean

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim sRuta As String
  Dim sContenido As String
  Dim iPid As Integer
  Dim sCmdline As String

  sRuta = RutaLock()

  ' --- 2. SIN LOCK PREVIO: INSTANCIA LIBRE ---
  If Not Exist(sRuta) Then
    EscribirLock()
    Return False
  Endif

  ' --- 3. LEER EL PID GUARDADO ---
  Try sContenido = Trim$(File.Load(sRuta))
  If Error Then
    ' LOCK ILEGIBLE: TRATARLO COMO LIBRE Y REESCRIBIR
    EscribirLock()
    Return False
  Endif

  iPid = CInt(Val(sContenido))

  ' PID INVÁLIDO EN EL ARCHIVO: LOCK CORRUPTO → LIBRE
  If iPid <= 0 Then
    EscribirLock()
    Return False
  Endif

  ' --- 4. ¿EL PROCESO SIGUE VIVO? (/proc/PID) ---
  If Not Exist("/proc/" & CStr(iPid)) Then
    ' PROCESO MUERTO: LOCK HUÉRFANO → LIBRE
    EscribirLock()
    Return False
  Endif

  ' --- 5. ¿ES REALMENTE gbpublisher? (evita falso positivo por PID reutilizado) ---
  ' /proc/PID/cmdline SEPARA ARGUMENTOS CON NUL; BUSCAR EL NOMBRE ALCANZA
  Try sCmdline = File.Load("/proc/" & CStr(iPid) & "/cmdline")
  If Error Then
    ' NO SE PUDO LEER (proceso ajeno o ya terminado): TRATAR COMO LIBRE
    EscribirLock()
    Return False
  Endif

  If InStr(sCmdline, Application.Name) = 0 Then
    ' EL PID FUE REUTILIZADO POR OTRO PROGRAMA: LOCK HUÉRFANO → LIBRE
    EscribirLock()
    Return False
  Endif

  ' --- 6. INSTANCIA VIVA Y CONFIRMADA ---
  Return True

End

' ============================================
' Función   : EscribirLock
' Propósito : Escribe el lockfile con el PID del proceso actual, leído de
'             /proc/self/stat (primer campo). No es crítico: si falla, la
'             app arranca igual (solo se pierde la protección).
' ============================================
Private Sub EscribirLock()

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim sStat As String
  Dim iEspacio As Integer
  Dim sPid As String

  ' --- 2. LEER EL PID PROPIO ---
  Try sStat = File.Load("/proc/self/stat")
  If Error Then Return

  ' EL PID ES EL PRIMER CAMPO, ANTES DEL PRIMER ESPACIO
  ' (comm PUEDE CONTENER ESPACIOS/PARÉNTESIS; SOLO USAMOS EL PREFIJO NUMÉRICO)
  iEspacio = InStr(sStat, " ")
  If iEspacio = 0 Then Return
  sPid = Left$(sStat, iEspacio - 1)

  ' --- 3. ESCRIBIR EL LOCK ---
  Try File.Save(RutaLock(), sPid)

End

' ============================================
' Función   : LiberarLock
' Propósito : Elimina el lockfile de instancia única. Llamar en el cierre
'             limpio de la app (p. ej. desde CerrarTodoMySQL).
' ============================================
Public Sub LiberarLock()

  ' --- 1. BORRADO DEFENSIVO ---
  Try Kill RutaLock()

End

' ============================================
' Función   : RutaLock
' Propósito : Ruta del lockfile de instancia única. Incluye User.Name
'             (por usuario) y Application.Path sanitizado (separa la app
'             instalada de la corrida desde el IDE, que tienen distinta
'             ruta base). /tmp se limpia al reiniciar → sin huérfanos
'             persistentes; local a la máquina → válido con HOME en NFS.
' Retorna   : String — ruta absoluta del lockfile.
' ============================================
Private Function RutaLock() As String

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim sPathSanitizado As String

  ' --- 2. SANITIZAR LA RUTA BASE (LAS BARRAS ROMPEN EL NOMBRE DE ARCHIVO) ---
  ' INSTALADO Y IDE DIFIEREN EN Application.Path → LOCKS DISTINTOS,
  ' PERO LA MISMA APP INSTALADA COLISIONA CONSIGO MISMA
  sPathSanitizado = Replace(Application.Path, "/", "_")

  ' --- 3. RETORNO ---
  Return "/tmp/gbpublisher-" & User.Name & "-" & sPathSanitizado & ".lock"

End

' ============================================
' Función   : FamiliaDisponibleEnSistema
' Propósito : Pregunta a fontconfig si una familia tipográfica está
'             efectivamente disponible. Usa fc-match, que devuelve la
'             familia REALMENTE resuelta: si la pedida no está instalada
'             devuelve la de reemplazo (típicamente DejaVu).
' Parámetros: sFamilia As String — nombre exacto de la familia
' Retorna   : Boolean — True si fontconfig resuelve la familia pedida.
'             Devuelve False también cuando fontconfig no está disponible;
'             en ese caso el llamador cae al chequeo por archivos, que es
'             el camino seguro.
' ============================================
Private Function FamiliaDisponibleEnSistema(sFamilia As String) As Boolean

  Dim sSalida As String

  ' --- 1. CONSULTAR A fontconfig ---
  ' Exec Y NO Shell: EL NOMBRE DE FAMILIA LLEVA ESPACIOS Y NO DEBE PASAR
  ' POR sh -c (SC-05). EL ARRAY LITERAL VA EN UNA SOLA LÍNEA.
  ' LA FORMA "Exec ... To" NO LLEVA ASIGNACIÓN ADELANTE NI ADMITE Wait:
  ' YA ES SÍNCRONA Y VUELCA stdout EN LA VARIABLE DE LA CLÁUSULA To.
  sSalida = ""
  Try Exec ["fc-match", "-f", "%{family}", sFamilia] To sSalida

  ' --- 2. SIN fontconfig NO SE PUEDE AFIRMAR NADA (RC-GM-02) ---
  If Error Then Return False

  ' --- 3. COMPARAR LA FAMILIA RESUELTA CON LA PEDIDA ---
  ' COMPARACIÓN ASCII: InStr ES CORRECTO Y SUFICIENTE AQUÍ (RC-GM-12)
  Return (InStr(sSalida, sFamilia) > 0)

End

' ============================================
' Función   : VerificarFuentesIBMPlex
' Propósito : Garantiza que la familia IBM Plex esté disponible antes de que
'             la interfaz se renderice. Si el sistema ya la provee, no hace
'             nada. Si falta total o parcialmente, copia SOLO los archivos
'             ausentes desde los recursos del paquete, registra el cambio en
'             fontconfig y solicita reinicio: Qt fija su caché tipográfica al
'             arrancar el proceso y no la relee en caliente.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno). Termina con Quit ante error de instalación
'             o tras copiar fuentes nuevas.
' ============================================
Public Sub VerificarFuentesIBMPlex()

  Dim sFontDst As String
  Dim sFontSrc As String
  Dim sFuente As String
  Dim sParte As String
  Dim sAcum As String
  Dim sMensaje As String
  Dim aFuentes As String[]
  Dim aPartes As String[]
  Dim aNoEnPaquete As New String[]
  Dim aErrorCopia As New String[]
  Dim iPresentes As Integer
  Dim iCopiadas As Integer
  Dim iEsperadas As Integer
  Dim lTamOrigen As Long
  Dim lTamDestino As Long
  Dim bOrigenValido As Boolean
  Dim bCacheFallo As Boolean

  ' --- 1. INICIALIZACIÓN ---
  sFontDst = User.Home &/ m_Constantes.DIR_FUENTES_USUARIO
  sFontSrc = RutaRecursos() &/ "fonts"
  aFuentes = Split(m_Constantes.FUENTES_IBMPLEX, ",")
  iEsperadas = aFuentes.Count
  iPresentes = 0
  iCopiadas = 0
  bOrigenValido = False
  bCacheFallo = False

  ' --- 2. INVENTARIO COMPLETO DEL DESTINO ---
  ' SE CUENTAN LAS OCHO, NO UNA CENTINELA: UNA COPIA PARCIAL PREVIA DEBE
  ' PODER COMPLETARSE EN EL ARRANQUE SIGUIENTE EN LUGAR DE QUEDAR CONGELADA
  For Each sFuente In aFuentes
    If Exist(sFontDst &/ sFuente) Then Inc iPresentes
  Next

  ' NADA QUE HACER: LA INSTALACIÓN LOCAL ESTÁ COMPLETA
  If iPresentes = iEsperadas Then Return

  ' --- 3. FAMILIA YA PROVISTA POR EL SISTEMA ---
  ' SOLO VÁLIDO CON CERO ARCHIVOS PROPIOS: SI HAY ALGUNO, LA FAMILIA PODRÍA
  ' ESTAR RESOLVIENDO GRACIAS A NUESTRA PROPIA COPIA PARCIAL Y HAY QUE
  ' COMPLETARLA. If ANIDADO PORQUE And NO ES SHORT-CIRCUIT (RC-GM-17).
  If iPresentes = 0 Then
    If FamiliaDisponibleEnSistema(m_Constantes.FAMILIA_IBMPLEX_SANS) Then
      If FamiliaDisponibleEnSistema(m_Constantes.FAMILIA_IBMPLEX_MONO) Then Return
    Endif
  Endif

  ' --- 4. VERIFICAR EL ORIGEN EN EL PAQUETE ---
  ' IsDir DISTINGUE UN DIRECTORIO DE UN ARCHIVO SUELTO CON EL MISMO NOMBRE
  If Exist(sFontSrc) Then
    If IsDir(sFontSrc) Then bOrigenValido = True
  Endif

  If Not bOrigenValido Then
    m_Sonido.sonar("Error")
    Message.Error(
      "No se encontró el directorio de fuentes del paquete:" & Chr(10) &
      sFontSrc & Chr(10) & Chr(10) &
      "La instalación de gbpublisher puede estar incompleta." & Chr(10) &
      "Reinstale el paquete e intente nuevamente.")
    Quit
  Endif

  ' --- 5. CREAR EL ÁRBOL DE DESTINO NIVEL POR NIVEL ---
  ' Mkdir NO ES RECURSIVO. DOC OFICIAL: "If some parent directory of the
  ' specified path does not exist, then the command fails" (ERROR 45).
  ' EN UN HOME NUEVO ~/.local/share/fonts NORMALMENTE NO EXISTE TODAVÍA.
  aPartes = Split(m_Constantes.DIR_FUENTES_USUARIO, "/")
  sAcum = User.Home
  For Each sParte In aPartes
    sAcum = sAcum &/ sParte
    If Not Exist(sAcum) Then
      Try Mkdir sAcum
      ' RC-GM-02: Try NO INTERRUMPE LA EJECUCIÓN
      If Error Then
        m_Sonido.sonar("Error")
        Message.Error(
          "No se pudo crear el directorio de fuentes del usuario:" & Chr(10) &
          sAcum & Chr(10) & Chr(10) &
          Error.Text & Chr(10) & Chr(10) &
          "Verifique el espacio libre y los permisos de escritura en su " &
          "directorio personal.")
        Quit
      Endif
    Endif
  Next

  ' --- 6. COPIAR ÚNICAMENTE LAS FUENTES AUSENTES ---
  For Each sFuente In aFuentes

    ' YA PRESENTE: NO SE RECOPIA, LA OPERACIÓN ES IDEMPOTENTE
    If Exist(sFontDst &/ sFuente) Then Continue

    ' AUSENTE EN EL PAQUETE: CAUSA DISTINTA DE UN FALLO DE ESCRITURA,
    ' SE CONTABILIZA APARTE PARA NO EMITIR UN DIAGNÓSTICO FALSO
    If Not Exist(sFontSrc &/ sFuente) Then
      aNoEnPaquete.Add(sFuente)
      Continue
    Endif

    Try Copy sFontSrc &/ sFuente To sFontDst &/ sFuente
    If Error Then
      aErrorCopia.Add(sFuente)
      Continue
    Endif

    ' VERIFICAR TAMAÑO: UNA COPIA TRUNCADA POR DISCO LLENO DEJA UN .otf QUE
    ' EXISTE, QUE fontconfig IGNORA Y QUE EL INVENTARIO DEL APARTADO 2 DARÍA
    ' POR BUENO PARA SIEMPRE. SE BORRA PARA QUE EL PRÓXIMO ARRANQUE REINTENTE.
    lTamOrigen = -1
    lTamDestino = -2
    Try lTamOrigen = Stat(sFontSrc &/ sFuente).Size
    Try lTamDestino = Stat(sFontDst &/ sFuente).Size
    If lTamOrigen <> lTamDestino Then
      Try Kill sFontDst &/ sFuente
      aErrorCopia.Add(sFuente)
      Continue
    Endif

    Inc iCopiadas

  Next

  ' --- 7. NINGUNA COPIA NUEVA: DISTINGUIR LA CAUSA REAL ---
  If iCopiadas = 0 Then
    If aErrorCopia.Count > 0 Then
      ' EL PAQUETE ESTÁ BIEN, LO QUE FALLA ES LA ESCRITURA: PEDIR UNA
      ' REINSTALACIÓN ACÁ SERÍA MANDAR AL USUARIO A UN CALLEJÓN SIN SALIDA
      sMensaje =
        "No se pudieron escribir las fuentes IBM Plex en:" & Chr(10) &
        sFontDst & Chr(10) & Chr(10) &
        "Archivos afectados:" & Chr(10) &
        aErrorCopia.Join(Chr(10)) & Chr(10) & Chr(10) &
        "Verifique el espacio libre y los permisos de escritura en su " &
        "directorio personal."
    Else
      sMensaje =
        "No se encontraron las fuentes IBM Plex en el paquete instalado." & Chr(10) & Chr(10) &
        "Directorio buscado:" & Chr(10) &
        sFontSrc & Chr(10) & Chr(10) &
        "La instalación de gbpublisher puede estar incompleta." & Chr(10) &
        "Reinstale el paquete e intente nuevamente."
    Endif
    m_Sonido.sonar("Error")
    Message.Error(sMensaje)
    Quit
  Endif

  ' --- 8. REGISTRAR LAS FUENTES EN fontconfig ---
  ' NO ES CRÍTICO: fontconfig REDETECTA EL DIRECTORIO POR mtime EN EL PRÓXIMO
  ' ARRANQUE Y fc-cache SOLO ADELANTA ESE TRABAJO. POR ESO SU FALLA SE INFORMA
  ' PERO NO ABORTA. Exec Y NO Shell: LA RUTA NO DEBE PASAR POR sh -c (SC-05).
  Try Exec ["fc-cache", "-f", sFontDst] Wait
  If Error Then bCacheFallo = True

  ' --- 9. INFORMAR RESULTADO Y SOLICITAR REINICIO ---
  If (iPresentes + iCopiadas) < iEsperadas Then
    ' INSTALACIÓN PARCIAL: DETALLAR CADA CAUSA POR SEPARADO
    sMensaje =
      "Se instalaron " & CStr(iPresentes + iCopiadas) & " de " &
      CStr(iEsperadas) & " fuentes IBM Plex." & Chr(10) & Chr(10)
    If aNoEnPaquete.Count > 0 Then
      sMensaje &= "No están presentes en el paquete instalado:" & Chr(10) &
        aNoEnPaquete.Join(Chr(10)) & Chr(10) & Chr(10)
    Endif
    If aErrorCopia.Count > 0 Then
      sMensaje &= "No se pudieron escribir (espacio o permisos):" & Chr(10) &
        aErrorCopia.Join(Chr(10)) & Chr(10) & Chr(10)
    Endif
    sMensaje &= "La interfaz puede no visualizarse correctamente." & Chr(10) & Chr(10) &
      "Cierre y vuelva a abrir la aplicación para continuar."
  Else
    sMensaje =
      "Su sistema no tenía instalada la familia tipográfica IBM Plex." & Chr(10) & Chr(10) &
      "Las fuentes se instalaron correctamente en:" & Chr(10) &
      sFontDst & Chr(10) & Chr(10) &
      "Cierre la aplicación y vuelva a abrirla para continuar."
  Endif

  ' AVISO DIAGNÓSTICO: SI TRAS EL REINICIO LAS FUENTES SIGUEN SIN VERSE,
  ' ESTA LÍNEA EXPLICA POR QUÉ PUDO HACER FALTA UN SEGUNDO ARRANQUE
  If bCacheFallo Then
    sMensaje &= Chr(10) & Chr(10) &
      "Nota: no se pudo actualizar la caché de fuentes del sistema (fc-cache)."
  Endif

  m_Sonido.sonar("Info")
  Message.Info(sMensaje)
  Quit

End
