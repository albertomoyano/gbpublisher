# Gambas Form File 3.0

{ Form Form
  Move(0,0,441,297)
  #Scaled = False
  Resizable = False
  Arrangement = Arrange.Vertical
  AutoResize = True
  Spacing = True
  Margin = True
  Padding = 4
  { HBox3 HBox
    Move(45,9,360,36)
    { lblResize Label
      Move(108,0,108,36)
      Expand = True
      Alignment = Align.Center
    }
  }
  { HBox2 HBox
    Move(45,45,360,36)
    { PictureBox1 PictureBox
      Move(0,0,36,36)
      ToolTip = ("Brillo")
      Picture = Picture.Load("iconos/resize.png")
      Stretch = True
      Alignment = Align.Center
      Border = Border.Plain
    }
    { !SliderResize Slider
      Move(99,0,180,36)
      #Public = True
      Expand = True
      MinValue = -10
    }
    { !pbSemaforoR PictureBox
      Move(315,0,36,36)
      #Public = True
      Alignment = Align.Center
    }
  }
  { HBox1 HBox
    Move(45,153,360,36)
    { Spring1 Spring
      Move(18,0,36,36)
    }
    { btnAplicar Button
      Move(153,0,36,36)
      Picture = Picture["iconos/ok.png"]
    }
    { btnCerrar Button
      Move(189,0,36,36)
      Picture = Picture["iconos/salir.png"]
    }
  }
}
