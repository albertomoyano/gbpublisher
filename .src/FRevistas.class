' Gambas class file

' ============================================
' Formulario : FRevistas
' Propósito  : Las revistas de una editorial y sus secciones (etapa B2,
'              decisión de Alberto, 12/11: la pestaña «Revistas» de FSysAdmin
'              pasa a «Editorial» y un botón abre este formulario, hijo de la
'              editorial elegida). Trae lo que tenía la pestaña, sin los datos
'              que pasaron a la editorial (nombre, institución, ROR, lugar,
'              prefijo DOI, licencia y titular) y con el rótulo del volumen.
'              El correo queda como correo propio de la revista: vacío, vale
'              el de la editorial.
'              Las consultas, validaciones y grabaciones están en m_Revistas.
'              Etapa B3: la solapa «Órganos» edita los órganos editoriales de
'              la revista y sus miembros con vigencia (m_Organos; la persona
'              se elige con FBuscarAutor).
'              Etapa C2 (1.28.0): el logo de la cabecera del artículo, en la
'              base (revista.logo). Se carga y se quita en el acto, sin
'              «Guardar»: es un archivo, no un campo del formulario.
' Uso        : FRevistas.hConn = hConnServidor
'              FRevistas.iIdEditorial = …
'              FRevistas.sEditorial = …
'              FRevistas.sUsuario = sUsuarioActual
'              FRevistas.ShowModal()
' Conexión   : la que pasa FSysAdmin (puede no haber sesión: m_Revistas).
' ============================================

' CONEXIÓN, EDITORIAL Y USUARIO, LOS DA EL LLAMADOR
Public hConn As Connection
Public iIdEditorial As Integer
Public sEditorial As String
Public sUsuario As String

' COLUMNAS DE LAS GRILLAS (GV-58: CONTEO FIJO)
Private Const COLUMNAS_REVISTAS As Integer = 3
Private Const COLUMNAS_SECCIONES As Integer = 4
' UNA ENTRADA POR FILA, EN EL MISMO ORDEN QUE LA GRILLA
Private $aIdsRevistas As New Integer[]
' CANTIDAD DE NÚMEROS DE CADA FILA: SIN NÚMEROS SE PUEDE BORRAR (B2d)
Private $aNumerosRevistas As New Integer[]
Private $aIdsSecciones As New Integer[]
Private $iRevistaActual As Integer
Private $iSeccionActual As Integer
' IDIOMAS DE PUBLICACIÓN DE LA REVISTA ELEGIDA: EL PRIMERO TITULA LA GRILLA
Private $aIdiomasRevista As New String[]
' TÍTULOS DE LA SECCIÓN EN EDICIÓN, POR IDIOMA (DECISIÓN 20: UN IDIOMA A LA VEZ)
Private $cTitulosSeccion As New Collection
Private $sIdiomaTitulo As String
' EVITA QUE EL Click DEL COMBO DE IDIOMA ACTÚE MIENTRAS SE CARGA LA SECCIÓN
Private $bCargandoSeccion As Boolean
' PLANTILLAS DE RESUMEN DE LA REVISTA ELEGIDA: UN id POR ÍTEM DEL COMBO DE LA
' SECCIÓN; EL PRIMERO ES 0, «RESUMEN SIMPLE» (ENTREGA C2)
Private $aIdsPlantillas As New Integer[]
' --- SOLAPA «Órganos» (ETAPA B3) ---
Private Const COLUMNAS_ORGANOS As Integer = 4
Private Const COLUMNAS_MIEMBROS As Integer = 5
' UN id POR FILA, EN EL MISMO ORDEN QUE LA GRILLA
Private $aIdsOrganos As New Integer[]
Private $aIdsMiembros As New Integer[]
' EN LOS EDITORES: -1 NINGUNO, 0 ALTA, >0 EDICIÓN
Private $iOrganoActual As Integer = -1
Private $iMiembroActual As Integer = -1
' LA PERSONA DEL MIEMBRO EN EDICIÓN (id DE autores; 0 = NINGUNA)
Private $iAutorMiembro As Integer

' ============================================
' Función   : Form_Show
' Propósito : Aplicar la configuración de botones del marco (SC-20)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub Form_Show()

  m_Ventana.FijarBotones(Me)

End

' ============================================
' Función   : Form_Open
' Propósito : Prepara grillas y combos y lista las revistas de la editorial
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub Form_Open()

  ' --- 1. SIN CONEXIÓN O SIN EDITORIAL NO HAY QUÉ EDITAR ---
  ' If SEPARADOS: Or NO ES SHORT-CIRCUIT Y hConn PUEDE SER NULL (RC-GM-17)
  If Not hConn Then
    Me.Close()
    Return
  Endif
  If iIdEditorial <= 0 Then
    Me.Close()
    Return
  Endif

  ' --- 2. ROTULACIÓN ---
  lblEditorialRevistas.Text = sEditorial

  ' --- 3. GRILLAS, COMBOS Y DATOS ---
  ConfigurarGridsRevistas()
  ConfigurarGridsOrganos()
  LlenarCombosRevistas()
  CargarRevistas()

End

' ============================================
' Función   : btnCerrar_Click
' Propósito : Cierra el formulario; lo no guardado se descarta, como en la
'             pestaña de antes
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnCerrar_Click()

  Me.Close()

End

' ============================================
' Función   : ConfigurarGridsRevistas
' Propósito : Columnas de las grillas de revistas y de secciones (GV-58:
'             conteo fijo)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub ConfigurarGridsRevistas()

  ' --- 1. REVISTAS ---
  With gvRevistas
    .Header = GridView.Horizontal
    .Columns.Count = COLUMNAS_REVISTAS
    .Columns[0].Title = "Título"
    .Columns[0].Width = 300
    .Columns[1].Title = "ISSN-e"
    .Columns[1].Width = 90
    .Columns[2].Title = "Números"
    .Columns[2].Width = 70
    .Rows.Count = 0
  End With

  ' --- 2. SECCIONES ---
  With gvSecciones
    .Header = GridView.Horizontal
    .Columns.Count = COLUMNAS_SECCIONES
    .Columns[0].Title = "Código"
    .Columns[0].Width = 140
    .Columns[1].Title = "Título"
    .Columns[1].Width = 260
    .Columns[2].Title = "Orden"
    .Columns[2].Width = 60
    .Columns[3].Title = "Estado"
    .Columns[3].Width = 70
    .Rows.Count = 0
  End With

End

' ============================================
' Función   : LlenarCombosRevistas
' Propósito : Carga los combos de valores cerrados de los dos editores
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub LlenarCombosRevistas()

  ' --- 1. LISTAS FIJAS: EL ÍNDICE DEL COMBO ES EL DE LA LISTA DE CÓDIGOS ---
  cmbModeloPaginacionRevista.List = m_Revistas.ModelosPaginacionLeyendas()
  cmbTipoAccesoRevista.List = m_Revistas.TiposAccesoLeyendas()
  cmbTipoArticuloSeccion.List = m_Revistas.TiposArticulo()

  ' --- 2. CATÁLOGOS ---
  ' ESTILOS DE CITA: EL MISMO CATÁLOGO QUE LIBROS (SC-57). LAS LICENCIAS SON
  ' DE LA EDITORIAL (1.26.0): SU COMBO ESTÁ EN FSysAdmin
  m_Revistas.LlenarComboEstilos(cmbEstiloCitaRevista)

End

' ============================================
' Función   : CargarRevistas
' Propósito : Llena la grilla con las revistas de la editorial, limpia los dos
'             editores y deja los botones como corresponde a «nada elegido»
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub CargarRevistas()

  Dim rDatos As Result
  Dim iFila As Integer

  ' --- 1. LECTURA ---
  $aIdsRevistas.Clear()
  $aNumerosRevistas.Clear()
  gvRevistas.Rows.Count = 0
  rDatos = m_Revistas.ListarRevistas(hConn, iIdEditorial)

  ' --- 2. GRILLA, CON UN id POR FILA EN EL MISMO ORDEN ---
  If rDatos Then
    gvRevistas.Rows.Count = rDatos.Count
    iFila = 0
    While rDatos.Available
      $aIdsRevistas.Add(rDatos!id_revista)
      gvRevistas[iFila, 0].Text = rDatos!titulo
      gvRevistas[iFila, 1].Text = m_Revistas.TextoDe(rDatos, "issn_electronico")
      ' COUNT LLEGA COMO Long
      gvRevistas[iFila, 2].Text = CStr(rDatos!numeros)
      $aNumerosRevistas.Add(rDatos!numeros)
      Inc iFila
      rDatos.MoveNext
    Wend
  Endif

  ' --- 3. NADA ELEGIDO ---
  $iRevistaActual = 0
  $iSeccionActual = 0
  LimpiarEditorRevista()
  LimpiarEditorSeccion()
  gvSecciones.Rows.Count = 0
  $aIdsSecciones.Clear()
  btnGuardarRevista.Enabled = False
  btnBorrarRevista.Enabled = False
  btnNuevaSeccion.Enabled = False
  btnGuardarSeccion.Enabled = False
  btnPlantillasResumen.Enabled = False
  btnReaperturas.Enabled = False
  btnCargarLogoRevista.Enabled = False
  btnQuitarLogoRevista.Enabled = False
  ' SIN REVISTA, LA SOLAPA «Órganos» QUEDA VACÍA Y SIN ALTA
  CargarOrganos()

End

' ============================================
' Función   : gvRevistas_Click
' Propósito : Al elegir una revista, carga su editor y sus secciones
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub gvRevistas_Click()

  Dim iFila As Integer

  ' --- 1. FILA VÁLIDA ---
  iFila = gvRevistas.Row
  If iFila < 0 Or iFila >= $aIdsRevistas.Count Then Return

  ' --- 2. EDITOR Y SECCIONES ---
  $iRevistaActual = $aIdsRevistas[iFila]
  If Not CargarRevistaEnEditor($iRevistaActual) Then Return
  CargarSecciones()
  ' LAS PLANTILLAS SON DE LA REVISTA: EL COMBO DE LA SECCIÓN SE REARMA
  LlenarComboPlantillas()
  ' LOS ÓRGANOS TAMBIÉN SON DE LA REVISTA
  CargarOrganos()

  ' --- 3. BOTONES ---
  btnGuardarRevista.Enabled = True
  ' SOLO SIN NÚMEROS: LA QUE TIENE NÚMEROS NO SE BORRA
  btnBorrarRevista.Enabled = $aNumerosRevistas[iFila] = 0
  btnNuevaSeccion.Enabled = True
  btnGuardarSeccion.Enabled = False
  btnPlantillasResumen.Enabled = True
  btnReaperturas.Enabled = True
  btnCargarLogoRevista.Enabled = True
  ' QUITAR, SOLO SI HAY LOGO (LO DECIDE MostrarLogo, LLAMADA AL CARGAR)
  tsRevistas.Index = 0

End

' ============================================
' Función   : CargarRevistaEnEditor
' Propósito : Vuelca el registro de la revista a la pestaña «Revista»
' Parámetros: iIdRevista As Integer — revista
' Retorna   : Boolean — True si se cargó
' ============================================
Private Function CargarRevistaEnEditor(iIdRevista As Integer) As Boolean

  Dim rDatos As Result
  Dim iIndice As Integer
  Dim sEstilo As String

  ' --- 1. LECTURA ---
  rDatos = m_Revistas.CargarRevista(hConn, iIdRevista)
  If Not rDatos Then Return False

  ' --- 2. TEXTOS ---
  txtTituloRevista.Text = m_Revistas.TextoDe(rDatos, "titulo")
  txtTituloAbreviadoRevista.Text = m_Revistas.TextoDe(rDatos, "titulo_abreviado")
  txtAcronimoRevista.Text = m_Revistas.TextoDe(rDatos, "acronimo")
  txtIssnImpresoRevista.Text = m_Revistas.TextoDe(rDatos, "issn_impreso")
  txtIssnElectronicoRevista.Text = m_Revistas.TextoDe(rDatos, "issn_electronico")
  ' CORREO PROPIO; VACÍO, VALE EL DE LA EDITORIAL (1.26.0)
  txtEmailRevista.Text = m_Revistas.TextoDe(rDatos, "email_editorial")
  txtRotuloVolumenRevista.Text = m_Revistas.TextoDe(rDatos, "rotulo_volumen")
  txtIdiomasRevista.Text = m_Revistas.TextoDe(rDatos, "idiomas_publicacion")

  ' --- 3. COMBOS DE SOLO LECTURA: SE UBICAN POR ÍNDICE ---
  iIndice = m_Revistas.IndiceDe(m_Revistas.ModelosPaginacionCodigos(), m_Revistas.TextoDe(rDatos, "modelo_paginacion"))
  If iIndice < 0 Then iIndice = 0
  cmbModeloPaginacionRevista.Index = iIndice

  iIndice = m_Revistas.IndiceDe(m_Revistas.TiposAccesoCodigos(), m_Revistas.TextoDe(rDatos, "tipo_acceso_defecto"))
  If iIndice < 0 Then iIndice = 0
  cmbTipoAccesoRevista.Index = iIndice

  ' --- 4. ESTILO DE CITA ---
  ' UN ESTILO GUARDADO QUE YA NO ESTÁ INSTALADO SE MUESTRA IGUAL: EL COMBO ES
  ' EDITABLE Y NO LO PIERDE (SC-23)
  sEstilo = m_Revistas.TextoDe(rDatos, "estilo_cita")
  If sEstilo = "" Then
    cmbEstiloCitaRevista.Text = ""
  Else
    cmbEstiloCitaRevista.Text = m_Revistas.TextoComboEstilo(sEstilo)
  Endif

  ' --- 5. EL LOGO (1.28.0) ---
  ' SELECT * LO TRAE; NULL LLEGA COMO Blob VACÍO (m_Revistas.DatosDeBlob)
  MostrarLogo(m_Revistas.DatosDeBlob(rDatos!logo))

  ' --- 6. AUDITORÍA, SOLO LECTURA ---
  txtAuditoriaRevista.Text = m_Revistas.TextoDe(rDatos, "fecha_creacion") & "  ·  " & m_Revistas.TextoDe(rDatos, "usuario_creacion")

  Return True

End

' ============================================
' Función   : LimpiarEditorRevista
' Propósito : Deja vacía la pestaña «Revista»
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub LimpiarEditorRevista()

  txtTituloRevista.Text = ""
  txtTituloAbreviadoRevista.Text = ""
  txtAcronimoRevista.Text = ""
  txtIssnImpresoRevista.Text = ""
  txtIssnElectronicoRevista.Text = ""
  txtEmailRevista.Text = ""
  txtRotuloVolumenRevista.Text = ""
  txtIdiomasRevista.Text = ""
  cmbEstiloCitaRevista.Text = ""
  cmbModeloPaginacionRevista.Index = 0
  cmbTipoAccesoRevista.Index = 0
  MostrarLogo("")
  txtAuditoriaRevista.Text = ""

End

' ============================================
' Función   : btnNuevaRevista_Click
' Propósito : Alta mínima de una revista de la editorial y su selección, como
'             Colecciones
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnNuevaRevista_Click()

  Dim iNueva As Integer

  ' --- 1. ALTA ---
  iNueva = m_Revistas.CrearRevista(hConn, sUsuario, iIdEditorial)
  If iNueva = 0 Then Return

  ' --- 2. RELECTURA Y SELECCIÓN DE LA NUEVA ---
  CargarRevistas()
  SeleccionarRevista(iNueva)
  txtTituloRevista.SetFocus()
  txtTituloRevista.SelectAll()

End

' ============================================
' Función   : SeleccionarRevista
' Propósito : Ubica la grilla en una revista y la carga
' Parámetros: iIdRevista As Integer — revista
' Retorna   : nada
' ============================================
Private Sub SeleccionarRevista(iIdRevista As Integer)

  Dim iFila As Integer

  iFila = $aIdsRevistas.Find(iIdRevista)
  If iFila < 0 Then Return
  gvRevistas.Row = iFila
  gvRevistas_Click()

End

' ============================================
' Función   : btnBorrarRevista_Click
' Propósito : Borra la revista elegida si no tiene números, con lo que
'             cuelga de ella, después de confirmar (por ejemplo, una
'             «(Nueva revista)» creada por error). La pregunta dice qué se
'             va con ella
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnBorrarRevista_Click()

  Dim iFila As Integer
  Dim sContenido As String

  ' --- 1. HAY REVISTA ELEGIDA ---
  If $iRevistaActual <= 0 Then Return
  iFila = $aIdsRevistas.Find($iRevistaActual)
  If iFila < 0 Then Return

  ' --- 2. CONFIRMACIÓN, CON LO QUE SE BORRA JUNTO ---
  sContenido = m_Revistas.ContenidoRevista(hConn, $iRevistaActual)
  If sContenido <> "" Then sContenido = Chr(10) & Chr(10) & "También se borran: " & sContenido & "."
  m_Sonido.sonar("Question")
  If Message.Question("¿Borrar la revista «" & gvRevistas[iFila, 0].Text & "»?" & sContenido, "Borrar", "Cancelar") <> 1 Then Return

  ' --- 3. BORRADO Y RELECTURA ---
  If Not m_Revistas.BorrarRevista(hConn, $iRevistaActual) Then Return
  m_Sonido.sonar("Info")
  CargarRevistas()

End

' ============================================
' Función   : btnGuardarRevista_Click
' Propósito : Junta los valores del editor y los graba por m_Revistas
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnGuardarRevista_Click()

  Dim cDatos As New Collection
  Dim iRevista As Integer

  ' --- 1. HAY REVISTA ELEGIDA ---
  If $iRevistaActual <= 0 Then Return

  ' --- 2. VALORES, POR NOMBRE DE COLUMNA; Null DONDE NO HAY DATO ---
  cDatos["titulo"] = m_Revistas.NuloSiVacio(txtTituloRevista.Text)
  cDatos["titulo_abreviado"] = m_Revistas.NuloSiVacio(txtTituloAbreviadoRevista.Text)
  cDatos["acronimo"] = m_Revistas.NuloSiVacio(txtAcronimoRevista.Text)
  cDatos["issn_impreso"] = m_Revistas.NuloSiVacio(UCase(txtIssnImpresoRevista.Text))
  cDatos["issn_electronico"] = m_Revistas.NuloSiVacio(UCase(txtIssnElectronicoRevista.Text))
  cDatos["email_editorial"] = m_Revistas.NuloSiVacio(txtEmailRevista.Text)
  cDatos["estilo_cita"] = m_Revistas.NuloSiVacio(m_Revistas.EstiloDesdeCombo(cmbEstiloCitaRevista.Text))
  cDatos["modelo_paginacion"] = m_Revistas.ModelosPaginacionCodigos()[cmbModeloPaginacionRevista.Index]
  cDatos["rotulo_volumen"] = m_Revistas.NuloSiVacio(txtRotuloVolumenRevista.Text)
  cDatos["idiomas_publicacion"] = m_Revistas.NuloSiVacio(txtIdiomasRevista.Text)
  cDatos["tipo_acceso_defecto"] = m_Revistas.NuloSiVacio(m_Revistas.TiposAccesoCodigos()[cmbTipoAccesoRevista.Index])

  ' --- 3. GRABACIÓN ---
  If Not m_Revistas.GuardarRevista(hConn, $iRevistaActual, cDatos) Then Return

  ' --- 4. RELECTURA MANTENIENDO LA SELECCIÓN ---
  ' EL TÍTULO PUEDE HABER CAMBIADO EL ORDEN DE LA GRILLA
  m_Sonido.sonar("Info")
  iRevista = $iRevistaActual
  CargarRevistas()
  SeleccionarRevista(iRevista)

End

' ============================================
' Función   : CargarSecciones
' Propósito : Llena la grilla de secciones de la revista elegida, con el
'             título en su primer idioma de publicación
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub CargarSecciones()

  Dim rDatos As Result
  Dim iFila As Integer

  ' --- 1. LIMPIEZA ---
  gvSecciones.Rows.Count = 0
  $aIdsSecciones.Clear()
  $iSeccionActual = 0
  LimpiarEditorSeccion()

  ' --- 2. IDIOMAS DE LA REVISTA: EL PRIMERO TITULA LA GRILLA ---
  $aIdiomasRevista = m_Revistas.IdiomasDeRevista(hConn, $iRevistaActual)
  If $aIdiomasRevista.Count > 0 Then
    gvSecciones.Columns[1].Title = "Título (" & $aIdiomasRevista[0] & ")"
    rDatos = m_Revistas.ListarSecciones(hConn, $iRevistaActual, $aIdiomasRevista[0])
  Else
    gvSecciones.Columns[1].Title = "Título"
    rDatos = m_Revistas.ListarSecciones(hConn, $iRevistaActual, "")
  Endif
  If Not rDatos Then Return

  ' --- 3. GRILLA ---
  gvSecciones.Rows.Count = rDatos.Count
  iFila = 0
  While rDatos.Available
    $aIdsSecciones.Add(rDatos!id_seccion)
    gvSecciones[iFila, 0].Text = rDatos!codigo
    gvSecciones[iFila, 1].Text = m_Revistas.TextoDe(rDatos, "titulo")
    gvSecciones[iFila, 2].Text = CStr(rDatos!orden)
    ' RC-GM-01: TINYINT(1) LLEGA COMO Boolean
    gvSecciones[iFila, 3].Text = If(rDatos!activa, "Activa", "Inactiva")
    Inc iFila
    rDatos.MoveNext
  Wend

End

' ============================================
' Función   : gvSecciones_Click
' Propósito : Al elegir una sección, la carga en la pestaña «Secciones»
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub gvSecciones_Click()

  Dim iFila As Integer

  ' --- 1. FILA VÁLIDA ---
  iFila = gvSecciones.Row
  If iFila < 0 Or iFila >= $aIdsSecciones.Count Then Return

  ' --- 2. EDITOR ---
  $iSeccionActual = $aIdsSecciones[iFila]
  If Not CargarSeccionEnEditor($iSeccionActual) Then Return
  btnGuardarSeccion.Enabled = True
  tsRevistas.Index = 1

End

' ============================================
' Función   : CargarSeccionEnEditor
' Propósito : Vuelca la sección y sus títulos a la pestaña «Secciones». Los
'             títulos quedan en $cTitulosSeccion; el campo muestra el del
'             idioma elegido en el combo (decisión 20)
' Parámetros: iIdSeccion As Integer — sección
' Retorna   : Boolean — True si se cargó
' ============================================
Private Function CargarSeccionEnEditor(iIdSeccion As Integer) As Boolean

  Dim rDatos As Result
  Dim iIndice As Integer

  ' --- 1. LECTURA ---
  rDatos = m_Revistas.CargarSeccion(hConn, iIdSeccion)
  If Not rDatos Then Return False

  ' --- 2. CAMPOS ---
  ' $bCargandoSeccion: ASIGNAR UN COMBO POR CÓDIGO PUEDE DISPARAR SU Click, Y
  ' ESE Click NO DEBE GUARDAR EL TÍTULO DEL IDIOMA ANTERIOR
  $bCargandoSeccion = True
  txtCodigoSeccion.Text = rDatos!codigo
  spnOrdenSeccion.Value = rDatos!orden
  chkActivaSeccion.Value = rDatos!activa
  iIndice = m_Revistas.IndiceDe(m_Revistas.TiposArticulo(), m_Revistas.TextoDe(rDatos, "article_type_defecto"))
  cmbTipoArticuloSeccion.Index = iIndice
  ' PLANTILLA DE RESUMEN: NULL ES EL PRIMER ÍTEM, «RESUMEN SIMPLE»
  If IsNull(rDatos!id_plantilla_resumen) Then
    cmbPlantillaSeccion.Index = 0
  Else
    cmbPlantillaSeccion.Index = $aIdsPlantillas.Find(rDatos!id_plantilla_resumen)
  Endif

  ' --- 3. TÍTULOS POR IDIOMA ---
  $cTitulosSeccion = m_Revistas.TitulosSeccion(hConn, iIdSeccion)
  cmbIdiomaSeccion.List = $aIdiomasRevista
  If $aIdiomasRevista.Count > 0 Then
    cmbIdiomaSeccion.Index = 0
    $sIdiomaTitulo = $aIdiomasRevista[0]
    txtTituloSeccion.Enabled = True
  Else
    ' SIN IDIOMAS DE PUBLICACIÓN NO HAY DÓNDE TITULAR: SE AVISA AL GUARDAR
    $sIdiomaTitulo = ""
    txtTituloSeccion.Enabled = False
  Endif
  MostrarTituloSeccion()
  $bCargandoSeccion = False

  Return True

End

' ============================================
' Función   : MostrarTituloSeccion
' Propósito : Pone en el campo el título del idioma actual
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub MostrarTituloSeccion()

  If $sIdiomaTitulo <> "" Then
    If $cTitulosSeccion.Exist($sIdiomaTitulo) Then
      txtTituloSeccion.Text = $cTitulosSeccion[$sIdiomaTitulo]
      Return
    Endif
  Endif
  txtTituloSeccion.Text = ""

End

' ============================================
' Función   : GuardarTituloEnMemoria
' Propósito : Pasa lo escrito en el campo al título del idioma actual, antes
'             de cambiar de idioma o de grabar
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub GuardarTituloEnMemoria()

  If $sIdiomaTitulo = "" Then Return
  $cTitulosSeccion[$sIdiomaTitulo] = txtTituloSeccion.Text

End

' ============================================
' Función   : cmbIdiomaSeccion_Click
' Propósito : Cambio de idioma: guarda en memoria el título del idioma que se
'             deja y muestra el del nuevo
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub cmbIdiomaSeccion_Click()

  ' --- 1. DURANTE LA CARGA NO SE TOCA NADA ---
  If $bCargandoSeccion Then Return

  ' --- 2. CAMBIO DE IDIOMA ---
  GuardarTituloEnMemoria()
  $sIdiomaTitulo = cmbIdiomaSeccion.Text
  MostrarTituloSeccion()

End

' ============================================
' Función   : LimpiarEditorSeccion
' Propósito : Deja vacía la pestaña «Secciones»
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub LimpiarEditorSeccion()

  $bCargandoSeccion = True
  txtCodigoSeccion.Text = ""
  spnOrdenSeccion.Value = 0
  chkActivaSeccion.Value = False
  cmbTipoArticuloSeccion.Index = -1
  cmbPlantillaSeccion.Index = -1
  cmbIdiomaSeccion.Clear()
  txtTituloSeccion.Text = ""
  $cTitulosSeccion = New Collection
  $sIdiomaTitulo = ""
  $bCargandoSeccion = False

End

' ============================================
' Función   : btnNuevaSeccion_Click
' Propósito : Alta mínima de una sección en la revista elegida y su selección
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnNuevaSeccion_Click()

  Dim iNueva As Integer

  ' --- 1. HAY REVISTA ELEGIDA ---
  If $iRevistaActual <= 0 Then Return

  ' --- 2. ALTA ---
  iNueva = m_Revistas.CrearSeccion(hConn, $iRevistaActual)
  If iNueva = 0 Then Return

  ' --- 3. RELECTURA Y SELECCIÓN DE LA NUEVA ---
  CargarSecciones()
  SeleccionarSeccion(iNueva)
  txtCodigoSeccion.SetFocus()
  txtCodigoSeccion.SelectAll()

End

' ============================================
' Función   : SeleccionarSeccion
' Propósito : Ubica la grilla en una sección y la carga
' Parámetros: iIdSeccion As Integer — sección
' Retorna   : nada
' ============================================
Private Sub SeleccionarSeccion(iIdSeccion As Integer)

  Dim iFila As Integer

  iFila = $aIdsSecciones.Find(iIdSeccion)
  If iFila < 0 Then Return
  gvSecciones.Row = iFila
  gvSecciones_Click()

End

' ============================================
' Función   : btnGuardarSeccion_Click
' Propósito : Junta los valores de la sección y sus títulos y los graba por
'             m_Revistas
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnGuardarSeccion_Click()

  Dim cDatos As New Collection
  Dim iSeccion As Integer

  ' --- 1. HAY SECCIÓN ELEGIDA ---
  If $iSeccionActual <= 0 Then Return

  ' --- 2. EL TÍTULO A LA VISTA TODAVÍA NO PASÓ A LA MEMORIA ---
  GuardarTituloEnMemoria()

  ' --- 3. VALORES ---
  cDatos["codigo"] = Trim(txtCodigoSeccion.Text)
  cDatos["orden"] = spnOrdenSeccion.Value
  If cmbTipoArticuloSeccion.Index < 0 Then
    cDatos["article_type_defecto"] = Null
  Else
    cDatos["article_type_defecto"] = cmbTipoArticuloSeccion.Text
  Endif
  cDatos["activa"] = If(chkActivaSeccion.Value, 1, 0)
  ' SIN ELEGIR O «RESUMEN SIMPLE»: NULL
  If cmbPlantillaSeccion.Index > 0 Then
    cDatos["id_plantilla_resumen"] = $aIdsPlantillas[cmbPlantillaSeccion.Index]
  Else
    cDatos["id_plantilla_resumen"] = Null
  Endif

  ' --- 4. GRABACIÓN ---
  If Not m_Revistas.GuardarSeccion(hConn, $iSeccionActual, $iRevistaActual, cDatos, $cTitulosSeccion, $aIdiomasRevista) Then Return

  ' --- 5. RELECTURA MANTENIENDO LA SELECCIÓN ---
  m_Sonido.sonar("Info")
  iSeccion = $iSeccionActual
  CargarSecciones()
  SeleccionarSeccion(iSeccion)

End

' ============================================
' Función   : LlenarComboPlantillas
' Propósito : Llena el combo de plantilla de la sección con las plantillas de
'             la revista elegida; el primer ítem es «resumen simple» (Null)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub LlenarComboPlantillas()

  Dim rDatos As Result

  ' --- 1. PRIMER ÍTEM: SIN PLANTILLA ---
  cmbPlantillaSeccion.Clear()
  $aIdsPlantillas.Clear()
  cmbPlantillaSeccion.Add("(resumen simple)")
  $aIdsPlantillas.Add(0)

  ' --- 2. LAS DE LA REVISTA; LAS INACTIVAS SE MARCAN PERO SE MUESTRAN, PORQUE
  ' UNA SECCIÓN PUEDE TENERLA ASIGNADA ---
  rDatos = m_Revistas.ListarPlantillas(hConn, $iRevistaActual)
  If Not rDatos Then Return
  While rDatos.Available
    ' CBool: TINYINT(1) LLEGA COMO Boolean Y True VALE -1 (MEDIDO, 28/10)
    cmbPlantillaSeccion.Add(rDatos!nombre & If(CBool(rDatos!activa), "", "  (inactiva)"))
    $aIdsPlantillas.Add(rDatos!id_plantilla)
    rDatos.MoveNext
  Wend

End

' ============================================
' Función   : btnPlantillasResumen_Click
' Propósito : Abre el diálogo de plantillas de la revista elegida y, al
'             volver, rearma el combo y recarga la sección a la vista
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnPlantillasResumen_Click()

  Dim iSeccion As Integer

  ' --- 1. HAY REVISTA ELEGIDA ---
  If $iRevistaActual <= 0 Then Return

  ' --- 2. DIÁLOGO, CON LA CONEXIÓN QUE PASÓ FSysAdmin (PUEDE NO HABER SESIÓN) ---
  FPlantillasResumen.hConn = hConn
  FPlantillasResumen.iIdRevista = $iRevistaActual
  FPlantillasResumen.ShowModal()

  ' --- 3. COMBO NUEVO Y SECCIÓN A LA VISTA RECARGADA ---
  iSeccion = $iSeccionActual
  LlenarComboPlantillas()
  If iSeccion > 0 Then SeleccionarSeccion(iSeccion)

End

' ============================================
' Función   : btnReaperturas_Click
' Propósito : Abre el diálogo para reabrir un artículo publicado de la
'             revista elegida (entrega E, decisión 17). Quien reabre es el
'             administrador validado en FSysAdmin
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnReaperturas_Click()

  Dim iFila As Integer

  ' --- 1. HAY REVISTA ELEGIDA ---
  If $iRevistaActual <= 0 Then Return
  iFila = $aIdsRevistas.Find($iRevistaActual)

  ' --- 2. DIÁLOGO, CON LA CONEXIÓN QUE PASÓ FSysAdmin (PUEDE NO HABER SESIÓN) ---
  ' EL TÍTULO SALE DE LA GRILLA, QUE ES LO GUARDADO (NO DEL EDITOR)
  FReabrirArticulo.hConn = hConn
  FReabrirArticulo.iIdRevista = $iRevistaActual
  If iFila >= 0 Then FReabrirArticulo.sRevista = gvRevistas[iFila, 0].Text
  FReabrirArticulo.sUsuario = sUsuario
  FReabrirArticulo.ShowModal()

End

' ════════════════════════════════════════════════════════════════════════════
' SOLAPA «Órganos» (ETAPA B3, 1.26.0): LOS ÓRGANOS EDITORIALES DE LA REVISTA
' ELEGIDA Y SUS MIEMBROS CON VIGENCIA. LAS CONSULTAS, LAS VALIDACIONES Y LAS
' GRABACIONES ESTÁN EN m_Organos; LA PERSONA SE ELIGE CON FBuscarAutor
' ════════════════════════════════════════════════════════════════════════════

' ============================================
' Función   : ConfigurarGridsOrganos
' Propósito : Columnas de las grillas de órganos y de miembros (GV-58:
'             conteo fijo)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub ConfigurarGridsOrganos()

  ' --- 1. ÓRGANOS ---
  With gvOrganos
    .Header = GridView.Horizontal
    .Columns.Count = COLUMNAS_ORGANOS
    .Columns[0].Title = "Órgano"
    .Columns[0].Width = 180
    .Columns[1].Title = "Orden"
    .Columns[1].Width = 55
    .Columns[2].Title = "Estado"
    .Columns[2].Width = 70
    .Columns[3].Title = "Vigentes"
    .Columns[3].Width = 70
    .Rows.Count = 0
  End With

  ' --- 2. MIEMBROS ---
  With gvMiembros
    .Header = GridView.Horizontal
    .Columns.Count = COLUMNAS_MIEMBROS
    .Columns[0].Title = "Persona"
    .Columns[0].Width = 130
    .Columns[1].Title = "Afiliación"
    .Columns[1].Width = 100
    .Columns[2].Title = "Orden"
    .Columns[2].Width = 45
    .Columns[3].Title = "Desde"
    .Columns[3].Width = 85
    .Columns[4].Title = "Hasta"
    .Columns[4].Width = 85
    .Rows.Count = 0
  End With

End

' ============================================
' Función   : CargarOrganos
' Propósito : Llena la grilla de órganos de la revista elegida y deja vacíos
'             los dos editores
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub CargarOrganos()

  Dim rDatos As Result
  Dim iFila As Integer

  ' --- 1. LIMPIEZA ---
  gvOrganos.Rows.Count = 0
  $aIdsOrganos.Clear()
  LimpiarEditorOrgano()
  $iOrganoActual = -1
  LimpiarMiembros()
  btnNuevoOrgano.Enabled = $iRevistaActual > 0
  btnGuardarOrgano.Enabled = False
  btnBorrarOrgano.Enabled = False
  If $iRevistaActual <= 0 Then Return

  ' --- 2. LECTURA ---
  rDatos = m_Organos.ListarOrganos(hConn, $iRevistaActual)
  If Not rDatos Then Return

  ' --- 3. GRILLA; «Vigentes» CUENTA A HOY, SOBRE EL TOTAL ---
  gvOrganos.Rows.Count = rDatos.Count
  iFila = 0
  While rDatos.Available
    $aIdsOrganos.Add(rDatos!id_organo)
    gvOrganos[iFila, 0].Text = rDatos!nombre
    gvOrganos[iFila, 1].Text = CStr(rDatos!orden)
    ' CBool: TINYINT(1) LLEGA COMO Boolean (RC-GM-01)
    gvOrganos[iFila, 2].Text = If(CBool(rDatos!activo), "Activo", "Inactivo")
    gvOrganos[iFila, 3].Text = CStr(rDatos!vigentes) & " de " & CStr(rDatos!miembros)
    Inc iFila
    rDatos.MoveNext
  Wend

End

' ============================================
' Función   : LimpiarEditorOrgano
' Propósito : Deja vacíos los campos del órgano
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub LimpiarEditorOrgano()

  txtNombreOrgano.Text = ""
  spnOrdenOrgano.Value = 0
  chkActivoOrgano.Value = False

End

' ============================================
' Función   : gvOrganos_Click
' Propósito : Al elegir un órgano, lo carga en su editor y lista sus
'             miembros
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub gvOrganos_Click()

  Dim iFila As Integer
  Dim rDatos As Result

  ' --- 1. FILA VÁLIDA ---
  iFila = gvOrganos.Row
  If iFila < 0 Or iFila >= $aIdsOrganos.Count Then Return

  ' --- 2. LECTURA Y CAMPOS ---
  rDatos = m_Organos.CargarOrgano(hConn, $aIdsOrganos[iFila])
  If Not rDatos Then Return
  $iOrganoActual = $aIdsOrganos[iFila]
  txtNombreOrgano.Text = rDatos!nombre
  spnOrdenOrgano.Value = rDatos!orden
  chkActivoOrgano.Value = CBool(rDatos!activo)

  ' --- 3. BOTONES Y MIEMBROS ---
  btnGuardarOrgano.Enabled = True
  btnBorrarOrgano.Enabled = True
  CargarMiembros()

End

' ============================================
' Función   : btnNuevoOrgano_Click
' Propósito : Prepara el editor para un órgano nuevo. No graba nada: el alta
'             la hace «Guardar», porque el nombre es obligatorio (mismo
'             criterio que los créditos de la editorial)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnNuevoOrgano_Click()

  ' --- 1. HAY REVISTA ELEGIDA ---
  If $iRevistaActual <= 0 Then Return

  ' --- 2. EDITOR VACÍO EN MODO ALTA (0); UN ÓRGANO NUEVO NACE ACTIVO ---
  LimpiarEditorOrgano()
  chkActivoOrgano.Value = True
  $iOrganoActual = 0
  LimpiarMiembros()
  btnGuardarOrgano.Enabled = True
  btnBorrarOrgano.Enabled = False
  txtNombreOrgano.SetFocus()

End

' ============================================
' Función   : btnGuardarOrgano_Click
' Propósito : Graba el órgano en edición (alta si es nuevo) y lo vuelve a
'             elegir
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnGuardarOrgano_Click()

  Dim cDatos As New Collection
  Dim iOrgano As Integer

  ' --- 1. HAY REVISTA Y UN ÓRGANO EN EDICIÓN (0 = ALTA) ---
  If $iRevistaActual <= 0 Then Return
  If $iOrganoActual < 0 Then Return

  ' --- 2. VALORES ---
  cDatos["nombre"] = m_Revistas.NuloSiVacio(txtNombreOrgano.Text)
  cDatos["orden"] = spnOrdenOrgano.Value
  cDatos["activo"] = If(chkActivoOrgano.Value, 1, 0)

  ' --- 3. GRABACIÓN ---
  iOrgano = m_Organos.GuardarOrgano(hConn, $iOrganoActual, $iRevistaActual, cDatos)
  If iOrgano = 0 Then Return

  ' --- 4. RELECTURA Y SELECCIÓN DEL GRABADO ---
  m_Sonido.sonar("Info")
  CargarOrganos()
  SeleccionarOrgano(iOrgano)

End

' ============================================
' Función   : SeleccionarOrgano
' Propósito : Ubica la grilla en un órgano y lo carga
' Parámetros: iIdOrgano As Integer — órgano
' Retorna   : nada
' ============================================
Private Sub SeleccionarOrgano(iIdOrgano As Integer)

  Dim iFila As Integer

  iFila = $aIdsOrganos.Find(iIdOrgano)
  If iFila < 0 Then Return
  gvOrganos.Row = iFila
  gvOrganos_Click()

End

' ============================================
' Función   : btnBorrarOrgano_Click
' Propósito : Borra el órgano elegido, con confirmación. m_Organos solo lo
'             borra si nunca tuvo miembros (decisión de Alberto, 12/11)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnBorrarOrgano_Click()

  ' --- 1. HAY ÓRGANO GRABADO ELEGIDO ---
  If $iOrganoActual <= 0 Then Return

  ' --- 2. CONFIRMACIÓN ---
  m_Sonido.sonar("Question")
  If Message.Question("¿Borrar el órgano «" & txtNombreOrgano.Text & "»?", "Borrar", "Cancelar") <> 1 Then Return

  ' --- 3. BORRADO Y RELECTURA ---
  If Not m_Organos.BorrarOrgano(hConn, $iOrganoActual) Then Return
  m_Sonido.sonar("Info")
  CargarOrganos()

End

' ============================================
' Función   : CargarMiembros
' Propósito : Llena la grilla de miembros del órgano elegido y deja vacío el
'             editor de la fila
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub CargarMiembros()

  Dim rDatos As Result
  Dim iFila As Integer

  ' --- 1. LIMPIEZA ---
  LimpiarMiembros()
  If $iOrganoActual <= 0 Then Return
  btnNuevoMiembro.Enabled = True

  ' --- 2. LECTURA ---
  rDatos = m_Organos.ListarMiembros(hConn, $iOrganoActual)
  If Not rDatos Then Return

  ' --- 3. GRILLA; «Hasta» VACÍO ES VIGENTE ---
  gvMiembros.Rows.Count = rDatos.Count
  iFila = 0
  While rDatos.Available
    $aIdsMiembros.Add(rDatos!id_miembro)
    gvMiembros[iFila, 0].Text = m_Revistas.TextoDe(rDatos, "persona")
    gvMiembros[iFila, 1].Text = m_Revistas.TextoDe(rDatos, "afiliacion")
    gvMiembros[iFila, 2].Text = CStr(rDatos!orden)
    gvMiembros[iFila, 3].Text = m_Editorial.TextoFecha(rDatos, "desde")
    gvMiembros[iFila, 4].Text = m_Editorial.TextoFecha(rDatos, "hasta")
    Inc iFila
    rDatos.MoveNext
  Wend

End

' ============================================
' Función   : LimpiarMiembros
' Propósito : Vacía la grilla y el editor de miembros; los botones quedan
'             como corresponde a «nada elegido»
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub LimpiarMiembros()

  ' --- 1. GRILLA ---
  gvMiembros.Rows.Count = 0
  $aIdsMiembros.Clear()

  ' --- 2. EDITOR ---
  LimpiarEditorMiembro()

  ' --- 3. BOTONES: SIN ÓRGANO GRABADO NO HAY ALTA ---
  btnNuevoMiembro.Enabled = $iOrganoActual > 0
  btnGuardarMiembro.Enabled = False
  btnBorrarMiembro.Enabled = False

End

' ============================================
' Función   : LimpiarEditorMiembro
' Propósito : Deja vacíos los campos del miembro
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub LimpiarEditorMiembro()

  $iMiembroActual = -1
  $iAutorMiembro = 0
  txtPersonaMiembro.Text = ""
  txtAfiliacionMiembro.Text = ""
  spnOrdenMiembro.Value = 0
  dtbDesdeMiembro.Value = Null
  dtbHastaMiembro.Value = Null

End

' ============================================
' Función   : gvMiembros_Click
' Propósito : Al elegir un miembro, lo carga en el editor de la fila
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub gvMiembros_Click()

  Dim iFila As Integer
  Dim rDatos As Result

  ' --- 1. FILA VÁLIDA ---
  iFila = gvMiembros.Row
  If iFila < 0 Or iFila >= $aIdsMiembros.Count Then Return

  ' --- 2. LECTURA ---
  rDatos = m_Organos.CargarMiembro(hConn, $aIdsMiembros[iFila])
  If Not rDatos Then Return

  ' --- 3. CAMPOS ---
  $iMiembroActual = $aIdsMiembros[iFila]
  $iAutorMiembro = rDatos!id_autor
  txtPersonaMiembro.Text = m_Revistas.TextoDe(rDatos, "persona")
  txtAfiliacionMiembro.Text = m_Revistas.TextoDe(rDatos, "afiliacion")
  spnOrdenMiembro.Value = rDatos!orden
  dtbDesdeMiembro.Value = rDatos!desde
  ' NULL: VIGENTE. EL DateBox ACEPTA Null (MISMO USO QUE FMetadatosArticulo)
  dtbHastaMiembro.Value = rDatos!hasta

  ' --- 4. BOTONES ---
  btnGuardarMiembro.Enabled = True
  btnBorrarMiembro.Enabled = True

End

' ============================================
' Función   : btnNuevoMiembro_Click
' Propósito : Elige una persona con FBuscarAutor y prepara el editor para
'             su alta, con la afiliación propuesta de la ficha. No graba:
'             el alta la hace «Guardar» (falta la fecha «desde»)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnNuevoMiembro_Click()

  Dim iIdAutor As Integer

  ' --- 1. HAY ÓRGANO GRABADO ELEGIDO ---
  If $iOrganoActual <= 0 Then Return

  ' --- 2. ELECCIÓN: EL id VUELVE POR Me.Close; 0 ES «NO SE ELIGIÓ» ---
  FBuscarAutor.hConn = hConn
  iIdAutor = FBuscarAutor.ShowModal()
  If iIdAutor <= 0 Then Return

  ' --- 3. EDITOR EN MODO ALTA (0) ---
  LimpiarEditorMiembro()
  $iMiembroActual = 0
  $iAutorMiembro = iIdAutor
  txtPersonaMiembro.Text = m_Organos.NombrePersona(hConn, iIdAutor)
  txtAfiliacionMiembro.Text = m_Organos.AfiliacionPropuesta(hConn, iIdAutor)
  btnGuardarMiembro.Enabled = True
  btnBorrarMiembro.Enabled = False
  dtbDesdeMiembro.SetFocus()

End

' ============================================
' Función   : btnGuardarMiembro_Click
' Propósito : Graba el miembro en edición (alta si es nuevo) y lo vuelve a
'             elegir
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnGuardarMiembro_Click()

  Dim cDatos As New Collection
  Dim iMiembro As Integer
  Dim iOrgano As Integer

  ' --- 1. HAY ÓRGANO Y UN MIEMBRO EN EDICIÓN (0 = ALTA) ---
  If $iOrganoActual <= 0 Then Return
  If $iMiembroActual < 0 Then Return

  ' --- 2. VALORES ---
  If $iAutorMiembro > 0 Then
    cDatos["id_autor"] = $iAutorMiembro
  Else
    cDatos["id_autor"] = Null
  Endif
  cDatos["afiliacion"] = m_Revistas.NuloSiVacio(txtAfiliacionMiembro.Text)
  cDatos["orden"] = spnOrdenMiembro.Value
  cDatos["desde"] = dtbDesdeMiembro.Value
  cDatos["hasta"] = dtbHastaMiembro.Value

  ' --- 3. GRABACIÓN ---
  iMiembro = m_Organos.GuardarMiembro(hConn, $iMiembroActual, $iOrganoActual, cDatos)
  If iMiembro = 0 Then Return

  ' --- 4. RELECTURA: LA CUENTA DE VIGENTES DEL ÓRGANO CAMBIA ---
  m_Sonido.sonar("Info")
  iOrgano = $iOrganoActual
  CargarOrganos()
  SeleccionarOrgano(iOrgano)
  SeleccionarMiembro(iMiembro)

End

' ============================================
' Función   : SeleccionarMiembro
' Propósito : Ubica la grilla en un miembro y lo carga
' Parámetros: iIdMiembro As Integer — membresía
' Retorna   : nada
' ============================================
Private Sub SeleccionarMiembro(iIdMiembro As Integer)

  Dim iFila As Integer

  iFila = $aIdsMiembros.Find(iIdMiembro)
  If iFila < 0 Then Return
  gvMiembros.Row = iFila
  gvMiembros_Click()

End

' ============================================
' Función   : btnBorrarMiembro_Click
' Propósito : Borra el miembro elegido, con confirmación. La pregunta
'             recuerda que quien deja el órgano se cierra con «hasta», para
'             que siga en los números en que figuró
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnBorrarMiembro_Click()

  Dim iOrgano As Integer

  ' --- 1. HAY MIEMBRO GRABADO ELEGIDO ---
  If $iMiembroActual <= 0 Then Return

  ' --- 2. CONFIRMACIÓN ---
  m_Sonido.sonar("Question")
  If Message.Question("¿Borrar a «" & txtPersonaMiembro.Text & "» de «" & txtNombreOrgano.Text & "»?" & Chr(10) & Chr(10) &
      "Si dejó el órgano, conviene cargar «hasta» en lugar de borrar: así sigue figurando en los números en que estuvo.", "Borrar", "Cancelar") <> 1 Then Return

  ' --- 3. BORRADO Y RELECTURA ---
  If Not m_Organos.BorrarMiembro(hConn, $iMiembroActual) Then Return
  m_Sonido.sonar("Info")
  iOrgano = $iOrganoActual
  CargarOrganos()
  SeleccionarOrgano(iOrgano)

End

' ============================================
' Función   : btnVaciarHastaMiembro_Click
' Propósito : Deja vacía la fecha «hasta»: el miembro queda vigente (se graba
'             NULL)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnVaciarHastaMiembro_Click()

  dtbHastaMiembro.Value = Null

End

' ============================================
' Función   : MostrarLogo
' Propósito : Muestra el logo de la revista en la vista previa, o la deja
'             vacía; habilita «Quitar» solo si hay logo
' Parámetros: sDatos As String — los bytes del PNG; vacío si no hay
' Retorna   : nada
' ============================================
Private Sub MostrarLogo(sDatos As String)

  Dim sTemporal As String

  ' --- 1. SIN LOGO ---
  btnQuitarLogoRevista.Enabled = sDatos <> ""
  If sDatos = "" Then
    picLogoRevista.Picture = Null
    Return
  Endif

  ' --- 2. CON LOGO: Picture.Load LEE DE UN ARCHIVO; SE PASA POR UNO TEMPORAL ---
  sTemporal = Temp() & ".png"
  Try File.Save(sTemporal, sDatos)
  If Not Error Then Try picLogoRevista.Picture = Picture.Load(sTemporal)
  ' UNA VISTA PREVIA QUE NO SE PUDO ARMAR NO IMPIDE NADA: EL LOGO ESTÁ EN LA BASE
  If Error Then picLogoRevista.Picture = Null
  Try Kill sTemporal

End

' ============================================
' Función   : btnCargarLogoRevista_Click
' Propósito : Elige un PNG, lo valida (m_Revistas.LeerLogoDeArchivo) y lo
'             graba en la revista en el acto
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnCargarLogoRevista_Click()

  Dim sDatos As String

  ' --- 1. HAY REVISTA ELEGIDA ---
  If $iRevistaActual <= 0 Then Return

  ' --- 2. DIÁLOGO ---
  Dialog.Title = "Logo de la cabecera del artículo (PNG, 184 × 20 mm)"
  Dialog.Filter = ["*.png", "Imágenes PNG"]
  ' Dialog.OpenFile DEVUELVE True CUANDO EL USUARIO CANCELA
  If Dialog.OpenFile() Then Return

  ' --- 3. VALIDACIÓN: PNG, Y AVISO SI LA PROPORCIÓN NO ES LA DE LA CABECERA ---
  sDatos = m_Revistas.LeerLogoDeArchivo(Dialog.Path)
  If sDatos = "" Then Return

  ' --- 4. GRABACIÓN Y VISTA PREVIA ---
  If Not m_Revistas.GuardarLogo(hConn, $iRevistaActual, sDatos) Then Return
  m_Sonido.sonar("Info")
  MostrarLogo(sDatos)

End

' ============================================
' Función   : btnQuitarLogoRevista_Click
' Propósito : Quita el logo de la revista, con confirmación. Lo que se
'             componga después lleva el que esté en media/ del proyecto
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnQuitarLogoRevista_Click()

  ' --- 1. HAY REVISTA ELEGIDA ---
  If $iRevistaActual <= 0 Then Return

  ' --- 2. CONFIRMACIÓN ---
  m_Sonido.sonar("Question")
  If Message.Question("¿Quitar el logo de la revista?" & gb.NewLine & gb.NewLine &
      "Los números que se compongan después van a usar el logo que tenga cada proyecto en media/logo-revista.png (el genérico, si nadie lo cambió).", "Quitar", "Cancelar") <> 1 Then Return

  ' --- 3. GRABACIÓN Y VISTA PREVIA ---
  If Not m_Revistas.GuardarLogo(hConn, $iRevistaActual, "") Then Return
  m_Sonido.sonar("Info")
  MostrarLogo("")

End
