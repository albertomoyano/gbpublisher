# Gambas Form File 3.0

{ Form Form
  Move(0,0,450,108)
  #Scaled = False
  Text = ("Enmarcar texto")
  Icon = Picture["iconos/gbadoc.png"]
  Resizable = False
  Arrangement = Arrange.Vertical
  AutoResize = True
  Centered = True
  Spacing = True
  Margin = True
  Padding = 4
  { hbxPar HBox
    Move(0,0,432,36)
    #Translate = False
    { lblPar Label
      Move(0,0,189,36)
      #Translate = False
      Text = "  Par de signos  "
    }
    { cmbPar ComboBox
      Move(198,0,216,36)
      #Translate = False
