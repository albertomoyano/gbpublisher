' Gambas module file

' ==========================================================
' MÓDULO    : m_GenerarSalidasLibro
' PROPÓSITO : Punto de entrada de las salidas del libro, del ensamblado de su
'             canónico y de su validación (SC-75). La lógica pesada vive en
'             scripts de engine/ (SC-13); acá queda lo que sale de la base y
'             el lanzamiento.
'
' CÓMO SE LANZA UN SCRIPT
' ----------------------------------------------------------
'   Por m_Lanzadora.EjecutarScript, el único camino (SC-53). Ahí está por qué
'   se lanza así.
' ==========================================================

' PLAZOS EN SEGUNDOS. NO SON UN CORTE: AL VENCER SE PREGUNTA SI SEGUIR
Private Const PLAZO_CANONICO As Float = 300.0
' EL LOTE DE CANÓNICOS DE CAPÍTULO: UNA JVM Y UN PANDOC POR CAPÍTULO
Private Const PLAZO_CANONICOS_CAPITULO As Float = 600.0
Private Const PLAZO_HTML As Float = 600.0
' EL PDF HACE CINCO O MÁS PASADAS DE LuaLaTeX, MÁS biber Y xindy
Private Const PLAZO_PDF As Float = 1200.0
' LA VALIDACIÓN DE UN CANÓNICO: jing Y UNA JVM DE SAXON PARA EL SCHEMATRON
Private Const PLAZO_VALIDAR As Float = 300.0
' LA REVISIÓN DE VIGENCIA AL ABRIR: SOLO sha256sum Y xmllint, SIN JVM
Private Const PLAZO_VIGENCIA As Float = 120.0

' --- PDF/A DE LIBROS ---
' latex/pdfa/: LOS AUXILIARES DEL PDF/A NO PISAN LOS DEL PDF ESTÁNDAR (LOS
' .idx TIENEN NOMBRE FIJO). EL SUFIJO DISTINGUE EL ARCHIVO EN salidas/pdf/
Private Const CARPETA_PDFA As String = "pdfa"
Private Const SUFIJO_PDFA2U As String = "_pdfa2u"
Private Const NIVEL_PDFA2U As String = "2u"

' LISTA DE CAPÍTULOS QUE GAMBAS ESCRIBE PARA generar_canonicos_capitulos.sh,
' RELATIVA AL PROYECTO. UNA SOLA: NO PUEDE HABER DOS LOTES A LA VEZ
Private Const LISTA_CANONICOS As String = "tmp/lote-canonicos.tsv"

' LISTA DE CANÓNICOS QUE GAMBAS LE PASA A validar_canonicos.sh, RELATIVA AL
' PROYECTO. LA MISMA QUE USAN LOS SCRIPTS QUE LO LLAMAN ANIDADO: NUNCA CORREN
' DOS A LA VEZ (SC-53)
Private Const LISTA_VALIDAR As String = "tmp/lote-validar.txt"

' ============================================
' Función   : RutaSalidaLibro
' Propósito : La ruta de una salida del libro, con el mismo nombre que le da
'             su generación: el PDF, salidas/pdf/<proyecto>.pdf
'             (GenerarPDFLibro, 6); el HTML, docs/index.html
'             (GenerarLibroHTML, 9); el EPUB, salidas/epub/ con el nombre
'             que sale del título (m_GenerarEpubLibro.NombreEpubLibro).
' Parámetros: sSalida As String — pdf | html | epub
'             iIdLibro As Integer — id del libro (solo lo usa el EPUB)
' Retorna   : String — ruta absoluta; vacía si no se pudo resolver, con el
'             motivo ya informado
' ============================================
Public Function RutaSalidaLibro(sSalida As String, iIdLibro As Integer) As String

  ' --- 1. INICIALIZACIÓN ---
  Dim sNombreEpub As String

  ' --- 2. RUTA SEGÚN LA SALIDA ---
  Select Case sSalida
    Case "pdf"
      Return m_InicioCierre.RutaProyectoEnCurso &/ "salidas" &/ "pdf" &/
        File.BaseName(m_InicioCierre.NombreProyectoEnCurso) & ".pdf"
    Case "html"
      Return m_InicioCierre.RutaProyectoEnCurso &/ "docs" &/ "index.html"
    Case "epub"
      ' EL NOMBRE SALE DE LA BASE: SI LA CONSULTA FALLA, YA SE INFORMÓ
      sNombreEpub = m_GenerarEpubLibro.NombreEpubLibro(iIdLibro)
      If sNombreEpub = "" Then Return ""
      Return m_InicioCierre.RutaProyectoEnCurso &/ "salidas" &/ "epub" &/ sNombreEpub
  End Select

  ' UNA SALIDA DESCONOCIDA ES UN ERROR DEL LLAMADOR (GV-23)
  m_Sonido.sonar("Error")
  Message.Error("Salida desconocida para el visor: «" & sSalida & "».")
  Return ""

End

' ============================================
' Función   : AbrirSalidaEnVisor
' Propósito : Abre una salida del libro con la aplicación predeterminada del
'             sistema (xdg-open vía gb.desktop): el PDF en su visor, el HTML
'             en el navegador, el EPUB en el lector. Si el archivo no existe,
'             lo dice con un mensaje. La llaman btnPDFenVisorExterno_Click,
'             btnHTMLenVisorExterno_Click y btnEPUBenVisorExterno_Click.
' Parámetros: sSalida As String — pdf | html | epub
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub AbrirSalidaEnVisor(sSalida As String)

  ' --- 1. INICIALIZACIÓN ---
  Dim iIdLibro As Integer
  Dim sRuta As String

  ' --- 2. PROYECTO ABIERTO Y CON LIBRO ---
  If m_InicioCierre.IdProyectoEnCurso = 0 Then
    m_Sonido.sonar("Info")
    Message.Info("Abrí un proyecto antes de ver sus salidas.")
    Return
  Endif

  ' LAS SALIDAS DE REVISTAS SON POR ARTÍCULO Y POR NÚMERO, CON OTROS NOMBRES:
  ' ESTOS BOTONES ABREN LAS DEL LIBRO
  iIdLibro = m_XML.ObtenerIdLibro(m_InicioCierre.IdProyectoEnCurso)
  If iIdLibro = 0 Then
    m_Sonido.sonar("Warning")
    Message.Warning("No hay libro asociado a este proyecto.")
    Return
  Endif

  ' --- 3. NINGUNA GENERACIÓN EN CURSO ---
  ' MIENTRAS UN SCRIPT CORRE, EL ARCHIVO PUEDE ESTAR A MEDIO ESCRIBIR
  If m_Lanzadora.HayScriptEnCurso() Then
    m_Sonido.sonar("Warning")
    Message.Warning("Hay una generación en curso. Esperá a que termine para abrir la salida.")
    Return
  Endif

  ' --- 4. RUTA ---
  sRuta = RutaSalidaLibro(sSalida, iIdLibro)
  If sRuta = "" Then Return

  ' --- 5. EL ARCHIVO TIENE QUE EXISTIR ---
  ' ES LA ÚNICA FORMA DE INFORMAR ESTE FALLO: Desktop.Open SIN ESPERA NO LO
  ' REPORTA (GV-23)
  If Not Exist(sRuta) Then
    m_Sonido.sonar("Warning")
    Message.Warning("Todavía no hay " & UCase(sSalida) & " del libro: generalo primero." & gb.NewLine & gb.NewLine &
      "Se buscó:" & gb.NewLine & sRuta)
    Return
  Endif

  ' --- 6. ABRIR CON LA APLICACIÓN DEL SISTEMA (RC-GM-02) ---
  ' SIN Wait: Wait = True USA Process.Wait Y CONGELA LA INTERFAZ (GV-17).
  ' ESTE Try SOLO ATRAPA FALLOS DE LANZAMIENTO, NO LA FALTA DE UNA APLICACIÓN
  ' ASOCIADA
  Try Desktop.Open(sRuta)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo abrir el archivo con la aplicación del sistema:" & gb.NewLine &
      sRuta & gb.NewLine & gb.NewLine & Error.Text)
    Return
  Endif

End

' ============================================
' Función   : RutaConfigEstilo
' Propósito : La configuración instalada de un estilo de cita de libro:
'             ~/.gbpublisher/latex/cita-<estilo>-config.tex. Es la que copia
'             CopiarRecursosLatex a cada proyecto.
' Parámetros: sEstilo As String — identificador (apa, verona-modern…)
' Retorna   : String — la ruta, exista o no
' ============================================
Public Function RutaConfigEstilo(sEstilo As String) As String

  Return User.Home &/ ".gbpublisher" &/ "latex" &/ "cita-" & sEstilo & "-config.tex"

End

' ============================================
' Función   : EstiloLibroExiste
' Propósito : Dice si un identificador es un estilo de cita de libro: que
'             tenga la forma de un nombre de archivo seguro y que su
'             configuración esté instalada.
' Parámetros: sEstilo As String — identificador
' Retorna   : Boolean
' Nota      : LA FORMA SE CONTROLA ANTES DE ARMAR LA RUTA: UN VALOR CON «/» O
'             CON «..» SALDRÍA DE LA CARPETA. SOLO MINÚSCULAS ASCII, DÍGITOS Y
'             GUION, QUE ES LO QUE USAN LOS ARCHIVOS cita-*-config.tex.
' ============================================
Public Function EstiloLibroExiste(sEstilo As String) As Boolean

  ' --- 1. FORMA ---
  If sEstilo = "" Then Return False
  If Not (sEstilo Like "[a-z0-9]*") Then Return False
  If Not (sEstilo Like "*[a-z0-9]") Then Return False
  ' EN Like LA NEGACIÓN ES [^…]; [!…] NO NIEGA (MEDIDO CON gbs3 3.19)
  If sEstilo Like "*[^a-z0-9-]*" Then Return False

  ' --- 2. CONFIGURACIÓN INSTALADA ---
  Return Exist(RutaConfigEstilo(sEstilo))

End

' ============================================
' Función   : EstilosLibro
' Propósito : Los estilos de cita de libro instalados: uno por cada
'             cita-<estilo>-config.tex de ~/.gbpublisher/latex/, en orden
'             alfabético. Es la lista del combo de FMetadatosLibro.
' Parámetros: (ninguno)
' Retorna   : String[] — los identificadores; vacío si no hay ninguno o no se
'             puede leer la carpeta
' ============================================
Public Function EstilosLibro() As String[]

  Dim aEstilos As New String[]
  Dim aArchivos As String[]
  Dim sArchivo As String
  Dim sEstilo As String
  Dim sCarpeta As String

  ' --- 1. LECTURA DE LA CARPETA ---
  sCarpeta = User.Home &/ ".gbpublisher" &/ "latex"
  If Not Exist(sCarpeta) Then Return aEstilos

  Try aArchivos = Dir(sCarpeta, "cita-*-config.tex", gb.File)
  If Error Then Return aEstilos

  ' --- 2. IDENTIFICADORES ---
  ' cita-<estilo>-config.tex: LO QUE QUEDA ENTRE «cita-» (5) Y «-config.tex» (11)
  For Each sArchivo In aArchivos
    sEstilo = Mid(sArchivo, 6, Len(sArchivo) - 16)
    If EstiloLibroExiste(sEstilo) Then aEstilos.Add(sEstilo)
  Next

  aEstilos.Sort()
  Return aEstilos

End

' ============================================
' Función   : LeyendaEstilo
' Propósito : La etiqueta legible de un estilo: la primera línea de su
'             configuración, si es «% ESTILO: <etiqueta>».
' Parámetros: sEstilo As String — identificador
' Retorna   : String — la etiqueta, o "" si el archivo no la declara o no se
'             puede leer (el combo muestra entonces el identificador)
' ============================================
Public Function LeyendaEstilo(sEstilo As String) As String

  Dim hArchivo As File
  Dim sLinea As String

  ' --- 1. PRIMERA LÍNEA ---
  hArchivo = Open RutaConfigEstilo(sEstilo) For Input
  If Not Eof(hArchivo) Then Line Input #hArchivo, sLinea
  Close #hArchivo

  ' --- 2. LA MARCA ---
  ' EL PREFIJO ES ASCII: Mid POR BYTES NO CORTA UN CARÁCTER DE LA ETIQUETA
  sLinea = m_XML.TrimUTF8(sLinea)
  If sLinea Begins "% ESTILO:" Then Return m_XML.TrimUTF8(Mid(sLinea, 10))

  Return ""

Catch
  ' SI FALLA LA LECTURA SE MUESTRA EL IDENTIFICADOR
  Return ""

End

' ============================================
' Función   : ResolverEstiloCita
' Propósito : El identificador de estilo de cita del libro —apa, iso690,
'             ieee, vancouver, verona-modern—, tal como lo guarda
'             libros_md.estilo_cita. Una sola versión para el HTML y el EPUB.
' Parámetros: iIdLibro As Integer — libro
' Retorna   : String — el identificador; apa si no hay estilo, no se puede
'             leer o no está instalado, que coincide con el default de las hojas
' ============================================
Public Function ResolverEstiloCita(iIdLibro As Integer) As String

  ' --- 1. INICIALIZACIÓN ---
  Dim hEstilo As Result
  Dim sEstilo As String

  ' --- 2. CONSULTA ---
  Try hEstilo = m_ConexionBD.mConn.Exec(
    "SELECT estilo_cita FROM libros_md WHERE id_libro = &1 LIMIT 1", iIdLibro)
  If Error Then Return "apa"
  If Not hEstilo.Available Then Return "apa"
  If IsNull(hEstilo["estilo_cita"]) Then Return "apa"

  ' --- 3. VALIDACIÓN: EL ESTILO TIENE QUE ESTAR INSTALADO ---
  sEstilo = m_XML.TrimUTF8(hEstilo["estilo_cita"])
  If Not EstiloLibroExiste(sEstilo) Then Return "apa"

  Return sEstilo

End

' ============================================
' Función   : PrepararCitasPantalla
' Propósito : Decide, en un solo lugar, cómo arman HTML y EPUB las citas y las
'             referencias (SC-57). Si el estilo tiene archivo de pantalla
'             (~/.gbpublisher/latex/cita-<estilo>-html.tex), las escribe
'             biblatex con tex4ht y esta función deja los insumos de esa pasada;
'             si no, las arman las plantillas de las hojas.
' Parámetros: sEstilo As String — el identificador que dio ResolverEstiloCita
' Retorna   : String — "tex4ht" | "xslt"; "" si no se pudieron escribir los
'             insumos (EscribirInsumosCitas ya informó el motivo)
' Nota      : EL SCRIPT RECIBE EL MODO Y NO LO VUELVE A DECIDIR. LA HOJA CORTA
'             SI UN ESTILO NO TIENE NI ARCHIVO DE PANTALLA NI PLANTILLAS.
' ============================================
Public Function PrepararCitasPantalla(sEstilo As String) As String

  Dim sPantalla As String

  ' --- 1. ARCHIVO DE PANTALLA DEL ESTILO ---
  ' LA MISMA CARPETA DE LA QUE SALEN LOS ESTILOS DEL SELECTOR (EstilosLibro)
  sPantalla = User.Home &/ ".gbpublisher" &/ "latex" &/ "cita-" & sEstilo & "-html.tex"
  If Not Exist(sPantalla) Then Return "xslt"

  ' --- 2. INSUMOS DE LA PASADA ---
  ' LA LISTA DE PIEZAS, LAS DEFINICIONES Y EL .bib: LOS MISMOS DEL PDF
  If Not m_GenerarPDFLibro.EscribirInsumosCitas() Then Return ""

  Return "tex4ht"

End

' ============================================
' Función   : PrepararInsumosLibro
' Propósito : Escribe a disco todo lo que el ensamblado del libro necesita de la
'             base —info del libro, manifiesto y, si corresponde, bibliografía
'             consolidada— y devuelve los datos para invocar el script. Los
'             scripts no tocan la base: todo lo que sale de ella llega como
'             archivo.
' Parámetros: (ninguno)
' Retorna   : CInsumosLibro — nunca Null; con bListo en False si algo falló, y
'             en ese caso el motivo ya se informó
' ============================================
Public Function PrepararInsumosLibro() As CInsumosLibro

  ' --- 1. INICIALIZACIÓN ---
  Dim oInsumos As New CInsumosLibro
  Dim hLugar As Result
  Dim sNombreArchivoMadre As String
  Dim sProblema As String

  oInsumos.bListo = False
  oInsumos.sLugarBibliografia = "por_capitulo"
  oInsumos.sBiblioRel = ""

  ' --- 2. PROYECTO Y LIBRO ---
  oInsumos.sRutaProyecto = m_InicioCierre.RutaProyectoEnCurso
  If oInsumos.sRutaProyecto = "" Then
    m_Sonido.sonar("Warning")
    Message.Warning("No hay ningún proyecto abierto.")
    Return oInsumos
  Endif

  ' EL ID DEL PROYECTO SALE DE LA GLOBAL DE SESIÓN Y NO DEL ValueBox DE FMain,
  ' QUE PUEDE RESETEARSE POR EVENTOS DE INTERFAZ (RC-GM-16)
  oInsumos.iIdLibro = m_XML.ObtenerIdLibro(m_InicioCierre.IdProyectoEnCurso)
  If oInsumos.iIdLibro = 0 Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo resolver el libro del proyecto activo." & gb.NewLine &
      "Verificá que exista una fila en libros_md para este proyecto.")
    Return oInsumos
  Endif

  ' CÓDIGOS REPETIDOS: EL CANÓNICO DERIVA EL ORDEN DEL NOMBRE, Y DOS PIEZAS
  ' CON EL MISMO CÓDIGO QUEDAN ORDENADAS POR CASUALIDAD (SC-55)
  sProblema = m_PiezasLibro.ProblemaCodigoRepetido(oInsumos.iIdLibro)
  If sProblema <> "" Then
    m_Sonido.sonar("Error")
    Message.Error(sProblema)
    Return oInsumos
  Endif

  ' --- 3. NOMBRE BASE ---
  ' EL PREFIJO «l-» ES LA CONVENCIÓN DE ARCHIVOS DE LIBRO. String.* POR
  ' COHERENCIA CON SC-02, AUNQUE EL PREFIJO SEA ASCII
  sNombreArchivoMadre = File.BaseName(m_InicioCierre.NombreProyectoEnCurso)
  If String.Left(sNombreArchivoMadre, 2) = "l-" Then
    oInsumos.sNombreBase = String.Mid(sNombreArchivoMadre, 3)
  Else
    oInsumos.sNombreBase = sNombreArchivoMadre
  Endif

  ' --- 4. INFO DEL LIBRO Y MANIFIESTO ---
  ' SI ESTAS FUNCIONES YA MUESTRAN SU PROPIO MENSAJE, ESTE ES REDUNDANTE; SI NO
  ' LO MUESTRAN, ES EL ÚNICO. PREFERIBLE DOS MENSAJES A NINGUNO (GV-23)
  If Not m_XML.GenerarInfoLibroXML(oInsumos.iIdLibro) Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo escribir la información del libro (tmp/info-libro).")
    Return oInsumos
  Endif

  If Not m_XML.GenerarManifiestoLibro(oInsumos.iIdLibro) Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo escribir el manifiesto del libro (tmp/manifiesto-libro).")
    Return oInsumos
  Endif

  ' --- 5. MODELO DE BIBLIOGRAFÍA ---
  ' SI NO SE PUEDE LEER, por_capitulo: ES EL DEFAULT DE LA COLUMNA
  Try hLugar = m_ConexionBD.mConn.Exec(
    "SELECT lugar_bibliografia FROM libros_md WHERE id_libro = &1 LIMIT 1", oInsumos.iIdLibro)
  If Not Error Then
    If hLugar.Available Then
      If Not IsNull(hLugar["lugar_bibliografia"]) Then
        oInsumos.sLugarBibliografia = m_XML.TrimUTF8(hLugar["lugar_bibliografia"])
      Endif
    Endif
  Endif

  ' --- 6. BIBLIOGRAFÍA CONSOLIDADA ---
  If oInsumos.sLugarBibliografia = "consolidada" Then
    ' GenerarBiblioLibroXML MUESTRA SU PROPIO MENSAJE AL FALLAR
    If Not m_XML.GenerarBiblioLibroXML(oInsumos.iIdLibro) Then Return oInsumos
    ' LA ESCRIBE CON File.BaseName DEL PROYECTO, NO CON EL NOMBRE BASE
    oInsumos.sBiblioRel = "tmp/biblio-libro-" &
      File.BaseName(m_InicioCierre.NombreProyectoEnCurso) & ".xml"
  Endif

  oInsumos.bListo = True
  Return oInsumos

End

' ============================================
' Función   : ArgumentosEnsamblado
' Propósito : Los cuatro argumentos que comparten ensamblar_libro.sh y los
'             scripts que lo invocan, en el orden que esperan.
' Parámetros: oInsumos As CInsumosLibro — insumos ya preparados
' Retorna   : String[] — ruta, nombre base, modelo de bibliografía y ruta de
'             la bibliografía consolidada o «-»
' ============================================
Private Function ArgumentosEnsamblado(oInsumos As CInsumosLibro) As String[]

  Dim aArgumentos As New String[]

  aArgumentos.Add(oInsumos.sRutaProyecto)
  aArgumentos.Add(oInsumos.sNombreBase)
  aArgumentos.Add(oInsumos.sLugarBibliografia)

  ' «-» Y NO CADENA VACÍA: UN ARGUMENTO VACÍO ES FRÁGIL DE PASAR, Y SI SE
  ' PERDIERA LOS SIGUIENTES SE CORRERÍAN DE POSICIÓN
  If oInsumos.sBiblioRel = "" Then
    aArgumentos.Add("-")
  Else
    aArgumentos.Add(oInsumos.sBiblioRel)
  Endif

  Return aArgumentos

End

' ============================================
' Función   : EscribirColofonDigital
' Propósito : Escribe tmp/colofon-digital.xml, de donde docbook-to-html.xsl
'             toma el pie de página. El texto sale de m_PiezasLibro, el mismo
'             que usa la página de colofón del EPUB.
'             El <p> va en el namespace de XHTML porque la hoja lo copia tal
'             cual dentro de su salida, que está en ese namespace. La raíz no:
'             es solo el contenedor.
' Parámetros: sRutaProyecto As String — raíz del proyecto
' Retorna   : Boolean — False si no se pudo escribir, con el motivo informado
' ============================================
Private Function EscribirColofonDigital(sRutaProyecto As String) As Boolean

  Dim sRuta As String
  Dim s As String

  sRuta = sRutaProyecto &/ "tmp" &/ "colofon-digital.xml"

  s = "<?xml version=" & Chr(34) & "1.0" & Chr(34) & " encoding=" & Chr(34) & "UTF-8" & Chr(34) & "?>" & Chr(10)
  s &= "<colofon>" & Chr(10)
  s &= "<p xmlns=" & Chr(34) & "http://www.w3.org/1999/xhtml" & Chr(34) & ">" &
    m_PiezasLibro.ColofonDigital() & "</p>" & Chr(10)
  s &= "</colofon>" & Chr(10)

  Try File.Save(sRuta, s)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo escribir el colofón del HTML:" & gb.NewLine & sRuta &
      gb.NewLine & gb.NewLine & Error.Text)
    Return False
  Endif

  Return True

End

' ============================================
' Función   : GenerarCanonicoLibro
' Propósito : Ensambla el canónico DocBook del libro completo. La verificación
'             de los capítulos, el ensamblado, la escritura atómica y la
'             validación las hace engine/ensamblar_libro.sh.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub GenerarCanonicoLibro()

  ' --- 1. INICIALIZACIÓN ---
  Dim oInsumos As CInsumosLibro
  Dim iRespuesta As Integer
  Dim iResultado As Integer

  ' --- 2. ALERTA PREVIA ---
  ' EL SCRIPT VERIFICA QUE CADA CANÓNICO DE CAPÍTULO EXISTA Y ESTÉ BIEN FORMADO,
  ' PERO NO PUEDE SABER SI ESTÁ AL DÍA CON SU .md
  iRespuesta = Message.Question(
    "ENSAMBLAR EL CANÓNICO DEL LIBRO" & gb.NewLine & gb.NewLine &
    "Se arma el canónico del libro entero a partir de los canónicos" & gb.NewLine &
    "de cada capítulo (jats/c-*.xml)." & gb.NewLine & gb.NewLine &
    "Los canónicos de los capítulos tienen que estar regenerados:" & gb.NewLine &
    "si un capítulo cambió y no se regeneró, el libro sale con la" & gb.NewLine &
    "versión anterior de ese capítulo.",
    "Ensamblar", "Cancelar")
  If iRespuesta <> 1 Then Return

  ' --- 3. INSUMOS DESDE LA BASE ---
  oInsumos = PrepararInsumosLibro()
  If Not oInsumos.bListo Then Return

  ' --- 4. ENSAMBLADO ---
  iResultado = m_Lanzadora.EjecutarScript("ensamblar_libro.sh", ArgumentosEnsamblado(oInsumos), PLAZO_CANONICO,
    "Ensamblando el canónico del libro")

  ' --- 5. INFORME ---
  m_Lanzadora.InformarResultado(iResultado, "El canónico del libro",
    oInsumos.sRutaProyecto &/ "jats" &/ "c-libro-" & oInsumos.sNombreBase & ".xml")

End

' ============================================
' Función   : GenerarCanonicoEnCurso
' Propósito : Genera el canónico DocBook del capítulo abierto en el editor
'             («Canónico archivo en curso» de menuDocBook). Es un lote de un
'             solo capítulo: el mismo camino que «Todos los canónicos».
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub GenerarCanonicoEnCurso()

  ' --- 1. INICIALIZACIÓN ---
  Dim iIdCapitulo As Integer
  Dim hCapitulo As Result
  Dim sNombre As String
  Dim iResultado As Integer

  ' --- 2. CAPÍTULO EN CURSO ---
  ' DE LA GLOBAL DE SESIÓN Y NO DE UN CONTROL (RC-GM-16)
  iIdCapitulo = m_InicioCierre.IdCapituloEnCurso
  If iIdCapitulo = 0 Then
    m_Sonido.sonar("Warning")
    Message.Warning("No hay ningún capítulo seleccionado." & gb.NewLine &
      "Seleccioná un archivo de front-matter/, articulos/ o back-matter/.")
    Return
  Endif

  ' --- 3. DATOS DEL CAPÍTULO ---
  ' LAS MISMAS COLUMNAS QUE LA CONSULTA DE GenerarCanonicosTodos: LanzarCanonicos
  ' LEE LAS DOS
  Try hCapitulo = m_ConexionBD.mConn.Exec(
    "SELECT id_capitulo, nombre_archivo, tipo_capitulo, idioma_capitulo " &
    "FROM capitulos WHERE id_capitulo = &1 AND nombre_archivo IS NOT NULL LIMIT 1",
    iIdCapitulo)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo leer el capítulo:" & gb.NewLine & Error.Text)
    Return
  Endif
  If Not hCapitulo.Available Then
    m_Sonido.sonar("Error")
    Message.Error("No se encontró el capítulo id=" & CStr(iIdCapitulo) &
      " o no tiene nombre de archivo registrado.")
    Return
  Endif

  sNombre = m_XML.TrimUTF8(hCapitulo["nombre_archivo"])

  ' --- 4. PIEZA SIN CUERPO ---
  ' EL CRITERIO DEL MANIFIESTO (m_XML.GenerarManifiestoLibro): UNA PIEZA QUE NO
  ' ENTRA AL LIBRO COMO CANÓNICO NO TIENE CANÓNICO PROPIO. ANTES SE EXCEPTUABA
  ' SOLO bm-99-colofon, POR NOMBRE
  If Not m_PiezasLibro.TieneCuerpo(TipoDeCapitulo(hCapitulo)) Then
    m_Sonido.sonar("Info")
    Message.Info("«" & sNombre & "» no tiene canónico propio." & gb.NewLine & gb.NewLine &
      "Es una pieza sin cuerpo: cada salida del libro la arma" & gb.NewLine &
      "a su modo a partir de la base.")
    Return
  Endif

  ' --- 5. LANZAMIENTO E INFORME ---
  iResultado = LanzarCanonicos(hCapitulo)
  InformarCanonicos(iResultado, sNombre)

End

' ============================================
' Función   : GenerarCanonicosTodos
' Propósito : Genera los canónicos DocBook de todos los capítulos del libro
'             que tienen cuerpo («Todos los canónicos» de menuDocBook). El caso
'             es el de las correcciones repartidas en varios archivos: se
'             aplican con buscar/reemplazar y se regenera todo de una vez.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub GenerarCanonicosTodos()

  ' --- 1. INICIALIZACIÓN ---
  Dim iIdLibro As Integer
  Dim hCapitulos As Result
  Dim iResultado As Integer

  ' --- 2. PROYECTO Y LIBRO ---
  If m_InicioCierre.RutaProyectoEnCurso = "" Then
    m_Sonido.sonar("Warning")
    Message.Warning("No hay ningún proyecto abierto.")
    Return
  Endif

  ' EL ID DEL PROYECTO SALE DE LA GLOBAL DE SESIÓN (RC-GM-16)
  iIdLibro = m_XML.ObtenerIdLibro(m_InicioCierre.IdProyectoEnCurso)
  If iIdLibro = 0 Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo resolver el libro del proyecto activo." & gb.NewLine &
      "Verificá que exista una fila en libros_md para este proyecto.")
    Return
  Endif

  ' --- 3. CAPÍTULOS ---
  ' LA MISMA CONDICIÓN Y EL MISMO ORDEN QUE m_XML.GenerarManifiestoLibro: «TODOS»
  ' TIENE QUE SER LO QUE EL ENSAMBLADO VA A PEDIR, NI MÁS NI MENOS. LAS PIEZAS
  ' SIN CUERPO LAS SALTEA LanzarCanonicos CON EL MISMO CRITERIO QUE EL MANIFIESTO
  Try hCapitulos = m_ConexionBD.mConn.Exec(
    "SELECT id_capitulo, nombre_archivo, tipo_capitulo, idioma_capitulo " &
    "FROM capitulos WHERE id_libro = &1 " &
    "AND nombre_archivo IS NOT NULL " &
    "ORDER BY " & m_OrdenPiezas.ClausulaOrden("nombre_archivo"), iIdLibro)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudieron leer los capítulos del libro:" & gb.NewLine & Error.Text)
    Return
  Endif
  If Not hCapitulos.Available Then
    m_Sonido.sonar("Warning")
    Message.Warning("El libro no tiene capítulos con archivo registrado.")
    Return
  Endif

  ' --- 4. LANZAMIENTO E INFORME ---
  iResultado = LanzarCanonicos(hCapitulos)
  InformarCanonicos(iResultado, "")

End

' ============================================
' Función   : LanzarCanonicos
' Propósito : Escribe los insumos que salen de la base para cada capítulo del
'             resultado y lanza engine/generar_canonicos_capitulos.sh, que hace
'             pandoc, Saxon y la validación (SC-13). Es el camino común de
'             «en curso» y «todos».
' Parámetros: hCapitulos As Result — capítulos a generar, sin recorrer, con las
'               columnas id_capitulo, nombre_archivo, tipo_capitulo e
'               idioma_capitulo
' Retorna   : Integer — lo que devuelve m_Lanzadora.EjecutarScript, o
'             m_Lanzadora.RESULTADO_EN_CURSO / m_Lanzadora.RESULTADO_NO_LANZADO si no se lanzó; en el
'             segundo caso el motivo ya se informó o el usuario canceló
' ============================================
Private Function LanzarCanonicos(hCapitulos As Result) As Integer

  ' --- 1. INICIALIZACIÓN ---
  Dim iIdCapitulo As Integer
  Dim sNombre As String
  Dim sTipo As String
  Dim sIdioma As String
  Dim sCampos As String
  Dim sLista As String
  Dim iCantidad As Integer
  Dim aArgumentos As New String[]
  Dim hListas As Result
  Dim iIdLibro As Integer

  ' --- 2. REENTRADA ---
  ' ANTES DE ESCRIBIR NADA: UN SCRIPT EN CURSO PUEDE ESTAR LEYENDO LOS MISMOS
  ' ARCHIVOS DE tmp/ QUE ESTA FUNCIÓN REESCRIBE. m_Lanzadora.EjecutarScript LO
  ' VERIFICA TAMBIÉN, PERO DESPUÉS DE LA ESCRITURA SERÍA TARDE
  If m_Lanzadora.HayScriptEnCurso() Then Return m_Lanzadora.RESULTADO_EN_CURSO

  ' --- 3. EL EDITOR IGUAL AL DISCO (SC-06) ---
  ' EL SCRIPT LEE LOS .md DEL DISCO. LO QUE ESTÁ SIN GUARDAR EN EL EDITOR SE
  ' GUARDA O SE DESCARTA ACÁ, Y DESPUÉS SE ALINEA: «DESCARTAR» DEJA EL TEXTO
  ' DESCARTADO EN EL EDITOR (m_BuscarRegex.AlinearEditorConDisco)
  If Not FMain.ConfirmarDescartarCambios() Then Return m_Lanzadora.RESULTADO_NO_LANZADO
  If Not m_BuscarRegex.AlinearEditorConDisco() Then Return m_Lanzadora.RESULTADO_NO_LANZADO

  ' --- 4. REFERENCIAS DEL PROYECTO, UNA VEZ POR LANZAMIENTO ---
  ' EL .bib LO LEE GenerarBiblioCapituloXML; EL ref-*.xml, LAS SALIDAS. ANTES SE
  ' EXPORTABAN UNA VEZ POR CAPÍTULO Y SIN MIRAR EL RESULTADO. LAS DOS
  ' FUNCIONES INFORMAN SUS FALLOS
  If Not m_Bibtex.ExportarBibTeX() Then Return m_Lanzadora.RESULTADO_NO_LANZADO
  If Not m_XML.ExportarDocBookdesdeBIB() Then Return m_Lanzadora.RESULTADO_NO_LANZADO

  ' --- 5. INSUMOS DE CADA CAPÍTULO Y LISTA ---
  ' UN INSUMO QUE NO SE PUEDE ESCRIBIR FRENA TODO ANTES DE LANZAR: ES UN
  ' PROBLEMA DE LA BASE, NO DEL .md, Y NO SE ARREGLA CAPÍTULO POR CAPÍTULO
  While hCapitulos.Available

    sTipo = TipoDeCapitulo(hCapitulos)

    ' LAS PIEZAS SIN CUERPO NO TIENEN CANÓNICO PROPIO: EL CRITERIO DEL MANIFIESTO.
    ' MoveNext ANTES DE Continue: SIN ÉL EL BUCLE NO AVANZA
    If Not m_PiezasLibro.TieneCuerpo(sTipo) Then
      hCapitulos.MoveNext
      Continue
    Endif

    iIdCapitulo = hCapitulos["id_capitulo"]
    sNombre = m_XML.TrimUTF8(hCapitulos["nombre_archivo"])
    sIdioma = IdiomaDeCapitulo(hCapitulos)

    ' UN TAB O UN SALTO DE LÍNEA EN UN CAMPO CORRERÍA LAS COLUMNAS DE LA LISTA
    sCampos = sNombre & sTipo & sIdioma
    If InStr(sCampos, Chr(9)) > 0 Or InStr(sCampos, Chr(10)) > 0 Or InStr(sCampos, Chr(13)) > 0 Then
      m_Sonido.sonar("Error")
      Message.Error("El capítulo id=" & CStr(iIdCapitulo) & " tiene un tabulador o un salto" & gb.NewLine &
        "de línea en el nombre de archivo, el tipo o el idioma." & gb.NewLine &
        "Corregilo en la base antes de generar.")
      Return m_Lanzadora.RESULTADO_NO_LANZADO
    Endif

    ' LAS DOS FUNCIONES INFORMAN SUS FALLOS
    If Not m_XML.GenerarInfoCapituloXML(iIdCapitulo) Then Return m_Lanzadora.RESULTADO_NO_LANZADO
    If Not m_XML.GenerarBiblioCapituloXML(iIdCapitulo) Then Return m_Lanzadora.RESULTADO_NO_LANZADO

    ' nombre_archivo, xml:id, tipo E idioma: EL ORDEN QUE ESPERA EL SCRIPT
    sLista &= sNombre & Chr(9) & "cap-" & CStr(iIdCapitulo) & Chr(9) &
      sTipo & Chr(9) & sIdioma & Chr(10)
    Inc iCantidad

    hCapitulos.MoveNext
  Wend

  ' --- 5b. LA LISTA DE SIGLAS, EN TODO LOTE (1.18.0) ---
  ' NO TIENE .md: SUS SIGLAS SALEN DE LOS CANÓNICOS DE LAS DEMÁS PIEZAS, Y UN
  ' LOTE QUE CAMBIA UNO LA DEJA VIEJA. SE AGREGA SI EL LOTE NO LA TRAE (UN
  ' SOLO CAPÍTULO); EL SCRIPT LA PROCESA AL FINAL. SIN OTRAS PIEZAS NO HAY DE
  ' DÓNDE SACAR SIGLAS
  If iCantidad > 0 Then
    If InStr(sLista, Chr(9) & m_Siglas.TIPO_LISTA & Chr(9)) = 0 Then
      iIdLibro = m_XML.ObtenerIdLibro(m_InicioCierre.IdProyectoEnCurso)
      Try hListas = m_ConexionBD.mConn.Exec(
        "SELECT id_capitulo, nombre_archivo, tipo_capitulo, idioma_capitulo " &
        "FROM capitulos WHERE id_libro = &1 AND nombre_archivo IS NOT NULL AND tipo_capitulo = &2", iIdLibro, m_Siglas.TIPO_LISTA)
      If Error Then
        m_Sonido.sonar("Error")
        Message.Error("No se pudo leer la lista de siglas del libro:" & gb.NewLine & Error.Text)
        Return m_Lanzadora.RESULTADO_NO_LANZADO
      Endif
      While hListas.Available
        iIdCapitulo = hListas["id_capitulo"]
        sNombre = m_XML.TrimUTF8(hListas["nombre_archivo"])
        sIdioma = IdiomaDeCapitulo(hListas)
        ' LOS MISMOS INSUMOS QUE CUALQUIER PIEZA: info Y biblio. EL TIPO ES
        ' LA CONSTANTE, Y EL CONTROL DE TABULADORES DEL NOMBRE LO HACE
        ' m_Siglas.EscribirPiezas ANTES DEL LANZAMIENTO
        If Not m_XML.GenerarInfoCapituloXML(iIdCapitulo) Then Return m_Lanzadora.RESULTADO_NO_LANZADO
        If Not m_XML.GenerarBiblioCapituloXML(iIdCapitulo) Then Return m_Lanzadora.RESULTADO_NO_LANZADO
        sLista &= sNombre & Chr(9) & "cap-" & CStr(iIdCapitulo) & Chr(9) &
          m_Siglas.TIPO_LISTA & Chr(9) & sIdioma & Chr(10)
        Inc iCantidad
        hListas.MoveNext
      Wend
    Endif
  Endif

  If iCantidad = 0 Then
    m_Sonido.sonar("Warning")
    Message.Warning("Ninguna pieza del libro tiene cuerpo propio: no hay canónicos que generar.")
    Return m_Lanzadora.RESULTADO_NO_LANZADO
  Endif

  Try File.Save(m_InicioCierre.RutaProyectoEnCurso &/ LISTA_CANONICOS, sLista)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo escribir la lista de capítulos:" & gb.NewLine &
      LISTA_CANONICOS & gb.NewLine & gb.NewLine & Error.Text)
    Return m_Lanzadora.RESULTADO_NO_LANZADO
  Endif

  ' --- 6. LANZAMIENTO ---
  ' LA PESTAÑA DEL PROYECTO, COMO LOS BOTONES QUE ESTO REEMPLAZA. EL PANEL
  ' INFERIOR Y LA TERMINAL LOS MUESTRA m_Lanzadora.EjecutarScript
  FMain.TabStrip1.Index = 0

  aArgumentos.Add(m_InicioCierre.RutaProyectoEnCurso)
  aArgumentos.Add(LISTA_CANONICOS)

  Return m_Lanzadora.EjecutarScript("generar_canonicos_capitulos.sh", aArgumentos, PLAZO_CANONICOS_CAPITULO,
    "Generando los canónicos de capítulo")

End

' ============================================
' Función   : InformarCanonicos
' Propósito : Traduce el resultado del lote de canónicos a un mensaje. El
'             fallo se informa distinto que en InformarResultado: en un lote
'             puede haber canónicos generados y otros no, y los que no se
'             generaron se borraron (ver la cabecera del script).
' Parámetros: iResultado As Integer — lo que devolvió LanzarCanonicos
'             sNombreUnico As String — nombre_archivo si fue un solo capítulo;
'               vacío si fue el lote de todos
' Retorna   : (Sub, sin retorno)
' ============================================
Private Sub InformarCanonicos(iResultado As Integer, sNombreUnico As String)

  ' --- 1. INICIALIZACIÓN ---
  Dim sCarpeta As String

  sCarpeta = m_InicioCierre.RutaProyectoEnCurso &/ "jats"

  ' --- 2. UN SOLO CAPÍTULO ---
  ' LOS MENSAJES GENERALES SIRVEN; SOLO EL FALLO AGREGA LO DEL CANÓNICO BORRADO
  If sNombreUnico <> "" Then
    If iResultado = m_Lanzadora.SALIDA_FALLO Then
      m_Sonido.sonar("Error")
      Message.Error("El canónico de «" & sNombreUnico & "» no se generó." & gb.NewLine & gb.NewLine &
        "El motivo está en la terminal. Si había un canónico anterior," & gb.NewLine &
        "se borró: ya no correspondía al .md.")
    Else
      m_Lanzadora.InformarResultado(iResultado, "El canónico de «" & sNombreUnico & "»",
        sCarpeta &/ "c-" & sNombreUnico & ".xml")
    Endif
    Return
  Endif

  ' --- 3. LOTE DE TODOS ---
  Select Case iResultado

    Case m_Lanzadora.SALIDA_OK
      m_Sonido.sonar("Info")
      Message.Info("Se generaron los canónicos de todos los capítulos." & gb.NewLine & gb.NewLine &
        "Carpeta:" & gb.NewLine & sCarpeta)

    Case m_Lanzadora.SALIDA_AVISOS
      m_Sonido.sonar("Warning")
      Message.Warning("Se generaron los canónicos de todos los capítulos," & gb.NewLine &
        "pero con avisos." & gb.NewLine & gb.NewLine &
        "Revisá la terminal: al final están los capítulos con avisos," & gb.NewLine &
        "y cada aviso está marcado con ⚠ en su capítulo.")

    Case m_Lanzadora.SALIDA_FALLO
      ' NO SE AFIRMA QUE EL LOTE HAYA CORRIDO: EL CÓDIGO 1 TAMBIÉN LO DA UN
      ' FALLO DEL ENTORNO, ANTES DEL PRIMER CAPÍTULO
      m_Sonido.sonar("Error")
      Message.Error("No se generaron todos los canónicos." & gb.NewLine & gb.NewLine &
        "El detalle está en la terminal. Si el lote llegó a correr," & gb.NewLine &
        "al final está la lista de los capítulos que fallaron; sus" & gb.NewLine &
        "canónicos anteriores se borraron, así que el libro no se" & gb.NewLine &
        "puede ensamblar hasta corregirlos y regenerarlos.")

    Case Else
      ' EN CURSO, NO LANZADO, ABANDONADO, ILEGIBLE U OTRO CÓDIGO
      m_Lanzadora.InformarResultado(iResultado, "El lote de canónicos", sCarpeta)

  End Select

End

' ============================================
' Función   : TipoDeCapitulo
' Propósito : tipo_capitulo de la fila actual, con el default del XSLT de
'             ensamblado y del manifiesto: «capitulo» si es NULL o vacío.
' Parámetros: hCapitulo As Result — posicionado en la fila
' Retorna   : String — el tipo
' ============================================
Private Function TipoDeCapitulo(hCapitulo As Result) As String

  If IsNull(hCapitulo["tipo_capitulo"]) Then Return "capitulo"
  If Len(m_XML.TrimUTF8(hCapitulo["tipo_capitulo"])) = 0 Then Return "capitulo"
  Return m_XML.TrimUTF8(hCapitulo["tipo_capitulo"])

End

' ============================================
' Función   : IdiomaDeCapitulo
' Propósito : idioma_capitulo de la fila actual, con el default del XSLT de
'             ensamblado: «es» si es NULL o vacío.
' Parámetros: hCapitulo As Result — posicionado en la fila
' Retorna   : String — el código de idioma
' ============================================
Private Function IdiomaDeCapitulo(hCapitulo As Result) As String

  If IsNull(hCapitulo["idioma_capitulo"]) Then Return "es"
  If Len(m_XML.TrimUTF8(hCapitulo["idioma_capitulo"])) = 0 Then Return "es"
  Return m_XML.TrimUTF8(hCapitulo["idioma_capitulo"])

End

' ============================================
' Función   : ValidarCanonico
' Propósito : Valida un canónico del visor XML con engine/validar_canonicos.sh
'             en modo completo (SC-75): bien formado, vigencia, recursos y el
'             esquema según la raíz: DocBook 5.2 (RNG y Schematron) en un
'             libro; DTD de JATS 1.4 y JATS4R en un artículo de un número
'             nuevo. El informe queda en la terminal.
' Parámetros: sArchivo As String — nombre del archivo dentro de jats/, como lo
'               muestra cmbArchivosXML (c-a-01-CAP01.xml)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub ValidarCanonico(sArchivo As String)

  ' --- 1. INICIALIZACIÓN ---
  Dim sRutaProyecto As String
  Dim aArgumentos As New String[]
  Dim iResultado As Integer

  ' --- 2. VALIDACIÓN DE ENTRADA ---
  sRutaProyecto = m_InicioCierre.RutaProyectoEnCurso
  If sRutaProyecto = "" Then
    m_Sonido.sonar("Warning")
    Message.Warning("No hay ningún proyecto abierto.")
    Return
  Endif

  ' EL BOTÓN YA ESTÁ APAGADO EN UN NÚMERO VIEJO; ESTO CUBRE UNA LLAMADA DESDE
  ' OTRO LUGAR (SC-75)
  If Not m_Lanzadora.ValidacionHabilitada() Then
    m_Sonido.sonar("Warning")
    Message.Warning("La validación del visor no está disponible en este proyecto." & gb.NewLine &
      "En revistas, es solo para los números del esquema nuevo.")
    Return
  Endif

  If sArchivo = "" Then
    m_Sonido.sonar("Warning")
    Message.Warning("Elegí en la lista el canónico que querés validar.")
    Return
  Endif

  ' UN NOMBRE CON / SALDRÍA DE jats/: LA LISTA SOLO TRAE NOMBRES DE ARCHIVO
  If InStr(sArchivo, "/") > 0 Or Not Exist(sRutaProyecto &/ "jats" &/ sArchivo) Then
    m_Sonido.sonar("Error")
    Message.Error("No existe el archivo:" & gb.NewLine & sRutaProyecto &/ "jats" &/ sArchivo)
    Return
  Endif

  ' --- 3. LISTA DEL VALIDADOR ---
  ' UN SOLO ARCHIVO, RELATIVO AL PROYECTO, COMO LO ESPERA EL SCRIPT
  Try File.Save(sRutaProyecto &/ LISTA_VALIDAR, "jats/" & sArchivo & Chr(10))
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo escribir la lista del validador:" & gb.NewLine &
      LISTA_VALIDAR & gb.NewLine & gb.NewLine & Error.Text)
    Return
  Endif

  ' --- 4. LANZAMIENTO ---
  aArgumentos.Add(sRutaProyecto)
  aArgumentos.Add("completo")
  aArgumentos.Add(LISTA_VALIDAR)

  iResultado = m_Lanzadora.EjecutarScript("validar_canonicos.sh", aArgumentos, PLAZO_VALIDAR,
    "Validando " & sArchivo)

  ' --- 5. INFORME ---
  InformarValidacion(iResultado, "«" & sArchivo & "»")

End

' ============================================
' Función   : RevisarVigenciaLibro
' Propósito : Revisa al abrir un libro si sus canónicos corresponden todavía a
'             sus archivos fuente: engine/validar_canonicos.sh en modo
'             vigencia, sobre todos los jats/c-*.xml (SC-75). Sin JVM. Con
'             código 0 no muestra nada; un canónico sin huella tampoco se
'             informa acá, porque avisaría en cada apertura.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub RevisarVigenciaLibro()

  ' --- 1. INICIALIZACIÓN ---
  Dim sRutaProyecto As String
  Dim aArgumentos As New String[]
  Dim iResultado As Integer

  ' --- 2. VALIDACIÓN DE ENTRADA ---
  ' UN LIBRO SIN jats/ TODAVÍA NO TIENE CANÓNICOS: NO HAY NADA QUE REVISAR, Y
  ' EL SCRIPT SALDRÍA CON CÓDIGO 1 POR LA CARPETA QUE FALTA
  sRutaProyecto = m_InicioCierre.RutaProyectoEnCurso
  If sRutaProyecto = "" Then Return
  If Not IsDir(sRutaProyecto &/ "jats") Then Return

  ' --- 3. LANZAMIENTO ---
  ' «-» ES TODOS LOS jats/c-*.xml: LOS HUÉRFANOS NO ESTÁN EN NINGUNA LISTA DE
  ' LA BASE, Y SON PARTE DE LO QUE HAY QUE VER
  aArgumentos.Add(sRutaProyecto)
  aArgumentos.Add("vigencia")
  aArgumentos.Add("-")

  iResultado = m_Lanzadora.EjecutarScript("validar_canonicos.sh", aArgumentos, PLAZO_VIGENCIA,
    "Revisando la vigencia de los canónicos")

  ' --- 4. INFORME ---
  ' EN MODO vigencia EL CÓDIGO 3 SOLO LO DAN DESACTUALIZADOS Y HUÉRFANOS:
  ' «SIN HUELLA» VA EN TENUE (SC-75)
  Select Case iResultado

    Case m_Lanzadora.SALIDA_OK
      ' NADA QUE DECIR: LA APERTURA SIGUE SIN INTERRUPCIONES

    Case m_Lanzadora.SALIDA_AVISOS
      m_Sonido.sonar("Warning")
      Message.Warning("Hay canónicos desactualizados o huérfanos." & gb.NewLine & gb.NewLine &
        "Un canónico desactualizado ya no corresponde a su .md o a sus" & gb.NewLine &
        "cuadros: el ensamblado, el PDF y el EPUB no se generan hasta" & gb.NewLine &
        "regenerarlo. Uno huérfano no tiene .md: no se puede regenerar" & gb.NewLine &
        "y, si sobra, se borra a mano." & gb.NewLine & gb.NewLine &
        "El detalle está en la terminal.")

    Case m_Lanzadora.SALIDA_FALLO
      m_Sonido.sonar("Warning")
      Message.Warning("No se pudo revisar la vigencia de todos los canónicos." & gb.NewLine & gb.NewLine &
        "El motivo está en la terminal.")

    Case Else
      ' EN CURSO, NO LANZADO, ABANDONADO, ILEGIBLE U OTRO CÓDIGO
      InformarValidacion(iResultado, "La revisión de vigencia")

  End Select

End

' ============================================
' Función   : InformarValidacion
' Propósito : Traduce el resultado de validar_canonicos.sh a un mensaje. No
'             usa los textos de InformarResultado: un validador no genera
'             nada, y «se generó» sería falso (SC-75). Los resultados propios
'             de la lanzadora sí van a InformarResultado, que ya los conoce.
' Parámetros: iResultado As Integer — lo que devolvió m_Lanzadora.EjecutarScript
'             sQue As String — qué se validó, para el texto («c-a-01.xml»)
' Retorna   : (Sub, sin retorno)
' ============================================
Private Sub InformarValidacion(iResultado As Integer, sQue As String)

  ' --- 1. RESULTADOS PROPIOS DE LA LANZADORA ---
  ' NEGATIVOS: EN CURSO, NO LANZADO, ABANDONADO, ILEGIBLE. NINGUNO HABLA DE
  ' LO QUE SE GENERÓ, ASÍ QUE SUS TEXTOS SIRVEN TAL CUAL
  If iResultado < 0 Then
    m_Lanzadora.InformarResultado(iResultado, sQue, "")
    Return
  Endif

  ' --- 2. CÓDIGOS DEL VALIDADOR ---
  ' SOLO SE AFIRMA LO QUE EL SCRIPT VERIFICÓ: «VÁLIDO» ES QUE CORRIERON
  ' TODAS LAS CAPAS Y NINGUNA ENCONTRÓ NADA
  Select Case iResultado

    Case m_Lanzadora.SALIDA_OK
      m_Sonido.sonar("Info")
      Message.Info(sQue & ": sin hallazgos." & gb.NewLine & gb.NewLine &
        "Bien formado, al día con sus archivos fuente, válido contra" & gb.NewLine &
        "DocBook 5.2 (RNG y Schematron), conforme a las reglas de" & gb.NewLine &
        "gbpublisher y con sus imágenes en png o jpg en media/.")

    Case m_Lanzadora.SALIDA_AVISOS
      m_Sonido.sonar("Warning")
      Message.Warning(sQue & " tiene hallazgos." & gb.NewLine & gb.NewLine &
        "Revisá la terminal: están marcados con ⚠.")

    Case m_Lanzadora.SALIDA_FALLO
      m_Sonido.sonar("Error")
      Message.Error(sQue & " no se pudo validar." & gb.NewLine & gb.NewLine &
        "El motivo está en la terminal.")

    Case Else
      m_Sonido.sonar("Error")
      Message.Error(sQue & " no se pudo validar (código " & CStr(iResultado) & ")." & gb.NewLine & gb.NewLine &
        "El motivo está al final de la salida en la terminal.")

  End Select

End

' ============================================
' Función   : GenerarLibroHTML
' Propósito : Genera docs/index.html. engine/generar_html_libro.sh ensambla
'             primero el canónico del libro y recién después transforma: el
'             HTML es la única salida que lo lee, y la costura entre los dos
'             pasos era donde se rompía.
'             Con destino_html = 'portal' (1.22.0) la salida es la integrada
'             al portal: antes de lanzar el script se escriben la portada y
'             los créditos de la página de entrada, y el script recibe el
'             destino y la dirección del portal, de donde baja el marco.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub GenerarLibroHTML()

  ' --- 1. INICIALIZACIÓN ---
  Dim oInsumos As CInsumosLibro
  Dim aArgumentos As String[]
  Dim hTapa As Result
  Dim sEstiloCita As String
  Dim sModoCitas As String
  Dim sImagenTapa As String
  Dim sDestino As String
  Dim sUrlPortal As String
  Dim iRespuesta As Integer
  Dim iResultado As Integer

  ' --- 2. ALERTA PREVIA ---
  iRespuesta = Message.Question(
    "GENERAR LA SALIDA HTML DEL LIBRO (Fase 1)" & gb.NewLine & gb.NewLine &
    "Se ensambla el canónico del libro y se genera docs/index.html." & gb.NewLine & gb.NewLine &
    "Los canónicos de los capítulos tienen que estar regenerados:" & gb.NewLine &
    "el ensamblado los toma tal como están en el disco.",
    "Generar", "Cancelar")
  If iRespuesta <> 1 Then Return

  ' --- 3. INSUMOS DESDE LA BASE ---
  oInsumos = PrepararInsumosLibro()
  If Not oInsumos.bListo Then Return

  ' --- 4. ESTILO DE CITA Y MODO DE LAS CITAS (SC-57) ---
  sEstiloCita = ResolverEstiloCita(oInsumos.iIdLibro)
  sModoCitas = PrepararCitasPantalla(sEstiloCita)
  If sModoCitas = "" Then Return

  ' --- 5. TAPA Y DESTINO ---
  ' LA TAPA, SOLO PARA QUE EL SCRIPT AVISE SI LA BASE DECLARA UNA QUE NO ESTÁ
  ' EN media/: SE COPIA CON EL RESTO DE LAS IMÁGENES.
  ' EL DESTINO DECIDE LA SALIDA: UN ERROR AL LEERLO NO PUEDE CAER EN SILENCIO
  ' EN LA AUTÓNOMA, ASÍ QUE ESTA LECTURA, A DIFERENCIA DE LA ANTERIOR, FRENA
  sImagenTapa = ""
  sDestino = "autonomo"
  sUrlPortal = ""
  Try hTapa = m_ConexionBD.mConn.Exec(
    "SELECT imagen_tapa, destino_html, url_portal FROM libros_md WHERE id_libro = &1 LIMIT 1",
    oInsumos.iIdLibro)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudieron leer la tapa y el destino del HTML:" & gb.NewLine & Error.Text)
    Return
  Endif

  If hTapa.Available Then
    If Not IsNull(hTapa["imagen_tapa"]) Then
      sImagenTapa = m_XML.TrimUTF8(hTapa["imagen_tapa"])
    Endif
    ' destino_html ES NOT NULL; url_portal PUEDE SER NULL (GV-74)
    sDestino = m_XML.TrimUTF8(hTapa["destino_html"])
    If Not IsNull(hTapa["url_portal"]) Then
      sUrlPortal = m_XML.TrimUTF8(hTapa["url_portal"])
    Endif
  Endif

  ' LA BASE YA LO IMPIDE (chk_libros_destino_html); SE MIRA OTRA VEZ PARA DAR
  ' UN MENSAJE CLARO EN LUGAR DEL DEL SCRIPT
  If sDestino = "portal" And sUrlPortal = "" Then
    m_Sonido.sonar("Warning")
    Message.Warning("El libro está integrado al portal pero no tiene la dirección del portal." & gb.NewLine &
      "Cargala en el formulario del libro.")
    Return
  Endif

  ' --- 6. COLOFÓN DEL PIE ---
  ' EL SCRIPT VERIFICA QUE EXISTA ANTES DE TRANSFORMAR: SIN ÉL, LA HOJA
  ' OMITIRÍA EL PIE EN SILENCIO
  If Not EscribirColofonDigital(oInsumos.sRutaProyecto) Then Return

  ' --- 6b. PORTADA Y CRÉDITOS DE LA PÁGINA DE ENTRADA (SOLO INTEGRADO) ---
  ' LAS MISMAS PÁGINAS DEL EPUB, EN tmp/html-portal/. LA FUNCIÓN AVISA SOLA
  If sDestino = "portal" Then
    If Not m_GenerarEpubLibro.EscribirPrimerasHtml(oInsumos.sRutaProyecto, oInsumos.iIdLibro) Then Return
  Endif

  ' --- 7. ARGUMENTOS ---
  ' LOS CUATRO DEL ENSAMBLADO, MÁS EL ESTILO, EL MODO DE LAS CITAS Y LA TAPA.
  ' AUTÓNOMO: LA TAPA VA ÚLTIMA Y SOLO SI HAY. INTEGRADO: TAPA (O «-»),
  ' DESTINO Y DIRECCIÓN DEL PORTAL
  aArgumentos = ArgumentosEnsamblado(oInsumos)
  aArgumentos.Add(sEstiloCita)
  aArgumentos.Add(sModoCitas)
  If sDestino = "portal" Then
    ' INTEGRADO: LA TAPA OCUPA SU LUGAR AUNQUE NO HAYA («-»), PARA QUE LLEGUEN
    ' EL DESTINO Y LA DIRECCIÓN DEL PORTAL
    If sImagenTapa <> "" Then
      aArgumentos.Add(sImagenTapa)
    Else
      aArgumentos.Add("-")
    Endif
    aArgumentos.Add(sDestino)
    aArgumentos.Add(sUrlPortal)
  Else
    ' AUTÓNOMO: LOS MISMOS ARGUMENTOS DE SIEMPRE
    If sImagenTapa <> "" Then aArgumentos.Add(sImagenTapa)
  Endif

  ' --- 8. GENERACIÓN ---
  iResultado = m_Lanzadora.EjecutarScript("generar_html_libro.sh", aArgumentos, PLAZO_HTML,
    "Generando el HTML del libro")

  ' --- 9. INFORME ---
  m_Lanzadora.InformarResultado(iResultado, "El HTML del libro",
    oInsumos.sRutaProyecto &/ "docs" &/ "index.html")

  ' --- 10. LA TAPA DEL PORTAL ---
  ' CUBRE UNA TAPA REEMPLAZADA EN media/ SIN VOLVER A GUARDAR EL FORMULARIO
  ' (SC-81). SOLO SI EL HTML SALIÓ: SI FALLÓ POR LA TAPA, SERÍA EL MISMO AVISO DOS VECES
  If iResultado = m_Lanzadora.SALIDA_OK Or iResultado = m_Lanzadora.SALIDA_AVISOS Then m_TapaWeb.ActualizarLibroEnCurso()

End

' ==========================================================
' PROPÓSITO:
'   Punto de entrada único para la salida PDF de un libro.
'   Muestra qué se va a hacer y con qué prestaciones, y ofrece
'   generar los archivos LaTeX con o sin compilar.
'
' POR QUÉ DOS OPCIONES Y NO TRES
' ----------------------------------------------------------
'   Generar no es solo escribir el maestro: m_GenerarPDFLibro.
'   ArmarInsumosLaTeX escribe lo que sale de la base (preámbulo
'   derivado, .bib, lista de piezas, main.tex propuesto) y
'   engine/preparar_latex_libro.sh transforma los canónicos, borra
'   los .tex huérfanos y pone el main.tex en su lugar. Es todo el
'   trabajo salvo llamar a LuaLaTeX.
'
'   Así que «solo main.tex» y «salida PDF» no son dos operaciones
'   distintas: la segunda es la primera más compilar. Lo único que
'   cambia es si se ejecuta el compilador.
'
'   «Solo generar» sirve para revisar el main.tex o personalizarlo
'   antes de compilar, que es el caso de los scripts de
'   personalización del diseño.
'
' LAS PRESTACIONES SE MUESTRAN ANTES DE GENERAR
' ----------------------------------------------------------
'   Salen de libros_md.estado_libro y el editor no las elige acá:
'   son consecuencia del estado editorial del libro. Mostrarlas
'   evita la sorpresa de un PDF con cruces de corte cuando se
'   esperaba uno para revisar en pantalla.
' ==========================================================
Public Sub GenerarPDFLibro()

  Dim hLibro As Result
  Dim sEstado As String
  Dim sPrestaciones As String
  Dim sNombreSalida As String
  Dim aArgumentos As New String[]
  Dim iRespuesta As Integer
  Dim iResultado As Integer

  ' --- 0. MOSTRAR CONSOLA ---
  FMain.tbMostrarPanelInferior.Value = True
  FMain.TabPanelIzquierdaInferior.Index = 0

  ' --- 1. GUARD DE CAMBIOS SIN GUARDAR ---
  ' SE VERIFICA ANTES DE TODO: LA GENERACIÓN LEE LOS CANÓNICOS DEL DISCO, Y
  ' UN CAMBIO SIN GUARDAR EN EL EDITOR NO ESTÁ EN NINGUNO DE ELLOS (SC-06).
  If Not FMain.ConfirmarDescartarCambios() Then Return

  ' --- 2. LEER EL ESTADO EDITORIAL ---
  Try hLibro = m_ConexionBD.mConn.Exec(
    "SELECT estado_libro FROM libros_md WHERE id_proyecto = &1 LIMIT 1",
    m_InicioCierre.IdProyectoEnCurso)

  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo leer el estado del libro:" & gb.NewLine & Error.Text)
    Return
  Endif

  If Not hLibro.Available Then
    m_Sonido.sonar("Error")
    Message.Error("El proyecto abierto no tiene un libro asociado en la base.")
    Return
  Endif

  sEstado = LCase(Trim(hLibro["estado_libro"]))
  sPrestaciones = DescribirPrestaciones(sEstado)

  ' --- 3. CONSULTA AL USUARIO ---
  ' Message.Question DEVUELVE 1 PARA EL PRIMER BOTÓN, 2 PARA EL SEGUNDO Y 3
  ' PARA EL TERCERO.
  iRespuesta = Message.Question(
    "GENERAR LA SALIDA PDF DEL LIBRO" & gb.NewLine & gb.NewLine &
    "Se van a regenerar todos los archivos LaTeX del proyecto a partir" & gb.NewLine &
    "de los canónicos DocBook y de los datos de la base." & gb.NewLine & gb.NewLine &
    "Estado del libro: " & sEstado & gb.NewLine &
    sPrestaciones & gb.NewLine & gb.NewLine &
    "Los canónicos deben estar actualizados: la generación no los" & gb.NewLine &
    "regenera, los lee tal como están en el disco.",
    "Generar y compilar", "Solo generar", "Cancelar")

  If iRespuesta = 3 Then Return

  ' --- 4. LO QUE SALE DE LA BASE ---
  ' SOLO CONSULTAS Y ARMADO DE TEXTO: LA PARTE LENTA —EL COLOREO Y SAXON POR
  ' PIEZA— LA HACE EL SCRIPT, DENTRO DE LA LANZADORA. ArmarInsumosLaTeX AVISA
  ' CON SU PROPIO MENSAJE CUANDO ABORTA
  If Not m_GenerarPDFLibro.ArmarInsumosLaTeX() Then Return

  ' --- 5. SOLO GENERAR: PREPARAR Y TERMINAR ---
  If iRespuesta = 2 Then
    aArgumentos.Add(m_InicioCierre.RutaProyectoEnCurso)
    aArgumentos.Add(m_GenerarPDFLibro.LISTA_PIEZAS_LATEX)
    aArgumentos.Add(m_GenerarPDFLibro.MAIN_PROPUESTO)

    iResultado = m_Lanzadora.EjecutarScript("preparar_latex_libro.sh", aArgumentos, PLAZO_PDF,
      "Preparando los archivos LaTeX del libro")

    ' EL main.tex QUEDA EN latex/ PARA REVISARLO O PERSONALIZARLO ANTES DE
    ' COMPILAR
    m_Lanzadora.InformarResultado(iResultado, "El main.tex",
      m_InicioCierre.RutaProyectoEnCurso &/ "latex" &/ "main.tex")
    Return
  Endif

  ' --- 6. COMPILACIÓN ---
  ' POR LA LANZADORA (SC-53), COMO LAS DEMÁS SALIDAS: ANTES SE TIPEABA EN LA
  ' TERMINAL Y GAMBAS NO SE ENTERABA DE CUÁNDO TERMINABA, ASÍ QUE NO PODÍA
  ' MOSTRAR QUE ESTABA TRABAJANDO NI INFORMAR CÓMO TERMINÓ. LA EXISTENCIA DEL
  ' SCRIPT LA VERIFICA LA LANZADORA. EL COMPILADOR LLAMA PRIMERO A
  ' preparar_latex_libro.sh: TODO EN UN SOLO LANZAMIENTO.

  ' EL NOMBRE DEL PDF ES EL DEL PROYECTO, NO «main». EL MAESTRO SE LLAMA
  ' main.tex POR CONVENIENCIA INTERNA; EL ARCHIVO QUE RECIBE EL EDITOR TIENE
  ' QUE DECIR DE QUÉ LIBRO ES.
  sNombreSalida = File.BaseName(m_InicioCierre.NombreProyectoEnCurso)

  aArgumentos.Add(m_InicioCierre.RutaProyectoEnCurso)
  aArgumentos.Add(m_Bibtex.NombreArchivoBib())
  aArgumentos.Add(sNombreSalida)
  aArgumentos.Add(m_GenerarPDFLibro.LISTA_PIEZAS_LATEX)
  aArgumentos.Add(m_GenerarPDFLibro.MAIN_PROPUESTO)

  iResultado = m_Lanzadora.EjecutarScript("compilar_pdf_libro.sh", aArgumentos, PLAZO_PDF,
    "Componiendo el PDF del libro")

  ' --- 7. INFORME ---
  m_Lanzadora.InformarResultado(iResultado, "El PDF del libro",
    m_InicioCierre.RutaProyectoEnCurso &/ "salidas" &/ "pdf" &/ sNombreSalida & ".pdf")

Catch
  ' RED DE ÚLTIMO RECURSO (RC-GM-20). LOS FALLOS PREVISIBLES SE ATRAPAN CON
  ' Try + If Error EN SU PUNTO.
  m_Sonido.sonar("Error")
  Message.Error("Error al preparar la salida PDF: " & Error.Text)

End

' ============================================
' Función   : DescribirPrestaciones
' Propósito : Describe en lenguaje llano qué prestaciones produce un estado
'             editorial, para mostrarlas antes de generar.
' Parámetros: sEstado As String — libros_md.estado_libro
' Retorna   : String — descripción de una línea
' Nota      : LA TABLA TIENE QUE COINCIDIR CON PrestacionesDeSalida DE
'             m_GenerarPDFLibro. SON DOS LUGARES PARA EL MISMO HECHO, PERO
'             UNO PRODUCE BANDERAS Y EL OTRO TEXTO PARA UN HUMANO. SI SE
'             AGREGA UN ESTADO, HAY QUE TOCAR LOS DOS.
' ============================================
Private Function DescribirPrestaciones(sEstado As String) As String

  Select Case LCase(Trim(sEstado))
    Case "borrador"
      Return "  marcas de caja, marcas tipográficas de trabajo y enlaces en color"
    Case "en_correccion"
      Return "  marcas tipográficas de trabajo y enlaces en color"
    Case "en_produccion"
      Return "  enlaces en color, sin marcas de trabajo"
    Case "publicado"
      Return "  cruces de corte, enlaces sin color, código en blanco y negro, hoja de montaje"
    Case m_GenerarPDFLibro.PERFIL_PRESERVACION
      Return "  preservación: formato final, enlaces y código en color, sin marcas ni cruces"
    Case Else
      Return "  estado no reconocido: se compone como en producción"
  End Select

End

' ============================================
' Función   : GenerarPDFA2uLibro
' Propósito : Salida PDF/A-2u del libro, para preservación. Es directa: no
'             pregunta y NO REGENERA NADA. Compila lo que ya está en latex/
'             —el main.tex y las piezas del PDF publicado— con un maestro
'             envolvente que declara la norma y el perfil de preservación:
'               \DocumentMetadata{pdfstandard=A-2u, lang=…}
'               \def\gbPerfilPreservacion{}
'               \input{main}
'             El PDF/A se hace cuando el libro ya está en la web y quizá en
'             imprenta: tiene que ser ESE libro, no uno recompuesto desde
'             canónicos que pudieron cambiar después.
'             engine/compilar_pdfa_libro.sh compila en latex/pdfa/, valida con
'             veraPDF y solo si es conforme lo pasa a salidas/pdf/ como
'             {proyecto}_pdfa2u.pdf.
' Parámetros: ninguno (trabaja sobre el proyecto en curso)
' Retorna   : nada
' Nota      : SIN GUARD DE CAMBIOS SIN GUARDAR: NO LEE LOS CANÓNICOS NI EL
'             EDITOR, SOLO latex/. EL PERFIL DE PRESERVACIÓN LO APLICA EL
'             PREÁMBULO DERIVADO, QUE TIENE QUE SER DE ESTA VERSIÓN: SE
'             VERIFICA EN EL APARTADO 2.
' ============================================
Public Sub GenerarPDFA2uLibro()

  Dim hLibro As Result
  Dim sRutaLatex As String
  Dim sPreambulo As String
  Dim sIdioma As String
  Dim sNombreSalida As String
  Dim sDirPdfa As String
  Dim sMaestroRel As String
  Dim sTexto As String
  Dim aArgumentos As New String[]
  Dim iResultado As Integer

  ' --- 0. MOSTRAR CONSOLA ---
  FMain.tbMostrarPanelInferior.Value = True
  FMain.TabPanelIzquierdaInferior.Index = 0

  ' --- 1. PROYECTO ABIERTO ---
  If m_InicioCierre.IdProyectoEnCurso = 0 Then
    m_Sonido.sonar("Info")
    Message.Info("Abrí un proyecto antes de generar la salida PDF/A.")
    Return
  Endif

  ' --- 2. LO QUE SE REUSA TIENE QUE ESTAR, Y SER DE ESTA VERSIÓN ---
  sRutaLatex = m_InicioCierre.RutaProyectoEnCurso &/ "latex"

  If Not Exist(sRutaLatex &/ "main.tex") Then
    m_Sonido.sonar("Error")
    Message.Error("No existe latex/main.tex." & gb.NewLine & gb.NewLine &
      "El PDF/A compila lo que ya está en latex/, sin regenerar nada:" & gb.NewLine &
      "generá primero el PDF estándar.")
    Return
  Endif

  Try sPreambulo = File.Load(sRutaLatex &/ "preambulo-proyecto.tex")
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo leer latex/preambulo-proyecto.tex:" & gb.NewLine & Error.Text)
    Return
  Endif

  ' UN DERIVADO ANTERIOR NO CONOCE EL PERFIL: EL PDF/A SALDRÍA CON LAS
  ' PRESTACIONES DEL ÚLTIMO ESTADO (CON CRUCES, SI FUE IMPRENTA) SIN AVISO
  If InStr(sPreambulo, "\\gbPerfilPreservacion") = 0 Then
    m_Sonido.sonar("Error")
    Message.Error("El preambulo-proyecto.tex de latex/ es de una versión anterior" & gb.NewLine &
      "y no conoce el perfil de preservación." & gb.NewLine & gb.NewLine &
      "Generá una vez el PDF estándar con esta versión de gbpublisher.")
    Return
  Endif

  ' --- 3. IDIOMA DEL DOCUMENTO ---
  ' \DocumentMetadata PIDE EL CÓDIGO BCP 47, QUE ES LO QUE GUARDA LA BASE
  ' (m_Idiomas). SE VERIFICA CONTRA EL CATÁLOGO: UN CÓDIGO QUE NO ESTÁ AHÍ
  ' TAMPOCO LO RECONOCE babel
  Try hLibro = m_ConexionBD.mConn.Exec(
    "SELECT idioma_principal FROM libros_md WHERE id_proyecto = &1 LIMIT 1",
    m_InicioCierre.IdProyectoEnCurso)

  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo leer el libro del proyecto:" & gb.NewLine & Error.Text)
    Return
  Endif

  If Not hLibro.Available Then
    m_Sonido.sonar("Error")
    Message.Error("El proyecto abierto no tiene un libro asociado en la base.")
    Return
  Endif

  If IsNull(hLibro["idioma_principal"]) Then
    sIdioma = ""
  Else
    sIdioma = Trim(hLibro["idioma_principal"])
  Endif

  If m_Idiomas.Babel(sIdioma) = "" Then
    m_Sonido.sonar("Error")
    Message.Error("El idioma principal del libro no está en el catálogo de idiomas: «" & sIdioma & "».")
    Return
  Endif

  ' --- 4. MAESTRO ENVOLVENTE ---
  ' SE LLAMA COMO EL PDF FINAL: CON \DocumentMetadata, dc:source ES EL NOMBRE
  ' DEL TRABAJO, Y ASÍ DICE DE QUÉ LIBRO ES (pdfsource SE IGNORA, GV-101)
  sNombreSalida = File.BaseName(m_InicioCierre.NombreProyectoEnCurso) & SUFIJO_PDFA2U
  sDirPdfa = sRutaLatex &/ CARPETA_PDFA
  sMaestroRel = "latex" &/ CARPETA_PDFA &/ sNombreSalida & ".tex"

  If Not Exist(sDirPdfa) Then
    Try Mkdir sDirPdfa
    If Error Then
      m_Sonido.sonar("Error")
      Message.Error("No se pudo crear latex/" & CARPETA_PDFA & "/:" & gb.NewLine & Error.Text)
      Return
    Endif
  Endif

  sTexto = "% " & sNombreSalida & ".tex — MAESTRO DEL PDF/A-2u" & gb.NewLine
  sTexto &= "% ARCHIVO DERIVADO: LO ESCRIBE gbpublisher EN CADA GENERACIÓN." & gb.NewLine
  sTexto &= "% \\DocumentMetadata VA ANTES DE \\documentclass, QUE ESTÁ EN main.tex." & gb.NewLine
  sTexto &= "% \\gbPerfilPreservacion IMPONE EL PERFIL DE PRESERVACIÓN AL PREÁMBULO" & gb.NewLine
  sTexto &= "% DERIVADO: SIN MARCAS DE TRABAJO NI CRUCES DE CORTE." & gb.NewLine
  sTexto &= "\\DocumentMetadata{pdfstandard=A-2u, lang=" & sIdioma & "}" & gb.NewLine
  sTexto &= "\\def\\gbPerfilPreservacion{}" & gb.NewLine
  sTexto &= "\\input{main}" & gb.NewLine

  ' File.Save ESCRIBE UTF-8 TAL CUAL (SC-02)
  Try File.Save(m_InicioCierre.RutaProyectoEnCurso &/ sMaestroRel, sTexto)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo escribir el maestro del PDF/A:" & gb.NewLine & Error.Text)
    Return
  Endif

  ' --- 5. COMPILACIÓN Y VALIDACIÓN ---
  ' POR LA LANZADORA (SC-53). EL SCRIPT VALIDA CON veraPDF Y SOLO ENTREGA UN
  ' PDF CONFORME: UNO QUE NO LO ES QUEDA EN latex/pdfa/ Y SALE CON CÓDIGO 1
  aArgumentos.Add(m_InicioCierre.RutaProyectoEnCurso)
  aArgumentos.Add(m_Bibtex.NombreArchivoBib())
  aArgumentos.Add(sNombreSalida)
  aArgumentos.Add(sMaestroRel)
  aArgumentos.Add(NIVEL_PDFA2U)

  iResultado = m_Lanzadora.EjecutarScript("compilar_pdfa_libro.sh", aArgumentos, PLAZO_PDF,
    "Componiendo el PDF/A-2u del libro")

  ' --- 6. INFORME ---
  m_Lanzadora.InformarResultado(iResultado, "El PDF/A-2u del libro",
    m_InicioCierre.RutaProyectoEnCurso &/ "salidas" &/ "pdf" &/ sNombreSalida & ".pdf")

Catch
  ' RED DE ÚLTIMO RECURSO (RC-GM-20). LOS FALLOS PREVISIBLES SE ATRAPAN CON
  ' Try + If Error EN SU PUNTO.
  m_Sonido.sonar("Error")
  Message.Error("Error al preparar la salida PDF/A: " & Error.Text)

End
