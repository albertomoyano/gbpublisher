' Gambas module file

' ==============================================================================
' Módulo: m_Shortcodes
' ------------------------------------------------------------------------------
' El panel de shortcodes y la inserción en el editor:
'   - Lista por tipo de marcado (bloques, marcas en línea), agrupada por
'     grupo y perfil, con los shortcodes que el diccionario deja ver
'   - Ayuda del shortcode elegido, con el ejemplo coloreado como en el editor
'   - Inserción según el modo: envolver, plantilla o figura
'   - Cierre nombrado de los bloques (SC-33)
'
' LOS DATOS SALEN DE m_CatalogoShortcodes, EL DICCIONARIO QUE LEE LO QUE
' EXPORTA gbShortcodes (RF-11). ESTE MÓDULO NO TIENE NINGUNA LISTA PROPIA
' DE SHORTCODES NI CONSULTA LA BASE.
'
' CONTROLES DEL PANEL EN FMain:
'   - cmbShortcodes       (ComboBox, ReadOnly): tipo de marcado
'   - txtDescripcion      (TextLabel): qué es un bloque y qué una marca en línea
'   - lbDefiniciones      (ListView): shortcodes, con separadores de grupo
'   - txtAyudaShortcode   (TextEdit, ReadOnly): ayuda del shortcode elegido
' ==============================================================================

' --- OPCIONES DEL COMBO ---
Public Const OPCION_BLOQUES As String = "Bloques"
Public Const OPCION_LINEA As String = "Marcas en línea"

' --- SEPARADORES DE LA LISTA: NO SE PUEDEN ELEGIR ---
Private Const SEP_COMUNES As String = "Comunes"
Private Const SEP_ESTRUCTURA As String = "Estructura del producto"
Private Const SEP_DISCIPLINARES As String = "Disciplinares"
' INSTRUCCIONES DE COMPOSICIÓN: SOLO PARA EL PDF (SC-38)
Private Const SEP_COMPOSICION As String = "Composición (solo PDF)"
Private Const SEP_VACIO As String = "Ninguno disponible todavía"

' SANGRÍA DE UN SHORTCODE BAJO SU SEPARADOR
Private Const PREFIJO_ITEM As String = "      "

' MARCA DE UN BORRADOR EN LA LISTA (SOLO SE VEN DESDE EL IDE)
Private Const MARCA_BORRADOR As String = " (borrador)"

' --- SHORTCODES DE LA LISTA ACTUAL, POR LA KEY DEL ÍTEM ("sc:nombre") ---
' LOS SEPARADORES ("sep:N") NO TIENEN ENTRADA
Public cShortcodesActuales As Collection

' --- LA AYUDA: CONTROL Y SHORTCODE QUE MUESTRA, PARA REPINTARLA ---
' AL CAMBIAR DE TEMA O DE TIPOGRAFÍA (m_ResaltadoSintaxis)
Private $hAyuda As TextEdit
Private $sNombreEnAyuda As String

' ==============================================================================
' Función   : InicializarTabShortcodes
' Propósito : Punto único de entrada al abrir un proyecto. Llena el combo,
'             deja la ayuda vacía y dispara la carga de la lista con la
'             primera opción.
' Parámetros: cmb As ComboBox — FMain.cmbShortcodes
'             lst As ListView — FMain.lbDefiniciones
'             txt As TextEdit — FMain.txtAyudaShortcode
' Retorna   : nada
' ==============================================================================
Public Sub InicializarTabShortcodes(cmb As ComboBox, lst As ListView, txt As TextEdit)

  ' --- 1. ESTADO ---
  $hAyuda = txt
  $sNombreEnAyuda = ""
  cShortcodesActuales = New Collection

  ' --- 2. CONTROLES ---
  lst.Clear
  txt.ReadOnly = True
  txt.Wrap = True
  LimpiarAyuda()

  cmb.Clear
  cmb.Add(OPCION_BLOQUES)
  cmb.Add(OPCION_LINEA)
  cmb.ReadOnly = True

  ' --- 3. PRIMERA OPCIÓN ---
  ' ASIGNAR Index DISPARA cmbShortcodes_Click, QUE CARGA LA LISTA: UN SOLO
  ' CAMINO DE CARGA (GV-53)
  cmb.Index = 0

End

' ==============================================================================
' Función   : TipoDeOpcion
' Propósito : Traduce la opción del combo al tipo del catálogo
' Parámetros: sOpcion As String — texto elegido en el combo
' Retorna   : String — TIPO_BLOQUE o TIPO_LINEA; vacío si no es una opción
' ==============================================================================
Public Function TipoDeOpcion(sOpcion As String) As String

  If sOpcion = OPCION_BLOQUES Then Return m_CatalogoShortcodes.TIPO_BLOQUE
  If sOpcion = OPCION_LINEA Then Return m_CatalogoShortcodes.TIPO_LINEA
  Return ""

End

' ==============================================================================
' Función   : DescripcionDeTipo
' Propósito : El texto del rótulo para un tipo de marcado
' Parámetros: sTipo As String — TIPO_BLOQUE o TIPO_LINEA
' Retorna   : String — el texto (SC-03: vive en m_Constantes)
' ==============================================================================
Public Function DescripcionDeTipo(sTipo As String) As String

  If sTipo = m_CatalogoShortcodes.TIPO_LINEA Then Return m_Constantes.SHORTCODE_AYUDA_LINEA
  Return m_Constantes.SHORTCODE_AYUDA_BLOQUES

End

' ==============================================================================
' Función   : CargarShortcodesPorTipo
' Propósito : Llena la lista con los shortcodes visibles del tipo de
'             marcado y del tipo de proyecto, con un separador por grupo y,
'             en los disciplinares, uno por perfil.
' Parámetros: sTipo As String — TIPO_BLOQUE o TIPO_LINEA
'             lst As ListView — FMain.lbDefiniciones
' Retorna   : Boolean — True si se llenó (aunque haya quedado sin shortcodes)
' ==============================================================================
Public Function CargarShortcodesPorTipo(sTipo As String, lst As ListView) As Boolean

  Dim aVisibles As CShortcodeCatalogo[]
  Dim oFila As CShortcodeCatalogo
  Dim bLibro As Boolean
  Dim sGrupoAnterior As String
  Dim sPerfilAnterior As String
  Dim sTexto As String

  ' --- 1. RESET ---
  lst.Clear
  cShortcodesActuales = New Collection
  LimpiarAyuda()

  ' --- 2. TIPO DE PROYECTO: LIBRO O REVISTA ---
  Select Case FMain.TipoProyectoActual
    Case m_Constantes.TIPO_REVISTA_MD
      bLibro = False
    Case m_Constantes.TIPO_LIBRO_MD
      bLibro = True
    Default
      ' SIN PROYECTO, O DE UN TIPO QUE NO USA SHORTCODES
      Return False
  End Select

  ' --- 3. LO QUE EL DICCIONARIO DEJA VER, EN EL ORDEN DEL CATÁLOGO ---
  aVisibles = m_CatalogoShortcodes.Visibles(bLibro, sTipo)

  ' UNA LISTA VACÍA SE DICE, NO SE DEJA EN BLANCO (GV-23)
  If aVisibles.Count = 0 Then
    AgregarSeparador(lst, SEP_VACIO, False)
    Return True
  Endif

  ' --- 4. SEPARADORES AL CAMBIAR DE GRUPO, Y DE PERFIL EN LOS DISCIPLINARES ---
  sGrupoAnterior = "#"
  sPerfilAnterior = "#"
  For Each oFila In aVisibles

    If oFila.sGrupo <> sGrupoAnterior Then
      AgregarSeparador(lst, NombreDeGrupo(oFila.sGrupo), True)
      sGrupoAnterior = oFila.sGrupo
      sPerfilAnterior = "#"
    Endif

    If oFila.sPerfil <> "" Then
      If oFila.sPerfil <> sPerfilAnterior Then
        AgregarSeparador(lst, FormatearNombrePerfil(oFila.sPerfil), False)
        sPerfilAnterior = oFila.sPerfil
      Endif
    Endif

    ' EL ÍTEM; UN BORRADOR SOLO SE VE DESDE EL IDE Y SE MARCA
    sTexto = PREFIJO_ITEM & oFila.sEtiqueta
    If oFila.Estado(bLibro) <> m_CatalogoShortcodes.ESTADO_LIBERADO Then sTexto &= MARCA_BORRADOR
    lst.Add("sc:" & oFila.sNombre, sTexto)
    cShortcodesActuales["sc:" & oFila.sNombre] = oFila

  Next

  Return True

End

' ==============================================================================
' Función   : AgregarSeparador
' Propósito : Agrega un ítem que no se puede elegir: un grupo (con fondo)
'             o un perfil
' Parámetros: lst As ListView — lista
'             sTexto As String — texto del separador
'             bPrincipal As Boolean — True grupo, False perfil o aviso
' Retorna   : nada
' ==============================================================================
Private Sub AgregarSeparador(lst As ListView, sTexto As String, bPrincipal As Boolean)

  Dim sKey As String

  ' LA KEY ES ÚNICA POR LA POSICIÓN EN LA LISTA
  sKey = "sep:" & CStr(lst.Count) & ":" & sTexto
  lst.Add(sKey, sTexto)
  lst[sKey].RichText = "<b>" & Html$(sTexto) & "</b>"
  If bPrincipal Then
    lst[sKey].Background = &HF5EBC8&
  Else
    lst[sKey].Background = Color.Background
  Endif

End

' ==============================================================================
' Función   : NombreDeGrupo
' Propósito : El texto del separador de un grupo del catálogo
' Parámetros: sGrupo As String — comun, estructura, disciplinar o composicion
' Retorna   : String — texto visible
' ==============================================================================
Private Function NombreDeGrupo(sGrupo As String) As String

  Select Case sGrupo
    Case "comun"
      Return SEP_COMUNES
    Case "estructura"
      Return SEP_ESTRUCTURA
    Case "disciplinar"
      Return SEP_DISCIPLINARES
    Case "composicion"
      Return SEP_COMPOSICION
  End Select
  Return sGrupo

End

' ==============================================================================
' Función   : FormatearNombrePerfil
' Propósito : El perfil del catálogo como texto visible (ciencias_sociales
'             → Ciencias sociales)
' Parámetros: sPerfil As String — perfil del catálogo
' Retorna   : String — texto visible
' ==============================================================================
Private Function FormatearNombrePerfil(sPerfil As String) As String

  Dim sTexto As String

  sTexto = Replace(sPerfil, "_", " ")
  Return String.UCase(String.Left(sTexto, 1)) & String.Mid(sTexto, 2)

End

' ==============================================================================
' Función   : AnclaCierre
' Propósito : Arma el ancla del cierre nombrado de un bloque (SC-33). Es el
'             ÚNICO lugar con el formato: lo usan InsertarShortcode y
'             FMain.InsertarFigura. Quien la escribe pone antes una línea
'             en blanco; sin ella, Pandoc la lee como texto del párrafo.
' Parámetros: sClase As String — clase de Pandoc del bloque (fig, epigraph)
' Retorna   : String — "[/clase]: # ()", sin salto de línea
' ==============================================================================
Public Function AnclaCierre(sClase As String) As String

  Return "[/" & sClase & "]: # ()"

End

' ==============================================================================
' Función   : LimpiarAyuda
' Propósito : Deja la ayuda vacía y sin shortcode
' Parámetros: ninguno
' Retorna   : nada
' ==============================================================================
Public Sub LimpiarAyuda()

  $sNombreEnAyuda = ""
  If IsNull($hAyuda) Then Return
  $hAyuda.RichText = ""

End

' ==============================================================================
' Función   : RenderizarInfoShortcode
' Propósito : Muestra la ayuda de un shortcode: el fragmento que exporta
'             gbShortcodes, con el ejemplo coloreado en el lugar de la marca
' Parámetros: oFila As CShortcodeCatalogo — shortcode; Null limpia la ayuda
' Retorna   : nada
' ==============================================================================
Public Sub RenderizarInfoShortcode(oFila As CShortcodeCatalogo)

  ' --- 1. SIN SHORTCODE (UN SEPARADOR): AYUDA VACÍA ---
  If IsNull(oFila) Then
    LimpiarAyuda()
    Return
  Endif

  ' --- 2. SE RECUERDA PARA REPINTARLA AL CAMBIAR DE TEMA ---
  $sNombreEnAyuda = oFila.sNombre
  PintarAyuda()

End

' ==============================================================================
' Función   : RefrescarAyuda
' Propósito : Vuelve a pintar la ayuda con el tema y la tipografía
'             actuales. La llama m_ResaltadoSintaxis al cambiarlos.
' Parámetros: ninguno
' Retorna   : nada
' ==============================================================================
Public Sub RefrescarAyuda()

  If $sNombreEnAyuda = "" Then Return
  PintarAyuda()

End

' ==============================================================================
' Función   : PintarAyuda
' Propósito : Arma el HTML de la ayuda del shortcode en curso y lo asigna
' Parámetros: ninguno
' Retorna   : nada
' ==============================================================================
Private Sub PintarAyuda()

  Dim oFila As CShortcodeCatalogo
  Dim sFragmento As String
  Dim sEjemplo As String
  Dim aHtml As New String[]

  ' --- 1. EL SHORTCODE Y SU FRAGMENTO ---
  If IsNull($hAyuda) Then Return
  oFila = m_CatalogoShortcodes.PorNombre($sNombreEnAyuda)
  If IsNull(oFila) Then
    LimpiarAyuda()
    Return
  Endif

  sFragmento = m_CatalogoShortcodes.AyudaHTML(oFila.sNombre)

  ' --- 2. DOCUMENTO CON SU ESTILO EN LA CABECERA (GV-64) ---
  aHtml.Add("<html><head><style>")
  aHtml.Add("h3 { font-size: 12pt; margin-top: 10px; margin-bottom: 4px; }")
  aHtml.Add("p { margin-top: 0px; margin-bottom: 6px; }")
  aHtml.Add("code { font-family: monospace; }")
  aHtml.Add("</style></head><body>")

  ' UN BORRADOR SOLO SE VE DESDE EL IDE: SE DICE QUE LO ES
  If oFila.Estado(FMain.TipoProyectoActual = m_Constantes.TIPO_LIBRO_MD) <> m_CatalogoShortcodes.ESTADO_LIBERADO Then
    aHtml.Add("<p><i>Borrador: no se ve en la versión instalada.</i></p>")
  Endif

  ' --- 3. EL FRAGMENTO, O POR QUÉ NO ESTÁ (GV-23) ---
  If sFragmento = "" Then
    aHtml.Add("<p>No se encontró la ayuda de <b>" & Html$(oFila.sNombre) & "</b> en " &
      Html$(m_CatalogoShortcodes.Carpeta()) & ".</p>")
  Else
    sEjemplo = m_CatalogoShortcodes.Ejemplo(oFila.sNombre)
    aHtml.Add(Replace(sFragmento, m_CatalogoShortcodes.MARCA_EJEMPLO, BloqueEjemplo(sEjemplo)))
  Endif

  aHtml.Add("</body></html>")

  ' --- 4. ASIGNACIÓN: DESDE EL PRINCIPIO (GV-37); NUNCA Pos (GV-44) ---
  Try $hAyuda.RichText = aHtml.Join(gb.NewLine)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo mostrar la ayuda del shortcode:" & gb.NewLine & Error.Text)
    Return
  Endif
  $hAyuda.Select(0, 0)
  $hAyuda.ScrollY = 0

End

' ==============================================================================
' Función   : BloqueEjemplo
' Propósito : El ejemplo coloreado con la gramática y el tema del editor,
'             en una celda con el fondo del tema y la tipografía del editor
' Parámetros: sEjemplo As String — el ejemplo tal como se escribe
' Retorna   : String — tabla HTML de una celda
' ==============================================================================
Private Function BloqueEjemplo(sEjemplo As String) As String

  Dim sParrafos As String

  ' --- 1. SIN EJEMPLO EXPORTADO ---
  If sEjemplo = "" Then Return "<p><i>Sin ejemplo.</i></p>"

  ' --- 2. COLOREADO; SI EL RESALTADO FALLA (YA INFORMADO), TEXTO PLANO ---
  sParrafos = m_ResaltadoSintaxis.HtmlResaltado(sEjemplo, "markdown", m_ResaltadoSintaxis.CssFuente())
  If sParrafos = "" Then sParrafos = "<pre>" & Html$(sEjemplo) & "</pre>"

  ' --- 3. CELDA A TODO EL ANCHO CON EL FONDO DEL TEMA (GV-64) ---
  Return "<table width='100%' cellpadding='8' cellspacing='0'><tr><td bgcolor='" &
    m_ResaltadoSintaxis.ColorFondoHex() & "'>" & sParrafos & "</td></tr></table>"

End

' ==============================================================================
' Función   : InsertarShortcode
' Propósito : Inserta un shortcode en el editor según su modo:
'             - figura: el camino de FMain.InsertarFigura (SC-32)
'             - envolver: rodea la selección, que es obligatoria
'             - dos-partes: como envolver, si la selección tiene la forma
'               {primera}{segunda} (SC-35); si no, avisa y no inserta
'             - separador: un bloque vacío; sin selección y con el cursor
'               al principio de una línea vacía (SC-36)
'             - separador-valor: como el separador, con el marcador • en la
'               línea del valor, seleccionado (SC-39)
'             - plantilla: inserta el marcador • en lugar del contenido y
'               lo deja seleccionado (SC-21)
'             Un bloque ocupa líneas propias y cierra con el ancla nombrada
'             precedida de línea en blanco (SC-33); una marca en línea
'             cierra en la misma línea.
' Parámetros: oFila As CShortcodeCatalogo — shortcode
' Retorna   : nada
' ==============================================================================
Public Sub InsertarShortcode(oFila As CShortcodeCatalogo)

  Dim sSeleccion As String
  Dim sContenido As String
  Dim sInsertar As String
  Dim sTexto As String
  Dim iInicio As Integer
  Dim iLargo As Integer
  Dim iMarca As Integer
  Dim sMotivo As String

  ' --- 1. VALIDACIÓN ---
  If IsNull(oFila) Then Return

  ' --- 2. FIGURA: ELIGE LA IMAGEN, LA COPIA A /media Y ARMA EL BLOQUE ---
  If oFila.sModo = m_CatalogoShortcodes.MODO_FIGURA Then
    FMain.InsertarFigura(InStr(oFila.sApertura, ".fullwidth") > 0)
    Return
  Endif

  ' --- 3. SELECCIÓN SEGÚN EL MODO ---
  sSeleccion = m_EditorPrincipal.TextoSeleccionado()

  ' SEPARADOR: NO ENVUELVE NI REEMPLAZA, Y VA EN UNA LÍNEA PROPIA: EN UNA
  ' LÍNEA VACÍA NO PARTE NINGÚN PÁRRAFO. SE INSERTA ACÁ PORQUE NO TIENE
  ' CONTENIDO ENTRE LA APERTURA Y EL ANCLA. EL SEPARADOR CON VALOR TIENE LOS
  ' MISMOS SEMÁFOROS Y UNA LÍNEA CON EL MARCADOR PARA ESCRIBIR EL VALOR, QUE
  ' VALIDA EL FILTRO AL GENERAR (SC-39): AL INSERTAR TODAVÍA NO EXISTE
  If oFila.sModo = m_CatalogoShortcodes.MODO_SEPARADOR Or oFila.sModo = m_CatalogoShortcodes.MODO_SEPARADOR_VALOR Then
    If sSeleccion <> "" Then
      m_Sonido.sonar("Warning")
      Message.Warning("«" & oFila.sEtiqueta & "» no se aplica sobre texto." & gb.NewLine & gb.NewLine &
        "Quite la selección y ubique el cursor en una línea vacía.")
      FMain.txtEditorProyecto.SetFocus()
      Return
    Endif
    If Not m_EditorPrincipal.CursorEnLineaVaciaAlInicio() Then
      m_Sonido.sonar("Warning")
      Message.Warning("«" & oFila.sEtiqueta & "» va en una línea propia." & gb.NewLine & gb.NewLine &
        "Ubique el cursor al principio de una línea vacía, entre dos párrafos.")
      FMain.txtEditorProyecto.SetFocus()
      Return
    Endif
    iInicio = m_EditorPrincipal.InicioSeleccion()
    sTexto = m_EditorPrincipal.Texto()
    ' LA LÍNEA DEL VALOR, CON SU LÍNEA EN BLANCO: SIN ELLA EL ANCLA SE LEE
    ' COMO TEXTO DEL VALOR (SC-33)
    sContenido = ""
    If oFila.sModo = m_CatalogoShortcodes.MODO_SEPARADOR_VALOR Then
      sContenido = m_Constantes.SNIPPET_MARCADOR & Chr(10) & Chr(10)
    Endif
    ' EL BLOQUE: APERTURA, LÍNEA EN BLANCO, VALOR SI LO HAY, ANCLA (SC-33) Y
    ' CIERRE; LAS LÍNEAS EN BLANCO QUE FALTEN ANTES Y DESPUÉS, COMO EN TODO BLOQUE
    sInsertar = oFila.sApertura & Chr(10) & Chr(10) & sContenido & AnclaCierre(oFila.sClase) & Chr(10) & oFila.sCierre
    sInsertar = SeparacionAntes(String.Left(sTexto, iInicio)) & sInsertar &
      SeparacionDespues(String.Mid(sTexto, iInicio + 1))
    If Not m_EditorPrincipal.Insertar(sInsertar) Then Return
    ' EL MARCADOR QUEDA SELECCIONADO PARA ESCRIBIR EL VALOR ENCIMA (SC-21).
    ' String.InStr CUENTA CARACTERES, COHERENTE CON Seleccionar (RC-GM-21)
    If oFila.sModo = m_CatalogoShortcodes.MODO_SEPARADOR_VALOR Then
      iMarca = String.InStr(sInsertar, m_Constantes.SNIPPET_MARCADOR)
      If iMarca > 0 Then m_EditorPrincipal.Seleccionar(iInicio + iMarca - 1, 1)
    Endif
    FMain.txtEditorProyecto.SetFocus()
    Return
  Endif

  If oFila.sModo = m_CatalogoShortcodes.MODO_ENVOLVER Or oFila.sModo = m_CatalogoShortcodes.MODO_DOS_PARTES Then
    If sSeleccion = "" Then
      m_Sonido.sonar("Warning")
      Message.Warning("Seleccione el texto al que quiere aplicar «" & oFila.sEtiqueta & "».")
      FMain.txtEditorProyecto.SetFocus()
      Return
    Endif
    sContenido = sSeleccion

    ' LAS LLAVES SON EL SEMÁFORO: LAS ESCRIBE QUIEN MARCA, ANTES (SC-35). EL
    ' FILTRO dos-partes.lua REPITE EL CONTROL AL GENERAR
    If oFila.sModo = m_CatalogoShortcodes.MODO_DOS_PARTES Then
      sMotivo = ProblemaDosPartes(sSeleccion)
      If sMotivo <> "" Then
        m_Sonido.sonar("Warning")
        Message.Warning("«" & oFila.sEtiqueta & "» necesita el texto en dos partes entre llaves:" & gb.NewLine & gb.NewLine &
          "{primera parte}{segunda parte}" & gb.NewLine & gb.NewLine &
          "La segunda puede quedar vacía: {texto}{}" & gb.NewLine & gb.NewLine &
          "En la selección " & sMotivo & ".")
        FMain.txtEditorProyecto.SetFocus()
        Return
      Endif
      ' SIN BLANCOS EN LOS BORDES: UN SALTO SELECCIONADO DE MÁS NO ENTRA AL BLOQUE
      sContenido = Trim(sSeleccion)
    Endif
  Else
    ' PLANTILLA: NO ENVUELVE; SI HAY SELECCIÓN, SE CONFIRMA QUE SE REEMPLAZA
    If sSeleccion <> "" Then
      m_Sonido.sonar("Warning")
      If Message.Question("«" & oFila.sEtiqueta & "» no envuelve texto." & gb.NewLine & gb.NewLine &
          "El texto seleccionado será reemplazado. ¿Continuar?", "Sí", "No") <> 1 Then
        FMain.txtEditorProyecto.SetFocus()
        Return
      Endif
    Endif
    sContenido = m_Constantes.SNIPPET_MARCADOR
  Endif

  ' --- 4. TEXTO A INSERTAR ---
  ' EL TRAMO SE TOMA ANTES: ES LO QUE SE REEMPLAZA
  iInicio = m_EditorPrincipal.InicioSeleccion()
  iLargo = m_EditorPrincipal.LargoSeleccion()

  If oFila.sTipo = m_CatalogoShortcodes.TIPO_BLOQUE Then
    ' LÍNEA EN BLANCO ANTES DEL ANCLA: SIN ELLA PANDOC LA LEE COMO TEXTO (SC-33)
    sInsertar = oFila.sApertura & Chr(10) & Chr(10) & sContenido & Chr(10) & Chr(10) &
      AnclaCierre(oFila.sClase) & Chr(10) & oFila.sCierre
    ' UN BLOQUE PEGADO A UN PÁRRAFO NO ES UN BLOQUE: PANDOC LO LEE COMO TEXTO
    ' DEL PÁRRAFO, SIN AVISO (MEDIDO). SE AGREGAN LAS LÍNEAS EN BLANCO QUE FALTEN
    sTexto = m_EditorPrincipal.Texto()
    sInsertar = SeparacionAntes(String.Left(sTexto, iInicio)) & sInsertar &
      SeparacionDespues(String.Mid(sTexto, iInicio + iLargo + 1))
  Else
    sInsertar = oFila.sApertura & sContenido & oFila.sCierre
  Endif

  ' --- 5. INSERCIÓN: REEMPLAZA LA SELECCIÓN Y CONSERVA EL DESHACER ---
  If Not m_EditorPrincipal.Insertar(sInsertar) Then Return

  ' --- 6. PLANTILLA: EL MARCADOR QUEDA SELECCIONADO (SC-21) ---
  ' String.InStr CUENTA CARACTERES, COHERENTE CON Seleccionar (RC-GM-21)
  If oFila.sModo = m_CatalogoShortcodes.MODO_PLANTILLA Then
    iMarca = String.InStr(sInsertar, m_Constantes.SNIPPET_MARCADOR)
    If iMarca > 0 Then m_EditorPrincipal.Seleccionar(iInicio + iMarca - 1, 1)
  Endif

  ' --- 7. FOCO AL EDITOR (RC-GM-07) ---
  FMain.txtEditorProyecto.SetFocus()

End

' ==============================================================================
' Función   : ProblemaDosPartes
' Propósito : Controla que un texto tenga la forma {primera}{segunda}: las
'             llaves de afuera delimitan, las de adentro (balanceadas) son
'             texto. Es la misma regla que dos-partes.lua (SC-35)
' Parámetros: sTexto As String — la selección
' Retorna   : String — vacío si la forma es correcta; si no, qué falla,
'             redactado para seguir a «En la selección »
' ==============================================================================
Private Function ProblemaDosPartes(sTexto As String) As String

  Dim sLimpio As String
  Dim sCar As String
  Dim iPos As Integer
  Dim iNivel As Integer
  Dim iPartes As Integer
  Dim iInicioParte As Integer
  Dim aPartes As New String[]
  Dim aLineas As String[]

  ' --- 1. LOS BORDES ---
  sLimpio = Trim(sTexto)
  If Left(sLimpio, 1) <> "{" Then Return "falta la llave de apertura al principio"
  If Right(sLimpio, 1) <> "}" Then Return "falta la llave de cierre al final"

  ' --- 2. RECORRIDO CONTANDO LLAVES ---
  ' POR BYTES: { Y } SON ASCII, Y NINGÚN BYTE DE UN CARÁCTER UTF-8 MULTIBYTE
  ' COINCIDE CON ELLOS
  For iPos = 1 To Len(sLimpio)
    sCar = Mid(sLimpio, iPos, 1)
    If sCar = "{" Then
      Inc iNivel
      If iNivel = 1 Then
        If iPartes = 2 Then Return "hay más de dos partes"
        Inc iPartes
        iInicioParte = iPos + 1
      Endif
    Else If sCar = "}" Then
      If iNivel = 0 Then Return "hay una llave de cierre sin su apertura"
      Dec iNivel
      If iNivel = 0 Then
        aPartes.Add(Mid(sLimpio, iInicioParte, iPos - iInicioParte))
      Endif
    Else If iNivel = 0 Then
      ' FUERA DE LAS LLAVES NO HAY NADA: ENTRE LAS DOS PARTES, NI UN ESPACIO
      If iPartes = 1 Then Return "las dos partes no van pegadas: tiene que quedar }{"
      Return "hay texto fuera de las llaves"
    Endif
  Next

  ' --- 3. RESULTADO ---
  If iNivel <> 0 Then Return "hay una llave de apertura sin cerrar"
  If aPartes.Count <> 2 Then Return "no hay dos partes"
  If Trim(aPartes[0]) = "" Then Return "la primera parte está vacía"
  ' UNA LÍNEA EN BLANCO ADENTRO ABRE OTRO PÁRRAFO, Y LA SEGUNDA PARTE ES UNO
  ' SOLO: <attribution> Y <attrib> SOLO ADMITEN TEXTO EN LÍNEA
  aLineas = Split(aPartes[1], "\n")
  For iPos = 1 To aLineas.Max - 1
    If Trim(aLineas[iPos]) = "" Then Return "la segunda parte tiene más de un párrafo"
  Next

  Return ""

End

' ==============================================================================
' Función   : SeparacionAntes
' Propósito : Los saltos que faltan para que un bloque empiece después de
'             una línea en blanco
' Parámetros: sAntes As String — el texto anterior al punto de inserción
' Retorna   : String — "", un salto o dos
' ==============================================================================
Private Function SeparacionAntes(sAntes As String) As String

  ' --- 1. PRINCIPIO DEL DOCUMENTO O YA HAY LÍNEA EN BLANCO ---
  If sAntes = "" Then Return ""
  If String.Right(sAntes, 2) = Chr(10) & Chr(10) Then Return ""

  ' --- 2. AL PRINCIPIO DE UNA LÍNEA FALTA UNO; A MITAD DE LÍNEA, DOS ---
  If String.Right(sAntes, 1) = Chr(10) Then Return Chr(10)
  Return Chr(10) & Chr(10)

End

' ==============================================================================
' Función   : SeparacionDespues
' Propósito : Los saltos que faltan para que después de un bloque haya una
'             línea en blanco
' Parámetros: sDespues As String — el texto posterior al tramo reemplazado
' Retorna   : String — "", un salto o dos
' ==============================================================================
Private Function SeparacionDespues(sDespues As String) As String

  ' --- 1. FIN DEL DOCUMENTO O YA HAY LÍNEA EN BLANCO ---
  If sDespues = "" Then Return ""
  If String.Left(sDespues, 2) = Chr(10) & Chr(10) Then Return ""

  ' --- 2. SI SIGUE UN SALTO FALTA UNO; SI SIGUE TEXTO, DOS ---
  If String.Left(sDespues, 1) = Chr(10) Then Return Chr(10)
  Return Chr(10) & Chr(10)

End
