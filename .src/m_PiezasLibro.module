' Gambas module file

' ==========================================================
' MÓDULO    : m_PiezasLibro
' PROPÓSITO : La matriz editorial de las piezas del libro: qué lleva cada
'             salida y cómo se resuelve cada pieza en cada una. Es el ÚNICO
'             lugar donde está escrita. La consultan el manifiesto del
'             canónico, el EPUB y el PDF; ninguno debe tener su propia lista
'             de tipos escrita a mano.
'
' POR QUÉ UNA MATRIZ Y NO UN «VA / NO VA»
' ----------------------------------------------------------
'   Cada salida es una edición, no una copia del PDF en otro formato. Una
'   misma pieza puede existir en las tres y resolverse de tres maneras: el
'   colofón es una página en el EPUB, un entorno de LaTeX en el PDF y parte
'   de la plantilla en el HTML, donde no ocupa lugar en la secuencia.
'
' PIEZAS CON CUERPO Y SIN CUERPO
' ----------------------------------------------------------
'   Una pieza con cuerpo tiene .md y canónico, y va en todas las salidas desde
'   su canónico. Las piezas sin cuerpo —índices, listas, bibliografía,
'   colofón— no tienen .md ni canónico: las produce cada salida a su modo, o
'   no las produce. Sin cuerpo no significa sin contenido: significa derivada.
'
' LA CONDICIÓN DE LOS ÍNDICES
' ----------------------------------------------------------
'   En EPUB y HTML los índices se omiten PORQUE NO TIENEN ENLACES. Un índice
'   de páginas en un formato refluible es un artefacto falso, y la búsqueda
'   del lector o del navegador lo reemplaza con ventaja. No es «no aplica»:
'   es «no se hace todavía». Si algún día se construyen índices con enlaces,
'   esta es la fila que cambia.
'
' UN TIPO NUEVO
' ----------------------------------------------------------
'   Un tipo que no está en esta matriz se trata como pieza con cuerpo, que es
'   el caso común —capítulo, prólogo, introducción—. Si en realidad no tiene
'   cuerpo, el ensamblado lo va a pedir como canónico y va a fallar diciendo
'   qué archivo falta. Es un fallo ruidoso a propósito: el remedio es agregar
'   la fila acá.
' ==========================================================

' SALIDAS
Public Const SALIDA_PDF As String = "pdf"
Public Const SALIDA_EPUB As String = "epub"
Public Const SALIDA_HTML As String = "html"

' TRATAMIENTOS DE UNA PIEZA EN UNA SALIDA
' LA PIEZA TIENE .md Y CANÓNICO: LA SALIDA LA TOMA DE SU CANÓNICO
Public Const TRATAMIENTO_CUERPO As Integer = 1
' LA COMPONE LA HERRAMIENTA DE LA SALIDA: LaTeX, biblatex. LA SALIDA SOLO
' EMITE EL COMANDO
Public Const TRATAMIENTO_COMPUESTA As Integer = 2
' LA SALIDA LA CONSTRUYE A PARTIR DEL CANÓNICO O DE LA BASE
Public Const TRATAMIENTO_DERIVADA As Integer = 3
' EL 4 ERA TRATAMIENTO_SHORTCODE, RESERVADO PARA LA AUTORÍA EN LA APERTURA
' DE CAPÍTULO. SE RETIRÓ: ESA AUTORÍA SALE DE LA BASE, COMO EL FOLIO
' (m_GenerarPDFLibro.AutoriaApertura). EL NÚMERO NO SE REUSA.
' SE INTEGRA EN LA PLANTILLA COMO PIE DE PÁGINA: NO OCUPA LUGAR EN LA
' SECUENCIA DE PIEZAS
Public Const TRATAMIENTO_PIE As Integer = 5
' NO VA EN ESA SALIDA
Public Const TRATAMIENTO_OMITIDA As Integer = 6

' ============================================
' Función   : TieneCuerpo
' Propósito : Responde si una pieza tiene .md y canónico propio. Es lo que
'             decide si entra en el manifiesto del canónico del libro.
' Parámetros: sTipo As String — capitulos.tipo_capitulo
' Retorna   : Boolean — False para las piezas sin cuerpo de la matriz; True
'             para cualquier otro tipo, incluido uno desconocido
' ============================================
Public Function TieneCuerpo(sTipo As String) As Boolean

  Select Case sTipo
    Case "indice_onomastico", "indice_concepto", "indice_autores"
      Return False
    Case "lista_figuras", "lista_tablas"
      Return False
    Case "bibliografia", "colofon"
      Return False
      ' LAS PRIMERAS SALEN DE LA BASE (SC-25)
    Case "portadilla", "portada", "creditos"
      Return False
  End Select

  Return True

End

' ============================================
' Función   : Tratamiento
' Propósito : Cómo se resuelve una pieza en una salida. Es la matriz editorial.
' Parámetros: sTipo As String — capitulos.tipo_capitulo
'             sSalida As String — una de las constantes SALIDA_*
' Retorna   : Integer — una de las constantes TRATAMIENTO_*
' ============================================
Public Function Tratamiento(sTipo As String, sSalida As String) As Integer

  ' --- 1. SALIDA VÁLIDA ---
  ' UNA SALIDA DESCONOCIDA ES UN ERROR DE PROGRAMACIÓN, NO UN DATO: SE LEVANTA
  ' PARA QUE SE VEA DONDE SE PRODUJO Y NO LEJOS DE AHÍ (GV-23)
  If sSalida <> SALIDA_PDF And sSalida <> SALIDA_EPUB And sSalida <> SALIDA_HTML Then
    Error.Raise("m_PiezasLibro.Tratamiento: salida desconocida «" & sSalida & "»")
  Endif

  ' --- 2. PIEZAS CON CUERPO: IGUAL EN TODAS LAS SALIDAS ---
  If TieneCuerpo(sTipo) Then Return TRATAMIENTO_CUERPO

  ' --- 3. PIEZAS SIN CUERPO: LA MATRIZ ---
  Select Case sTipo

      ' ÍNDICES: SIN ENLACES NO VAN EN LAS SALIDAS DIGITALES. VER LA CONDICIÓN
      ' EN EL ENCABEZADO DEL MÓDULO
    Case "indice_onomastico", "indice_concepto", "indice_autores"
      If sSalida = SALIDA_PDF Then Return TRATAMIENTO_COMPUESTA
      Return TRATAMIENTO_OMITIDA

      ' LISTAS DE FIGURAS Y TABLAS: SOLO EN EL IMPRESO
    Case "lista_figuras", "lista_tablas"
      If sSalida = SALIDA_PDF Then Return TRATAMIENTO_COMPUESTA
      Return TRATAMIENTO_OMITIDA

      ' BIBLIOGRAFÍA: biblatex EN EL PDF; EN LAS DIGITALES SALE DEL CANÓNICO,
      ' QUE LA TRAE POR CAPÍTULO O CONSOLIDADA SEGÚN lugar_bibliografia
    Case "bibliografia"
      If sSalida = SALIDA_PDF Then Return TRATAMIENTO_COMPUESTA
      Return TRATAMIENTO_DERIVADA

      ' COLOFÓN: ENTORNO gbcolofon CON DATOS DE LA BASE EN EL PDF, PÁGINA PROPIA
      ' EN EL EPUB, PIE DE PÁGINA EN EL HTML
    Case "colofon"
      If sSalida = SALIDA_HTML Then Return TRATAMIENTO_PIE
      Return TRATAMIENTO_DERIVADA

      ' PRIMERAS (SC-25). EN EL PDF, MACROS CON DATOS DE LA BASE. EN EL EPUB,
      ' LA PORTADILLA NO VA —EN UN FORMATO REFLUIBLE REPITE LA PORTADA— Y LA
      ' PORTADA Y LOS CRÉDITOS SON PÁGINAS PROPIAS. EN EL HTML LAS REEMPLAZA
      ' LA PÁGINA DE ENTRADA.
    Case "portadilla"
      If sSalida = SALIDA_PDF Then Return TRATAMIENTO_DERIVADA
      Return TRATAMIENTO_OMITIDA

    Case "portada", "creditos"
      If sSalida = SALIDA_HTML Then Return TRATAMIENTO_OMITIDA
      Return TRATAMIENTO_DERIVADA

  End Select

  ' NO SE LLEGA ACÁ: TODO TIPO SIN CUERPO TIENE SU CASO ARRIBA. SI SE AGREGA
  ' UNO A TieneCuerpo Y NO A ESTA MATRIZ, SE LEVANTA EL ERROR
  Error.Raise("m_PiezasLibro.Tratamiento: el tipo «" & sTipo & "» no tiene cuerpo y no está en la matriz")

End

' ============================================
' Función   : ProblemaPosicion
' Propósito : Comprueba que una pieza esté numerada donde su tipo lo exige.
'             Hoy, una sola regla: la dedicatoria va en el espacio reservado
'             de preliminares, fm-00 a fm-09. Ahí el PDF la compone como
'             página suelta —sin título, sin folio, fuera del sumario— y antes
'             del sumario, como pide la tradición editorial.
'             La usan el ABM, al guardar, y el generador del PDF, antes de
'             escribir nada: la misma regla en los dos lugares.
' Parámetros: sNombre As String — capitulos.nombre_archivo
'             sTipo As String — capitulos.tipo_capitulo
' Retorna   : String — vacío si la posición es válida; si no, el mensaje que
'             explica qué está mal y cómo corregirlo
' ============================================
Public Function ProblemaPosicion(sNombre As String, sTipo As String) As String

  ' --- 1. INICIALIZACIÓN ---
  Dim sNom As String
  Dim bBien As Boolean

  sNom = LCase(Trim(sNombre))

  ' --- 2. SIN NOMBRE NO HAY POSICIÓN QUE CONTROLAR ---
  ' EL ABM PERMITE GUARDAR UNA PIEZA ANTES DE ELEGIR SU ARCHIVO, Y LAS
  ' SALIDAS LA EXCLUYEN (nombre_archivo IS NOT NULL)
  If sNom = "" Then Return ""

  ' --- 3. LA DEDICATORIA: fm-00 A fm-09 ---
  If LCase(Trim(sTipo)) = "dedicatoria" Then
    ' GV-12: NADA DE Not DELANTE DE Begins
    bBien = False
    If sNom Begins "fm-" Then bBien = m_OrdenPiezas.EnEspacioReservado(sNom)
    If bBien Then Return ""
    Return "La dedicatoria «" & sNombre & "» tiene que numerarse entre fm-00 " &
      "y fm-09, después de las primeras." & gb.NewLine &
      "Ese espacio es el de las piezas sueltas: sale sin título, en su propia " &
      "página y antes del sumario." & gb.NewLine &
      "Renombrá el archivo, por ejemplo fm-04-dedicatoria.md, y volvé a " &
      "elegirlo en la ficha de la pieza."
  Endif

  Return ""

End

' ============================================
' Función   : ProblemaCodigoRepetido
' Propósito : Busca piezas del libro con el mismo código de posición
'             («bm-20-indice-autores» y «bm-20-referencias» comparten bm-20).
'             Con el código repetido el orden lo decide el resto del nombre,
'             alfabéticamente, y no el número: puede salir bien por
'             casualidad (SC-55, CÓDIGOS REPETIDOS).
'             Vale para todo el libro: preliminares, cuerpo y finales.
' Parámetros: iIdLibro As Integer — libros_md.id_libro
' Retorna   : String — vacío si no hay repetidos o si la consulta falla; si
'             no, el mensaje con TODOS los códigos repetidos y sus piezas
' Nota      : EL CÓDIGO SALE DE m_OrdenPiezas.ExpresionCodigo, LA MISMA
'             DEFINICIÓN QUE USAN LAS GRILLAS: NO SE REESCRIBE EN GAMBAS.
'             UN FALLO DE LECTURA DEVUELVE VACÍO: LOS GENERADORES LEEN LA
'             MISMA TABLA Y FALLAN CON SU PROPIO MENSAJE.
' ============================================
Public Function ProblemaCodigoRepetido(iIdLibro As Integer) As String

  ' --- 1. INICIALIZACIÓN ---
  Dim hRepetidos As Result
  Dim sLista As String

  ' --- 2. LOS CÓDIGOS CON MÁS DE UNA PIEZA ---
  ' EL ALIAS EN GROUP BY LO ADMITE MySQL (MANUAL 8.0, B.3.4.4, «PROBLEMS WITH
  ' COLUMN ALIASES»). PROBADO EN MySQL 8.0.46 CON ONLY_FULL_GROUP_BY
  Try hRepetidos = m_ConexionBD.mConn.Exec(
    "SELECT " & m_OrdenPiezas.ExpresionCodigo("nombre_archivo") & " AS codigo, " &
    "GROUP_CONCAT(nombre_archivo ORDER BY nombre_archivo SEPARATOR ', ') AS piezas " &
    "FROM capitulos " &
    "WHERE id_libro = &1 AND nombre_archivo IS NOT NULL " &
    "GROUP BY codigo HAVING COUNT(*) > 1 " &
    "ORDER BY codigo", iIdLibro)
  If Error Then Return ""

  ' --- 3. UNA LÍNEA POR CÓDIGO REPETIDO ---
  ' SE LISTAN TODOS Y NO SOLO EL PRIMERO: RENUMERAR UNO PUEDE CHOCAR CON OTRO
  For Each hRepetidos
    sLista &= "    " & hRepetidos["codigo"] & ":  " & hRepetidos["piezas"] & gb.NewLine
  Next

  If sLista = "" Then Return ""

  ' --- 4. EL MENSAJE ---
  Return "Hay piezas con el mismo código de posición:" & gb.NewLine & gb.NewLine &
    sLista & gb.NewLine &
    "Con el código repetido, el orden lo decide el resto del nombre y no el " &
    "número. Renombrá los archivos para que cada código sea único y volvé a " &
    "elegirlos en la ficha de cada pieza."

End

' ============================================
' Función   : ProblemaOrdenFinales
' Propósito : Comprueba el orden relativo de las piezas de finales que, mal
'             ubicadas, dan un libro equivocado sin que nada falle (SC-55):
'             R1  ningún índice antes de la pieza bibliografia
'             R2  bibliografía consolidada con índices: la pieza bibliografia
'                 tiene que estar declarada
'             R3  el colofón declarado es la última pieza
'             Es una regla del LIBRO, no de una pieza: por eso no está en
'             ProblemaPosicion. El generador del PDF frena con ella; el ABM
'             solo avisa, porque al renumerar hay estados intermedios
'             inválidos que no se pueden evitar.
' Parámetros: aNombre As String[] — nombre_archivo de las piezas, en el orden
'             del libro (m_OrdenPiezas.ClausulaOrden)
'             aTipo As String[] — tipo_capitulo, paralelo a aNombre
'             bConsolidada As Boolean — lugar_bibliografia = 'consolidada'
' Retorna   : String — vacío si el orden es válido; si no, el mensaje del
'             PRIMER problema, con qué está mal y cómo corregirlo
' Nota      : NO CONTROLA glosario, sobre_autores NI cronologia: SU LUGAR ES
'             CUESTIÓN DE TRADICIÓN EDITORIAL, NO UN ERROR (SC-55).
' ============================================
Public Function ProblemaOrdenFinales(aNombre As String[], aTipo As String[], bConsolidada As Boolean) As String

  ' --- 1. INICIALIZACIÓN ---
  Dim i As Integer
  Dim iBibliografia As Integer = -1
  Dim iPrimerIndice As Integer = -1
  Dim iColofon As Integer = -1

  ' --- 2. RECORRIDO: LA PRIMERA APARICIÓN DE CADA TIPO ---
  ' SI HAY MÁS DE UNA BIBLIOGRAFÍA MANDA LA PRIMERA, COMO EN EL EPUB
  ' (m_GenerarEpubLibro, $iPosBibliografia)
  For i = 0 To aTipo.Max
    Select Case LCase(Trim(aTipo[i]))
      Case "bibliografia"
        If iBibliografia = -1 Then iBibliografia = i
      Case "indice_onomastico", "indice_concepto", "indice_autores"
        If iPrimerIndice = -1 Then iPrimerIndice = i
      Case "colofon"
        If iColofon = -1 Then iColofon = i
    End Select
  Next

  ' --- 3. R1: LA BIBLIOGRAFÍA ANTES QUE LOS ÍNDICES ---
  ' IFS ANIDADOS: And NO CORTOCIRCUITA (RC-GM-17)
  If iBibliografia >= 0 Then
    If iPrimerIndice >= 0 Then
      If iPrimerIndice < iBibliografia Then
        Return "El índice «" & aNombre[iPrimerIndice] & "» está antes que la " &
          "bibliografía «" & aNombre[iBibliografia] & "»." & gb.NewLine &
          "Los índices van después de la bibliografía. Renumerá los archivos: " &
          "por ejemplo, bm-20-referencias y bm-21-indice-autores."
      Endif
    Endif
  Endif

  ' --- 4. R2: CONSOLIDADA CON ÍNDICES, LA PIEZA TIENE QUE ESTAR DECLARADA ---
  ' SIN PIEZA, EL GENERADOR PONE LA BIBLIOGRAFÍA AL FINAL, DESPUÉS DE TODAS LAS
  ' PIEZAS DECLARADAS: LOS ÍNDICES QUEDARÍAN ANTES. SIN ÍNDICES, ESE RESPALDO
  ' DA EL ORDEN CORRECTO Y NO SE EXIGE NADA
  If bConsolidada Then
    If iBibliografia = -1 Then
      If iPrimerIndice >= 0 Then
        Return "El libro tiene bibliografía consolidada e índices, pero no " &
          "tiene declarada la pieza de bibliografía." & gb.NewLine &
          "Sin ella, la bibliografía saldría después del índice «" &
          aNombre[iPrimerIndice] & "». Declará una pieza de tipo bibliografia " &
          "numerada antes de los índices."
      Endif
    Endif
  Endif

  ' --- 5. R3: EL COLOFÓN ES LA ÚLTIMA PIEZA ---
  If iColofon >= 0 Then
    If iColofon < aTipo.Max Then
      Return "El colofón «" & aNombre[iColofon] & "» no es la última pieza: " &
        "después viene «" & aNombre[iColofon + 1] & "»." & gb.NewLine &
        "El colofón cierra el libro. Numeralo después de todas las demás, " &
        "por ejemplo bm-99-colofon."
    Endif
  Endif

  Return ""

End

' ============================================
' Función   : VaEnIndice
' Propósito : Dice si una pieza tiene entrada en el índice de la salida
'             digital: el nav del EPUB y el índice de la página de entrada del
'             HTML. Replica el PDF (SC-31): la dedicatoria no entra al sumario.
' Parámetros: sTipo As String — capitulos.tipo_capitulo
' Retorna   : Boolean — False para la dedicatoria; True para el resto
' Nota      : EL HTML NO LLAMA ESTA FUNCIÓN: docbook-to-html.xsl LEE EL MISMO
'             DATO DEL MANIFIESTO (@tipo_capitulo). SI CAMBIA LA REGLA, CAMBIA
'             EN LOS DOS LUGARES.
' ============================================
Public Function VaEnIndice(sTipo As String) As Boolean

  Select Case LCase(Trim(sTipo))
    Case "dedicatoria"
      Return False
  End Select

  Return True

End

' ============================================
' Función   : ColofonDigital
' Propósito : El texto del colofón de las salidas digitales —EPUB y HTML—, que
'             es el mismo en las dos. Es la ÚNICA copia de ese texto: el EPUB lo
'             usa para su página y el HTML para el pie, que lee de un archivo
'             que escribe m_GenerarSalidasLibro.
'
'             El colofón del PDF NO sale de acá: vive en la plantilla LaTeX, que
'             es donde se eligen las familias tipográficas que nombra, y toma la
'             versión de \gbversion. Las digitales no nombran tipografías: en un
'             formato refluible el lector la cambia. Si se cambia la redacción
'             de uno, revisar el otro.
'
'             Sin fecha de generación, igual que el PDF: dos generaciones sin
'             cambios en los datos tienen que dar el mismo resultado.
' Parámetros: (ninguno)
' Retorna   : String — el CONTENIDO del párrafo, en XHTML y ya escapado, sin
'             la etiqueta <p>: cada salida pone su propio envoltorio
' ============================================
Public Function ColofonDigital() As String

  Dim sUrl As String

  sUrl = "https://github.com/albertomoyano/gbpublisher"

  Return "La composición de este libro se realizó con gbpublisher versión " &
    Application.Version & ", bajo un modelo de fuente única que garantiza la " &
    "trazabilidad entre el original y cada una de sus salidas (HTML, ePub y PDF). " &
    "El proyecto se encuentra disponible en <a href=" & Chr(34) & sUrl & Chr(34) & ">" &
    sUrl & "</a>."

End
