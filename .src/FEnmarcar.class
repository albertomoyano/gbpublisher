' Gambas class file

' ==============================================================================
' Formulario: FEnmarcar
' ------------------------------------------------------------------------------
' Diálogo de btnEnmarcar: pide el par de signos con que se enmarca la selección.
' Uso: llamar a ShowModal, que devuelve 1 si se aceptó; el índice del par queda
' en m_Enmarcar.iParElegido. NO EN UNA VARIABLE Public DEL FORM: NO SOBREVIVE
' AL CIERRE (RC-GM-13).
' LA TABLA DE PARES ESTÁ EN m_Enmarcar.Par: ESTE FORM SOLO MUESTRA SUS ETIQUETAS.
' ==============================================================================

' ==============================================================================
' Función   : Form_Open
' Propósito : Prepara el diálogo: llena el combo y lo deja en el último par
'             usado en la sesión
' Parámetros: ninguno
' Retorna   : nada
' ==============================================================================
Public Sub Form_Open()

  Dim iIndice As Integer

  ' --- 1. ESTADO: CADA APERTURA EMPIEZA SIN RESPUESTA ---
  m_Enmarcar.iParElegido = -1

  ' --- 2. COMBO: LAS ETIQUETAS DE LA TABLA, EN SU ORDEN ---
  cmbPar.Clear
  For iIndice = 0 To m_Enmarcar.CantidadPares() - 1
    cmbPar.Add(m_Enmarcar.Par(iIndice)[0])
  Next

  ' ENMARCAR VARIAS VECES SEGUIDAS CON EL MISMO PAR ES UN ENTER
  cmbPar.Index = m_Enmarcar.iUltimoPar

  cmbPar.SetFocus()

End

' ==============================================================================
' Función   : btnAceptar_Click
' Propósito : Devuelve el par elegido y lo recuerda para la próxima vez
' Parámetros: ninguno
' Retorna   : nada
' ==============================================================================
Public Sub btnAceptar_Click()

  ' LOS DATOS AL MÓDULO, LA DECISIÓN COMO VALOR (RC-GM-13)
  m_Enmarcar.iParElegido = cmbPar.Index
  m_Enmarcar.iUltimoPar = cmbPar.Index
  Me.Close(1)

End

' ==============================================================================
' Función   : btnCancelar_Click
' Propósito : Cierra sin respuesta
' Parámetros: ninguno
' Retorna   : nada
' ==============================================================================
Public Sub btnCancelar_Click()

  Me.Close(0)

End
