' Gambas class file

' ==========================================================
' FORMULARIO : FPedirNombre
' PROPÓSITO  : Pide el nombre de un archivo o de una carpeta, para crearlo o
'              renombrarlo.
'              Se abre solo desde m_FileManager.PedirNombre, que fija los
'              parámetros antes de ShowModal y recibe el nombre por
'              m_FileManager.NombreElegido (RC-GM-13).
' VALIDACIÓN : al aceptar, no por tecla: así también se controla lo pegado.
'              El motivo se muestra en lblAviso y el formulario sigue abierto.
' ==========================================================

' ============================================
' Función   : Form_Open
' Propósito : Carga la indicación, el título y el texto inicial
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub Form_Open()

  ' --- 1. TEXTOS QUE FIJÓ m_FileManager.PedirNombre ---
  Me.Text = m_FileManager.PedirTitulo
  lblIndicacion.Text = m_FileManager.PedirTitulo
  lblAviso.Text = ""
  txtNombre.Text = m_FileManager.PedirInicial

  ' --- 2. FOCO EN EL CAMPO, CON EL TEXTO SELECCIONADO ---
  ' AL RENOMBRAR, ESCRIBIR REEMPLAZA LA SUGERENCIA DE UNA VEZ
  txtNombre.SetFocus()
  txtNombre.SelectAll()

End

' ============================================
' Función   : Form_Show
' Propósito : Quita los botones del marco (SC-20). La salida es Cancelar o
'             la tecla Escape (btnCancelar.Cancel)
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub Form_Show()

  m_Ventana.FijarBotones(Me)

End

' ============================================
' Función   : btnAceptar_Click
' Propósito : Valida el nombre y, si es válido, lo devuelve por el módulo
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub btnAceptar_Click()

  ' --- 1. INICIALIZACIÓN ---
  Dim sNombre As String
  Dim sMotivo As String
  Dim sNombreActual As String

  sNombre = Trim(txtNombre.Text)

  ' --- 2. FORMA DEL NOMBRE, SEGÚN LA CARPETA DONDE VA A QUEDAR ---
  ' UN .md EN UNA CARPETA DE PIEZAS SIGUE LAS REGLAS DEL CONVERSOR
  sMotivo = m_FileManager.MotivoNombre(sNombre, m_FileManager.PedirEsCarpeta, m_FileManager.PedirDirectorio)
  If sMotivo <> "" Then
    MostrarAviso(sMotivo)
    Return
  Endif

  ' --- 3. QUE NO EXISTA YA ---
  ' AL RENOMBRAR, ACEPTAR EL MISMO NOMBRE NO ES UN CHOQUE: NO HACE NADA
  If m_FileManager.PedirRutaOriginal <> "" Then sNombreActual = File.Name(m_FileManager.PedirRutaOriginal)
  If sNombre <> sNombreActual Then
    If Exist(m_FileManager.PedirDirectorio &/ sNombre) Then
      MostrarAviso("Ya existe «" & sNombre & "» en esta carpeta.")
      Return
    Endif
  Endif

  ' --- 4. RETORNO ---
  ' EL NOMBRE POR EL MÓDULO Y LA DECISIÓN POR ShowModal (RC-GM-13)
  m_FileManager.NombreElegido = sNombre
  Me.Close(1)

End

' ============================================
' Función   : btnCancelar_Click
' Propósito : Cierra sin devolver nombre
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub btnCancelar_Click()

  Me.Close(0)

End

' ============================================
' Función   : MostrarAviso
' Propósito : Muestra el motivo del rechazo y devuelve el foco al campo
' Parámetros: sTexto As String — el motivo
' Retorna   : (Sub, sin retorno)
' ============================================
Private Sub MostrarAviso(sTexto As String)

  m_Sonido.sonar("Warning")
  lblAviso.Text = sTexto
  ' EL USUARIO SIGUE ESCRIBIENDO: EL FOCO VUELVE AL CAMPO (RC-GM-07)
  txtNombre.SetFocus()

End
