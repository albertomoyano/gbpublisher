' Gambas class file

' ============================================
' Clase     : CShortcodeCatalogo
' Propósito : Un shortcode del catálogo que exporta gbShortcodes
'             (_catalogo.tsv, RF-11). Es una clase y no una Collection
'             de campos: una Collection pierde la clave a la que se le
'             asigna "" (GV-68), y perfil viene vacío en la mayoría.
' ============================================

Public sNombre As String
Public sClase As String
Public sEtiqueta As String
Public sTipo As String
Public sGrupo As String
Public sPerfil As String
Public iOrden As Integer
Public sEstadoLibro As String
Public sEstadoRevista As String
Public sModo As String
Public sApertura As String
Public sCierre As String

' ============================================
' Función   : Estado
' Propósito : El estado del shortcode para el tipo de proyecto
' Parámetros: bLibro As Boolean — True libro, False revista
' Retorna   : String — no_aplica, borrador o liberado
' ============================================
Public Function Estado(bLibro As Boolean) As String

  If bLibro Then Return sEstadoLibro
  Return sEstadoRevista

End
