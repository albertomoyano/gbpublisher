' Gambas class file

' ============================================
' Clase     : CPalabraHallada
' Propósito : Representa una palabra extraída de un texto, con su ubicación.
'             Reemplaza el par (Collection posición→palabra + arrays paralelos)
'             que usaba m_Hunspell. Es la opción 2 de GV-24: una clase chica
'             cuando los datos tienen sentido juntos.
' ============================================

' TODAS LAS POSICIONES Y LONGITUDES SON EN CARACTERES (CODEPOINTS), NO EN BYTES.
' ES LA UNIDAD QUE USAN String.Mid / String.Len (SC-02) Y TAMBIÉN LA COLUMNA
' DEL TextEditor Y LA PROPIEDAD Pos DEL TextEdit, VERIFICADO 2026-09.

Public sPalabra As String       ' LA PALABRA, YA RECORTADA DE GUIONES Y APÓSTROFOS DE BORDE
Public iPosicion As Integer     ' POSICIÓN DE INICIO EN EL TEXTO, EN CARACTERES, BASE 1
Public iLongitud As Integer     ' LARGO DE LA PALABRA, EN CARACTERES

' ============================================
' Función   : _new
' Propósito : Constructor. Deja el objeto listo en una sola sentencia.
' Parámetros: sTexto As String — la palabra
'             iInicio As Integer — posición en caracteres, base 1
'             iLargo As Integer — largo en caracteres
' Retorna   : nada
' ============================================
' ATENCIÓN GV-32: UN New CON ARGUMENTOS NO PUEDE IR ANIDADO DENTRO DE OTRA
' LLAMADA. SIEMPRE ASIGNARLO A UNA VARIABLE PRIMERO Y DESPUÉS USARLA.

Public Sub _new(sTexto As String, iInicio As Integer, iLargo As Integer)

  sPalabra = sTexto
  iPosicion = iInicio
  iLongitud = iLargo

End
