' Gambas module file

' ============================================
' Módulo    : m_BuscarRegex
' Propósito : LADO GAMBAS DEL BUSCADOR POR EXPRESIONES REGULARES. Es dueño del
'             estado de la pestaña "regexp" de FMain; los handlers de FMain solo
'             delegan acá (patrón módulo-dueño-del-estado, como m_GestionImagenes
'             y m_RevisarPDF).
'
'             El motor real es el script perl engine/buscar_regex.pl. Este módulo
'             NUNCA aplica regex por su cuenta: arma la invocación, parsea la
'             salida y gobierna la UI. La división es la misma que con Saxon o
'             Pandoc: Gambas orquesta, el proceso externo procesa.
'
'             RESPONSABILIDADES:
'               - Resolver la ruta del script (instalación del sistema, no
'                 ~/.gbpublisher: el motor no se personaliza).
'               - Armar la whitelist de archivos del proyecto (ObtenerArchivosMD).
'               - Validación continua del patrón con debounce.
'               - btnProbar: banco de pruebas en seco sobre areaEditor.
'               - Gobernar el ámbito (los tres radiobutton + txtFiltrar).
'               - btnBuscarRegex: abrir FRegexResultados, que busca y reemplaza.
'               - La biblioteca de patrones en la interfaz (SC-51): combo,
'                 guardar, borrar, compartir e importar. Los datos y el formato
'                 viven en m_PatronesRegex; acá solo se gobierna la pestaña.
'
' Convención de nombres de controles en la pestaña (FMain):
'   rbProyecto rbEnCurso rbFiltrar   — ámbito (radiobutton)
'   txtFiltrar                       — filtro de archivos (solo con rbFiltrar)
'   cmbPatrones                      — biblioteca personal de patrones (SC-51)
'   btnGuardarPatron btnBorrarPatron btnCompartirPatron btnImportarPatrones
'   lblDescripcionPatron             — descripción y marca de modificado
'   txtBuscar txtReemplazo           — patrón y reemplazo
'   ckbCaseless ckbMultiline ckbDotAll ckbExtended — flags /i /m /s /x
'   btnProbar btnBuscarRegex         — acciones
'   areaEditor areaEditorMostrarResultado — banco de pruebas (TextArea)
' ============================================

' --- SEPARADOR DE AVISOS DEL VALIDADOR (debe coincidir con el .pl) ---
' Los campos del protocolo se separan con NUL (Chr(0)); dentro del campo de
' avisos, cada aviso se separa con este carácter (0x1F). El NUL se maneja con
' Chr(0) directamente en el parseo, por claridad.
Private Const SEP_LISTA As String = "\x1F"

' --- PREFIJOS DE ARCHIVO POR CARPETA (whitelist) ---
' front-matter → fm-  |  articulos → a-  |  back-matter → bm-
' El patrón completo exige prefijo + "-" + 2 dígitos + "-": fm-NN-, a-NN-, bm-NN-
' Un notas.md o un a-1.md (sin los dos dígitos) quedan fuera del proyecto.
Private Const PREFIJO_FRONT As String = "fm"
Private Const PREFIJO_ARTICULOS As String = "a"
Private Const PREFIJO_BACK As String = "bm"

' --- DEBOUNCE DE LA VALIDACIÓN CONTINUA ---
' Cada cambio en patrón/reemplazo/flags reinicia el timer; la validación
' dispara cuando el usuario deja de tipear DEMORA_VALIDACION ms. Evita lanzar
' un proceso perl por cada tecla.
Private Const DEMORA_VALIDACION As Integer = 300
Private $hTimerValidar As Timer

' --- ESTADO DE LA ÚLTIMA VALIDACIÓN ---
' Lo consumen btnBuscarRegex, btnProbar y btnGuardarPatron: solo con un patrón
' que compiló.
Private $bPatronValido As Boolean

' --- BIBLIOTECA DE PATRONES EN LA PESTAÑA (SC-51) ---
' Primer ítem del combo: trabajar sin patrón guardado. Los nombres válidos no
' llevan paréntesis ni espacios, así que no puede chocar con uno guardado.
Private Const TEXTO_PATRON_LIBRE As String = "(patrón libre)"
' Nombre del patrón cargado en los campos; "" = patrón libre.
Private $sPatronCargado As String
' Índice elegido en el combo, para reponerlo si el usuario cancela un cambio.
Private $iIndiceCombo As Integer
' Reponer el combo desde el código dispara Click al asignar Index (GV-53); la
' bandera hace que el handler no vuelva a cargar el patrón.
Private $bReponiendoCombo As Boolean

' ============================================
' Función   : RutaScript
' Propósito : DEVUELVE LA RUTA ABSOLUTA DEL MOTOR PERL. Vive en la instalación
'             del sistema (engine/), NO en ~/.gbpublisher: no es personalizable,
'             y así el script y este módulo viajan siempre en el mismo .deb, sin
'             posibilidad de quedar desincronizados.
' Retorna   : String — ruta al script
' ============================================
Private Function RutaScript() As String

  Return m_InicioCierre.RutaRecursos() &/ "engine" &/ "buscar_regex.pl"

End

' ============================================
' Función   : InicializarTabRegex
' Propósito : Prepara la pestaña al abrir un proyecto. La habilita solo si hay
'             archivos en disco: en modo parcial RutaProyectoEnCurso está vacía
'             (SC-06) y no hay nada que buscar. Se llama desde FMain.AbrirProyecto
'             junto a las demás Inicializar* (shortcodes, PDF, imágenes).
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub InicializarTabRegex()

  ' --- 1. CREAR EL TIMER DE DEBOUNCE UNA SOLA VEZ ---
  If IsNull($hTimerValidar) Then
    $hTimerValidar = New Timer As "TimerValidarRegex"
    $hTimerValidar.Delay = DEMORA_VALIDACION
  Endif
  $hTimerValidar.Stop

  ' --- 2. SIN PATRÓN CARGADO ---
  ' VA ANTES DE LIMPIAR LOS CAMPOS: CADA ASIGNACIÓN DISPARA _Change Y
  ' SolicitarValidacion CONSULTA ESTE ESTADO PARA LA MARCA DE MODIFICADO
  $sPatronCargado = ""

  ' --- 3. ÁMBITO POR DEFECTO: TODO EL PROYECTO ---
  FMain.rbProyecto.Value = True
  FMain.txtFiltrar.Text = ""
  FMain.txtFiltrar.Enabled = False

  ' --- 4. LIMPIAR ENTRADAS Y RESULTADO DEL BANCO DE PRUEBAS ---
  FMain.txtBuscar.Text = ""
  FMain.txtReemplazo.Text = ""
  FMain.areaEditor.Text = ""
  FMain.areaEditorMostrarResultado.Text = ""

  ' --- 5. FLAGS EN FALSO ---
  FMain.ckbCaseless.Value = False
  FMain.ckbMultiline.Value = False
  FMain.ckbDotAll.Value = False
  FMain.ckbExtended.Value = False

  ' --- 6. BIBLIOTECA: SE RELEE DEL DISCO EN CADA APERTURA (SC-51) ---
  ' ASÍ APARECE UN PATRÓN CORREGIDO CON UN EDITOR EXTERNO. SI LA LECTURA
  ' FALLA, m_PatronesRegex YA AVISÓ Y EL COMBO QUEDA SOLO CON EL PATRÓN LIBRE
  m_PatronesRegex.Cargar()
  PoblarComboPatrones("")

  ' --- 7. ESTADO INICIAL: SIN PATRÓN NO HAY NADA HABILITADO ---
  $bPatronValido = False
  FMain.btnProbar.Enabled = False
  FMain.btnBuscarRegex.Enabled = False
  FMain.btnGuardarPatron.Enabled = False
  ActualizarEstadoPatron()

End

' ============================================
' Función   : ObtenerArchivosMD
' Propósito : DEFINICIÓN ÚNICA DE "CUÁLES SON LOS ARCHIVOS DE CONTENIDO DEL
'             PROYECTO". Devuelve las rutas absolutas de los .md de front-matter,
'             articulos y back-matter que cumplen la nomenclatura, en orden
'             editorial. NO incluye el .md principal del proyecto ni toca la UI.
'             Es la whitelist del buscador: perl recibe exactamente esta lista y
'             no enumera el filesystem por su cuenta.
' Parámetros: (ninguno)
' Retorna   : String[] — rutas absolutas; orden: front-matter, articulos,
'             back-matter; alfabético dentro de cada carpeta. Vacío si no hay
'             proyecto con archivos (modo parcial o sin abrir).
' ============================================
Public Function ObtenerArchivosMD() As String[]

  Dim aResultado As New String[]

  ' --- 1. SIN ARCHIVOS EN DISCO NO HAY NADA QUE LISTAR ---
  If m_InicioCierre.RutaProyectoEnCurso = "" Then Return aResultado

  ' --- 2. RECORRER LAS TRES CARPETAS EN ORDEN EDITORIAL ---
  AcumularArchivosCarpeta(aResultado, "front-matter", PREFIJO_FRONT)
  AcumularArchivosCarpeta(aResultado, "articulos", PREFIJO_ARTICULOS)
  AcumularArchivosCarpeta(aResultado, "back-matter", PREFIJO_BACK)

  Return aResultado

End

' ============================================
' Función   : AcumularArchivosCarpeta
' Propósito : Agrega a la lista las rutas absolutas de los .md de una carpeta que
'             cumplen la nomenclatura prefijo-NN-*. Auxiliar de ObtenerArchivosMD.
' Parámetros: aDestino As String[] — lista donde acumular (se modifica)
'             sCarpeta As String — nombre de la subcarpeta del proyecto
'             sPrefijo As String — prefijo esperado (fm, a, bm)
' Retorna   : (Sub, sin retorno)
' ============================================
Private Sub AcumularArchivosCarpeta(aDestino As String[], sCarpeta As String, sPrefijo As String)

  Dim sRutaCarpeta As String
  Dim aArchivos As String[]
  Dim sArchivo As String

  ' --- 1. LA CARPETA PUEDE NO EXISTIR (PROYECTO INCOMPLETO) ---
  sRutaCarpeta = m_InicioCierre.RutaProyectoEnCurso &/ sCarpeta
  If Not Exist(sRutaCarpeta) Then Return

  ' --- 2. LISTAR .md Y ORDENAR ALFABÉTICO (= EDITORIAL CON NN DE DOS DÍGITOS) ---
  aArchivos = Dir(sRutaCarpeta, "*.md")
  If Not aArchivos Then Return
  aArchivos.Sort()

  ' --- 3. FILTRAR POR NOMENCLATURA Y ACUMULAR RUTA ABSOLUTA ---
  For Each sArchivo In aArchivos
    If CumpleNomenclatura(sArchivo, sPrefijo) Then
      aDestino.Add(sRutaCarpeta &/ sArchivo)
    Endif
  Next

End

' ============================================
' Función   : CumpleNomenclatura
' Propósito : Verifica que un nombre de archivo siga el patrón prefijo-NN-*.md:
'             el prefijo, un guion, exactamente dos dígitos, otro guion, y luego
'             lo que sea. Deja fuera notas.md, a-1-x.md, fm.md, etc.
'             Se resuelve con String.* (no gb.pcre): el nombre es corto y la
'             regla es fija, no hace falta un motor de regex para esto.
' Parámetros: sNombre As String — nombre de archivo (sin ruta)
'             sPrefijo As String — prefijo esperado
' Retorna   : Boolean
' ============================================
Private Function CumpleNomenclatura(sNombre As String, sPrefijo As String) As Boolean

  Dim sEsperado As String
  Dim sResto As String
  Dim iLargoPref As Integer

  ' --- 1. DEBE EMPEZAR CON "prefijo-" ---
  sEsperado = sPrefijo & "-"
  iLargoPref = String.Len(sEsperado)
  If String.Left(sNombre, iLargoPref) <> sEsperado Then Return False

  ' --- 2. DESPUÉS DEL PREFIJO: DOS DÍGITOS Y UN GUION ---
  ' sResto ARRANCA JUSTO DESPUÉS DE "prefijo-"
  sResto = String.Mid(sNombre, iLargoPref + 1)
  If String.Len(sResto) < 3 Then Return False
  If Not IsDigit(String.Mid(sResto, 1, 1)) Then Return False
  If Not IsDigit(String.Mid(sResto, 2, 1)) Then Return False
  If String.Mid(sResto, 3, 1) <> "-" Then Return False

  Return True

End

' ============================================
' Función   : ArchivoEnCursoEsBuscable
' Propósito : Indica si el archivo actualmente cargado en el editor
'             (m_InicioCierre.sRutaArchivoAbierto... via FMain) cumple la
'             whitelist. El .md principal del proyecto es el "cuaderno de notas"
'             del maquetador y NO es contenido editorial: queda fuera, igual que
'             cualquier notas.md. Por eso rbEnCurso se habilita solo cuando el
'             archivo en curso es un fm-/a-/bm- con nomenclatura -NN-.
' Retorna   : Boolean
' ============================================
Public Function ArchivoEnCursoEsBuscable() As Boolean

  Dim sRuta As String
  Dim sCarpeta As String
  Dim sNombre As String

  ' --- 1. RUTA DEL ARCHIVO EN EL EDITOR ---
  ' sRutaArchivoAbierto se mantiene actualizada en el _Click del combo con la
  ' ruta absoluta del archivo cargado.
  sRuta = FMain.sRutaArchivoAbierto
  If Trim(sRuta) = "" Then Return False
  If Not Exist(sRuta) Then Return False

  ' --- 2. LA CARPETA CONTENEDORA DEBE SER UNA DE LAS TRES ---
  ' El prefijo esperado depende de la carpeta: un a-01-*.md en front-matter no
  ' es válido. Se deriva el prefijo de la carpeta y se verifica la nomenclatura.
  sNombre = File.Name(sRuta)
  sCarpeta = File.Name(File.Dir(sRuta))

  Select Case sCarpeta
    Case "front-matter"
      Return CumpleNomenclatura(sNombre, PREFIJO_FRONT)
    Case "articulos"
      Return CumpleNomenclatura(sNombre, PREFIJO_ARTICULOS)
    Case "back-matter"
      Return CumpleNomenclatura(sNombre, PREFIJO_BACK)
    Default
      Return False
  End Select

End

' ============================================
' Función   : ResolverAmbito
' Propósito : Arma la lista de archivos sobre la que se va a buscar, según el
'             radiobutton de ámbito activo. Es el ÚNICO lugar donde el ámbito se
'             traduce a archivos concretos: FRegexResultados recibe la lista ya
'             hecha y no sabe de radios ni de filtros.
'               rbProyecto → toda la whitelist
'               rbFiltrar  → la whitelist filtrada por substring (sensible) sobre
'                            el nombre del archivo
'               rbEnCurso  → el archivo del editor, si es buscable (ya se validó
'                            al habilitar el radio, pero se revalida por las dudas)
' Retorna   : String[] — rutas absolutas; vacío si no hay nada que buscar
' ============================================
Public Function ResolverAmbito() As String[]

  Dim aTodos As String[]
  Dim aResultado As New String[]
  Dim sRuta As String
  Dim sFiltro As String

  ' --- 1. ARCHIVO EN CURSO: UN SOLO ELEMENTO ---
  If FMain.rbEnCurso.Value Then
    If ArchivoEnCursoEsBuscable() Then aResultado.Add(FMain.sRutaArchivoAbierto)
    Return aResultado
  Endif

  ' --- 2. LOS OTROS DOS MODOS PARTEN DE LA WHITELIST COMPLETA ---
  aTodos = ObtenerArchivosMD()

  ' --- 3. TODO EL PROYECTO: LA WHITELIST TAL CUAL ---
  If FMain.rbProyecto.Value Then Return aTodos

  ' --- 4. FILTRAR: SUBSTRING SENSIBLE SOBRE EL NOMBRE DEL ARCHIVO ---
  ' El filtro estrecha DENTRO de la whitelist, nunca la ensancha: se recorre la
  ' lista ya filtrada por nomenclatura y se conservan los que contienen el texto.
  If FMain.rbFiltrar.Value Then
    sFiltro = Trim(FMain.txtFiltrar.Text)
    ' FILTRO VACÍO EN MODO FILTRAR: NO ASUMIMOS "TODO", DEVOLVEMOS VACÍO. EL
    ' USUARIO ELIGIÓ FILTRAR PERO NO DIJO POR QUÉ; BUSCAR EN TODO SERÍA UNA
    ' SORPRESA.
    If sFiltro = "" Then Return aResultado
    For Each sRuta In aTodos
      If InStr(File.Name(sRuta), sFiltro) > 0 Then aResultado.Add(sRuta)
    Next
    Return aResultado
  Endif

  ' --- 5. NINGÚN RADIO (NO DEBERÍA PASAR): VACÍO ---
  Return aResultado

End

' ============================================
' Función   : FlagsActuales
' Propósito : Traduce los cuatro checkbox a las letras de los flags, en el
'             orden imsx. Es la forma en que se guardan en un patrón (SC-51)
' Parámetros: (ninguno)
' Retorna   : String — p. ej. "im", "x", o "" si no hay ninguno
' ============================================
Private Function FlagsActuales() As String

  Dim sFlags As String

  If FMain.ckbCaseless.Value Then sFlags &= "i"
  If FMain.ckbMultiline.Value Then sFlags &= "m"
  If FMain.ckbDotAll.Value Then sFlags &= "s"
  If FMain.ckbExtended.Value Then sFlags &= "x"

  Return sFlags

End

' ============================================
' Función   : ArmarFlags
' Propósito : Traduce los cuatro checkbox al string de flags que espera el
'             script: letras concatenadas, o "-" si no hay ninguno (el script
'             no recibe un argumento vacío para los flags). El orden es
'             indiferente para el .pl; se mantiene imsx por prolijidad.
' Parámetros: (ninguno)
' Retorna   : String — p. ej. "im", "x", o "-"
' ============================================
Private Function ArmarFlags() As String

  Return FlagsParaMotor(FlagsActuales())

End

' ============================================
' Función   : FlagsParaMotor
' Propósito : Convierte unas letras de flags al argumento del script: "-" si
'             están vacías
' Parámetros: sFlags As String — letras de flags, posiblemente vacías
' Retorna   : String — las mismas letras, o "-"
' ============================================
Private Function FlagsParaMotor(sFlags As String) As String

  If sFlags = "" Then Return "-"
  Return sFlags

End

' ============================================
' Función   : SolicitarValidacion
' Propósito : Punto de entrada de la validación continua. Lo llaman los eventos
'             _Change de txtBuscar, txtReemplazo y los _Click de los flags.
'             No valida en el acto: reinicia el timer de debounce. Restart
'             reinicia la cuenta atrás, así que solo se valida cuando el usuario
'             deja de tipear (DEMORA_VALIDACION ms sin actividad).
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub SolicitarValidacion()

  ' MIENTRAS EL USUARIO EDITA, NADA ESTÁ VALIDADO
  $bPatronValido = False
  FMain.btnProbar.Enabled = False
  FMain.btnBuscarRegex.Enabled = False
  FMain.btnGuardarPatron.Enabled = False

  ' LA MARCA DE MODIFICADO SE RECALCULA CON CADA CAMBIO (SC-51)
  ActualizarEstadoPatron()

  ' PATRÓN VACÍO: NO HAY QUÉ VALIDAR, NO SE LANZA PROCESO
  If Trim(FMain.txtBuscar.Text) = "" Then
    $hTimerValidar.Stop
    FMain.areaEditorMostrarResultado.Text = ""
    Return
  Endif

  ' REINICIAR EL DEBOUNCE
  $hTimerValidar.Restart

End

' EVENTO DEL TIMER DE DEBOUNCE: EL USUARIO DEJÓ DE TIPEAR, VALIDAR AHORA
Public Sub TimerValidarRegex_Timer()

  $hTimerValidar.Stop
  ValidarPatronAhora()

End

' ============================================
' Función   : InvocarValidador
' Propósito : Corre el modo 'validar' del script de forma síncrona (es 5 ms) y
'             devuelve el resultado ya separado. NO TOCA LA INTERFAZ: lo usan
'             la validación continua de la pestaña y la importación de
'             patrones (SC-51), que no pasa por los controles.
' Parámetros: sPatron As String — patrón
'             sReemplazo As String — reemplazo (se audita solo si no está vacío)
'             sFlags As String — letras de flags, posiblemente vacías
' Retorna   : String[] — dos elementos: [0] veredicto, [1] detalle.
'               "OK"     → detalle = avisos separados por SEP_LISTA (o "")
'               "ERROR"  → detalle = mensaje de perl sobre el patrón
'               "FALLO"  → detalle = el proceso no corrió o respondió mal
'                          (problema de entorno, no del patrón)
' ============================================
Private Function InvocarValidador(sPatron As String, sReemplazo As String, sFlags As String) As String[]

  Dim sSalida As String
  Dim sVeredicto As String
  Dim sResto As String
  Dim iPrimerNul As Integer
  Dim iSegundoNul As Integer
  Dim iTercerNul As Integer
  Dim sAplicar As String

  ' --- 1. ARMAR ARGUMENTOS ---
  ' EL REEMPLAZO SOLO SE AUDITA SI EL USUARIO ESCRIBIÓ ALGO EN ÉL
  sAplicar = If(Trim(sReemplazo) <> "", "1", "0")

  ' --- 2. INVOCAR EL VALIDADOR (SÍNCRONO, SIN SHELL: SC-05) ---
  ' -CSA: STDIN/STDOUT/STDERR y @ARGV en UTF-8. El patrón puede tener acentos,
  ' comillas tipográficas o NBSP y debe llegar intacto.
  Try Exec ["perl", "-CSA", RutaScript(), "validar", sPatron, sReemplazo, FlagsParaMotor(sFlags), sAplicar] To sSalida
  If Error Then Return ["FALLO", "No se pudo ejecutar el validador:" & Chr(10) & Error.Text]

  ' --- 3. SEPARAR VEREDICTO / RESTO POR EL PRIMER NUL ---
  ' Split completo fragmentaría el mensaje si tuviera separadores; se corta a
  ' mano por los primeros Chr(0) (SC-05).
  iPrimerNul = InStr(sSalida, Chr(0))
  If iPrimerNul = 0 Then Return ["FALLO", "Respuesta inesperada del validador."]
  sVeredicto = Left(sSalida, iPrimerNul - 1)
  sResto = Mid(sSalida, iPrimerNul + 1)

  ' --- 4. ERROR: EL SEGUNDO CAMPO (HASTA EL SIGUIENTE NUL) ES EL MENSAJE ---
  If sVeredicto = "ERROR" Then
    iSegundoNul = InStr(sResto, Chr(0))
    If iSegundoNul > 0 Then sResto = Left(sResto, iSegundoNul - 1)
    Return ["ERROR", sResto]
  Endif

  ' --- 5. OK: sResto = <n_grupos> NUL <avisos> NUL ---
  ' EL SCRIPT CIERRA EL ÚLTIMO CAMPO CON NUL: SE CORTA AHÍ, PARA QUE EL NUL
  ' FINAL NO LLEGUE AL TextArea
  If sVeredicto <> "OK" Then Return ["FALLO", "Respuesta inesperada del validador."]
  iSegundoNul = InStr(sResto, Chr(0))
  If iSegundoNul = 0 Then Return ["OK", ""]
  sResto = Mid(sResto, iSegundoNul + 1)
  iTercerNul = InStr(sResto, Chr(0))
  If iTercerNul > 0 Then sResto = Left(sResto, iTercerNul - 1)

  Return ["OK", sResto]

End

' ============================================
' Función   : ProblemaDelPatron
' Propósito : Dice si el motor acepta un patrón. Lo usa m_PatronesRegex al
'             importar: un patrón que el motor rechaza no se escribe en la
'             carpeta (SC-51). Los avisos no cuentan como problema.
' Parámetros: sPatron As String — patrón
'             sReemplazo As String — reemplazo
'             sFlags As String — letras de flags, posiblemente vacías
' Retorna   : String — "" si el motor lo acepta; si no, el motivo
' ============================================
Public Function ProblemaDelPatron(sPatron As String, sReemplazo As String, sFlags As String) As String

  Dim aRespuesta As String[]

  aRespuesta = InvocarValidador(sPatron, sReemplazo, sFlags)
  If aRespuesta[0] = "OK" Then Return ""
  If aRespuesta[0] = "ERROR" Then Return "patrón inválido: " & aRespuesta[1]
  Return aRespuesta[1]

End

' ============================================
' Función   : ValidarPatronAhora
' Propósito : Valida los campos de la pestaña con el motor y refleja el
'             resultado en la UI: habilita o no las acciones y muestra el
'             mensaje de error o los avisos. No toca ningún archivo del
'             proyecto.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Private Sub ValidarPatronAhora()

  Dim aRespuesta As String[]

  ' --- 1. INVOCAR EL MOTOR CON LO QUE HAY EN LOS CAMPOS ---
  aRespuesta = InvocarValidador(FMain.txtBuscar.Text, FMain.txtReemplazo.Text, FlagsActuales())

  ' --- 2. FALLO DEL PROCESO EN SÍ (perl ausente, script ilegible) ---
  ' NO ES UN PATRÓN INVÁLIDO SINO UN PROBLEMA DE ENTORNO: SE INFORMA Y SE DEJA
  ' TODO INHIBIDO.
  If aRespuesta[0] = "FALLO" Then
    $bPatronValido = False
    FMain.areaEditorMostrarResultado.Text = aRespuesta[1]
    Return
  Endif

  ' --- 3. PATRÓN INVÁLIDO: EL MENSAJE DE PERL CON <-- HERE ---
  If aRespuesta[0] = "ERROR" Then
    $bPatronValido = False
    FMain.areaEditorMostrarResultado.Text = "Patrón inválido:" & Chr(10) & aRespuesta[1]
    Return
  Endif

  ' --- 4. PATRÓN VÁLIDO: SE HABILITAN LAS ACCIONES ---
  $bPatronValido = True
  FMain.btnProbar.Enabled = True
  FMain.btnBuscarRegex.Enabled = True
  FMain.btnGuardarPatron.Enabled = True

  ' --- 5. AVISOS (NBSP LITERAL, $N INEXISTENTE, MATCH VACÍO) ---
  ' NO SON BLOQUEANTES: EL PATRÓN ES VÁLIDO, PERO CONVIENE VERLOS.
  If Trim(aRespuesta[1]) <> "" Then
    FMain.areaEditorMostrarResultado.Text = "Avisos:" & Chr(10) & Replace(aRespuesta[1], SEP_LISTA, Chr(10))
  Else
    FMain.areaEditorMostrarResultado.Text = ""
  Endif

End

' ============================================
' Función   : Probar
' Propósito : Banco de pruebas en seco. Corre el modo 'probar' del script sobre
'             el texto de areaEditor y vuelca el resultado en
'             areaEditorMostrarResultado. Prueba SEMÁNTICA (¿el patrón hace lo
'             que quiero?), no alcance. No toca el proyecto.
'             La llama FMain.btnProbar_Click.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub Probar()

  Dim sTexto As String
  Dim sSalida As String
  Dim sVeredicto As String
  Dim sResto As String
  Dim iPrimerNul As Integer
  Dim iSegundoNul As Integer
  Dim sCuenta As String
  Dim sCuerpo As String
  Dim sFlags As String
  Dim sAplicar As String
  Dim sRutaTmp As String

  ' --- 1. GUARDAS ---
  If Not $bPatronValido Then
    m_Sonido.sonar("Warning")
    Message.Warning("El patrón no es válido todavía.")
    Return
  Endif

  sTexto = FMain.areaEditor.Text
  If sTexto = "" Then
    m_Sonido.sonar("Warning")
    Message.Warning("Escribí o pegá un texto de prueba en el área de la izquierda.")
    Return
  Endif

  ' --- 2. ARGUMENTOS ---
  sFlags = ArmarFlags()
  sAplicar = If(Trim(FMain.txtReemplazo.Text) <> "", "1", "0")

  ' --- 3. VOLCAR EL TEXTO DE PRUEBA A UN TEMPORAL ---
  ' La forma Exec ... To de Gambas no expone stdin (la cláusula With en esa
  ' forma es solo With Error), así que el texto viaja por un archivo temporal
  ' que se pasa como argumento y se borra al terminar. File.Save es UTF-8
  ' nativo (SC-02), que es lo que el script espera.
  sRutaTmp = Temp$()
  Try File.Save(sRutaTmp, sTexto)
  If Error Then
    m_Sonido.sonar("Error")
    FMain.areaEditorMostrarResultado.Text = "No se pudo preparar el texto de prueba:" & Chr(10) & Error.Text
    Return
  Endif

  ' --- 4. INVOCAR EL MODO probar (ARRAY EN UNA SOLA LÍNEA: RC DEL Type mismatch) ---
  Try Exec ["perl", "-CSA", RutaScript(), "probar", FMain.txtBuscar.Text, FMain.txtReemplazo.Text, sFlags, sAplicar, sRutaTmp] To sSalida
  ' EL TEMPORAL YA CUMPLIÓ SU FUNCIÓN, SE BORRA HAYA IDO BIEN O MAL
  Try Kill sRutaTmp
  If Error Then
    m_Sonido.sonar("Error")
    FMain.areaEditorMostrarResultado.Text = "No se pudo ejecutar la prueba:" & Chr(10) & Error.Text
    Return
  Endif

  ' --- 5. PARSEAR: OK Chr(0) <cuenta> Chr(0) <cuerpo>  |  ERROR Chr(0) <msg> ---
  iPrimerNul = InStr(sSalida, Chr(0))
  If iPrimerNul = 0 Then
    FMain.areaEditorMostrarResultado.Text = "Respuesta inesperada de la prueba."
    Return
  Endif
  sVeredicto = Left(sSalida, iPrimerNul - 1)
  sResto = Mid(sSalida, iPrimerNul + 1)

  If sVeredicto = "ERROR" Then
    iSegundoNul = InStr(sResto, Chr(0))
    If iSegundoNul > 0 Then sResto = Left(sResto, iSegundoNul - 1)
    m_Sonido.sonar("Error")
    FMain.areaEditorMostrarResultado.Text = "Patrón inválido:" & Chr(10) & sResto
    Return
  Endif

  ' OK: sResto = <cuenta> Chr(0) <cuerpo>. El cuerpo es todo lo que sigue al
  ' segundo NUL y se toma entero, sin volver a partir.
  iSegundoNul = InStr(sResto, Chr(0))
  If iSegundoNul = 0 Then
    sCuenta = sResto
    sCuerpo = ""
  Else
    sCuenta = Left(sResto, iSegundoNul - 1)
    sCuerpo = Mid(sResto, iSegundoNul + 1)
  Endif

  ' --- 6. VOLCAR RESULTADO ---
  ' El contador va como prefijo informativo: distingue "no matcheó" (0) de
  ' "reemplazó por idéntico" o "búsqueda pura" (N pero texto sin cambios).
  m_Sonido.sonar("Info")
  FMain.areaEditorMostrarResultado.Text = "[" & sCuenta & " coincidencia(s)]" & Chr(10) & Chr(10) & sCuerpo

End

' ============================================
' Función   : CambiarAmbito
' Propósito : Responde a los tres radiobutton de ámbito. Solo con rbFiltrar el
'             txtFiltrar queda habilitado para escribir el substring de filtrado;
'             en los otros dos modos se deshabilita y se limpia. El filtro
'             estrecha SIEMPRE dentro de la whitelist, nunca la ensancha.
'             La llaman los _Click de rbProyecto, rbEnCurso y rbFiltrar.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub CambiarAmbito()

  If FMain.rbFiltrar.Value Then
    FMain.txtFiltrar.Enabled = True
    FMain.txtFiltrar.SetFocus()
  Else
    FMain.txtFiltrar.Enabled = False
    FMain.txtFiltrar.Text = ""
  Endif

End

' ============================================
' Función   : ActualizarDisponibilidadEnCurso
' Propósito : Habilita o deshabilita el radio rbEnCurso según si el archivo
'             cargado en el editor es buscable (whitelist). Si el usuario está
'             parado en el .md principal (sus notas) o en un archivo fuera de la
'             whitelist, "buscar en el archivo en curso" no tiene sentido y la
'             opción se apaga. Si rbEnCurso estaba elegido y deja de estar
'             disponible, el ámbito cae a rbProyecto.
'             Se llama al abrir la pestaña y cada vez que cambia el archivo del
'             editor (desde el _Click de cmbArticulosRevista).
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub ActualizarDisponibilidadEnCurso()

  Dim bBuscable As Boolean

  bBuscable = ArchivoEnCursoEsBuscable()
  FMain.rbEnCurso.Enabled = bBuscable

  ' SI EL ÁMBITO ACTIVO ERA "EN CURSO" Y YA NO SE PUEDE, VOLVER A "TODO EL
  ' PROYECTO" PARA NO DEJAR UN RADIO DESHABILITADO SELECCIONADO.
  If Not bBuscable And FMain.rbEnCurso.Value Then
    FMain.rbProyecto.Value = True
    CambiarAmbito()
  Endif

End

' ============================================
' Función   : BuscarRegex
' Propósito : Abre FRegexResultados con el estado actual ya resuelto: la lista de
'             archivos (según el ámbito), el patrón, el reemplazo y los flags.
'             El formulario es autónomo: recibe todo por parámetro y no lee los
'             controles de FMain. Es MODAL a propósito: mientras está abierto
'             nadie escribe a mano en el editor, así que el editor puede
'             mostrar cualquier coincidencia sin riesgo (MostrarCoincidencia).
'             La llama FMain.btnBuscarRegex_Click, después del aviso de
'             cambios sin guardar (SC-06).
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub BuscarRegex()

  Dim aArchivos As String[]
  Dim sAplicar As String
  Dim hForm As FRegexResultados
  Dim sDisco As String

  ' --- 1. GUARDA: SOLO CON PATRÓN VÁLIDO ---
  If Not $bPatronValido Then
    m_Sonido.sonar("Warning")
    Message.Warning("El patrón no es válido todavía.")
    Return
  Endif

  ' --- 2. RESOLVER EL ÁMBITO A UNA LISTA CONCRETA DE ARCHIVOS ---
  aArchivos = ResolverAmbito()
  If aArchivos.Count = 0 Then
    m_Sonido.sonar("Warning")
    Message.Warning("No hay archivos sobre los que buscar con el ámbito elegido." & Chr(10) &
      "Verificá el ámbito o el filtro.")
    Return
  Endif

  ' --- 3. EL EDITOR TIENE QUE SER IGUAL AL DISCO ---
  ' perl BUSCA EN DISCO Y LAS POSICIONES SE APLICAN AL EDITOR. «DESCARTAR» EN EL
  ' AVISO DE CAMBIOS SOLO MUEVE EL PUNTO DE CONTROL (MarcarGuardado): EL TEXTO
  ' DESCARTADO SIGUE EN EL EDITOR. SI DIFIERE DEL DISCO, SE RELEE. UN ESPACIO
  ' DURO EN EL ARCHIVO TAMBIÉN DA DIFERENCIA (.Text LO NORMALIZA, GV-47): SE
  ' RELEE SIN NECESIDAD, PERO LAS POSICIONES NO CAMBIAN (UN CARÁCTER POR OTRO)
  If FMain.sRutaArchivoAbierto <> "" Then
    Try sDisco = File.Load(FMain.sRutaArchivoAbierto)
    If Error Then
      m_Sonido.sonar("Error")
      Message.Error("No se pudo leer el archivo abierto:" & Chr(10) & Error.Text)
      Return
    Endif
    If m_EditorPrincipal.Texto() <> sDisco Then
      If Not FMain.RecargarArchivoAbierto() Then Return
    Endif
  Endif

  ' --- 4. DELEGAR AL FORMULARIO DE RESULTADOS ---
  ' Se le pasa todo hecho: archivos, patrón, reemplazo, flags. El aplicar se
  ' deriva de si hay reemplazo escrito: sin reemplazo, el formulario solo
  ' busca. LA RECARGA DE LO REEMPLAZADO LA HACE EL FORMULARIO APENAS ESCRIBE
  ' (TrasReemplazo): DESPUÉS DE REEMPLAZAR SE SIGUE NAVEGANDO SOBRE EL TEXTO
  ' NUEVO SIN CERRARLO.
  sAplicar = If(Trim(FMain.txtReemplazo.Text) <> "", "1", "0")

  hForm = New FRegexResultados
  hForm.Configurar(aArchivos, FMain.txtBuscar.Text, FMain.txtReemplazo.Text, ArmarFlags(), sAplicar, RutaScript())
  hForm.ShowModal()

  ' --- 5. FOCO AL EDITOR: LA ÚLTIMA COINCIDENCIA VISTA QUEDA SELECCIONADA (RC-GM-07) ---
  FMain.txtEditorProyecto.SetFocus()

End

' ============================================
' Función   : MostrarCoincidencia
' Propósito : Lleva el editor a una coincidencia de FRegexResultados: abre su
'             archivo si no es el abierto (m_Estructura.AbrirArchivo, por el
'             combo, GV-53) y la deja seleccionada con su párrafo arriba de la
'             vista (m_EditorPrincipal.IrA). No hay riesgo de posiciones viejas:
'             el formulario es modal, el editor quedó igual al disco al abrirlo
'             (BuscarRegex, apartado 3) y después de cada reemplazo se recarga y
'             se vuelve a buscar. «Resaltar» es seleccionar: colorear con Format
'             entraría en el deshacer (GV-46). La llama
'             FRegexResultados.gvResultados_Select.
' Parámetros: sRuta As String — ruta absoluta del archivo de la coincidencia
'             iLinea As Integer — línea, base 0 (como la da el script)
'             iColumna As Integer — columna en caracteres, base 0
'             iLargo As Integer — largo de la coincidencia en caracteres
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub MostrarCoincidencia(sRuta As String, iLinea As Integer, iColumna As Integer, iLargo As Integer)

  Dim sRaiz As String
  Dim sRel As String

  ' --- 1. ABRIR EL ARCHIVO SI NO ES EL DEL EDITOR ---
  ' SI YA ESTÁ ABIERTO NO SE LLAMA A AbrirArchivo (PRECEDENTE:
  ' m_AnalizarProyecto.IrAEjemplo). LA RUTA RELATIVA ES EL TEXTO DEL COMBO
  If sRuta <> FMain.sRutaArchivoAbierto Then
    sRaiz = m_InicioCierre.RutaProyectoEnCurso & "/"
    If String.Left(sRuta, String.Len(sRaiz)) <> sRaiz Then Return
    sRel = String.Mid(sRuta, String.Len(sRaiz) + 1)
    ' False: NO ESTÁ EN EL COMBO O FALLÓ LA LECTURA (YA INFORMADA)
    If Not m_Estructura.AbrirArchivo(sRel) Then Return
  Endif

  ' --- 2. SELECCIONAR LA COINCIDENCIA CON SU PÁRRAFO ARRIBA ---
  ' LÍNEA Y COLUMNA BASE 0, COMO LAS DA EL SCRIPT; PosicionDe CALCULA SOBRE EL
  ' TEXTO DEL EDITOR (MISMO CAMINO QUE m_AnalizarProyecto.IrAEjemplo)
  m_EditorPrincipal.IrA(m_EditorPrincipal.PosicionDe(iLinea, iColumna), iLargo)

End

' ============================================
' Función   : TrasReemplazo
' Propósito : Pone al día todo lo que depende de los archivos que el reemplazo
'             acaba de escribir en disco, como lo haría un guardado: su árbol de
'             estructura y sus referencias citadas en la base, y, si uno es el
'             abierto, el editor (FMain.RecargarArchivoAbierto). Se llama apenas
'             termina la escritura, también si se cortó a mitad: lo escrito,
'             escrito está. La llama FRegexResultados.btnReemplazar_Click.
' Parámetros: aArchivos As String[] — rutas absolutas efectivamente escritas
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub TrasReemplazo(aArchivos As String[])

  Dim sRuta As String
  Dim sContenido As String
  Dim bAbiertoTocado As Boolean

  ' --- 1. CADA ARCHIVO ESCRITO: ÁRBOL Y REFERENCIAS DESDE EL DISCO ---
  For Each sRuta In aArchivos
    Try sContenido = File.Load(sRuta)
    If Error Then
      ' NO ES UN CANAL MUDO (GV-23): EL ARCHIVO SE ESCRIBIÓ PERO NO SE PUEDE RELEER
      m_Sonido.sonar("Warning")
      Message.Warning("No se pudo releer " & File.Name(sRuta) & " después del reemplazo:" & Chr(10) & Error.Text)
      Continue
    Endif

    ' EL ABIERTO LO RECARGA FMain, QUE TAMBIÉN REHACE SU ÁRBOL
    If sRuta = FMain.sRutaArchivoAbierto Then
      bAbiertoTocado = True
    Else
      m_Estructura.ActualizarArchivo(sRuta, sContenido)
    Endif

    ' LAS CLAVES CITADAS PUDIERON CAMBIAR: LO MISMO QUE EL GUARDADO. LA FUNCIÓN
    ' INFORMA SUS PROPIOS ERRORES Y DEVUELVE False
    Try m_Bibtex.ExtraerYGuardarReferenciasDelEditor(sContenido, sRuta)
    If Error Then
      m_Sonido.sonar("Warning")
      Message.Warning("Falló la extracción de referencias de " & File.Name(sRuta) & ":" & Chr(10) & Error.Text)
    Endif
  Next

  ' --- 2. EL ARCHIVO ABIERTO: EDITOR, ÁRBOL, COMENTARIOS Y CONTADOR ---
  If bAbiertoTocado Then FMain.RecargarArchivoAbierto()

End

' ============================================
' BIBLIOTECA PERSONAL DE PATRONES (SC-51)
' Los datos y el formato viven en m_PatronesRegex. Desde acá se gobierna el
' combo, la marca de modificado y los cuatro botones.
' ============================================

' ============================================
' Función   : PoblarComboPatrones
' Propósito : Vuelve a llenar cmbPatrones con el patrón libre y los guardados,
'             y deja elegido el que se pide. No carga nada en los campos: la
'             reposición del índice dispara Click (GV-53) y la bandera
'             $bReponiendoCombo lo neutraliza.
' Parámetros: sSeleccion As String — nombre a dejar elegido; "" o un nombre
'             que ya no existe deja el patrón libre
' Retorna   : (Sub, sin retorno)
' ============================================
Private Sub PoblarComboPatrones(sSeleccion As String)

  Dim sNombre As String
  Dim iIndice As Integer

  ' --- 1. INICIO DE LA REPOSICIÓN ---
  $bReponiendoCombo = True

  ' --- 2. LLENAR: Clear Y Add NO DISPARAN Click; EL COMBO QUEDA EN 0 (GV-69) ---
  FMain.cmbPatrones.Clear()
  FMain.cmbPatrones.Add(TEXTO_PATRON_LIBRE)
  For Each sNombre In m_PatronesRegex.Nombres()
    FMain.cmbPatrones.Add(sNombre)
  Next

  ' --- 3. ÍNDICE PEDIDO; SI NO ESTÁ, EL PATRÓN LIBRE ---
  ' Find DISTINGUE MAYÚSCULAS (GV-59); LOS NOMBRES SON SIEMPRE MINÚSCULAS
  iIndice = 0
  If sSeleccion <> "" Then iIndice = FMain.cmbPatrones.Find(sSeleccion)
  If iIndice < 0 Then iIndice = 0

  ' SOLO SE ASIGNA SI CAMBIA: ASIGNAR EL MISMO ÍNDICE TAMBIÉN DISPARA Click (GV-53)
  If FMain.cmbPatrones.Index <> iIndice Then FMain.cmbPatrones.Index = iIndice
  $iIndiceCombo = iIndice

  ' --- 4. SI EL PATRÓN CARGADO YA NO EXISTE, LOS CAMPOS QUEDAN COMO PATRÓN LIBRE ---
  If iIndice = 0 Then $sPatronCargado = ""

  ' --- 5. FIN DE LA REPOSICIÓN ---
  $bReponiendoCombo = False

End

' ============================================
' Función   : ElegirPatron
' Propósito : Responde a la elección en cmbPatrones. El patrón libre conserva
'             lo que hay en los campos; un patrón guardado los completa, y su
'             texto de prueba entra en areaEditor solo si el área está vacía
'             (así no se pierde un fragmento real pegado para probar varios
'             patrones). Si lo que hay en los campos se perdería, pregunta.
'             La llama FMain.cmbPatrones_Click.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub ElegirPatron()

  Dim iNuevo As Integer
  Dim sNombre As String
  Dim cPatron As Collection
  Dim sFlags As String

  ' --- 1. REPOSICIÓN DESDE EL CÓDIGO: NO ES UNA ELECCIÓN DEL USUARIO (GV-53) ---
  If $bReponiendoCombo Then Return
  iNuevo = FMain.cmbPatrones.Index

  ' --- 2. PATRÓN LIBRE: LOS CAMPOS SE CONSERVAN, NO HAY NADA QUE PERDER ---
  If iNuevo <= 0 Then
    $sPatronCargado = ""
    $iIndiceCombo = 0
    ActualizarEstadoPatron()
    Return
  Endif

  ' --- 3. GUARD: LO QUE HAY EN LOS CAMPOS SE VA A REEMPLAZAR ---
  ' ELEGIR DE NUEVO EL MISMO PATRÓN SIRVE PARA VOLVER A LA VERSIÓN GUARDADA:
  ' TAMBIÉN PASA POR ACÁ Y PREGUNTA SI HAY CAMBIOS
  If Not ConfirmarDescartarPatron() Then
    $bReponiendoCombo = True
    If FMain.cmbPatrones.Index <> $iIndiceCombo Then FMain.cmbPatrones.Index = $iIndiceCombo
    $bReponiendoCombo = False
    Return
  Endif

  ' --- 4. EL PATRÓN ELEGIDO ---
  sNombre = FMain.cmbPatrones.Text
  cPatron = m_PatronesRegex.Patron(sNombre)
  If IsNull(cPatron) Then
    ' NO DEBERÍA PASAR: EL COMBO SE LLENA CON LOS CARGADOS
    m_Sonido.sonar("Error")
    Message.Error("No se encontró el patrón «" & sNombre & "».")
    Return
  Endif

  ' --- 5. COMPLETAR LOS CAMPOS ---
  ' $sPatronCargado QUEDA VACÍO MIENTRAS SE ASIGNA: CADA ASIGNACIÓN DISPARA
  ' _Change Y LA MARCA DE MODIFICADO SE CALCULARÍA CON LOS CAMPOS A MEDIAS. LA
  ' VALIDACIÓN LA DISPARAN ESOS MISMOS _Change, CON SU DEBOUNCE.
  $sPatronCargado = ""
  sFlags = m_PatronesRegex.Campo(cPatron, "flags")
  FMain.txtBuscar.Text = m_PatronesRegex.Campo(cPatron, "patron")
  FMain.txtReemplazo.Text = m_PatronesRegex.Campo(cPatron, "reemplazo")
  FMain.ckbCaseless.Value = InStr(sFlags, "i") > 0
  FMain.ckbMultiline.Value = InStr(sFlags, "m") > 0
  FMain.ckbDotAll.Value = InStr(sFlags, "s") > 0
  FMain.ckbExtended.Value = InStr(sFlags, "x") > 0
  If FMain.areaEditor.Text = "" Then FMain.areaEditor.Text = m_PatronesRegex.Campo(cPatron, "texto_prueba")

  ' --- 6. QUEDA CARGADO ---
  $sPatronCargado = sNombre
  $iIndiceCombo = iNuevo
  ActualizarEstadoPatron()

End

' ============================================
' Función   : PatronModificado
' Propósito : Indica si los campos difieren del patrón cargado. Compara patrón,
'             reemplazo y flags; la descripción no está en los campos y el
'             texto de prueba cambia todo el tiempo al probar, así que no
'             cuentan. Se compara contra lo guardado, no se siguen eventos: no
'             importa qué asignación dispara qué (SC-51).
' Parámetros: (ninguno)
' Retorna   : Boolean — False también si no hay patrón cargado
' ============================================
Private Function PatronModificado() As Boolean

  Dim cPatron As Collection

  ' --- 1. SIN PATRÓN CARGADO NO HAY CONTRA QUÉ COMPARAR ---
  If $sPatronCargado = "" Then Return False
  cPatron = m_PatronesRegex.Patron($sPatronCargado)
  If IsNull(cPatron) Then Return False

  ' --- 2. COMPARACIÓN CAMPO POR CAMPO (= DISTINGUE MAYÚSCULAS; == NO) ---
  If FMain.txtBuscar.Text <> m_PatronesRegex.Campo(cPatron, "patron") Then Return True
  If FMain.txtReemplazo.Text <> m_PatronesRegex.Campo(cPatron, "reemplazo") Then Return True
  If FlagsActuales() <> m_PatronesRegex.Campo(cPatron, "flags") Then Return True

  Return False

End

' ============================================
' Función   : ConfirmarDescartarPatron
' Propósito : Antes de reemplazar los campos con otro patrón, pregunta si hay
'             algo que se perdería: un patrón libre escrito, o un patrón
'             cargado con cambios sin guardar. Es SC-06 aplicado a la pestaña.
' Parámetros: (ninguno)
' Retorna   : Boolean — True si se puede seguir
' ============================================
Private Function ConfirmarDescartarPatron() As Boolean

  Dim sMotivo As String

  ' --- 1. ¿HAY ALGO QUE SE PERDERÍA? ---
  If $sPatronCargado = "" Then
    If Trim(FMain.txtBuscar.Text) = "" Then Return True
    sMotivo = "Hay un patrón escrito que no está guardado."
  Else
    If Not PatronModificado() Then Return True
    sMotivo = "El patrón «" & $sPatronCargado & "» tiene cambios sin guardar."
  Endif

  ' --- 2. PREGUNTAR ---
  m_Sonido.sonar("Warning")
  Return Message.Warning(sMotivo & Chr(10) & Chr(10) & "¿Descartarlo y cargar el patrón elegido?", "Descartar", "Cancelar") = 1

End

' ============================================
' Función   : ActualizarEstadoPatron
' Propósito : Refleja en la pestaña el estado de la biblioteca: la descripción
'             del patrón cargado con la marca de modificado, y qué botones
'             tienen sentido. Guardar depende de la validación y lo maneja
'             ella (ValidarPatronAhora y SolicitarValidacion).
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub ActualizarEstadoPatron()

  Dim cPatron As Collection
  Dim sTexto As String

  ' --- 1. BORRAR Y COMPARTIR: SOLO CON UN PATRÓN GUARDADO CARGADO ---
  FMain.btnBorrarPatron.Enabled = $sPatronCargado <> ""
  FMain.btnCompartirPatron.Enabled = $sPatronCargado <> ""

  ' --- 2. PATRÓN LIBRE: SIN DESCRIPCIÓN ---
  If $sPatronCargado = "" Then
    FMain.lblDescripcionPatron.Text = ""
    Return
  Endif

  ' --- 3. DESCRIPCIÓN Y MARCA ---
  cPatron = m_PatronesRegex.Patron($sPatronCargado)
  sTexto = m_PatronesRegex.Campo(cPatron, "descripcion")
  If sTexto = "" Then sTexto = "(sin descripción)"
  If PatronModificado() Then sTexto &= "   — modificado, sin guardar"
  FMain.lblDescripcionPatron.Text = sTexto

End

' ============================================
' Función   : GuardarPatron
' Propósito : Guarda lo que hay en los campos como patrón de la biblioteca.
'             FGuardarPatron pide nombre, descripción y texto de prueba (este
'             último, precargado con areaEditor para recortarlo), y confirma
'             si el nombre ya existe. Guardar con otro nombre es «guardar
'             como»: el patrón anterior queda. La llama
'             FMain.btnGuardarPatron_Click.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub GuardarPatron()

  Dim hForm As FGuardarPatron
  Dim sDescripcion As String
  Dim cPatron As Collection

  ' --- 1. GUARDA: SOLO UN PATRÓN QUE EL MOTOR ACEPTÓ ---
  If Not $bPatronValido Then
    m_Sonido.sonar("Warning")
    Message.Warning("El patrón no es válido todavía.")
    Return
  Endif

  ' --- 2. DATOS PROPUESTOS: LOS DEL PATRÓN CARGADO, SI LO HAY ---
  If $sPatronCargado <> "" Then sDescripcion = m_PatronesRegex.Campo(m_PatronesRegex.Patron($sPatronCargado), "descripcion")

  ' --- 3. PEDIR NOMBRE, DESCRIPCIÓN Y TEXTO DE PRUEBA ---
  ' LA DECISIÓN VUELVE POR ShowModal; LOS DATOS, POR m_PatronesRegex
  hForm = New FGuardarPatron
  hForm.Configurar($sPatronCargado, sDescripcion, FMain.areaEditor.Text)
  If hForm.ShowModal() <> m_PatronesRegex.ACCION_GUARDAR Then Return

  ' --- 4. ESCRIBIR ---
  cPatron = m_PatronesRegex.NuevoPatron(m_PatronesRegex.sEleccionNombre, m_PatronesRegex.sEleccionDescripcion, FMain.txtBuscar.Text, FMain.txtReemplazo.Text, FlagsActuales(), m_PatronesRegex.sEleccionTextoPrueba)
  If Not m_PatronesRegex.Guardar(cPatron) Then Return

  ' --- 5. RELEER, REPONER EL COMBO Y DEJAR CARGADO EL GUARDADO ---
  m_PatronesRegex.Cargar()
  $sPatronCargado = m_PatronesRegex.sEleccionNombre
  PoblarComboPatrones($sPatronCargado)
  ActualizarEstadoPatron()

  m_Sonido.sonar("Info")

End

' ============================================
' Función   : BorrarPatron
' Propósito : Borra de la biblioteca el patrón cargado. Los campos quedan como
'             patrón libre: se puede volver a guardar. La llama
'             FMain.btnBorrarPatron_Click.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub BorrarPatron()

  ' --- 1. GUARDA: TIENE QUE HABER UN PATRÓN GUARDADO CARGADO ---
  If $sPatronCargado = "" Then
    m_Sonido.sonar("Warning")
    Message.Warning("Elegí en la lista el patrón que querés borrar.")
    Return
  Endif

  ' --- 2. CONFIRMAR ---
  m_Sonido.sonar("Warning")
  If Message.Warning("¿Borrar el patrón «" & $sPatronCargado & "» de la biblioteca?" & Chr(10) & Chr(10) &
    "Los campos conservan su contenido como patrón libre.", "Borrar", "Cancelar") <> 1 Then Return

  ' --- 3. BORRAR, RELEER Y REPONER ---
  If Not m_PatronesRegex.Borrar($sPatronCargado) Then Return
  m_PatronesRegex.Cargar()
  $sPatronCargado = ""
  PoblarComboPatrones("")
  ActualizarEstadoPatron()

End

' ============================================
' Función   : CompartirPatron
' Propósito : Escribe el patrón cargado en un archivo elegido por el usuario,
'             en el formato de la biblioteca (SC-51). Se comparte lo guardado:
'             con cambios sin guardar, se pide guardar antes. La llama
'             FMain.btnCompartirPatron_Click.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub CompartirPatron()

  Dim sRuta As String

  ' --- 1. GUARDAS ---
  If $sPatronCargado = "" Then
    m_Sonido.sonar("Warning")
    Message.Warning("Elegí en la lista el patrón que querés compartir.")
    Return
  Endif
  If PatronModificado() Then
    m_Sonido.sonar("Warning")
    Message.Warning("El patrón «" & $sPatronCargado & "» tiene cambios sin guardar." & Chr(10) &
      "Guardalo antes de compartirlo: se comparte el patrón guardado.")
    Return
  Endif

  ' --- 2. ELEGIR EL DESTINO ---
  ' SaveFile DEVUELVE True AL CANCELAR (GV-16, MISMA CONVENCIÓN)
  Dialog.Title = "Compartir el patrón «" & $sPatronCargado & "»"
  Dialog.Filter = ["*.json", "Patrones de gbpublisher"]
  Dialog.Path = User.Home &/ $sPatronCargado & ".json"
  If Dialog.SaveFile() Then Return
  sRuta = Dialog.Path

  ' --- 3. EXTENSIÓN, VERIFICADA EN CÓDIGO (RC-GM-19) ---
  ' EL DIÁLOGO YA PREGUNTÓ SI Dialog.Path EXISTÍA (GV-97): NO SE REPITE. SOLO SE
  ' PREGUNTA ACÁ SI EL CÓDIGO CAMBIA LA RUTA, PORQUE ESA RUTA EL DIÁLOGO NO LA VIO
  If LCase(File.Ext(sRuta)) <> "json" Then
    sRuta &= ".json"
    If IsDir(sRuta) Then
      m_Sonido.sonar("Error")
      Message.Error("El destino es una carpeta:" & Chr(10) & sRuta)
      Return
    Endif
    If Exist(sRuta) Then
      m_Sonido.sonar("Warning")
      If Message.Warning("Ya existe el archivo:" & Chr(10) & sRuta & Chr(10) & Chr(10) & "¿Reemplazarlo?", "Reemplazar", "Cancelar") <> 1 Then Return
    Endif
  Endif

  ' --- 4. ESCRIBIR ---
  If Not m_PatronesRegex.Exportar($sPatronCargado, sRuta) Then Return
  m_Sonido.sonar("Info")
  Message.Info("Patrón «" & $sPatronCargado & "» guardado en:" & Chr(10) & sRuta)

End

' ============================================
' Función   : ImportarPatrones
' Propósito : Incorpora a la biblioteca los patrones de un archivo (SC-51). La
'             lógica, los controles y el informe están en
'             m_PatronesRegex.Importar; acá se elige el archivo y se repone la
'             pestaña. Los campos no se tocan: si se reemplazó el patrón
'             cargado, la marca de modificado lo muestra. La llama
'             FMain.btnImportarPatrones_Click.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub ImportarPatrones()

  ' --- 1. ELEGIR EL ARCHIVO (OpenFile DEVUELVE True AL CANCELAR) ---
  Dialog.Title = "Importar patrones"
  Dialog.Filter = ["*.json", "Patrones de gbpublisher"]
  Dialog.Path = User.Home & "/"
  If Dialog.OpenFile() Then Return

  ' --- 2. IMPORTAR; SI NO SE ESCRIBIÓ NADA, NO HAY QUÉ REPONER ---
  If Not m_PatronesRegex.Importar(Dialog.Path) Then Return

  ' --- 3. RELEER Y REPONER EL COMBO CONSERVANDO EL PATRÓN CARGADO ---
  m_PatronesRegex.Cargar()
  PoblarComboPatrones($sPatronCargado)
  ActualizarEstadoPatron()

End
