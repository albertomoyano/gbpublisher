# Gambas Form File 3.0

{ Form Form
  Move(0,0,640,360)
  #Scaled = False
  Text = ("Vincular el archivo con un número")
  Resizable = False
  Arrangement = Arrange.Vertical
  AutoResize = True
  Spacing = True
  Margin = True
  Padding = 4
  { lblArchivoVinculo TextLabel
    Move(9,9,620,72)
    Foreground = &H0000FF
    Border = Border.Plain
  }
  { hbxRevistaVinculo HBox
    Move(9,90,620,36)
    { lblRevistaVinculo Label
      Move(0,0,160,36)
      Alignment = Align.Right
      Text = ("revista: ")
    }
    { cmbRevistaVinculo ComboBox
      Move(162,0,450,36)
      Expand = True
      ReadOnly = True
    }
  }
  { hbxVolumenVinculo HBox
    Move(9,135,620,36)
    { lblVolumenVinculo Label
      Move(0,0,160,36)
      Alignment = Align.Right
      Text = ("volumen: ")
    }
    { txtVolumenVinculo TextBox
      Move(162,0,450,36)
      Expand = True
      Placeholder = ("Por ejemplo: 12")
    }
  }
  { hbxNumeroVinculo HBox
    Move(9,180,620,36)
    { lblNumeroVinculo Label
      Move(0,0,160,36)
      Alignment = Align.Right
      Text = ("número: ")
    }
    { txtNumeroVinculo TextBox
      Move(162,0,450,36)
      Expand = True
      Placeholder = ("Por ejemplo: 1")
    }
  }
  { hbxSuplementoVinculo HBox
    Move(9,225,620,36)
    { lblSuplementoVinculo Label
      Move(0,0,160,36)
      Alignment = Align.Right
      Text = ("suplemento: ")
    }
    { txtSuplementoVinculo TextBox
      Move(162,0,450,36)
      Expand = True
      Placeholder = ("Solo si es un suplemento")
    }
  }
  { hbxBotonesVinculo HBox
    Move(9,315,632,36)
    Centered = True
    { sprBotonesVinculo Spring
      Move(0,0,36,36)
    }
    { btnVincular Button
      Move(320,0,144,36)
      Text = ("Vincular")
      Picture = Picture["iconos/vincular.png"]
    }
    { btnCancelarVinculo Button
      Move(468,0,144,36)
      Text = ("Cancelar")
      Picture = Picture["iconos/salir.png"]
    }
  }
}
