' Gambas class file

' ============================================
' Clase     : CMensaje
' Propósito : Una entrada del catálogo de mensajes. Reúne los cuatro
'             textos y los cinco atributos de clasificación que
'             corresponden a un código de hallazgo.
'
'             El motor NO guarda texto: guarda códigos. Todo lo que
'             hay en esta clase se resuelve al mostrar en la grilla o
'             al emitir el informe. Por eso la redacción se puede
'             corregir sin recompilar, se puede traducir, y un informe
'             archivado se puede regenerar con los mensajes mejorados
'             sobre los mismos hechos medidos.
' ============================================

' --- 1. IDENTIDAD ---

Public sCodigo As String

' --- 2. CLASIFICACIÓN ---
' Estos cinco valores vivían embebidos en ClasificarPorDefecto. Al
' pasar al catálogo, agregar una regla nueva deja de requerir tocar
' código: alcanza con agregar un <mensaje> al XML.

Public sOrigen As String
Public sImpacto As String
Public sCorreccion As String
Public sCerteza As String
Public bUniversal As Boolean = False

' --- 3. LOS CUATRO TEXTOS ---
' corto        una línea, para la grilla
' largo        qué se encontró
' consecuencia por qué importa, en términos verificables
' remedio      qué hacer y quién puede hacerlo

Public sCorto As String
Public sLargo As String
Public sConsecuencia As String
Public sRemedio As String
