# Gambas Form File 3.0

{ Form Form
  Move(0,0,720,480)
  #Scaled = False
  Resizable = False
  Arrangement = Arrange.Vertical
  Spacing = True
  Margin = True
  Padding = 4
  { hbxNombre HBox
    Move(9,9,693,36)
    #Translate = False
    { lblNombre Label
      Move(0,0,117,36)
      #Translate = False
      Alignment = Align.Right
      Text = "Nombre: "
    }
    { txtNombre TextBox
      Move(117,0,288,36)
      #Translate = False
      Font = Font["Monospace"]
      MaxLength = 60
    }
    { lblAyudaNombre Label
      Move(414,0,270,36)
      #Translate = False
      Expand = True
      Text = "  a-z, 0-9 y guion; hasta 60"
    }
  }
  { hbxDescripcion HBox
    Move(9,54,693,36)
    #Translate = False
    { lblDescripcion Label
      Move(0,0,117,36)
      #Translate = False
      Alignment = Align.Right
      Text = "Descripción: "
    }
    { txtDescripcion TextBox
      Move(117,0,567,36)
      #Translate = False
      Expand = True
    }
  }
  { lblTextoPrueba Label
    Move(9,99,693,36)
    #Translate = False
    Text = "Texto de prueba (se guarda con el patrón: dejá solo lo que ilustra el caso)"
  }
  { txaTextoPrueba TextArea
    Move(9,144,693,270)
    #Translate = False
    Font = Font["Monospace"]
    Expand = True
  }
  { hbxBotones HBox
    Move(9,423,693,36)
    #Translate = False
    { Panel1 Panel
      Move(0,0,36,36)
      Expand = True
    }
    { btnGuardar Button
      Move(405,0,144,36)
      #Translate = False
      Font = Font["Bold"]
      Default = True
      Text = "Guardar"
      Picture = Picture["iconos/guardar.png"]
    }
    { btnCancelar Button
      Move(549,0,144,36)
      #Translate = False
      Text = "Cancelar"
      Picture = Picture["iconos/salir.png"]
    }
  }
}
