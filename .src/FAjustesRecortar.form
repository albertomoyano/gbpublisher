# Gambas Form File 3.0

{ Form Form
  Move(0,0,960,600)
  #Scaled = False
  Resizable = False
  Arrangement = Arrange.Vertical
  Spacing = True
  Margin = True
  Padding = 4
  { HBox3 HBox
    Move(45,9,360,36)
    { lblRecortar Label
      Move(108,0,108,36)
      Expand = True
      Alignment = Align.Center
    }
    { !pbRecortar PictureBox
      Move(306,0,36,36)
      #Public = True
      Alignment = Align.Center
    }
  }
  { saRecortar ScrollArea
    Move(45,54,351,180)
    Expand = True
    AutoResize = True
  }
  { HBox1 HBox
    Move(36,243,360,36)
    { Spring1 Spring
      Move(18,0,36,36)
    }
    { btnAplicar Button
      Move(153,0,36,36)
      Picture = Picture["iconos/ok.png"]
    }
    { btnCerrar Button
      Move(189,0,36,36)
      Picture = Picture["iconos/salir.png"]
    }
  }
}
