' Gambas class file

' UN CUADRO (SC-66, SC-67): EL ARCHIVO cuadros/tbl-….md YA LEÍDO. LO LLENA
' m_Cuadros.Leer Y LO ESCRIBE m_Cuadros.Escribir; FTabla LO EDITA.
'
' LOS VALORES SON LOS DEL ARCHIVO, SIN TRADUCIR: «sí» ES True, UNA CLAVE QUE
' FALTA TIENE SU VALOR POR OMISIÓN (EL MISMO QUE APLICA cuadro-leer.lua). EL
' QUE CONTROLA DE VERDAD ES cuadro-leer.lua: ESTA CLASE NO VALIDA.
'
' LA TABLA TIENE DOS FORMAS:
'   - pipe table: Encabezado Y Filas, CELDA POR CELDA, CON EL TEXTO EN
'     MARKDOWN TAL CUAL Y EL «\|» YA CONVERTIDO EN «|»;
'   - cualquier otra (grid table, con celdas unidas): EsTablaTexto = True Y
'     EL TEXTO ENTERO EN TablaTexto. FTabla LA EDITA COMO TEXTO (SC-67, a).

' --- EL ENCABEZADO ---
Public Titulo As String
Public Nota As String
Public Cuerpo As String = "normal"
Public Separacion As String = "normal"
Public Rotar As Boolean
Public Agrupar As Boolean
Public Ancho As String = "columna"
Public Cortes As New Integer[]
Public Bloques As New Integer[]

' --- LAS COLUMNAS: UNA ENTRADA POR COLUMNA, EN PARALELO ---
' ColAncho EN CENTÍMETROS CON PUNTO DECIMAL, O VACÍO; ColAlinear izq, centro
' O VACÍO (= izq)
Public ColTipo As New String[]
Public ColAncho As New String[]
Public ColAlinear As New String[]

' --- LA TABLA ---
Public Encabezado As New String[]
Public Filas As New String[][]
Public EsTablaTexto As Boolean
Public TablaTexto As String
