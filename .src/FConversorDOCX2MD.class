' Gambas class file

' ==============================================================================
' Formulario  : FConversorDOCX2MD
' Propósito   : Interfaz de la conversión de .docx a Markdown. Junta y valida
'               los parámetros, pregunta por las sobrescrituras y ejecuta
'               engine/convertir_docx.sh en la terminal propia del formulario,
'               donde el usuario ve cada etapa. El veredicto llega por el
'               código de salida, en el evento Kill de la terminal.
'               La lógica de conversión NO vive acá: está en el script y en el
'               filtro engine/limpiar_docx.lua (contrato de ingreso).
'               SUPUESTO: el formulario se invoca con un proyecto abierto.
' Dependencias: m_Sonido, m_FuncionesGenericas (RaizProyectoValida),
'               m_InicioCierre (RutaRecursos), gb.form.terminal.
' ==============================================================================

' --- CARACTERES PERMITIDOS EN EL NOMBRE. EL "_" QUEDA FUERA A PROPÓSITO: EL ---
' --- SCRIPT LO USA PARA SEPARAR EL NOMBRE DE LA PIEZA DEL DE SUS IMÁGENES    ---
Private Const CARACTERES_NOMBRE As String = "-0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
Private Const DIGITOS As String = "0123456789"
Private Const LARGO_MAXIMO_NOMBRE As Integer = 24

' --- PERMITE EL CIERRE DESDE EL BOTÓN Y BLOQUEA LA X DEL SISTEMA ---
Private $bCierrePermitido As Boolean

' --- HAY UN PROCESO CORRIENDO EN LA TERMINAL ---
Private $bConvirtiendo As Boolean

' --- PROCESO DEVUELTO POR TerminalView.Exec: EL CÓDIGO DE SALIDA SE LEE DE ---
' --- ACÁ, NO DE Last, PORQUE EL EMISOR DEL EVENTO Kill ES LA TERMINAL       ---
Private $hProceso As Process

' --- DESTINO DE LA CONVERSIÓN EN CURSO, PARA EL MENSAJE FINAL ---
Private $sDestinoEnCurso As String

' ============================================
' Función   : Form_Open
' Propósito : Estado inicial: campos limpios, controles habilitados y botón
'             Convertir oculto hasta completar origen y nombre. Me.Close()
'             destruye la instancia (RC-GM-13), así que cada apertura parte
'             de cero; igual se fija todo explícitamente
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub Form_Open()

  ' --- 1. RESETEAR CAMPOS DE ENTRADA ---
  txtArchivoOrigen.Text = ""
  txtArchivoDestino.Text = ""
  lblNombreArchivo.Text = ""
  rbBody.Value = True

  ' --- 2. ESTADO INICIAL ---
  $bCierrePermitido = False
  $bConvirtiendo = False
  $hProceso = Null
  $sDestinoEnCurso = ""
  HabilitarControles(True)
  btnCONVERTIR.Visible = False

  ' --- 3. FUENTE DEL TERMINAL: EXPLÍCITA, NO HEREDADA ---
  ' SI SE DEJA EN «FUENTE POR DEFECTO», QT SINTETIZA EL BOLD Y SE VE MAL
  TerminalViewConversor.Font.Name = "IBM Plex Mono"
  TerminalViewConversor.Font.Size = 12
  TerminalViewConversor.Background = Color.RGB(45, 30, 20)   ' MARRÓN OSCURO
  TerminalViewConversor.Foreground = Color.RGB(230, 220, 210)

End

' ============================================
' Función   : btnBuscar_Click
' Propósito : Permite seleccionar el .docx de origen
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnBuscar_Click()

  ' --- 1. CONFIGURAR Y ABRIR EL DIÁLOGO ---
  ' EL FILTRO ES COSMÉTICO (RC-GM-19): LA EXTENSIÓN SE VALIDA EN btnCONVERTIR_Click
  Dialog.Title = "Seleccionar archivo .docx"
  Dialog.Filter = ["*.docx", "Documentos de Word (.docx)"]
  Dialog.Path = User.Home

  ' Dialog.OpenFile DEVUELVE True CUANDO EL USUARIO CANCELA
  If Dialog.OpenFile() Then Return

  ' --- 2. MOSTRAR RUTA SELECCIONADA ---
  txtArchivoOrigen.Text = Dialog.Path

  ' --- 3. ACTUALIZAR VISIBILIDAD DEL BOTÓN CONVERTIR ---
  ActualizarBotonConvertir()

End

' ============================================
' Función   : btnCONVERTIR_Click
' Propósito : Valida las entradas, pregunta por las sobrescrituras y lanza
'             engine/convertir_docx.sh en la terminal del formulario. No
'             espera el resultado: lo recibe TerminalViewConversor_Kill
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnCONVERTIR_Click()

  Dim sRutaOrigen As String
  Dim sRaiz As String
  Dim sNombre As String
  Dim sPrefijo As String
  Dim sSubcarpeta As String
  Dim sNombreFinal As String
  Dim sScript As String
  Dim aComando As New String[]

  ' --- 1. OBTENER VALORES DE LA INTERFAZ ---
  ' ANTE UN DOBLE CLICK DURANTE UNA CONVERSIÓN NO SE HACE NADA
  If $bConvirtiendo Then Return

  sRutaOrigen = Trim(txtArchivoOrigen.Text)
  ' UCase CUBRE EL TEXTO PEGADO CON EL MOUSE, QUE NO DISPARA KeyRelease
  sNombre = UCase(Trim(txtArchivoDestino.Text))

  ' LA CARPETA DEL PROYECTO ES LA RAÍZ, NO EL .md DEL PROYECTO (GV-01).
  ' RaizProyectoValida DEVUELVE "" SI NO HAY PROYECTO O SI NO ES UN DIRECTORIO
  sRaiz = m_FuncionesGenericas.RaizProyectoValida()

  ' --- 2. VALIDAR CAMPOS Y PROYECTO ---
  If sRutaOrigen = "" Then
    m_Sonido.sonar("Error")
    Message.Error("Debe seleccionar un archivo de origen.")
    Return
  Endif

  If sNombre = "" Then
    m_Sonido.sonar("Error")
    Message.Error("El campo de nombre de archivo no puede estar vacío.")
    Return
  Endif

  If sRaiz = "" Then
    m_Sonido.sonar("Error")
    Message.Error("No hay un proyecto abierto o su carpeta no es un directorio válido.")
    Return
  Endif

  ' --- 3. VALIDAR EL NOMBRE COMPLETO ---
  ' DEFENSA EN PROFUNDIDAD: KeyPress NO CUBRE EL PEGADO CON EL MOUSE
  If Not NombreDestinoValido(sNombre) Then
    m_Sonido.sonar("Error")
    Message.Error("El nombre debe comenzar con dos dígitos y un guion, y usar solo" &
      gb.NewLine & "mayúsculas, dígitos y guiones (máximo " & LARGO_MAXIMO_NOMBRE & " caracteres)," &
      gb.NewLine & "por ejemplo 01-INTRODUCCION.")
    Return
  Endif

  ' --- 4. VERIFICAR QUE EL ORIGEN ES UN ARCHIVO ---
  ' Exist ES True TAMBIÉN PARA CARPETAS (GV-01): IsDir EN If APARTE
  If Not Exist(sRutaOrigen) Then
    m_Sonido.sonar("Error")
    Message.Error("El archivo de origen no existe:" & gb.NewLine & sRutaOrigen)
    Return
  Endif

  If IsDir(sRutaOrigen) Then
    m_Sonido.sonar("Error")
    Message.Error("El origen seleccionado es una carpeta, no un archivo.")
    Return
  Endif

  ' --- 5. VERIFICAR LA EXTENSIÓN ---
  ' SIN DISTINGUIR CAJA A PROPÓSITO: UN .DOCX DE WINDOWS ES VÁLIDO
  If LCase(File.Ext(sRutaOrigen)) <> "docx" Then
    m_Sonido.sonar("Error")
    Message.Error("Formato no soportado. Solo se convierten archivos .docx.")
    Return
  Endif

  ' --- 6. DETERMINAR PREFIJO Y SUBCARPETA SEGÚN EL TIPO DE PIEZA ---
  ' rbBody ES EL DEFAULT DEL FORMULARIO Y CAE EN EL Case Else
  Select Case True
    Case rbFront.Value
      sPrefijo = "fm-"
      sSubcarpeta = "front-matter"
    Case rbBack.Value
      sPrefijo = "bm-"
      sSubcarpeta = "back-matter"
    Case Else
      sPrefijo = "a-"
      sSubcarpeta = "articulos"
  End Select

  sNombreFinal = sPrefijo & sNombre

  ' --- 7. VERIFICAR QUE EL SCRIPT ESTÁ INSTALADO ---
  ' engine/ NO SE COPIA A ~/.gbpublisher (SC-11): SE LEE DE LOS RECURSOS
  sScript = m_InicioCierre.RutaRecursos() &/ "engine" &/ "convertir_docx.sh"

  If Not Exist(sScript) Then
    m_Sonido.sonar("Error")
    Message.Error("No se encuentra el script de conversión:" & gb.NewLine & sScript &
      gb.NewLine & gb.NewLine & "Reinstale el paquete de gbpublisher.")
    Return
  Endif

  ' --- 8. CONFIRMAR SOBRESCRITURAS ---
  ' LAS PREGUNTAS SON INTERFAZ Y VAN ACÁ: EL SCRIPT NO PREGUNTA NI LEE stdin.
  ' SI SE CONFIRMA, EL SCRIPT REEMPLAZA TAMBIÉN EL INFORME Y LAS IMÁGENES DE LA PIEZA
  If Exist(sRaiz &/ sSubcarpeta &/ sNombreFinal & ".md") Then
    If Message.Question("Ya existe el archivo:" & gb.NewLine &
        sNombreFinal & ".md" & gb.NewLine & gb.NewLine &
        "¿Desea sobrescribirlo?", "Sí", "No") <> 1 Then
      Return
    Endif
  Endif

  If Exist(sRaiz &/ "originales" &/ sNombreFinal & ".docx") Then
    If Message.Question("Ya existe el original:" & gb.NewLine &
        sNombreFinal & ".docx" & gb.NewLine & gb.NewLine &
        "¿Desea sobrescribirlo?", "Sí", "No") <> 1 Then
      Return
    Endif
  Endif

  ' --- 9. LANZAR EL SCRIPT EN LA TERMINAL ---
  ' ARRAY SIN SHELL INTERMEDIO (SC-05, GV-06): LAS RUTAS VIAJAN INTACTAS
  ' AUNQUE TENGAN COMILLAS, $ O ESPACIOS
  aComando.Add("bash")
  aComando.Add(sScript)
  aComando.Add(sRutaOrigen)
  aComando.Add(sRaiz)
  aComando.Add(sSubcarpeta)
  aComando.Add(sNombreFinal)

  Try $hProceso = TerminalViewConversor.Exec(aComando)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo lanzar la conversión:" & gb.NewLine & Error.Text)
    Return
  Endif

  ' --- 10. ESTADO DE CONVERSIÓN EN CURSO ---
  $bConvirtiendo = True
  $sDestinoEnCurso = sSubcarpeta &/ sNombreFinal & ".md"
  HabilitarControles(False)

  ' EL FOCO EN LA TERMINAL PERMITE INTERRUMPIR CON Ctrl+C (RC-GM-07)
  TerminalViewConversor.SetFocus()

End

' ============================================
' Función   : TerminalViewConversor_Kill
' Propósito : Recibe el fin del script y comunica el veredicto según el
'             estado y el código de salida del proceso
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub TerminalViewConversor_Kill()

  Dim iEstado As Integer
  Dim iValor As Integer

  ' --- 1. CAPTURAR EL RESULTADO Y LIBERAR EL ESTADO ---
  ' SI NO HAY PROCESO PROPIO, EL EVENTO NO CORRESPONDE A UNA CONVERSIÓN
  If $hProceso = Null Then Return

  iEstado = $hProceso.State
  iValor = $hProceso.Value
  $hProceso = Null
  $bConvirtiendo = False
  HabilitarControles(True)

  ' --- 2. PROCESO TERMINADO POR SEÑAL (Ctrl+C O Kill) ---
  ' CON State = Crashed, Value ES EL NÚMERO DE SEÑAL, NO UN CÓDIGO DE SALIDA
  If iEstado <> Process.Stopped Then
    m_Sonido.sonar("Warning")
    Message.Warning("La conversión fue interrumpida (señal " & iValor & ")." &
      gb.NewLine & gb.NewLine &
      "Si ocurrió antes de la etapa 6, el proyecto no se modificó." &
      gb.NewLine & "Revise la terminal para ver hasta dónde llegó.")
    Return
  Endif

  ' --- 3. CONVERSIÓN COMPLETA ---
  If iValor = 0 Then
    m_Sonido.sonar("Info")
    Message.Info("Conversión completada:" & gb.NewLine & $sDestinoEnCurso &
      gb.NewLine & gb.NewLine & "El informe quedó en /originales.")

    ' RESET PARA UNA EVENTUAL NUEVA CONVERSIÓN
    txtArchivoOrigen.Text = ""
    txtArchivoDestino.Text = ""
    lblNombreArchivo.Text = ""
    btnCONVERTIR.Visible = False
    Return
  Endif

  ' --- 4. FALLO CON CÓDIGO DE LA TABLA ---
  m_Sonido.sonar("Error")
  Message.Error(MensajeCodigoSalida(iValor) & gb.NewLine & gb.NewLine &
    "Revise la terminal para ver el detalle.")

End

' ============================================
' Función   : MensajeCodigoSalida
' Propósito : Traduce el código de salida de convertir_docx.sh a un mensaje
' Parámetros: iCodigo As Integer — código de salida del script
' Retorna   : String — mensaje para el usuario
' ============================================
Private Function MensajeCodigoSalida(iCodigo As Integer) As String

  ' LA TABLA ESTÁ DOCUMENTADA EN EL ENCABEZADO DE engine/convertir_docx.sh
  Select Case iCodigo
    Case 10
      Return "Argumentos inválidos para la conversión (código 10)."
    Case 11
      Return "Falta una dependencia: pandoc 3.1.3 o posterior, python3 o el filtro de limpieza (código 11)."
    Case 20
      Return "Pandoc no pudo convertir el archivo (código 20). El proyecto no se modificó."
    Case 30
      Return "Falló la normalización del texto (código 30). El proyecto no se modificó."
    Case 40
      Return "Falló una escritura en el proyecto (código 40). El proyecto puede haber quedado incompleto."
    Case 50
      Return "Falló el armado del informe (código 50). El proyecto no se modificó."
    Case Else
      Return "La conversión terminó con un código inesperado (" & iCodigo & ")."
  End Select

End

' ============================================
' Función   : HabilitarControles
' Propósito : Bloquea o libera la interfaz mientras corre una conversión
' Parámetros: bHabilitar As Boolean — True para liberar, False para bloquear
' Retorna   : nada
' ============================================
Private Sub HabilitarControles(bHabilitar As Boolean)

  btnBuscar.Enabled = bHabilitar
  txtArchivoDestino.Enabled = bHabilitar
  rbFront.Enabled = bHabilitar
  rbBody.Enabled = bHabilitar
  rbBack.Enabled = bHabilitar
  btnCONVERTIR.Enabled = bHabilitar
  btnCerrar.Enabled = bHabilitar

End

' ============================================
' Función   : NombreDestinoValido
' Propósito : Verifica el patrón NN- y que todos los caracteres estén permitidos
' Parámetros: sNombre As String — nombre sin prefijo de tipo, ya en mayúsculas
' Retorna   : Boolean — True si el nombre es válido
' ============================================
Private Function NombreDestinoValido(sNombre As String) As Boolean

  Dim iLargo As Integer
  Dim iPos As Integer

  ' --- 1. LARGO: NN- MÁS AL MENOS UN CARÁCTER ---
  iLargo = String.Len(sNombre)
  If iLargo < 4 Then Return False
  If iLargo > LARGO_MAXIMO_NOMBRE Then Return False

  ' --- 2. PATRÓN POSICIONAL NN- ---
  ' CONDICIONES SEPARADAS: And/Or NO CORTOCIRCUITAN (RC-GM-17, GV-12)
  If InStr(DIGITOS, String.Mid(sNombre, 1, 1)) = 0 Then Return False
  If InStr(DIGITOS, String.Mid(sNombre, 2, 1)) = 0 Then Return False
  If String.Mid(sNombre, 3, 1) <> "-" Then Return False

  ' --- 3. RESTO DEL NOMBRE: SOLO CARACTERES PERMITIDOS ---
  ' String.Mid POR CODEPOINT: UNA Ñ O UNA TILDE NO ESTÁN EN LA LISTA Y SE RECHAZAN
  For iPos = 4 To iLargo
    If InStr(CARACTERES_NOMBRE, String.Mid(sNombre, iPos, 1)) = 0 Then Return False
  Next

  Return True

End

' ============================================
' Función   : txtArchivoDestino_KeyPress
' Propósito : Filtra caracteres permitidos y fuerza que el nombre comience
'             con el patrón posicional NN-
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub txtArchivoDestino_KeyPress()

  Dim iPos As Integer

  ' --- 1. PERMITIR TECLAS DE CONTROL ---
  If Key.Code = Key.BackSpace Or Key.Code = Key.Delete Or
      Key.Code = Key.Left Or Key.Code = Key.Right Or
      Key.Code = Key.Tab Or Key.Code = Key.Enter Or
      Key.Code = Key.Home Or Key.Code = Key.End Then
    Return
  Endif

  ' TECLAS SIN TEXTO (SHIFT, CTRL, FLECHAS): NO ESCRIBEN NADA Y NO DEBEN SONAR
  If Key.Text = "" Then Return

  ' --- 2. VALIDAR LONGITUD MÁXIMA (INCLUYE EL PREFIJO NN-) ---
  If String.Len(txtArchivoDestino.Text) >= LARGO_MAXIMO_NOMBRE Then
    m_Sonido.sonar("Warning")
    Message.Warning("El nombre del archivo no puede tener más de " & LARGO_MAXIMO_NOMBRE & " caracteres.")
    Stop Event
    Return
  Endif

  ' --- 3. FORZAR PATRÓN POSICIONAL NN- EN LAS PRIMERAS TRES POSICIONES ---
  ' Pos ES 0-INDEXED: 0 Y 1 SON LOS DOS DÍGITOS, 2 ES EL GUION
  iPos = txtArchivoDestino.Pos

  If iPos = 0 Or iPos = 1 Then
    ' LAS DOS PRIMERAS POSICIONES SOLO ACEPTAN DÍGITOS
    If InStr(DIGITOS, Key.Text) = 0 Then
      m_Sonido.sonar("Warning")
      Stop Event
    Endif
    Return
  Endif

  If iPos = 2 Then
    ' LA TERCERA POSICIÓN SOLO ACEPTA EL GUION
    If Key.Text <> "-" Then
      m_Sonido.sonar("Warning")
      Stop Event
    Endif
    Return
  Endif

  ' --- 4. POSICIÓN 3 EN ADELANTE: DÍGITOS, LETRAS Y GUION ---
  ' LAS MINÚSCULAS SE ACEPTAN: KeyRelease LAS PASA A MAYÚSCULAS
  If InStr(CARACTERES_NOMBRE, UCase(Key.Text)) > 0 Then Return

  ' --- 5. BLOQUEAR CUALQUIER OTRO CARÁCTER ---
  Stop Event

End

' ============================================
' Función   : txtArchivoDestino_KeyRelease
' Propósito : Fuerza mayúsculas, valida longitud y actualiza el preview
'             del nombre final con el prefijo de tipo seleccionado
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub txtArchivoDestino_KeyRelease()

  Dim sTexto As String
  Dim iPosicionCursor As Integer

  ' --- 1. GUARDAR POSICIÓN DEL CURSOR ---
  iPosicionCursor = txtArchivoDestino.Pos

  ' --- 2. CONVERTIR A MAYÚSCULAS ---
  sTexto = UCase(txtArchivoDestino.Text)

  ' --- 3. VALIDAR LONGITUD MÁXIMA ---
  If String.Len(sTexto) > LARGO_MAXIMO_NOMBRE Then
    sTexto = String.Left(sTexto, LARGO_MAXIMO_NOMBRE)
    m_Sonido.sonar("Warning")
    Message.Warning("El nombre del archivo no puede tener más de " & LARGO_MAXIMO_NOMBRE & " caracteres.")
    iPosicionCursor = LARGO_MAXIMO_NOMBRE
  Endif

  ' --- 4. ACTUALIZAR TEXTO Y RESTAURAR CURSOR ---
  txtArchivoDestino.Text = sTexto
  txtArchivoDestino.Pos = iPosicionCursor

  ' --- 5. ACTUALIZAR PREVIEW Y VISIBILIDAD DEL BOTÓN CONVERTIR ---
  ActualizarPreviewNombre()
  ActualizarBotonConvertir()

End

' ============================================
' Función   : rbFront_Click
' Propósito : Actualiza el preview al elegir Front Matter
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub rbFront_Click()

  ActualizarPreviewNombre()

End

' ============================================
' Función   : rbBody_Click
' Propósito : Actualiza el preview al elegir el cuerpo
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub rbBody_Click()

  ActualizarPreviewNombre()

End

' ============================================
' Función   : rbBack_Click
' Propósito : Actualiza el preview al elegir Back Matter
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub rbBack_Click()

  ActualizarPreviewNombre()

End

' ============================================
' Función   : ActualizarPreviewNombre
' Propósito : Muestra el nombre final del archivo (prefijo, nombre y
'             extensión) en lblNombreArchivo
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub ActualizarPreviewNombre()

  Dim sPrefijo As String
  Dim sNombre As String

  ' --- 1. DETERMINAR PREFIJO SEGÚN EL TIPO DE PIEZA ACTUAL ---
  Select Case True
    Case rbFront.Value
      sPrefijo = "fm-"
    Case rbBack.Value
      sPrefijo = "bm-"
    Case Else
      sPrefijo = "a-"
  End Select

  ' --- 2. CONSTRUIR Y MOSTRAR EL NOMBRE FINAL O DEJAR VACÍO ---
  sNombre = Trim(txtArchivoDestino.Text)
  If sNombre = "" Then
    lblNombreArchivo.Text = ""
  Else
    lblNombreArchivo.Text = sPrefijo & sNombre & ".md"
  Endif

End

' ============================================
' Función   : ActualizarBotonConvertir
' Propósito : Muestra u oculta btnCONVERTIR según haya origen y nombre
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub ActualizarBotonConvertir()

  btnCONVERTIR.Visible = (Trim(txtArchivoOrigen.Text) <> "" And Trim(txtArchivoDestino.Text) <> "")

End

' ============================================
' Función   : btnCerrar_Click
' Propósito : Habilita el cierre y cierra el formulario
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnCerrar_Click()

  ' EL BOTÓN ESTÁ DESHABILITADO DURANTE LA CONVERSIÓN; ESTO ES LA RED
  If $bConvirtiendo Then Return

  $bCierrePermitido = True
  Me.Close()

End

' ============================================
' Función   : Form_Close
' Propósito : Bloquea el cierre durante una conversión y el cierre desde la X
'             del sistema; permite el que viene del botón Cerrar
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub Form_Close()

  ' --- 1. CONVERSIÓN EN CURSO: NO SE CIERRA ---
  ' CERRAR MATARÍA LA TERMINAL CON EL SCRIPT A MEDIAS
  If $bConvirtiendo Then
    m_Sonido.sonar("Warning")
    Message.Warning("Hay una conversión en curso." & gb.NewLine &
      "Espere a que termine o interrúmpala con Ctrl+C en la terminal.")
    Stop Event
    Return
  Endif

  ' --- 2. CIERRE DESDE EL BOTÓN: PERMITIDO ---
  If $bCierrePermitido Then Return

  ' --- 3. CIERRE DESDE LA X: BLOQUEADO ---
  m_Sonido.sonar("Info")
  Message.Info("Para cerrar el formulario correctamente," & Chr(10) &
    "use el botón <b>Cerrar</b>.")
  Stop Event

End
