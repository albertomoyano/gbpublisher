' Gambas class file

' ============================================
' Clase     : CContribuyente
' Propósito : Un contribuyente del artículo en memoria, con sus afiliaciones
'             y sus roles CRediT, mientras se edita en FMetadatosArticulo. Se
'             graba con el artículo, en su transacción (decisión de Alberto,
'             28/10). Clase chica y no valores sueltos por GV-24: los datos
'             tienen sentido juntos y viajan al diálogo y de vuelta.
' Tablas    : articulo_contribuyente, contribuyente_afiliacion,
'             contribuyente_credit.
' ============================================

' PERSONA: id EN autores. 0 = AUTORÍA COLECTIVA (JATS collab)
Public iIdAutor As Integer
' COLECTIVO: SU NOMBRE. VACÍO EN UNA PERSONA (chk_contrib_quien)
Public sNombreColectivo As String
' CÓMO SE MUESTRA EN LA GRILLA: «Apellidos, Nombre» O EL NOMBRE DEL COLECTIVO
Public sNombre As String
' autor | editor | traductor (m_Articulo.RolesContribuyenteCodigos)
Public sRol As String = "autor"
Public bCorrespondencia As Boolean
' EMAIL EN ESTE ARTÍCULO; OBLIGATORIO SI bCorrespondencia
Public sEmail As String
Public sNotas As String
' ROLES CRediT SEPARADOS POR «; », COMO LOS DEVUELVE FCreditRoles
Public sCredit As String

' AFILIACIONES DEL MOMENTO, EN ORDEN: CINCO ARREGLOS PARALELOS, UNA ENTRADA
' POR AFILIACIÓN. LA INSTITUCIÓN ES OBLIGATORIA; EL ROR VA COMO URL COMPLETA
Public aInstituciones As New String[]
Public aDepartamentos As New String[]
Public aCiudades As New String[]
Public aPaises As New String[]
Public aRors As New String[]

' ============================================
' Función   : Copia
' Propósito : Un duplicado independiente, para que el diálogo edite sobre él
'             y solo se adopte al aceptar
' Parámetros: ninguno
' Retorna   : CContribuyente — la copia, con arreglos propios
' ============================================
Public Function Copia() As CContribuyente

  Dim oCopia As New CContribuyente

  oCopia.iIdAutor = iIdAutor
  oCopia.sNombreColectivo = sNombreColectivo
  oCopia.sNombre = sNombre
  oCopia.sRol = sRol
  oCopia.bCorrespondencia = bCorrespondencia
  oCopia.sEmail = sEmail
  oCopia.sNotas = sNotas
  oCopia.sCredit = sCredit
  ' Copy: LOS ARREGLOS SON OBJETOS; ASIGNARLOS LOS COMPARTIRÍA
  oCopia.aInstituciones = aInstituciones.Copy()
  oCopia.aDepartamentos = aDepartamentos.Copy()
  oCopia.aCiudades = aCiudades.Copy()
  oCopia.aPaises = aPaises.Copy()
  oCopia.aRors = aRors.Copy()

  Return oCopia

End

' ============================================
' Función   : AgregarAfiliacion
' Propósito : Agrega una afiliación al final, en los cinco arreglos a la vez
' Parámetros: sInstitucion, sDepartamento, sCiudad, sPais, sRor As String
' Retorna   : nada
' ============================================
Public Sub AgregarAfiliacion(sInstitucion As String, sDepartamento As String, sCiudad As String, sPais As String, sRor As String)

  aInstituciones.Add(sInstitucion)
  aDepartamentos.Add(sDepartamento)
  aCiudades.Add(sCiudad)
  aPaises.Add(sPais)
  aRors.Add(sRor)

End

' ============================================
' Función   : QuitarAfiliacion
' Propósito : Quita una afiliación de los cinco arreglos a la vez
' Parámetros: iIndice As Integer — posición
' Retorna   : nada
' ============================================
Public Sub QuitarAfiliacion(iIndice As Integer)

  If iIndice < 0 Or iIndice >= aInstituciones.Count Then Return
  aInstituciones.Remove(iIndice)
  aDepartamentos.Remove(iIndice)
  aCiudades.Remove(iIndice)
  aPaises.Remove(iIndice)
  aRors.Remove(iIndice)

End

' ============================================
' Función   : MoverAfiliacion
' Propósito : Intercambia una afiliación con la vecina, en los cinco arreglos
' Parámetros: iIndice As Integer — posición
'             iPaso As Integer — -1 sube, 1 baja
' Retorna   : Integer — la nueva posición; la misma si no se pudo mover
' ============================================
Public Function MoverAfiliacion(iIndice As Integer, iPaso As Integer) As Integer

  Dim iDestino As Integer

  iDestino = iIndice + iPaso
  If iIndice < 0 Or iDestino < 0 Or iDestino >= aInstituciones.Count Then Return iIndice
  ' INTERCAMBIO A MANO: String[] NO TIENE Exchange EN 3.19 (MEDIDO, 28/10)
  Intercambiar(aInstituciones, iIndice, iDestino)
  Intercambiar(aDepartamentos, iIndice, iDestino)
  Intercambiar(aCiudades, iIndice, iDestino)
  Intercambiar(aPaises, iIndice, iDestino)
  Intercambiar(aRors, iIndice, iDestino)

  Return iDestino

End

' ============================================
' Función   : Intercambiar
' Propósito : Intercambia dos posiciones de un arreglo de texto
' Parámetros: aLista As String[] — el arreglo (es un objeto: se modifica)
'             iUna As Integer — una posición
'             iOtra As Integer — la otra
' Retorna   : nada
' ============================================
Private Sub Intercambiar(aLista As String[], iUna As Integer, iOtra As Integer)

  Dim sTexto As String

  sTexto = aLista[iUna]
  aLista[iUna] = aLista[iOtra]
  aLista[iOtra] = sTexto

End
