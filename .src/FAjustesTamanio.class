' Gambas class file

' --- 0. ESTADO LOCAL DEL DIÁLOGO ---
Private $iAnchoOriginal As Integer
Private $iAltoOriginal As Integer

' ============================================
' Función   : Form_Open
' Propósito : CAPTURAR LAS DIMENSIONES ORIGINALES Y DEJAR EL SLIDER EN 100% (NEUTRO).
' ============================================
Public Sub Form_Open()

  ' --- 1. GUARD: DEBE HABER IMAGEN CARGADA ---
  $iAnchoOriginal = m_GestionImagenes.AnchoImagen()
  $iAltoOriginal = m_GestionImagenes.AltoImagen()
  If $iAnchoOriginal = 0 Then
    m_Sonido.sonar("Error")
    Message.Warning(("No hay ninguna imagen cargada."))
    Me.Close()
    Return
  Endif

  ' --- 2. SLIDER EN NEUTRO (100% = TAMAÑO ORIGINAL) ---
  SliderResize.Value = 100

  ' --- 3. INFORME Y SEMÁFORO INICIALES ---
  ActualizarInforme()

End

' ============================================
' Función   : AnchoDestino
' Propósito : CALCULAR EL ANCHO RESULTANTE SEGÚN EL PORCENTAJE DEL SLIDER.
' Retorna   : Integer — ANCHO EN PX (MÍNIMO 1)
' ============================================
Private Function AnchoDestino() As Integer

  Dim iAncho As Integer

  iAncho = Round($iAnchoOriginal * SliderResize.Value / 100)
  If iAncho < 1 Then iAncho = 1
  Return iAncho

End

' ============================================
' Función   : AltoDestino
' Propósito : CALCULAR EL ALTO RESULTANTE SEGÚN EL PORCENTAJE (PRESERVA ASPECTO).
' Retorna: Integer — ALTO EN PX (MÍNIMO 1)
' ============================================
Private Function AltoDestino() As Integer

  Dim iAlto As Integer

  iAlto = Round($iAltoOriginal * SliderResize.Value / 100)
  If iAlto < 1 Then iAlto = 1
  Return iAlto

End

' ============================================
' Función   : ActualizarInforme
' Propósito : MOSTRAR EN lblResize EL PORCENTAJE, EL TAMAÑO ORIGINAL Y EL RESULTANTE,
'             Y PINTAR EL SEMÁFORO CON EL ANCHO HIPOTÉTICO.
' ============================================
Private Sub ActualizarInforme()

  ' --- 1. TEXTO: NN% [ORIG x ORIG] [NUEVO x NUEVO]px ---
  lblResize.Text = SliderResize.Value & "% [" &
    $iAnchoOriginal & "x" & $iAltoOriginal & "] [" &
    AnchoDestino() & "x" & AltoDestino() & "]px"

  ' --- 2. SEMÁFORO DEL ESTADO HIPOTÉTICO (EL DE LA PESTAÑA NO SE TOCA) ---
  m_GestionImagenes.PintarSemaforoEn(pbSemaforoR, AnchoDestino())

End

' ============================================
' Función   : SliderResize_Change
' ============================================
Public Sub SliderResize_Change()

  ActualizarInforme()

End

' ============================================
' Función   : btnAplicar_Click
' Propósito : EJECUTAR EL REESCALADO CON LAS DIMENSIONES CALCULADAS Y CERRAR.
' ============================================
Public Sub btnAplicar_Click()

  ' --- 1. SIN CAMBIO DE TAMAÑO: NO HACER NADA ---
  If SliderResize.Value = 100 Then
    Me.Close()
    Return
  Endif

  ' --- 2. APLICAR Y CERRAR ---
  m_GestionImagenes.AplicarResize(AnchoDestino(), AltoDestino())
  Me.Close()

End

' ============================================
' Función   : btnCerrar_Click
' Propósito : CERRAR SIN APLICAR (NADA QUE DESHACER: NO SE TOCÓ LA IMAGEN).
' ============================================
Public Sub btnCerrar_Click()

  Me.Close()

End
