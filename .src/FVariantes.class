' Gambas class file

' ============================================
' Formulario: FVariantes
' Propósito : Muestra las VARIANTES de una misma palabra en el proyecto, que
'             calcula engine/analizar_lexico.pl desde m_AnalizarProyecto:
'             guion (on-line/online), mayúscula dentro de la oración
'             (Estado/estado) y tilde de la lista cerrada de la RAE
'             (solo/sólo, guion/guión).
'
'             NO MODAL Y ENCIMA DEL PRINCIPAL (m_AnalizarProyecto.VerVariantes:
'             Show y TopOnly, como FOrtografia): se corrige en el editor con la
'             lista a la vista. Un clic en un ejemplo lleva al lugar en el
'             editor (m_AnalizarProyecto.IrAEjemplo). Mientras se corrige, los
'             datos envejecen: el encabezado dice la hora del análisis y
'             «Actualizar» vuelve a analizar.
'
'             No hay número de línea: el análisis sale del AST de Pandoc y el
'             lector markdown no admite sourcepos. Por eso el salto busca la
'             forma en el texto actual del editor.
'
' Controles del .form:
'   lblEncabezado (Label)        — resumen y hora del análisis
'   gvVariantes (GridView)       — una fila por forma, agrupadas
'   lblEjemplos (Label)          — indicación sobre la grilla de abajo
'   gvEjemplos (GridView)        — oraciones de ejemplo de la forma elegida
'   btnActualizar (Button)       — vuelve a analizar el proyecto
'   btnCerrar (Button)
' ============================================

' --- DATOS RECIBIDOS DE m_AnalizarProyecto (por Configurar) ---
' CADA VARIANTE ES UN String[]: id, tipo, forma, cantidad, archivos
' CADA EJEMPLO ES UN String[]: id, forma, archivo, oración
Private $aVariantes As Object[]
Private $aEjemplos As Object[]
Private $sHora As String

' --- EJEMPLOS A LA VISTA: ÍNDICE EN $aEjemplos DE CADA FILA DE gvEjemplos ---
Private $aFilasEjemplo As New Integer[]

' --- ÍNDICES DE CAMPO (EL ORDEN DEL REGISTRO V Y X DEL SCRIPT) ---
Private Const V_ID As Integer = 0
Private Const V_TIPO As Integer = 1
Private Const V_FORMA As Integer = 2
Private Const V_CANTIDAD As Integer = 3
Private Const V_ARCHIVOS As Integer = 4
Private Const X_ID As Integer = 0
Private Const X_FORMA As Integer = 1
Private Const X_ARCHIVO As Integer = 2
Private Const X_ORACION As Integer = 3

' ============================================
' Función   : Form_Show
' Propósito : APLICAR LA CONFIGURACIÓN DE BOTONES DEL MARCO
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub Form_Show()

  m_Ventana.FijarBotones(Me)

End

' ============================================
' Función   : Configurar
' Propósito : RECIBE LOS DATOS DE UN ANÁLISIS. SE LLAMA ANTES DE Show Y, CON
'             LA VENTANA ABIERTA, CADA VEZ QUE TERMINA UN ANÁLISIS NUEVO
'             (SEGUIDA DE Recargar). EL FORMULARIO NO LEE CONTROLES DE FMain
' Parámetros: aVariantes As Object[] — registros V
'             aEjemplos As Object[] — registros X
'             sHora As String — hora del análisis
' Retorna   : nada
' ============================================
Public Sub Configurar(aVariantes As Object[], aEjemplos As Object[], sHora As String)

  $aVariantes = aVariantes
  $aEjemplos = aEjemplos
  $sHora = sHora

End

' ============================================
' Función   : Form_Open
' Propósito : ARMA LAS DOS GRILLAS Y LAS LLENA
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub Form_Open()

  ' --- 1. TÍTULO ---
  Me.Title = "Variantes de una misma palabra en el proyecto"

  ' --- 2. COLUMNAS DE LAS VARIANTES ---
  With gvVariantes
    .Columns.Count = 4
    .Columns[0].Title = "Tipo"
    .Columns[0].Width = 260
    .Columns[1].Title = "Forma"
    .Columns[1].Width = 180
    .Columns[2].Title = "Veces"
    .Columns[2].Width = 70
    .Columns[3].Title = "Archivos"
    .Columns[3].Width = 400
    .Mode = Select.Single
    .Grid = True
    .Header = GridView.Horizontal
  End With

  ' --- 3. COLUMNAS DE LOS EJEMPLOS ---
  With gvEjemplos
    .Columns.Count = 2
    .Columns[0].Title = "Archivo"
    .Columns[0].Width = 160
    .Columns[1].Title = "Oración"
    .Columns[1].Width = 760
    .Mode = Select.Single
    .Grid = True
    .Header = GridView.Horizontal
  End With

  ' --- 4. DATOS ---
  Recargar()

End

' ============================================
' Función   : Recargar
' Propósito : VUELCA LOS DATOS RECIBIDOS EN LA GRILLA DE VARIANTES Y VACÍA LA
'             DE EJEMPLOS. EL TIPO SE ESCRIBE SOLO EN LA PRIMERA FORMA DE CADA
'             GRUPO
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub Recargar()

  ' --- 1. INICIALIZACIÓN ---
  Dim i As Integer
  Dim aReg As String[]
  Dim sIdAnterior As String
  Dim iGrupos As Integer

  ' --- 2. FILAS DE VARIANTES ---
  gvVariantes.Rows.Count = 0
  gvVariantes.Rows.Count = $aVariantes.Count
  For i = 0 To $aVariantes.Max
    aReg = $aVariantes[i]
    If aReg[V_ID] <> sIdAnterior Then
      gvVariantes[i, 0].Text = NombreTipo(aReg[V_TIPO])
      gvVariantes[i, 0].Foreground = Color.Blue
      Inc iGrupos
    Endif
    gvVariantes[i, 1].Text = aReg[V_FORMA]
    gvVariantes[i, 2].Text = aReg[V_CANTIDAD]
    gvVariantes[i, 3].Text = aReg[V_ARCHIVOS]
    sIdAnterior = aReg[V_ID]
  Next

  ' --- 3. EJEMPLOS VACÍOS HASTA ELEGIR UNA FORMA ---
  gvEjemplos.Rows.Count = 0
  $aFilasEjemplo.Clear

  ' --- 4. ENCABEZADO E INDICACIÓN ---
  lblEncabezado.Text = CStr(iGrupos) & " grupo(s) de variantes, según el análisis de las " & $sHora & ". Las citas en bloque no se analizan: respetan la grafía del original."
  lblEjemplos.Text = "Elegí una forma. Clic en un ejemplo: va al lugar en el editor. Desde ahí, F3 sigue a la siguiente aparición."

End

' ============================================
' Función   : NombreTipo
' Propósito : NOMBRE LEGIBLE DEL TIPO DE VARIANTE
' Parámetros: sTipo As String — guion, mayuscula, tilde, tilde-rae
' Retorna   : String — texto de la celda
' ============================================
Private Function NombreTipo(sTipo As String) As String

  Select Case sTipo
    Case "guion"
      Return "Guion"
    Case "mayuscula"
      Return "Mayúscula dentro de la oración"
    Case "tilde"
      Return "Tilde optativa (no recomendada por la RAE)"
    Case "tilde-rae"
      Return "Tilde suprimida (Ortografía 2010)"
  End Select

  Return sTipo

End

' ============================================
' Función   : gvVariantes_Select
' Propósito : LLENA LA GRILLA DE EJEMPLOS CON LOS DE LA FORMA ELEGIDA. VA EN
'             Select: ELEGIR UNA FORMA NO MUEVE EL EDITOR
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub gvVariantes_Select()

  ' --- 1. INICIALIZACIÓN ---
  Dim iFila As Integer
  Dim aVar As String[]
  Dim aEj As String[]
  Dim i As Integer
  Dim iDestino As Integer

  ' --- 2. FILA ELEGIDA ---
  iFila = gvVariantes.Row
  If iFila < 0 Or If iFila >= $aVariantes.Count Then Return
  aVar = $aVariantes[iFila]

  ' --- 3. LOS EJEMPLOS DE ESA FORMA EN ESE GRUPO ---
  gvEjemplos.Rows.Count = 0
  $aFilasEjemplo.Clear
  For i = 0 To $aEjemplos.Max
    aEj = $aEjemplos[i]
    If aEj[X_ID] = aVar[V_ID] And aEj[X_FORMA] = aVar[V_FORMA] Then
      iDestino = gvEjemplos.Rows.Count
      gvEjemplos.Rows.Count = iDestino + 1
      gvEjemplos[iDestino, 0].Text = aEj[X_ARCHIVO]
      gvEjemplos[iDestino, 1].Text = aEj[X_ORACION]
      $aFilasEjemplo.Add(i)
    Endif
  Next

End

' ============================================
' Función   : gvEjemplos_Click
' Propósito : LLEVA EL EDITOR AL LUGAR DEL EJEMPLO. VA EN Click Y NO EN
'             Select: ASIGNAR Row DISPARA Select PERO NUNCA Click (GV-78), ASÍ
'             QUE LLENAR LA GRILLA NO PROVOCA SALTOS
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub gvEjemplos_Click()

  ' --- 1. INICIALIZACIÓN ---
  Dim iFila As Integer
  Dim aEj As String[]

  ' --- 2. EL EJEMPLO DE LA FILA ---
  iFila = gvEjemplos.Row
  If iFila < 0 Or If iFila > $aFilasEjemplo.Max Then Return
  aEj = $aEjemplos[$aFilasEjemplo[iFila]]

  ' --- 3. SALTO: LO RESUELVE EL MÓDULO DUEÑO DEL ANÁLISIS ---
  m_AnalizarProyecto.IrAEjemplo(aEj[X_ARCHIVO], aEj[X_FORMA], aEj[X_ORACION])

End

' ============================================
' Función   : btnActualizar_Click
' Propósito : VUELVE A ANALIZAR EL PROYECTO. AL TERMINAR, EL MÓDULO RECARGA
'             ESTA VENTANA CON LOS DATOS NUEVOS
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnActualizar_Click()

  m_AnalizarProyecto.Analizar()

End

' ============================================
' Función   : btnCerrar_Click
' Propósito : CIERRA EL FORMULARIO
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnCerrar_Click()

  Me.Close()

End

' ============================================
' Función   : Form_Close
' Propósito : AVISA AL MÓDULO QUE LA VENTANA SE CERRÓ, PARA QUE SUELTE LA
'             REFERENCIA Y LA PRÓXIMA VEZ ABRA UNA NUEVA
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub Form_Close()

  m_AnalizarProyecto.VentanaVariantesCerrada()

End
