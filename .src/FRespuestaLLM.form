# Gambas Form File 3.0

{ Form Form
  Move(0,0,860,640)
  #Scaled = False
  Resizable = False
  Arrangement = Arrange.Vertical
  Spacing = True
  Margin = True
  Padding = 4
  { lblEstado Label
    Move(9,9,828,36)
    #Translate = False
  }
  { lblEntrada Label
    Move(9,45,828,36)
    #Translate = False
    Font = Font["Bold"]
    Text = "Entrada biblatex"
  }
  { txaEntrada TextArea
    Move(9,81,612,144)
    Font = Font["Monospace"]
    Expand = True
    ReadOnly = True
    Wrap = True
    ScrollBar = Scroll.Vertical
  }
  { lblDiagnostico Label
    Move(9,342,828,36)
    #Translate = False
    Font = Font["Bold"]
    Text = "Diagnóstico"
  }
  { txaDiagnostico TextArea
    Move(9,378,729,108)
    Expand = True
    ReadOnly = True
    Wrap = True
    ScrollBar = Scroll.Vertical
  }
  { hbxBotones HBox
    Move(9,585,828,36)
    #Translate = False
    { Panel1 Panel
      Move(0,0,63,36)
      Expand = True
    }
    { btnCopiar Button
      Move(396,0,144,36)
      #Translate = False
      Text = "Copiar"
    }
    { btnAplicar Button
      Move(540,0,144,36)
      #Translate = False
      Font = Font["Bold"]
      Background = &H9FFF7F
      Text = "Aplicar"
      Picture = Picture["iconos/enviar.png"]
    }
    { btnCerrar Button
      Move(684,0,144,36)
      #Translate = False
      Text = "Cerrar"
      Picture = Picture["iconos/salir.png"]
    }
  }
}
