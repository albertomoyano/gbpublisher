# Gambas Form File 3.0

{ Form Form
  Move(0,0,960,720)
  #Scaled = False
  Text = ("Reabrir un artículo publicado")
  Resizable = False
  Centered = True
  Arrangement = Arrange.Vertical
  Spacing = True
  Margin = True
  Padding = 4
  { lblRevistaReabrir Label
    Move(9,9,936,36)
    Foreground = &H0000FF
    Alignment = Align.Center
    Border = Border.Plain
  }
  { lblPublicados Label
    Move(9,54,936,36)
    Text = ("Artículos publicados")
  }
  { gvPublicados GridView
    Move(9,99,936,198)
    Expand = True
    Mode = Select.Single
    ShowCursor = True
    Header = GridView.Horizontal
  }
  { hbxMotivoReabrir HBox
    Move(9,306,936,81)
    { lblMotivoReabrir Label
      Move(0,0,170,36)
      Alignment = Align.Right
      Text = ("motivo: ")
    }
    { txaMotivoReabrir TextArea
      Move(173,0,750,81)
      Expand = True
      Wrap = True
      ScrollBar = Scroll.Vertical
    }
  }
  { hbxBotonesReabrir HBox
    Move(9,396,936,36)
    { lblAvisoReabrir Label
      Move(0,0,630,36)
      Foreground = &H0000FF
      Expand = True
      Text = ("Vuelve a «En producción». Lo congelado al publicar queda escrito. La reapertura queda registrada.")
    }
    { btnReabrir Button
      Move(639,0,144,36)
      Text = ("Reabrir")
      Picture = Picture["iconos/clave.png"]
    }
    { btnCerrar Button
      Move(783,0,144,36)
      Text = ("Cerrar")
      Picture = Picture["iconos/salir.png"]
    }
  }
  { lblReaperturas Label
    Move(9,441,936,36)
    Text = ("Registro de reaperturas de la revista")
  }
  { gvReaperturas GridView
    Move(9,486,936,198)
    Expand = True
    Mode = Select.Single
    Header = GridView.Horizontal
  }
}
