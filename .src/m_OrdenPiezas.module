' Gambas module file

' ==========================================================
' MÓDULO    : m_OrdenPiezas
' PROPÓSITO : El orden editorial de las piezas de un libro o de un número de
'             revista, escrito como SQL. Es el ÚNICO lugar donde está: lo usan
'             el ensamblado del PDF del libro, el manifiesto de GitHub y las
'             grillas de los formularios de metadatos. Ninguna consulta debe
'             tener su propio CASE por prefijo escrito a mano.
'
' LA CONVENCIÓN
' ----------------------------------------------------------
'   El nombre de archivo da la posición: prefijo-NN-resto («fm-10-prologo»,
'   «a-03-tal-cosa», «bm-99-colofon»). El prefijo fija la familia
'   (preliminares, cuerpo, finales) y NN el lugar dentro de ella. La
'   numeración de dos dígitos hace que el orden alfabético dentro de cada
'   familia equivalga al numérico.
'
' POR QUÉ NO EL ORDEN ALFABÉTICO SOLO
' ----------------------------------------------------------
'   Da a- < bm- < fm-, exactamente el inverso del orden de lectura. Por eso
'   primero se ordena por familia y después por nombre.
'
' POR QUÉ NO EL id
' ----------------------------------------------------------
'   Un id refleja cuándo se cargó la pieza, no dónde va. Las piezas no llegan
'   juntas ni en orden.
'
' POR QUÉ NO EN m_PiezasLibro
' ----------------------------------------------------------
'   m_PiezasLibro es la matriz de las piezas del LIBRO por salida. Este orden
'   vale también para los artículos de un número de revista, que usan los
'   mismos prefijos.
' ==========================================================

' ============================================
' Función   : ClausulaOrden
' Propósito : Devuelve el criterio de ORDER BY del orden editorial, sin la
'             palabra ORDER BY, para la columna de nombre de archivo indicada
' Parámetros: sColumna As String — columna con el nombre de archivo, tal como
'             se escribe en la consulta («nombre_archivo», «c.nombre_archivo»)
' Retorna   : String — «CASE ... END, <columna>»
' ============================================
Public Function ClausulaOrden(sColumna As String) As String

  ' UN NOMBRE NULL O SIN PREFIJO CONOCIDO CAE EN EL 9: LA PIEZA QUEDA AL
  ' FINAL Y SIGUE VISIBLE, QUE ES LO QUE NECESITA UNA GRILLA PARA EDITARLA
  Return "CASE " &
    "WHEN " & sColumna & " LIKE 'fm-%' THEN 1 " &
    "WHEN " & sColumna & " LIKE 'a-%' THEN 2 " &
    "WHEN " & sColumna & " LIKE 'bm-%' THEN 3 " &
    "ELSE 9 END, " & sColumna

End

' ============================================
' Función   : ExpresionCodigo
' Propósito : Devuelve la expresión SQL que extrae el código de posición del
'             nombre de archivo: todo hasta el segundo guion («fm-10-prologo»
'             → «fm-10»)
' Parámetros: sColumna As String — columna con el nombre de archivo
' Retorna   : String — «SUBSTRING_INDEX(<columna>, '-', 2)»; da NULL si la
'             columna es NULL
' ============================================
Public Function ExpresionCodigo(sColumna As String) As String

  ' SUBSTRING_INDEX CON CONTADOR POSITIVO DEVUELVE LO QUE ESTÁ A LA IZQUIERDA
  ' DEL N-ÉSIMO DELIMITADOR (DOCUMENTACIÓN DE MySQL Y MariaDB)
  Return "SUBSTRING_INDEX(" & sColumna & ", '-', 2)"

End

' ============================================
' Función   : EnEspacioReservado
' Propósito : Dice si un nombre de archivo cae en el espacio reservado de su
'             familia: fm-00 a fm-09 o bm-00 a bm-09. Ahí van las primeras
'             (SC-25) y las piezas sueltas —dedicatoria, foto a página entera,
'             recordatorio—, que no son capítulos y no entran al sumario.
' Parámetros: sNombre As String — nombre_archivo («fm-04-dedicatoria»)
' Retorna   : Boolean — True si el NN del nombre es 00 a 09 en fm o bm
' Nota      : ES LA MISMA REGLA QUE $especial EN docbook-to-latex.xsl, QUE LEE
'             EL NN DEL CANÓNICO (orden-seccion, DERIVADO DEL NOMBRE POR
'             ensamblar-libro-canonico.xsl). SE ACEPTA SOLO LA FORMA DE DOS
'             DÍGITOS QUE FIJA LA CONVENCIÓN (SC-44).
' ============================================
Public Function EnEspacioReservado(sNombre As String) As Boolean

  ' --- 1. INICIALIZACIÓN ---
  Dim aPartes As String[]

  ' --- 2. PARTES DEL NOMBRE: prefijo-NN-resto ---
  ' SIN EL resto, ensamblar-libro-canonico.xsl NO DERIVA EL NN: SE EXIGEN LAS
  ' TRES PARTES PARA COINCIDIR CON LA HOJA
  aPartes = Split(LCase(Trim(sNombre)), "-")
  If aPartes.Count < 3 Then Return False

  ' --- 3. FAMILIA: SOLO PRELIMINARES Y FINALES TIENEN ESPACIO RESERVADO ---
  If aPartes[0] <> "fm" And aPartes[0] <> "bm" Then Return False

  ' --- 4. NÚMERO: LOS DIEZ VALORES DEL ESPACIO, ESCRITOS ---
  Select Case aPartes[1]
    Case "00", "01", "02", "03", "04", "05", "06", "07", "08", "09"
      Return True
  End Select

  Return False

End
