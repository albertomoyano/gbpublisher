' Gambas class file

' ============================================
' Clase     : CHallazgoPar
' Propósito : Representa UN error de emparejamiento detectado por m_Pares.
'             Solo existe para los errores: los pares completos dentro de su
'             propio párrafo no se instancian, porque el grid del panel no los
'             muestra.
'             Las coordenadas se guardan SIEMPRE en valores de la API del
'             TextEditor (0-indexadas, RF-02), no en la numeración que
'             muestra la barra de estado. La conversión para presentar, si
'             hace falta, se hace al escribir la celda y nunca en el dato.
' ============================================

' PÁRRAFO DONDE ESTÁ EL CARÁCTER INVOLUCRADO.
' EQUIVALE A LA PROPIEDAD Line DEL TextEditor (0-INDEXADA)
Public iParrafo As Integer

' AVANCE DENTRO DEL PÁRRAFO, EN CARACTERES Y NO EN BYTES (SC-02).
' EQUIVALE A LA PROPIEDAD Column DEL TextEditor (0-INDEXADA)
Public iPos As Integer

' EL CARÁCTER EFECTIVAMENTE ENCONTRADO
Public sCaracter As String

' CLASE DE FALLA: VER LAS CONSTANTES CLASE_* DE m_Pares
Public iClase As Integer

' NIVEL DE ANIDAMIENTO EN QUE SE ABRIÓ ESTE PAR. SOLO TIENE SENTIDO PARA LAS
' FALLAS QUE NACEN DE UNA APERTURA; UN CIERRE SIN APERTURA LO DEJA EN 0.
' SIRVE PARA SABER, CUANDO HAY VARIOS HALLAZGOS SUPERPUESTOS, CUÁL ES EL
' EXTERIOR Y CUÁL ESTÁ ADENTRO DE OTRO
Public iProfundidad As Integer

' ============================================
' Función   : _new
' Propósito : Construye el hallazgo con sus cuatro datos básicos. La
'             profundidad se asigna aparte, porque no todas las clases de
'             falla la tienen.
' Parámetros: iParrafoOrigen As Integer — párrafo, valor de API
'             iPosOrigen As Integer — posición en el párrafo, valor de API
'             sCaracterOrigen As String — el carácter involucrado
'             iClaseOrigen As Integer — constante CLASE_* de m_Pares
' Retorna   : (constructor, sin retorno)
' ============================================
Public Sub _new(iParrafoOrigen As Integer, iPosOrigen As Integer, sCaracterOrigen As String, iClaseOrigen As Integer)

  iParrafo = iParrafoOrigen
  iPos = iPosOrigen
  sCaracter = sCaracterOrigen
  iClase = iClaseOrigen
  iProfundidad = 0

End
