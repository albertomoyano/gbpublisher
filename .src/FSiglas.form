# Gambas Form File 3.0

{ Form Form
  Move(0,0,960,600)
  #Scaled = False
  Text = ("Siglas")
  Resizable = False
  Arrangement = Arrange.Vertical
  Centered = True
  Spacing = True
  Margin = True
  Padding = 4
  { txaAvisoSiglas TextArea
    Move(9,9,756,72)
    Background = Color.Background
    Foreground = &H0000FF
    NoTabFocus = True
    Text = ("Catálogo de la editorial, común a todos los libros. Corregir una sigla corrige los libros en curso que la usan; los publicados quedan como salieron.")
    ReadOnly = True
    Wrap = True
    ScrollBar = Scroll.Vertical
  }
  { tbsSiglas TabStrip
    Move(9,90,882,441)
    Expand = True
    Arrangement = Arrange.Vertical
    Spacing = True
    Margin = True
    Padding = 4
    Count = 3
    Index = 0
    Text = ("Catálogo")
    Picture = Picture["iconos/siglas.png"]
    { hbxBuscarSigla HBox
      Move(9,9,711,36)
      Spacing = True
      { lblBuscarSigla Label
        Move(0,0,144,36)
        Alignment = Align.Right
        Text = ("buscar: ")
      }
      { txtBuscarSigla TextBox
        Move(159,0,288,36)
        Expand = True
        Placeholder = ("En la sigla o en el desarrollo, sin distinguir tildes ni mayúsculas")
      }
    }
    { hbxCatalogo HBox
      Move(9,45,711,153)
      Expand = True
      Spacing = True
      { gvCatalogo GridView
        Move(0,0,342,144)
        Expand = True
        Mode = Select.Single
        ShowCursor = True
        Header = GridView.Horizontal
      }
      { vbxBotonesCatalogo VBox
        Move(387,0,36,153)
        { btnNuevaSigla Button
          Move(0,0,36,36)
          ToolTip = ("Sigla nueva en el catálogo")
          Picture = Picture["iconos/+nuevo.png"]
        }
        { btnBorrarSigla Button
          Move(0,36,36,36)
          ToolTip = ("Borrar la sigla elegida (solo si ningún libro la usa)")
          Picture = Picture["iconos/borrar.png"]
        }
        { btnAdoptarSigla Button
          Move(9,72,36,36)
          ToolTip = ("Agregar la sigla elegida a este libro")
          Picture = Picture["iconos/vincular.png"]
        }
        { Spring3 Spring
          Move(0,117,36,36)
        }
      }
    }
    { hbxSigla HBox
      Move(9,198,711,36)
      { lblSigla Label
        Move(0,0,144,36)
        Alignment = Align.Right
        Text = ("sigla: ")
      }
      { txtSigla TextBox
        Move(153,0,200,36)
        Placeholder = ("OMS")
        MaxLength = 32
      }
    }
    { hbxDesarrollo HBox
      Move(9,234,711,36)
      { lblDesarrollo Label
        Move(0,0,144,36)
        Alignment = Align.Right
        Text = ("desarrollo: ")
      }
      { txtDesarrollo TextBox
        Move(153,0,423,36)
        Expand = True
        Placeholder = ("Organización Mundial de la Salud — la cursiva va entre asteriscos: *Clarín*")
        MaxLength = 500
      }
    }
    { hbxPlural HBox
      Move(9,270,711,36)
      { lblPlural Label
        Move(0,0,144,36)
        Alignment = Align.Right
        Text = ("plural: ")
      }
      { txtPlural TextBox
        Move(153,0,423,36)
        Expand = True
        Placeholder = ("Opcional: comisiones internas (solo para el texto; la lista lleva el singular)")
        MaxLength = 500
      }
    }
    { hbxIdioma HBox
      Move(9,306,711,36)
      { lblIdioma Label
        Move(0,0,144,36)
        Alignment = Align.Right
        Text = ("idioma: ")
      }
      { cmbIdioma ComboBox
        Move(153,0,120,36)
        ReadOnly = True
      }
      { lblIdiomaNota Label
        Move(282,0,387,36)
        Expand = True
        Text = ("  Vacío: la lengua del libro. Otro idioma: el desarrollo va en cursiva.")
      }
    }
    { hbxBotonesCatalogo HBox
      Move(9,342,711,36)
      { lblEstadoSigla Label
        Move(0,0,234,36)
        Foreground = &H0000FF
        Expand = True
      }
      { btnGuardarSigla Button
        Move(486,0,144,36)
        Text = ("Guardar")
        Picture = Picture["iconos/guardarComo.png"]
      }
    }
    Index = 1
    Text = ("Este libro")
    Picture = Picture["iconos/sigla-libro.png"]
    { gvLibro GridView
      Move(18,99,279,153)
      Expand = True
      Mode = Select.Single
      ShowCursor = True
      Header = GridView.Horizontal
    }
    { hbxBotonesLibro HBox
      Move(18,360,783,36)
      { lblEstadoLibro Label
        Move(0,0,216,36)
        Foreground = &H0000FF
        Expand = True
      }
      { btnSincronizar Button
        Move(603,0,144,36)
        ToolTip = ("Igualar las siglas del libro a las marcas de sus archivos guardados: agrega las marcadas y quita las que no tienen marcas")
        Text = ("Sincronizar")
        Picture = Picture["iconos/agregar-todo.png"]
      }
    }
    Index = 2
    Text = ("Caja de texto temporal")
    Picture = Picture["iconos/textnormal.png"]
    { txaLista TextArea
      Move(9,18,387,198)
      Font = Font["IBM Plex Mono"]
      Expand = True
    }
    { hbxBotonesLista HBox
      Move(9,315,855,36)
      Spacing = True
      { chkAdoptarLista CheckBox
        Move(0,0,260,36)
        Text = ("Agregarlas también a este libro  ")
        Value = CheckBox.True
      }
      { lblEstadoLista Label
        Move(342,0,459,36)
        Background = Color.Background
        Foreground = &H0000FF
        Expand = True
        Alignment = Align.Center
        Border = Border.Plain
        Text = ("Una sigla por línea: «SIGLA: desarrollo». \\emph{…} pasa a cursiva.")
      }
    }
    { hbxBotonesLista2 HBox
      Move(9,360,846,36)
      Spacing = True
      { btnCargarLista Button
        Move(0,0,144,36)
        Text = ("Cargar")
        Picture = Picture["iconos/ok.png"]
      }
      { Spring2 Spring
        Move(675,0,36,36)
      }
    }
    Index = 0
  }
  { hbxBotonesSiglas HBox
    Move(9,549,720,36)
    { btnImportarJSON Button
      Move(0,0,144,36)
      ToolTip = ("Importar en este libro las siglas de un JSON exportado")
      Text = ("Imp. JSON")
      Picture = Picture["iconos/suplementos.png"]
    }
    { btnExportarJSON Button
      Move(153,0,144,36)
      ToolTip = ("Exportar a JSON las siglas de este libro, con sus claves")
      Text = ("Exp. JSON")
      Picture = Picture["iconos/exportar.png"]
    }
    { Spring1 Spring
      Move(306,0,36,36)
    }
    { btnCerrar Button
      Move(531,0,144,36)
      Text = ("Cerrar")
      Picture = Picture["iconos/salir.png"]
    }
  }
}
