' Gambas module file

' POSICIÓN Y TEXTO DE TextoBibDocBook: LA TRADUCCIÓN ES RECURSIVA Y UN
' PRIMITIVO NO VUELVE MODIFICADO POR PARÁMETRO (GV-24)
Private $sBibTexto As String
Private $iBibPos As Integer

' =====================================================
' MÓDULO: m_XML
' =====================================================
' PROPÓSITO:
'   El XML que arma Gambas desde la base y el .bib:
'
'   — Libros (DocBook 5.2): GenerarInfoLibroXML, GenerarInfoCapituloXML,
'       GenerarBiblioLibroXML, GenerarBiblioCapituloXML, GenerarManifiestoLibro
'
'   — Bibliografía JATS del canónico de revista: EscribirRefList
'
'   — Auxiliares de revista: ObtenerIdRevista, EstiloCitaRevista,
'       ArgumentoIdiomaPandoc, PreambuloVistaCuadro (vista de cuadros)
'
'   — Comunes: EscaparXML, TituloXML, SanitizarCitekey, TrimUTF8,
'       ObtenerIdLibro
'
'   EL CAMINO VIEJO DE REVISTAS (FRONT Y BODY JATS, DOAJ, VALIDACIÓN DE
'   INDEXADORES, PDF) SE RETIRÓ EL 18/11/2026 (SC-98). EL CANÓNICO Y LAS
'   SALIDAS DE REVISTA LOS ARMAN LOS SCRIPTS DE engine/ (SC-87 A SC-93)
'
' DEPENDENCIAS:
'   m_ConexionBD   — conexión activa a MySQL/MariaDB
'   m_Sonido       — feedback auditivo
'   FMain          — terminal integrada + valuebox de proyecto
'
' NOTA DTD JATS 1.4 — related-article:
'   Los atributos publication-year, fpage y lpage NO están
'   declarados en la DTD JATS 1.4. Solo vol e issue son válidos.
'   La posición correcta dentro de article-meta es:
'   después de <permissions> y antes de <abstract>.
' =====================================================

' =====================================================
' FUNCIÓN AUXILIAR: EscaparXML
' =====================================================
' DESCRIPCIÓN: ESCAPA CARACTERES ESPECIALES PARA XML
' PARÁMETROS: sTexto — TEXTO A ESCAPAR
' RETORNA:    String — TEXTO ESCAPADO
' =====================================================
Public Function EscaparXML(sTexto As String) As String

  Dim sResultado As String

  sResultado = sTexto
  sResultado = Replace(sResultado, "&", "&amp;")
  sResultado = Replace(sResultado, "<", "&lt;")
  sResultado = Replace(sResultado, ">", "&gt;")
  ' COMILLA DOBLE: USAR Chr(34) (SC-01). EL "\"" LITERAL NO FUNCIONA
  ' EN GAMBAS — BUSCA LA SECUENCIA backslash+comilla, NO LA COMILLA SOLA.
  sResultado = Replace(sResultado, Chr(34), "&quot;")
  sResultado = Replace(sResultado, "'", "&apos;")

  Return sResultado

End

' ============================================
' Función   : TituloXML
' Propósito : Un título o subtítulo de la base listo para el XML canónico,
'             con el corte que escribió el editor traducido al separador del
'             vocabulario (SC-28).
' Parámetros: sTexto     As String — el título tal como está en la base
'             sSeparador As String — m_CorteTitulo.SEPARADOR_JATS o
'                                    m_CorteTitulo.SEPARADOR_DOCBOOK
' Retorna   : String — el título escapado; vacío si no tenía texto
' Nota      : EL ORDEN ES PARTIR, ESCAPAR, UNIR (SC-28). EL SEPARADOR ES
'             MARCADO Y NO SE ESCAPA: POR ESO SE ESCAPA CADA TRAMO SOLO.
' ============================================
Public Function TituloXML(sTexto As String, sSeparador As String) As String

  Dim aTramos As String[]
  Dim i As Integer

  ' --- 1. PARTICIÓN ---
  aTramos = m_CorteTitulo.Tramos(sTexto)

  ' --- 2. ESCAPE DE CADA TRAMO ---
  For i = 0 To aTramos.Max
    aTramos[i] = EscaparXML(aTramos[i])
  Next

  ' --- 3. UNIÓN CON EL SEPARADOR DEL VOCABULARIO ---
  Return aTramos.Join(sSeparador)

End

' ============================================
' Función   : SanitizarCitekey
' Propósito : Convierte un citekey arbitrario a NMTOKEN válido para
'             el atributo id de <ref> y rid de <xref> en JATS.
'             - Caracteres ASCII permitidos (a-zA-Z0-9.-_): se mantienen
'             - Cualquier otro carácter (URLs con /, DOIs con :,
'               espacios, pipes, caracteres multibyte): se reemplaza por '_'
'             - Underscores múltiples se colapsan a uno
'             Determinística: mismo input siempre produce mismo output.
'             La misma lógica está implementada en el filtro Lua
'             cite-to-xref.lua, en la función sanitizar_citekey(),
'             garantizando que el rid del xref en el cuerpo y el id
'             del <ref> en la bibliografía coincidan exactamente para
'             cualquier citekey original posible.
' Parámetros: sCitekey As String — citekey original (puede contener
'             cualquier carácter, incluyendo multibyte)
' Retorna   : String — citekey sanitizado, NMTOKEN-válido
' ============================================
Public Function SanitizarCitekey(sCitekey As String) As String

  Dim sResultado As String
  Dim i As Integer
  Dim sChar As String
  Dim iCodigo As Integer

  ' --- 1. Validación de entrada ---
  If sCitekey = "" Then Return ""

  ' --- 2. Reemplazar caracteres no permitidos por '_' ---
  ' RECORRER CODEPOINT A CODEPOINT CON String.* (SC-02 — UTF-8 SAFE).
  ' SÓLO ACEPTAR ASCII a-zA-Z0-9.-_. CUALQUIER OTRO VA A '_'.
  ' LOS MULTIBYTE (TILDES, EÑES, ETC.) NUNCA SON ASCII PURO → '_'.
  sResultado = ""
  For i = 1 To String.Len(sCitekey)
    sChar = String.Mid(sCitekey, i, 1)
    ' SI EL CODEPOINT OCUPA MÁS DE UN BYTE ES MULTIBYTE → REEMPLAZAR
    If Len(sChar) > 1 Then
      sResultado &= "_"
      Continue
    Endif
    iCodigo = Asc(sChar)
    ' RANGOS ASCII PERMITIDOS:
    '   a-z = 97-122, A-Z = 65-90, 0-9 = 48-57
    '   . = 46, - = 45, _ = 95
    If (iCodigo >= 97 And iCodigo <= 122) Or
        (iCodigo >= 65 And iCodigo <= 90) Or
        (iCodigo >= 48 And iCodigo <= 57) Or
        iCodigo = 46 Or iCodigo = 45 Or iCodigo = 95 Then
      sResultado &= sChar
    Else
      sResultado &= "_"
    Endif
  Next

  ' --- 3. Colapsar underscores múltiples a uno ---
  While InStr(sResultado, "__") > 0
    sResultado = Replace(sResultado, "__", "_")
  Wend

  Return sResultado

End

' =====================================================
' FUNCIÓN AUXILIAR: ExtraerAnio
' =====================================================
' DESCRIPCIÓN: EXTRAE EL AÑO DE UNA FECHA EN FORMATO ISO (YYYY-MM-DD)
' PARÁMETROS: sFecha — STRING CON FECHA
' RETORNA:    String — AÑO EXTRAÍDO
' =====================================================
Private Function ExtraerAnio(sFecha As String) As String

  If InStr(sFecha, "-") > 0 Then
    Return Split(sFecha, "-")[0]
  Else
    Return sFecha
  Endif

End

' =====================================================
' FUNCIÓN AUXILIAR: EncontrarLlaveCorrespondiente
' =====================================================
' DESCRIPCIÓN: ENCUENTRA LA LLAVE DE CIERRE } CORRESPONDIENTE
'              A UNA LLAVE DE APERTURA { EN sTexto
' PARÁMETROS: sTexto     — TEXTO COMPLETO
'             iPosInicio — POSICIÓN DESDE LA QUE BUSCAR
' RETORNA:    Integer — POSICIÓN DE LA LLAVE DE CIERRE, -1 SI NO SE ENCUENTRA
' =====================================================
Private Function EncontrarLlaveCorrespondiente(sTexto As String, iPosInicio As Integer) As Integer

  Dim nivel As Integer = 1
  Dim i As Integer
  Dim caracter As String

  For i = iPosInicio To Len(sTexto)
    caracter = Mid(sTexto, i, 1)
    If caracter = "{" Then
      nivel += 1
    Else If caracter = "}" Then
      nivel -= 1
      If nivel = 0 Then Return i
    Endif
  Next

  Return -1

End

' =====================================================
' FUNCIÓN: GenerarPersonGroup
' =====================================================
' DESCRIPCIÓN: GENERA <person-group> DESDE STRING DE AUTORES BIBTEX
' PARÁMETROS: sNombres — String con autores
'                        (Apellido, Nombre and Apellido2, Nombre2)
'             sTipo    — Tipo de grupo (author, editor, translator)
' RETORNA:    String XML con <person-group>
' =====================================================
Private Function GenerarPersonGroup(sNombres As String, sTipo As String) As String

  Dim sXML As String
  Dim aNombres As String[]
  Dim nombreCompleto As String
  Dim apellido As String
  Dim nombre As String
  Dim posComa As Integer
  Dim i As Integer

  sXML = "      <person-group person-group-type=\"" & sTipo & "\">\n"

  ' --- 1. Normalizar espacios ---
  sNombres = Replace(sNombres, Chr(9), " ")
  sNombres = Replace(sNombres, Chr(160), " ")
  While InStr(sNombres, "  ")
    sNombres = Replace(sNombres, "  ", " ")
  Wend
  sNombres = TrimUTF8(sNombres)

  ' --- 2. Separar autores por " and " ---
  sNombres = Replace(sNombres, " and ", "|||")
  aNombres = Split(sNombres, "|||")

  ' --- 3. Procesar cada autor ---
  For i = 0 To aNombres.Max
    nombreCompleto = TrimUTF8(aNombres[i])
    If Len(nombreCompleto) = 0 Then Continue

    ' AUTORES COLECTIVOS (et al.)
    If nombreCompleto = "others" Or nombreCompleto = "et al" Or nombreCompleto = "et al." Then
      sXML &= "        <etal/>\n"
      Continue
    Endif

    ' FORMATO BIBTEX: Apellido, Nombre
    posComa = InStr(nombreCompleto, ",")
    If posComa > 0 Then
      apellido = TrimUTF8(Left(nombreCompleto, posComa - 1))
      nombre = TrimUTF8(Mid(nombreCompleto, posComa + 1))
    Else
      apellido = nombreCompleto
      nombre = ""
    Endif

    sXML &= "        <name>\n"
    sXML &= "          <surname>" & EscaparXML(apellido) & "</surname>\n"
    If Len(nombre) > 0 Then
      sXML &= "          <given-names>" & EscaparXML(nombre) & "</given-names>\n"
    Endif
    sXML &= "        </name>\n"
  Next

  sXML &= "      </person-group>\n"

  Return sXML

End Function


' =====================================================
' FUNCIÓN: GenerarElementCitationDesdeBib
' =====================================================
' DESCRIPCIÓN: GENERA <element-citation> COMPLETO DESDE ENTRADA BIB
' PARÁMETROS: sEntry      — TEXTO COMPLETO DE LA ENTRADA BIBTEX
'             sType       — TIPO DE ENTRADA (@article, @book, etc.)
'             dictEntries — DICCIONARIO CON TODAS LAS ENTRADAS (PARA crossref)
' RETORNA:    String — XML DE <element-citation>
' =====================================================
Private Function GenerarElementCitationDesdeBib(sEntry As String, sType As String, dictEntries As Collection) As String

  ' COMILLA DOBLE COMO VARIABLE LOCAL — LEGIBILIDAD EN CONSTRUCCIÓN
  ' DE ATRIBUTOS XML (SC-01)
  Dim cQ As String = Chr(34)

  Dim sXML As String = ""
  Dim sPubType As String
  Dim sAuthor As String
  Dim sEditor As String
  Dim sEditorType As String
  Dim sEditorA As String
  Dim sEditorAType As String
  Dim sEditorB As String
  Dim sEditorBType As String
  Dim sEditorC As String
  Dim sEditorCType As String
  Dim sTranslator As String
  Dim sTitle As String
  Dim sSubtitle As String
  Dim sJournal As String
  Dim sBookTitle As String
  Dim sBookSubtitle As String
  Dim sYear As String
  Dim sDate As String
  Dim sVolume As String
  Dim sNumber As String
  Dim sPages As String
  Dim sPublisher As String
  Dim sAddress As String
  Dim sDoi As String
  Dim sIsbn As String
  Dim sIssn As String
  Dim sUrl As String
  Dim sEdition As String
  Dim sSchool As String
  Dim sInstitution As String
  Dim sNote As String
  Dim sEid As String
  Dim sEprint As String
  Dim sEprintType As String
  Dim sSeries As String
  Dim sVersion As String
  Dim sHolder As String
  Dim sMaintitle As String
  Dim sMainsubtitle As String
  Dim sBookauthor As String
  Dim aPages As String[]
  Dim sFinalYear As String
  Dim sTituloCompleto As String
  Dim sBookTitleCompleto As String
  Dim sCrossref As String
  Dim sEntryBase As String

  ' --- 0. Resolver crossref si existe ---
  sCrossref = ParsearCampoBib(sEntry, "crossref")

  If sCrossref <> "" And dictEntries.Exist(sCrossref) Then
    sEntryBase = dictEntries[sCrossref]
    If Lower(TrimUTF8(sType)) = "incollection" Then
      sEntryBase = Replace(sEntryBase, "  title ", "  booktitle ", gb.IgnoreCase)
    Endif
    sEntry = FusionarEntradas(sEntryBase, sEntry)
  Endif

  ' --- 1. Mapear tipo BibTeX → JATS publication-type ---
  Select Case Lower(TrimUTF8(sType))
    Case "periodical"
      sPubType = "newspaper"
    Case "article"
      sPubType = "journal"
    Case "book"
      sPubType = "book"
    Case "incollection", "inbook", "bookinbook"
      sPubType = "book-chapter"
    Case "collection"
      sPubType = "book"
    Case "phdthesis", "mastersthesis", "thesis"
      sPubType = "thesis"
    Case "misc", "online"
      Dim sHowTemp As String = Lower(Trim(ParsearCampoBib(sEntry, "howpublished")))
      Select Case sHowTemp
        Case "carta manuscrita", "carta mecanografiada", "carta", "telegrama"
          sPubType = "letter"
        Case "carta documento", "notificación oficial", "decreto", "resolución", "oficio"
          sPubType = "legal-doc"
        Case "comunicación oficial", "memorándum", "memorando"
          sPubType = "commun"
        Case Else
          If InStr(sHowTemp, "http") > 0 Or InStr(sHowTemp, "www") > 0 Then
            sPubType = "web"
          Else
            sPubType = "other"
          Endif
      End Select
    Case "conference", "inproceedings"
      sPubType = "confproc"
    Case "unpublished"
      Dim sNoteTemp As String = ParsearCampoBib(sEntry, "note")
      If InStr(Lower(sNoteTemp), "congreso") > 0 Or
          InStr(Lower(sNoteTemp), "workshop") > 0 Or
          InStr(Lower(sNoteTemp), "conferencia") > 0 Or
          InStr(Lower(sNoteTemp), "ponencia") > 0 Or
          InStr(Lower(sNoteTemp), "conference") > 0 Then
        sPubType = "confproc"
      Else
        sPubType = "other"
      Endif
    Case "report", "techreport"
      sPubType = "report"
    Case "patent"
      sPubType = "patent"
    Case "manual"
      sPubType = "book"
    Case Else
      sPubType = "other"
  End Select

  ' --- 2. Extraer campos del .bib ---
  sAuthor = ParsearCampoBib(sEntry, "author")
  sEditor = ParsearCampoBib(sEntry, "editor")
  sEditorType = ParsearCampoBib(sEntry, "editortype")
  sEditorA = ParsearCampoBib(sEntry, "editora")
  sEditorAType = ParsearCampoBib(sEntry, "editoratype")
  sEditorB = ParsearCampoBib(sEntry, "editorb")
  sEditorBType = ParsearCampoBib(sEntry, "editorbtype")
  sEditorC = ParsearCampoBib(sEntry, "editorc")
  sEditorCType = ParsearCampoBib(sEntry, "editorctype")
  sTranslator = ParsearCampoBib(sEntry, "translator")
  sTitle = ParsearCampoBib(sEntry, "title")
  sSubtitle = ParsearCampoBib(sEntry, "subtitle")

  ' JOURNAL: PRIORIZAR journaltitle SOBRE journal
  sJournal = ParsearCampoBib(sEntry, "journaltitle")
  If sJournal = "" Then sJournal = ParsearCampoBib(sEntry, "journal")

  sBookTitle = ParsearCampoBib(sEntry, "booktitle")
  sBookSubtitle = ParsearCampoBib(sEntry, "booksubtitle")

  ' AÑO: PRIORIZAR date SOBRE year
  sDate = ParsearCampoBib(sEntry, "date")
  sYear = ParsearCampoBib(sEntry, "year")
  If sDate <> "" Then
    sFinalYear = ExtraerAnio(sDate)
  Else If sYear <> "" Then
    sFinalYear = sYear
  Else
    sFinalYear = ""
  Endif

  sVolume = ParsearCampoBib(sEntry, "volume")
  sNumber = ParsearCampoBib(sEntry, "number")
  sPages = ParsearCampoBib(sEntry, "pages")
  sPublisher = ParsearCampoBib(sEntry, "publisher")

  ' LOCATION (BibLaTeX) o ADDRESS (BibTeX)
  sAddress = ParsearCampoBib(sEntry, "location")
  If sAddress = "" Then sAddress = ParsearCampoBib(sEntry, "address")

  sDoi = ParsearCampoBib(sEntry, "doi")
  sIsbn = ParsearCampoBib(sEntry, "isbn")
  sIssn = ParsearCampoBib(sEntry, "issn")
  sUrl = ParsearCampoBib(sEntry, "url")
  sEdition = ParsearCampoBib(sEntry, "edition")
  sSchool = ParsearCampoBib(sEntry, "school")
  sInstitution = ParsearCampoBib(sEntry, "institution")
  sNote = ParsearCampoBib(sEntry, "note")
  sEid = ParsearCampoBib(sEntry, "eid")
  sEprint = ParsearCampoBib(sEntry, "eprint")
  sEprintType = ParsearCampoBib(sEntry, "eprinttype")
  sSeries = ParsearCampoBib(sEntry, "series")
  sVersion = ParsearCampoBib(sEntry, "version")
  sHolder = ParsearCampoBib(sEntry, "holder")
  sMaintitle = ParsearCampoBib(sEntry, "maintitle")
  sMainsubtitle = ParsearCampoBib(sEntry, "mainsubtitle")
  sBookauthor = ParsearCampoBib(sEntry, "bookauthor")

  ' --- 3. Abrir <element-citation> ---
  sXML &= "    <element-citation publication-type=" & cQ & sPubType & cQ & ">" & gb.NewLine

  ' --- 4. Person-groups ---
  If sAuthor <> "" Then sXML &= GenerarPersonGroup(sAuthor, "author")

  If sEditor <> "" Then
    Dim sTipoEditor As String = MapearTipoEditor(sEditorType)
    sXML &= GenerarPersonGroup(sEditor, sTipoEditor)
  Endif
  If sEditorA <> "" Then
    Dim sTipoEditorA As String = MapearTipoEditor(sEditorAType)
    sXML &= GenerarPersonGroup(sEditorA, sTipoEditorA)
  Endif
  If sEditorB <> "" Then
    Dim sTipoEditorB As String = MapearTipoEditor(sEditorBType)
    sXML &= GenerarPersonGroup(sEditorB, sTipoEditorB)
  Endif
  If sEditorC <> "" Then
    Dim sTipoEditorC As String = MapearTipoEditor(sEditorCType)
    sXML &= GenerarPersonGroup(sEditorC, sTipoEditorC)
  Endif
  If sTranslator <> "" Then sXML &= GenerarPersonGroup(sTranslator, "translator")

  ' --- 5. Títulos ---
  sTituloCompleto = If(sSubtitle <> "", sTitle & ": " & sSubtitle, sTitle)
  sBookTitleCompleto = If(sBookSubtitle <> "", sBookTitle & ": " & sBookSubtitle, sBookTitle)

  If sBookTitleCompleto <> "" Then
    If sTituloCompleto <> "" Then
      sXML &= "      <chapter-title>" & sTituloCompleto & "</chapter-title>" & gb.NewLine
    Endif
    sXML &= "      <source>" & sBookTitleCompleto & "</source>" & gb.NewLine
  Else
    If sTituloCompleto <> "" Then
      Select Case sPubType
        Case "journal", "newspaper"
          sXML &= "      <article-title>" & sTituloCompleto & "</article-title>" & gb.NewLine
        Case Else
          sXML &= "      <source>" & sTituloCompleto & "</source>" & gb.NewLine
      End Select
    Endif
  Endif

  If sJournal <> "" And (sPubType = "journal" Or sPubType = "newspaper") Then
    sXML &= "      <source>" & sJournal & "</source>" & gb.NewLine
  Endif

  If sSeries <> "" And (sPubType = "book" Or InStr(Lower(sType), "collection") > 0) Then
    sXML &= "      <series>" & sSeries & "</series>" & gb.NewLine
  Endif

  ' --- 6. Publisher y ubicación ---
  If sPublisher <> "" Then sXML &= "      <publisher-name>" & sPublisher & "</publisher-name>" & gb.NewLine
  If sAddress <> "" Then sXML &= "      <publisher-loc>" & sAddress & "</publisher-loc>" & gb.NewLine

  ' --- 7. Año, volumen, número ---
  If sFinalYear <> "" Then sXML &= "      <year>" & sFinalYear & "</year>" & gb.NewLine
  If sVolume <> "" Then sXML &= "      <volume>" & sVolume & "</volume>" & gb.NewLine

  If sNumber <> "" Then
    Select Case sPubType
      Case "patent"
        sXML &= "      <patent>" & sNumber & "</patent>" & gb.NewLine
      Case "report"
        sXML &= "      <pub-id pub-id-type=" & cQ & "report-number" & cQ & ">" & sNumber & "</pub-id>" & gb.NewLine
      Case Else
        sXML &= "      <issue>" & sNumber & "</issue>" & gb.NewLine
    End Select
  Endif

  ' --- 8. Paginación o elocation-id ---
  If sEid <> "" Then
    sXML &= "      <elocation-id>" & sEid & "</elocation-id>" & gb.NewLine
  Else If sPages <> "" Then
    If InStr(sPages, "--") > 0 Then
      aPages = Split(sPages, "--")
    Else If InStr(sPages, "-") > 0 Then
      aPages = Split(sPages, "-")
    Else
      sXML &= "      <fpage>" & TrimUTF8(sPages) & "</fpage>" & gb.NewLine
      sXML &= "      <lpage>" & TrimUTF8(sPages) & "</lpage>" & gb.NewLine
      aPages = Null
    Endif
    If aPages Then
      If aPages.Count >= 2 Then
        sXML &= "      <fpage>" & TrimUTF8(aPages[0]) & "</fpage>" & gb.NewLine
        sXML &= "      <lpage>" & TrimUTF8(aPages[1]) & "</lpage>" & gb.NewLine
      Else If aPages.Count = 1 Then
        sXML &= "      <fpage>" & TrimUTF8(aPages[0]) & "</fpage>" & gb.NewLine
        sXML &= "      <lpage>" & TrimUTF8(aPages[0]) & "</lpage>" & gb.NewLine
      Endif
    Endif
  Endif

  ' --- 9. Edición, institución, nota ---
  If sEdition <> "" Then sXML &= "      <edition>" & sEdition & "</edition>" & gb.NewLine

  If sPubType = "thesis" Or sPubType = "report" Then
    If sInstitution <> "" Then
      sXML &= "      <institution>" & sInstitution & "</institution>" & gb.NewLine
    Else If sSchool <> "" Then
      sXML &= "      <institution>" & sSchool & "</institution>" & gb.NewLine
    Endif
  Endif

  If sNote <> "" Then sXML &= "      <comment>" & sNote & "</comment>" & gb.NewLine
  If sVersion <> "" And sPubType = "web" Then
    sXML &= "      <comment>Version " & sVersion & "</comment>" & gb.NewLine
  Endif

  If sHolder <> "" And sPubType = "patent" Then
    Dim sHolderLimpio As String
    sHolderLimpio = Replace(sHolder, "{{", "")
    sHolderLimpio = Replace(sHolderLimpio, "}}", "")
    sHolderLimpio = Replace(sHolderLimpio, "{", "")
    sHolderLimpio = Replace(sHolderLimpio, "}", "")
    sHolderLimpio = Replace(sHolderLimpio, " and ", ", ")
    sXML &= "      <comment>Patent holder: " & sHolderLimpio & "</comment>" & gb.NewLine
  Endif

  ' --- 10. Identificadores ---
  If sIsbn <> "" Then sXML &= "      <isbn>" & sIsbn & "</isbn>" & gb.NewLine
  If sIssn <> "" Then sXML &= "      <issn>" & sIssn & "</issn>" & gb.NewLine
  If sDoi <> "" Then sXML &= "      <pub-id pub-id-type=" & cQ & "doi" & cQ & ">" & sDoi & "</pub-id>" & gb.NewLine
  If sEprint <> "" Then
    If sEprintType <> "" Then sEprintType = Lower(sEprintType)
    sXML &= "      <pub-id pub-id-type=" & cQ & sEprintType & cQ & ">" & sEprint & "</pub-id>" & gb.NewLine
  Endif
  If sUrl <> "" Then
    sXML &= "      <ext-link ext-link-type=" & cQ & "uri" & cQ & " xlink:href=" & cQ & sUrl & cQ & ">" & sUrl & "</ext-link>" & gb.NewLine
  Endif

  sXML &= "    </element-citation>" & gb.NewLine

  Return sXML

End

' =====================================================
' FUNCIÓN: ParsearCampoBib
' =====================================================
' DESCRIPCIÓN: EXTRAE EL VALOR DE UN CAMPO DEL BIB SIN LIMPIAR
' PARÁMETROS: sEntry — TEXTO COMPLETO DE LA ENTRADA BIBTEX
'             sCampo — NOMBRE DEL CAMPO A EXTRAER
' RETORNA:    String — VALOR DEL CAMPO (vacío si no existe)
' =====================================================
Private Function ParsearCampoBib(sEntry As String, sCampo As String) As String

  Dim iStart As Integer
  Dim iEnd As Integer
  Dim sValor As String = ""
  Dim sPatron As String

  ' PATRÓN 1: campo = {valor}
  sPatron = sCampo & " = {"
  iStart = InStr(sEntry, sPatron)

  ' PATRÓN 2: campo={valor}
  If iStart = 0 Then
    sPatron = sCampo & "={"
    iStart = InStr(sEntry, sPatron)
  Endif

  ' PATRÓN 3: buscar por líneas (algunos formatos no estándar)
  If iStart = 0 Then
    Dim aLineas As String[] = Split(sEntry, "\n")
    Dim sLinea As String

    For Each sLinea In aLineas
      sLinea = TrimUTF8(sLinea)
      If Left(sLinea, Len(sCampo)) = sCampo Then
        iStart = InStr(sLinea, "{")
        If iStart > 0 Then
          iEnd = EncontrarLlaveCorrespondiente(sLinea, iStart + 1)
          If iEnd > 0 Then
            sValor = Mid(sLinea, iStart + 1, iEnd - iStart - 1)
            Return TrimUTF8(sValor)
          Endif
        Endif
      Endif
    Next
    Return ""
  Endif

  iStart = iStart + Len(sPatron)
  iEnd = EncontrarLlaveCorrespondiente(sEntry, iStart)
  If iEnd = 0 Then Return ""

  sValor = Mid(sEntry, iStart, iEnd - iStart)
  Return TrimUTF8(sValor)

End

' =====================================================
' FUNCIÓN: FusionarEntradas
' =====================================================
' DESCRIPCIÓN: FUSIONA DOS ENTRADAS BIB PARA RESOLVER crossref.
'              LOS CAMPOS DE sEntryActual TIENEN PRIORIDAD.
' PARÁMETROS: sEntryBase   — ENTRADA BASE (referenciada)
'             sEntryActual — ENTRADA ACTUAL (tiene prioridad)
' RETORNA:    String — ENTRADA FUSIONADA
' =====================================================
Private Function FusionarEntradas(sEntryBase As String, sEntryActual As String) As String

  Dim aLineasBase As String[]
  Dim aLineasActual As String[]
  Dim dictCampos As New Collection
  Dim sLinea As String
  Dim sCampo As String
  Dim iPosIgual As Integer
  Dim sResultado As String
  Dim sPrimeraLinea As String
  Dim i As Integer

  ' --- 1. Parsear entrada base ---
  aLineasBase = Split(sEntryBase, "\n")
  For i = 0 To aLineasBase.Max
    sLinea = aLineasBase[i]
    If Len(Trim(sLinea)) = 0 Then Continue
    If Trim(sLinea) = "}" Then Continue
    iPosIgual = InStr(sLinea, "=")
    If iPosIgual = 0 Then Continue
    sCampo = Trim(Left(sLinea, iPosIgual - 1))
    If InStr(sCampo, "{") > 0 Then Continue
    sCampo = Lower(sCampo)
    dictCampos[sCampo] = sLinea
  Next

  ' --- 2. Parsear entrada actual y sobrescribir ---
  aLineasActual = Split(sEntryActual, "\n")
  sPrimeraLinea = aLineasActual[0]

  For i = 0 To aLineasActual.Max
    sLinea = aLineasActual[i]
    If Len(Trim(sLinea)) = 0 Then Continue
    If Trim(sLinea) = "}" Then Continue
    iPosIgual = InStr(sLinea, "=")
    If iPosIgual = 0 Then Continue
    sCampo = Trim(Left(sLinea, iPosIgual - 1))
    If InStr(sCampo, "{") > 0 Then Continue
    sCampo = Lower(sCampo)
    If sCampo = "crossref" Then Continue
    dictCampos[sCampo] = sLinea
  Next

  ' --- 3. Reconstruir entrada ---
  sResultado = sPrimeraLinea & "\n"
  Dim aKeys As String[] = dictCampos.Keys
  For i = 0 To aKeys.Max
    sCampo = aKeys[i]
    sResultado &= dictCampos[sCampo] & "\n"
  Next
  sResultado &= "}\n"

  Return sResultado

End


' =====================================================
' FUNCIÓN: TrimUTF8
' =====================================================
' DESCRIPCIÓN: ELIMINA ESPACIOS ASCII (0x20) AL INICIO Y FINAL
'              SIN CORROMPER CARACTERES UTF-8 MULTIBYTE.
'              Trim() DE GAMBAS ELIMINA BYTES 0xA0 QUE SON PARTE
'              DE SECUENCIAS UTF-8 VÁLIDAS (ej: à = 0xC3 0xA0)
' PARÁMETROS: sTexto — CADENA A PROCESAR
' RETORNA:    String — CADENA SIN ESPACIOS ASCII AL INICIO/FINAL
' =====================================================
Public Function TrimUTF8(sTexto As String) As String

  Dim iStart As Integer
  Dim iEnd As Integer
  Dim iByte As Integer

  If Not sTexto Then Return ""

  iStart = 1
  iEnd = Len(sTexto)

  While iStart <= iEnd
    iByte = Asc(Mid(sTexto, iStart, 1))
    If iByte <> 32 Then Break
    iStart += 1
  Wend

  While iEnd >= iStart
    iByte = Asc(Mid(sTexto, iEnd, 1))
    If iByte <> 32 Then Break
    iEnd -= 1
  Wend

  If iStart > iEnd Then
    Return ""
  Else
    Return Mid(sTexto, iStart, iEnd - iStart + 1)
  Endif

End Function

' =====================================================
' FUNCIÓN AUXILIAR: MapearTipoEditor
' =====================================================
' DESCRIPCIÓN: MAPEA TIPOS DE EDITOR BIBLATEX A JATS
' PARÁMETROS: sTipoBibLaTeX — TIPO DE EDITOR EN BIBLATEX
' RETORNA:    String — TIPO DE PERSON-GROUP EN JATS
' =====================================================
Private Function MapearTipoEditor(sTipoBibLaTeX As String) As String

  If sTipoBibLaTeX = "" Then Return "editor"

  Select Case Lower(sTipoBibLaTeX)
    Case "editor"
      Return "editor"
    Case "compiler"
      Return "compiler"
    Case "translator"
      Return "translator"
    Case "organizer"
      Return "editor"
    Case Else
      Return "editor"
  End Select

End

' =====================================================
' FUNCIÓN: ObtenerIdRevista
' =====================================================
' DESCRIPCIÓN: OBTIENE EL id_revista CORRESPONDIENTE A UN
'              PROYECTO: LA REVISTA DE SU NÚMERO (numero.id_proyecto ES
'              ÚNICO). HASTA EL 18/11/2026 LEÍA revistas_md (SC-98)
' PARÁMETROS: iIdProyecto — ID DEL PROYECTO A CONSULTAR
' RETORNA:    Integer > 0 si se encontró, 0 si no tiene revista
' =====================================================
Public Function ObtenerIdRevista(iIdProyecto As Integer) As Integer

  Dim hResult As Result

  Try hResult = m_ConexionBD.mConn.Exec(
    "SELECT id_revista FROM numero WHERE id_proyecto = &1 LIMIT 1",
    iIdProyecto)

  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al obtener la revista del proyecto:" & Chr(10) & Error.Text)
    Return 0
  Endif

  If hResult.Available Then
    Return hResult["id_revista"]
  Endif

  Return 0

Catch
  m_Sonido.sonar("Error")
  Message.Error("Error inesperado en ObtenerIdRevista:" & Chr(10) & Error.Text)
  Return 0

End Function

' ============================================
' Función   : IdiomaPrincipalEfectivo
' Propósito : Idioma principal del artículo tal como lo declara el
'             canónico: código ISO 639-1 del catálogo, o el valor tal
'             cual si el catálogo no lo reconoce, o "es" si falta.
'             La usa ArgumentoIdiomaPandoc.
' Parámetros: hArticulo As Result — fila con la columna idioma_principal
' Retorna   : String — código de idioma
' ============================================
Private Function IdiomaPrincipalEfectivo(hArticulo As Result) As String

  ' --- 1. VALOR POR OMISIÓN ---
  If IsNull(hArticulo["idioma_principal"]) Then Return "es"

  ' --- 2. CATÁLOGO DE IDIOMAS (1.3.0): CÓDIGO O NOMBRE → CÓDIGO ---
  If m_Idiomas.Normalizar(TrimUTF8(hArticulo["idioma_principal"])) <> "" Then
    Return m_Idiomas.Normalizar(TrimUTF8(hArticulo["idioma_principal"]))
  Endif

  ' --- 3. NO RECONOCIDO: SE CONSERVA TAL CUAL, COMO EL Case Else ANTERIOR ---
  If Len(TrimUTF8(hArticulo["idioma_principal"])) > 0 Then Return TrimUTF8(hArticulo["idioma_principal"])

  Return "es"

End

' ============================================
' Función   : ArgumentoIdiomaPandoc
' Propósito : El argumento -M gb-idioma=xx que lleva a Pandoc el idioma
'             principal del artículo. Lo lee conversacion.lua para la
'             etiqueta por omisión de los turnos (SC-43). Clave propia y
'             no lang: se eligió por el ODT (retirado, SC-96), donde lang
'             cambiaba además el idioma de citeproc y del documento. HOY
'             LA USA SOLO LA VISTA DE CUADROS (m_Cuadros); EL CANÓNICO DE
'             REVISTA APLICA LA MISMA REGLA EN generar_canonicos_articulos.sh
'             (idioma_pandoc). El valor va a la línea de
'             comandos: solo pasa si son letras ASCII y guiones; si no,
'             va "es", que es también lo que el filtro hace con un
'             idioma fuera de su tabla
' Parámetros: hArticulo As Result — fila con la columna idioma_principal
' Retorna   : String — " -M gb-idioma=xx", con el espacio inicial
' ============================================
Public Function ArgumentoIdiomaPandoc(hArticulo As Result) As String

  Dim sIdioma As String
  Dim sPermitidos As String = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-"
  Dim iPos As Integer

  ' --- 1. EL IDIOMA COMO LO DECLARA EL CANÓNICO ---
  sIdioma = IdiomaPrincipalEfectivo(hArticulo)

  ' --- 2. SOLO LETRAS ASCII Y GUIONES: VA SIN COMILLAS A LA TERMINAL ---
  ' UN CARÁCTER DE VARIOS BYTES NO ESTÁ EN sPermitidos Y TAMBIÉN DESCARTA
  If sIdioma = "" Then sIdioma = "es"
  For iPos = 1 To Len(sIdioma)
    If InStr(sPermitidos, Mid(sIdioma, iPos, 1)) = 0 Then
      sIdioma = "es"
      Break
    Endif
  Next

  ' --- 3. RETORNO ---
  Return " -M gb-idioma=" & sIdioma

End

' ============================================
' Función   : EscribirRefList
' Propósito : Escribe tmp/reflist-{base}.xml: el <ref-list> de JATS 1.4 con
'             las entradas del .bib del proyecto cuyas claves se piden, en
'             ese orden. Es el cuerpo de GenerarRefListXML, separado para que
'             lo use también el canónico de revistas (m_CanonicoRevista), que
'             saca las claves del .md (SC-16). Sin claves escribe un
'             <ref-list/> vacío y devuelve True: el XSLT omite <back>
' Parámetros: sNombreArchivo As String — el archivo del artículo («a-01-tal»)
'             aClaves As String[] — las claves, en el orden de la lista
' Retorna   : Boolean — True si reflist-*.xml quedó escrito
' ============================================
Public Function EscribirRefList(sNombreArchivo As String, aClaves As String[]) As Boolean

  Dim aCitekeys As String[]
  Dim colCitekeys As New Collection
  Dim sBibFile As String
  Dim sBibContent As String
  Dim sEntry As String
  Dim aEntries As String[]
  Dim sType As String
  Dim sCitekey As String
  Dim iPosLlave As Integer
  Dim iPosComa As Integer
  Dim dictEntries As New Collection
  Dim dictTypes As New Collection
  Dim sXML As String
  Dim sDirTmp As String
  Dim sNombreBase As String
  Dim sFilePath As String
  Dim sCk As String

  ' --- 1. RUTA DEL reflist ---
  sDirTmp = m_InicioCierre.RutaProyectoEnCurso &/ "tmp"
  sNombreBase = "reflist-" & Mid(sNombreArchivo, 3)
  sFilePath = sDirTmp & "/" & sNombreBase & ".xml"

  ' --- 2. Sin referencias → ref-list vacío ---
  If aClaves.Count = 0 Then
    Try File.Save(sFilePath, "<ref-list/>" & Chr(10))
    If Error Then
      m_Sonido.sonar("Error")
      Message.Error("Error al guardar reflist vacío en " & sFilePath & ":" & Chr(10) & Error.Text)
      Return False
    Endif
    Return True
  Endif

  ' --- 3. Construir colección de citekeys esperados ---
  aCitekeys = aClaves
  For Each sCk In aCitekeys
    colCitekeys[sCk] = True
  Next

  ' --- 4. Verificar .bib ---
  sBibFile = m_InicioCierre.RutaProyectoEnCurso &/ "referencias/ref-" &
    File.BaseName(m_InicioCierre.NombreProyectoEnCurso) & ".bib"

  If Not Exist(sBibFile) Then
    m_Sonido.sonar("Error")
    Message.Error("No se encontró el archivo de referencias:" & Chr(10) & sBibFile & Chr(10) &
      "Exporte primero las referencias desde la base de datos.")
    Return False
  Endif

  ' --- 5. Leer el .bib ---
  Try sBibContent = File.Load(sBibFile)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al leer el archivo .bib:" & Chr(10) & Error.Text)
    Return False
  Endif

  ' --- 6. Primera pasada: almacenar entradas para crossref ---
  aEntries = Split(sBibContent, "@", "", True)

  For Each sEntry In aEntries
    If TrimUTF8(sEntry) = "" Then Continue
    iPosLlave = InStr(sEntry, "{")
    iPosComa = InStr(sEntry, ",")
    If iPosLlave = 0 Or iPosComa = 0 Then Continue
    sType = TrimUTF8(Left(sEntry, iPosLlave - 1))
    If Lower(sType) = "comment" Or Lower(sType) = "string" Then Continue
    sCitekey = TrimUTF8(Mid(sEntry, iPosLlave + 1, iPosComa - iPosLlave - 1))
    If sCitekey = "" Then Continue
    dictEntries[sCitekey] = sEntry
    dictTypes[sCitekey] = sType
  Next

  ' --- 7. Segunda pasada: generar XML en el orden de referencias_citadas ---
  ' EL NAMESPACE xlink ES OBLIGATORIO PORQUE ext-link USA xlink:href
  ' SIN ESTA DECLARACIÓN EL PARSER XML RECHAZA EL DOCUMENTO Y SAXON LO TRUNCA
  sXML = "<ref-list xmlns:xlink=" & Chr(34) & "http://www.w3.org/1999/xlink" & Chr(34) & ">" & Chr(10)

  ' DETECCIÓN DE COLISIÓN: SI DOS CITEKEYS DISTINTOS PRODUCEN EL MISMO
  ' RESULTADO AL SANITIZARSE (POSIBLE EN BIBLIOGRAFÍAS HEREDADAS CON
  ' CARACTERES ESPECIALES), ABORTAR Y AVISAR. NO APLICAR UN HEURÍSTICO
  ' SILENCIOSO QUE PUEDA FUNDIR DOS REFERENCIAS DISTINTAS BAJO EL MISMO id.
  Dim colSanitizados As New Collection
  Dim sCkSanitizado As String

  For Each sCk In aCitekeys
    sCk = TrimUTF8(sCk)
    If sCk = "" Then Continue

    ' SANITIZAR Y VERIFICAR COLISIÓN ANTES DE PROCESAR LA ENTRADA
    sCkSanitizado = SanitizarCitekey(sCk)
    If colSanitizados.Exist(sCkSanitizado) Then
      ' SI YA SE VIO ESTE SANITIZADO, REVISAR SI ERA EL MISMO ORIGINAL
      If colSanitizados[sCkSanitizado] <> sCk Then
        m_Sonido.sonar("Error")
        Message.Error(
          "Colisión de citekeys al sanitizar para XML JATS:" & Chr(10) & Chr(10) &
          "Original 1: " & colSanitizados[sCkSanitizado] & Chr(10) &
          "Original 2: " & sCk & Chr(10) &
          "Ambos resultan en: " & sCkSanitizado & Chr(10) & Chr(10) &
          "Renombre uno de los dos en el archivo .bib y vuelva a generar el reflist.")
        Return False
      Endif
      ' MISMO CITEKEY APARECE DOS VECES EN referencias_citadas: SALTAR
      Continue
    Endif
    colSanitizados[sCkSanitizado] = sCk

    If Not dictEntries.Exist(sCk) Then
      sXML &= "  <!-- ADVERTENCIA: citekey '" & sCk & "' no encontrado en el .bib -->" & Chr(10)
      Continue
    Endif

    sEntry = dictEntries[sCk]
    sType = dictTypes[sCk]

    ' EL id DEL <ref> USA LA FORMA SANITIZADA, IGUAL QUE EL rid DEL xref
    ' GENERADO POR cite-to-xref.lua. AMBOS COINCIDEN EXACTAMENTE Y EL XML
    ' RESULTANTE ES NMTOKEN-VÁLIDO SEGÚN LA DTD DE JATS.
    sXML &= "  <ref id=" & Chr(34) & "bib-" & sCkSanitizado & Chr(34) & ">" & Chr(10)
    sXML &= GenerarElementCitationDesdeBib(sEntry, sType, dictEntries)
    sXML &= "  </ref>" & Chr(10)
  Next

  sXML &= "</ref-list>" & Chr(10)

  ' --- 8. Guardar ---
  Try File.Save(sFilePath, sXML)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al guardar reflist xml en " & sFilePath & ":" & Chr(10) & Error.Text)
    Return False
  Endif

  Return Exist(sFilePath)

Catch
  m_Sonido.sonar("Error")
  Message.Error("Error inesperado en EscribirRefList:" & Chr(10) &
    Error.Text & Chr(10) & "Donde: " & Error.Where)
  Return False

End Function

' ============================================
' PREÁMBULO DEL PDF VIEJO DE REVISTAS
' EL CAMINO VIEJO (GenerarTeXBodyDesdeCanonico, EnsamblarTeX, CompilarPDF,
' GenerarPDF) SE RETIRÓ EL 18/11/2026 (SC-98). QUEDA SOLO EL PREÁMBULO,
' QUE USA LA VISTA DE CUADROS DE REVISTA (PreambuloVistaCuadro). EL PDF
' NUEVO DE REVISTAS ARMA EL SUYO POR CAPAS EN generar_pdf_revista.sh
' ============================================

' ============================================
' Función   : ObtenerPreambuloEmbebido
' Propósito : Genera el preámbulo LaTeX del PDF viejo de revistas.
'             El marcador %%BIBRESOURCE%% lo vacía
'             PreambuloVistaCuadro, su único llamador.
'             Si existe ~/.gbpublisher/gb-pdf-template.tex,
'             ese archivo tiene prioridad sobre este embebido.
' Retorna   : String — preámbulo LaTeX listo para l-*.tex
' ============================================
Private Function ObtenerPreambuloEmbebido(bBorrador As Boolean, sEstilo As String) As String

  Dim s As String
  Dim sRutaProyecto As String = m_InicioCierre.RutaProyectoEnCurso

  ' --- 1. Clase y opciones ---
  s = "\\documentclass{article}" & Chr(10) & Chr(10)

  ' --- 2. Fuentes y codificación (LuaLaTeX) ---
  s &= "% --- FUENTES Y CODIFICACIÓN ---" & Chr(10)
  s &= "\\usepackage[final,babel=True]{microtype}" & Chr(10)
  s &= "\\microtypecontext{spacing=nonfrench}" & Chr(10)
  s &= "\\usepackage{fontspec}" & Chr(10)
  s &= "\\usepackage{svg}" & Chr(10)
  s &= "\\usepackage{afterpage}" & Chr(10)
  s &= "\\svgsetup{inkscapelatex=false,inkscapearea=drawing}" & Chr(10)
  s &= "\\usepackage{unicode-math}" & Chr(10)
  s &= "\\setmathfont{Libertinus Math}[Scale=MatchLowercase]" & Chr(10)
  s &= "\\setsansfont[Scale=MatchLowercase,Ligatures=TeX," & Chr(10)
  s &= "  Extension=.otf,UprightFont=*-Regular,ItalicFont=*-Italic," & Chr(10)
  s &= "  BoldFont=*-SemiBold,BoldItalicFont=*-SemiBoldItalic]{IBMPlexSansCondensed}" & Chr(10)
  s &= "\\setmonofont[Scale=0.91,Extension=.otf,UprightFont=*-Regular," & Chr(10)
  s &= "  ItalicFont=IBMPlexMono-Italic.otf,BoldFont=IBMPlexMono-Bold.otf," & Chr(10)
  s &= "  BoldItalicFont=IBMPlexMono-BoldItalic.otf]{IBMPlexMono.otf}" & Chr(10)
  s &= Chr(10)

  ' --- 3. Idiomas ---
  s &= "% --- IDIOMAS ---" & Chr(10)
  s &= "\\usepackage[english,portuguese,main=spanish]{babel}" & Chr(10)
  s &= "\\usepackage[autostyle=true]{csquotes}" & Chr(10)
  s &= "\\setmainfont[Numbers={OldStyle,Proportional}," & Chr(10)
  s &= "  Ligatures={TeX,Common,Discretionary},Scale=1.18]{Libertinus Serif}" & Chr(10)
  s &= "\\renewcommand{\\normalsize}{\\fontsize{10pt}{13pt}\\selectfont}" & Chr(10)
  s &= Chr(10)
  ' --- 4. Bibliografía ---
  s &= "% --- BIBLIOGRAFÍA ---" & Chr(10)
  s &= "\\input{" & User.Home & "/.gbpublisher/latex/cita-" & sEstilo & "-config.tex}" & Chr(10)
  ' LAS CADENAS COMUNES A TODOS LOS ESTILOS, DESPUÉS DEL CONFIG: NECESITAN biblatex
  ' CARGADO. RUTA ABSOLUTA, COMO EL CONFIG: \input RESUELVE CONTRA LA CARPETA DE LA
  ' COMPILACIÓN (cita-cadenas-es.tex)
  s &= "\\input{" & User.Home & "/.gbpublisher/latex/cita-cadenas-es.tex}" & Chr(10)
  s &= "%%BIBRESOURCE%%" & Chr(10)
  ' Select Case sEstilo
  '   Case "apa"
  '     s &= "\\usepackage[style=apa,backref=true,backend=biber]{biblatex}" & Chr(10)
  '     s &= "\\input{" & User.Home & "/.gbpublisher/biblatex/apa-config.tex}" & Chr(10)
  '     s &= "%%BIBRESOURCE%%" & Chr(10)
  '   Case "iso690"
  '     s &= "\\usepackage[style=iso-authoryear,backref=true,backend=biber]{biblatex}" & Chr(10)
  '     s &= "\\input{" & User.Home & "/.gbpublisher/biblatex/iso690-config.tex}" & Chr(10)
  '     s &= "%%BIBRESOURCE%%" & Chr(10)
  '   Case "ieee"
  '     s &= "\\usepackage[style=ieee,citestyle=numeric,backref=true,backend=biber]{biblatex}" & Chr(10)
  '     s &= "\\input{" & User.Home & "/.gbpublisher/biblatex/ieee-config.tex}" & Chr(10)
  '     s &= "%%BIBRESOURCE%%" & Chr(10)
  '   Case "vancouver"
  '     s &= "\\usepackage[nocompress]{cite}" & Chr(10)
  '     s &= "\\bibliographystyle{vancouver}" & Chr(10)
  '   Case Else
  '     s &= "\\usepackage[style=apa,backref=true,backend=biber]{biblatex}" & Chr(10)
  '     s &= "%%BIBRESOURCE%%" & Chr(10)
  ' End Select
  s &= Chr(10)
  ' --- 5. Página ---
  ' right=87mm: margen_real(13) + marginparsep(6) + marginparwidth(68) = 87mm
  ' textwidth = 210 - 13 - 87 = 110mm (deducido por geometry)
  ' headheight=29mm: logo(20) + separación(3) + barra(6) = 29mm
  s &= "% --- PÁGINA ---" & Chr(10)
  s &= "\\usepackage[paperwidth=210mm,paperheight=297mm," & Chr(10)
  s &= "  top=13mm,bottom=23mm,left=13mm,right=87mm," & Chr(10)
  s &= "  headsep=0mm,footskip=12mm,headheight=29mm,headsep=10mm," & Chr(10)
  s &= "  marginparsep=6mm,marginparwidth=68mm," & Chr(10)
  If bBorrador Then
    s &= "  includehead,includefoot,showframe]{geometry}" & Chr(10)
  Else
    s &= "  includehead,includefoot]{geometry}" & Chr(10)
  Endif
  s &= "\\setcounter{secnumdepth}{0}" & Chr(10)
  s &= Chr(10)
  ' --- 6. Posicionamiento absoluto ---
  ' \textblockorigin{0mm}{0mm} mide desde la esquina física del papel
  s &= "% --- POSICIONAMIENTO ABSOLUTO ---" & Chr(10)
  s &= "\\usepackage[absolute,overlay]{textpos}" & Chr(10)
  s &= "\\setlength{\\TPHorizModule}{1mm}" & Chr(10)
  s &= "\\setlength{\\TPVertModule}{1mm}" & Chr(10)
  s &= "\\textblockorigin{0mm}{0mm}" & Chr(10)
  s &= "\\newlength{\\gbbloquex}" & Chr(10)
  s &= "\\AtBeginDocument{\\setlength{\\gbbloquex}" &
    "{\\dimexpr 1in+\\hoffset+\\oddsidemargin+\\textwidth+\\marginparsep\\relax}}" & Chr(10)
  s &= Chr(10)
  ' --- 7. Tablas, figuras, varios ---
  s &= "% --- TABLAS Y FIGURAS ---" & Chr(10)
  s &= "\\usepackage{booktabs}" & Chr(10)
  s &= "\\usepackage{graphicx}" & Chr(10)
  s &= "\\usepackage[labelfont=bf,font=small,labelsep=period,format=plain]{caption}" & Chr(10)
  s &= Chr(10)
  s &= "% --- VARIOS ---" & Chr(10)
  ' EPÍGRAFE (SC-35): GEMELA DE \gbepigrafe EN preambulo-contrato.tex
  ' (LIBROS). UN CAMBIO EN UNA VA EN LAS DOS
  s &= "\\newcommand{\\gbepigrafe}[2]{%" & Chr(10)
  s &= "  \\par\\vspace{.5\\baselineskip}%" & Chr(10)
  s &= "  {\\noindent\\hfill" & Chr(10)
  s &= "   \\begin{minipage}{.6\\linewidth}%" & Chr(10)
  s &= "     \\small\\parindent=0pt\\parskip=.5em" & Chr(10)
  s &= "     \\hyphenpenalty=10000\\exhyphenpenalty=10000" & Chr(10)
  s &= "     \\raggedright #1\\par" & Chr(10)
  s &= "     \\if\\relax\\detokenize{#2}\\relax\\else" & Chr(10)
  s &= "       \\parskip=0pt\\vspace{1ex}\\hrule height 0.6pt\\vspace{1ex}%" & Chr(10)
  s &= "       {\\raggedleft #2\\par}%" & Chr(10)
  s &= "     \\fi" & Chr(10)
  s &= "   \\end{minipage}\\par}%" & Chr(10)
  s &= "  \\vspace{.5\\baselineskip}}" & Chr(10)
  s &= "\\usepackage{hyperref}" & Chr(10)
  s &= "\\hypersetup{colorlinks=True,linkcolor=azulrevista,citecolor=azulrevista,urlcolor=azulrevista,filecolor=azulrevista," & Chr(10)
  s &= "linktoc=all,breaklinks=True,bookmarksopen=True,bookmarksnumbered=True}" & Chr(10)
  ' CORTE DE LÍNEA EN EL TÍTULO DEL ARTÍCULO (SC-28): CORTA AL COMPONER, Y EN
  ' LO QUE hyperref PASA A CADENA PDF VALE UN ESPACIO, PORQUE EL QUE LO SIGUE
  ' EN EL TÍTULO LO CONSUME TeX AL LEER EL NOMBRE. HOY NINGÚN METADATO DEL
  ' PDF DEL ARTÍCULO LLEVA EL TÍTULO; LA DESACTIVACIÓN EVITA QUE EL DÍA QUE
  ' LO LLEVE APAREZCA UN \\ EN LA CADENA
  s &= "\\newcommand{\\gbCorteTitulo}{\\\\}" & Chr(10)
  s &= "\\pdfstringdefDisableCommands{\\def\\gbCorteTitulo{ }}" & Chr(10)
  ' NOTA AL PIE EN UN TÍTULO DE SECCIÓN (SC-29): LA EMITE jats-to-latex EN
  ' LA APERTURA DE LA SECCIÓN. CON LA OPCIÓN calcwidth, titlesec COMPONE EL
  ' TÍTULO DOS VECES Y UN \footnote DIRECTO AVANZA DOS VECES EL CONTADOR
  ' (GV-70); \iftitlemeasuring LO EVITA. ESTE PREÁMBULO NO USA calcwidth,
  ' PERO LA MACRO ES LA MISMA DEL CONTRATO DE LIBROS. SI titlesec NO
  ' ESTUVIERA, \iftitlemeasuring SE PROVEE Y SIEMPRE COMPONE
  s &= "\\newcommand{\\gbNotaTitulo}[1]{\\iftitlemeasuring{}{\\footnote{#1}}}" & Chr(10)
  s &= "\\AtBeginDocument{\\providecommand{\\iftitlemeasuring}[2]{#2}}" & Chr(10)
  ' TACHADO Y SUBRAYADO (SC-30): jats-to-latex EMITE \gbTachado Y
  ' \gbSubrayado, LOS MISMOS NOMBRES DEL CONTRATO DE LIBROS. ulem CORTA LA
  ' LÍNEA, QUE \underline NO; [normalem] DEJA \emph EN BASTARDILLA. EN LOS
  ' MARCADORES DEL PDF QUEDA EL TEXTO SOLO
  s &= "\\usepackage[normalem]{ulem}" & Chr(10)
  s &= "\\DeclareRobustCommand{\\gbTachado}[1]{\\sout{#1}}" & Chr(10)
  s &= "\\DeclareRobustCommand{\\gbSubrayado}[1]{\\uline{#1}}" & Chr(10)
  s &= "\\pdfstringdefDisableCommands{\\def\\gbTachado#1{#1}\\def\\gbSubrayado#1{#1}}" & Chr(10)
  s &= "\\usepackage[bottom,stable,hang]{footmisc}" & Chr(10)
  s &= "\\usepackage{scrextend}" & Chr(10)
  s &= "\\usepackage{changepage}" & Chr(10)
  s &= "\\newcommand{\\fullwidthblock}[1]{%" & Chr(10)
  s &= "  \\begin{adjustwidth}{0pt}{-\\dimexpr\\marginparsep+\\marginparwidth\\relax}%" & Chr(10)
  s &= "  \\centering #1%" & Chr(10)
  s &= "  \\end{adjustwidth}%" & Chr(10)
  s &= "}" & Chr(10)
  s &= "\\usepackage{rotating}" & Chr(10)
  ' SEPARACIÓN ENTRE NOTAS
  s &= "\\setlength{\\footnotesep}{10pt}" & Chr(10)
  ' LÍNEA SEPARADORA — SOLO UNA DEFINICIÓN
  s &= "\\renewcommand{\\footnoterule}{%" & Chr(10)
  s &= "  \\kern -3pt%" & Chr(10)
  s &= "  \\hrule height 0.5pt width 0.4\\columnwidth%" & Chr(10)
  s &= "  \\kern 6pt}" & Chr(10)
  ' NUMERACIÓN ENTRE CORCHETES EN SANS SERIF
  s &= "\\renewcommand*{\\thefootnote}{\\scriptsize\\sf{[\\arabic{footnote}]}}" & Chr(10)
  ' TAMAÑO DEL TEXTO DE LA NOTA
  s &= "\\makeatletter" & Chr(10)
  s &= "\\patchcmd{\\@footnotetext}{\\footnotesize}{\\small}{}{}" & Chr(10)
  s &= "\\makeatother" & Chr(10)
  ' POSICIÓN DEL NÚMERO: FUERA DE LA CAJA, ALINEADO A LA DERECHA
  s &= "\\newcommand*\\footnotemarkspace{0em}" & Chr(10)
  s &= "\\deffootnote{\\footnotemarkspace}" & Chr(10)
  s &= "  {\\parindent}" & Chr(10)
  s &= "  {\\makebox[\\footnotemarkspace][r]{\\llap{\\thefootnotemark\\quad}}}" & Chr(10)
  s &= "\\raggedbottom" & Chr(10)
  s &= "\\clubpenalty=10000" & Chr(10)
  s &= "\\widowpenalty=10000" & Chr(10)
  ' CIFRAS Y CANTIDADES (SC-64, SC-65): LA MISMA CONFIGURACIÓN QUE EL CONTRATO
  ' DEL LIBRO (preambulo-contrato.tex, VERSIÓN 15). detect-all NO SE QUITA: SIN
  ' ELLA babel-spanish PASA EL PUNTO DECIMAL A COMA (GV-123). SI CAMBIA, CAMBIA
  ' EL FORMATEADOR DE cifras.lua, QUE ARMA EL TEXTO DEL HTML Y EL EPUB
  s &= "\\usepackage{siunitx}" & Chr(10)
  s &= "\\sisetup{output-decimal-marker={.}," & Chr(10)
  s &= "  group-separator={\\hspace{0.15em}}," & Chr(10)
  s &= "  group-minimum-digits=5," & Chr(10)
  s &= "  table-text-alignment=center," & Chr(10)
  s &= "  detect-all," & Chr(10)
  s &= "  per-mode=symbol}" & Chr(10)
  s &= "\\DeclareSIUnit\\euro{€}" & Chr(10)
  ' CUADROS (SC-66): EL MISMO ESTILO QUE EL LIBRO; LAS MACROS SON GEMELAS DE
  ' LAS DE preambulo-contrato.tex (VERSIÓN 16). UN CAMBIO VA EN LAS DOS.
  ' array: LAS COLUMNAS m{…} CON >{\raggedright\arraybackslash}
  s &= "\\usepackage{array}" & Chr(10)
  s &= "\\newcommand{\\gbCuadroLetra}{\\sffamily}" & Chr(10)
  s &= "\\newcommand{\\gbCuadroCuerpoNormal}{\\footnotesize}" & Chr(10)
  s &= "\\newcommand{\\gbCuadroCuerpoChico}{\\scriptsize}" & Chr(10)
  s &= "\\newcommand{\\gbCuadroSepNormal}{4pt}" & Chr(10)
  s &= "\\newcommand{\\gbCuadroSepEstrecha}{2pt}" & Chr(10)
  ' LOS TEXTOS DE UN CUADRO CORTADO (cortes:), GEMELOS DEL CONTRATO 17
  s &= "\\newcommand{\\gbCuadroContinua}{Continúa en la página siguiente}" & Chr(10)
  s &= "\\newcommand{\\gbCuadroViene}{Viene de la página anterior}" & Chr(10)
  ' EL ANCHO TOTAL (ancho: total, SOLO REVISTAS): COLUMNA, CALLE Y COLUMNA
  ' DERECHA. EL MISMO adjustwidth QUE LA FIGURA DE ANCHO COMPLETO (SC-32);
  ' (changepage YA ESTÁ CARGADO, EN EL APARTADO DE LAS FIGURAS)
  s &= "\\newenvironment{gbcuadrototal}" &
    "{\\begin{adjustwidth}{0pt}{-\\dimexpr\\marginparsep+\\marginparwidth\\relax}}" &
    "{\\end{adjustwidth}}" & Chr(10)
  s &= "\\usepackage{enumitem}" & Chr(10)
  s &= "\\setlist{nosep,topsep=4pt}" & Chr(10)
  ' --- TÍTULOS DE SECCIÓN (titlesec) ---
  s &= "\\usepackage{titlesec}" & Chr(10)
  s &= "\\titleformat{\\section}[hang]" & Chr(10)
  s &= "  {\\sf\\bfseries\\Large\\color{azulrevista}\\raggedright}" & Chr(10)
  s &= "  {\\thesection}{.5em}{}[]" & Chr(10)
  s &= "\\titlespacing{\\section}" & Chr(10)
  s &= "  {\\parindent}{18pt plus 0.5pt minus 0.5pt}{6.75pt}" & Chr(10)
  s &= "\\titleformat{\\subsection}[hang]" & Chr(10)
  s &= "  {\\sf\\large\\color{azulrevista}\\raggedright}" & Chr(10)
  s &= "  {\\thesubsection}{.5em}{}[]" & Chr(10)
  s &= "\\titlespacing{\\subsection}" & Chr(10)
  s &= "  {\\parindent}{18pt plus 0.5pt minus 0.5pt}{6.75pt}" & Chr(10)
  s &= "\\titleformat{\\subsubsection}[hang]" & Chr(10)
  s &= "  {\\rm\\bfseries\\normalsize\\color{azulrevista}\\raggedright}" & Chr(10)
  s &= "  {\\thesubsubsection}{.5em}{}[]" & Chr(10)
  s &= "\\titlespacing{\\subsubsection}" & Chr(10)
  s &= "  {\\parindent}{18pt plus 0.5pt minus 0.5pt}{6.75pt}" & Chr(10)
  s &= "\\titleformat{\\paragraph}[runin]" & Chr(10)
  s &= "  {\\bfseries\\color{azulrevista}}{}{0em}{}[\\mbox{ --- }]" & Chr(10)
  s &= "\\titlespacing{\\paragraph}" & Chr(10)
  s &= "  {0pt}{6.75pt plus 0.5pt minus 0.5pt}{0pt}" & Chr(10)
  s &= "\\titleformat{\\subparagraph}[hang]" & Chr(10)
  s &= "  {\\sf\\bfseries\\large\\color{azulrevista}\\centering}" & Chr(10)
  s &= "  {\\thesubparagraph}{.5em}{}[]" & Chr(10)
  s &= "\\titlespacing{\\subparagraph}" & Chr(10)
  s &= "  {\\parindent}{18pt plus 0.5pt minus 0.5pt}{6.75pt}" & Chr(10)
  s &= "% --- COLOR ---" & Chr(10)
  s &= "\\usepackage[svgnames]{xcolor}" & Chr(10)
  s &= "\\usepackage{tcolorbox}" & Chr(10)
  s &= "\\definecolor{azulrevista}{HTML}{2d5a8e}" & Chr(10)
  ' RECUADROS (SC-41): GEMELOS DE gbRecuadro Y gbRecuadroBarra DE
  ' preambulo-contrato.tex (LIBROS). UN CAMBIO EN UNOS VA EN LOS OTROS.
  ' gbcolorbase ES EL AZUL DE LA REVISTA: \colorlet DESPUÉS DE azulrevista,
  ' PARA QUE UN CAMBIO DE ESE COLOR (color-borravino.lua) LO ARRASTRE.
  ' breakable: UN RECUADRO LARGO CRUZA DE PÁGINA; ACÁ tcolorbox SE CARGA
  ' SIN [most], ASÍ QUE LA BIBLIOTECA SE PIDE APARTE.
  ' LA BARRA VA EN SANS NEGRITA Y MAYÚSCULAS, COMO \articulotipo EN LA CABECERA
  s &= "\\tcbuselibrary{breakable}" & Chr(10)
  s &= "\\colorlet{gbcolorbase}{azulrevista}" & Chr(10)
  s &= "\\tcbset{" & Chr(10)
  s &= "  gbrecuadro/.style={breakable, parbox=false," & Chr(10)
  s &= "    colback=black!7, colframe=gbcolorbase, boxrule=1pt, arc=5pt," & Chr(10)
  s &= "    boxsep=0pt, left=8pt, right=8pt, top=8pt, bottom=8pt," & Chr(10)
  s &= "    before skip=\\baselineskip, after skip=\\baselineskip," & Chr(10)
  s &= "    before upper=\\noindent}," & Chr(10)
  s &= "  gbrecuadrobarra/.style={breakable, parbox=false, sharp corners," & Chr(10)
  s &= "    colback=black!7, colframe=black!7, boxrule=0pt," & Chr(10)
  s &= "    colbacktitle=gbcolorbase, coltitle=white, titlerule=0pt," & Chr(10)
  s &= "    boxsep=0pt, left=8pt, right=8pt, top=8pt, bottom=8pt," & Chr(10)
  s &= "    toptitle=0pt, bottomtitle=0pt, lefttitle=8pt, righttitle=8pt," & Chr(10)
  s &= "    before skip=\\baselineskip, after skip=\\baselineskip," & Chr(10)
  s &= "    before upper=\\noindent}}" & Chr(10)
  s &= "\\newenvironment{gbRecuadro}" & Chr(10)
  s &= "  {\\begin{tcolorbox}[gbrecuadro]}" & Chr(10)
  s &= "  {\\end{tcolorbox}}" & Chr(10)
  s &= "\\newenvironment{gbRecuadroBarra}[1]" & Chr(10)
  s &= "  {\\begin{tcolorbox}[gbrecuadrobarra," & Chr(10)
  s &= "     title={\\parbox[c][1pc][c]{\\linewidth}{\\sffamily\\bfseries\\MakeUppercase{#1}}}]}" & Chr(10)
  s &= "  {\\end{tcolorbox}}" & Chr(10)
  s &= Chr(10)
  ' CONVERSACIÓN (SC-43): GEMELOS DE gbconversacion Y \gbetiqueta DE
  ' preambulo-contrato.tex (LIBROS, CONTRATO 12). UN CAMBIO EN UNOS VA EN LOS
  ' OTROS. SANS, \small, EL BLOQUE CORRIDO 14 PT A LA IZQUIERDA COMO LA CITA
  ' (quote, MÁS ABAJO), SIN SANGRÍA DE PRIMERA LÍNEA, ESPACIO CHICO ENTRE
  ' TURNOS Y PÁRRAFOS,
  ' \medskip AL ABRIR Y AL CERRAR. LA ETIQUETA LLEGA YA EN MAYÚSCULAS Y VA EN
  ' PESO NORMAL; EL \nopagebreak DESPUÉS DE LA PREGUNTA LO ESCRIBE LA HOJA
  s &= "\\newenvironment{gbconversacion}" & Chr(10)
  s &= "  {\\par\\medskip" & Chr(10)
  s &= "   \\begingroup\\sffamily\\small" & Chr(10)
  s &= "   \\setlength{\\leftskip}{14pt}%" & Chr(10)
  s &= "   \\setlength{\\parindent}{0pt}%" & Chr(10)
  s &= "   \\setlength{\\parskip}{\\smallskipamount}}" & Chr(10)
  s &= "  {\\par\\endgroup\\medskip}" & Chr(10)
  s &= "\\newcommand{\\gbetiqueta}[1]{#1\\enspace}" & Chr(10)
  s &= Chr(10)
  ' CÓDIGO (SC-42): GEMELO DE LA SECCIÓN 8 DE preambulo-contrato.tex (LIBROS,
  ' CONTRATO 11). UN CAMBIO EN UNO VA EN EL OTRO, Y EN EL CSS DE jats-to-html.xsl
  ' Y gbpublisher.css. EL COLOR LO PONE colorear_codigo.sh ANTES DE LA HOJA; ACÁ
  ' SOLO SE DEFINE CÓMO SE VE CADA TOKEN. LAS REVISTAS NO VAN A IMPRENTA: SIN
  ' \gbcodigocolorfalse, SIEMPRE EN COLOR. EL CONTADOR gbcodigo NUMERA LOS
  ' LISTADOS 1, 2, 3, APARTE DE LAS FIGURAS. listings SE RETIRÓ.
  s &= "\\usepackage{fancyvrb}" & Chr(10)
  s &= "\\newcounter{gbcodigo}" & Chr(10)
  s &= "\\expandafter\\ifx\\csname ifgbcodigocolor\\endcsname\\relax" & Chr(10)
  s &= "  \\expandafter\\newif\\csname ifgbcodigocolor\\endcsname" & Chr(10)
  s &= "  \\gbcodigocolortrue" & Chr(10)
  s &= "\\fi" & Chr(10)
  s &= "\\ifgbcodigocolor" & Chr(10)
  s &= "  \\definecolor{gbcodfondo}{HTML}{282828}" & Chr(10)
  s &= "  \\definecolor{gbcodmarco}{HTML}{282828}" & Chr(10)
  s &= "  \\definecolor{gbcodtexto}{HTML}{EBDBB2}" & Chr(10)
  s &= "  \\definecolor{gbcodcabeza}{HTML}{3C3836}" & Chr(10)
  s &= "  \\definecolor{gbcodrotulo}{HTML}{A89984}" & Chr(10)
  s &= "  \\definecolor{gbcodnumero}{HTML}{7C6F64}" & Chr(10)
  s &= "\\else" & Chr(10)
  s &= "  \\definecolor{gbcodfondo}{gray}{1}" & Chr(10)
  s &= "  \\definecolor{gbcodmarco}{gray}{0}" & Chr(10)
  s &= "  \\definecolor{gbcodtexto}{gray}{0}" & Chr(10)
  s &= "  \\definecolor{gbcodcabeza}{gray}{0.9}" & Chr(10)
  s &= "  \\definecolor{gbcodrotulo}{gray}{0}" & Chr(10)
  s &= "  \\definecolor{gbcodnumero}{gray}{0.45}" & Chr(10)
  s &= "\\fi" & Chr(10)
  s &= "% \\gbDefTok{NOMBRE}{COLOR HTML}{ESTILO}: DEFINE \\NOMBRETok. EL" & Chr(10)
  s &= "% ESTILO ES \\textbf, \\textit O \\relax. SIN COLOR, SOLO EL ESTILO." & Chr(10)
  s &= "\\newcommand{\\gbDefTok}[3]{%" & Chr(10)
  s &= "  \\ifgbcodigocolor" & Chr(10)
  s &= "    \\expandafter\\newcommand\\csname #1Tok\\endcsname[1]{\\textcolor[HTML]{#2}{#3{##1}}}%" & Chr(10)
  s &= "  \\else" & Chr(10)
  s &= "    \\expandafter\\newcommand\\csname #1Tok\\endcsname[1]{#3{##1}}%" & Chr(10)
  s &= "  \\fi}" & Chr(10)
  s &= "% LAS 31 CLASES DE skylighting" & Chr(10)
  s &= "\\gbDefTok{Normal}{EBDBB2}{\\relax}" & Chr(10)
  s &= "\\gbDefTok{Variable}{EBDBB2}{\\relax}" & Chr(10)
  s &= "\\gbDefTok{Keyword}{83A598}{\\textbf}" & Chr(10)
  s &= "\\gbDefTok{ControlFlow}{83A598}{\\textbf}" & Chr(10)
  s &= "\\gbDefTok{DataType}{FABD2F}{\\relax}" & Chr(10)
  s &= "\\gbDefTok{Attribute}{FABD2F}{\\relax}" & Chr(10)
  s &= "\\gbDefTok{DecVal}{D3869B}{\\relax}" & Chr(10)
  s &= "\\gbDefTok{BaseN}{D3869B}{\\relax}" & Chr(10)
  s &= "\\gbDefTok{Float}{D3869B}{\\relax}" & Chr(10)
  s &= "\\gbDefTok{Constant}{D3869B}{\\relax}" & Chr(10)
  s &= "\\gbDefTok{Char}{B8BB26}{\\relax}" & Chr(10)
  s &= "\\gbDefTok{String}{B8BB26}{\\relax}" & Chr(10)
  s &= "\\gbDefTok{VerbatimString}{B8BB26}{\\relax}" & Chr(10)
  s &= "\\gbDefTok{SpecialString}{B8BB26}{\\relax}" & Chr(10)
  s &= "\\gbDefTok{SpecialChar}{FE8019}{\\relax}" & Chr(10)
  s &= "\\gbDefTok{Import}{FE8019}{\\relax}" & Chr(10)
  s &= "\\gbDefTok{Preprocessor}{FE8019}{\\relax}" & Chr(10)
  s &= "\\gbDefTok{Comment}{928374}{\\textit}" & Chr(10)
  s &= "\\gbDefTok{Documentation}{928374}{\\textit}" & Chr(10)
  s &= "\\gbDefTok{Annotation}{928374}{\\textit}" & Chr(10)
  s &= "\\gbDefTok{CommentVar}{928374}{\\textit}" & Chr(10)
  s &= "\\gbDefTok{Information}{928374}{\\textit}" & Chr(10)
  s &= "\\gbDefTok{RegionMarker}{928374}{\\relax}" & Chr(10)
  s &= "\\gbDefTok{Other}{8EC07C}{\\relax}" & Chr(10)
  s &= "\\gbDefTok{Function}{8EC07C}{\\relax}" & Chr(10)
  s &= "\\gbDefTok{Operator}{8EC07C}{\\relax}" & Chr(10)
  s &= "\\gbDefTok{BuiltIn}{8EC07C}{\\relax}" & Chr(10)
  s &= "\\gbDefTok{Extension}{8EC07C}{\\relax}" & Chr(10)
  s &= "\\gbDefTok{Warning}{FE8019}{\\textbf}" & Chr(10)
  s &= "\\gbDefTok{Alert}{FB4934}{\\textbf}" & Chr(10)
  s &= "\\gbDefTok{Error}{FB4934}{\\relax}" & Chr(10)
  s &= "\\newcommand{\\gbnl}[1]{\\llap{\\textcolor{gbcodnumero}{#1}\\hspace{1.2em}}}" & Chr(10)
  s &= "\\newcommand{\\gbnc}{\\relax}" & Chr(10)
  s &= "\\newcommand{\\gbret}{\\textcolor{gbcodnumero}{\\symbol{\"21A9}}}" & Chr(10)
  s &= "\\tcbset{gbcodigo/.style={breakable, colback=gbcodfondo," & Chr(10)
  s &= "  colframe=gbcodmarco, coltext=gbcodtexto, boxrule=0.4pt, arc=3pt," & Chr(10)
  s &= "  colbacktitle=gbcodcabeza, coltitle=gbcodrotulo, titlerule=0pt," & Chr(10)
  s &= "  fonttitle=\\ttfamily\\scriptsize, toptitle=1pt, bottomtitle=1pt," & Chr(10)
  s &= "  boxsep=0pt, left=3em, right=6pt, top=5pt, bottom=5pt," & Chr(10)
  s &= "  lefttitle=6pt, before skip=\\baselineskip, after skip=\\baselineskip}}" & Chr(10)
  s &= "% \\VerbatimEnvironment: fancyvrb BUSCA \\end{gbCodigo} Y NO" & Chr(10)
  s &= "% \\end{Verbatim}. ES LA FORMA DOCUMENTADA DE ENVOLVER UN Verbatim." & Chr(10)
  s &= "\\newenvironment{gbCodigo}[1]" & Chr(10)
  s &= "  {\\VerbatimEnvironment" & Chr(10)
  s &= "   \\begin{tcolorbox}[gbcodigo,title={#1}]%" & Chr(10)
  s &= "   \\begin{Verbatim}[commandchars=\\\\\\{\\},fontsize=\\footnotesize]}" & Chr(10)
  s &= "  {\\end{Verbatim}\\end{tcolorbox}}" & Chr(10)
  s &= "% EL PIE VA PEGADO AL BLOQUE: SE DESCUENTA PARTE DEL after skip" & Chr(10)
  s &= "\\newcommand{\\gbPieCodigo}[2]{%" & Chr(10)
  s &= "  \\par\\nopagebreak\\vspace{-.5\\baselineskip}%" & Chr(10)
  s &= "  \\refstepcounter{gbcodigo}\\label{#1}%" & Chr(10)
  s &= "  {\\small\\noindent\\textbf{Código~\\thegbcodigo.}\\space #2\\par}%" & Chr(10)
  s &= "  \\vspace{.5\\baselineskip}}" & Chr(10)
  s &= "\\renewenvironment{quote}" &
    "{\\normalsize\\list{}{\\sf\\leftmargin=14pt\\rightmargin=0pt}" &
    "\\item\\relax}{\\endlist}" & Chr(10)
  s &= Chr(10)
  If bBorrador Then
    s &= "\\usepackage[hyphenation,homeoarchy,homeoarchywordcolor=orange," &
      "homeoarchycharcolor=orange,draft]{impnattypo}" & Chr(10)
  Endif
  s &= Chr(10)

  ' --- 8. VERSO (SC-49): EL PAQUETE verse, gbverso Y gbversoepigrafe ---
  ' GEMELOS DE preambulo-contrato.tex (LIBROS, CONTRATO 14): UN CAMBIO EN
  ' UNOS VA EN LOS OTROS. EL verse DEL PAQUETE REEMPLAZA AL QUE SE
  ' REDEFINÍA ACÁ. gbverso: EN BASTARDILLA Y A 14 PT DEL MARGEN, COMO LA
  ' CITA. gbversoepigrafe: EL VERSO DE UN EPÍGRAFE, SIN MARGEN NI \topsep
  ' (GV-94). CADA VERSO EMPIEZA CON \relax (GV-93, LO ESCRIBE LA HOJA)
  s &= "\\usepackage{verse}" & Chr(10)
  s &= "\\newenvironment{gbverso}" & Chr(10)
  s &= "  {\\setlength{\\leftmargini}{14pt}\\begin{verse}\\normalsize\\itshape}" & Chr(10)
  s &= "  {\\end{verse}}" & Chr(10)
  s &= "\\makeatletter" & Chr(10)
  s &= "\\newenvironment{gbversoepigrafe}" & Chr(10)
  s &= "  {\\def\\@listi{\\leftmargin\\z@\\topsep\\z@\\partopsep\\z@\\itemsep\\z@\\parsep\\z@}%" & Chr(10)
  s &= "   \\begin{verse}}" & Chr(10)
  s &= "  {\\end{verse}}" & Chr(10)
  s &= "\\makeatother" & Chr(10)

  ' --- 9. Macro articulotipo (sobreescrita por XSLT) ---
  s &= "\\newcommand{\\articulotipo}{}" & Chr(10)
  s &= Chr(10)

  ' --- 10. Cabecera y pie ---
  ' headwidth = textwidth(110) + marginparsep(6) + marginparwidth(68) = 184mm
  s &= "% --- HEADER / FOOTER ---" & Chr(10)
  s &= "\\usepackage{fancyhdr}" & Chr(10)
  s &= "\\setlength{\\headwidth}{\\textwidth}" & Chr(10)
  s &= "\\addtolength{\\headwidth}{\\marginparsep}" & Chr(10)
  s &= "\\addtolength{\\headwidth}{\\marginparwidth}" & Chr(10)
  s &= Chr(10)

  ' ESTILO PRIMERA PÁGINA
  s &= "\\fancypagestyle{firstpage}{%" & Chr(10)
  s &= "  \\fancyhf{}%" & Chr(10)
  s &= "  \\fancyhead[L]{%" & Chr(10)
  s &= "    \\begin{minipage}[t]{\\headwidth}%" & Chr(10)
  s &= "    \\includegraphics[width=184mm,height=20mm,keepaspectratio=false]{" &
    sRutaProyecto &/ "media" &/ "logo-revista.png" & "}\\\\[3mm]%" & Chr(10)
  s &= "      {\\setlength{\\fboxsep}{0pt}%" & Chr(10)
  s &= "      \\colorbox{azulrevista}{%" & Chr(10)
  s &= "        \\parbox[c][6mm][c]{\\headwidth}{%" & Chr(10)
  s &= "          \\hspace{12pt}\\sffamily\\bfseries\\color{white}\\articulotipo%" & Chr(10)
  s &= "        }%" & Chr(10)
  s &= "      }}%" & Chr(10)
  s &= "    \\end{minipage}%" & Chr(10)
  s &= "  }%" & Chr(10)
  s &= "  \\renewcommand{\\headrulewidth}{0pt}%" & Chr(10)
  s &= "  \\fancyfoot[L]{%" & Chr(10)
  s &= "    \\begin{minipage}[t]{\\headwidth}%" & Chr(10)
  s &= "      \\textcolor{azulrevista}{\\rule{\\headwidth}{1pt}}\\\\[1pt]%" & Chr(10)
  s &= "      \\sffamily\\thepage\\hfill%" & Chr(10)
  s &= "      \\small\\articulorevista{} / e-ISSN: \\texttt{\\articuloissne}" &
    "{} / Vol.~\\articulovolumen{},~n.\\textsuperscript{o}~\\articulonumero{} / \\articulofecha%" & Chr(10)
  s &= "    \\end{minipage}%" & Chr(10)
  s &= "  }%" & Chr(10)
  s &= "  \\renewcommand{\\footrulewidth}{0pt}%" & Chr(10)
  s &= "}%" & Chr(10)
  s &= Chr(10)

  ' ESTILO PÁGINAS 2+
  s &= "\\pagestyle{fancy}" & Chr(10)
  s &= "\\fancyhf{}" & Chr(10)
  s &= "\\fancyhead[L]{%" & Chr(10)
  s &= "  \\raisebox{\\dimexpr\\headheight-7mm\\relax}[0pt][0pt]{%" & Chr(10)
  s &= "    \\begin{minipage}[b]{\\headwidth}%" & Chr(10)
  s &= "      \\sffamily\\thepage\\hfill%" & Chr(10)
  s &= "      \\small\\articulorevista{} / e-ISSN: \\texttt{\\articuloissne}" &
    "{} / Vol.~\\articulovolumen{},~n.\\textsuperscript{o}~\\articulonumero{} / \\articulofecha\\\\[1pt]%" & Chr(10)
  s &= "      \\textcolor{azulrevista}{\\rule{\\headwidth}{1pt}}%" & Chr(10)
  s &= "    \\end{minipage}%" & Chr(10)
  s &= "  }%" & Chr(10)
  s &= "}%" & Chr(10)
  s &= "\\renewcommand{\\headrulewidth}{0pt}" & Chr(10)
  s &= Chr(10)

  ' --- 10. Macros del artículo (sobreescritas por XSLT) ---
  s &= "% --- MACROS DEL ARTÍCULO (SOBREESCRITAS POR EL XSLT) ---" & Chr(10)
  s &= "\\newcommand{\\articulotitulo}{}" & Chr(10)
  s &= "\\newcommand{\\articulosubtitulo}{}" & Chr(10)
  s &= "\\newcommand{\\articulotitulotrans}{}" & Chr(10)
  s &= "\\newcommand{\\articuloautores}{}" & Chr(10)
  s &= "\\newcommand{\\articulodoi}{}" & Chr(10)
  s &= "\\newcommand{\\articuloidiomaxml}{es}" & Chr(10)
  s &= "\\newcommand{\\articulorevista}{}" & Chr(10)
  s &= "\\newcommand{\\articuloissne}{}" & Chr(10)
  s &= "\\newcommand{\\articulovolumen}{}" & Chr(10)
  s &= "\\newcommand{\\articulonumero}{}" & Chr(10)
  s &= "\\newcommand{\\articulofecha}{}" & Chr(10)
  s &= "\\newcommand{\\articulopagina}{0}" & Chr(10)
  s &= Chr(10)

  ' --- 11. Apertura del documento ---
  s &= "\\begin{document}" & Chr(10)

  Return s

End Function

' ============================================
' Función   : EstiloCitaRevista
' Propósito : El estilo de cita de la revista, como lo usa el preámbulo del
'             PDF: el nombre del CSL de revistas_md.estilo_cita reducido al
'             identificador corto (apa, iso690, ieee, vancouver). Es lo que
'             hacía el apartado 2 de m_GenerarPDF.GenerarPDFunaColumna, que
'             ahora la llama: el PDF y la vista previa de los cuadros (SC-67)
'             no pueden leer el estilo de dos maneras
' Parámetros: iIdRevista As Integer
' Retorna   : String — el identificador; vacío si la revista no lo tiene o
'             la consulta falla (EL PDF LO RECIBÍA ASÍ Y ASÍ SIGUE)
' ============================================
Public Function EstiloCitaRevista(iIdRevista As Integer) As String

  Dim hEstilo As Result
  Dim sEstilo As String

  ' --- 1. LA BASE; If ANIDADO: And NO CORTOCIRCUITA (RC-GM-17) ---
  Try hEstilo = m_ConexionBD.mConn.Exec(
    "SELECT estilo_cita FROM revista WHERE id_revista = &1 LIMIT 1", iIdRevista)
  If Not Error Then
    If hEstilo.Available Then sEstilo = m_Metadatos.NullToString(hEstilo["estilo_cita"])
  Endif

  ' --- 2. DEL NOMBRE DEL CSL AL IDENTIFICADOR: apa.csl → apa ---
  sEstilo = LCase(File.BaseName(sEstilo))
  If sEstilo Begins "apa" Then
    sEstilo = "apa"
  Else If InStr(sEstilo, "iso690") > 0 Or sEstilo Begins "iso" Then
    sEstilo = "iso690"
  Else If sEstilo Begins "ieee" Then
    sEstilo = "ieee"
  Else If sEstilo Begins "vancouver" Or InStr(sEstilo, "numeric") > 0 Then
    sEstilo = "vancouver"
  Endif

  Return sEstilo

End

' ============================================
' Función   : PreambuloVistaCuadro
' Propósito : El preámbulo de la vista previa de un cuadro de revista
'             (SC-67): el del PDF en borrador —con showframe—, sin la
'             bibliografía y sin \begin{document}, que lo pone el maestro de
'             engine/vista_cuadro.sh
' Parámetros: sEstilo As String — de EstiloCitaRevista
' Retorna   : String
' Nota      : CONSERVA hyperref, AL REVÉS QUE EL DEL LIBRO: ACÁ VA EMBEBIDO A
'             MITAD DEL PREÁMBULO Y SEGUIDO DE \pdfstringdefDisableCommands,
'             QUE SIN ÉL NO EXISTE. EN EL LIBRO ES UNA CAPA APARTE Y EL
'             CONTRATO NO DEPENDE DE ELLA
' ============================================
Public Function PreambuloVistaCuadro(sEstilo As String) As String

  Dim s As String
  Dim iPos As Integer

  ' --- 1. EL DEL PDF, EN BORRADOR ---
  s = ObtenerPreambuloEmbebido(True, sEstilo)

  ' --- 2. SIN .bib: EL CUADRO SOLO NO RESUELVE CITAS, Y biblatex COMPONE IGUAL ---
  s = Replace(s, "%%BIBRESOURCE%%", "")

  ' --- 3. SIN \begin{document}: ES LA ÚLTIMA LÍNEA DEL PREÁMBULO ---
  iPos = RInStr(s, "\\begin{document}")
  If iPos > 0 Then s = Left(s, iPos - 1)

  Return s

End

' =====================================================
' FUNCIÓN: ObtenerIdLibro
' =====================================================
' DESCRIPCIÓN: OBTIENE EL id_libro CORRESPONDIENTE A UN
'              PROYECTO (RELACIÓN 1 A 1 proyecto → libro)
' PARÁMETROS: iIdProyecto — ID DEL PROYECTO A CONSULTAR
' RETORNA:    Integer > 0 si se encontró, 0 si no tiene libro
' =====================================================
Public Function ObtenerIdLibro(iIdProyecto As Integer) As Integer

  Dim hResult As Result

  Try hResult = m_ConexionBD.mConn.Exec(
    "SELECT id_libro FROM libros_md WHERE id_proyecto = &1 LIMIT 1",
    iIdProyecto)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al obtener el libro del proyecto:" & Chr(10) & Error.Text)
    Return 0
  Endif
  If hResult.Available Then
    Return hResult["id_libro"]
  Endif
  Return 0
Catch
  m_Sonido.sonar("Error")
  Message.Error("Error inesperado en ObtenerIdLibro:" & Chr(10) & Error.Text)
  Return 0

End Function

' ==========================================================
' BLOQUE DE FUNCIONES PARA GENERACIÓN DE BIBLIOGRAFÍA DOCBOOK 5.2
' ==========================================================
'
' DEPENDENCIAS (YA EXISTEN EN m_XML):
'   - ParsearCampoBib(sEntry, sCampo) As String
'   - FusionarEntradas(sEntryBase, sEntryActual) As String
'   - ExtraerAnio(sFecha) As String
'   - EscaparXML(sTexto) As String
'   - SanitizarCitekey(sCitekey) As String
'   - TrimUTF8(sTexto) As String
'
' ANÁLOGOS JATS (REVISTAS) QUE SE REPLICAN:
'   - (ConvertirTipoJATS, YA ELIMINADA: EL MAPEO JATS QUEDÓ EN LÍNEA
'     EN GenerarElementCitationDesdeBib) → ConvertirTipoDocBook
'   - MapearTipoEditor          → MapearTipoEditorDocBook
'   - GenerarPersonGroup        → GenerarPersonGroupDocBook
'   - GenerarElementCitationDesdeBib → GenerarBiblioentryDesdeBib
'   - EscribirRefList           → GenerarBiblioCapituloXML
'                                  (+ GenerarBiblioLibroXML PARA CONSOLIDADA)
'
' CONVENCIÓN DE ASOCIACIÓN (RC-BIB-01):
'   La asociación bibtex ↔ artículo/capítulo NO usa FKs ni id_articulo.
'   El matching es por clave_bibtex: en libros, contra el CSV de citekeys de
'   capitulos.referencias_citadas; en revistas, contra las claves que el
'   canónico saca del .md (SC-16; la tabla vieja articulos salió, SC-98).
'   El .bib es compartido a nivel proyecto.
' ==========================================================

' ============================================
' Función   : ConvertirTipoDocBook
' Propósito : MAPEA UN TIPO DE ENTRADA BIBTEX/BIBLATEX AL VALOR DEL
'             ATRIBUTO pubwork DE <biblioentry> EN DOCBOOK 5.2.
'             PARA TIPOS SIN EQUIVALENTE NATIVO (TESIS, REPORTE,
'             PONENCIA, PATENTE, PERIÓDICO) DEVUELVE "other"; EL TIPO
'             REAL SE PRESERVA VÍA ConvertirOtherpubwork EN EL ATRIBUTO
'             otherpubwork.
' Parámetros: sTipoBibTeX As String — TIPO DE ENTRADA (article, book, ...)
' Retorna   : String — VALOR pubwork VÁLIDO EN DOCBOOK 5.2, O CADENA
'             VACÍA PARA TIPOS DEMASIADO GENÉRICOS (misc, software).
' ============================================
Private Function ConvertirTipoDocBook(sTipoBibTeX As String) As String

  ' --- 1. TABLA DE MAPEO A VALORES VÁLIDOS DE pubwork EN DOCBOOK 5.2 ---
  ' VALORES VÁLIDOS: article, bbs, book, cdrom, chapter, dvd, emailmessage,
  ' gopher, journal, manuscript, newsposting, other, part, refentry, section,
  ' series, set, webpage, wiki.
  ' LOS TIPOS SIN EQUIVALENTE NATIVO SE MAPEAN A "other" Y PRESERVAN SU
  ' NATURALEZA EN otherpubwork (VER ConvertirOtherpubwork).
  Dim mapeo As New Collection

  mapeo["article"] = "article"
  mapeo["book"] = "book"
  mapeo["inbook"] = "chapter"
  mapeo["incollection"] = "chapter"
  mapeo["bookinbook"] = "chapter"
  mapeo["collection"] = "book"
  mapeo["proceedings"] = "book"
  mapeo["manual"] = "book"
  mapeo["booklet"] = "book"
  mapeo["online"] = "webpage"
  mapeo["unpublished"] = "manuscript"

  ' TIPOS SIN EQUIVALENTE NATIVO: pubwork="other", TIPO REAL EN otherpubwork
  mapeo["thesis"] = "other"
  mapeo["phdthesis"] = "other"
  mapeo["mastersthesis"] = "other"
  mapeo["techreport"] = "other"
  mapeo["report"] = "other"
  mapeo["inproceedings"] = "other"
  mapeo["conference"] = "other"
  mapeo["periodical"] = "other"
  mapeo["patent"] = "other"

  ' TIPOS DEMASIADO GENÉRICOS: SIN pubwork (SE EMITE SIN EL ATRIBUTO)
  mapeo["misc"] = ""
  mapeo["software"] = ""
  mapeo["dataset"] = ""

  ' --- 2. RETORNAR EL VALOR O CADENA VACÍA SI NO HAY MATCH ---
  If mapeo.Exist(Lower(sTipoBibTeX)) Then
    Return mapeo[Lower(sTipoBibTeX)]
  Else
    Return ""
  Endif

End

' ────────────────────────────────────────────────────────────────────────────
' MODIFICACIÓN 2 — Agregar la función auxiliar ConvertirOtherpubwork
' (colocar inmediatamente después de ConvertirTipoDocBook)
' ────────────────────────────────────────────────────────────────────────────

' ============================================
' Función   : ConvertirOtherpubwork
' Propósito : PARA TIPOS BIBLATEX SIN EQUIVALENTE NATIVO EN @pubwork,
'             DEVUELVE EL VALOR DEL ATRIBUTO otherpubwork (NMTOKEN) QUE
'             PRESERVA LA NATURALEZA REAL DE LA OBRA. SOLO SE USA CUANDO
'             ConvertirTipoDocBook DEVOLVIÓ "other".
'             DEVUELVE CADENA VACÍA PARA TIPOS CON pubwork NATIVO.
' Parámetros: sTipoBibTeX As String — TIPO DE ENTRADA (thesis, report, ...)
' Retorna   : String — VALOR otherpubwork (NMTOKEN: SIN ESPACIOS), O
'             CADENA VACÍA SI EL TIPO TIENE pubwork NATIVO.
' ============================================
Private Function ConvertirOtherpubwork(sTipoBibTeX As String) As String

  ' --- 1. TABLA DE TIPOS QUE VAN A pubwork="other" ---
  ' EL VALOR ES UN NMTOKEN (SIN ESPACIOS NI CARACTERES ESPECIALES) QUE
  ' IDENTIFICA LA NATURALEZA REAL DE LA OBRA PARA EL XSLT DE SALIDA.
  Dim mapeoOtro As New Collection

  mapeoOtro["thesis"] = "thesis"
  mapeoOtro["phdthesis"] = "thesis"
  mapeoOtro["mastersthesis"] = "thesis"
  mapeoOtro["techreport"] = "report"
  mapeoOtro["report"] = "report"
  mapeoOtro["inproceedings"] = "inproceedings"
  mapeoOtro["conference"] = "inproceedings"
  mapeoOtro["periodical"] = "periodical"
  mapeoOtro["patent"] = "patent"

  ' --- 2. RETORNAR EL VALOR O CADENA VACÍA SI NO APLICA ---
  If mapeoOtro.Exist(Lower(sTipoBibTeX)) Then
    Return mapeoOtro[Lower(sTipoBibTeX)]
  Else
    Return ""
  Endif

End

' ==========================================================
' FUNCIÓN PRIVADA AUXILIAR: MapearTipoEditorDocBook
' ==========================================================
' Función   : MapearTipoEditorDocBook
' Propósito : MAPEA EL VALOR DE editortype DE BIBLATEX AL ELEMENTO
'             DOCBOOK 5.2 APROPIADO. DEVUELVE UNA STRUCT CON DOS CAMPOS
'             (ELEMENTO Y ATRIBUTOS) CODIFICADA COMO STRING SEPARADO
'             POR "|" PARA MANTENER LA SIGNATURA SIMPLE.
'             FORMATO: "elemento|atributos_xml"
'               editor       → "editor|"                    (SIN ATRIBUTOS)
'               compiler     → "othercredit|class=" & cQ & "other" & cQ &
'                                  " otherclass=" & cQ & "compiler" & cQ
'               translator   → "othercredit|class=" & cQ & "translator" & cQ
'               director     → "othercredit|class=" & cQ & "other" & cQ &
'                                  " otherclass=" & cQ & "director" & cQ
'               coordinator  → IDEM CON otherclass="coordinator"
'               organizer    → IDEM CON otherclass="organizer"
' Parámetros: sTipoBibLaTeX As String — VALOR DE editortype (editor,
'                                  compiler, translator, director, etc.)
' Retorna   : String — "elemento|atributos" SEGÚN MAPA ARRIBA
' ==========================================================
Private Function MapearTipoEditorDocBook(sTipoBibLaTeX As String) As String

  ' --- 1. INICIALIZACIÓN ---
  Dim cQ As String = Chr(34)
  Dim sTipo As String

  ' --- 2. SIN TIPO: EDITOR ---
  If sTipoBibLaTeX = "" Then Return "editor|"
  sTipo = Lower(TrimUTF8(sTipoBibLaTeX))

  ' --- 3. MAPEO ---
  ' SE SIGUE EL MODELO DE biblatex: UN COMPILADOR, UN COORDINADOR O UN
  ' DIRECTOR SON EDITORES CON UN TIPO, Y COMO TALES OCUPAN EL LUGAR DEL AUTOR
  ' CUANDO NO LO HAY. ANTES SE EMITÍAN COMO <othercredit>, QUE LAS HOJAS DE
  ' HTML Y EPUB NO TOMAN COMO SUSTITUTO DEL AUTOR: LA REFERENCIA SALÍA SIN
  ' NOMBRE, MIENTRAS EL PDF, QUE PASA POR biblatex, SALÍA BIEN.
  ' EL TIPO VIAJA EN @role Y LO LEE marca-editor.xsl PARA LA ABREVIATURA.
  ' Lower ES SEGURO ACÁ: LOS TIPOS DE biblatex SON ASCII (GV-03)
  Select Case sTipo

    Case "editor"
      Return "editor|"

      ' EL TRADUCTOR NO OCUPA NUNCA EL LUGAR DEL AUTOR: SIGUE COMO othercredit
    Case "translator"
      Return "othercredit|class=" & cQ & "translator" & cQ

      ' compiler, coordinator, director, collaborator, organizer Y CUALQUIER
      ' OTRO: EDITOR CON SU TIPO, COMO LO TRATA biblatex. UN TIPO NO PREVISTO
      ' SALE CON LA MARCA DE EDITOR (marca-editor.xsl)
    Case Else
      Return "editor|role=" & cQ & EscaparXML(sTipo) & cQ

  End Select

End

' ============================================
' Función   : PosicionNivelCero
' Propósito : Busca una cadena en un valor de BibTeX IGNORANDO LO QUE ESTÁ
'             ENTRE LLAVES, que es como separa biber: las llaves agrupan, y
'             lo agrupado no se parte. {Johnson and Johnson} es una sola
'             persona; {Ministerio de Salud, Presidencia} no tiene nombre de
'             pila.
'             String.* Y NO Mid/Len: LAS POSICIONES SON DE CARACTERES Y LAS
'             USA String.Mid (RC-GM-12, GV-41).
' Parámetros: sTexto As String — el valor
'             sBuscado As String — lo que se busca
'             iDesde As Integer — posición inicial, en caracteres; 1 = inicio.
'               DEBE SER UN PUNTO DE NIVEL CERO: EL CONTADOR ARRANCA EN CERO
' Retorna   : Integer — posición en caracteres de la primera aparición fuera
'             de llaves, o 0 si no aparece
' ============================================
Private Function PosicionNivelCero(sTexto As String, sBuscado As String, iDesde As Integer) As Integer

  Dim sCaracter As String
  Dim iPos As Integer
  Dim iLargo As Integer
  Dim iLargoBuscado As Integer
  Dim iNivel As Integer

  iLargo = String.Len(sTexto)
  iLargoBuscado = String.Len(sBuscado)
  iNivel = 0

  For iPos = iDesde To iLargo
    sCaracter = String.Mid(sTexto, iPos, 1)
    If sCaracter = "{" Then
      Inc iNivel
    Else If sCaracter = "}" Then
      ' UNA LLAVE DE CIERRE SUELTA NO LLEVA EL NIVEL A NEGATIVO
      If iNivel > 0 Then Dec iNivel
    Else If iNivel = 0 Then
      If String.Mid(sTexto, iPos, iLargoBuscado) = sBuscado Then Return iPos
    Endif
  Next

  Return 0

End

' ============================================
' Función   : DividirNivelCero
' Propósito : Split que respeta las llaves de BibTeX: corta solo en las
'             apariciones del separador que están fuera de llaves.
' Parámetros: sTexto As String — el valor
'             sSeparador As String — el separador
' Retorna   : String[] — las partes, sin recortar; al menos una
' ============================================
Private Function DividirNivelCero(sTexto As String, sSeparador As String) As String[]

  Dim aPartes As New String[]
  Dim iDesde As Integer
  Dim iPos As Integer

  iDesde = 1

  ' CADA CORTE DEJA iDesde EN UN PUNTO DE NIVEL CERO, QUE ES LO QUE
  ' PosicionNivelCero ESPERA
  Do
    iPos = PosicionNivelCero(sTexto, sSeparador, iDesde)
    If iPos = 0 Then Break
    aPartes.Add(String.Mid(sTexto, iDesde, iPos - iDesde))
    iDesde = iPos + String.Len(sSeparador)
  Loop

  aPartes.Add(String.Mid(sTexto, iDesde))

  Return aPartes

End

' ============================================
' Función   : TextoBibDocBook
' Propósito : Un valor de una referencia, del .bib al XML canónico: las tres
'             órdenes de LaTeX admitidas pasan a su elemento DocBook, las
'             llaves de agrupación se quitan y el texto se escapa.
'               \enquote{x}  →  <quote>x</quote>   (los niveles: quote.xsl)
'               \emph{x}     →  <emphasis>x</emphasis>
'               \sptext{x}   →  .<superscript>x</superscript>
'               \&           →  &amp;
'             EL PUNTO DE \sptext ES EL QUE PONE babel-spanish (\es@orddot):
'             n\sptext{o} SE COMPONE «n.º» EN EL PDF (MEDIDO).
' Parámetros: sValor As String — el valor tal como está en el .bib
' Retorna   : String — el contenido del elemento, ya escapado
' Nota      : REEMPLAZÓ A EscaparXML(QuitarLlavesBib(...)) EN LOS CAMPOS DE
'             TEXTO. LOS TRES ELEMENTOS SON VÁLIDOS EN TODOS ELLOS (title,
'             citetitle, bibliomisc, publishername, city, edition, orgname;
'             MEDIDO CON jing CONTRA EL RELAX NG DE DocBook 5.2).
'             UN VALOR QUE NO CUMPLE LA REGLA CORTA CON Error.Raise: LO
'             ATRAPA EL Catch DE QUIEN GENERA LA BIBLIOGRAFÍA (GV-23).
' ============================================
Private Function TextoBibDocBook(sValor As String) As String

  Dim sProblema As String

  ' --- 1. VALIDACIÓN: LA MISMA REGLA QUE EL FORMULARIO Y EL .bib ---
  sProblema = m_Bibtex.ProblemaOrdenesLatex(sValor)
  If sProblema <> "" Then
    Error.Raise("Referencia con LaTeX no admitido: " & sProblema & " en «" & sValor & "»")
  Endif

  ' --- 2. TRADUCCIÓN ---
  $sBibTexto = sValor
  $iBibPos = 1
  Return TextoBibGrupo()

End

' ============================================
' Función   : TextoBibGrupo
' Propósito : Traduce desde $iBibPos hasta la llave que cierra el grupo en
'             curso, o hasta el final del valor. Auxiliar de TextoBibDocBook.
' Parámetros: (ninguno — trabaja sobre $sBibTexto y $iBibPos)
' Retorna   : String — el fragmento traducido y escapado
' Nota      : RECURSIVA: UNA ORDEN O UNA LLAVE ABREN UN GRUPO NUEVO. LA
'             POSICIÓN VA EN UNA VARIABLE DE MÓDULO Y NO EN UN PARÁMETRO:
'             EN GAMBAS UN PRIMITIVO NO VUELVE MODIFICADO (GV-24).
'             LAS LLAVES YA ESTÁN BALANCEADAS (ProblemaOrdenesLatex).
' ============================================
Private Function TextoBibGrupo() As String

  Dim sSalida As String
  Dim sTramo As String
  Dim sCaracter As String
  Dim sInterior As String

  ' --- 1. RECORRIDO HASTA EL CIERRE DEL GRUPO ---
  While $iBibPos <= Len($sBibTexto)
    sCaracter = Mid($sBibTexto, $iBibPos, 1)

    ' CIERRE DEL GRUPO: VUELVE AL QUE LO ABRIÓ
    If sCaracter = "}" Then
      Inc $iBibPos
      Break
    Endif

    ' EL & ESCAPADO DE LaTeX ES TEXTO: EL CARÁCTER, QUE EscaparXML VUELVE
    ' &amp; CON EL RESTO DEL TRAMO
    If Mid($sBibTexto, $iBibPos, 2) = "\\&" Then
      sTramo &= "&"
      $iBibPos += 2
      Continue
    Endif

    If sCaracter = "\\" Or sCaracter = "{" Then
      ' EL TEXTO ACUMULADO SE ESCAPA ANTES DE ABRIR UN ELEMENTO
      sSalida &= EscaparXML(sTramo)
      sTramo = ""

      If sCaracter = "{" Then
        ' LLAVE DE AGRUPACIÓN: SE QUITA Y SU CONTENIDO QUEDA
        Inc $iBibPos
        sSalida &= TextoBibGrupo()
      Else If Mid($sBibTexto, $iBibPos, 9) = "\\enquote{" Then
        $iBibPos += 9
        sInterior = TextoBibGrupo()
        sSalida &= "<quote>" & sInterior & "</quote>"
      Else If Mid($sBibTexto, $iBibPos, 8) = "\\sptext{" Then
        $iBibPos += 8
        sInterior = TextoBibGrupo()
        sSalida &= ".<superscript>" & sInterior & "</superscript>"
      Else
        ' \emph{: LA ÚNICA QUE QUEDA (ProblemaOrdenesLatex YA VALIDÓ)
        $iBibPos += 6
        sInterior = TextoBibGrupo()
        sSalida &= "<emphasis>" & sInterior & "</emphasis>"
      Endif
      Continue
    Endif

    sTramo &= sCaracter
    Inc $iBibPos
  Wend

  ' --- 2. EL TEXTO QUE QUEDA ---
  sSalida &= EscaparXML(sTramo)

  Return sSalida

End

' ============================================
' Función   : QuitarLlavesBib
' Propósito : Quita las llaves de agrupación de un valor de BibTeX, una vez
'             que ya cumplieron su función: agrupar un nombre ({de la Fuente},
'             {Ministerio de Salud}) o proteger una mayúscula ({I}'ve). En el
'             XML son dos caracteres más, y las hojas los imprimían.
'             SOLO LLAVES: ES LO ÚNICO DE LA SINTAXIS DE BibTeX QUE LOS DATOS
'             TRAEN (MEDIDO: NI \&, NI --, NI ~). LA ANTIGUA LimpiarMarcasLatex,
'             YA ELIMINADA, HACÍA MÁS PERO NO SERVÍA ACÁ: CONVERTÍA \emph EN
'             <italic>, QUE ES JATS.
'             LIMITACIÓN: UNA LLAVE LITERAL ESCRITA \{ SE PERDERÍA. NO HAY
'             NINGUNA EN LOS DATOS.
' Parámetros: sTexto As String — el valor, sin escapar para XML
' Retorna   : String — el valor sin llaves
' ============================================
Private Function QuitarLlavesBib(sTexto As String) As String

  Dim sSalida As String

  sSalida = Replace(sTexto, "{", "")
  sSalida = Replace(sSalida, "}", "")

  Return sSalida

End

' ==========================================================
' FUNCIÓN PRIVADA AUXILIAR: GenerarPersonGroupDocBook
' ==========================================================
' Función   : GenerarPersonGroupDocBook
' Propósito : GENERA UN GRUPO DE PERSONAS (author/editor/othercredit) EN
'             DOCBOOK 5.2 A PARTIR DE UN STRING BIBLATEX CON FORMATO
'             "Apellido, Nombre and Apellido, Nombre". ANÁLOGA A
'             GenerarPersonGroup PERO EMITIENDO ELEMENTOS DOCBOOK:
'                <author><personname><surname/><firstname/></personname></author>
' Parámetros: sNombres As String — STRING BIBLATEX DE NOMBRES
'             sTipo    As String — TIPO MAPEADO POR MapearTipoEditorDocBook,
'                                  FORMATO "elemento|atributos".
'                                  PARA AUTORES SE PASA "author|".
' Retorna   : String — FRAGMENTO XML DOCBOOK CON UN ELEMENTO POR PERSONA
' ==========================================================
Private Function GenerarPersonGroupDocBook(sNombres As String, sTipo As String) As String

  Dim sXML As String
  Dim aNombres As String[]
  Dim nombreCompleto As String
  Dim apellido As String
  Dim nombre As String
  Dim posComa As Integer
  Dim i As Integer
  Dim aTipo As String[]
  Dim sElemento As String
  Dim sAtributos As String

  ' --- 1. PARSEAR EL TIPO "elemento|atributos" ---
  aTipo = Split(sTipo, "|")
  If aTipo.Count < 1 Then Return ""
  sElemento = aTipo[0]
  If aTipo.Count >= 2 Then
    sAtributos = aTipo[1]
  Else
    sAtributos = ""
  Endif

  ' --- 2. NORMALIZAR ESPACIOS DEL STRING DE ENTRADA ---
  sNombres = Replace(sNombres, Chr(9), " ")
  sNombres = Replace(sNombres, Chr(160), " ")
  While InStr(sNombres, "  ")
    sNombres = Replace(sNombres, "  ", " ")
  Wend
  sNombres = TrimUTF8(sNombres)

  ' --- 3. SEPARAR PERSONAS POR " and ", FUERA DE LLAVES ---
  ' ANTES SE PARTÍA SIN MIRAR LAS LLAVES: {Johnson and Johnson} SALÍA COMO
  ' DOS PERSONAS
  aNombres = DividirNivelCero(sNombres, " and ")

  ' --- 4. EMITIR UN ELEMENTO POR PERSONA ---
  For i = 0 To aNombres.Max
    nombreCompleto = TrimUTF8(aNombres[i])
    If Len(nombreCompleto) = 0 Then Continue

    ' AUTORES COLECTIVOS / "OTROS"
    ' EN DOCBOOK 5.2 NO HAY EQUIVALENTE DIRECTO A <etal/>; SE USA UN
    ' <othercredit> COMO MARCADOR. NO PUEDE IR VACÍO: EL ESQUEMA EXIGE UN
    ' personname O UN orgname ADENTRO, Y EL VACÍO DEJABA EL CANÓNICO
    ' INVÁLIDO EN CUANTO UNA REFERENCIA TENÍA "and others". EL role DICE A
    ' QUÉ LISTA PERTENECE —author, editor, othercredit—, PORQUE UNA MISMA
    ' REFERENCIA PUEDE TENER VARIAS.
    ' PENDIENTE: LAS HOJAS DE HTML Y EPUB NO LEEN ESTE MARCADOR, Y EL «Y
    ' OTROS» SE PIERDE EN ESAS SALIDAS; EL PDF LO IMPRIME PORQUE biblatex
    ' LEE EL "and others" DEL .bib
    If nombreCompleto = "others" Or nombreCompleto = "et al" Or nombreCompleto = "et al." Then
      sXML &= "      <othercredit class=" & Chr(34) & "other" & Chr(34) &
        " otherclass=" & Chr(34) & "etal" & Chr(34) &
        " role=" & Chr(34) & sElemento & Chr(34) & ">" &
        "<orgname>et al.</orgname></othercredit>" & gb.NewLine
      Continue
    Endif

    ' FORMATO BIBLATEX: "Apellido, Nombre". LA COMA SE BUSCA FUERA DE LLAVES:
    ' {Ministerio de Salud, Presidencia} NO TIENE NOMBRE DE PILA
    posComa = PosicionNivelCero(nombreCompleto, ",", 1)
    If posComa > 0 Then
      apellido = TrimUTF8(String.Left(nombreCompleto, posComa - 1))
      nombre = TrimUTF8(String.Mid(nombreCompleto, posComa + 1))
    Else
      ' SIN COMA: CONSIDERAR TODO COMO APELLIDO (LO MÁS CONSERVADOR)
      apellido = nombreCompleto
      nombre = ""
    Endif

    ' LAS LLAVES YA AGRUPARON: SE QUITAN RECIÉN AHORA, DESPUÉS DE PARTIR
    apellido = TrimUTF8(QuitarLlavesBib(apellido))
    nombre = TrimUTF8(QuitarLlavesBib(nombre))

    ' --- EMITIR EL ELEMENTO ---
    If sAtributos = "" Then
      sXML &= "      <" & sElemento & ">" & gb.NewLine
    Else
      sXML &= "      <" & sElemento & " " & sAtributos & ">" & gb.NewLine
    Endif
    sXML &= "        <personname>" & gb.NewLine
    sXML &= "          <surname>" & EscaparXML(apellido) & "</surname>" & gb.NewLine
    If Len(nombre) > 0 Then
      sXML &= "          <firstname>" & EscaparXML(nombre) & "</firstname>" & gb.NewLine
    Endif
    sXML &= "        </personname>" & gb.NewLine
    sXML &= "      </" & sElemento & ">" & gb.NewLine
  Next

  Return sXML

End

' ==========================================================
' FUNCIÓN PÚBLICA: GenerarBiblioCapituloXML
' ==========================================================
' Función   : GenerarBiblioCapituloXML
' Propósito : GENERA EL FRAGMENTO <bibliography> EN DOCBOOK 5.2 PARA UN
'             CAPÍTULO ESPECÍFICO. FILTRA EL .bib DEL PROYECTO USANDO
'             LOS CITEKEYS EN capitulos.referencias_citadas.
'             ESCRIBE EL RESULTADO EN tmp/biblio-cap-NN.xml.
'             ANÁLOGA A GenerarRefListXML DE REVISTAS.
'
'             COMPORTAMIENTO SEGÚN libros_md.lugar_bibliografia:
'             - 'por_capitulo': GENERA EL FRAGMENTO NORMALMENTE.
'             - 'consolidada':  GENERA UN <bibliography/> VACÍO Y RETORNA
'                               True (LA BIBLIOGRAFÍA REAL VA EN UN CAPÍTULO
'                               APARTE GENERADO POR GenerarBiblioLibroXML).
'
' Parámetros: iIdCapitulo As Integer — id_capitulo de la BD
' Retorna   : Boolean — True si el archivo fue generado exitosamente
' ==========================================================
Public Function GenerarBiblioCapituloXML(iIdCapitulo As Integer) As Boolean

  ' --- 0. DECLARACIÓN DE VARIABLES ---
  Dim hCapitulo As Result
  Dim hLibro As Result
  Dim sNombreArchivo As String
  Dim sReferenciasCSV As String
  Dim sLugarBibliografia As String
  Dim iIdLibro As Integer
  Dim aCitekeys As String[]
  Dim sBibFile As String
  Dim sBibContent As String
  Dim sEntry As String
  Dim aEntries As String[]
  Dim sType As String
  Dim sCitekey As String
  Dim iPosLlave As Integer
  Dim iPosComa As Integer
  Dim dictEntries As New Collection
  Dim dictTypes As New Collection
  Dim sXML As String
  Dim sDirTmp As String
  Dim sNombreBase As String
  Dim sFilePath As String
  Dim sCk As String
  Dim sCkSanitizado As String
  Dim colSanitizados As New Collection

  ' --- 1. OBTENER NOMBRE DEL CAPÍTULO Y REFERENCIAS_CITADAS ---
  Try hCapitulo = m_ConexionBD.mConn.Exec(
    "SELECT nombre_archivo, referencias_citadas, id_libro FROM capitulos WHERE id_capitulo = &1 LIMIT 1",
    iIdCapitulo)

  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al consultar el capítulo:" & Chr(10) & Error.Text)
    Return False
  Endif

  If Not hCapitulo.Available Then
    m_Sonido.sonar("Error")
    Message.Error("No se encontraron datos para el capítulo id=" & CStr(iIdCapitulo))
    Return False
  Endif

  sNombreArchivo = TrimUTF8(hCapitulo["nombre_archivo"])
  iIdLibro = CInt(hCapitulo["id_libro"])
  sDirTmp = m_InicioCierre.RutaProyectoEnCurso &/ "tmp"
  ' CONVENCIÓN DE NOMBRES: biblio-{nombre_archivo_sin_prefijo}.xml
  ' EL PREFIJO a-, fm- O bm- SE PRESERVA EN EL NOMBRE DEL ARCHIVO
  ' COMPLETO; biblio- REEMPLAZA AL PREFIJO PARA QUE EL ENSAMBLADOR
  ' SAXON LO TOME COMO PARÁMETRO biblio=...
  sNombreBase = "biblio-" & Mid(sNombreArchivo, InStr(sNombreArchivo, "-") + 1)
  sFilePath = sDirTmp & "/" & File.BaseName(sNombreBase) & ".xml"

  ' --- 2. DETERMINAR lugar_bibliografia DEL LIBRO ---
  Try hLibro = m_ConexionBD.mConn.Exec(
    "SELECT lugar_bibliografia FROM libros_md WHERE id_libro = &1 LIMIT 1",
    iIdLibro)
  If Error Or Not hLibro.Available Then
    ' SI NO SE PUEDE DETERMINAR, ASUMIR el default por_capitulo
    sLugarBibliografia = "por_capitulo"
  Else
    sLugarBibliografia = TrimUTF8(hLibro["lugar_bibliografia"])
    If sLugarBibliografia = "" Then sLugarBibliografia = "por_capitulo"
  Endif

  ' --- 3. SI ES CONSOLIDADA, EMITIR FRAGMENTO VACÍO Y SALIR ---
  ' EL XSL DE ENSAMBLADO IGNORA EL PARÁMETRO biblio CUANDO EL DOCUMENTO
  ' ESTÁ VACÍO (NO HAY db:bibliography/db:biblioentry). VER LA CONDICIÓN
  ' EN ensamblar-capitulo-canonico.xsl § PASO 3.
  If sLugarBibliografia = "consolidada" Then
    Try File.Save(sFilePath, "<bibliography xmlns=" & Chr(34) &
      "http://docbook.org/ns/docbook" & Chr(34) & "/>" & Chr(10))
    If Error Then
      m_Sonido.sonar("Error")
      Message.Error("Error al guardar biblio vacío en " & sFilePath & ":" & Chr(10) & Error.Text)
      Return False
    Endif
    Return True
  Endif

  ' --- 4. CAPÍTULO SIN REFERENCIAS: <bibliography/> VACÍO ---
  If IsNull(hCapitulo["referencias_citadas"]) Or
      TrimUTF8(hCapitulo["referencias_citadas"]) = "" Then
    Try File.Save(sFilePath, "<bibliography xmlns=" & Chr(34) &
      "http://docbook.org/ns/docbook" & Chr(34) & "/>" & Chr(10))
    If Error Then
      m_Sonido.sonar("Error")
      Message.Error("Error al guardar biblio vacío en " & sFilePath & ":" & Chr(10) & Error.Text)
      Return False
    Endif
    Return True
  Endif

  sReferenciasCSV = TrimUTF8(hCapitulo["referencias_citadas"])

  ' --- 5. CONSTRUIR LISTA DE CITEKEYS ---
  aCitekeys = Split(sReferenciasCSV, ",")

  ' --- 6. VERIFICAR QUE EXISTE EL .bib DEL PROYECTO ---
  sBibFile = m_InicioCierre.RutaProyectoEnCurso &/ "referencias/ref-" &
    File.BaseName(m_InicioCierre.NombreProyectoEnCurso) & ".bib"

  If Not Exist(sBibFile) Then
    m_Sonido.sonar("Error")
    Message.Error("No se encontró el archivo de referencias:" & Chr(10) & sBibFile & Chr(10) &
      "Exporte primero las referencias desde la base de datos.")
    Return False
  Endif

  ' --- 7. LEER EL .bib ---
  Try sBibContent = File.Load(sBibFile)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al leer el archivo .bib:" & Chr(10) & Error.Text)
    Return False
  Endif

  ' --- 8. PRIMERA PASADA: INDEXAR TODAS LAS ENTRADAS PARA CROSSREF ---
  ' SE PARTE EL ARCHIVO EN ENTRADAS USANDO "@" COMO DELIMITADOR.
  ' DESCARTA ENTRADAS @comment Y @string (NO SON BIBLIOGRAFÍA).
  aEntries = Split(sBibContent, "@", "", True)
  For Each sEntry In aEntries
    If TrimUTF8(sEntry) = "" Then Continue
    iPosLlave = InStr(sEntry, "{")
    iPosComa = InStr(sEntry, ",")
    If iPosLlave = 0 Or iPosComa = 0 Then Continue
    sType = TrimUTF8(Left(sEntry, iPosLlave - 1))
    If Lower(sType) = "comment" Or Lower(sType) = "string" Then Continue
    sCitekey = TrimUTF8(Mid(sEntry, iPosLlave + 1, iPosComa - iPosLlave - 1))
    If sCitekey = "" Then Continue
    dictEntries[sCitekey] = sEntry
    dictTypes[sCitekey] = sType
  Next

  ' --- 9. SEGUNDA PASADA: GENERAR XML EN ORDEN DE referencias_citadas ---
  ' EL NAMESPACE xlink ES OBLIGATORIO PORQUE <link xlink:href="..."> SE USA
  ' EN bibliosource. EL XSL DE ENSAMBLADO LO RE-DECLARA EN EL WRAPPER RAÍZ.
  sXML = "<bibliography xmlns=" & Chr(34) & "http://docbook.org/ns/docbook" & Chr(34) &
    " xmlns:xlink=" & Chr(34) & "http://www.w3.org/1999/xlink" & Chr(34) & ">" & Chr(10)
  sXML &= "  <title>Referencias</title>" & Chr(10)

  ' DETECCIÓN DE COLISIÓN DE CITEKEYS AL SANITIZAR (MISMO PATRÓN QUE
  ' GenerarRefListXML DE REVISTAS). SI DOS CITEKEYS DISTINTOS PRODUCEN
  ' EL MISMO RESULTADO SANITIZADO, ABORTAR EXPLÍCITAMENTE.
  For Each sCk In aCitekeys
    sCk = TrimUTF8(sCk)
    If sCk = "" Then Continue

    sCkSanitizado = SanitizarCitekey(sCk)
    If colSanitizados.Exist(sCkSanitizado) Then
      If colSanitizados[sCkSanitizado] <> sCk Then
        m_Sonido.sonar("Error")
        Message.Error(
          "Colisión de citekeys al sanitizar para XML DocBook:" & Chr(10) & Chr(10) &
          "Original 1: " & colSanitizados[sCkSanitizado] & Chr(10) &
          "Original 2: " & sCk & Chr(10) &
          "Ambos resultan en: " & sCkSanitizado & Chr(10) & Chr(10) &
          "Renombre uno de los dos en el archivo .bib y vuelva a generar el biblio.")
        Return False
      Endif
      ' MISMO CITEKEY APARECE DOS VECES EN referencias_citadas: SALTAR
      Continue
    Endif
    colSanitizados[sCkSanitizado] = sCk

    If Not dictEntries.Exist(sCk) Then
      sXML &= "  <!-- ADVERTENCIA: citekey '" & sCk & "' no encontrado en el .bib -->" & Chr(10)
      Continue
    Endif

    sEntry = dictEntries[sCk]
    sType = dictTypes[sCk]

    ' GENERAR EL <biblioentry> CON xml:id="bib-{sanitizado}"
    sXML &= GenerarBiblioentryDesdeBib(sEntry, sType, sCkSanitizado, dictEntries)
  Next

  sXML &= "</bibliography>" & Chr(10)

  ' --- 10. GUARDAR ARCHIVO ---
  Try File.Save(sFilePath, sXML)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al guardar biblio xml en " & sFilePath & ":" & Chr(10) & Error.Text)
    Return False
  Endif

  Return Exist(sFilePath)

Catch
  m_Sonido.sonar("Error")
  Message.Error("Error inesperado en GenerarBiblioCapituloXML:" & Chr(10) &
    Error.Text & Chr(10) & "Donde: " & Error.Where)
  Return False

End Function

' ==========================================================
' FUNCIÓN PÚBLICA: GenerarBiblioLibroXML
' ==========================================================
' Función   : GenerarBiblioLibroXML
' Propósito : GENERA EL FRAGMENTO <bibliography> CONSOLIDADO PARA UN LIBRO
'             COMPLETO CUANDO libros_md.lugar_bibliografia='consolidada'.
'             DERIVA AUTOMÁTICAMENTE LOS CITEKEYS UNIENDO LOS
'             capitulos.referencias_citadas DE TODOS LOS CAPÍTULOS DEL
'             LIBRO (PATRÓN DE LATEX, NO HAY CAMPO MANUAL EN libros_md).
'             ESCRIBE EL RESULTADO EN tmp/biblio-libro-{nombre_proyecto}.xml.
'
' Parámetros: iIdLibro As Integer — id_libro de la BD
' Retorna   : Boolean — True si el archivo fue generado exitosamente
' ==========================================================
Public Function GenerarBiblioLibroXML(iIdLibro As Integer) As Boolean

  ' --- 0. DECLARACIÓN DE VARIABLES ---
  Dim hLibro As Result
  Dim hCapitulos As Result
  Dim sLugarBibliografia As String
  Dim sCsvCapitulo As String
  Dim sCsvConsolidado As String
  Dim aCitekeys As String[]
  Dim colCitekeysUnicos As New Collection
  Dim sBibFile As String
  Dim sBibContent As String
  Dim sEntry As String
  Dim aEntries As String[]
  Dim sType As String
  Dim sCitekey As String
  Dim iPosLlave As Integer
  Dim iPosComa As Integer
  Dim dictEntries As New Collection
  Dim dictTypes As New Collection
  Dim sXML As String
  Dim sDirTmp As String
  Dim sFilePath As String
  Dim sCk As String
  Dim sCkSanitizado As String
  Dim colSanitizados As New Collection

  ' --- 1. VERIFICAR QUE EL LIBRO USA BIBLIOGRAFÍA CONSOLIDADA ---
  Try hLibro = m_ConexionBD.mConn.Exec(
    "SELECT lugar_bibliografia FROM libros_md WHERE id_libro = &1 LIMIT 1",
    iIdLibro)
  If Error Or Not hLibro.Available Then
    m_Sonido.sonar("Error")
    Message.Error("No se encontraron datos para el libro id=" & CStr(iIdLibro))
    Return False
  Endif

  sLugarBibliografia = TrimUTF8(hLibro["lugar_bibliografia"])
  If sLugarBibliografia <> "consolidada" Then
    m_Sonido.sonar("Warning")
    Message.Warning("El libro no usa bibliografía consolidada (lugar_bibliografia=" &
      sLugarBibliografia & "). Use GenerarBiblioCapituloXML para cada capítulo.")
    Return False
  Endif

  sDirTmp = m_InicioCierre.RutaProyectoEnCurso &/ "tmp"
  sFilePath = sDirTmp & "/biblio-libro-" & File.BaseName(m_InicioCierre.NombreProyectoEnCurso) & ".xml"

  ' --- 2. UNIR referencias_citadas DE TODOS LOS CAPÍTULOS DEL LIBRO ---
  ' EL PATRÓN ES ANÁLOGO A LO QUE HACE BIBER EN LATEX: ESCANEAR TODOS LOS
  ' \cite Y EMITIR LA UNIÓN. ACÁ EL "ESCANEO" YA ESTÁ HECHO POR EL ABM,
  ' QUE POPULA capitulos.referencias_citadas POR CAPÍTULO.
  Try hCapitulos = m_ConexionBD.mConn.Exec(
    "SELECT referencias_citadas FROM capitulos " &
    "WHERE id_libro = &1 AND referencias_citadas IS NOT NULL " &
    "AND TRIM(referencias_citadas) <> ''",
    iIdLibro)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al consultar capítulos del libro:" & Chr(10) & Error.Text)
    Return False
  Endif

  ' RECORRER LOS CSV DE CADA CAPÍTULO Y AGREGAR A LA COLECCIÓN DE ÚNICOS.
  ' SE PRESERVA EL ORDEN DE APARICIÓN: PRIMERO LOS DEL PRIMER CAPÍTULO,
  ' LUEGO LOS NUEVOS DEL SEGUNDO, ETC.
  While hCapitulos.Available
    sCsvCapitulo = TrimUTF8(hCapitulos["referencias_citadas"])
    If sCsvCapitulo <> "" Then
      aCitekeys = Split(sCsvCapitulo, ",")
      For Each sCk In aCitekeys
        sCk = TrimUTF8(sCk)
        If sCk <> "" And Not colCitekeysUnicos.Exist(sCk) Then
          colCitekeysUnicos[sCk] = True
          ' ACUMULAR EN ORDEN PARA SEGUNDO PASS
          If sCsvConsolidado <> "" Then sCsvConsolidado &= ","
          sCsvConsolidado &= sCk
        Endif
      Next
    Endif
    hCapitulos.MoveNext
  Wend

  ' --- 3. SI NO HAY REFERENCIAS, EMITIR BIBLIOGRAFÍA VACÍA ---
  If sCsvConsolidado = "" Then
    Try File.Save(sFilePath, "<bibliography xmlns=" & Chr(34) &
      "http://docbook.org/ns/docbook" & Chr(34) &
      "><title>Referencias</title></bibliography>" & Chr(10))
    If Error Then
      m_Sonido.sonar("Error")
      Message.Error("Error al guardar biblio vacío en " & sFilePath & ":" & Chr(10) & Error.Text)
      Return False
    Endif
    Return True
  Endif

  ' --- 4. VERIFICAR Y LEER EL .bib DEL PROYECTO ---
  sBibFile = m_InicioCierre.RutaProyectoEnCurso &/ "referencias/ref-" &
    File.BaseName(m_InicioCierre.NombreProyectoEnCurso) & ".bib"

  If Not Exist(sBibFile) Then
    m_Sonido.sonar("Error")
    Message.Error("No se encontró el archivo de referencias:" & Chr(10) & sBibFile & Chr(10) &
      "Exporte primero las referencias desde la base de datos.")
    Return False
  Endif

  Try sBibContent = File.Load(sBibFile)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al leer el archivo .bib:" & Chr(10) & Error.Text)
    Return False
  Endif

  ' --- 5. INDEXAR ENTRADAS DEL .bib ---
  aEntries = Split(sBibContent, "@", "", True)
  For Each sEntry In aEntries
    If TrimUTF8(sEntry) = "" Then Continue
    iPosLlave = InStr(sEntry, "{")
    iPosComa = InStr(sEntry, ",")
    If iPosLlave = 0 Or iPosComa = 0 Then Continue
    sType = TrimUTF8(Left(sEntry, iPosLlave - 1))
    If Lower(sType) = "comment" Or Lower(sType) = "string" Then Continue
    sCitekey = TrimUTF8(Mid(sEntry, iPosLlave + 1, iPosComa - iPosLlave - 1))
    If sCitekey = "" Then Continue
    dictEntries[sCitekey] = sEntry
    dictTypes[sCitekey] = sType
  Next

  ' --- 6. GENERAR XML EN ORDEN DEL CSV CONSOLIDADO ---
  sXML = "<bibliography xmlns=" & Chr(34) & "http://docbook.org/ns/docbook" & Chr(34) &
    " xmlns:xlink=" & Chr(34) & "http://www.w3.org/1999/xlink" & Chr(34) & ">" & Chr(10)
  sXML &= "  <title>Referencias</title>" & Chr(10)

  aCitekeys = Split(sCsvConsolidado, ",")
  For Each sCk In aCitekeys
    sCk = TrimUTF8(sCk)
    If sCk = "" Then Continue

    sCkSanitizado = SanitizarCitekey(sCk)
    If colSanitizados.Exist(sCkSanitizado) Then
      If colSanitizados[sCkSanitizado] <> sCk Then
        m_Sonido.sonar("Error")
        Message.Error(
          "Colisión de citekeys al sanitizar para XML DocBook:" & Chr(10) & Chr(10) &
          "Original 1: " & colSanitizados[sCkSanitizado] & Chr(10) &
          "Original 2: " & sCk & Chr(10) &
          "Ambos resultan en: " & sCkSanitizado & Chr(10) & Chr(10) &
          "Renombre uno de los dos en el archivo .bib y vuelva a generar el biblio.")
        Return False
      Endif
      Continue
    Endif
    colSanitizados[sCkSanitizado] = sCk

    If Not dictEntries.Exist(sCk) Then
      sXML &= "  <!-- ADVERTENCIA: citekey '" & sCk & "' no encontrado en el .bib -->" & Chr(10)
      Continue
    Endif

    sEntry = dictEntries[sCk]
    sType = dictTypes[sCk]

    sXML &= GenerarBiblioentryDesdeBib(sEntry, sType, sCkSanitizado, dictEntries)
  Next

  sXML &= "</bibliography>" & Chr(10)

  ' --- 7. GUARDAR ARCHIVO ---
  Try File.Save(sFilePath, sXML)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al guardar biblio xml en " & sFilePath & ":" & Chr(10) & Error.Text)
    Return False
  Endif

  Return Exist(sFilePath)

Catch
  m_Sonido.sonar("Error")
  Message.Error("Error inesperado en GenerarBiblioLibroXML:" & Chr(10) &
    Error.Text & Chr(10) & "Donde: " & Error.Where)
  Return False

End Function

' ==========================================================
' FUNCIÓN PÚBLICA: GenerarInfoCapituloXML
' ==========================================================
' AGREGAR AL FINAL DE m_XML.module, JUNTO CON LAS DEMÁS FUNCIONES
' DE GENERACIÓN DE FRAGMENTOS DOCBOOK.
'
' ANÁLOGA A GenerarFrontXML (REVISTAS), CON LAS SIGUIENTES
' DIFERENCIAS PROPIAS DE LIBROS ACADÉMICOS:
'   - Tabla: capitulo_autor (no articulo_autor)
'   - Enum rol_autor: solo 'autor', 'traductor' (sin 'editor')
'   - Sin es_autor_correspondencia
'   - Sin emisión de <email> en el XML (queda solo en BD)
'   - ROR del momento (ror_afiliacion_momento) + fallback al
'     ror_afiliacion_actual de autores
'   - contribuciones_credit JSON + taxonomia_credit TEXT (fallback)
'   - notas_autor (por autor) → <personblurb> dentro de <author>
'   - author_notes (global del capítulo) → <authorblurb> al cierre
'
' ESTRUCTURA DEL <info> GENERADO (16 BLOQUES):
'   1.  Título, subtítulo, título corto, título traducido
'   2.  Identificadores (DOI, elocation-id)
'   3.  Autores (loop sobre capitulo_autor + autores)
'   4.  Autores corporativos / anónimos / grupales
'   5.  Resúmenes (hasta 3 idiomas)
'   6.  Palabras clave (hasta 3 idiomas)
'   7.  Clasificaciones (MeSH, DeCS, temática)
'   8.  Fechas (publicación online, recepción, aceptación, revisión)
'   9.  Paginación
'   10. Financiamiento
'   11. Conflictos de interés
'   12. Ética
'   13. Datos asociados
'   14. Licencia y copyright
'   15. URLs
'   16. Conteos de figuras / tablas / ecuaciones
'
' SALIDA: tmp/info-{nombre_archivo_sin_prefijo}.xml
'   ej.: capítulo a-02-metodologia.md → tmp/info-02-metodologia.xml
' ==========================================================

' ============================================
' Función   : GenerarInfoCapituloXML
' Propósito : Genera el fragmento <info> en DocBook 5.2 para un capítulo
'             específico, leyendo la tabla capitulos y el JOIN de
'             capitulo_autor + autores. Escribe el resultado en tmp/.
' Parámetros: iIdCapitulo As Integer — id_capitulo de la BD
' Retorna   : Boolean — True si el archivo fue generado exitosamente
' ============================================
Public Function GenerarInfoCapituloXML(iIdCapitulo As Integer) As Boolean

  ' --- 0. DECLARACIÓN DE VARIABLES ---
  ' COMILLA DOBLE COMO VARIABLE LOCAL PARA RESPETAR SC-01
  Dim cQ As String = Chr(34)

  Dim hCapitulo As Result
  Dim hAutores As Result
  Dim sIdiomaTit As String
  Dim sXML As String
  Dim sDirTmp As String
  Dim sFilePath As String
  Dim sNombreBase As String
  Dim sNombreArchivo As String
  Dim aUbicacion As String[]
  Dim hLibroEstilo As Result

  ' VARIABLES PARA EL LOOP DE AUTORES
  Dim sRolAutor As String
  Dim sElementoAutor As String
  Dim sAtributosAutor As String
  Dim sAfil As String
  Dim sDept As String
  Dim sCiudadAfil As String
  Dim sPaisAfil As String
  Dim sRor As String
  Dim sCredit As String
  Dim aRoles As String[]
  Dim sRole As String

  ' VARIABLES PARA FECHAS
  Dim sFechaPubOnline As String
  Dim sFechaRecep As String
  Dim sFechaAcept As String
  Dim sFechaRev As String

  ' VARIABLES PARA KEYWORDS
  Dim aKwd As String[]
  Dim sKwd As String

  ' VARIABLES PARA CLASIFICACIONES
  Dim aTerminos As String[]
  Dim sTermino As String

  ' --- 1. PREPARAR DIRECTORIO TEMPORAL ---
  sDirTmp = m_InicioCierre.RutaProyectoEnCurso &/ "tmp"

  ' --- 2. CONSULTAR DATOS DEL CAPÍTULO ---
  ' LAS FECHAS SE PIDEN EN FORMATO ISO YYYY-MM-DD PARA EVITAR
  ' PROBLEMAS DE LOCALIZACIÓN EN LA CONVERSIÓN DE GAMBAS.
  Try hCapitulo = m_ConexionBD.mConn.Exec(
    "SELECT *, " &
    "DATE_FORMAT(fecha_publicacion_online, '%Y-%m-%d') AS fecha_online_iso, " &
    "DATE_FORMAT(fecha_recepcion,          '%Y-%m-%d') AS fecha_rec_iso, " &
    "DATE_FORMAT(fecha_aceptacion,         '%Y-%m-%d') AS fecha_ace_iso, " &
    "DATE_FORMAT(fecha_revision,           '%Y-%m-%d') AS fecha_rev_iso " &
    "FROM capitulos WHERE id_capitulo = &1 LIMIT 1", iIdCapitulo)

  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al consultar el capítulo:" & Chr(10) & Error.Text)
    Return False
  Endif

  If Not hCapitulo.Available Then
    m_Sonido.sonar("Error")
    Message.Error("No se encontraron datos para el capítulo id=" & CStr(iIdCapitulo))
    Return False
  Endif

  ' NOMBRE DEL ARCHIVO DE SALIDA:
  ' "a-02-metodologia"  → "info-02-metodologia"
  ' "fm-01-prologo"     → "info-01-prologo"
  ' "bm-99-colofon"     → "info-99-colofon"
  ' EL PREFIJO SE DESCARTA TOMANDO EL TEXTO DESDE EL PRIMER GUIÓN.
  sNombreArchivo = TrimUTF8(hCapitulo["nombre_archivo"])
  sNombreBase = "info-" & Mid(sNombreArchivo, InStr(sNombreArchivo, "-") + 1)
  sFilePath = sDirTmp & "/" & File.BaseName(sNombreBase) & ".xml"

  ' --- 3. CONSULTAR AUTORES DEL CAPÍTULO ---
  ' JOIN capitulo_autor + autores CON PRIORIDAD A LOS DATOS DEL MOMENTO
  ' (capturados al asignar el autor al capítulo) SOBRE LOS DATOS VIGENTES
  ' DEL AUTOR (que pueden haber cambiado).
  Try hAutores = m_ConexionBD.mConn.Exec(
    "SELECT a.id_autor, a.apellidos, a.nombre, a.sufijo, a.orcid, " &
    "a.afiliacion_actual, a.departamento, a.ciudad_afiliacion, a.pais_afiliacion, " &
    "a.ror_afiliacion_actual, a.biografia_corta, " &
    "ca.orden_autoria, ca.rol_autor, " &
    "ca.afiliacion_momento, ca.departamento_momento, ca.ciudad_momento, " &
    "ca.pais_momento, ca.ror_afiliacion_momento, " &
    "ca.taxonomia_credit, ca.contribuciones_credit, ca.notas_autor " &
    "FROM autores a " &
    "INNER JOIN capitulo_autor ca ON a.id_autor = ca.id_autor " &
    "WHERE ca.id_capitulo = &1 " &
    "ORDER BY ca.orden_autoria ASC",
    iIdCapitulo)

  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al consultar autores del capítulo:" & Chr(10) & Error.Text)
    Return False
  Endif

  ' --- 4. ABRIR EL ELEMENTO RAÍZ <info> ---
  ' EL NAMESPACE xlink ES NECESARIO PORQUE <legalnotice> Y POSIBLES
  ' bibliosource USAN <link xlink:href="...">. EL XSL DE ENSAMBLADO
  ' LO RE-DECLARA EN EL WRAPPER RAÍZ DEL CANÓNICO.
  sXML = "<info xmlns=" & cQ & "http://docbook.org/ns/docbook" & cQ &
    " xmlns:xlink=" & cQ & "http://www.w3.org/1999/xlink" & cQ & ">" & Chr(10)

  ' ==========================================================
  ' BLOQUE 1. TÍTULO Y SUBTÍTULO
  ' ==========================================================
  ' EL <title> ES OBLIGATORIO EN DOCBOOK 5.2 PARA <chapter>/<preface>/etc.
  ' SI ESTÁ VACÍO, EMITIMOS UN PLACEHOLDER PARA QUE EL DOCUMENTO RESULTANTE
  ' AL MENOS VALIDE; EL EDITOR DEBE COMPLETARLO ANTES DE PUBLICAR.
  ' EL CORTE DEL EDITOR VA COMO <?gb-corte?>: DocBook 5.2 NO TIENE ELEMENTO
  ' DE CORTE EN title NI EN subtitle, Y LA INSTRUCCIÓN VALIDA (SC-28). EL
  ' TÍTULO CORTO Y EL TRADUCIDO NO CORTAN: VAN PLANOS
  If Not IsNull(hCapitulo["titulo_capitulo"]) And
      Len(TrimUTF8(hCapitulo["titulo_capitulo"])) > 0 Then
    sXML &= "  <title>" & TituloXML(hCapitulo["titulo_capitulo"], m_CorteTitulo.SEPARADOR_DOCBOOK) &
      "</title>" & Chr(10)
  Else
    sXML &= "  <title>[SIN TÍTULO]</title>" & Chr(10)
  Endif

  If Not IsNull(hCapitulo["subtitulo"]) And
      Len(TrimUTF8(hCapitulo["subtitulo"])) > 0 Then
    sXML &= "  <subtitle>" & TituloXML(hCapitulo["subtitulo"], m_CorteTitulo.SEPARADOR_DOCBOOK) &
      "</subtitle>" & Chr(10)
  Endif

  If Not IsNull(hCapitulo["titulo_corto"]) And
      Len(TrimUTF8(hCapitulo["titulo_corto"])) > 0 Then
    sXML &= "  <titleabbrev>" & EscaparXML(m_CorteTitulo.Plano(hCapitulo["titulo_corto"])) &
      "</titleabbrev>" & Chr(10)
  Endif

  ' TÍTULO TRADUCIDO: VA EN <bibliomisc role="titulo-traducido"> CON SU
  ' xml:lang. DocBook 5.2 ADMITE UN SOLO <title> EN <info>: UN SEGUNDO
  ' <title role="traducido"> INVALIDA EL CANÓNICO CONTRA EL RNG (VERIFICADO).
  ' bibliomisc CON role ES EL PATRÓN DEL CANÓNICO PARA LOS DATOS SIN
  ' ELEMENTO PROPIO (tipo-capitulo, mes-publicacion): EL DATO QUEDA EN EL
  ' XML, QUE SIGUE SIENDO AUTÓNOMO (RC-XJ-02). NO CORTA: VA PLANO (SC-28)
  If Not IsNull(hCapitulo["titulo_traducido"]) And
      Len(TrimUTF8(hCapitulo["titulo_traducido"])) > 0 Then
    sIdiomaTit = ""
    If Not IsNull(hCapitulo["idioma_titulo_traducido"]) Then
      sIdiomaTit = TrimUTF8(hCapitulo["idioma_titulo_traducido"])
    Endif
    sXML &= "  <bibliomisc role=" & cQ & "titulo-traducido" & cQ
    If sIdiomaTit <> "" Then
      sXML &= " xml:lang=" & cQ & EscaparXML(sIdiomaTit) & cQ
    Endif
    sXML &= ">" & EscaparXML(m_CorteTitulo.Plano(hCapitulo["titulo_traducido"])) &
      "</bibliomisc>" & Chr(10)
  Endif

  ' ==========================================================
  ' BLOQUE 2. IDENTIFICADORES
  ' ==========================================================
  If Not IsNull(hCapitulo["doi"]) And Len(TrimUTF8(hCapitulo["doi"])) > 0 Then
    sXML &= "  <biblioid class=" & cQ & "doi" & cQ & ">" &
      EscaparXML(TrimUTF8(hCapitulo["doi"])) & "</biblioid>" & Chr(10)
  Endif

  If Not IsNull(hCapitulo["elocation_id"]) And
      Len(TrimUTF8(hCapitulo["elocation_id"])) > 0 Then
    sXML &= "  <bibliomisc role=" & cQ & "elocation-id" & cQ & ">" &
      EscaparXML(TrimUTF8(hCapitulo["elocation_id"])) &
      "</bibliomisc>" & Chr(10)
  Endif

  ' ==========================================================
  ' BLOQUE 2b. UBICACIÓN DE LA PIEZA EN EL LIBRO
  ' ==========================================================
  ' seccion-libro, orden-seccion Y tipo-capitulo: LOS LEE docbook-to-latex.xsl
  ' PARA DECIDIR LA PÁGINA SUELTA (fm/bm CON NN DE 00 A 09) Y LA NUMERACIÓN.
  ' EL PDF TRANSFORMA EL CANÓNICO DE CADA PIEZA, NO EL DEL LIBRO: SIN ESTOS
  ' DATOS ACÁ, LA PÁGINA SUELTA NO SE ACTIVABA NUNCA (RC-XJ-02: EL DATO DE LA
  ' BASE VA EN EL CANÓNICO, NO POR PARÁMETRO).
  ' LA MISMA DERIVACIÓN QUE ensamblar-libro-canonico.xsl: prefijo-NN-resto.
  ' ESA HOJA DESCARTA ESTOS TRES AL COPIAR EL <info> Y LOS VUELVE A ESCRIBIR
  ' DESDE EL MANIFIESTO: NO QUEDAN DUPLICADOS EN EL CANÓNICO DEL LIBRO.
  aUbicacion = Split(sNombreArchivo, "-")
  If aUbicacion.Count >= 3 Then
    sXML &= "  <bibliomisc role=" & cQ & "seccion-libro" & cQ & ">" &
      EscaparXML(aUbicacion[0]) & "</bibliomisc>" & Chr(10)
    sXML &= "  <bibliomisc role=" & cQ & "orden-seccion" & cQ & ">" &
      EscaparXML(aUbicacion[1]) & "</bibliomisc>" & Chr(10)
  Endif

  ' NULL Y VACÍO NO SE EMITEN: LAS HOJAS CAEN AL ELEMENTO Y SU role.
  ' NULL APARTE (RC-GM-17: SIN CORTOCIRCUITO)
  If Not IsNull(hCapitulo["tipo_capitulo"]) Then
    If Len(TrimUTF8(hCapitulo["tipo_capitulo"])) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "tipo-capitulo" & cQ & ">" &
        EscaparXML(TrimUTF8(hCapitulo["tipo_capitulo"])) & "</bibliomisc>" & Chr(10)
    Endif
  Endif

  ' ==========================================================
  ' BLOQUE 2c. ESTILO DE CITA DEL LIBRO
  ' ==========================================================
  ' EL PDF Y LA PASADA DE CITAS TRANSFORMAN EL CANÓNICO DE CADA PIEZA, Y
  ' docbook-to-latex.xsl AGRUPA LAS CITAS SEGÚN EL ESTILO: SIN ESTE DATO VALÍA
  ' SIEMPRE apa (SC-57; RC-XJ-02: EL DATO DE LA BASE VA EN EL CANÓNICO, NO POR
  ' PARÁMETRO). ES EL MISMO VALOR QUE EL BLOQUE 15 DEL CANÓNICO DEL LIBRO;
  ' ensamblar-libro-canonico.xsl LO DESCARTA AL COPIAR LA PIEZA.
  ' preparar_latex_libro.sh Y preparar_citas_libro.sh LO COTEJAN CON EL
  ' ESTILO DEL PREÁMBULO: UN CANÓNICO VIEJO CORTA EN VEZ DE AGRUPAR CON OTRO
  ' ESTILO. NULL Y VACÍO NO SE EMITEN: LOS DETECTA ESE COTEJO.
  ' EL role ES estilo-cita, COMO LA COLUMNA: ANTES ERA csl-style, UN NOMBRE
  ' HEREDADO DE CUANDO EL ESTILO ERA UN .csl (SC-57)
  Try hLibroEstilo = m_ConexionBD.mConn.Exec(
    "SELECT estilo_cita FROM libros_md WHERE id_libro = &1 LIMIT 1", hCapitulo["id_libro"])
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al consultar el estilo de cita del libro:" & Chr(10) & Error.Text)
    Return False
  Endif

  ' RC-GM-17: EL CHEQUEO DE Available VA APARTE DEL DE Error
  If hLibroEstilo.Available Then
    If Not IsNull(hLibroEstilo["estilo_cita"]) Then
      If Len(TrimUTF8(hLibroEstilo["estilo_cita"])) > 0 Then
        sXML &= "  <bibliomisc role=" & cQ & "estilo-cita" & cQ & ">" &
          EscaparXML(TrimUTF8(hLibroEstilo["estilo_cita"])) & "</bibliomisc>" & Chr(10)
      Endif
    Endif
  Endif

  ' ==========================================================
  ' BLOQUE 3. AUTORES (LOOP CAPITULO_AUTOR + AUTORES)
  ' ==========================================================
  ' SE EMITE CADA AUTOR/TRADUCTOR EN ORDEN DE orden_autoria.
  ' EL ENUM rol_autor SOLO TIENE 'autor' Y 'traductor' EN LIBROS.
  While hAutores.Available

    ' DETERMINAR ELEMENTO Y ATRIBUTOS SEGÚN ROL
    sRolAutor = "autor"
    If Not IsNull(hAutores["rol_autor"]) Then
      sRolAutor = TrimUTF8(hAutores["rol_autor"])
    Endif

    Select Case sRolAutor
      Case "traductor"
        sElementoAutor = "othercredit"
        sAtributosAutor = " class=" & cQ & "translator" & cQ
      Case Else
        sElementoAutor = "author"
        sAtributosAutor = ""
    End Select

    sXML &= "  <" & sElementoAutor & sAtributosAutor & ">" & Chr(10)

    ' NOMBRE (PERSONNAME)
    sXML &= "    <personname>" & Chr(10)
    sXML &= "      <firstname>" &
      EscaparXML(TrimUTF8(hAutores["nombre"])) & "</firstname>" & Chr(10)
    sXML &= "      <surname>" &
      EscaparXML(TrimUTF8(hAutores["apellidos"])) & "</surname>" & Chr(10)
    If Not IsNull(hAutores["sufijo"]) And
        Len(TrimUTF8(hAutores["sufijo"])) > 0 Then
      ' DOCBOOK 5.2 USA <lineage> PARA SUFIJOS DE LINAJE (Jr., III).
      ' NO USAMOS <honorific> PORQUE ESE ELEMENTO ES PARA TRATAMIENTOS
      ' (Dr., Prof.) QUE VAN ANTES DEL NOMBRE.
      sXML &= "      <lineage>" &
        EscaparXML(TrimUTF8(hAutores["sufijo"])) & "</lineage>" & Chr(10)
    Endif
    sXML &= "    </personname>" & Chr(10)

    ' ORCID COMO <uri type="orcid">
    If Not IsNull(hAutores["orcid"]) And
        Len(TrimUTF8(hAutores["orcid"])) > 0 Then
      sXML &= "    <uri type=" & cQ & "orcid" & cQ & ">" &
        "https://orcid.org/" & EscaparXML(TrimUTF8(hAutores["orcid"])) &
        "</uri>" & Chr(10)
    Endif

    ' AFILIACIÓN CON PRIORIDAD _momento → DATO ACTUAL DEL AUTOR
    sAfil = ""
    sDept = ""
    sCiudadAfil = ""
    sPaisAfil = ""
    sRor = ""

    If Not IsNull(hAutores["afiliacion_momento"]) And
        Len(TrimUTF8(hAutores["afiliacion_momento"])) > 0 Then
      sAfil = TrimUTF8(hAutores["afiliacion_momento"])
    Else If Not IsNull(hAutores["afiliacion_actual"]) And
        Len(TrimUTF8(hAutores["afiliacion_actual"])) > 0 Then
      sAfil = TrimUTF8(hAutores["afiliacion_actual"])
    Endif

    If Not IsNull(hAutores["departamento_momento"]) And
        Len(TrimUTF8(hAutores["departamento_momento"])) > 0 Then
      sDept = TrimUTF8(hAutores["departamento_momento"])
    Else If Not IsNull(hAutores["departamento"]) And
        Len(TrimUTF8(hAutores["departamento"])) > 0 Then
      sDept = TrimUTF8(hAutores["departamento"])
    Endif

    If Not IsNull(hAutores["ciudad_momento"]) And
        Len(TrimUTF8(hAutores["ciudad_momento"])) > 0 Then
      sCiudadAfil = TrimUTF8(hAutores["ciudad_momento"])
    Else If Not IsNull(hAutores["ciudad_afiliacion"]) And
        Len(TrimUTF8(hAutores["ciudad_afiliacion"])) > 0 Then
      sCiudadAfil = TrimUTF8(hAutores["ciudad_afiliacion"])
    Endif

    If Not IsNull(hAutores["pais_momento"]) And
        Len(TrimUTF8(hAutores["pais_momento"])) > 0 Then
      sPaisAfil = TrimUTF8(hAutores["pais_momento"])
    Else If Not IsNull(hAutores["pais_afiliacion"]) And
        Len(TrimUTF8(hAutores["pais_afiliacion"])) > 0 Then
      sPaisAfil = TrimUTF8(hAutores["pais_afiliacion"])
    Endif

    If Not IsNull(hAutores["ror_afiliacion_momento"]) And
        Len(TrimUTF8(hAutores["ror_afiliacion_momento"])) > 0 Then
      sRor = TrimUTF8(hAutores["ror_afiliacion_momento"])
    Else If Not IsNull(hAutores["ror_afiliacion_actual"]) And
        Len(TrimUTF8(hAutores["ror_afiliacion_actual"])) > 0 Then
      sRor = TrimUTF8(hAutores["ror_afiliacion_actual"])
    Endif

    If sAfil <> "" Or sDept <> "" Or sCiudadAfil <> "" Or sPaisAfil <> "" Or sRor <> "" Then
      sXML &= "    <affiliation>" & Chr(10)
      If sDept <> "" Then
        sXML &= "      <orgdiv>" & EscaparXML(sDept) & "</orgdiv>" & Chr(10)
      Endif
      If sAfil <> "" Then
        sXML &= "      <orgname>" & EscaparXML(sAfil) & "</orgname>" & Chr(10)
      Endif
      If sCiudadAfil <> "" Or sPaisAfil <> "" Then
        sXML &= "      <address>" & Chr(10)
        If sCiudadAfil <> "" Then
          sXML &= "        <city>" & EscaparXML(sCiudadAfil) & "</city>" & Chr(10)
        Endif
        If sPaisAfil <> "" Then
          sXML &= "        <country>" & EscaparXML(sPaisAfil) & "</country>" & Chr(10)
        Endif
        sXML &= "      </address>" & Chr(10)
      Endif
      ' ROR: SE EMITE COMO <otheraddr role="ror"> DENTRO DE <affiliation>.
      ' DOCBOOK 5.2 NO TIENE UN ELEMENTO ESTÁNDAR PARA IDENTIFICADORES
      ' DE ORGANIZACIÓN; <otheraddr> ES EL MÁS APROPIADO SEMÁNTICAMENTE.
      If sRor <> "" Then
        sXML &= "      <otheraddr role=" & cQ & "ror" & cQ & ">" &
          EscaparXML(sRor) & "</otheraddr>" & Chr(10)
      Endif
      sXML &= "    </affiliation>" & Chr(10)
    Endif

    ' NOTAS DEL AUTOR (PROPIAS DE ESTE AUTOR EN ESTE CAPÍTULO)
    If Not IsNull(hAutores["notas_autor"]) And
        Len(TrimUTF8(hAutores["notas_autor"])) > 0 Then
      sXML &= "    <personblurb><para>" &
        EscaparXML(TrimUTF8(hAutores["notas_autor"])) &
        "</para></personblurb>" & Chr(10)
    Endif

    ' ROLES CRediT: PRIORIDAD AL JSON contribuciones_credit;
    ' FALLBACK A taxonomia_credit (TEXT)
    sCredit = ""
    If Not IsNull(hAutores["contribuciones_credit"]) Then
      sCredit = TrimUTF8(hAutores["contribuciones_credit"])
    Endif

    If sCredit <> "" And sCredit <> "null" And sCredit <> "[]" Then
      ' PARSER MÍNIMO DE JSON ARRAY: ["Conceptualization", "Investigation", ...]
      ' SE LIMPIAN CORCHETES, COMILLAS Y SPLIT POR COMA.
      Dim sJsonLimpio As String = sCredit
      sJsonLimpio = Replace(sJsonLimpio, "[", "")
      sJsonLimpio = Replace(sJsonLimpio, "]", "")
      sJsonLimpio = Replace(sJsonLimpio, cQ, "")
      sJsonLimpio = TrimUTF8(sJsonLimpio)
      If sJsonLimpio <> "" Then
        aRoles = Split(sJsonLimpio, ",")
        For Each sRole In aRoles
          sRole = TrimUTF8(sRole)
          If sRole <> "" Then
            sXML &= "    <bibliomisc role=" & cQ & "credit-role" & cQ & ">" &
              EscaparXML(sRole) & "</bibliomisc>" & Chr(10)
          Endif
        Next
      Endif
    Else If Not IsNull(hAutores["taxonomia_credit"]) And
        Len(TrimUTF8(hAutores["taxonomia_credit"])) > 0 Then
      ' FALLBACK: TEXTO PLANO
      sXML &= "    <bibliomisc role=" & cQ & "credit-roles-texto" & cQ & ">" &
        EscaparXML(TrimUTF8(hAutores["taxonomia_credit"])) &
        "</bibliomisc>" & Chr(10)
    Endif

    sXML &= "  </" & sElementoAutor & ">" & Chr(10)
    hAutores.MoveNext
  Wend

  ' ==========================================================
  ' BLOQUE 4. AUTORES CORPORATIVOS / ANÓNIMOS / GRUPALES
  ' ==========================================================
  ' AUTOR CORPORATIVO: <author><orgname>...
  If Not IsNull(hCapitulo["autor_corporativo"]) And
      Len(TrimUTF8(hCapitulo["autor_corporativo"])) > 0 Then
    sXML &= "  <author>" & Chr(10)
    sXML &= "    <orgname>" &
      EscaparXML(TrimUTF8(hCapitulo["autor_corporativo"])) &
      "</orgname>" & Chr(10)
    sXML &= "  </author>" & Chr(10)
  Endif

  ' AUTORES ANÓNIMOS: <author><othername role="anonymous"/></author>
  If hCapitulo["autores_anonimos"] = True Then
    sXML &= "  <author><personname><othername role=" & cQ & "anonymous" & cQ &
      "/></personname></author>" & Chr(10)
  Endif

  ' GRUPO DE AUTORES: <authorgroup><collab><orgname>...
  If Not IsNull(hCapitulo["grupo_autores"]) And
      Len(TrimUTF8(hCapitulo["grupo_autores"])) > 0 Then
    sXML &= "  <authorgroup>" & Chr(10)
    sXML &= "    <collab>" & Chr(10)
    sXML &= "      <orgname>" &
      EscaparXML(TrimUTF8(hCapitulo["grupo_autores"])) &
      "</orgname>" & Chr(10)
    sXML &= "    </collab>" & Chr(10)
    sXML &= "  </authorgroup>" & Chr(10)
  Endif

  ' NOTAS DE AUTORÍA (A NIVEL CAPÍTULO, NO DE AUTOR INDIVIDUAL)
  If Not IsNull(hCapitulo["author_notes"]) And
      Len(TrimUTF8(hCapitulo["author_notes"])) > 0 Then
    sXML &= "  <authorblurb><para>" &
      EscaparXML(TrimUTF8(hCapitulo["author_notes"])) &
      "</para></authorblurb>" & Chr(10)
  Endif

  ' ==========================================================
  ' BLOQUE 5. RESÚMENES (HASTA 3 IDIOMAS)
  ' ==========================================================
  Dim iIdxResumen As Integer
  Dim sResumen As String
  Dim sIdiomaResumen As String
  Dim sCampoResumen As String
  Dim sCampoIdiomaResumen As String

  For iIdxResumen = 1 To 3
    sCampoResumen = "resumen_" & CStr(iIdxResumen)
    sCampoIdiomaResumen = "idioma_resumen_" & CStr(iIdxResumen)
    sResumen = ""
    sIdiomaResumen = ""

    If Not IsNull(hCapitulo[sCampoResumen]) And
        Len(TrimUTF8(hCapitulo[sCampoResumen])) > 0 Then
      sResumen = TrimUTF8(hCapitulo[sCampoResumen])
    Endif

    If sResumen = "" Then Continue

    If Not IsNull(hCapitulo[sCampoIdiomaResumen]) Then
      sIdiomaResumen = TrimUTF8(hCapitulo[sCampoIdiomaResumen])
    Endif

    sXML &= "  <abstract"
    If sIdiomaResumen <> "" Then
      sXML &= " xml:lang=" & cQ & EscaparXML(sIdiomaResumen) & cQ
    Endif
    sXML &= ">" & Chr(10)
    sXML &= "    <para>" & EscaparXML(sResumen) & "</para>" & Chr(10)
    sXML &= "  </abstract>" & Chr(10)
  Next

  ' ==========================================================
  ' BLOQUE 6. PALABRAS CLAVE (HASTA 3 IDIOMAS)
  ' ==========================================================
  Dim iIdxKwd As Integer
  Dim sCsvKwd As String
  Dim sIdiomaKwd As String
  Dim sCampoKwd As String
  Dim sCampoIdiomaKwd As String

  For iIdxKwd = 1 To 3
    sCampoKwd = "palabras_clave_" & CStr(iIdxKwd)
    sCampoIdiomaKwd = "idioma_kwd_" & CStr(iIdxKwd)
    sCsvKwd = ""
    sIdiomaKwd = ""

    If Not IsNull(hCapitulo[sCampoKwd]) And
        Len(TrimUTF8(hCapitulo[sCampoKwd])) > 0 Then
      sCsvKwd = TrimUTF8(hCapitulo[sCampoKwd])
    Endif

    If sCsvKwd = "" Then Continue

    If Not IsNull(hCapitulo[sCampoIdiomaKwd]) Then
      sIdiomaKwd = TrimUTF8(hCapitulo[sCampoIdiomaKwd])
    Endif

    sXML &= "  <keywordset"
    If sIdiomaKwd <> "" Then
      sXML &= " xml:lang=" & cQ & EscaparXML(sIdiomaKwd) & cQ
    Endif
    sXML &= ">" & Chr(10)

    ' SPLIT POR COMA (PATRÓN ESTÁNDAR EN BIBLIOTECONOMÍA Y EN REVISTAS)
    aKwd = Split(sCsvKwd, ",")
    For Each sKwd In aKwd
      sKwd = TrimUTF8(sKwd)
      If sKwd <> "" Then
        sXML &= "    <keyword>" & EscaparXML(sKwd) & "</keyword>" & Chr(10)
      Endif
    Next
    sXML &= "  </keywordset>" & Chr(10)
  Next

  ' ==========================================================
  ' BLOQUE 7. CLASIFICACIONES (MeSH, DeCS, TEMÁTICA)
  ' ==========================================================
  ' MeSH (MEDICAL SUBJECT HEADINGS) — CSV
  If Not IsNull(hCapitulo["mesh_terms"]) And
      Len(TrimUTF8(hCapitulo["mesh_terms"])) > 0 Then
    sXML &= "  <subjectset scheme=" & cQ & "MeSH" & cQ & ">" & Chr(10)
    aTerminos = Split(TrimUTF8(hCapitulo["mesh_terms"]), ",")
    For Each sTermino In aTerminos
      sTermino = TrimUTF8(sTermino)
      If sTermino <> "" Then
        sXML &= "    <subject><subjectterm>" & EscaparXML(sTermino) &
          "</subjectterm></subject>" & Chr(10)
      Endif
    Next
    sXML &= "  </subjectset>" & Chr(10)
  Endif

  ' DeCS (DESCRIPTORES EN CIENCIAS DE LA SALUD) — CSV
  If Not IsNull(hCapitulo["descriptores_decs"]) And
      Len(TrimUTF8(hCapitulo["descriptores_decs"])) > 0 Then
    sXML &= "  <subjectset scheme=" & cQ & "DeCS" & cQ & ">" & Chr(10)
    aTerminos = Split(TrimUTF8(hCapitulo["descriptores_decs"]), ",")
    For Each sTermino In aTerminos
      sTermino = TrimUTF8(sTermino)
      If sTermino <> "" Then
        sXML &= "    <subject><subjectterm>" & EscaparXML(sTermino) &
          "</subjectterm></subject>" & Chr(10)
      Endif
    Next
    sXML &= "  </subjectset>" & Chr(10)
  Endif

  ' CLASIFICACIÓN TEMÁTICA EDITORIAL — CSV
  If Not IsNull(hCapitulo["clasificacion_tematica"]) And
      Len(TrimUTF8(hCapitulo["clasificacion_tematica"])) > 0 Then
    sXML &= "  <subjectset role=" & cQ & "tematica" & cQ & ">" & Chr(10)
    aTerminos = Split(TrimUTF8(hCapitulo["clasificacion_tematica"]), ",")
    For Each sTermino In aTerminos
      sTermino = TrimUTF8(sTermino)
      If sTermino <> "" Then
        sXML &= "    <subject><subjectterm>" & EscaparXML(sTermino) &
          "</subjectterm></subject>" & Chr(10)
      Endif
    Next
    sXML &= "  </subjectset>" & Chr(10)
  Endif

  ' ==========================================================
  ' BLOQUE 8. FECHAS
  ' ==========================================================
  sFechaPubOnline = ""
  sFechaRecep = ""
  sFechaAcept = ""
  sFechaRev = ""

  If Not IsNull(hCapitulo["fecha_online_iso"]) Then
    sFechaPubOnline = CStr(hCapitulo["fecha_online_iso"])
  Endif
  If Not IsNull(hCapitulo["fecha_rec_iso"]) Then
    sFechaRecep = CStr(hCapitulo["fecha_rec_iso"])
  Endif
  If Not IsNull(hCapitulo["fecha_ace_iso"]) Then
    sFechaAcept = CStr(hCapitulo["fecha_ace_iso"])
  Endif
  If Not IsNull(hCapitulo["fecha_rev_iso"]) Then
    sFechaRev = CStr(hCapitulo["fecha_rev_iso"])
  Endif

  If sFechaPubOnline <> "" Then
    sXML &= "  <date role=" & cQ & "publicacion-online" & cQ & ">" &
      EscaparXML(sFechaPubOnline) & "</date>" & Chr(10)
  Endif
  If sFechaRecep <> "" Then
    sXML &= "  <date role=" & cQ & "recepcion" & cQ & ">" &
      EscaparXML(sFechaRecep) & "</date>" & Chr(10)
  Endif
  If sFechaAcept <> "" Then
    sXML &= "  <date role=" & cQ & "aceptacion" & cQ & ">" &
      EscaparXML(sFechaAcept) & "</date>" & Chr(10)
  Endif
  If sFechaRev <> "" Then
    sXML &= "  <date role=" & cQ & "revision" & cQ & ">" &
      EscaparXML(sFechaRev) & "</date>" & Chr(10)
  Endif

  ' ==========================================================
  ' BLOQUE 9. PAGINACIÓN
  ' ==========================================================
  Dim sPagIni As String = ""
  Dim sPagFin As String = ""

  If Not IsNull(hCapitulo["pagina_inicio"]) Then
    sPagIni = TrimUTF8(hCapitulo["pagina_inicio"])
  Endif
  If Not IsNull(hCapitulo["pagina_fin"]) Then
    sPagFin = TrimUTF8(hCapitulo["pagina_fin"])
  Endif

  If sPagIni <> "" Or sPagFin <> "" Then
    sXML &= "  <bibliomisc role=" & cQ & "paginas" & cQ & ">" &
      EscaparXML(sPagIni)
    If sPagFin <> "" Then
      sXML &= "-" & EscaparXML(sPagFin)
    Endif
    sXML &= "</bibliomisc>" & Chr(10)
  Endif

  If Not IsNull(hCapitulo["numero_paginas"]) Then
    If CInt(hCapitulo["numero_paginas"]) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "numero-paginas" & cQ & ">" &
        CStr(hCapitulo["numero_paginas"]) & "</bibliomisc>" & Chr(10)
    Endif
  Endif

  ' ==========================================================
  ' BLOQUE 10. FINANCIAMIENTO
  ' ==========================================================
  If Not IsNull(hCapitulo["financiamiento"]) And
      Len(TrimUTF8(hCapitulo["financiamiento"])) > 0 Then
    sXML &= "  <bibliomisc role=" & cQ & "financiamiento" & cQ & ">" &
      EscaparXML(TrimUTF8(hCapitulo["financiamiento"])) &
      "</bibliomisc>" & Chr(10)
  Endif

  If Not IsNull(hCapitulo["numero_proyecto"]) And
      Len(TrimUTF8(hCapitulo["numero_proyecto"])) > 0 Then
    sXML &= "  <bibliomisc role=" & cQ & "numero-proyecto" & cQ & ">" &
      EscaparXML(TrimUTF8(hCapitulo["numero_proyecto"])) &
      "</bibliomisc>" & Chr(10)
  Endif

  If Not IsNull(hCapitulo["funding_statement"]) And
      Len(TrimUTF8(hCapitulo["funding_statement"])) > 0 Then
    sXML &= "  <bibliomisc role=" & cQ & "funding-statement" & cQ & ">" &
      EscaparXML(TrimUTF8(hCapitulo["funding_statement"])) &
      "</bibliomisc>" & Chr(10)
  Endif

  ' ==========================================================
  ' BLOQUE 11. CONFLICTOS DE INTERÉS
  ' ==========================================================
  ' SOLO EMITIMOS SI tiene_conflictos = True. EL FLAG ES LA AUTORIDAD;
  ' EL CAMPO conflictos_interes ES SU TEXTO ASOCIADO.
  If hCapitulo["tiene_conflictos"] = True Then
    If Not IsNull(hCapitulo["conflictos_interes"]) And
        Len(TrimUTF8(hCapitulo["conflictos_interes"])) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "conflictos-interes" & cQ & ">" &
        EscaparXML(TrimUTF8(hCapitulo["conflictos_interes"])) &
        "</bibliomisc>" & Chr(10)
    Else
      ' FLAG SIN TEXTO: EMITIR DECLARACIÓN VACÍA EXPLÍCITA
      sXML &= "  <bibliomisc role=" & cQ & "conflictos-interes" & cQ &
        ">Los autores declaran conflictos de interés.</bibliomisc>" & Chr(10)
    Endif
  Endif

  ' ==========================================================
  ' BLOQUE 12. ÉTICA
  ' ==========================================================
  If Not IsNull(hCapitulo["declaracion_etica"]) And
      Len(TrimUTF8(hCapitulo["declaracion_etica"])) > 0 Then
    sXML &= "  <bibliomisc role=" & cQ & "declaracion-etica" & cQ & ">" &
      EscaparXML(TrimUTF8(hCapitulo["declaracion_etica"])) &
      "</bibliomisc>" & Chr(10)
  Endif

  If hCapitulo["consentimiento_informado"] = True Then
    sXML &= "  <bibliomisc role=" & cQ & "consentimiento-informado" & cQ &
      ">yes</bibliomisc>" & Chr(10)
  Endif

  If hCapitulo["aprobacion_comite_etica"] = True Then
    sXML &= "  <bibliomisc role=" & cQ & "aprobacion-comite-etica" & cQ &
      ">yes</bibliomisc>" & Chr(10)
  Endif

  If Not IsNull(hCapitulo["numero_aprobacion_etica"]) And
      Len(TrimUTF8(hCapitulo["numero_aprobacion_etica"])) > 0 Then
    sXML &= "  <bibliomisc role=" & cQ & "numero-aprobacion-etica" & cQ & ">" &
      EscaparXML(TrimUTF8(hCapitulo["numero_aprobacion_etica"])) &
      "</bibliomisc>" & Chr(10)
  Endif

  ' ==========================================================
  ' BLOQUE 13. DATOS ASOCIADOS
  ' ==========================================================
  If Not IsNull(hCapitulo["material_suplementario"]) And
      Len(TrimUTF8(hCapitulo["material_suplementario"])) > 0 Then
    sXML &= "  <bibliomisc role=" & cQ & "material-suplementario" & cQ & ">" &
      EscaparXML(TrimUTF8(hCapitulo["material_suplementario"])) &
      "</bibliomisc>" & Chr(10)
  Endif

  If Not IsNull(hCapitulo["dataset_asociado"]) And
      Len(TrimUTF8(hCapitulo["dataset_asociado"])) > 0 Then
    sXML &= "  <bibliomisc role=" & cQ & "dataset-asociado" & cQ & ">" &
      EscaparXML(TrimUTF8(hCapitulo["dataset_asociado"])) &
      "</bibliomisc>" & Chr(10)
  Endif

  If Not IsNull(hCapitulo["disponibilidad_datos"]) And
      Len(TrimUTF8(hCapitulo["disponibilidad_datos"])) > 0 Then
    sXML &= "  <bibliomisc role=" & cQ & "disponibilidad-datos" & cQ & ">" &
      EscaparXML(TrimUTF8(hCapitulo["disponibilidad_datos"])) &
      "</bibliomisc>" & Chr(10)
  Endif

  If Not IsNull(hCapitulo["data_availability_statement"]) And
      Len(TrimUTF8(hCapitulo["data_availability_statement"])) > 0 Then
    sXML &= "  <bibliomisc role=" & cQ & "data-availability-statement" & cQ & ">" &
      EscaparXML(TrimUTF8(hCapitulo["data_availability_statement"])) &
      "</bibliomisc>" & Chr(10)
  Endif

  ' ==========================================================
  ' BLOQUE 14. LICENCIA Y COPYRIGHT
  ' ==========================================================
  ' LICENCIA: USAMOS <legalnotice role="licencia"> CON <para> INTERNO.
  ' SI HAY URL DE LICENCIA, SE EMITE EN UN <para> SEPARADO CON <link>.
  If Not IsNull(hCapitulo["licencia"]) And
      Len(TrimUTF8(hCapitulo["licencia"])) > 0 Then
    sXML &= "  <legalnotice role=" & cQ & "licencia" & cQ & ">" & Chr(10)
    sXML &= "    <para>" & EscaparXML(TrimUTF8(hCapitulo["licencia"])) &
      "</para>" & Chr(10)
    If Not IsNull(hCapitulo["url_licencia"]) And
        Len(TrimUTF8(hCapitulo["url_licencia"])) > 0 Then
      Dim sUrlLic As String = TrimUTF8(hCapitulo["url_licencia"])
      sXML &= "    <para><link xlink:href=" & cQ & EscaparXML(sUrlLic) & cQ &
        ">" & EscaparXML(sUrlLic) & "</link></para>" & Chr(10)
    Endif
    sXML &= "  </legalnotice>" & Chr(10)
  Endif

  ' COPYRIGHT: ESTRUCTURADO CON <year> Y <holder>
  Dim sCopyHolder As String = ""
  Dim sCopyYear As String = ""

  If Not IsNull(hCapitulo["copyright_holder"]) And
      Len(TrimUTF8(hCapitulo["copyright_holder"])) > 0 Then
    sCopyHolder = TrimUTF8(hCapitulo["copyright_holder"])
  Endif

  If Not IsNull(hCapitulo["copyright_year"]) Then
    If CStr(hCapitulo["copyright_year"]) <> "0" Then
      sCopyYear = CStr(hCapitulo["copyright_year"])
    Endif
  Endif

  If sCopyHolder <> "" Or sCopyYear <> "" Then
    sXML &= "  <copyright>" & Chr(10)
    If sCopyYear <> "" Then
      sXML &= "    <year>" & EscaparXML(sCopyYear) & "</year>" & Chr(10)
    Endif
    If sCopyHolder <> "" Then
      sXML &= "    <holder>" & EscaparXML(sCopyHolder) & "</holder>" & Chr(10)
    Endif
    sXML &= "  </copyright>" & Chr(10)
  Endif

  ' DECLARACIÓN DE COPYRIGHT (TEXTO LIBRE COMPLEMENTARIO)
  If Not IsNull(hCapitulo["declaracion_copyright"]) And
      Len(TrimUTF8(hCapitulo["declaracion_copyright"])) > 0 Then
    sXML &= "  <bibliomisc role=" & cQ & "declaracion-copyright" & cQ & ">" &
      EscaparXML(TrimUTF8(hCapitulo["declaracion_copyright"])) &
      "</bibliomisc>" & Chr(10)
  Endif

  ' ==========================================================
  ' BLOQUE 15. URLs
  ' ==========================================================
  If Not IsNull(hCapitulo["url_capitulo"]) And
      Len(TrimUTF8(hCapitulo["url_capitulo"])) > 0 Then
    sXML &= "  <bibliomisc role=" & cQ & "url-capitulo" & cQ & ">" &
      EscaparXML(TrimUTF8(hCapitulo["url_capitulo"])) &
      "</bibliomisc>" & Chr(10)
  Endif

  If Not IsNull(hCapitulo["url_pdf"]) And
      Len(TrimUTF8(hCapitulo["url_pdf"])) > 0 Then
    sXML &= "  <bibliomisc role=" & cQ & "url-pdf" & cQ & ">" &
      EscaparXML(TrimUTF8(hCapitulo["url_pdf"])) &
      "</bibliomisc>" & Chr(10)
  Endif

  ' ==========================================================
  ' BLOQUE 16. CONTEOS (FIGURAS, TABLAS, ECUACIONES)
  ' ==========================================================
  If Not IsNull(hCapitulo["numero_figuras"]) Then
    If CInt(hCapitulo["numero_figuras"]) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "numero-figuras" & cQ & ">" &
        CStr(hCapitulo["numero_figuras"]) & "</bibliomisc>" & Chr(10)
    Endif
  Endif

  If Not IsNull(hCapitulo["numero_tablas"]) Then
    If CInt(hCapitulo["numero_tablas"]) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "numero-tablas" & cQ & ">" &
        CStr(hCapitulo["numero_tablas"]) & "</bibliomisc>" & Chr(10)
    Endif
  Endif

  If Not IsNull(hCapitulo["numero_ecuaciones"]) Then
    If CInt(hCapitulo["numero_ecuaciones"]) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "numero-ecuaciones" & cQ & ">" &
        CStr(hCapitulo["numero_ecuaciones"]) & "</bibliomisc>" & Chr(10)
    Endif
  Endif

  ' ==========================================================
  ' CIERRE Y GRABADO
  ' ==========================================================
  sXML &= "</info>" & Chr(10)

  Try File.Save(sFilePath, sXML)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al guardar info xml en " & sFilePath & ":" & Chr(10) & Error.Text)
    Return False
  Endif

  Return Exist(sFilePath)

Catch
  m_Sonido.sonar("Error")
  Message.Error("Error inesperado en GenerarInfoCapituloXML:" & Chr(10) &
    Error.Text & Chr(10) & "Donde: " & Error.Where)
  Return False

End Function


' ==========================================================
' FUNCIÓN PÚBLICA: GenerarInfoLibroXML
' ==========================================================
' ANÁLOGA A GenerarInfoCapituloXML PERO A NIVEL DE LIBRO.
' PRODUCE EL FRAGMENTO <info> QUE VA COMO PRIMER HIJO DEL <book>
' EN EL CANÓNICO ENSAMBLADO DEL LIBRO COMPLETO.
'
' FUENTES DE DATOS:
'   - libros_md (por id_libro)
'   - LEFT JOIN colecciones (si id_coleccion está seteado)
'   - LEFT JOIN series      (si id_serie está seteado)
'   - libro_autor + autores (autores/editores/compiladores del libro)
'
' ESTRUCTURA DEL <info> GENERADO (16 BLOQUES):
'   1.  Títulos (titulo_libro, subtitulo, titulo_abreviado, titulo_original)
'   2.  Identificadores editoriales (ISBN impreso/electrónico, DOI, handle, SciELO id)
'   3.  Autores del libro (loop libro_autor + autores)
'   4.  Datos editoriales (publisher, address)
'   5.  Colección / serie (biblioset relation)
'   6.  Edición (edition, numero_edicion, numero_paginas)
'   7.  Fechas de publicación
'   8.  Idiomas
'   9.  Tipo y estado de publicación
'   10. Área temática, palabras clave, clasificaciones
'   11. Resumen, descripción, objetivos
'   12. Acceso, licencia, embargo
'   13. URLs (url_libro, oai-pmh, logo)
'   14. Repositorios de producción y preservación
'   15. Estilo de cita (CSL)
'   16. Portada (mediaobject role="tapa")
'
' SALIDA: tmp/info-libro-{nombre_base_del_l_md}.xml
'   ej.: proyecto con l-libronombre.md → tmp/info-libro-libronombre.xml
'
' Propósito : Genera el fragmento <info> en DocBook 5.2 para un libro
'             específico, leyendo la tabla libros_md + JOINs a
'             colecciones, series y libro_autor + autores.
'             Escribe el resultado en tmp/info-libro-{nombre}.xml.
' Parámetros: iIdLibro As Integer — id_libro de la BD
' Retorna   : Boolean — True si el archivo fue generado exitosamente
' ============================================
Public Function GenerarInfoLibroXML(iIdLibro As Integer) As Boolean

  ' --- 0. DECLARACIÓN DE VARIABLES ---
  ' COMILLA DOBLE COMO VARIABLE LOCAL PARA RESPETAR SC-01
  Dim cQ As String = Chr(34)

  Dim hLibro As Result
  Dim hAutores As Result
  Dim sXML As String
  Dim sDirTmp As String
  Dim sFilePath As String
  Dim sNombreArchivoMadre As String
  Dim sNombreBase As String

  ' VARIABLES PARA EL LOOP DE AUTORES DEL LIBRO
  Dim sRolLibro As String
  Dim sElementoAutor As String
  Dim sAtributosAutor As String
  Dim sAfil As String
  Dim sDept As String
  Dim sCiudadAfil As String
  Dim sPaisAfil As String
  Dim sRor As String
  Dim sCredit As String
  Dim aRoles As String[]
  Dim sRole As String

  ' VARIABLES PARA COLECCION / SERIE
  Dim sColNombre As String
  Dim sColAbrev As String
  Dim sColIssn As String
  Dim sSerieNombre As String
  Dim sSerieAbrev As String
  Dim sSerieIssn As String

  ' VARIABLES PARA KEYWORDS Y CLASIFICACIONES
  Dim aTerminos As String[]
  Dim sTermino As String

  ' VARIABLES PARA TÍTULO ORIGINAL (BLOQUE 1)
  Dim sIdiomaOrig As String

  ' VARIABLES PARA CRediT DE AUTORES (BLOQUE 3)
  Dim sJsonLimpio As String

  ' VARIABLES PARA DATOS EDITORIALES (BLOQUE 4): UNA VUELTA POR EDITORIAL
  ' DEL LIBRO (libro_editorial, 2.2.0)
  Dim hEditoriales As Result
  Dim sEditorial As String
  Dim sInstitucionEd As String
  Dim sRorEditorial As String
  Dim sCiudadPub As String
  Dim sPaisPub As String
  Dim sDireccionEd As String
  Dim sEmailEd As String
  Dim sEmailLibro As String

  ' VARIABLES PARA RESUMEN Y RESUMEN TRADUCIDO (BLOQUE 11)
  Dim sIdiomaPrinc As String
  Dim sIdiomaTrad As String

  ' VARIABLES PARA LICENCIA (BLOQUE 12)
  Dim sUrlLic As String

  ' VARIABLES PARA PORTADA (BLOQUE 16)
  Dim sImagenTapa As String
  Dim sTituloTapa As String

  ' --- 1. PREPARAR DIRECTORIO TEMPORAL ---
  sDirTmp = m_InicioCierre.RutaProyectoEnCurso &/ "tmp"

  ' --- 2. CONSULTAR DATOS DEL LIBRO CON JOINs A COLECCIONES Y SERIES ---
  ' LAS FECHAS SE PIDEN EN FORMATO ISO YYYY-MM-DD PARA CONSISTENCIA
  ' CON EL RESTO DEL PIPELINE.
  ' LEFT JOIN A COLECCIONES Y SERIES: SI id_coleccion O id_serie ESTÁN
  ' NULL, LAS COLUMNAS DEVUELVEN NULL SIN AFECTAR LA CONSULTA PRINCIPAL.
  Try hLibro = m_ConexionBD.mConn.Exec(
    "SELECT libros_md.*, " &
    "DATE_FORMAT(fecha_publicacion_completa, '%Y-%m-%d') AS fecha_pub_iso, " &
    "colecciones.nombre AS coleccion_nombre, " &
    "colecciones.nombre_abreviado AS coleccion_abrev, " &
    "colecciones.issn AS coleccion_issn, " &
    "series.nombre AS serie_nombre, " &
    "series.nombre_abreviado AS serie_abrev, " &
    "series.issn AS serie_issn " &
    "FROM libros_md " &
    "LEFT JOIN colecciones ON libros_md.id_coleccion = colecciones.id_coleccion " &
    "LEFT JOIN series ON libros_md.id_serie = series.id_serie " &
    "WHERE libros_md.id_libro = &1 LIMIT 1", iIdLibro)

  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al consultar el libro:" & Chr(10) & Error.Text)
    Return False
  Endif

  If Not hLibro.Available Then
    m_Sonido.sonar("Error")
    Message.Error("No se encontraron datos para el libro id=" & CStr(iIdLibro))
    Return False
  Endif

  ' NOMBRE DEL ARCHIVO DE SALIDA:
  ' EL ARCHIVO MADRE DEL PROYECTO ES l-{basename}.md
  ' EL info-libro TOMA ESE {basename} PARA EL NOMBRE:
  '   l-libronombre.md → tmp/info-libro-libronombre.xml
  sNombreArchivoMadre = File.BaseName(m_InicioCierre.NombreProyectoEnCurso)
  ' STRIP DEL PREFIJO "l-" SI ESTÁ (POR CONVENCIÓN DE ARCHIVOS DEL PROYECTO)
  If Left(sNombreArchivoMadre, 2) = "l-" Then
    sNombreBase = Mid(sNombreArchivoMadre, 3)
  Else
    sNombreBase = sNombreArchivoMadre
  Endif
  sFilePath = sDirTmp & "/info-libro-" & sNombreBase & ".xml"

  ' --- 3. CONSULTAR AUTORES DEL LIBRO ---
  ' JOIN libro_autor + autores CON PRIORIDAD A LOS DATOS DEL MOMENTO
  ' (capturados al asignar el autor al libro) SOBRE LOS DATOS VIGENTES
  ' DEL AUTOR (que pueden haber cambiado).
  Try hAutores = m_ConexionBD.mConn.Exec(
    "SELECT a.id_autor, a.apellidos, a.nombre, a.sufijo, a.orcid, " &
    "a.afiliacion_actual, a.departamento, a.ciudad_afiliacion, a.pais_afiliacion, " &
    "a.ror_afiliacion_actual, a.biografia_corta, " &
    "la.orden_autoria, la.rol_libro, " &
    "la.afiliacion_momento, la.departamento_momento, la.ciudad_momento, " &
    "la.pais_momento, la.ror_afiliacion_momento, " &
    "la.contribuciones_credit, la.notas_autor " &
    "FROM autores a " &
    "INNER JOIN libro_autor la ON a.id_autor = la.id_autor " &
    "WHERE la.id_libro = &1 " &
    "ORDER BY la.orden_autoria ASC",
    iIdLibro)

  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al consultar autores del libro:" & Chr(10) & Error.Text)
    Return False
  Endif

  ' --- 4. ABRIR EL ELEMENTO RAÍZ <info> ---
  ' NAMESPACES: docbook COMO DEFAULT, xlink PARA <legalnotice> QUE USA
  ' <link xlink:href="...">. EL XSL DE ENSAMBLADO DEL LIBRO RE-DECLARA
  ' ESTOS NAMESPACES EN EL WRAPPER RAÍZ DEL CANÓNICO.
  sXML = "<info xmlns=" & cQ & "http://docbook.org/ns/docbook" & cQ &
    " xmlns:xlink=" & cQ & "http://www.w3.org/1999/xlink" & cQ & ">" & Chr(10)

  ' ==========================================================
  ' BLOQUE 1. TÍTULOS
  ' ==========================================================
  ' EL <title> ES OBLIGATORIO EN DOCBOOK 5.2 PARA <book>.
  ' SI FALTA (NO DEBERÍA POR NOT NULL EN BD, PERO POR DEFENSA),
  ' EMITIMOS PLACEHOLDER PARA QUE VALIDE.
  ' EL CORTE DEL EDITOR VA COMO <?gb-corte?> EN EL TÍTULO Y EL SUBTÍTULO
  ' (SC-28). EL ABREVIADO Y EL ORIGINAL NO CORTAN: VAN PLANOS
  If Not IsNull(hLibro["titulo_libro"]) Then
    If Len(TrimUTF8(hLibro["titulo_libro"])) > 0 Then
      sXML &= "  <title>" & TituloXML(hLibro["titulo_libro"], m_CorteTitulo.SEPARADOR_DOCBOOK) &
        "</title>" & Chr(10)
    Else
      sXML &= "  <title>[SIN TÍTULO]</title>" & Chr(10)
    Endif
  Else
    sXML &= "  <title>[SIN TÍTULO]</title>" & Chr(10)
  Endif

  If Not IsNull(hLibro["subtitulo"]) Then
    If Len(TrimUTF8(hLibro["subtitulo"])) > 0 Then
      sXML &= "  <subtitle>" & TituloXML(hLibro["subtitulo"], m_CorteTitulo.SEPARADOR_DOCBOOK) &
        "</subtitle>" & Chr(10)
    Endif
  Endif

  If Not IsNull(hLibro["titulo_abreviado"]) Then
    If Len(TrimUTF8(hLibro["titulo_abreviado"])) > 0 Then
      sXML &= "  <titleabbrev>" & EscaparXML(m_CorteTitulo.Plano(hLibro["titulo_abreviado"])) &
        "</titleabbrev>" & Chr(10)
    Endif
  Endif

  ' TÍTULO ORIGINAL: VA EN <bibliomisc role="titulo-original"> CON SU
  ' xml:lang SI ESTÁ INDICADO. UN SEGUNDO <title> EN <info> INVALIDA EL
  ' CANÓNICO CONTRA EL RNG DE DocBook 5.2 (VERIFICADO); bibliomisc CON role
  ' ES EL PATRÓN DEL CANÓNICO PARA LOS DATOS SIN ELEMENTO PROPIO
  If Not IsNull(hLibro["titulo_original"]) Then
    If Len(TrimUTF8(hLibro["titulo_original"])) > 0 Then
      sIdiomaOrig = ""
      If Not IsNull(hLibro["idioma_titulo_original"]) Then
        sIdiomaOrig = TrimUTF8(hLibro["idioma_titulo_original"])
      Endif
      sXML &= "  <bibliomisc role=" & cQ & "titulo-original" & cQ
      If sIdiomaOrig <> "" Then
        sXML &= " xml:lang=" & cQ & EscaparXML(sIdiomaOrig) & cQ
      Endif
      sXML &= ">" & EscaparXML(m_CorteTitulo.Plano(hLibro["titulo_original"])) &
        "</bibliomisc>" & Chr(10)
    Endif
  Endif

  ' ==========================================================
  ' BLOQUE 2. IDENTIFICADORES EDITORIALES
  ' ==========================================================
  ' ISBN IMPRESO: biblioid class="isbn" role="print"
  If Not IsNull(hLibro["isbn_impreso"]) Then
    If Len(TrimUTF8(hLibro["isbn_impreso"])) > 0 Then
      sXML &= "  <biblioid class=" & cQ & "isbn" & cQ &
        " role=" & cQ & "print" & cQ & ">" &
        EscaparXML(TrimUTF8(hLibro["isbn_impreso"])) & "</biblioid>" & Chr(10)
    Endif
  Endif

  ' ISBN ELECTRÓNICO: biblioid class="isbn" role="electronic"
  If Not IsNull(hLibro["isbn_electronico"]) Then
    If Len(TrimUTF8(hLibro["isbn_electronico"])) > 0 Then
      sXML &= "  <biblioid class=" & cQ & "isbn" & cQ &
        " role=" & cQ & "electronic" & cQ & ">" &
        EscaparXML(TrimUTF8(hLibro["isbn_electronico"])) & "</biblioid>" & Chr(10)
    Endif
  Endif

  ' DOI DEL LIBRO
  If Not IsNull(hLibro["doi_libro"]) Then
    If Len(TrimUTF8(hLibro["doi_libro"])) > 0 Then
      sXML &= "  <biblioid class=" & cQ & "doi" & cQ & ">" &
        EscaparXML(TrimUTF8(hLibro["doi_libro"])) & "</biblioid>" & Chr(10)
    Endif
  Endif

  ' HANDLE PREFIX
  If Not IsNull(hLibro["handle_prefix"]) Then
    If Len(TrimUTF8(hLibro["handle_prefix"])) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "handle-prefix" & cQ & ">" &
        EscaparXML(TrimUTF8(hLibro["handle_prefix"])) &
        "</bibliomisc>" & Chr(10)
    Endif
  Endif

  ' IDENTIFICADOR SCIELO
  If Not IsNull(hLibro["identificador_scielo"]) Then
    If Len(TrimUTF8(hLibro["identificador_scielo"])) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "scielo-id" & cQ & ">" &
        EscaparXML(TrimUTF8(hLibro["identificador_scielo"])) &
        "</bibliomisc>" & Chr(10)
    Endif
  Endif

  ' URL DE DESCARGA PDF (LIBRO COMPLETO)
  If Not IsNull(hLibro["url_descarga_pdf"]) Then
    If Len(TrimUTF8(hLibro["url_descarga_pdf"])) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "url-descarga-pdf" & cQ & ">" &
        EscaparXML(TrimUTF8(hLibro["url_descarga_pdf"])) &
        "</bibliomisc>" & Chr(10)
    Endif
  Endif

  ' URL DE DESCARGA EPUB (LIBRO COMPLETO)
  If Not IsNull(hLibro["url_descarga_epub"]) Then
    If Len(TrimUTF8(hLibro["url_descarga_epub"])) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "url-descarga-epub" & cQ & ">" &
        EscaparXML(TrimUTF8(hLibro["url_descarga_epub"])) &
        "</bibliomisc>" & Chr(10)
    Endif
  Endif

  ' ==========================================================
  ' BLOQUE 3. AUTORES DEL LIBRO (LOOP libro_autor + autores)
  ' ==========================================================
  ' MAPEO DE rol_libro A ELEMENTOS DOCBOOK 5.2:
  '   autor                → <author>
  '   editor               → <editor>
  '   compilador           → <editor role="compiler">
  '   coordinador          → <editor role="coordinator">
  '   colaborador          → <editor role="collaborator">
  ' LA RESPONSABILIDAD EDITORIAL ES UN EDITOR CON UN ROL, COMO EN biblatex Y
  ' COMO EN LA BIBLIOGRAFÍA (MapearTipoEditorDocBook). ANTES COMPILADORES Y
  ' COORDINADORES ERAN <othercredit>: EL «CÓMO CITAR» DEL HTML NO LOS VEÍA Y
  ' UN LIBRO SIN AUTOR SE CITABA SIN NOMBRE. LOS DEMÁS ROLES SIGUEN COMO
  ' <othercredit> PORQUE NINGUNO OCUPA EL LUGAR DEL AUTOR:
  '   prologuista_externo  → <othercredit class="other" otherclass="prologuista-externo">
  '   traductor            → <othercredit class="translator">
  '   ilustrador           → <othercredit class="graphicdesigner">
  '   director_coleccion   → <othercredit class="other" otherclass="director-coleccion">
  While hAutores.Available

    sRolLibro = "autor"
    If Not IsNull(hAutores["rol_libro"]) Then
      sRolLibro = TrimUTF8(hAutores["rol_libro"])
    Endif

    Select Case sRolLibro
      Case "autor"
        sElementoAutor = "author"
        sAtributosAutor = ""
      Case "editor"
        sElementoAutor = "editor"
        sAtributosAutor = ""
      Case "traductor"
        sElementoAutor = "othercredit"
        sAtributosAutor = " class=" & cQ & "translator" & cQ
      Case "ilustrador"
        sElementoAutor = "othercredit"
        sAtributosAutor = " class=" & cQ & "graphicdesigner" & cQ
      Case "compilador"
        sElementoAutor = "editor"
        sAtributosAutor = " role=" & cQ & "compiler" & cQ
      Case "coordinador"
        sElementoAutor = "editor"
        sAtributosAutor = " role=" & cQ & "coordinator" & cQ
      Case "colaborador"
        sElementoAutor = "editor"
        sAtributosAutor = " role=" & cQ & "collaborator" & cQ
      Case "prologuista_externo"
        sElementoAutor = "othercredit"
        sAtributosAutor = " class=" & cQ & "other" & cQ &
          " otherclass=" & cQ & "prologuista-externo" & cQ
      Case "director_coleccion"
        sElementoAutor = "othercredit"
        sAtributosAutor = " class=" & cQ & "other" & cQ &
          " otherclass=" & cQ & "director-coleccion" & cQ
      Case Else
        sElementoAutor = "author"
        sAtributosAutor = ""
    End Select

    sXML &= "  <" & sElementoAutor & sAtributosAutor & ">" & Chr(10)

    ' NOMBRE (PERSONNAME)
    sXML &= "    <personname>" & Chr(10)
    sXML &= "      <firstname>" &
      EscaparXML(TrimUTF8(hAutores["nombre"])) & "</firstname>" & Chr(10)
    sXML &= "      <surname>" &
      EscaparXML(TrimUTF8(hAutores["apellidos"])) & "</surname>" & Chr(10)
    If Not IsNull(hAutores["sufijo"]) Then
      If Len(TrimUTF8(hAutores["sufijo"])) > 0 Then
        sXML &= "      <lineage>" &
          EscaparXML(TrimUTF8(hAutores["sufijo"])) & "</lineage>" & Chr(10)
      Endif
    Endif
    sXML &= "    </personname>" & Chr(10)

    ' ORCID
    If Not IsNull(hAutores["orcid"]) Then
      If Len(TrimUTF8(hAutores["orcid"])) > 0 Then
        sXML &= "    <uri type=" & cQ & "orcid" & cQ & ">" &
          "https://orcid.org/" & EscaparXML(TrimUTF8(hAutores["orcid"])) &
          "</uri>" & Chr(10)
      Endif
    Endif

    ' AFILIACIÓN CON PRIORIDAD _momento → DATO ACTUAL DEL AUTOR
    sAfil = ""
    sDept = ""
    sCiudadAfil = ""
    sPaisAfil = ""
    sRor = ""

    If Not IsNull(hAutores["afiliacion_momento"]) Then
      If Len(TrimUTF8(hAutores["afiliacion_momento"])) > 0 Then
        sAfil = TrimUTF8(hAutores["afiliacion_momento"])
      Endif
    Endif
    If sAfil = "" And Not IsNull(hAutores["afiliacion_actual"]) Then
      If Len(TrimUTF8(hAutores["afiliacion_actual"])) > 0 Then
        sAfil = TrimUTF8(hAutores["afiliacion_actual"])
      Endif
    Endif

    If Not IsNull(hAutores["departamento_momento"]) Then
      If Len(TrimUTF8(hAutores["departamento_momento"])) > 0 Then
        sDept = TrimUTF8(hAutores["departamento_momento"])
      Endif
    Endif
    If sDept = "" And Not IsNull(hAutores["departamento"]) Then
      If Len(TrimUTF8(hAutores["departamento"])) > 0 Then
        sDept = TrimUTF8(hAutores["departamento"])
      Endif
    Endif

    If Not IsNull(hAutores["ciudad_momento"]) Then
      If Len(TrimUTF8(hAutores["ciudad_momento"])) > 0 Then
        sCiudadAfil = TrimUTF8(hAutores["ciudad_momento"])
      Endif
    Endif
    If sCiudadAfil = "" And Not IsNull(hAutores["ciudad_afiliacion"]) Then
      If Len(TrimUTF8(hAutores["ciudad_afiliacion"])) > 0 Then
        sCiudadAfil = TrimUTF8(hAutores["ciudad_afiliacion"])
      Endif
    Endif

    If Not IsNull(hAutores["pais_momento"]) Then
      If Len(TrimUTF8(hAutores["pais_momento"])) > 0 Then
        sPaisAfil = TrimUTF8(hAutores["pais_momento"])
      Endif
    Endif
    If sPaisAfil = "" And Not IsNull(hAutores["pais_afiliacion"]) Then
      If Len(TrimUTF8(hAutores["pais_afiliacion"])) > 0 Then
        sPaisAfil = TrimUTF8(hAutores["pais_afiliacion"])
      Endif
    Endif

    If Not IsNull(hAutores["ror_afiliacion_momento"]) Then
      If Len(TrimUTF8(hAutores["ror_afiliacion_momento"])) > 0 Then
        sRor = TrimUTF8(hAutores["ror_afiliacion_momento"])
      Endif
    Endif
    If sRor = "" And Not IsNull(hAutores["ror_afiliacion_actual"]) Then
      If Len(TrimUTF8(hAutores["ror_afiliacion_actual"])) > 0 Then
        sRor = TrimUTF8(hAutores["ror_afiliacion_actual"])
      Endif
    Endif

    If sAfil <> "" Or sDept <> "" Or sCiudadAfil <> "" Or sPaisAfil <> "" Or sRor <> "" Then
      sXML &= "    <affiliation>" & Chr(10)
      If sDept <> "" Then
        sXML &= "      <orgdiv>" & EscaparXML(sDept) & "</orgdiv>" & Chr(10)
      Endif
      If sAfil <> "" Then
        sXML &= "      <orgname>" & EscaparXML(sAfil) & "</orgname>" & Chr(10)
      Endif
      If sCiudadAfil <> "" Or sPaisAfil <> "" Then
        sXML &= "      <address>" & Chr(10)
        If sCiudadAfil <> "" Then
          sXML &= "        <city>" & EscaparXML(sCiudadAfil) & "</city>" & Chr(10)
        Endif
        If sPaisAfil <> "" Then
          sXML &= "        <country>" & EscaparXML(sPaisAfil) & "</country>" & Chr(10)
        Endif
        sXML &= "      </address>" & Chr(10)
      Endif
      If sRor <> "" Then
        sXML &= "      <otheraddr role=" & cQ & "ror" & cQ & ">" &
          EscaparXML(sRor) & "</otheraddr>" & Chr(10)
      Endif
      sXML &= "    </affiliation>" & Chr(10)
    Endif

    ' NOTAS DEL AUTOR (PROPIAS DE ESTE AUTOR PARA ESTE LIBRO)
    If Not IsNull(hAutores["notas_autor"]) Then
      If Len(TrimUTF8(hAutores["notas_autor"])) > 0 Then
        sXML &= "    <personblurb><para>" &
          EscaparXML(TrimUTF8(hAutores["notas_autor"])) &
          "</para></personblurb>" & Chr(10)
      Endif
    Endif

    ' ROLES CRediT (SOLO PARA rol_libro='autor' TIENE SENTIDO EN LIBROS)
    sCredit = ""
    If Not IsNull(hAutores["contribuciones_credit"]) Then
      sCredit = TrimUTF8(hAutores["contribuciones_credit"])
    Endif

    If sCredit <> "" And sCredit <> "null" And sCredit <> "[]" Then
      sJsonLimpio = sCredit
      sJsonLimpio = Replace(sJsonLimpio, "[", "")
      sJsonLimpio = Replace(sJsonLimpio, "]", "")
      sJsonLimpio = Replace(sJsonLimpio, cQ, "")
      sJsonLimpio = TrimUTF8(sJsonLimpio)
      If sJsonLimpio <> "" Then
        aRoles = Split(sJsonLimpio, ",")
        For Each sRole In aRoles
          sRole = TrimUTF8(sRole)
          If sRole <> "" Then
            sXML &= "    <bibliomisc role=" & cQ & "credit-role" & cQ & ">" &
              EscaparXML(sRole) & "</bibliomisc>" & Chr(10)
          Endif
        Next
      Endif
    Endif

    sXML &= "  </" & sElementoAutor & ">" & Chr(10)
    hAutores.MoveNext
  Wend

  ' ==========================================================
  ' BLOQUE 4. DATOS EDITORIALES (PUBLISHER)
  ' ==========================================================
  ' UN publisher POR EDITORIAL DEL LIBRO, EN SU ORDEN: EL PRIMERO ES LA
  ' PRINCIPAL (libro_editorial, 2.2.0; claude/crossref-libros.md, F1). LAS
  ' HOJAS QUE LEEN UN SOLO publisher TOMAN EL PRIMERO, Y ESE ES LA PRINCIPAL.
  ' publisher AGRUPA publishername + address. institucion VA COMO orgname
  ' DENTRO DE address (SUBORDINADO A publishername). LOS DATOS SALEN DE LA
  ' TABLA editorial; DEL LIBRO SOLO EL CORREO, QUE SI ESTÁ CARGADO REEMPLAZA
  ' AL DE LA PRINCIPAL (COMO revista.email_editorial EN REVISTAS)
  sEmailLibro = ""
  If Not IsNull(hLibro["email_editorial"]) Then
    If Len(TrimUTF8(hLibro["email_editorial"])) > 0 Then
      sEmailLibro = TrimUTF8(hLibro["email_editorial"])
    Endif
  Endif

  hEditoriales = m_EditorialLibro.Leer(iIdLibro)
  If Not hEditoriales Then
    m_Sonido.sonar("Error")
    Message.Error(m_EditorialLibro.UltimoError())
    Return False
  Endif

  ' UN LIBRO SIN EDITORIAL NO LLEVA publisher: EL CANÓNICO ES VÁLIDO IGUAL, Y
  ' QUIEN LA EXIGE (CROSSREF) FRENA POR SU CUENTA
  While hEditoriales.Available
    sEditorial = TrimUTF8(m_Metadatos.NullToString(hEditoriales["nombre"]))
    sInstitucionEd = TrimUTF8(m_Metadatos.NullToString(hEditoriales["institucion"]))
    sRorEditorial = TrimUTF8(m_Metadatos.NullToString(hEditoriales["ror"]))
    sCiudadPub = TrimUTF8(m_Metadatos.NullToString(hEditoriales["ciudad"]))
    sPaisPub = TrimUTF8(m_Metadatos.NullToString(hEditoriales["pais"]))
    sDireccionEd = TrimUTF8(m_Metadatos.NullToString(hEditoriales["direccion"]))
    sEmailEd = TrimUTF8(m_Metadatos.NullToString(hEditoriales["email"]))
    ' EL REEMPLAZO DEL LIBRO VALE SOLO PARA LA PRINCIPAL
    If hEditoriales["orden"] = 1 And If sEmailLibro <> "" Then sEmailEd = sEmailLibro

    sXML &= "  <publisher>" & Chr(10)
    sXML &= "    <publishername>" & EscaparXML(sEditorial) &
      "</publishername>" & Chr(10)
    If sInstitucionEd <> "" Or sCiudadPub <> "" Or sPaisPub <> "" Or
        sDireccionEd <> "" Or sEmailEd <> "" Or sRorEditorial <> "" Then
      sXML &= "    <address>" & Chr(10)
      If sInstitucionEd <> "" Then
        sXML &= "      <orgname>" & EscaparXML(sInstitucionEd) &
          "</orgname>" & Chr(10)
      Endif
      If sDireccionEd <> "" Then
        sXML &= "      <street>" & EscaparXML(sDireccionEd) &
          "</street>" & Chr(10)
      Endif
      If sCiudadPub <> "" Then
        sXML &= "      <city>" & EscaparXML(sCiudadPub) & "</city>" & Chr(10)
      Endif
      If sPaisPub <> "" Then
        sXML &= "      <country>" & EscaparXML(sPaisPub) & "</country>" & Chr(10)
      Endif
      If sEmailEd <> "" Then
        sXML &= "      <email>" & EscaparXML(sEmailEd) & "</email>" & Chr(10)
      Endif
      ' ROR EDITORIAL COMO otheraddr role="ror" (MISMA CONVENCIÓN QUE AUTORES)
      If sRorEditorial <> "" Then
        sXML &= "      <otheraddr role=" & cQ & "ror" & cQ & ">" &
          EscaparXML(sRorEditorial) & "</otheraddr>" & Chr(10)
      Endif
      sXML &= "    </address>" & Chr(10)
    Endif
    sXML &= "  </publisher>" & Chr(10)
    hEditoriales.MoveNext
  Wend

  ' ==========================================================
  ' BLOQUE 5. COLECCIÓN Y SERIE
  ' ==========================================================
  ' DOS <biblioset> SEPARADOS CON relation DISTINTIVO:
  '   relation="series"    → COLECCIÓN
  '   relation="subseries" → SERIE (SUBDIVISIÓN DE LA COLECCIÓN)
  ' USAMOS relation="series" PARA COLECCIÓN PORQUE EN DOCBOOK LA
  ' NOMENCLATURA ESTÁNDAR ES "series" (NO "collection"), Y SUBSERIES
  ' ES LA NOMENCLATURA ESTÁNDAR PARA SUBDIVISIONES DENTRO DE SERIES.

  ' COLECCIÓN
  sColNombre = ""
  sColAbrev = ""
  sColIssn = ""
  If Not IsNull(hLibro["coleccion_nombre"]) Then
    If Len(TrimUTF8(hLibro["coleccion_nombre"])) > 0 Then
      sColNombre = TrimUTF8(hLibro["coleccion_nombre"])
    Endif
  Endif
  If Not IsNull(hLibro["coleccion_abrev"]) Then
    If Len(TrimUTF8(hLibro["coleccion_abrev"])) > 0 Then
      sColAbrev = TrimUTF8(hLibro["coleccion_abrev"])
    Endif
  Endif
  If Not IsNull(hLibro["coleccion_issn"]) Then
    If Len(TrimUTF8(hLibro["coleccion_issn"])) > 0 Then
      sColIssn = TrimUTF8(hLibro["coleccion_issn"])
    Endif
  Endif

  If sColNombre <> "" Then
    sXML &= "  <biblioset relation=" & cQ & "series" & cQ & ">" & Chr(10)
    sXML &= "    <title>" & EscaparXML(sColNombre) & "</title>" & Chr(10)
    If sColAbrev <> "" Then
      sXML &= "    <titleabbrev>" & EscaparXML(sColAbrev) &
        "</titleabbrev>" & Chr(10)
    Endif
    If sColIssn <> "" Then
      sXML &= "    <issn>" & EscaparXML(sColIssn) & "</issn>" & Chr(10)
    Endif
    If Not IsNull(hLibro["numero_en_coleccion"]) Then
      If Len(TrimUTF8(hLibro["numero_en_coleccion"])) > 0 Then
        sXML &= "    <volumenum>" &
          EscaparXML(TrimUTF8(hLibro["numero_en_coleccion"])) &
          "</volumenum>" & Chr(10)
      Endif
    Endif
    sXML &= "  </biblioset>" & Chr(10)
  Endif

  ' SERIE (SUBDIVISIÓN DE LA COLECCIÓN)
  sSerieNombre = ""
  sSerieAbrev = ""
  sSerieIssn = ""
  If Not IsNull(hLibro["serie_nombre"]) Then
    If Len(TrimUTF8(hLibro["serie_nombre"])) > 0 Then
      sSerieNombre = TrimUTF8(hLibro["serie_nombre"])
    Endif
  Endif
  If Not IsNull(hLibro["serie_abrev"]) Then
    If Len(TrimUTF8(hLibro["serie_abrev"])) > 0 Then
      sSerieAbrev = TrimUTF8(hLibro["serie_abrev"])
    Endif
  Endif
  If Not IsNull(hLibro["serie_issn"]) Then
    If Len(TrimUTF8(hLibro["serie_issn"])) > 0 Then
      sSerieIssn = TrimUTF8(hLibro["serie_issn"])
    Endif
  Endif

  If sSerieNombre <> "" Then
    sXML &= "  <biblioset relation=" & cQ & "subseries" & cQ & ">" & Chr(10)
    sXML &= "    <title>" & EscaparXML(sSerieNombre) & "</title>" & Chr(10)
    If sSerieAbrev <> "" Then
      sXML &= "    <titleabbrev>" & EscaparXML(sSerieAbrev) &
        "</titleabbrev>" & Chr(10)
    Endif
    If sSerieIssn <> "" Then
      sXML &= "    <issn>" & EscaparXML(sSerieIssn) & "</issn>" & Chr(10)
    Endif
    If Not IsNull(hLibro["numero_en_serie"]) Then
      If Len(TrimUTF8(hLibro["numero_en_serie"])) > 0 Then
        sXML &= "    <volumenum>" &
          EscaparXML(TrimUTF8(hLibro["numero_en_serie"])) &
          "</volumenum>" & Chr(10)
      Endif
    Endif
    sXML &= "  </biblioset>" & Chr(10)
  Endif

  ' ==========================================================
  ' BLOQUE 6. EDICIÓN
  ' ==========================================================
  If Not IsNull(hLibro["edicion"]) Then
    If Len(TrimUTF8(hLibro["edicion"])) > 0 Then
      sXML &= "  <edition>" & EscaparXML(TrimUTF8(hLibro["edicion"])) &
        "</edition>" & Chr(10)
    Endif
  Endif

  If Not IsNull(hLibro["numero_edicion"]) Then
    If CInt(hLibro["numero_edicion"]) > 0 Then
      sXML &= "  <edition role=" & cQ & "numeric" & cQ & ">" &
        CStr(hLibro["numero_edicion"]) & "</edition>" & Chr(10)
    Endif
  Endif

  If Not IsNull(hLibro["numero_paginas"]) Then
    If CInt(hLibro["numero_paginas"]) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "numero-paginas" & cQ & ">" &
        CStr(hLibro["numero_paginas"]) & "</bibliomisc>" & Chr(10)
    Endif
  Endif

  ' ==========================================================
  ' BLOQUE 7. FECHAS DE PUBLICACIÓN
  ' ==========================================================
  ' ano_publicacion Y mes_publicacion SON REDUNDANTES CON fecha_publicacion_completa,
  ' PERO EL EDITOR PUEDE CARGAR SOLO EL AÑO SIN CONOCER LA FECHA COMPLETA.
  ' EMITIMOS EN ORDEN DE PRECISIÓN.
  If Not IsNull(hLibro["fecha_pub_iso"]) Then
    If Len(TrimUTF8(hLibro["fecha_pub_iso"])) > 0 Then
      sXML &= "  <pubdate role=" & cQ & "completa" & cQ & ">" &
        EscaparXML(TrimUTF8(hLibro["fecha_pub_iso"])) & "</pubdate>" & Chr(10)
    Endif
  Endif

  If Not IsNull(hLibro["ano_publicacion"]) Then
    If CInt(hLibro["ano_publicacion"]) > 0 Then
      sXML &= "  <pubdate>" & CStr(hLibro["ano_publicacion"]) &
        "</pubdate>" & Chr(10)
    Endif
  Endif

  If Not IsNull(hLibro["mes_publicacion"]) Then
    If Len(TrimUTF8(hLibro["mes_publicacion"])) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "mes-publicacion" & cQ & ">" &
        EscaparXML(TrimUTF8(hLibro["mes_publicacion"])) &
        "</bibliomisc>" & Chr(10)
    Endif
  Endif

  ' ==========================================================
  ' BLOQUE 8. IDIOMAS
  ' ==========================================================
  ' idioma_principal SE EMITE COMO ATRIBUTO xml:lang DEL <book> RAÍZ
  ' (POR EL XSLT DE ENSAMBLADO, NO ACÁ). ACÁ EMITIMOS EL LISTADO
  ' EXTENDIDO PARA REFERENCIA (LIBROS BILINGÜES, ETC.).
  If Not IsNull(hLibro["idiomas_publicacion"]) Then
    If Len(TrimUTF8(hLibro["idiomas_publicacion"])) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "idiomas-publicacion" & cQ & ">" &
        EscaparXML(TrimUTF8(hLibro["idiomas_publicacion"])) &
        "</bibliomisc>" & Chr(10)
    Endif
  Endif

  ' ==========================================================
  ' BLOQUE 9. TIPO Y ESTADO DE PUBLICACIÓN
  ' ==========================================================
  ' tipo_libro NO ES UN ATRIBUTO ESTÁNDAR DE <book> EN DOCBOOK 5.2,
  ' ENTONCES VA COMO bibliomisc role="tipo-libro"
  If Not IsNull(hLibro["tipo_libro"]) Then
    If Len(TrimUTF8(hLibro["tipo_libro"])) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "tipo-libro" & cQ & ">" &
        EscaparXML(TrimUTF8(hLibro["tipo_libro"])) &
        "</bibliomisc>" & Chr(10)
    Endif
  Endif

  If Not IsNull(hLibro["estado_publicacion"]) Then
    If Len(TrimUTF8(hLibro["estado_publicacion"])) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "estado-publicacion" & cQ & ">" &
        EscaparXML(TrimUTF8(hLibro["estado_publicacion"])) &
        "</bibliomisc>" & Chr(10)
    Endif
  Endif

  ' ==========================================================
  ' BLOQUE 10. ÁREA TEMÁTICA, PALABRAS CLAVE, CLASIFICACIONES
  ' ==========================================================
  ' ÁREA DE CONOCIMIENTO Y DISCIPLINA COMO subjectset
  If Not IsNull(hLibro["area_conocimiento"]) Then
    If Len(TrimUTF8(hLibro["area_conocimiento"])) > 0 Then
      sXML &= "  <subjectset scheme=" & cQ & "area-conocimiento" & cQ & ">" & Chr(10)
      sXML &= "    <subject><subjectterm>" &
        EscaparXML(TrimUTF8(hLibro["area_conocimiento"])) &
        "</subjectterm></subject>" & Chr(10)
      sXML &= "  </subjectset>" & Chr(10)
    Endif
  Endif

  If Not IsNull(hLibro["disciplina"]) Then
    If Len(TrimUTF8(hLibro["disciplina"])) > 0 Then
      sXML &= "  <subjectset scheme=" & cQ & "disciplina" & cQ & ">" & Chr(10)
      sXML &= "    <subject><subjectterm>" &
        EscaparXML(TrimUTF8(hLibro["disciplina"])) &
        "</subjectterm></subject>" & Chr(10)
      sXML &= "  </subjectset>" & Chr(10)
    Endif
  Endif

  If Not IsNull(hLibro["subdisciplina"]) Then
    If Len(TrimUTF8(hLibro["subdisciplina"])) > 0 Then
      sXML &= "  <subjectset scheme=" & cQ & "subdisciplina" & cQ & ">" & Chr(10)
      aTerminos = Split(TrimUTF8(hLibro["subdisciplina"]), ",")
      For Each sTermino In aTerminos
        sTermino = TrimUTF8(sTermino)
        If sTermino <> "" Then
          sXML &= "    <subject><subjectterm>" & EscaparXML(sTermino) &
            "</subjectterm></subject>" & Chr(10)
        Endif
      Next
      sXML &= "  </subjectset>" & Chr(10)
    Endif
  Endif

  ' CLASIFICACIÓN UNESCO
  If Not IsNull(hLibro["clasificacion_unesco"]) Then
    If Len(TrimUTF8(hLibro["clasificacion_unesco"])) > 0 Then
      sXML &= "  <subjectset scheme=" & cQ & "UNESCO" & cQ & ">" & Chr(10)
      sXML &= "    <subject><subjectterm>" &
        EscaparXML(TrimUTF8(hLibro["clasificacion_unesco"])) &
        "</subjectterm></subject>" & Chr(10)
      sXML &= "  </subjectset>" & Chr(10)
    Endif
  Endif

  ' CLASIFICACIÓN OECD
  If Not IsNull(hLibro["clasificacion_oecd"]) Then
    If Len(TrimUTF8(hLibro["clasificacion_oecd"])) > 0 Then
      sXML &= "  <subjectset scheme=" & cQ & "OECD" & cQ & ">" & Chr(10)
      sXML &= "    <subject><subjectterm>" &
        EscaparXML(TrimUTF8(hLibro["clasificacion_oecd"])) &
        "</subjectterm></subject>" & Chr(10)
      sXML &= "  </subjectset>" & Chr(10)
    Endif
  Endif

  ' PALABRAS CLAVE DEL LIBRO — CSV
  If Not IsNull(hLibro["palabras_clave_libro"]) Then
    If Len(TrimUTF8(hLibro["palabras_clave_libro"])) > 0 Then
      sXML &= "  <keywordset>" & Chr(10)
      aTerminos = Split(TrimUTF8(hLibro["palabras_clave_libro"]), ",")
      For Each sTermino In aTerminos
        sTermino = TrimUTF8(sTermino)
        If sTermino <> "" Then
          sXML &= "    <keyword>" & EscaparXML(sTermino) & "</keyword>" & Chr(10)
        Endif
      Next
      sXML &= "  </keywordset>" & Chr(10)
    Endif
  Endif

  ' ==========================================================
  ' BLOQUE 11. RESUMEN, DESCRIPCIÓN, OBJETIVOS
  ' ==========================================================
  ' RESUMEN PRINCIPAL (EN idioma_principal)
  If Not IsNull(hLibro["resumen_libro"]) Then
    If Len(TrimUTF8(hLibro["resumen_libro"])) > 0 Then
      sIdiomaPrinc = "es"
      If Not IsNull(hLibro["idioma_principal"]) Then
        If Len(TrimUTF8(hLibro["idioma_principal"])) > 0 Then
          sIdiomaPrinc = TrimUTF8(hLibro["idioma_principal"])
        Endif
      Endif
      sXML &= "  <abstract xml:lang=" & cQ & EscaparXML(sIdiomaPrinc) & cQ & ">" & Chr(10)
      sXML &= "    <para>" & EscaparXML(TrimUTF8(hLibro["resumen_libro"])) &
        "</para>" & Chr(10)
      sXML &= "  </abstract>" & Chr(10)
    Endif
  Endif

  ' RESUMEN TRADUCIDO
  If Not IsNull(hLibro["resumen_traducido"]) Then
    If Len(TrimUTF8(hLibro["resumen_traducido"])) > 0 Then
      sIdiomaTrad = ""
      If Not IsNull(hLibro["idioma_resumen_traducido"]) Then
        If Len(TrimUTF8(hLibro["idioma_resumen_traducido"])) > 0 Then
          sIdiomaTrad = TrimUTF8(hLibro["idioma_resumen_traducido"])
        Endif
      Endif
      sXML &= "  <abstract role=" & cQ & "traducido" & cQ
      If sIdiomaTrad <> "" Then
        sXML &= " xml:lang=" & cQ & EscaparXML(sIdiomaTrad) & cQ
      Endif
      sXML &= ">" & Chr(10)
      sXML &= "    <para>" & EscaparXML(TrimUTF8(hLibro["resumen_traducido"])) &
        "</para>" & Chr(10)
      sXML &= "  </abstract>" & Chr(10)
    Endif
  Endif

  ' DESCRIPCIÓN
  If Not IsNull(hLibro["descripcion_libro"]) Then
    If Len(TrimUTF8(hLibro["descripcion_libro"])) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "descripcion" & cQ & ">" &
        EscaparXML(TrimUTF8(hLibro["descripcion_libro"])) &
        "</bibliomisc>" & Chr(10)
    Endif
  Endif

  ' OBJETIVOS Y ALCANCE
  If Not IsNull(hLibro["objetivos_alcance"]) Then
    If Len(TrimUTF8(hLibro["objetivos_alcance"])) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "objetivos-alcance" & cQ & ">" &
        EscaparXML(TrimUTF8(hLibro["objetivos_alcance"])) &
        "</bibliomisc>" & Chr(10)
    Endif
  Endif

  ' ==========================================================
  ' BLOQUE 12. ACCESO, LICENCIA, EMBARGO
  ' ==========================================================
  If Not IsNull(hLibro["tipo_acceso"]) Then
    If Len(TrimUTF8(hLibro["tipo_acceso"])) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "tipo-acceso" & cQ & ">" &
        EscaparXML(TrimUTF8(hLibro["tipo_acceso"])) &
        "</bibliomisc>" & Chr(10)
    Endif
  Endif

  ' LICENCIA COMO <legalnotice role="licencia">
  If Not IsNull(hLibro["licencia_defecto"]) Then
    If Len(TrimUTF8(hLibro["licencia_defecto"])) > 0 Then
      sXML &= "  <legalnotice role=" & cQ & "licencia" & cQ & ">" & Chr(10)
      sXML &= "    <para>" & EscaparXML(TrimUTF8(hLibro["licencia_defecto"])) &
        "</para>" & Chr(10)
      If Not IsNull(hLibro["url_licencia"]) Then
        If Len(TrimUTF8(hLibro["url_licencia"])) > 0 Then
          sUrlLic = TrimUTF8(hLibro["url_licencia"])
          sXML &= "    <para><link xlink:href=" & cQ & EscaparXML(sUrlLic) & cQ &
            ">" & EscaparXML(sUrlLic) & "</link></para>" & Chr(10)
        Endif
      Endif
      sXML &= "  </legalnotice>" & Chr(10)
    Endif
  Endif

  ' POLÍTICA DE ACCESO ABIERTO
  If Not IsNull(hLibro["politica_acceso_abierto"]) Then
    If Len(TrimUTF8(hLibro["politica_acceso_abierto"])) > 0 Then
      sXML &= "  <legalnotice role=" & cQ & "acceso-abierto" & cQ & ">" & Chr(10)
      sXML &= "    <para>" & EscaparXML(TrimUTF8(hLibro["politica_acceso_abierto"])) &
        "</para>" & Chr(10)
      sXML &= "  </legalnotice>" & Chr(10)
    Endif
  Endif

  ' PERÍODO DE EMBARGO
  If Not IsNull(hLibro["periodo_embargo"]) Then
    If CInt(hLibro["periodo_embargo"]) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "periodo-embargo" & cQ & ">" &
        CStr(hLibro["periodo_embargo"]) & "</bibliomisc>" & Chr(10)
    Endif
  Endif

  ' ==========================================================
  ' BLOQUE 13. URLs
  ' ==========================================================
  If Not IsNull(hLibro["url_libro"]) Then
    If Len(TrimUTF8(hLibro["url_libro"])) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "url-libro" & cQ & ">" &
        EscaparXML(TrimUTF8(hLibro["url_libro"])) &
        "</bibliomisc>" & Chr(10)
    Endif
  Endif

  If Not IsNull(hLibro["url_oai_pmh"]) Then
    If Len(TrimUTF8(hLibro["url_oai_pmh"])) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "url-oai-pmh" & cQ & ">" &
        EscaparXML(TrimUTF8(hLibro["url_oai_pmh"])) &
        "</bibliomisc>" & Chr(10)
    Endif
  Endif

  If Not IsNull(hLibro["url_logo"]) Then
    If Len(TrimUTF8(hLibro["url_logo"])) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "url-logo" & cQ & ">" &
        EscaparXML(TrimUTF8(hLibro["url_logo"])) &
        "</bibliomisc>" & Chr(10)
    Endif
  Endif

  ' ==========================================================
  ' BLOQUE 14. REPOSITORIOS DE PRODUCCIÓN Y PRESERVACIÓN
  ' ==========================================================
  If Not IsNull(hLibro["repositorio_produccion_url"]) Then
    If Len(TrimUTF8(hLibro["repositorio_produccion_url"])) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "repo-produccion-url" & cQ & ">" &
        EscaparXML(TrimUTF8(hLibro["repositorio_produccion_url"])) &
        "</bibliomisc>" & Chr(10)
    Endif
  Endif

  If Not IsNull(hLibro["repositorio_produccion_plataforma"]) Then
    If Len(TrimUTF8(hLibro["repositorio_produccion_plataforma"])) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "repo-produccion-plataforma" & cQ & ">" &
        EscaparXML(TrimUTF8(hLibro["repositorio_produccion_plataforma"])) &
        "</bibliomisc>" & Chr(10)
    Endif
  Endif

  If Not IsNull(hLibro["repositorio_produccion_tipo"]) Then
    If Len(TrimUTF8(hLibro["repositorio_produccion_tipo"])) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "repo-produccion-tipo" & cQ & ">" &
        EscaparXML(TrimUTF8(hLibro["repositorio_produccion_tipo"])) &
        "</bibliomisc>" & Chr(10)
    Endif
  Endif

  ' TINYINT — RECORDAR RC-GM-01: SE COMPARA CON True/False, NO CON 1/0
  If hLibro["repositorio_produccion_privado"] = True Then
    sXML &= "  <bibliomisc role=" & cQ & "repo-produccion-privado" & cQ &
      ">yes</bibliomisc>" & Chr(10)
  Endif

  If Not IsNull(hLibro["sistema_gestion_contenidos"]) Then
    If Len(TrimUTF8(hLibro["sistema_gestion_contenidos"])) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "cms" & cQ & ">" &
        EscaparXML(TrimUTF8(hLibro["sistema_gestion_contenidos"])) &
        "</bibliomisc>" & Chr(10)
    Endif
  Endif

  If Not IsNull(hLibro["repositorio_preservacion_url"]) Then
    If Len(TrimUTF8(hLibro["repositorio_preservacion_url"])) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "repo-preservacion-url" & cQ & ">" &
        EscaparXML(TrimUTF8(hLibro["repositorio_preservacion_url"])) &
        "</bibliomisc>" & Chr(10)
    Endif
  Endif

  If Not IsNull(hLibro["repositorio_preservacion_plataforma"]) Then
    If Len(TrimUTF8(hLibro["repositorio_preservacion_plataforma"])) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "repo-preservacion-plataforma" & cQ & ">" &
        EscaparXML(TrimUTF8(hLibro["repositorio_preservacion_plataforma"])) &
        "</bibliomisc>" & Chr(10)
    Endif
  Endif

  If Not IsNull(hLibro["indexado_en"]) Then
    If Len(TrimUTF8(hLibro["indexado_en"])) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "indexado-en" & cQ & ">" &
        EscaparXML(TrimUTF8(hLibro["indexado_en"])) &
        "</bibliomisc>" & Chr(10)
    Endif
  Endif

  ' ==========================================================
  ' BLOQUE 15. ESTILO DE CITA
  ' EL IDENTIFICADOR DE libros_md.estilo_cita (apa, verona-modern…), CON EL
  ' role estilo-cita, COMO LA COLUMNA. EL MISMO DATO Y EL MISMO role QUE EL
  ' BLOQUE 2c DE CADA PIEZA
  ' ==========================================================
  If Not IsNull(hLibro["estilo_cita"]) Then
    If Len(TrimUTF8(hLibro["estilo_cita"])) > 0 Then
      sXML &= "  <bibliomisc role=" & cQ & "estilo-cita" & cQ & ">" &
        EscaparXML(TrimUTF8(hLibro["estilo_cita"])) &
        "</bibliomisc>" & Chr(10)
    Endif
  Endif

  ' ==========================================================
  ' BLOQUE 16. PORTADA (mediaobject role="tapa")
  ' ==========================================================
  ' LA RUTA ES RELATIVA AL PROYECTO Y LA IMAGEN VIVE EN /media.
  ' EL CANÓNICO VIVE EN /jats, ENTONCES LA REFERENCIA DESDE EL
  ' CANÓNICO ES ../media/{imagen_tapa}.
  ' LAS DECLARACIONES sImagenTapa Y sTituloTapa ESTÁN EN EL
  ' APARTADO 0 PARA EVITAR EL ANTIPATRÓN DE Dim INLINE EN
  ' CONDICIONALES ANIDADOS (RC-GM-17).
  If Not IsNull(hLibro["imagen_tapa"]) Then
    If Len(TrimUTF8(hLibro["imagen_tapa"])) > 0 Then
      sImagenTapa = TrimUTF8(hLibro["imagen_tapa"])
      sXML &= "  <mediaobject role=" & cQ & "tapa" & cQ & ">" & Chr(10)
      sXML &= "    <imageobject>" & Chr(10)
      sXML &= "      <imagedata fileref=" & cQ & "../media/" &
        EscaparXML(sImagenTapa) & cQ & "/>" & Chr(10)
      sXML &= "    </imageobject>" & Chr(10)
      sXML &= "    <textobject>" & Chr(10)
      sTituloTapa = "Libro"
      If Not IsNull(hLibro["titulo_libro"]) Then
        If Len(TrimUTF8(hLibro["titulo_libro"])) > 0 Then
          ' TEXTO ALTERNATIVO DE LA TAPA: PLANO (SC-28)
          sTituloTapa = m_CorteTitulo.Plano(hLibro["titulo_libro"])
        Endif
      Endif
      sXML &= "      <phrase>Cubierta de " & EscaparXML(sTituloTapa) &
        "</phrase>" & Chr(10)
      sXML &= "    </textobject>" & Chr(10)
      sXML &= "  </mediaobject>" & Chr(10)
    Endif
  Endif
  ' ==========================================================
  ' CIERRE Y GRABADO
  ' ==========================================================
  sXML &= "</info>" & Chr(10)

  Try File.Save(sFilePath, sXML)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al guardar info-libro xml en " & sFilePath & ":" & Chr(10) &
      Error.Text)
    Return False
  Endif

  Return Exist(sFilePath)

Catch
  m_Sonido.sonar("Error")
  Message.Error("Error inesperado en GenerarInfoLibroXML:" & Chr(10) &
    Error.Text & Chr(10) & "Donde: " & Error.Where)
  Return False

End Function

' ==========================================================
' FUNCIÓN PÚBLICA: GenerarManifiestoLibro
' ==========================================================
' PROPÓSITO:
'   Genera el archivo tmp/manifiesto-libro-{nombre}.xml, que actúa
'   como fuente principal para el XSLT de ensamblado del libro.
'   Contiene:
'     - Metadata del libro (id_libro, id_proyecto, nombre archivo madre,
'       lugar_bibliografia)
'     - Ruta al info-libro-*.xml correspondiente
'     - Lista de capítulos con path, nombre_archivo, id_capitulo,
'       tipo_capitulo — ordenados por prefijo fm/a/bm y dentro
'       de cada prefijo por nombre_archivo alfabético
'
' MOTIVACIÓN DEL DISEÑO:
'   La lista ordenada permite al XSLT usar xsl:sort para verificación
'   cruzada (RC-XJ-04): si el manifiesto viene bien ordenado, el sort
'   no cambia nada; si viene desordenado por cualquier razón, el sort
'   lo endereza silenciosamente. Robusto por diseño.
'
' SALIDA: tmp/manifiesto-libro-{nombre_base_del_l_md}.xml
'   ej.: proyecto con l-libronombre.md → tmp/manifiesto-libro-libronombre.xml
' ==========================================================

' ============================================
' Función   : GenerarManifiestoLibro
' Propósito : Genera el archivo manifiesto XML del libro con la lista
'             de capítulos en orden fm/a/bm + alfabético, y metadata
'             del libro necesaria para el XSLT de ensamblado.
' Parámetros: iIdLibro As Integer — id_libro de la BD
' Retorna   : Boolean — True si el archivo fue generado exitosamente
' ============================================
Public Function GenerarManifiestoLibro(iIdLibro As Integer) As Boolean

  ' --- 0. DECLARACIÓN DE VARIABLES ---
  Dim cQ As String = Chr(34)

  Dim hLibro As Result
  Dim hCapitulos As Result
  Dim sXML As String
  Dim sDirTmp As String
  Dim sFilePath As String
  Dim sNombreArchivoMadre As String
  Dim sNombreBase As String
  Dim sPathCanonico As String
  Dim sPathInfoLibro As String
  Dim sTipoCapitulo As String
  Dim sIdiomaPrincipal As String
  Dim sLugarBiblio As String

  ' --- 1. PREPARAR DIRECTORIO TEMPORAL ---
  sDirTmp = m_InicioCierre.RutaProyectoEnCurso &/ "tmp"

  ' --- 2. RESOLVER NOMBRES ---
  ' EL ARCHIVO MADRE DEL PROYECTO ES l-{basename}.md
  ' EL MANIFIESTO TOMA ESE {basename}:
  '   l-libronombre.md → tmp/manifiesto-libro-libronombre.xml
  sNombreArchivoMadre = File.BaseName(m_InicioCierre.NombreProyectoEnCurso)
  If Left(sNombreArchivoMadre, 2) = "l-" Then
    sNombreBase = Mid(sNombreArchivoMadre, 3)
  Else
    sNombreBase = sNombreArchivoMadre
  Endif
  sFilePath = sDirTmp & "/manifiesto-libro-" & sNombreBase & ".xml"

  ' PATH DEL INFO-LIBRO CORRESPONDIENTE (RELATIVO AL PROYECTO)
  sPathInfoLibro = "tmp/info-libro-" & sNombreBase & ".xml"

  ' --- 3. CONSULTAR DATOS DEL LIBRO ---
  ' NECESITAMOS lugar_bibliografia, idioma_principal Y id_proyecto
  ' PARA POBLAR EL <libro> DEL MANIFIESTO.
  Try hLibro = m_ConexionBD.mConn.Exec(
    "SELECT id_libro, id_proyecto, lugar_bibliografia, idioma_principal " &
    "FROM libros_md WHERE id_libro = &1 LIMIT 1", iIdLibro)

  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al consultar el libro:" & Chr(10) & Error.Text)
    Return False
  Endif

  If Not hLibro.Available Then
    m_Sonido.sonar("Error")
    Message.Error("No se encontraron datos para el libro id=" & CStr(iIdLibro))
    Return False
  Endif

  ' EXTRAER LOS DOS CAMPOS QUE VAN COMO ATRIBUTO EN EL MANIFIESTO
  sIdiomaPrincipal = "es"
  If Not IsNull(hLibro["idioma_principal"]) Then
    If Len(TrimUTF8(hLibro["idioma_principal"])) > 0 Then
      sIdiomaPrincipal = TrimUTF8(hLibro["idioma_principal"])
    Endif
  Endif

  sLugarBiblio = "por_capitulo"
  If Not IsNull(hLibro["lugar_bibliografia"]) Then
    If Len(TrimUTF8(hLibro["lugar_bibliografia"])) > 0 Then
      sLugarBiblio = TrimUTF8(hLibro["lugar_bibliografia"])
    Endif
  Endif

  ' --- 4. CONSULTAR CAPÍTULOS DEL LIBRO EN ORDEN CANÓNICO ---
  ' ORDEN EDITORIAL fm-* < a-* < bm-*, Y DENTRO DE CADA GRUPO POR
  ' nombre_archivo. EL CRITERIO VIVE EN UN SOLO LUGAR (m_OrdenPiezas).
  ' nombre_archivo IS NOT NULL: EL ABM PERMITE GUARDAR UNA PIEZA SIN NOMBRE, Y
  ' SIN ESTA GUARDA EL MANIFIESTO DECLARARÍA UN «jats/c-.xml»
  Try hCapitulos = m_ConexionBD.mConn.Exec(
    "SELECT id_capitulo, nombre_archivo, tipo_capitulo " &
    "FROM capitulos WHERE id_libro = &1 " &
    "AND nombre_archivo IS NOT NULL " &
    "ORDER BY " & m_OrdenPiezas.ClausulaOrden("nombre_archivo"), iIdLibro)

  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al consultar capítulos del libro:" & Chr(10) & Error.Text)
    Return False
  Endif

  If Not hCapitulos.Available Then
    m_Sonido.sonar("Warning")
    Message.Warning("El libro id=" & CStr(iIdLibro) &
      " no tiene capítulos registrados en la base de datos.")
    Return False
  Endif

  ' --- 5. CONSTRUIR EL XML DEL MANIFIESTO ---
  sXML = "<?xml version=" & cQ & "1.0" & cQ & " encoding=" & cQ & "UTF-8" & cQ & "?>" & Chr(10)
  sXML &= "<manifiesto-libro>" & Chr(10)

  ' BLOQUE <libro>: METADATA GLOBAL DEL LIBRO
  sXML &= "  <libro" & Chr(10)
  sXML &= "    id_libro=" & cQ & CStr(hLibro["id_libro"]) & cQ & Chr(10)
  sXML &= "    id_proyecto=" & cQ & CStr(hLibro["id_proyecto"]) & cQ & Chr(10)
  sXML &= "    nombre_archivo_madre=" & cQ & EscaparXML(sNombreBase) & cQ & Chr(10)
  sXML &= "    idioma_principal=" & cQ & EscaparXML(sIdiomaPrincipal) & cQ & Chr(10)
  sXML &= "    lugar_bibliografia=" & cQ & EscaparXML(sLugarBiblio) & cQ & Chr(10)
  sXML &= "    info_libro=" & cQ & EscaparXML(sPathInfoLibro) & cQ & "/>" & Chr(10)

  ' BLOQUE <capitulos>: LISTA ORDENADA DE CAPÍTULOS DEL LIBRO
  sXML &= "  <capitulos>" & Chr(10)

  While hCapitulos.Available
    ' EL tipo_capitulo SE RESUELVE PRIMERO: DECIDE SI LA PIEZA ENTRA.
    ' VA ADEMÁS COMO ATRIBUTO PARA QUE EL XSLT DEL ENSAMBLADOR PUEDA DETECTAR
    ' CASOS ESPECIALES (BIBLIOGRAFÍA CONSOLIDADA, ETC.)
    sTipoCapitulo = "capitulo"
    If Not IsNull(hCapitulos["tipo_capitulo"]) Then
      If Len(TrimUTF8(hCapitulos["tipo_capitulo"])) > 0 Then
        sTipoCapitulo = TrimUTF8(hCapitulos["tipo_capitulo"])
      Endif
    Endif

    ' LAS PIEZAS SIN CUERPO NO ENTRAN AL CANÓNICO: NO TIENEN .md NI CANÓNICO
    ' PROPIO, Y CADA SALIDA LAS RESUELVE A SU MODO. LA DECISIÓN ES DE LA MATRIZ
    ' EDITORIAL, NO DE UNA LISTA ESCRITA ACÁ. DECLARAR UNA HACÍA ABORTAR EL
    ' ENSAMBLADO PIDIENDO UN CANÓNICO QUE NUNCA VA A EXISTIR, Y EL ABORTO
    ' DEJABA EL CANÓNICO DEL LIBRO TRUNCADO.
    ' MoveNext ANTES DE Continue: SIN ÉL EL BUCLE NO AVANZA Y NO TERMINA NUNCA
    If Not m_PiezasLibro.TieneCuerpo(sTipoCapitulo) Then
      hCapitulos.MoveNext
      Continue
    Endif

    ' CONSTRUIR EL PATH DEL CANÓNICO DEL CAPÍTULO (RELATIVO AL PROYECTO)
    ' LA CONVENCIÓN ES jats/c-{nombre_archivo}.xml
    sPathCanonico = "jats/c-" & TrimUTF8(hCapitulos["nombre_archivo"]) & ".xml"

    sXML &= "    <capitulo" & Chr(10)
    sXML &= "      path=" & cQ & EscaparXML(sPathCanonico) & cQ & Chr(10)
    sXML &= "      nombre_archivo=" & cQ &
      EscaparXML(TrimUTF8(hCapitulos["nombre_archivo"])) & cQ & Chr(10)
    sXML &= "      id_capitulo=" & cQ & CStr(hCapitulos["id_capitulo"]) & cQ & Chr(10)
    sXML &= "      tipo_capitulo=" & cQ & EscaparXML(sTipoCapitulo) & cQ & "/>" & Chr(10)

    hCapitulos.MoveNext
  Wend

  sXML &= "  </capitulos>" & Chr(10)
  sXML &= "</manifiesto-libro>" & Chr(10)

  ' --- 6. GRABAR EL ARCHIVO ---
  Try File.Save(sFilePath, sXML)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al guardar manifiesto en " & sFilePath & ":" & Chr(10) &
      Error.Text)
    Return False
  Endif

  Return Exist(sFilePath)

Catch
  m_Sonido.sonar("Error")
  Message.Error("Error inesperado en GenerarManifiestoLibro:" & Chr(10) &
    Error.Text & Chr(10) & "Donde: " & Error.Where)
  Return False

End Function

' ==========================================================
' FUNCIÓN PRIVADA: GenerarBiblioentryDesdeBib
' ==========================================================
' Función   : GenerarBiblioentryDesdeBib
' Propósito : GENERA UN <biblioentry> DE DOCBOOK 5.2 COMPLETO A PARTIR
'             DE UNA ENTRADA BIBLATEX. ANÁLOGA A GenerarElementCitationDesdeBib
'             PERO CON MAPEO BIBLATEX → DOCBOOK EN VEZ DE BIBLATEX → JATS.
'             RESUELVE crossref AL INICIO (IGUAL QUE SU PAR JATS).
' Parámetros: sEntry      As String     — TEXTO COMPLETO DE LA ENTRADA BIBTEX
'             sType       As String     — TIPO (article, book, ...)
'             sClave      As String     — CLAVE BIBTEX SANITIZADA (PARA xml:id)
'             dictEntries As Collection — DICCIONARIO citekey → entry (PARA crossref)
' Retorna   : String — FRAGMENTO <biblioentry>...</biblioentry>
' ==========================================================
Private Function GenerarBiblioentryDesdeBib(sEntry As String, sType As String, sClave As String, dictEntries As Collection) As String

  ' --- 0. INICIALIZACIÓN DE VARIABLES ---
  ' COMILLA DOBLE COMO VARIABLE LOCAL (SC-01)
  Dim cQ As String = Chr(34)
  Dim sXML As String = ""
  Dim sPubwork As String
  Dim sAuthor As String
  Dim sEditor As String
  Dim sEditorType As String
  Dim sEditorA As String
  Dim sEditorAType As String
  Dim sEditorB As String
  Dim sEditorBType As String
  Dim sEditorC As String
  Dim sEditorCType As String
  Dim sTranslator As String
  Dim sTitle As String
  Dim sSubtitle As String
  Dim sJournal As String
  Dim sBookTitle As String
  Dim sBookSubtitle As String
  Dim sYear As String
  Dim sDate As String
  Dim sFinalYear As String
  Dim sVolume As String
  Dim sNumber As String
  Dim sPages As String
  Dim sPublisher As String
  Dim sAddress As String
  Dim sDoi As String
  Dim sIsbn As String
  Dim sIssn As String
  Dim sUrl As String
  Dim sUrlDate As String
  Dim sEdition As String
  Dim sSchool As String
  Dim sCampoTypeTesis As String
  Dim sCodigoTesis As String
  Dim sNombreTesis As String
  Dim sInstitution As String
  Dim sOrganization As String
  Dim sNote As String
  Dim sEid As String
  Dim sEprint As String
  Dim sEprintType As String
  Dim sSeries As String
  Dim sVersion As String
  Dim sHolder As String
  Dim sMaintitle As String
  Dim sMainsubtitle As String
  Dim sBookauthor As String
  Dim sChapter As String
  Dim sCrossref As String
  Dim sEntryBase As String
  Dim sTituloCompleto As String
  Dim sBookTitleCompleto As String
  Dim sMaintitleCompleto As String
  ' TIPO REAL PRESERVADO PARA pubwork="other" (thesis, report, ...) Y
  ' TIPO EFECTIVO PARA LAS COMPARACIONES INTERNAS DE LA FUNCIÓN.
  Dim sOtherpubwork As String
  Dim sTipoEfectivo As String

  ' --- 1. RESOLVER crossref SI EXISTE (HERENCIA DE CAMPOS) ---
  sCrossref = ParsearCampoBib(sEntry, "crossref")
  If sCrossref <> "" And dictEntries.Exist(sCrossref) Then
    sEntryBase = dictEntries[sCrossref]
    ' SI EL HIJO ES INCOLLECTION/INBOOK, EL title DEL PADRE PASA A booktitle
    If Lower(TrimUTF8(sType)) = "incollection" Or
        Lower(TrimUTF8(sType)) = "inbook" Or
        Lower(TrimUTF8(sType)) = "bookinbook" Then
      sEntryBase = Replace(sEntryBase, "  title ", "  booktitle ", gb.IgnoreCase)
    Endif
    sEntry = FusionarEntradas(sEntryBase, sEntry)
  Endif

  ' --- 2. DETERMINAR pubwork Y TIPO EFECTIVO ---
  sPubwork = ConvertirTipoDocBook(sType)
  sOtherpubwork = ConvertirOtherpubwork(sType)

  ' TIPO EFECTIVO: PARA pubwork="other" LAS COMPARACIONES INTERNAS
  ' (TESIS→orgname, PATENTE→patent-number, ETC.) USAN EL TIPO REAL.
  If sPubwork = "other" Then
    sTipoEfectivo = sOtherpubwork
  Else
    sTipoEfectivo = sPubwork
  Endif

  ' --- 3. EXTRAER CAMPOS DEL BIBLATEX ---
  sAuthor = ParsearCampoBib(sEntry, "author")
  sEditor = ParsearCampoBib(sEntry, "editor")
  sEditorType = ParsearCampoBib(sEntry, "editortype")
  sEditorA = ParsearCampoBib(sEntry, "editora")
  sEditorAType = ParsearCampoBib(sEntry, "editoratype")
  sEditorB = ParsearCampoBib(sEntry, "editorb")
  sEditorBType = ParsearCampoBib(sEntry, "editorbtype")
  sEditorC = ParsearCampoBib(sEntry, "editorc")
  sEditorCType = ParsearCampoBib(sEntry, "editorctype")
  sTranslator = ParsearCampoBib(sEntry, "translator")
  sTitle = ParsearCampoBib(sEntry, "title")
  sSubtitle = ParsearCampoBib(sEntry, "subtitle")
  sBookauthor = ParsearCampoBib(sEntry, "bookauthor")
  sMaintitle = ParsearCampoBib(sEntry, "maintitle")
  sMainsubtitle = ParsearCampoBib(sEntry, "mainsubtitle")

  ' JOURNAL: PRIORIZAR journaltitle SOBRE journal (PATRÓN BIBLATEX MODERNO)
  sJournal = ParsearCampoBib(sEntry, "journaltitle")
  If sJournal = "" Then sJournal = ParsearCampoBib(sEntry, "journal")

  sBookTitle = ParsearCampoBib(sEntry, "booktitle")
  sBookSubtitle = ParsearCampoBib(sEntry, "booksubtitle")

  ' AÑO: PRIORIZAR date SOBRE year (BIBLATEX MODERNO)
  sDate = ParsearCampoBib(sEntry, "date")
  sYear = ParsearCampoBib(sEntry, "year")
  If sDate <> "" Then
    sFinalYear = ExtraerAnio(sDate)
  Else If sYear <> "" Then
    sFinalYear = sYear
  Else
    sFinalYear = ""
  Endif

  sVolume = ParsearCampoBib(sEntry, "volume")
  sNumber = ParsearCampoBib(sEntry, "number")
  sPages = ParsearCampoBib(sEntry, "pages")
  sPublisher = ParsearCampoBib(sEntry, "publisher")

  ' UBICACIÓN: location (BIBLATEX) o address (BIBTEX VIEJO)
  sAddress = ParsearCampoBib(sEntry, "location")
  If sAddress = "" Then sAddress = ParsearCampoBib(sEntry, "address")

  sDoi = ParsearCampoBib(sEntry, "doi")
  sIsbn = ParsearCampoBib(sEntry, "isbn")
  sIssn = ParsearCampoBib(sEntry, "issn")
  sUrl = ParsearCampoBib(sEntry, "url")
  sUrlDate = ParsearCampoBib(sEntry, "urldate")
  sEdition = ParsearCampoBib(sEntry, "edition")
  sSchool = ParsearCampoBib(sEntry, "school")
  ' CAMPO type: REFINA EL TIPO DE TESIS (phdthesis, mathesis, ...) EN
  ' BIBLATEX MODERNO (@thesis + type=). SE RESUELVE MÁS ABAJO.
  sCampoTypeTesis = ParsearCampoBib(sEntry, "type")

  sInstitution = ParsearCampoBib(sEntry, "institution")
  sOrganization = ParsearCampoBib(sEntry, "organization")
  sNote = ParsearCampoBib(sEntry, "note")
  sEid = ParsearCampoBib(sEntry, "eid")
  sEprint = ParsearCampoBib(sEntry, "eprint")
  sEprintType = ParsearCampoBib(sEntry, "eprinttype")
  sSeries = ParsearCampoBib(sEntry, "series")
  sVersion = ParsearCampoBib(sEntry, "version")
  sHolder = ParsearCampoBib(sEntry, "holder")
  sChapter = ParsearCampoBib(sEntry, "chapter")

  ' --- 4. ABRIR <biblioentry> CON xml:id Y, OPCIONALMENTE, pubwork ---
  ' EL xml:id USA LA FORMA SANITIZADA: COINCIDE CON EL linkend DEL
  ' <biblioref/> QUE EMITE cite-to-biblioref-db.lua.
  If sPubwork = "" Then
    sXML &= "    <biblioentry xml:id=" & cQ & "bib-" & sClave & cQ & ">" & gb.NewLine
  Else If sPubwork = "other" And sOtherpubwork <> "" Then
    ' pubwork="other" + otherpubwork="<tipo>": PRESERVA LA NATURALEZA
    ' REAL DE LA OBRA (SPEC DOCBOOK 5.2, ATRIBUTO otherpubwork NMTOKEN).
    sXML &= "    <biblioentry xml:id=" & cQ & "bib-" & sClave & cQ &
      " pubwork=" & cQ & "other" & cQ &
      " otherpubwork=" & cQ & sOtherpubwork & cQ & ">" & gb.NewLine
  Else
    sXML &= "    <biblioentry xml:id=" & cQ & "bib-" & sClave & cQ &
      " pubwork=" & cQ & sPubwork & cQ & ">" & gb.NewLine
  Endif

  ' --- 5. AUTORES Y EDITORES ---
  ' EL ORDEN ES: <author> PRIMERO, LUEGO <editor>, LUEGO <othercredit>.
  If sAuthor <> "" Then
    sXML &= GenerarPersonGroupDocBook(sAuthor, "author|")
  Endif

  If sEditor <> "" Then
    Dim sTipoEditor As String = MapearTipoEditorDocBook(sEditorType)
    sXML &= GenerarPersonGroupDocBook(sEditor, sTipoEditor)
  Endif
  If sEditorA <> "" Then
    Dim sTipoEditorA As String = MapearTipoEditorDocBook(sEditorAType)
    sXML &= GenerarPersonGroupDocBook(sEditorA, sTipoEditorA)
  Endif
  If sEditorB <> "" Then
    Dim sTipoEditorB As String = MapearTipoEditorDocBook(sEditorBType)
    sXML &= GenerarPersonGroupDocBook(sEditorB, sTipoEditorB)
  Endif
  If sEditorC <> "" Then
    Dim sTipoEditorC As String = MapearTipoEditorDocBook(sEditorCType)
    sXML &= GenerarPersonGroupDocBook(sEditorC, sTipoEditorC)
  Endif
  If sTranslator <> "" Then
    sXML &= GenerarPersonGroupDocBook(sTranslator,
      "othercredit|class=" & cQ & "translator" & cQ)
  Endif

  ' --- 6. TÍTULOS ---
  ' COMPONER TÍTULOS COMPLETOS CON SUBTÍTULOS (PATRÓN BIBLATEX: title + ": " + subtitle).
  ' LOS CAMPOS DE TEXTO PASAN POR TextoBibDocBook: QUITA LAS LLAVES DE BibTeX
  ' ({I}'ve, QUE SE IMPRIMÍAN EN HTML Y EPUB), TRADUCE \enquote, \sptext Y
  ' \emph A SU ELEMENTO (SC-57) Y ESCAPA EL TEXTO.
  ' NO PASAN URL NI DOI: EN biblatex SON LITERALES
  sTituloCompleto = If(sSubtitle <> "", sTitle & ": " & sSubtitle, sTitle)
  sBookTitleCompleto = If(sBookSubtitle <> "", sBookTitle & ": " & sBookSubtitle, sBookTitle)
  sMaintitleCompleto = If(sMainsubtitle <> "", sMaintitle & ": " & sMainsubtitle, sMaintitle)

  ' DECISIÓN: EN INCOLLECTION/INBOOK, EL title ES EL CAPÍTULO Y booktitle
  ' ES EL CONTENEDOR. EN DOCBOOK, USAMOS <title> PARA EL CHAPTER-TITLE Y
  ' <citetitle pubwork="book"> PARA EL CONTENEDOR.
  If sBookTitleCompleto <> "" Then
    If sTituloCompleto <> "" Then
      sXML &= "      <title>" & TextoBibDocBook(sTituloCompleto) & "</title>" & gb.NewLine
    Endif
    sXML &= "      <citetitle pubwork=" & cQ & "book" & cQ & ">" &
      TextoBibDocBook(sBookTitleCompleto) & "</citetitle>" & gb.NewLine
  Else
    ' SIN BOOKTITLE: EL title VA SEGÚN EL TIPO DE PUBLICACIÓN
    If sTituloCompleto <> "" Then
      Select Case sTipoEfectivo
        Case "article", "periodical"
          ' EL title DEL ARTÍCULO ES UN <title>; EL journal VA COMO <citetitle>
          sXML &= "      <title>" & TextoBibDocBook(sTituloCompleto) & "</title>" & gb.NewLine
        Case Else
          ' LIBROS, REPORTES, TESIS, ETC.: title COMO <citetitle pubwork="X">
          sXML &= "      <citetitle"
          If sPubwork <> "" Then
            sXML &= " pubwork=" & cQ & sPubwork & cQ
          Endif
          sXML &= ">" & TextoBibDocBook(sTituloCompleto) & "</citetitle>" & gb.NewLine
      End Select
    Endif
  Endif

  ' MAINTITLE (TÍTULO DE OBRA MULTI-VOLUMEN, BIBLATEX-ESPECÍFICO)
  If sMaintitleCompleto <> "" Then
    sXML &= "      <citetitle pubwork=" & cQ & "set" & cQ & ">" &
      TextoBibDocBook(sMaintitleCompleto) & "</citetitle>" & gb.NewLine
  Endif

  ' JOURNAL: PARA article/periodical, EL journal_title VA COMO <citetitle pubwork="journal">
  If sJournal <> "" And (sTipoEfectivo = "article" Or sTipoEfectivo = "periodical") Then
    sXML &= "      <citetitle pubwork=" & cQ & "journal" & cQ & ">" &
      TextoBibDocBook(sJournal) & "</citetitle>" & gb.NewLine
  Endif

  ' SERIES (BIBLATEX series): SOLO APLICA A LIBROS Y COLECCIONES
  If sSeries <> "" And (sPubwork = "book" Or sPubwork = "chapter" Or
      InStr(Lower(sType), "collection") > 0) Then
    sXML &= "      <bibliomisc role=" & cQ & "series" & cQ & ">" &
      TextoBibDocBook(sSeries) & "</bibliomisc>" & gb.NewLine
  Endif

  ' --- 7. PUBLISHER Y UBICACIÓN ---
  If sPublisher <> "" Then
    sXML &= "      <publisher>" & gb.NewLine
    sXML &= "        <publishername>" & TextoBibDocBook(sPublisher) & "</publishername>" & gb.NewLine
    If sAddress <> "" Then
      sXML &= "        <address><city>" & TextoBibDocBook(sAddress) & "</city></address>" & gb.NewLine
    Endif
    sXML &= "      </publisher>" & gb.NewLine
  Else If sAddress <> "" Then
    ' ADDRESS SIN PUBLISHER: EMITIR COMO bibliomisc PARA NO PERDER EL DATO
    sXML &= "      <bibliomisc role=" & cQ & "address" & cQ & ">" &
      TextoBibDocBook(sAddress) & "</bibliomisc>" & gb.NewLine
  Endif

  ' --- 8. FECHA, VOLUMEN, NÚMERO ---
  If sFinalYear <> "" Then
    sXML &= "      <pubdate>" & EscaparXML(sFinalYear) & "</pubdate>" & gb.NewLine
  Endif
  If sVolume <> "" Then
    sXML &= "      <volumenum>" & EscaparXML(sVolume) & "</volumenum>" & gb.NewLine
  Endif

  If sNumber <> "" Then
    Select Case sTipoEfectivo
      Case "patent"
        sXML &= "      <bibliomisc role=" & cQ & "patent-number" & cQ & ">" &
          EscaparXML(sNumber) & "</bibliomisc>" & gb.NewLine
      Case "report"
        sXML &= "      <bibliomisc role=" & cQ & "report-number" & cQ & ">" &
          EscaparXML(sNumber) & "</bibliomisc>" & gb.NewLine
      Case Else
        sXML &= "      <issuenum>" & EscaparXML(sNumber) & "</issuenum>" & gb.NewLine
    End Select
  Endif

  ' --- 9. PAGINACIÓN ---
  ' DOCBOOK 5.2 NO TIENE <fpage>/<lpage> COMO JATS — USA <artpagenums>
  ' QUE ES UN STRING CON EL RANGO COMPLETO. SE PRESERVA EL FORMATO ORIGINAL.
  If sEid <> "" Then
    sXML &= "      <bibliomisc role=" & cQ & "elocation" & cQ & ">" &
      EscaparXML(sEid) & "</bibliomisc>" & gb.NewLine
  Else If sPages <> "" Then
    ' NORMALIZAR "--" A "-" PARA LECTURA EN HTML
    Dim sPagesNorm As String = Replace(TrimUTF8(sPages), "--", "-")
    sXML &= "      <artpagenums>" & EscaparXML(sPagesNorm) & "</artpagenums>" & gb.NewLine
  Endif

  ' --- 10. EDICIÓN, INSTITUCIÓN, NOTAS ---
  If sEdition <> "" Then
    sXML &= "      <edition>" & TextoBibDocBook(sEdition) & "</edition>" & gb.NewLine
  Endif

  ' INSTITUTION/ORGANIZATION: PARA TESIS Y REPORTES
  If sTipoEfectivo = "thesis" Or sTipoEfectivo = "report" Then
    If sInstitution <> "" Then
      sXML &= "      <orgname>" & TextoBibDocBook(sInstitution) & "</orgname>" & gb.NewLine
    Else If sSchool <> "" Then
      sXML &= "      <orgname>" & TextoBibDocBook(sSchool) & "</orgname>" & gb.NewLine
    Else If sOrganization <> "" Then
      sXML &= "      <orgname>" & TextoBibDocBook(sOrganization) & "</orgname>" & gb.NewLine
    Endif
  Endif

  ' TIPO DE TESIS: EMITIR EL NOMBRE EN ESPAÑOL (DESDE cmb_biblatex) COMO
  ' bibliomisc. SOLO PARA TESIS. SI EL type NO ESTÁ EN LA TABLA PERO EL
  ' BIB TRAE UN VALOR LIBRE (EJ. TIPO LOCAL NO CATALOGADO), SE PRESERVA
  ' ESE TEXTO. SI NO HAY type ALGUNO, NO SE EMITE NADA Y EL XSLT PONDRÁ
  ' "Tesis" GENÉRICO AL VER otherpubwork='thesis'.
  If sTipoEfectivo = "thesis" Then
    ' DECLARADAS EN APARTADO 0: sCodigoTesis, sNombreTesis
    sCodigoTesis = ResolverCodigoTesis(sType, sCampoTypeTesis)
    If sCodigoTesis <> "" Then
      sNombreTesis = TraducirTipoTesis(sCodigoTesis)
      If sNombreTesis <> "" Then
        ' CÓDIGO CONOCIDO: NOMBRE EN ESPAÑOL DESDE LA BD.
        sXML &= "      <bibliomisc role=" & cQ & "thesis-type" & cQ & ">" &
          EscaparXML(sNombreTesis) & "</bibliomisc>" & gb.NewLine
      Else If TrimUTF8(sCampoTypeTesis) <> "" Then
        ' CÓDIGO NO CATALOGADO PERO CON TEXTO LIBRE: PRESERVARLO TAL CUAL
        ' (RESPETA TIPOS LOCALES NO CARGADOS EN cmb_biblatex).
        sXML &= "      <bibliomisc role=" & cQ & "thesis-type" & cQ & ">" &
          EscaparXML(TrimUTF8(sCampoTypeTesis)) & "</bibliomisc>" & gb.NewLine
      Endif
    Endif
  Endif

  If sNote <> "" Then
    sXML &= "      <bibliomisc role=" & cQ & "note" & cQ & ">" &
      TextoBibDocBook(sNote) & "</bibliomisc>" & gb.NewLine
  Endif

  If sVersion <> "" Then
    sXML &= "      <bibliomisc role=" & cQ & "version" & cQ & ">" &
      TextoBibDocBook(sVersion) & "</bibliomisc>" & gb.NewLine
  Endif

  If sHolder <> "" And sTipoEfectivo = "patent" Then
    ' LIMPIAR LLAVES BIBLATEX DEL CAMPO holder
    Dim sHolderLimpio As String
    sHolderLimpio = Replace(sHolder, "{{", "")
    sHolderLimpio = Replace(sHolderLimpio, "}}", "")
    sHolderLimpio = Replace(sHolderLimpio, "{", "")
    sHolderLimpio = Replace(sHolderLimpio, "}", "")
    sHolderLimpio = Replace(sHolderLimpio, " and ", ", ")
    sXML &= "      <bibliomisc role=" & cQ & "patent-holder" & cQ & ">" &
      EscaparXML(sHolderLimpio) & "</bibliomisc>" & gb.NewLine
  Endif

  ' --- 11. IDENTIFICADORES ESTÁNDAR ---
  ' EN DOCBOOK 5.2, TODOS LOS IDENTIFICADORES DE PUBLICACIÓN VAN COMO
  ' <biblioid class="X">VALOR</biblioid>. EL ATRIBUTO class TIENE VALORES
  ' ENUMERADOS QUE INCLUYEN: doi, isbn, issn, pubnumber, uri, etc.
  If sIsbn <> "" Then
    sXML &= "      <biblioid class=" & cQ & "isbn" & cQ & ">" &
      EscaparXML(sIsbn) & "</biblioid>" & gb.NewLine
  Endif
  If sIssn <> "" Then
    sXML &= "      <biblioid class=" & cQ & "issn" & cQ & ">" &
      EscaparXML(sIssn) & "</biblioid>" & gb.NewLine
  Endif
  If sDoi <> "" Then
    sXML &= "      <biblioid class=" & cQ & "doi" & cQ & ">" &
      EscaparXML(sDoi) & "</biblioid>" & gb.NewLine
  Endif
  If sEprint <> "" Then
    ' EL ATRIBUTO class DE biblioid NO TIENE UN VALOR PARA cada eprint type;
    ' USAMOS class="other" CON otherclass PARA PRESERVAR EL TIPO ORIGINAL.
    Dim sEprintTypeLower As String = Lower(sEprintType)
    If sEprintTypeLower = "" Then sEprintTypeLower = "eprint"
    sXML &= "      <biblioid class=" & cQ & "other" & cQ &
      " otherclass=" & cQ & EscaparXML(sEprintTypeLower) & cQ & ">" &
      EscaparXML(sEprint) & "</biblioid>" & gb.NewLine
  Endif

  ' URL: SE EMITE COMO <bibliosource> CON <link xlink:href="...">
  ' EL NAMESPACE xlink LO DECLARA EL WRAPPER DEL CANÓNICO (RC-DB-06).
  If sUrl <> "" Then
    sXML &= "      <bibliosource><link xlink:href=" & cQ & EscaparXML(sUrl) & cQ & ">" &
      EscaparXML(sUrl) & "</link></bibliosource>" & gb.NewLine
  Endif

  ' URLDATE: FECHA DE CONSULTA
  If sUrlDate <> "" Then
    sXML &= "      <bibliomisc role=" & cQ & "urldate" & cQ & ">" &
      EscaparXML(sUrlDate) & "</bibliomisc>" & gb.NewLine
  Endif

  ' --- 12. CIERRE ---
  sXML &= "    </biblioentry>" & gb.NewLine

  Return sXML

End

' ════════════════════════════════════════════════════════════════════════════
' PARCHE: TIPO DE TESIS EN EL CANÓNICO (thesis-type)
' ════════════════════════════════════════════════════════════════════════════
' Emite <bibliomisc role="thesis-type">Nombre en español</bibliomisc> para
' que el XSLT de salida formatee la referencia de tesis correctamente.
'
' PATRÓN (Opción A, coherente con RC-XJ-02): la traducción código→nombre
' vive en la BD (cmb_biblatex). Gambas la resuelve y emite el NOMBRE en
' español ya listo; el canónico queda autónomo, el XSLT solo lo coloca.
'
' TRES MODIFICACIONES:

'   3. En GenerarBiblioentryDesdeBib: capturar 'type' y emitir el bibliomisc.
' ════════════════════════════════════════════════════════════════════════════

' ============================================
' Función   : TraducirTipoTesis
' Propósito : TRADUCE UN CÓDIGO DE TIPO DE TESIS (phdthesis, mathesis, ...)
'             A SU NOMBRE EN ESPAÑOL CONSULTANDO cmb_biblatex. LA BD ES
'             LA FUENTE CANÓNICA DE LA TRADUCCIÓN (RC-XJ-02).
' Parámetros: sCodigo As String — CÓDIGO biblatex DEL TIPO DE TESIS
' Retorna   : String — NOMBRE EN ESPAÑOL (ej. "Tesis Doctoral"), O CADENA
'             VACÍA SI EL CÓDIGO NO ESTÁ EN LA TABLA (EL LLAMADOR DECIDE
'             EL FALLBACK).
' ============================================
Private Function TraducirTipoTesis(sCodigo As String) As String

  Dim hRes As Result

  ' --- 1. VALIDAR ENTRADA ---
  If TrimUTF8(sCodigo) = "" Then Return ""

  ' --- 2. CONSULTAR cmb_biblatex (thesis_type ACTIVO) ---
  ' RC-GM-15: Exec CON POCOS PLACEHOLDERS ES SEGURO; AQUÍ SOLO 1.
  Try hRes = m_ConexionBD.mConn.Exec(
    "SELECT nombre FROM cmb_biblatex " &
    "WHERE tipo = 'thesis_type' AND codigo = &1 AND activo = TRUE LIMIT 1",
    Lower(TrimUTF8(sCodigo)))
  If Error Then
    ' NO ABORTAR LA GENERACIÓN POR UN FALLO DE TRADUCCIÓN: EL LLAMADOR
    ' USARÁ SU FALLBACK. SOLO DEVOLVER VACÍO.
    Return ""
  Endif

  ' --- 3. RETORNAR EL NOMBRE O VACÍO ---
  If hRes.Available Then
    Return TrimUTF8(hRes["nombre"])
  Endif
  Return ""

End

' ============================================
' Función   : ResolverCodigoTesis
' Propósito : DETERMINA EL CÓDIGO DE TIPO DE TESIS A PARTIR DE LAS DOS
'             FORMAS EN QUE biblatex LO INDICA:
'               (a) TIPO DE ENTRADA: @phdthesis / @mastersthesis (bibtex)
'               (b) CAMPO type EN @thesis: type = {phdthesis} (biblatex)
'             EL CAMPO type EXPLÍCITO TIENE PRIORIDAD (BIBLATEX MODERNO).
'             NORMALIZA A MINÚSCULAS PARA MATCHEAR cmb_biblatex.codigo.
' Parámetros: sType      As String — TIPO DE ENTRADA (phdthesis, thesis, ...)
'             sCampoType As String — VALOR DEL CAMPO type DEL BIB (PUEDE
'                                    ESTAR VACÍO)
' Retorna   : String — CÓDIGO NORMALIZADO (ej. "phdthesis"), O CADENA VACÍA
'             SI NO SE PUEDE DETERMINAR.
' ============================================
Private Function ResolverCodigoTesis(sType As String, sCampoType As String) As String

  Dim sT As String
  Dim sCampo As String

  sT = Lower(TrimUTF8(sType))
  sCampo = Lower(TrimUTF8(sCampoType))

  ' --- 1. PRIORIDAD: CAMPO type EXPLÍCITO (BIBLATEX MODERNO) ---
  ' EJ: @thesis{..., type = {phdthesis}} → "phdthesis"
  If sCampo <> "" Then Return sCampo

  ' --- 2. TIPO DE ENTRADA CLÁSICO (@phdthesis / @mastersthesis) ---
  ' bibtex USA @mastersthesis; cmb_biblatex USA "mathesis".
  If sT = "phdthesis" Then Return "phdthesis"
  If sT = "mastersthesis" Then Return "mathesis"

  ' --- 3. ENTRADA @thesis SIN CAMPO type: SIN CÓDIGO ESPECÍFICO ---
  Return ""

End
