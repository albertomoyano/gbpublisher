' Gambas class file

' ============================================
' Clase     : CInsumosLibro
' Propósito : Lo que Gambas deja resuelto y escrito a disco antes de lanzar
'             un script de engine/ sobre el libro. Todo lo que sale de la base
'             —info del libro, manifiesto, bibliografía consolidada— ya está
'             en tmp/ cuando este objeto existe con bListo en True; los campos
'             son los argumentos que el script necesita para encontrarlo.
'             Clase y no parámetros de salida: en Gambas un primitivo no se
'             puede devolver por parámetro (GV-24).
' ============================================

' TRUE SOLO SI TODOS LOS INSUMOS SE ESCRIBIERON. EN FALSE, EL QUE LO PREPARÓ
' YA INFORMÓ POR QUÉ, Y EL LLAMADOR SOLO TIENE QUE SALIR
Public bListo As Boolean

Public iIdLibro As Integer
Public sRutaProyecto As String

' NOMBRE DEL LIBRO SIN EL PREFIJO «l-»: EL QUE USAN EL MANIFIESTO Y EL
' CANÓNICO DEL LIBRO
Public sNombreBase As String

' por_capitulo | consolidada
Public sLugarBibliografia As String

' RUTA RELATIVA AL PROYECTO DE LA BIBLIOGRAFÍA CONSOLIDADA. VACÍA EN
' por_capitulo; AL SCRIPT SE LE PASA «-» EN ESE CASO
Public sBiblioRel As String
