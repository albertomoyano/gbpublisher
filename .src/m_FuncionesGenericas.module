' Gambas module file

' ==============================================================================
' Módulo    : m_FuncionesGenericas
' Propósito : Utilidades transversales de gbpublisher: validadores de
'             identificadores, buscadores incrementales de la solapa BibTeX,
'             gestión de la estructura de carpetas del proyecto, verificadores
'             de integridad de los .md, motor de búsqueda literal en texto
'             UTF-8 y chequeo de dependencias del sistema.
' Dependencias: m_InicioCierre, m_ConexionBD, m_Sonido, m_Constantes, FMain,
'             FEstructuraResultados, FAyudas, FAvisoLegal.
'
' REVISIÓN — CORRECCIÓN DEL BUG DE RUTA DE PROYECTO
' -------------------------------------------------
' CAUSA RAÍZ: cinco funciones tomaban m_InicioCierre.ArchivoProyectoEnCurso
' (que es la RUTA DE UN ARCHIVO .md, no una carpeta) y la usaban como raíz para
' recorrer directorios. Exist() devuelve True también para archivos regulares,
' así que el guard no protegía y el Dir() siguiente abortaba con el error 49
' "Not a directory", matando la función entera sin mensaje visible.
' Reproducido en Gambas:
'   ruta = [/proyecto/r-revista.md]  Exist=True
'   #49: Not a directory: /proyecto/r-revista.md
' Funcionaba de casualidad cuando NombreProyectoEnCurso estaba vacío, porque
' "/a/b" &/ "" devuelve "/a/b", o sea la raíz.
' CORRECCIÓN: las cinco pasan por RaizProyectoValida(), que devuelve
' RutaProyectoEnCurso solo si es un directorio existente. Además todos los
' Dir() del módulo quedan envueltos en Try + If Error (RC-GM-02).
' ==============================================================================

Private ArticulosIDs As Collection
Private rutaIPs As String = User.Home &/ ".gbpublisher/.ips.txt"

' --- CANALES DE RETORNO DE FORMULARIOS MODALES (RC-GM-13) ---
' LAS VARIABLES Public DE UN FORM NO SIRVEN COMO CANAL DE RETORNO: AL CERRARSE
' LA INSTANCIA SE DESTRUYE Y EL VALOR SE PIERDE. VAN ACÁ, EN UN MÓDULO.

' RESULTADO DE LA SELECCIÓN EN FAutores. RESETEADO A 0 POR CADA CONSUMIDOR
' ANTES DE FAutores.ShowModal(), LEÍDO AL VOLVER DEL MODAL.
Public iAutorSeleccionadoEnFAutores As Integer = 0

' RESULTADO DE LA SELECCIÓN EN FCreditRoles. EL LLAMADOR LO LEE DESPUÉS DE
' ShowModal(). ANTES ESTABA DECLARADO A MITAD DEL MÓDULO, ENTRE DOS FUNCIONES.
Public sCreditSeleccionado As String

' SEÑAL DE QUE EL REEMPLAZO REGEX ESCRIBIÓ ARCHIVOS. LA LEE FMain AL VOLVER DEL
' MODAL PARA RECARGAR EL EDITOR SI EL ARCHIVO EN CURSO FUE TOCADO.
Public bRegexHuboEscritura As Boolean

' ============================================
' Función   : RaizProyectoValida
' Propósito : Devuelve la raíz del proyecto en curso SOLO si es un directorio
'             existente. Centraliza el guard que faltaba en las cinco funciones
'             que recorren los .md del proyecto y que abortaban con
'             "Not a directory" al recibir la ruta de un archivo.
' Parámetros: (ninguno)
' Retorna   : String — raíz del proyecto, o "" si no hay proyecto abierto o
'             la ruta no es un directorio
' ============================================
Public Function RaizProyectoValida() As String

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim sRaiz As String

  ' --- 2. SIN PROYECTO ABIERTO ---
  sRaiz = m_InicioCierre.RutaProyectoEnCurso
  If sRaiz = "" Then Return ""

  ' --- 3. LA RUTA DEBE SER UN DIRECTORIO ---
  ' Exist DEVUELVE True TAMBIÉN PARA ARCHIVOS REGULARES. SIN IsDir, EL Dir()
  ' POSTERIOR LEVANTA #49 "Not a directory" Y ABORTA LA FUNCIÓN ENTERA.
  ' If ANIDADO POR RC-GM-17: IsDir SOBRE RUTA INEXISTENTE PUEDE FALLAR
  If Not Exist(sRaiz) Then Return ""
  If Not IsDir(sRaiz) Then Return ""

  Return sRaiz

End

' ============================================
' Función   : AvisarSinProyecto
' Propósito : Mensaje único para las funciones que necesitan un proyecto
'             abierto y no lo tienen. Evita seis redacciones distintas del
'             mismo aviso repartidas por el módulo.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Private Sub AvisarSinProyecto()

  m_Sonido.sonar("Warning")
  Message.Warning("No hay un proyecto abierto, o la carpeta del proyecto no está accesible.")

End

' ============================================
' Función   : VerificarURLDesdeCampo
' Propósito : Consulta el código HTTP de la URL escrita en un TextBox y lo
'             informa al usuario en lenguaje llano.
' Parámetros: campo As TextBox — control que contiene la URL a verificar
' Retorna   : (Sub, sin retorno)
'
' SEGURIDAD: ANTES USABA Shell CON Quote(sURL). Quote() ES EL ESCAPADO DE
' GAMBAS, NO EL DE SHELL: DEVUELVE EL TEXTO ENTRE COMILLAS DOBLES, Y DENTRO DE
' COMILLAS DOBLES sh SIGUE EXPANDIENDO $(...) Y `...`. UNA URL PEGADA EN EL
' CAMPO CON LA FORMA http://x/$(comando) EJECUTABA ESE COMANDO. AHORA SE USA
' Exec CON ARRAY (SC-05), QUE NO PASA POR sh -c Y NO INTERPRETA NADA.
' EL ARRAY LITERAL VA EN UNA SOLA LÍNEA: PARTIDO CON COMA FINAL, GAMBAS LO LEE
' COMO String Y TIRA Type mismatch.
' ============================================
Public Sub VerificarURLDesdeCampo(campo As TextBox)

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim sURL As String
  Dim sResult As String

  ' --- 2. VALIDACIÓN DE ENTRADA ---
  sURL = Trim(campo.Text)
  If sURL = "" Then
    m_Sonido.sonar("Error")
    Message.Error("Por favor, ingrese una URL válida.")
    campo.SetFocus
    Return
  Endif

  ' --- 3. CONSULTA HTTP ---
  ' EL INDICADOR DE CARGA SE ENCIENDE RECIÉN ACÁ: ANTES SE ENCENDÍA AL ENTRAR
  ' Y HABÍA QUE APAGARLO EN CADA CAMINO DE SALIDA, INCLUIDO EL DE VALIDACIÓN
  FMain.Mouse = Mouse.Wait
  sResult = ""
  Try Exec ["curl", "-s", "-o", "/dev/null", "-w", "%{http_code}", "-L", "--connect-timeout", "5", "--max-time", "10", "-A", "Mozilla/5.0", sURL] To sResult
  FMain.Mouse = Mouse.Default

  ' RC-GM-02: Try NO INTERRUMPE LA EJECUCIÓN. SIN ESTE CHEQUEO, UN curl AUSENTE
  ' CAERÍA EN EL Case Else INFORMANDO UN "CÓDIGO DESCONOCIDO" VACÍO
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo ejecutar la verificación." & Chr(10) &
      "Verifique que curl esté instalado:" & Chr(10) & Error.Text)
    campo.SetFocus
    Return
  Endif

  ' --- 4. INFORMAR EL RESULTADO ---
  Select Case Trim(sResult)
    Case "200"
      m_Sonido.sonar("Info")
      Message.Info("La <b>URL existe</b> y respondió con código 200.")
    Case "301", "302"
      m_Sonido.sonar("Info")
      Message.Info("La <b>URL fue redireccionada</b> y respondió con código " & Trim(sResult) & ".")
    Case "404"
      m_Sonido.sonar("Error")
      Message.Error("La <b>URL no existe</b> (404 Not Found).")
    Case "500", "503"
      m_Sonido.sonar("Error")
      Message.Error("<b>Error del servidor</b> (" & Trim(sResult) & "). Intente nuevamente más tarde.")
    Case "000"
      m_Sonido.sonar("Error")
      Message.Error("Tiempo de espera agotado o no se pudo conectar al servidor.")
    Case Else
      m_Sonido.sonar("Error")
      Message.Error("Código de respuesta desconocido: <b>" & Trim(sResult) & "</b>.")
  End Select

  ' --- 5. RESTAURAR FOCO (RC-GM-07) ---
  ' EL Message.* REFUERZA LA PÉRDIDA DE FOCO; EL USUARIO ESPERA SEGUIR EDITANDO
  campo.SetFocus

End

' ============================================
' Función   : EsISBNValido
' Propósito : Valida un ISBN-10 o ISBN-13 calculando su dígito verificador.
'             Acepta guiones, espacios y la 'X' final (mayúscula o minúscula)
'             como dígito 10 en ISBN-10.
' Parámetros: sISBN As String — código a verificar
' Retorna   : Boolean — True si el ISBN es válido, False en caso contrario
' Notas     : ISBN-10 usa módulo 11 con pesos 10..1
'             ISBN-13 usa módulo 10 con pesos alternados 1, 3, 1, 3, ...
' ============================================
Public Function EsISBNValido(sISBN As String) As Boolean

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim sLimpio As String
  Dim i As Integer
  Dim iLen As Integer
  Dim iSuma As Integer
  Dim iPeso As Integer
  Dim iDigito As Integer
  Dim iVerifCalculado As Integer
  Dim iVerifLeido As Integer
  Dim sChar As String

  ' --- 2. NORMALIZAR ENTRADA ---
  ' QUITAR GUIONES Y ESPACIOS, NORMALIZAR LA 'X' A MAYÚSCULA.
  ' String.Len Y String.Mid PORQUE UN PEGADO SUCIO PUEDE TRAER GUION LARGO O
  ' ESPACIO DURO, QUE SON MULTIBYTE Y ROMPERÍAN EL CONTEO EN BYTES (RC-GM-12)
  sLimpio = Replace(sISBN, "-", "")
  sLimpio = Replace(sLimpio, " ", "")
  sLimpio = UCase(sLimpio)
  iLen = String.Len(sLimpio)

  ' --- 3. VALIDAR LONGITUD: SOLO ISBN-10 O ISBN-13 ---
  If iLen <> 10 And iLen <> 13 Then Return False

  ' --- 4. VALIDAR QUE TODOS LOS CARACTERES SEAN DÍGITOS ---
  ' LA 'X' SOLO PUEDE APARECER COMO DÍGITO VERIFICADOR DE ISBN-10
  For i = 1 To iLen
    sChar = String.Mid(sLimpio, i, 1)
    If sChar = "X" Then
      If iLen <> 10 Or i <> 10 Then Return False
    Else
      If Not IsDigit(sChar) Then Return False
    Endif
  Next

  ' --- 5. CÁLCULO ESPECÍFICO POR FORMATO ---
  If iLen = 10 Then

    ' --- 5.A. ISBN-10: MÓDULO 11, PESOS 10..1, 'X' VALE 10 ---
    iPeso = 10
    For i = 1 To 10
      sChar = String.Mid(sLimpio, i, 1)
      If sChar = "X" Then
        iDigito = 10
      Else
        iDigito = CInt(Val(sChar))
      Endif
      iSuma += iDigito * iPeso
      iPeso -= 1
    Next
    ' VÁLIDO SI LA SUMA TOTAL, DÍGITO VERIFICADOR INCLUIDO, ES DIVISIBLE POR 11
    Return (iSuma Mod 11) = 0

  Else

    ' --- 5.B. ISBN-13: MÓDULO 10, PESOS ALTERNADOS 1, 3, 1, 3, ... ---
    iPeso = 1
    For i = 1 To 12
      sChar = String.Mid(sLimpio, i, 1)
      iSuma += CInt(Val(sChar)) * iPeso
      iPeso = If(iPeso = 1, 3, 1)
    Next
    ' EL MOD 10 FINAL ES IMPRESCINDIBLE: SI LA SUMA ES DIVISIBLE POR 10,
    ' EL VERIFICADOR ES 0, NO 10
    iVerifCalculado = (10 - (iSuma Mod 10)) Mod 10
    iVerifLeido = CInt(Val(String.Mid(sLimpio, 13, 1)))
    Return iVerifCalculado = iVerifLeido

  Endif

End

' ============================================
' Función   : IsValidISSN
' Propósito : Valida el formato y el dígito de control de un ISSN.
'             Acepta la forma con y sin guion (NNNN-NNNC o NNNNNNNC).
' Parámetros: sISSN As String — código a verificar
' Retorna   : Boolean — True si el ISSN es válido, False en caso contrario
' Notas     : Módulo 11 con pesos 8..2. El dígito de control puede ser 'X',
'             que representa el valor 10.
' ============================================
Public Sub IsValidISSN(sISSN As String) As Boolean

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  ' TODOS LOS Dim AL INICIO (RC-GM-18): ANTES ESTABAN REPARTIDOS ENTRE LOS
  ' BLOQUES, LO QUE OBLIGA A LEER TODA LA FUNCIÓN PARA SABER QUÉ EXISTE
  Dim i As Integer
  Dim iSuma As Integer
  Dim iPeso As Integer
  Dim iDigitoControl As Integer
  Dim sLimpio As String
  Dim sUltimo As String
  Dim sEsperado As String

  ' --- 2. NORMALIZAR ENTRADA ---
  ' String.* POR CONSISTENCIA CON EsISBNValido: UN PEGADO CON GUION LARGO
  ' HARÍA QUE Len() CONTARA BYTES Y LA VALIDACIÓN DE LONGITUD MINTIERA
  sLimpio = UCase(Replace(sISSN, "-", ""))

  ' --- 3. VALIDAR LONGITUD ---
  If String.Len(sLimpio) <> 8 Then Return False

  ' --- 4. VALIDAR QUE LOS PRIMEROS SIETE SEAN DÍGITOS ---
  For i = 1 To 7
    If Not IsDigit(String.Mid(sLimpio, i, 1)) Then Return False
  Next

  ' --- 5. VALIDAR EL OCTAVO: DÍGITO O 'X' ---
  sUltimo = String.Mid(sLimpio, 8, 1)
  If Not IsDigit(sUltimo) Then
    If sUltimo <> "X" Then Return False
  Endif

  ' --- 6. CALCULAR EL DÍGITO DE CONTROL (MÓDULO 11, PESOS 8..2) ---
  iSuma = 0
  iPeso = 8
  For i = 1 To 7
    iSuma += CInt(Val(String.Mid(sLimpio, i, 1))) * iPeso
    iPeso -= 1
  Next

  iDigitoControl = 11 - (iSuma Mod 11)

  If iDigitoControl = 11 Then
    sEsperado = "0"
  Else If iDigitoControl = 10 Then
    sEsperado = "X"
  Else
    sEsperado = CStr(iDigitoControl)
  Endif

  ' --- 7. COMPARAR ---
  Return sEsperado = sUltimo

End

' ============================================
' Función   : PoblarComboDesdeTexto
' Propósito : Motor único de los buscadores incrementales de la solapa BibTeX.
'             Ejecuta una consulta LIKE con el texto tipeado, llena el ComboBox
'             con la columna pedida y lo muestra solo si hubo resultados.
' Parámetros: sTexto   As String   — texto tipeado por el usuario (sin escapar)
'             hCombo   As ComboBox — control a llenar y mostrar u ocultar
'             sSQL     As String   — consulta con UN placeholder &1 para el LIKE
'             sColumna As String   — nombre de la columna a volcar en el combo
' Retorna   : (Sub, sin retorno)
'
' SUSTITUYE A SEIS FUNCIONES QUE REPETÍAN EL MISMO CUERPO Y LOS MISMOS TRES
' DEFECTOS:
'   a) Exec SIN Try SEGUIDO DE If Error: EL If ERA CÓDIGO MUERTO Y UN FALLO
'      DE SQL SE PROPAGABA HACIA ARRIBA EN VEZ DE OCULTAR EL COMBO (RC-GM-02).
'   b) EL TEXTO DEL USUARIO SE INTERPOLABA EN EL SQL CON UN Replace DE COMILLA
'      SIMPLE COMO ÚNICA DEFENSA. AHORA VA POR PLACEHOLDER &1.
'   c) LOS WILDCARDS % Y _ NO SE ESCAPABAN: TIPEAR "%" TRAÍA LA TABLA ENTERA
'      Y "_" MATCHEABA CUALQUIER CARÁCTER (SC-08).
' ============================================
Private Sub PoblarComboDesdeTexto(sTexto As String, hCombo As ComboBox, sSQL As String, sColumna As String)

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim hResult As Result
  Dim sBusqueda As String
  Dim sValor As String

  ' --- 2. VALIDACIÓN DE ENTRADA ---
  hCombo.Clear()
  sBusqueda = Trim(sTexto)
  If sBusqueda = "" Then
    hCombo.Visible = False
    Return
  Endif

  ' --- 3. ESCAPAR WILDCARDS DE LIKE (SC-08) ---
  ' EL ORDEN IMPORTA: PRIMERO EL CARÁCTER DE ESCAPE MISMO, DESPUÉS LOS WILDCARDS
  sBusqueda = Replace(sBusqueda, "!", "!!")
  sBusqueda = Replace(sBusqueda, "%", "!%")
  sBusqueda = Replace(sBusqueda, "_", "!_")
  sBusqueda = "%" & sBusqueda & "%"

  ' --- 4. CONSULTA A BASE DE DATOS ---
  Try hResult = m_ConexionBD.mConn.Exec(sSQL, sBusqueda)
  If Error Then
    hCombo.Visible = False
    Return
  Endif

  ' --- 5. PROCESAMIENTO DE RESULTADOS ---
  ' If ANIDADO PORQUE And NO ES SHORT-CIRCUIT (RC-GM-17): CON EL CAMPO EN NULL,
  ' EVALUAR Trim() EN LA MISMA EXPRESIÓN QUE EL NULL-CHECK NO ES SEGURO
  While hResult.Available
    If Not IsNull(hResult[sColumna]) Then
      sValor = Trim(hResult[sColumna])
      If sValor <> "" Then hCombo.Add(sValor)
    Endif
    hResult.MoveNext()
  Wend

  ' --- 6. MOSTRAR SOLO SI HAY RESULTADOS ---
  hCombo.Visible = (hCombo.Count > 0)

End

' ============================================
' Función   : BuscarEditorialDesdeTexto
' Propósito : Buscador incremental de editoriales sobre la tabla bibtex.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub BuscarEditorialDesdeTexto()

  ' --- 1. DELEGACIÓN AL MOTOR COMÚN ---
  PoblarComboDesdeTexto(FMain.txtPublisher.Text, FMain.ComboBoxPublisher,
    "SELECT DISTINCT publisher FROM bibtex WHERE publisher LIKE &1 ESCAPE '!' ORDER BY publisher",
    "publisher")

End

