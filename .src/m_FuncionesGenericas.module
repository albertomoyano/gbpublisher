' ============================================
' Función   : ListarMDEnCarpeta
' Propósito : Agrega a los arrays de salida los .md de una carpeta, ordenados
'             alfabéticamente, con la etiqueta prefijada que se muestra al
'             usuario. Si la carpeta no existe o no se puede leer, no agrega
'             nada y no falla.
' Parámetros: sRuta      As String   — carpeta a listar (ruta absoluta)
'             sPrefijo   As String   — prefijo de la etiqueta ("" o "articulos/")
'             aRutas     As String[] — OUT: rutas absolutas de cada archivo
'             aEtiquetas As String[] — OUT: etiquetas para mostrar
' Retorna   : (Sub, sin retorno)
' Notas     : Acá vive el Try que faltaba en TODOS los Dir() del módulo.
'             Dir() sobre un archivo regular levanta el error 49
'             "Not a directory" y sobre una ruta inexistente el error
'             "File or directory does not exist"; sin Try, cualquiera de los
'             dos mata la función llamadora entera (RC-GM-02).
' ============================================
Private Sub ListarMDEnCarpeta(sRuta As String, sPrefijo As String, aRutas As String[], aEtiquetas As String[])

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim aArchivos As String[]
  Dim sArchivo As String

  ' --- 2. LA CARPETA TIENE QUE EXISTIR Y SER UN DIRECTORIO ---
  ' If ANIDADO POR RC-GM-17
  If Not Exist(sRuta) Then Return
  If Not IsDir(sRuta) Then Return

  ' --- 3. LISTAR CON PROTECCIÓN ---
  Try aArchivos = Dir(sRuta, "*.md")
  If Error Then Return

  ' --- 4. VOLCAR ORDENADO ---
  aArchivos.Sort()
  For Each sArchivo In aArchivos
    aRutas.Add(sRuta &/ sArchivo)
    aEtiquetas.Add(sPrefijo & sArchivo)
  Next

End

' ============================================
' Función   : ObtenerArchivosMD
' Propósito : Recolecta todos los .md del proyecto en curso desde las cuatro
'             carpetas relevantes, en el orden natural de lectura. Devuelve dos
'             arrays paralelos: rutas absolutas y etiquetas con prefijo.
'             Las carpetas inexistentes se ignoran en silencio, lo que permite
'             que sirva igual para revistas (sin front/back-matter) y libros.
' Parámetros: aRutas     As String[] — array destino para rutas absolutas
'             aEtiquetas As String[] — array destino para etiquetas
' Retorna   : Boolean — True si hay proyecto abierto y se pudo recorrer
' ============================================
Public Function ObtenerArchivosMD(aRutas As String[], aEtiquetas As String[]) As Boolean

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim sRaiz As String
  Dim sSubcarpeta As String
  Dim aSubcarpetas As String[]

  ' EL ORDEN DETERMINA EL ORDEN DE LOS ARCHIVOS EN LA TABLA. LA CADENA VACÍA
  ' REPRESENTA LA RAÍZ Y NO LLEVA PREFIJO EN LA ETIQUETA
  aSubcarpetas = ["", "front-matter", "articulos", "back-matter"]

  ' --- 2. LIMPIAR LOS ARRAYS POR SI VENÍAN CON CONTENIDO PREVIO ---
  aRutas.Clear
  aEtiquetas.Clear

  ' --- 3. RAÍZ DEL PROYECTO ---
  ' CORRECCIÓN DEL BUG: ANTES LEÍA m_InicioCierre.ArchivoProyectoEnCurso, QUE
  ' ES LA RUTA DEL .md DEL PROYECTO Y NO SU CARPETA
  sRaiz = RaizProyectoValida()
  If sRaiz = "" Then Return False

  ' --- 4. RECORRER EN ORDEN NATURAL DE LECTURA ---
  For Each sSubcarpeta In aSubcarpetas
    If sSubcarpeta = "" Then
      ListarMDEnCarpeta(sRaiz, "", aRutas, aEtiquetas)
    Else
      ListarMDEnCarpeta(sRaiz &/ sSubcarpeta, sSubcarpeta & "/", aRutas, aEtiquetas)
    Endif
  Next

  Return True

End

' ============================================
' Función   : ObtenerArchivosMDRaizYArticulos
' Propósito : Variante acotada de ObtenerArchivosMD que recorre solo la raíz y
'             /articulos. Es el alcance histórico de ContarCaracteresMD,
'             VerificarFootnotes y VerificarEstructuraMD.
' Parámetros: aRutas     As String[] — array destino para rutas absolutas
'             aEtiquetas As String[] — array destino para etiquetas
' Retorna   : Boolean — True si hay proyecto abierto y se pudo recorrer
'
' PENDIENTE DE DECISIÓN: ESTAS TRES FUNCIONES NO MIRAN front-matter NI
' back-matter, ASÍ QUE EN UN LIBRO NO VERIFICAN NI EL PRÓLOGO NI LOS ANEXOS.
' NO SE AMPLIÓ EL ALCANCE PORQUE ES UN CAMBIO DE COMPORTAMIENTO. SI QUERÉS QUE
' VERIFIQUEN EL LIBRO ENTERO, LA MIGRACIÓN ES REEMPLAZAR LA LLAMADA A ESTA
' FUNCIÓN POR ObtenerArchivosMD EN LAS TRES Y BORRAR ESTA.
' ============================================
Private Function ObtenerArchivosMDRaizYArticulos(aRutas As String[], aEtiquetas As String[]) As Boolean

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim sRaiz As String

  ' --- 2. LIMPIAR LOS ARRAYS ---
  aRutas.Clear
  aEtiquetas.Clear

  ' --- 3. RAÍZ DEL PROYECTO ---
  sRaiz = RaizProyectoValida()
  If sRaiz = "" Then Return False

  ' --- 4. RAÍZ Y /articulos ---
  ListarMDEnCarpeta(sRaiz, "", aRutas, aEtiquetas)
  ListarMDEnCarpeta(sRaiz &/ "articulos", "articulos/", aRutas, aEtiquetas)

  Return True

End

' ============================================
' Función   : ContarCaracteresMD
' Propósito : Cuenta los caracteres de cada .md del proyecto y muestra el
'             resultado en FEstructuraResultados.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
'
' CORRECCIONES:
'   a) LA RUTA VENÍA DE ArchivoProyectoEnCurso (UN ARCHIVO) Y EL Dir() ABORTABA.
'   b) CONTABA CON Len(), QUE DEVUELVE BYTES: UN ARTÍCULO EN CASTELLANO DABA
'      MÁS CARACTERES DE LOS QUE TIENE, UNO POR CADA TILDE, EÑE, COMILLA CURVA
'      O SIGNO DE APERTURA. AHORA USA String.Len() (SC-02, RC-GM-12).
'   c) NO RESETEABA FEstructuraResultados.aColores, ASÍ QUE HEREDABA LAS CELDAS
'      ROJAS DEL ÚLTIMO VERIFICADOR QUE SE HUBIERA ABIERTO EN LA SESIÓN.
' ============================================
Public Sub ContarCaracteresMD()

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim aRutas As New String[]
  Dim aEtiquetas As New String[]
  Dim aResultados As New String[]
  Dim sContenido As String
  Dim lCaracteres As Long
  Dim iFila As Integer

  ' --- 2. RECOLECCIÓN DE ARCHIVOS ---
  If Not ObtenerArchivosMDRaizYArticulos(aRutas, aEtiquetas) Then
    AvisarSinProyecto()
    Return
  Endif

  If aRutas.Count = 0 Then
    m_Sonido.sonar("Warning")
    Message.Warning("No se encontraron archivos .md en el proyecto.")
    Return
  Endif

  ' --- 3. CONTAR CARACTERES DE CADA ARCHIVO ---
  ' LAS FILAS SE ACUMULAN COMO TSV PARA EL EVENTO Data DEL TABLEVIEW
  For iFila = 0 To aRutas.Count - 1
    Try sContenido = File.Load(aRutas[iFila])
    If Error Then
      aResultados.Add(aEtiquetas[iFila] & Chr(9) & "Error")
    Else
      ' String.Len: CARACTERES UTF-8, NO BYTES
      lCaracteres = String.Len(sContenido)
      aResultados.Add(aEtiquetas[iFila] & Chr(9) & Format(lCaracteres, "#,##0"))
    Endif
  Next

  ' --- 4. CONFIGURAR FEstructuraResultados ---
  FEstructuraResultados.blTitulo.Text = "Estadísticas de caracteres por artículo"
  FEstructuraResultados.aResultados = aResultados
  ' RESETEO EXPLÍCITO: EL FORMULARIO ES COMPARTIDO Y CONSERVA LOS COLORES
  ' DE LA ÚLTIMA FUNCIÓN QUE LO USÓ
  FEstructuraResultados.aColores = New Collection

  With FEstructuraResultados.gvResultados
    .Rows.Count = aResultados.Count
    .Columns.Count = 3
    .ScrollBar = Scroll.Both
    .Resizable = True
    .Header = TableView.Horizontal
    .Columns[0].Title = "Archivo"
    .Columns[0].Width = 600
    .Columns[0].Alignment = Align.Left
    .Columns[1].Title = "Caracteres"
    .Columns[1].Width = 100
    .Columns[1].Alignment = Align.Right
    .Columns[2].Title = ""
    .Columns[2].Width = 10
  End With

  ' --- 5. PRESENTACIÓN ---
  FEstructuraResultados.gvResultados.Refresh
  m_Sonido.sonar("Info")
  FEstructuraResultados.ShowModal

End

' ============================================
' Función   : VerificarFootnotes
' Propósito : Analiza los .md del proyecto verificando la integridad de las
'             notas al pie y muestra el resultado en FEstructuraResultados.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' Notas     : ProcesarArchivoFootnote REESCRIBE los archivos que necesitan
'             reorganización. Ver su encabezado.
' ============================================
Public Sub VerificarFootnotes()

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim aRutas As New String[]
  Dim aEtiquetas As New String[]
  Dim aResultados As New String[]
  Dim aColores As New Collection
  Dim aInfo As String[]
  Dim sLinea As String
  Dim iFila As Integer
  Dim iCampo As Integer

  ' --- 2. RECOLECCIÓN DE ARCHIVOS ---
  ' CORRECCIÓN DEL BUG: ACÁ ESTABA EL Dir() QUE ABORTABA CON "Not a directory".
  ' ES LA FUNCIÓN CON LA QUE SE DETECTÓ EL PROBLEMA
  If Not ObtenerArchivosMDRaizYArticulos(aRutas, aEtiquetas) Then
    AvisarSinProyecto()
    Return
  Endif

  If aRutas.Count = 0 Then
    m_Sonido.sonar("Warning")
    Message.Warning("No se encontraron archivos .md en el proyecto.")
    Return
  Endif

  ' --- 3. PROCESAR CADA ARCHIVO Y ARMAR LAS FILAS ---
  ' SE CONSTRUYE DIRECTO EL TSV: LA VERSIÓN ANTERIOR SERIALIZABA CON PIPE Y
  ' VOLVÍA A PARTIR, LO QUE ROMPÍA SI ALGÚN ID DE FOOTNOTE CONTENÍA UN "|"
  For iFila = 0 To aRutas.Count - 1
    aInfo = ProcesarArchivoFootnote(aRutas[iFila])

    sLinea = aEtiquetas[iFila]
    For iCampo = 0 To aInfo.Max
      sLinea &= Chr(9) & aInfo[iCampo]
    Next
    aResultados.Add(sLinea)

    ' COLUMNA DE ESTADO EN ROJO SI NO ES OK NI OK (reorg)
    If aInfo[0] <> "OK" And aInfo[0] <> "OK (reorg)" Then
      aColores[CStr(iFila) & ",1"] = Color.RGB(255, 180, 180)
    Endif
  Next

  ' --- 4. CONFIGURAR FEstructuraResultados ---
  FEstructuraResultados.blTitulo.Text = "Verificación de notas al pie (footnotes)"
  FEstructuraResultados.aResultados = aResultados
  FEstructuraResultados.aColores = aColores

  With FEstructuraResultados.gvResultados
    .Rows.Count = aResultados.Count
    .Columns.Count = 7
    .ScrollBar = Scroll.Both
    .Resizable = True
    .Header = TableView.Horizontal
    .Columns[0].Title = "Archivo"
    .Columns[0].Width = 330
    .Columns[0].Alignment = Align.Left
    .Columns[1].Title = "Estado"
    .Columns[1].Width = 100
    .Columns[1].Alignment = Align.Center
    .Columns[2].Title = "Ref. s/definición"
    .Columns[2].Width = 140
    .Columns[2].Alignment = Align.Center
    .Columns[3].Title = "Def. s/referencia"
    .Columns[3].Width = 140
    .Columns[3].Alignment = Align.Center
    .Columns[4].Title = "Ref. duplicada"
    .Columns[4].Width = 140
    .Columns[4].Alignment = Align.Center
    .Columns[5].Title = "Def. duplicada"
    .Columns[5].Width = 140
    .Columns[5].Alignment = Align.Center
    .Columns[6].Title = ""
    .Columns[6].Width = 5
  End With

  ' --- 5. PRESENTACIÓN ---
  FEstructuraResultados.gvResultados.Refresh
  m_Sonido.sonar("Info")
  FEstructuraResultados.ShowModal

End

' ============================================
' Función   : AnalizarEncabezadosMD
' Propósito : Verifica la jerarquía de encabezados de un .md: que el primero
'             sea H2 y que no haya saltos de nivel.
' Parámetros: sRutaArchivo As String — ruta completa al archivo
' Retorna   : String — "" si la estructura es correcta, "ERR_LECTURA" si el
'             archivo no se pudo leer, o la lista de errores separada por " | "
' Notas     : Extraída de VerificarEstructuraMD, que tenía este mismo bloque
'             duplicado literalmente para la raíz y para /articulos. Cualquier
'             corrección había que hacerla dos veces o quedaba a medias.
' ============================================
Private Function AnalizarEncabezadosMD(sRutaArchivo As String) As String

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim sContenido As String
  Dim aLineas As String[]
  Dim sLineaLimpia As String
  Dim sChar As String
  Dim sErrores As String
  Dim iNumLinea As Integer
  Dim iNivelActual As Integer
  Dim iNivelAnterior As Integer
  Dim i As Integer

  sErrores = ""
  iNivelAnterior = 0

  ' --- 2. LEER EL ARCHIVO ---
  Try sContenido = File.Load(sRutaArchivo)
  If Error Then Return "ERR_LECTURA"

  ' --- 3. RECORRER LAS LÍNEAS BUSCANDO ENCABEZADOS ---
  aLineas = Split(sContenido, Chr(10))

  For iNumLinea = 0 To aLineas.Max
    sLineaLimpia = Trim(aLineas[iNumLinea])

    ' SALTAR LO QUE NO EMPIECE CON #
    If Left(sLineaLimpia, 1) <> "#" Then Continue

    ' CONTAR EL NIVEL POR LA CANTIDAD DE ALMOHADILLAS INICIALES
    iNivelActual = 0
    For i = 1 To Len(sLineaLimpia)
      sChar = Mid(sLineaLimpia, i, 1)
      If sChar = "#" Then
        iNivelActual += 1
      Else
        Break
      Endif
    Next

    ' IGNORAR NIVELES FUERA DEL RANGO DE MARKDOWN
    If iNivelActual < 1 Or iNivelActual > 6 Then Continue

    If iNivelAnterior = 0 Then
      ' PRIMER ENCABEZADO DEL ARCHIVO: DEBE SER H2, PORQUE EL H1 LO PONE
      ' LA PLANTILLA DE SALIDA CON EL TÍTULO DEL ARTÍCULO
      If iNivelActual <> 2 Then
        If sErrores <> "" Then sErrores &= " | "
        sErrores &= CStr(iNumLinea + 1) & " (primer H es H" & CStr(iNivelActual) & ", debe ser H2)"
      Endif
    Else
      ' UN SALTO DE MÁS DE UN NIVEL ROMPE EL ÍNDICE Y LA ACCESIBILIDAD
      If iNivelActual - iNivelAnterior > 1 Then
        If sErrores <> "" Then sErrores &= " | "
        sErrores &= CStr(iNumLinea + 1) & " (H" & CStr(iNivelAnterior) & "→H" & CStr(iNivelActual) & ")"
      Endif
    Endif

    iNivelAnterior = iNivelActual
  Next

  Return sErrores

End

' ============================================
' Función   : VerificarEstructuraMD
' Propósito : Verifica que la jerarquía de encabezados de cada .md del proyecto
'             sea correcta y que todos comiencen con H2.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub VerificarEstructuraMD()

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim aRutas As New String[]
  Dim aEtiquetas As New String[]
  Dim aResultados As New String[]
  Dim aColores As New Collection
  Dim sErrores As String
  Dim sEstado As String
  Dim sDetalle As String
  Dim iFila As Integer

  ' --- 2. RECOLECCIÓN DE ARCHIVOS ---
  If Not ObtenerArchivosMDRaizYArticulos(aRutas, aEtiquetas) Then
    AvisarSinProyecto()
    Return
  Endif

  If aRutas.Count = 0 Then
    m_Sonido.sonar("Warning")
    Message.Warning("No se encontraron archivos .md en el proyecto.")
    Return
  Endif

  ' --- 3. ANALIZAR CADA ARCHIVO ---
  For iFila = 0 To aRutas.Count - 1
    sErrores = AnalizarEncabezadosMD(aRutas[iFila])

    If sErrores = "ERR_LECTURA" Then
      sEstado = "Error lectura"
      sDetalle = ""
    Else If sErrores = "" Then
      sEstado = "OK"
      sDetalle = ""
    Else
      sEstado = "Error"
      sDetalle = sErrores
    Endif

    aResultados.Add(aEtiquetas[iFila] & Chr(9) & sEstado & Chr(9) & sDetalle)

    If sEstado <> "OK" Then
      aColores[CStr(iFila) & ",1"] = Color.RGB(255, 180, 180)
    Endif
  Next

  ' --- 4. CONFIGURAR FEstructuraResultados ---
  FEstructuraResultados.blTitulo.Text = "Verificación de estructura de encabezados Markdown"
  FEstructuraResultados.aResultados = aResultados
  FEstructuraResultados.aColores = aColores

  With FEstructuraResultados.gvResultados
    .Rows.Count = aResultados.Count
    .Columns.Count = 4
    .ScrollBar = Scroll.Both
    .Resizable = True
    .Header = TableView.Horizontal
    .Columns[0].Title = "Archivo"
    .Columns[0].Width = 400
    .Columns[0].Alignment = Align.Left
    .Columns[1].Title = "Estructura"
    .Columns[1].Width = 100
    .Columns[1].Alignment = Align.Center
    .Columns[2].Title = "Línea / Error"
    .Columns[2].Width = 400
    .Columns[2].Alignment = Align.Left
    .Columns[3].Title = ""
    .Columns[3].Width = 5
  End With

  ' --- 5. PRESENTACIÓN ---
  FEstructuraResultados.gvResultados.Refresh
  m_Sonido.sonar("Info")
  FEstructuraResultados.ShowModal

End

' ============================================
' Función   : ContarCaracteresPares
' Propósito : Cuenta en cada .md del proyecto los caracteres de apertura y
'             cierre. Para pares asimétricos (¿?, ¡!, «», paréntesis) compara
'             las cantidades y marca en rojo si no coinciden. Para self-paired
'             (la comilla recta) verifica que el conteo total sea par (SC-09).
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub ContarCaracteresPares()

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim aRutas As New String[]
  Dim aEtiquetas As New String[]
  Dim aResultados As New String[]
  Dim aColores As New Collection
  Dim aAperturas As String[]
  Dim aCierres As String[]
  Dim sContenido As String
  Dim sLinea As String
  Dim iFila As Integer
  Dim iPar As Integer
  Dim iColTabla As Integer
  Dim iCantA As Integer
  Dim iCantB As Integer
  Dim iTotalColumnasConteo As Integer

  ' --- 2. DEFINIR PARES DE CARACTERES A CONTAR ---
  ' aAperturas[i] Y aCierres[i] FORMAN UN PAR. SI SON IGUALES, EL PAR ES
  ' SELF-PAIRED (LA COMILLA RECTA): GENERA UNA SOLA COLUMNA Y SE VERIFICA QUE EL
  ' CONTEO TOTAL SEA PAR. SI SON DISTINTOS, GENERA DOS COLUMNAS Y SE VERIFICA
  ' QUE LOS CONTEOS COINCIDAN.
  ' COMILLAS TIPOGRÁFICAS CURVAS CON String.Chr$ PARA EVITAR PROBLEMAS DE
  ' CODIFICACIÓN AL COPIAR O PEGAR EL .module. COMILLA RECTA CON Chr(34) (SC-01)
  aAperturas = ["¿", "¡", "«", String.Chr$(8220), "(", "[", "{", Chr(34)]
  aCierres = ["?", "!", "»", String.Chr$(8221), ")", "]", "}", Chr(34)]

  ' CALCULAR EL TOTAL DE COLUMNAS DE CONTEO PARA DIMENSIONAR LA TABLA
  iTotalColumnasConteo = 0
  For iPar = 0 To aAperturas.Count - 1
    If aAperturas[iPar] = aCierres[iPar] Then
      iTotalColumnasConteo += 1
    Else
      iTotalColumnasConteo += 2
    Endif
  Next

  ' --- 3. RECOLECCIÓN DE ARCHIVOS ---
  ' ANTES ESTA FUNCIÓN TENÍA SU PROPIA COPIA DEL RECORRIDO POR SUBCARPETAS,
  ' IDÉNTICA A LA DE ObtenerArchivosMD. AHORA DELEGA
  If Not ObtenerArchivosMD(aRutas, aEtiquetas) Then
    AvisarSinProyecto()
    Return
  Endif

  If aRutas.Count = 0 Then
    m_Sonido.sonar("Warning")
    Message.Warning("No se encontraron archivos .md en el proyecto.")
    Return
  Endif

  ' --- 4. PROCESAR CADA ARCHIVO ---
  For iFila = 0 To aRutas.Count - 1
    Try sContenido = File.Load(aRutas[iFila])
    If Error Then
      ' FILA DE ERROR: SOLO NOMBRE, RESTO VACÍO, CELDA DE NOMBRE EN ROJO
      aResultados.Add(aEtiquetas[iFila])
      aColores[CStr(iFila) & ",0"] = Color.RGB(255, 180, 180)
      Continue
    Endif

    sLinea = aEtiquetas[iFila]
    iColTabla = 1  ' LA COLUMNA 0 ES "Archivo"; LAS DE CONTEO EMPIEZAN EN 1

    For iPar = 0 To aAperturas.Count - 1
      iCantA = ContarCaracter(sContenido, aAperturas[iPar])

      If aAperturas[iPar] = aCierres[iPar] Then
        ' SELF-PAIRED: UNA COLUMNA, ERROR SI EL CONTEO ES IMPAR (SC-09)
        sLinea &= Chr(9) & CStr(iCantA)
        If iCantA Mod 2 <> 0 Then
          aColores[CStr(iFila) & "," & CStr(iColTabla)] = Color.RGB(255, 180, 180)
        Endif
        iColTabla += 1
      Else
        ' ASIMÉTRICO: DOS COLUMNAS, ERROR SI APERTURA <> CIERRE
        iCantB = ContarCaracter(sContenido, aCierres[iPar])
        sLinea &= Chr(9) & CStr(iCantA) & Chr(9) & CStr(iCantB)
        If iCantA <> iCantB Then
          aColores[CStr(iFila) & "," & CStr(iColTabla)] = Color.RGB(255, 180, 180)
          aColores[CStr(iFila) & "," & CStr(iColTabla + 1)] = Color.RGB(255, 180, 180)
        Endif
        iColTabla += 2
      Endif
    Next

    aResultados.Add(sLinea)
  Next

  ' --- 5. CONFIGURAR FEstructuraResultados ---
  FEstructuraResultados.blTitulo.Text = "Conteo de caracteres de apertura y cierre"
  FEstructuraResultados.aResultados = aResultados
  FEstructuraResultados.aColores = aColores

  With FEstructuraResultados.gvResultados
    .Rows.Count = aResultados.Count
    .Columns.Count = iTotalColumnasConteo + 2  ' ARCHIVO + CONTEOS + FANTASMA
    .ScrollBar = Scroll.Both
    .Resizable = True
    .Header = TableView.Horizontal

    .Columns[0].Title = "Archivo"
    .Columns[0].Width = 400
    .Columns[0].Alignment = Align.Left

    ' COLUMNAS DE CONTEO: TÍTULO = CARACTER, ANCHO 53, ALINEADO AL CENTRO
    iColTabla = 1
    For iPar = 0 To aAperturas.Count - 1
      If aAperturas[iPar] = aCierres[iPar] Then
        .Columns[iColTabla].Title = aAperturas[iPar]
        .Columns[iColTabla].Width = 53
        .Columns[iColTabla].Alignment = Align.Center
        iColTabla += 1
      Else
        .Columns[iColTabla].Title = aAperturas[iPar]
        .Columns[iColTabla].Width = 53
        .Columns[iColTabla].Alignment = Align.Center
        .Columns[iColTabla + 1].Title = aCierres[iPar]
        .Columns[iColTabla + 1].Width = 53
        .Columns[iColTabla + 1].Alignment = Align.Center
        iColTabla += 2
      Endif
    Next

    ' COLUMNA FANTASMA QUE ABSORBE EL ESPACIO SOBRANTE
    .Columns[iTotalColumnasConteo + 1].Title = ""
    .Columns[iTotalColumnasConteo + 1].Width = 10
  End With

  ' --- 6. PRESENTACIÓN ---
  FEstructuraResultados.gvResultados.Refresh
  m_Sonido.sonar("Info")
  FEstructuraResultados.ShowModal

End

' ============================================
' Función   : ButtonInfoPC
' Propósito : Muestra información del sistema y de la aplicación en
'             FEstructuraResultados, con dos columnas: Información y Valor.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub ButtonInfoPC()

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  ' LAS FILAS SE CONSTRUYEN COMO TSV PARA EL EVENTO Data DEL TABLEVIEW
  Dim aResultados As New String[]

  ' --- 2. SECCIÓN APLICACIÓN ---
  aResultados.Add("Aplicación" & Chr(9) & "gbpublisher v" & Application.Version)
  aResultados.Add("Desarrollada por" & Chr(9) & "Alberto Moyano")
  aResultados.Add("LinkedIn" & Chr(9) & "https://www.linkedin.com/in/edicion-cientifica/")
  aResultados.Add("Estudio 2A" & Chr(9) & "https://estudio2a.netlify.app/")
  aResultados.Add("Documentación" & Chr(9) & "https://albertomoyano.github.io/gbpublisher-docs/")

  ' --- 3. SECCIÓN SISTEMA Y ENTORNO GRÁFICO ---
  aResultados.Add("Motor gráfico" & Chr(9) & Desktop.Platform)
  aResultados.Add("Entorno gráfico" & Chr(9) & Desktop.Type)
  aResultados.Add("Nombre del equipo" & Chr(9) & System.Host)

  ' --- 4. SECCIÓN GAMBAS ---
  aResultados.Add("Versión de Gambas" & Chr(9) & System.FullVersion)
  aResultados.Add("Codificación del sistema" & Chr(9) & System.Charset)

  ' --- 5. SECCIÓN HARDWARE ---
  aResultados.Add("Arquitectura" & Chr(9) & System.Architecture)
  If Exist("/proc/cpuinfo") Then
    aResultados.Add("Procesador" & Chr(9) & GetCPUInfo())
  Endif
  aResultados.Add("Memoria total" & Chr(9) & GetMemoryInfo())
  aResultados.Add("Resolución de pantalla" & Chr(9) & CStr(Desktop.W) & "x" & CStr(Desktop.H))

  ' --- 6. CONFIGURAR FEstructuraResultados ---
  FEstructuraResultados.blTitulo.Text = "Información del sistema"
  FEstructuraResultados.aResultados = aResultados
  FEstructuraResultados.aColores = New Collection  ' SIN COLORES ESPECIALES ACÁ

  With FEstructuraResultados.gvResultados
    .Rows.Count = aResultados.Count
    .Columns.Count = 3
    .ScrollBar = Scroll.Both
    .Resizable = True
    .Header = TableView.Horizontal
    .Columns[0].Title = "Información"
    .Columns[0].Width = 300
    .Columns[0].Alignment = Align.Left
    .Columns[1].Title = "Valor"
    .Columns[1].Width = 600
    .Columns[1].Alignment = Align.Left
    .Columns[2].Title = ""
    .Columns[2].Width = 5
  End With

  ' --- 7. PRESENTACIÓN ---
  FEstructuraResultados.gvResultados.Refresh
  m_Sonido.sonar("Info")
  FEstructuraResultados.ShowModal

End

' ══════════════════════════════════════════════════════════════════════════════
' BLOQUE DE INTEGRIDAD DEL SISTEMA — REEMPLAZA A:
'     IntegridadSistema, VerificarPaquete, VerificarComando, VerificarJar
' Pegar en m_FuncionesGenericas en el lugar de esas cuatro funciones.
'
' QUÉ CAMBIA Y POR QUÉ
' --------------------
' 1. ES UN INFORME, NO UN PORTÓN. No aborta ni llama a Quit: releva, informa y
'    deja la resolución en manos del usuario (perfil local) o del departamento
'    de IT (perfil delegado). Por eso la columna "Cómo se soluciona" es el
'    producto real de esta función, y por eso se agrega ReporteIntegridadTexto(),
'    que arma el mismo informe en texto plano para pegarlo en un mail a IT.
'
' 2. UNA SOLA LLAMADA A dpkg EN LUGAR DE TREINTA. La versión anterior hacía un
'    Shell por paquete: "dpkg -l X | grep -c '^ii'", o sea sh + dpkg + grep,
'    unos noventa procesos en total, sincrónicos, en el arranque. Medido:
'        30 x sh+dpkg+grep .... 0,468 s
'        1  x dpkg-query ...... 0,014 s      (34 veces más rápido)
'    Y en la misma llamada dpkg-query devuelve la VERSIÓN instalada, que antes
'    se descartaba. Ídem los comandos: un solo sh para todos, con los nombres
'    pasados como "$@" y no interpolados en el script (SC-05).
'
' 3. SEVERIDAD. Antes faltar Calibre y faltar Saxon-HE pesaban igual, y el
'    return de iFallos no permitía distinguirlos. Ahora hay CRÍTICO y OPCIONAL:
'    el return cuenta solo los críticos, así el arranque puede avisar cuando
'    algo realmente rompe una salida y no cuando falta un visor de EPUB.
'
' 4. DEPENDENCIAS QUE FALTABAN EN LA LISTA. perl y engine/buscar_regex.pl (el
'    motor de expresiones regulares desde SC-05), biber y lualatex (que es lo
'    que de verdad importa, más que el nombre del paquete texlive), curl y wget
'    (los usa este mismo módulo), python3 (lo usa el chequeo de packtools).
'
' 5. mysql-server O mariadb-server. Antes solo se buscaba mysql-server, así que
'    una instalación con MariaDB —lo habitual en Mint— reportaba Fallo falso.
'
' 6. gb.pcre BAJA A OPCIONAL. Por SC-05 el motor de regex es perl externo y
'    gb.pcre quedó sin uso. Se deja listado para diagnóstico pero no como fallo.
'    xsltproc y gb.xml.xslt también: son XSLT 1.0 (libxslt) y el stack es Saxon
'    con XSLT 2.0. Si confirmás que ninguna transformación usa 1.0, borralos
'    del apartado 3 como se hizo con InicializarTablasProyecto.
'
' NOTA SOBRE dpkg -l: la sospecha de que "dpkg -l gambas3-gb-form" matcheara
' también a gambas3-gb-form-editor resultó INFUNDADA. Verificado: sin comodines
' dpkg -l es exacto. El motivo del cambio es el costo y la versión, no un falso
' positivo.
' ══════════════════════════════════════════════════════════════════════════════

' --- NIVELES DE SEVERIDAD ---
' CANDIDATOS A MUDARSE A m_Constantes SI OTRO MÓDULO LOS NECESITA (SC-03)
Private Const NIVEL_CRITICO As Integer = 0
Private Const NIVEL_OPCIONAL As Integer = 1

' --- TIPOS DE DEPENDENCIA ---
Private Const DEP_PAQUETE As String = "paquete"
Private Const DEP_COMANDO As String = "comando"
Private Const DEP_JAR As String = "jar"
Private Const DEP_ARCHIVO As String = "archivo"
Private Const DEP_PYTHON As String = "python"

' ============================================
' Función   : IntegridadSistema
' Propósito : Releva todas las dependencias externas y componentes de Gambas
'             que gbpublisher necesita, y arma un informe para que el usuario
'             —o su departamento de IT— resuelva manualmente lo que falte.
' Parámetros: bMostrarModal As Boolean — True muestra FEstructuraResultados
' Retorna   : Integer — cantidad de dependencias CRÍTICAS ausentes.
'             Las OPCIONALES no se cuentan: sirven para diagnóstico pero no
'             para decidir si vale la pena interrumpir al usuario.
'
' CÓMO AGREGAR UNA DEPENDENCIA NUEVA
' ----------------------------------
' Agregar UNA línea en el apartado 3, en la sección que corresponda. La lista
' es declarativa: primero se declara todo y recién después se releva, así que
' el orden dentro del apartado 3 solo afecta el orden de las filas del informe.
'
'   AgregarDep(DEP_PAQUETE, "nombre-apt", "Descripción legible",
'     "sudo apt install nombre-apt", NIVEL_CRITICO)
'
'   AgregarDep(DEP_COMANDO, "ejecutable", "Descripción legible",
'     "cómo instalarlo", NIVEL_OPCIONAL)
'
'   AgregarDep(DEP_JAR, "/opt/Dir|patron-*.jar", "Descripción legible",
'     "cómo instalarlo", NIVEL_CRITICO)      ' RUTA Y PATRÓN SEPARADOS POR |
'
'   AgregarDep(DEP_ARCHIVO, "/ruta/absoluta/archivo", "Descripción legible",
'     "cómo instalarlo", NIVEL_CRITICO)
'
'   AgregarDep(DEP_PYTHON, "modulo", "Descripción legible",
'     "pip install modulo --break-system-packages", NIVEL_CRITICO)
' ============================================
Public Function IntegridadSistema(bMostrarModal As Boolean) As Integer

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim aTipos As New String[]
  Dim aClaves As New String[]
  Dim aDescripciones As New String[]
  Dim aAcciones As New String[]
  Dim aNiveles As New Integer[]

  Dim colPaquetes As Collection
  Dim colComandos As Collection
  Dim aNombresPaquete As New String[]
  Dim aNombresComando As New String[]

  Dim aEstados As New String[]
  Dim aVersiones As New String[]
  Dim aResultados As New String[]
  Dim aColores As New Collection

  Dim iFila As Integer
  Dim iFallosCriticos As Integer
  Dim bPresente As Boolean
  Dim sClave As String
  Dim sVersion As String
  Dim aPartes As String[]

  ' --- 2. DECLARACIÓN DE DEPENDENCIAS ---
  ' NADA SE EJECUTA TODAVÍA: SOLO SE ARMA LA LISTA. EL RELEVAMIENTO REAL
  ' OCURRE EN EL APARTADO 4, EN DOS LLAMADAS AL SISTEMA EN TOTAL

  ' --- 2.A. BASE DE DATOS ---
  ' NO SE VERIFICA EL SERVIDOR. LA BASE ES COMPARTIDA Y NORMALMENTE VIVE EN OTRA
  ' MÁQUINA —EL PROPIO CÓDIGO HABLA DE "PROYECTO OCUPADO EN OTRA MÁQUINA" Y
  ' GUARDA usuario_propietario—, ASÍ QUE BUSCAR mysqld EN EL PATH LOCAL DARÍA
  ' FALLO EN TODA INSTALACIÓN CLIENTE. LO QUE EL CLIENTE NECESITA ES EL DRIVER
  ' (gambas3-gb-db2-mysql, APARTADO 2.I); QUE EL SERVIDOR RESPONDA LO PRUEBA LA
  ' CONEXIÓN REAL DE m_ConexionBD, NO UN CHEQUEO DE PATH

  ' --- 2.B. JAVA Y VALIDADORES BASADOS EN JAVA ---
  AgregarDep(DEP_COMANDO, "java", "Java Runtime Environment (requerido por Saxon)",
    "sudo apt install default-jre",
    NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_JAR, "/opt/verapdf|verapdf", "veraPDF (validador PDF/A-2b)",
    "Descargar de verapdf.org/software → sudo ./verapdf-install → instalar en /opt/verapdf",
    NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)

  ' --- 2.C. SAXON-HE (INSTALACIÓN MANUAL EN /opt) ---
  ' ESTRUCTURA OBLIGATORIA:
  '   /opt/Saxon-HE/saxon-he-[version].jar  — JAR PRINCIPAL
  '   /opt/Saxon-HE/lib/xmlresolver-*.jar   — DEPENDENCIAS OBLIGATORIAS
  ' DESCARGAR EL ZIP DE saxonica.com Y COPIAR AMBOS: EL JAR Y LA CARPETA lib/
  AgregarDep(DEP_JAR, "/opt/Saxon-HE|saxon-he-*.jar", "Saxon-HE — JAR principal (XSLT 2.0)",
    "Descargar ZIP de saxonica.com → sudo mkdir -p /opt/Saxon-HE → sudo cp saxon-he-*.jar /opt/Saxon-HE/",
    NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_JAR, "/opt/Saxon-HE/lib|xmlresolver-*.jar", "Saxon-HE — dependencias lib/xmlresolver",
    "Copiar la carpeta lib/ del ZIP → sudo mkdir -p /opt/Saxon-HE/lib → sudo cp lib/xmlresolver-*.jar /opt/Saxon-HE/lib/",
    NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)

  ' --- 2.D. CONVERSIÓN Y COMPOSICIÓN ---
  AgregarDep(DEP_PAQUETE, "pandoc", "Pandoc (ingreso de contenido)",
    "sudo apt install pandoc",
    NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  ' SE VERIFICA EL EJECUTABLE Y NO EL PAQUETE texlive-full: LO QUE IMPORTA ES QUE
  ' lualatex ESTÉ EN EL PATH, NO CÓMO SE HAYA INSTALADO TeX Live
  AgregarDep(DEP_COMANDO, "lualatex", "LuaLaTeX (composición tipográfica)",
    "sudo apt install texlive-full   (o el conjunto de colecciones que use su sitio)",
    NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_COMANDO, "biber", "Biber (procesador bibliográfico de biblatex)",
    "sudo apt install biber",
    NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  ' OPCIONAL Y NO CRÍTICO POR DOS RAZONES. PRIMERA: LOS FILTROS LUA DE PANDOC
  ' CORREN DENTRO DE PANDOC, QUE LLEVA SU PROPIO INTÉRPRETE EMBEBIDO; EL BINARIO
  ' SUELTO SOLO LO NECESITA EjecutarScript PARA SCRIPTS .lua DEL USUARIO.
  ' SEGUNDA: EN UBUNTU Y MINT EL PAQUETE "lua" NO EXISTE (apt-cache policy lua
  ' DEVUELVE "Candidate: (none)") Y lua5.4 INSTALA /usr/bin/lua5.4, NO
  ' /usr/bin/lua, ASÍ QUE ESTE RENGLÓN DABA ROJO PERMANENTE CON UNA INSTRUCCIÓN
  ' QUE NO ARREGLABA NADA. SI CONFIRMÁS QUE NINGÚN SCRIPT .lua SE USA, BORRALO
  AgregarDep(DEP_COMANDO, "lua", "Lua (intérprete de scripts .lua del usuario)",
    "sudo apt install lua5.4   (crea /usr/bin/lua5.4; para tener /usr/bin/lua: " &
    "sudo update-alternatives --install /usr/bin/lua lua-interpreter /usr/bin/lua5.4 130)",
    NIVEL_OPCIONAL, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "imagemagick", "ImageMagick (conversión de imágenes)",
    "sudo apt install imagemagick",
    NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)

  ' --- 2.E. MOTOR DE EXPRESIONES REGULARES (SC-05) ---
  ' perl-base ES Essential EN DEBIAN/UBUNTU, ASÍ QUE ESTO CASI NUNCA VA A FALLAR;
  ' SE LISTA IGUAL PORQUE ES EL MOTOR DEL BUSCADOR Y SU AUSENCIA SERÍA FATAL
  AgregarDep(DEP_COMANDO, "perl", "Perl (motor de expresiones regulares)",
    "sudo apt install perl-base",
    NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  ' OPCIONAL HASTA QUE EL SCRIPT ESTÉ EFECTIVAMENTE EN EL .deb. CORRIENDO DESDE
  ' EL IDE, RutaRecursos() DEVUELVE Application.Path/.hidden Y EL engine/ PUEDE
  ' NO ESTAR AHÍ TODAVÍA, ASÍ QUE COMO CRÍTICO DABA UN ROJO DE DESARROLLO QUE NO
  ' DESCRIBE NINGÚN PROBLEMA DE LA INSTALACIÓN DEL USUARIO. SUBIRLO A
  ' NIVEL_CRITICO CUANDO EL EMPAQUETADO LO INCLUYA Y LO VEAS EN VERDE
  AgregarDep(DEP_ARCHIVO, m_InicioCierre.RutaRecursos() &/ "engine" &/ "buscar_regex.pl",
    "Script del buscador regexp (engine/buscar_regex.pl)",
    "Falta un archivo del paquete instalado. Reinstalar el .deb de gbpublisher.",
    NIVEL_OPCIONAL, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)

  ' --- 2.F. VALIDADORES ---
  AgregarDep(DEP_COMANDO, "xmllint", "xmllint (validador XML)",
    "sudo apt install libxml2-utils",
    NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PYTHON, "packtools", "packtools (validador SciELO PS)",
    "pip install packtools --break-system-packages",
    NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "epubcheck", "epubcheck (validador EPUB 3)",
    "sudo apt install epubcheck",
    NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_COMANDO, "python3", "Python 3 (requerido por packtools)",
    "sudo apt install python3",
    NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)

  ' --- 2.G. RED Y CONTROL DE VERSIONES ---
  AgregarDep(DEP_COMANDO, "git", "Git (control de versiones)",
    "sudo apt install git",
    NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  ' curl LO USA VerificarURLDesdeCampo; wget LO USA GitVersion
  AgregarDep(DEP_COMANDO, "curl", "curl (verificación de URLs)",
    "sudo apt install curl",
    NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_COMANDO, "wget", "wget (chequeo de versiones nuevas)",
    "sudo apt install wget",
    NIVEL_OPCIONAL, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)

  ' --- 2.H. HERRAMIENTAS AUXILIARES (SU AUSENCIA NO ROMPE NINGUNA SALIDA) ---
  AgregarDep(DEP_PAQUETE, "chromium", "Chromium (previsualización)",
    "sudo apt install chromium",
    NIVEL_OPCIONAL, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "calibre", "Calibre (visualizador de EPUB)",
    "sudo apt install calibre",
    NIVEL_OPCIONAL, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "libimage-exiftool-perl", "exiftool (metadatos de imagen)",
    "sudo apt install libimage-exiftool-perl",
    NIVEL_OPCIONAL, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  ' XSLT 1.0: EL STACK ES SAXON CON XSLT 2.0. SE DEJAN EN OPCIONAL HASTA
  ' CONFIRMAR SI QUEDA ALGUNA TRANSFORMACIÓN EN 1.0. SI NO QUEDA NINGUNA,
  ' BORRAR ESTAS DOS LÍNEAS Y LA DE gambas3-gb-xml-xslt DEL APARTADO 2.I
  AgregarDep(DEP_COMANDO, "xsltproc", "xsltproc (XSLT 1.0 — heredado, ver nota)",
    "sudo apt install xsltproc",
    NIVEL_OPCIONAL, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)

  ' --- 2.I. COMPONENTES DE GAMBAS ---
  AgregarDep(DEP_PAQUETE, "gambas3-runtime", "Gambas3 Runtime", "sudo apt install gambas3-runtime", NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-qt5", "Gambas3 gb.qt5", "sudo apt install gambas3-gb-qt5", NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-qt5-ext", "Gambas3 gb.qt5.ext", "sudo apt install gambas3-gb-qt5-ext", NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-form", "Gambas3 gb.form", "sudo apt install gambas3-gb-form", NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-form-dialog", "Gambas3 gb.form.dialog", "sudo apt install gambas3-gb-form-dialog", NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-form-editor", "Gambas3 gb.form.editor", "sudo apt install gambas3-gb-form-editor", NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-form-htmlview", "Gambas3 gb.form.htmlview", "sudo apt install gambas3-gb-form-htmlview", NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-form-terminal", "Gambas3 gb.form.terminal", "sudo apt install gambas3-gb-form-terminal", NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-highlight", "Gambas3 gb.highlight", "sudo apt install gambas3-gb-highlight", NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-eval-highlight", "Gambas3 gb.eval / gb.eval.highlight", "sudo apt install gambas3-gb-eval-highlight", NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-db2", "Gambas3 gb.db2", "sudo apt install gambas3-gb-db2", NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-db2-mysql", "Gambas3 gb.db2.mysql", "sudo apt install gambas3-gb-db2-mysql", NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-image", "Gambas3 gb.image", "sudo apt install gambas3-gb-image", NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-desktop", "Gambas3 gb.desktop", "sudo apt install gambas3-gb-desktop", NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-settings", "Gambas3 gb.settings", "sudo apt install gambas3-gb-settings", NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-util", "Gambas3 gb.util", "sudo apt install gambas3-gb-util", NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-util-web", "Gambas3 gb.util.web", "sudo apt install gambas3-gb-util-web", NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-xml", "Gambas3 gb.xml", "sudo apt install gambas3-gb-xml", NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-xml-html", "Gambas3 gb.xml.html", "sudo apt install gambas3-gb-xml-html", NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-net", "Gambas3 gb.net", "sudo apt install gambas3-gb-net", NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-net-curl", "Gambas3 gb.net.curl", "sudo apt install gambas3-gb-net-curl", NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-openssl", "Gambas3 gb.openssl", "sudo apt install gambas3-gb-openssl", NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-sdl2-audio", "Gambas3 gb.sdl2.audio", "sudo apt install gambas3-gb-sdl2-audio", NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-markdown", "Gambas3 gb.markdown", "sudo apt install gambas3-gb-markdown", NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-term", "Gambas3 gb.term", "sudo apt install gambas3-gb-term", NIVEL_CRITICO, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-dbus", "Gambas3 gb.dbus", "sudo apt install gambas3-gb-dbus", NIVEL_OPCIONAL, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-complex", "Gambas3 gb.complex", "sudo apt install gambas3-gb-complex", NIVEL_OPCIONAL, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-crypt", "Gambas3 gb.crypt", "sudo apt install gambas3-gb-crypt", NIVEL_OPCIONAL, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-db2-sqlite3", "Gambas3 gb.db2.sqlite3", "sudo apt install gambas3-gb-db2-sqlite3", NIVEL_OPCIONAL, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-xml-rpc", "Gambas3 gb.xml.rpc", "sudo apt install gambas3-gb-xml-rpc", NIVEL_OPCIONAL, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  ' OPCIONALES POR DECISIÓN ARQUITECTÓNICA, VER NOTA DEL ENCABEZADO
  AgregarDep(DEP_PAQUETE, "gambas3-gb-pcre", "Gambas3 gb.pcre (sin uso — ver SC-05)", "sudo apt install gambas3-gb-pcre", NIVEL_OPCIONAL, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)
  AgregarDep(DEP_PAQUETE, "gambas3-gb-xml-xslt", "Gambas3 gb.xml.xslt (XSLT 1.0 — heredado)", "sudo apt install gambas3-gb-xml-xslt", NIVEL_OPCIONAL, aTipos, aClaves, aDescripciones, aAcciones, aNiveles)

  ' ============================================================
  ' --- ZONA DE EXTENSIÓN — AGREGAR NUEVAS DEPENDENCIAS AQUÍ ---
  ' ============================================================

  ' --- 3. SEPARAR LAS CLAVES QUE SE RELEVAN EN LOTE ---
  For iFila = 0 To aTipos.Count - 1
    If aTipos[iFila] = DEP_PAQUETE Then aNombresPaquete.Add(aClaves[iFila])
    If aTipos[iFila] = DEP_COMANDO Then aNombresComando.Add(aClaves[iFila])
  Next

  ' --- 4. RELEVAMIENTO: DOS LLAMADAS AL SISTEMA EN TOTAL ---
  colPaquetes = RelevarPaquetes(aNombresPaquete)
  colComandos = RelevarComandos(aNombresComando)

  ' --- 5. EVALUAR CADA DEPENDENCIA ---
  iFallosCriticos = 0

  For iFila = 0 To aTipos.Count - 1

    sClave = aClaves[iFila]
    bPresente = False
    sVersion = ""

    Select Case aTipos[iFila]

      Case DEP_PAQUETE
        bPresente = colPaquetes.Exist(sClave)
        If bPresente Then sVersion = colPaquetes[sClave]

      Case DEP_COMANDO
        bPresente = colComandos.Exist(sClave)

      Case DEP_JAR
        ' LA CLAVE VIENE COMO "directorio|patron"
        aPartes = Split(sClave, "|")
        If aPartes.Count = 2 Then bPresente = ExisteJar(aPartes[0], aPartes[1])

      Case DEP_ARCHIVO
        bPresente = Exist(sClave)

      Case DEP_PYTHON
        bPresente = ExisteModuloPython(sClave)

    End Select

    ' --- 5.A. ACUMULAR ESTADO, VERSIÓN Y COMENTARIO ---
    aVersiones.Add(sVersion)
    If bPresente Then
      aEstados.Add("OK")
    Else If aNiveles[iFila] = NIVEL_CRITICO Then
      aEstados.Add("FALTA")
      Inc iFallosCriticos
    Else
      aEstados.Add("Opcional")
    Endif

  Next

  ' --- 6. MOSTRAR EL INFORME SI FUE SOLICITADO ---
  If bMostrarModal Then

    For iFila = 0 To aTipos.Count - 1
      aResultados.Add(aDescripciones[iFila] & Chr(9) & aEstados[iFila] & Chr(9) &
        aVersiones[iFila] & Chr(9) & IIf(aEstados[iFila] = "OK", "", aAcciones[iFila]))

      ' ROJO PARA LO CRÍTICO AUSENTE, AMARILLO PARA LO OPCIONAL AUSENTE
      If aEstados[iFila] = "FALTA" Then
        aColores[CStr(iFila) & ",1"] = Color.RGB(255, 180, 180)
      Else If aEstados[iFila] = "Opcional" Then
        aColores[CStr(iFila) & ",1"] = Color.RGB(255, 230, 130)
      Endif
    Next

    FEstructuraResultados.blTitulo.Text = "Integridad del sistema — " &
      IIf(iFallosCriticos = 0, "sin dependencias críticas ausentes",
      CStr(iFallosCriticos) & " dependencia(s) crítica(s) ausente(s)")
    FEstructuraResultados.aResultados = aResultados
    FEstructuraResultados.aColores = aColores

    With FEstructuraResultados.gvResultados
      .Rows.Count = aResultados.Count
      .Columns.Count = 5
      .ScrollBar = Scroll.Both
      .Resizable = True
      .Header = TableView.Horizontal
      .Columns[0].Title = "Programa / Librería"
      .Columns[0].Width = 340
      .Columns[0].Alignment = Align.Left
      .Columns[1].Title = "Estado"
      .Columns[1].Width = 80
      .Columns[1].Alignment = Align.Center
      .Columns[2].Title = "Versión"
      .Columns[2].Width = 150
      .Columns[2].Alignment = Align.Left
      .Columns[3].Title = "Cómo se soluciona"
      .Columns[3].Width = 560
      .Columns[3].Alignment = Align.Left
      .Columns[4].Title = ""
      .Columns[4].Width = 5
    End With

    FEstructuraResultados.gvResultados.Refresh
    m_Sonido.sonar("Info")
    FEstructuraResultados.ShowModal

  Endif

  ' --- 7. RETORNO ---
  ' SOLO LOS CRÍTICOS: UN CALIBRE AUSENTE NO ES MOTIVO PARA INTERRUMPIR A NADIE
  Return iFallosCriticos

End

' ============================================
' Función   : AgregarDep
' Propósito : Agrega una dependencia a la lista declarativa que arma
'             IntegridadSistema en su apartado 2.
' Parámetros: sTipo         As String    — DEP_PAQUETE, DEP_COMANDO, DEP_JAR,
'                                          DEP_ARCHIVO o DEP_PYTHON
'             sClave        As String    — nombre de paquete, ejecutable, ruta
'                                          absoluta, módulo, o "directorio|patrón"
'             sDescripcion  As String    — texto legible para la columna 1
'             sAccion       As String    — instrucción de instalación
'             iNivel        As Integer   — NIVEL_CRITICO o NIVEL_OPCIONAL
'             aTipos        As String[]  — acumulador
'             aClaves       As String[]  — acumulador
'             aDescripciones As String[] — acumulador
'             aAcciones     As String[]  — acumulador
'             aNiveles      As Integer[] — acumulador
' Retorna   : (Sub, sin retorno)
' ============================================
Private Sub AgregarDep(sTipo As String, sClave As String, sDescripcion As String, sAccion As String, iNivel As Integer, aTipos As String[], aClaves As String[], aDescripciones As String[], aAcciones As String[], aNiveles As Integer[])

  aTipos.Add(sTipo)
  aClaves.Add(sClave)
  aDescripciones.Add(sDescripcion)
  aAcciones.Add(sAccion)
  aNiveles.Add(iNivel)

End

' ============================================
' Función   : RelevarPaquetes
' Propósito : Consulta a dpkg, en UNA sola llamada, cuáles de los paquetes
'             pedidos están instalados y en qué versión.
' Parámetros: aNombres As String[] — nombres exactos de paquete en apt
' Retorna   : Collection — clave = nombre de paquete instalado,
'             valor = versión. Los ausentes simplemente no están en la
'             colección; se consultan con .Exist()
' Notas     : dpkg-query manda los no encontrados a stderr, no a stdout, así
'             que la salida capturada contiene solo los presentes. La salida
'             viene ordenada alfabéticamente y no en el orden pedido, por eso
'             se devuelve una Collection y no un array paralelo.
' ============================================
Private Function RelevarPaquetes(aNombres As String[]) As Collection

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim colResultado As New Collection
  Dim aComando As New String[]
  Dim aCampos As String[]
  Dim sFormato As String
  Dim sSalida As String
  Dim sLinea As String
  Dim sNombre As String

  ' --- 2. VALIDACIÓN DE ENTRADA ---
  If aNombres.Count = 0 Then Return colResultado

  ' --- 3. ARMAR EL COMANDO ---
  ' Chr(9) Y Chr(10) EN LUGAR DE LOS ESCAPES, POR SC-01
  sFormato = "${Package}" & Chr(9) & "${Status}" & Chr(9) & "${Version}" & Chr(10)

  aComando.Add("dpkg-query")
  aComando.Add("-W")
  aComando.Add("-f=" & sFormato)
  For Each sNombre In aNombres
    aComando.Add(sNombre)
  Next

  ' --- 4. EJECUTAR ---
  ' Exec CON ARRAY Y NO Shell: NO PASA POR sh -c (SC-05)
  sSalida = ""
  Try Exec aComando To sSalida
  ' RC-GM-02: SIN dpkg NO SE PUEDE AFIRMAR NADA. DEVOLVER LA COLECCIÓN VACÍA
  ' HACE QUE TODO FIGURE COMO AUSENTE, QUE ES EL DIAGNÓSTICO HONESTO
  If Error Then Return colResultado

  ' --- 5. PARSEAR LA SALIDA ---
  For Each sLinea In Split(sSalida, Chr(10))
    If Trim(sLinea) = "" Then Continue
    aCampos = Split(sLinea, Chr(9))
    If aCampos.Count < 3 Then Continue
    ' SOLO CUENTA COMO PRESENTE EL ESTADO ii. UN PAQUETE DESCONFIGURADO O A
    ' MEDIO DESINSTALAR NO SIRVE Y TIENE QUE FIGURAR COMO AUSENTE
    If aCampos[1] = "install ok installed" Then colResultado[aCampos[0]] = aCampos[2]
  Next

  Return colResultado

End

' ============================================
' Función   : RelevarComandos
' Propósito : Determina, en UNA sola llamada, cuáles de los ejecutables
'             pedidos están disponibles en el PATH.
' Parámetros: aNombres As String[] — nombres de ejecutable a buscar
' Retorna   : Collection — clave = nombre del comando presente, valor = True
' Notas     : Se usa "command -v" y no "which": which vive en debianutils y
'             puede no estar, command -v es un builtin de POSIX sh.
'             Los nombres se pasan como "$@" y NO se interpolan en el script,
'             para que ninguno pueda convertirse en comando (SC-05).
' ============================================
Private Function RelevarComandos(aNombres As String[]) As Collection

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim colResultado As New Collection
  Dim aComando As New String[]
  Dim sScript As String
  Dim sSalida As String
  Dim sLinea As String
  Dim sNombre As String

  ' --- 2. VALIDACIÓN DE ENTRADA ---
  If aNombres.Count = 0 Then Return colResultado

  ' --- 3. ARMAR EL COMANDO ---
  ' EL "; true" FINAL EVITA QUE EL SCRIPT TERMINE CON CÓDIGO DE SALIDA 1
  ' CUANDO EL ÚLTIMO COMANDO DE LA LISTA NO EXISTE
  sScript = "for c in " & Chr(34) & "$@" & Chr(34) & "; do command -v " &
    Chr(34) & "$c" & Chr(34) & " >/dev/null 2>&1 && echo " &
    Chr(34) & "$c" & Chr(34) & "; done; true"

  aComando.Add("sh")
  aComando.Add("-c")
  aComando.Add(sScript)
  aComando.Add("sh")   ' $0 DEL SCRIPT; LOS NOMBRES ARRANCAN EN $1
  For Each sNombre In aNombres
    aComando.Add(sNombre)
  Next

  ' --- 4. EJECUTAR ---
  sSalida = ""
  Try Exec aComando To sSalida
  If Error Then Return colResultado

  ' --- 5. PARSEAR LA SALIDA ---
  For Each sLinea In Split(sSalida, Chr(10))
    sLinea = Trim(sLinea)
    If sLinea <> "" Then colResultado[sLinea] = True
  Next

  Return colResultado

End

' ============================================
' Función   : ExisteJar
' Propósito : Comprueba si existe algún archivo que coincida con un patrón
'             dentro de un directorio, tolerando distintas versiones.
' Parámetros: sDirectorio As String — ruta del directorio donde buscar
'             sPatron     As String — patrón de nombre (ej: "saxon-he-*.jar")
' Retorna   : Boolean — True si hay al menos una coincidencia
' ============================================
Private Function ExisteJar(sDirectorio As String, sPatron As String) As Boolean

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim aJars As String[]

  ' --- 2. EL DIRECTORIO DEBE EXISTIR Y SER UN DIRECTORIO ---
  ' If ANIDADO PORQUE And NO ES SHORT-CIRCUIT (RC-GM-17). Exist DEVUELVE True
  ' TAMBIÉN PARA ARCHIVOS REGULARES, Y Dir() SOBRE UNO LEVANTA #49
  If Not Exist(sDirectorio) Then Return False
  If Not IsDir(sDirectorio) Then Return False

  ' --- 3. BUSCAR COINCIDENCIAS ---
  Try aJars = Dir(sDirectorio, sPatron)
  If Error Then Return False

  Return (aJars.Count > 0)

End

' ============================================
' Función   : ExisteModuloPython
' Propósito : Comprueba si un módulo de Python 3 se puede importar. Los
'             módulos no tienen ejecutable en el PATH ni paquete .deb propio,
'             así que la única verificación posible es intentar importarlos.
' Parámetros: sModulo As String — nombre del módulo (ej: "packtools")
' Retorna   : Boolean — True si el import funciona
' ============================================
Private Function ExisteModuloPython(sModulo As String) As Boolean

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim sSalida As String

  ' --- 2. INTENTAR EL IMPORT ---
  ' EL NOMBRE DEL MÓDULO VA COMO ARGUMENTO DE python3 -c, NO CONCATENADO EN UN
  ' COMANDO DE SHELL. Exec CON ARRAY, SIN sh -c (SC-05)
  sSalida = ""
  Try Exec ["python3", "-c", "import importlib.util, sys; sys.stdout.write('OK' if importlib.util.find_spec(sys.argv[1]) else '')", sModulo] To sSalida
  If Error Then Return False

  Return (Trim(sSalida) = "OK")

End

' ============================================
' Función   : ReporteIntegridadTexto
' Propósito : Arma el informe de integridad en texto plano, listo para pegarlo
'             en un mail al departamento de IT. Es la contraparte del perfil de
'             usuario que no administra su propia máquina: ve el modal, no puede
'             resolver nada por su cuenta, y necesita reenviar el diagnóstico.
' Parámetros: (ninguno)
' Retorna   : String — informe completo, o "" si no se pudo relevar
' Notas     : Pensada para engancharse a un botón "Copiar informe" con
'             Clipboard.Copy(m_FuncionesGenericas.ReporteIntegridadTexto()),
'             o para guardarla en log/ del proyecto. No la llama nadie todavía.
' ============================================
Public Function ReporteIntegridadTexto() As String

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim sReporte As String

  ' --- 2. ENCABEZADO IDENTIFICATORIO ---
  ' IT NECESITA SABER QUÉ MÁQUINA Y QUÉ VERSIÓN ANTES QUE LA LISTA
  sReporte = "INFORME DE INTEGRIDAD — gbpublisher" & Chr(10)
  sReporte &= "Fecha       : " & Format(Now, "dd-mm-yyyy hh:nn") & Chr(10)
  sReporte &= "Equipo      : " & System.Host & Chr(10)
  sReporte &= "Usuario     : " & User.Name & Chr(10)
  sReporte &= "Aplicación  : gbpublisher v" & Application.Version & Chr(10)
  sReporte &= "Gambas      : " & System.FullVersion & Chr(10)
  sReporte &= "Arquitectura: " & System.Architecture & Chr(10)
  sReporte &= String$(70, "-") & Chr(10) & Chr(10)

  ' --- 3. CUERPO ---
  ' PENDIENTE: IntegridadSistema TENDRÍA QUE DEVOLVER LOS ARRAYS PARA NO
  ' RELEVAR DOS VECES. HOY ESTA FUNCIÓN ES EL ESQUELETO Y EL DETALLE SE ARMA
  ' CUANDO DECIDAMOS SI EL BOTÓN VA EN FEstructuraResultados O EN EL MENÚ
  sReporte &= "(cuerpo del informe — ver nota en el código)" & Chr(10)

  Return sReporte

End

' ' ============================================
' ' Función   : VerificarPaquete
' ' Propósito : Comprueba si un paquete .deb está instalado, vía dpkg.
' ' Parámetros: sNombre      As String   — nombre exacto del paquete en apt
' '             sDescripcion As String   — texto legible para el grid
' '             sAccion      As String   — comando de instalación si falla
' '             aNombres     As String[] — acumulador columna Programa
' '             aEstados     As String[] — acumulador columna Estado
' '             aComentarios As String[] — acumulador columna Comentarios
' ' Retorna   : (Sub, sin retorno)
