' ============================================
' Función   : ControlarCarpetas
' Propósito : Garantiza que el proyecto en curso tenga toda la estructura de
'             carpetas que espera el flujo editorial, y crea el .gitignore
'             inicial si el proyecto todavía no tiene uno.
' Parámetros: (ninguno)
' Retorna   : Boolean — True si la estructura quedó completa; False si no hay
'             proyecto abierto o falló la creación de alguna carpeta
'
' CAMBIO: ANTES ERA Sub Y LEÍA RutaProyectoEnCurso SIN VALIDAR. CON LA GLOBAL
' VACÍA, "" &/ "articulos" DEVUELVE "articulos" (RELATIVO) Y EL Mkdir CREABA
' CARPETAS EN EL DIRECTORIO DE TRABAJO DE LA APLICACIÓN. ADEMÁS EL Mkdir IBA
' SIN Try: UN FALLO DE PERMISOS MATABA LA FUNCIÓN Y, CON ELLA, LA APERTURA.
' ============================================
Public Function ControlarCarpetas() As Boolean

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim sRaiz As String
  Dim sDirectorio As String
  Dim aDirectorios As String[]

  ' EL ORDEN IMPORTA: Mkdir NO ES RECURSIVO (DOC OFICIAL, ERROR 45), ASÍ QUE
  ' "salidas" TIENE QUE ESTAR ANTES QUE "salidas/scielo" Y ".github" ANTES
  ' QUE ".github/workflows"
  aDirectorios = ["articulos", "metadatos", "jats", "referencias",
    "front-matter", "back-matter", "docs", "files", "media",
    "correcciones", "originales", "tmp", "latex", "tapa",
    "salidas", "salidas/scielo", "salidas/pdf", "salidas/epub", "salidas/odt",
    ".github", ".github/workflows", "log"]

  ' --- 2. VALIDACIÓN: DEBE HABER PROYECTO ABIERTO ---
  sRaiz = RaizProyectoValida()
  If sRaiz = "" Then Return False

  ' --- 3. CREAR LAS CARPETAS AUSENTES ---
  For Each sDirectorio In aDirectorios
    If Not Exist(sRaiz &/ sDirectorio) Then
      Try Mkdir sRaiz &/ sDirectorio
      ' RC-GM-02: Try NO INTERRUMPE. SIN ESTE CHEQUEO, UNA CARPETA QUE NO SE
      ' PUDO CREAR SE DESCUBRE MUCHO DESPUÉS, AL FALLAR UNA SALIDA
      If Error Then
        m_Sonido.sonar("Error")
        Message.Error("No se pudo crear la carpeta del proyecto:" & Chr(10) &
          sRaiz &/ sDirectorio & Chr(10) & Chr(10) & Error.Text)
        Return False
      Endif
    Endif
  Next

  ' --- 4. CREAR .gitignore SI NO EXISTE ---
  ' SOLO SE IGNORA log/: ES EL REGISTRO LOCAL DE OPERACIONES (REEMPLAZOS REGEX,
  ' COPIAS DE TEMPORALES) Y NO VIAJA AL REMOTO. TODO LO DEMÁS SE VERSIONA,
  ' INCLUIDOS LOS DERIVADOS DE salidas/ Y latex/: LA ÚLTIMA VERSIÓN DE UN PDF O
  ' UN EPUB VIVE EN GIT Y SE PUEDE DESCARGAR SIN RECONSTRUIRLA.
  ' NO SE PISA SI YA EXISTE: UN PROYECTO PUDO HABER AJUSTADO SU .gitignore
  If Not Exist(sRaiz &/ ".gitignore") Then
    Try File.Save(sRaiz &/ ".gitignore", "log/" & Chr(10))
    If Error Then
      m_Sonido.sonar("Warning")
      Message.Warning("No se pudo crear el .gitignore del proyecto:" & Chr(10) & Error.Text)
    Endif
  Endif

  Return True

End

' ============================================
' Función   : CopiarArchivosBase_MD
' Propósito : Copia los archivos base al proyecto Markdown en curso desde los
'             recursos instalados en ~/.gbpublisher. Respeta la lógica de
'             no-sobreescritura para preservar personalizaciones del usuario.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub CopiarArchivosBase_MD()

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim sRaiz As String
  Dim sRecursos As String
  Dim sOrigenWorkflow As String
  Dim sDestinoWorkflow As String

  sRecursos = User.Home &/ ".gbpublisher"

  ' --- 2. VALIDACIÓN: DEBE HABER PROYECTO ABIERTO ---
  sRaiz = RaizProyectoValida()
  If sRaiz = "" Then
    AvisarSinProyecto()
    Return
  Endif

  ' --- 3. CONTROLAR ESTRUCTURA DE CARPETAS ---
  ' ControlarCarpetas YA CREA .github Y .github/workflows, ASÍ QUE EL APARTADO 4
  ' NO NECESITA VOLVER A CREARLOS COMO HACÍA LA VERSIÓN ANTERIOR
  If Not ControlarCarpetas() Then Return

  ' --- 4. ARCHIVOS EN LA RAÍZ DEL PROYECTO ---
  If Not File.RealPath(sRaiz &/ "readme.md") Then
    Try Copy "./readme.md" To sRaiz &/ "readme.md"
  Endif

  ' --- 5. WORKFLOW DE GITHUB ACTIONS ---
  ' SE COPIA SIEMPRE: SI LA INTEGRACIÓN ESTÁ INACTIVA EL ACTION NUNCA SE DISPARA
  ' PORQUE GBPUBLISHER NO GENERA .estado-proyecto.json EN ESE CASO
  sOrigenWorkflow = sRecursos &/ "github" &/ "estado-editorial.yml"
  sDestinoWorkflow = sRaiz &/ ".github" &/ "workflows" &/ "estado-editorial.yml"
  If Exist(sOrigenWorkflow) Then
    If Not Exist(sDestinoWorkflow) Then
      Try Copy sOrigenWorkflow To sDestinoWorkflow
    Endif
  Endif

  ' --- 6. ARCHIVOS EN /media ---
  If Not File.RealPath(sRaiz &/ "media" &/ "desconocido.png") Then
    Try Copy sRecursos &/ "media/desconocido.png" To sRaiz &/ "media" &/ "desconocido.png"
  Endif
  If Not File.RealPath(sRaiz &/ "media" &/ "falta-tapa.png") Then
    Try Copy sRecursos &/ "media/falta-tapa.png" To sRaiz &/ "media" &/ "falta-tapa.png"
  Endif
  If Not File.RealPath(sRaiz &/ "media" &/ "logo-revista.png") Then
    Try Copy sRecursos &/ "media/logo-revista.png" To sRaiz &/ "media" &/ "logo-revista.png"
  Endif
  If Not File.RealPath(sRaiz &/ "media" &/ "logo-cabecera.png") Then
    Try Copy sRecursos &/ "media/logo-cabecera.png" To sRaiz &/ "media" &/ "logo-cabecera.png"
  Endif

End

' ============================================
' Función   : BorrarArchivosAuxiliares
' Propósito : Envía a la terminal embebida un rm de los archivos auxiliares que
'             dejan LaTeX, tex4ht, biber y las conversiones intermedias.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
'
' PELIGRO — REVISAR ANTES DE USAR. EL COMANDO SE EJECUTA EN EL DIRECTORIO ACTUAL
' DE LA TERMINAL, QUE NO ESTÁ GARANTIZADO QUE SEA EL DEL PROYECTO, Y LA LISTA
' INCLUYE PATRONES QUE NO SON AUXILIARES:
'   *.png *.jpg *.svg  → BORRA LAS IMÁGENES DE /media QUE COPIA
'                        CopiarArchivosBase_MD Y LAS ILUSTRACIONES DEL PROYECTO
'   *.lua              → BORRA files/metadata.lua Y files/dkjson.lua
'   *.tex *.conf *.csv → BORRA CONFIGURACIONES Y DATOS DEL PROYECTO
'   *.xml *.html *.epub → BORRA SALIDAS QUE, SEGÚN EL .gitignore QUE CREA
'                        ControlarCarpetas, SE VERSIONAN A PROPÓSITO
' NO SE MODIFICÓ LA LISTA PORQUE ES UNA DECISIÓN EDITORIAL, NO TÉCNICA. LO QUE
' CORRESPONDE ES ACOTAR EL rm A latex/ Y tmp/, O PEDIR CONFIRMACIÓN AL USUARIO
' MOSTRÁNDOLE QUÉ SE VA A BORRAR.
' ============================================
Public Sub BorrarArchivosAuxiliares()

  ' --- 1. ENVIAR EL COMANDO A LA TERMINAL EMBEBIDA ---
  FMain.TerminalViewProyecto.Input("rm -rf *.xmpi *.eledsec* *.*end *.fuse* *.bcf-SAVE-ERROR *.bbl-SAVE-ERROR *.css *.lwarpmkconf *.sidetoc *.conf *.cut *.upa *.upb *.bib.backup *.ndx *.ps *.tex.backup *.csv *.published *.dat *.txt  *.bib.sav *.xml *.html *.xhtml *.opf *.xref *.ncx *.tmp *.4ct *.4tc *.4of *.4ot *.4os *.4oy *.4oo *.4og *.lg *.idv *.acn *.acr *.alg *.glg *.gls *.ist *.bak *.aux *.dvi *.lof *.lot *.bit *.idx *.glo *.bbl *.bcf *.ilg *.toc *.ind *.out *.blg *.fdb_latexmk *.fls *.run.xml *.ida *.idn *.inn *.synctex.gz *.xdy *.opf *.epub *.mobi *.ent *.cfg *.lua *.mk4 *.png *.jpg *.svg *.ttf *.woff *.woff2 temporal.*" & Chr(10))

End

' ============================================
' Función   : GitVersion
' Propósito : Lee un archivo remoto de texto y devuelve el valor de la clave
'             "Version=". Se usa para detectar releases nuevas en GitHub.
' Parámetros: raw As String — URL del archivo crudo a consultar
' Retorna   : String — versión encontrada, o "" si no se pudo determinar
'
' CAMBIO: ANTES USABA Shell CON LA URL INTERPOLADA ENTRE COMILLAS SIMPLES.
' AHORA VA CON Exec Y ARRAY (SC-05): NO PASA POR sh -c Y NO INTERPRETA
' METACARACTERES. EL ARRAY LITERAL EN UNA SOLA LÍNEA.
' ============================================
Public Sub GitVersion(raw As String) As String

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim sSalida As String
  Dim aLineas As String[]
  Dim sLinea As String
  Dim aPartes As String[]
  Dim sVersion As String

  sSalida = ""
  sVersion = ""

  ' --- 2. VALIDACIÓN DE ENTRADA ---
  If Trim(raw) = "" Then Return ""

  ' --- 3. DESCARGA DEL ARCHIVO REMOTO ---
  Try Exec ["wget", "-qO-", raw] To sSalida
  ' RC-GM-02: SIN CONEXIÓN O SIN wget, DEVOLVER "" ES LA RESPUESTA CORRECTA:
  ' "NO PUDE DETERMINAR LA VERSIÓN", QUE NO ES LO MISMO QUE "NO HAY VERSIÓN NUEVA"
  If Error Then Return ""
  If sSalida = "" Then Return ""

  ' --- 4. BUSCAR LA CLAVE Version= ---
  aLineas = Split(sSalida, Chr(10))
  For Each sLinea In aLineas
    If InStr(sLinea, "Version=") Then
      aPartes = Split(sLinea, "=")
      ' SOLO ACEPTAR LA LÍNEA SI LA CLAVE ES EXACTAMENTE "Version", NO UN CAMPO
      ' QUE LA CONTENGA COMO SUFIJO (p. ej. "MinVersion=")
      If aPartes.Count >= 2 Then
        If aPartes[0] = "Version" Then
          sVersion = aPartes[1]
          Break
        Endif
      Endif
    Endif
  Next

  ' --- 5. RETORNO ---
  Return Trim(sVersion)

End

' ============================================
' Función   : CargarComboBoxIP
' Propósito : Llena un ComboBox con las IPs guardadas en ~/.gbpublisher/.ips.txt,
'             una por línea, y preselecciona la primera.
' Parámetros: combo As ComboBox — control a llenar
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub CargarComboBoxIP(combo As ComboBox)

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim sContenido As String
  Dim sLinea As String
  Dim aLineas As String[]

  ' --- 2. VALIDACIÓN DE ENTRADA ---
  combo.Clear()
  If Not Exist(rutaIPs) Then Return

  ' --- 3. LECTURA DEL ARCHIVO ---
  Try sContenido = File.Load(rutaIPs)
  ' RC-GM-02: SIN ESTE CHEQUEO, UN ARCHIVO ILEGIBLE DEJA sContenido VACÍO Y EL
  ' COMBO SIN OPCIONES, SIN QUE NADIE SEPA POR QUÉ
  If Error Then
    m_Sonido.sonar("Warning")
    Message.Warning("No se pudo leer el archivo de IPs:" & Chr(10) &
      rutaIPs & Chr(10) & Chr(10) & Error.Text)
    Return
  Endif

  ' --- 4. NORMALIZAR FINES DE LÍNEA Y PARTIR ---
  ' EL ARCHIVO PUEDE HABER SIDO EDITADO A MANO DESDE OTRO SISTEMA
  sContenido = Replace(sContenido, Chr(13) & Chr(10), Chr(10))
  sContenido = Replace(sContenido, Chr(13), Chr(10))
  aLineas = Split(sContenido, Chr(10))

  ' --- 5. AGREGAR CADA LÍNEA NO VACÍA ---
  For Each sLinea In aLineas
    sLinea = Trim(sLinea)
    If sLinea <> "" Then combo.Add(sLinea)
  Next

  ' --- 6. PRESELECCIONAR LA PRIMERA ---
  ' Index ES MÁS DIRECTO Y MENOS FRÁGIL QUE combo.Text = combo[0].Text
  If combo.Count > 0 Then combo.Index = 0

End

' ============================================
' Función   : EjecutarScript
' Propósito : Ejecuta en la terminal embebida el script seleccionado en el
'             ComboBox, eligiendo el intérprete según la extensión del archivo.
'             Le pasa tres argumentos: la raíz del proyecto, el archivo .md del
'             proyecto y el archivo actualmente seleccionado en el combo de
'             artículos.
' Parámetros: cmbScripts As ComboBox — combo con la lista de scripts, en el
'             formato "descripción [nombre.ext]"
' Retorna   : (Sub, sin retorno)
'
' CONTRATO DE INVOCACIÓN (SIN CAMBIOS RESPECTO DE LA VERSIÓN ANTERIOR):
'   interprete "ruta/al/script" "$1" "$2"
'   $1 = raíz del proyecto        $2 = archivo activo del combo de artículos
'
' INCONSISTENCIA PENDIENTE DE DECISIÓN — NO SE TOCÓ. LA VERSIÓN ANTERIOR
' DECLARABA DOS VARIABLES CON EL MISMO VALOR:
'   Dim rutaProyecto     As String = m_InicioCierre.RutaProyectoEnCurso
'   Dim archivoCompleto  As String = m_InicioCierre.RutaProyectoEnCurso
' Y EL COMENTARIO DE archivoCompleto DECÍA "RUTA COMPLETA DEL ARCHIVO DE
' PROYECTO ACTUAL", QUE HOY SERÍA m_InicioCierre.ArchivoProyectoEnCurso.
' O EL COMENTARIO ESTÁ VIEJO Y $1 SIEMPRE FUE LA CARPETA, O LA ASIGNACIÓN ERA
' UN COPY-PASTE Y LOS SCRIPTS NUNCA RECIBIERON EL .md.
' CAMBIARLO ROMPE LOS SCRIPTS YA ESCRITOS EN ~/.gbpublisher/scripts, ASÍ QUE
' SE MANTIENE EL COMPORTAMIENTO EXACTO. REVISÁ QUÉ ESPERA $1 EN TUS SCRIPTS Y
' DECIDÍ: SI ESPERAN LA CARPETA, BORRAR EL COMENTARIO ENGAÑOSO; SI ESPERAN EL
' ARCHIVO, CAMBIAR LA ASIGNACIÓN A ArchivoProyectoEnCurso.
' ============================================
Public Sub EjecutarScript(cmbScripts As ComboBox)

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim sRutaScript As String
  Dim sExtension As String
  Dim sInterprete As String
  Dim sTextoSeleccionado As String
  Dim sNombreArchivo As String
  Dim sRaiz As String
  Dim sArchivoActivo As String
  Dim sComando As String
  Dim iInicio As Integer
  Dim iFin As Integer

  ' --- 2. VALIDACIÓN DE ENTRADA ---
  If cmbScripts.Index = -1 Then
    m_Sonido.sonar("Warning")
    Message.Warning("Selecciona un script primero.")
    Return
  Endif

  ' ANTES ESTE CHEQUEO ERA "If rutaProyecto = """ Y ESTABA DESPUÉS DE RESOLVER
  ' EL INTÉRPRETE. AHORA VA ARRIBA Y VALIDA ADEMÁS QUE SEA UN DIRECTORIO
  sRaiz = RaizProyectoValida()
  If sRaiz = "" Then
    AvisarSinProyecto()
    Return
  Endif

  ' --- 3. EXTRAER EL NOMBRE DEL ARCHIVO ENTRE CORCHETES ---
  ' EL COMBO GUARDA "descripción [nombre.ext]"; CargarScripts LO ARMA ASÍ
  sTextoSeleccionado = cmbScripts.Text
  iInicio = InStr(sTextoSeleccionado, "[")
  iFin = InStr(sTextoSeleccionado, "]")

  If iInicio = 0 Or iFin <= iInicio Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo determinar el archivo del script.")
    Return
  Endif

  sNombreArchivo = Mid$(sTextoSeleccionado, iInicio + 1, iFin - iInicio - 1)
  sRutaScript = User.Home &/ ".gbpublisher/scripts" &/ sNombreArchivo

  If Not Exist(sRutaScript) Then
    m_Sonido.sonar("Error")
    Message.Error("El script no existe: " & sRutaScript)
    Return
  Endif

  ' --- 4. DETERMINAR EL INTÉRPRETE SEGÚN LA EXTENSIÓN ---
  sExtension = LCase(File.Ext(sNombreArchivo))

  Select Case sExtension
    Case "py"
      sInterprete = "python3"
    Case "lua"
      sInterprete = "lua"
    Case "sh"
      sInterprete = "bash"
    Case "pl"
      sInterprete = "perl"
    Case "r"
      sInterprete = "Rscript"
    Default
      m_Sonido.sonar("Error")
      Message.Error("Tipo de script no soportado: ." & sExtension)
      Return
  End Select

  ' --- 5. CONSTRUIR Y ENVIAR EL COMANDO ---
  ' LOS ARTÍCULOS VIVEN EN articulos/. File.Name TOLERA QUE EL COMBO GUARDE
  ' "articulos/a-foo.md" O "a-foo.md" INDISTINTAMENTE: ES EL MISMO IDIOMA QUE USA
  ' m_EscanerTipografico PARA RESOLVER ESTE MISMO DATO.
  ' SI NO HAY ARTÍCULO SELECCIONADO SE PASA CADENA VACÍA EN LUGAR DE UNA RUTA
  ' INVENTADA: EL SCRIPT PUEDE DECIDIR QUÉ HACER, PERO NO DEBE RECIBIR UNA RUTA
  ' QUE APUNTA A LA CARPETA DEL PROYECTO COMO SI FUERA UN ARCHIVO
  sArchivoActivo = ""
  If Trim(FMain.cmbArticulosRevista.Text) <> "" Then
    sArchivoActivo = sRaiz &/ "articulos" &/ File.Name(FMain.cmbArticulosRevista.Text)
  Endif

  ' NOTA DE SEGURIDAD QUE SIGUE ABIERTA: ESTO VA A LA TERMINAL, O SEA A sh. LAS
  ' COMILLAS DOBLES DE Chr(34) NO PROTEGEN DE $(...) NI DE `...` SI LA RUTA DEL
  ' PROYECTO LOS CONTUVIERA. NO SE PUEDE USAR Exec PORQUE LA SALIDA TIENE QUE
  ' VERSE EN TerminalViewProyecto, QUE ES EL PUNTO DE LA FUNCIÓN. MITIGACIÓN
  ' POSIBLE SI ALGUNA VEZ IMPORTA: RECHAZAR RUTAS DE PROYECTO QUE CONTENGAN
  ' $ ` ; | & CUANDO SE ABRE EL PROYECTO, QUE ES UNA VALIDACIÓN DE UNA LÍNEA

  ' MISMA FORMA Y MISMOS DOS ARGUMENTOS QUE LA VERSIÓN ANTERIOR
  sComando = sInterprete & " " & Chr(34) & sRutaScript & Chr(34) &
    " " & Chr(34) & sRaiz & Chr(34) &
    " " & Chr(34) & sArchivoActivo & Chr(34)

  FMain.TerminalViewProyecto.Input(sComando & Chr(10))

End

' ============================================
' Función   : ValidarCursorInicioLineaVacia
' Propósito : Verifica que el cursor del editor esté en la columna 0 de una
'             línea vacía o compuesta solo por espacios.
' Parámetros: (ninguno)
' Retorna   : Boolean — True si se cumplen ambas condiciones
' Dependencias: FMain.txtEditorProyecto (TextEditor de gb.form.editor)
' ============================================
Public Function ValidarCursorInicioLineaVacia() As Boolean

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim oEditor As TextEditor

  oEditor = FMain.txtEditorProyecto

  ' --- 2. EDITOR VACÍO: ES VÁLIDO ---
  If oEditor.Count = 0 Then Return True

  ' --- 3. EL CURSOR DEBE ESTAR EN COLUMNA 0 ---
  ' If ANIDADO Y NO "Column = 0 And Trim(...)": And NO ES SHORT-CIRCUIT
  ' (RC-GM-17), ASÍ QUE EL ACCESO A oEditor[oEditor.Line] SE EVALUABA SIEMPRE
  ' Y UN Line FUERA DE RANGO CAÍA EN EL Catch MOSTRANDO UN ERROR AL USUARIO
  ' EN LUGAR DE DEVOLVER False LIMPIAMENTE
  If oEditor.Column <> 0 Then Return False

  ' --- 4. LA LÍNEA ACTUAL DEBE ESTAR VACÍA ---
  Return Trim(oEditor[oEditor.Line].Text) = ""

Catch

  m_Sonido.sonar("Error")
  Message.Error("Error al validar posición del cursor: " & Error.Text)
  Return False

End

' ============================================
' Función   : InsertarFechaHoraComentario
' Propósito : Inserta en el editor una marca de comentario Markdown invisible
'             en la salida, con fecha, hora y usuario en curso. Exige que el
'             cursor esté al inicio de una línea vacía.
' Parámetros: tipoComentario As String — INFO, FIXME o ERROR. Por defecto "INFO"
' Retorna   : (Sub, sin retorno)
' Dependencias: FMain.txtEditorProyecto, m_InicioCierre.UsuarioEnCurso
' ============================================
Public Sub InsertarFechaHoraComentario(Optional tipoComentario As String = "INFO")

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim sFechaHora As String
  Dim sNuevaLinea As String
  Dim sUsuario As String

  ' --- 2. VALIDAR POSICIÓN DEL CURSOR ---
  If Not ValidarCursorInicioLineaVacia() Then
    m_Sonido.sonar("Warning")
    Message.Warning("El cursor debe estar al inicio de una línea vacía para insertar el comentario.")
    FMain.txtEditorProyecto.SetFocus()
    Return
  Endif

  ' --- 3. OBTENER USUARIO Y FECHA ---
  ' RC-GM-11 Y RC-GM-16: EL USUARIO SALE DE LA GLOBAL DE SESIÓN, NO DEL TEXTBOX.
  ' FMain.TextBoxUsuario ES DISPLAY Y PUEDE RESETEARSE POR UN EVENTO DE UI,
  ' DEJANDO LA MARCA FIRMADA POR NADIE
  sUsuario = m_InicioCierre.UsuarioEnCurso
  If sUsuario = "" Then sUsuario = "desconocido"

  sFechaHora = Format(Now, "dd-mm-yyyy hh:nn")

  ' --- 4. ARMAR LA MARCA ---
  ' PENDIENTE (SC-03): ESTE LITERAL DEBERÍA VIVIR EN m_Constantes JUNTO A LOS
  ' DEMÁS PLACEHOLDERS, PARA PODER BUSCAR "MARCAS SIN COMPLETAR" CON UN SOLO
  ' PATRÓN Y PARA NO DUPLICARLO SI OTRO EVENTO INSERTA LO MISMO
  sNuevaLinea = "[" & sFechaHora & " " & sUsuario & "]: # (" & tipoComentario & ": esto no será visible)"

  ' --- 5. INSERTAR EN EL EDITOR ---
  ' RC-GM-08: Insert PUEDE FALLAR EN SILENCIO POR ESTADO INTERNO INVÁLIDO
  Try FMain.txtEditorProyecto.Insert(gb.NewLine & gb.NewLine & sNuevaLinea & gb.NewLine)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo insertar el comentario:" & Chr(10) & Error.Text)
    FMain.txtEditorProyecto.SetFocus()
    Return
  Endif

  ' --- 6. RESTAURAR FOCO (RC-GM-07) ---
  FMain.txtEditorProyecto.SetFocus()

End

' ============================================
' Función   : ContarCaracter
' Propósito : Cuenta ocurrencias de un caracter (o secuencia) en un texto.
'             Implementación UTF-8 segura: usa InStr con offset, que es
'             byte-oriented pero correcto en UTF-8 válido porque ningún byte
'             de un caracter multibyte aparece como byte de otro caracter.
' Parámetros: sTexto    As String — texto a recorrer
'             sCaracter As String — caracter (o secuencia) a contar
' Retorna   : Integer — número de ocurrencias encontradas
' Notas     : Len() DELIBERADO, no String.Len(): el avance del offset tiene que
'             ser en BYTES para coincidir con lo que devuelve InStr (RC-GM-12).
' ============================================
Public Function ContarCaracter(sTexto As String, sCaracter As String) As Integer

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim iCuenta As Integer
  Dim iPos As Integer
  Dim iLen As Integer

  ' --- 2. VALIDAR ENTRADA ---
  iLen = Len(sCaracter)
  If iLen = 0 Then Return 0

  ' --- 3. BUSCAR Y CONTAR OCURRENCIAS USANDO InStr CON OFFSET ---
  iCuenta = 0
  iPos = 1
  Do
    iPos = InStr(sTexto, sCaracter, iPos)
    If iPos = 0 Then Break
    Inc iCuenta
    iPos += iLen
  Loop

  Return iCuenta

End

' ============================================
' Función   : ProcesarArchivoFootnote
' Propósito : Analiza un .md verificando la integridad de sus notas al pie y
'             REORGANIZA el archivo moviendo todas las definiciones al final.
' Parámetros: sRutaArchivo As String — ruta completa al archivo .md
' Retorna   : String[] con 5 elementos:
'               [0] estado (OK, OK (reorg), ERROR, Error lectura, Error escritura)
'               [1] referencias sin definición (id y línea)
'               [2] definiciones sin referencia (id y línea)
'               [3] referencias duplicadas (id y líneas)
'               [4] definiciones duplicadas (id y líneas)
'
' ATENCIÓN — ESTA FUNCIÓN ESCRIBE EN DISCO. NO ES SOLO UN VERIFICADOR: SI
' ENCUENTRA DEFINICIONES FUERA DE LUGAR, REESCRIBE EL ARCHIVO SIN PREGUNTAR, Y
' VerificarFootnotes LA CORRE SOBRE TODOS LOS .md DEL PROYECTO DE UNA VEZ.
' EL COMPORTAMIENTO SE MANTIENE INTACTO PORQUE ES UNA DECISIÓN EDITORIAL, PERO
' ES EL CANDIDATO NÚMERO UNO A PEDIR CONFIRMACIÓN O A SEPARARSE EN DOS
' FUNCIONES: UNA QUE VERIFICA Y OTRA QUE REORGANIZA.
' ============================================
Private Function ProcesarArchivoFootnote(sRutaArchivo As String) As String[]

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim sContenidoOriginal As String
  Dim sNuevoContenido As String
  Dim aLineas As String[]
  Dim sLinea As String
  Dim i As Integer

  ' LISTAS DE IDS PARA PODER ITERAR EN ORDEN DE APARICIÓN
  Dim aRefIds As New String[]
  Dim aDefIds As New String[]

  ' COLLECTIONS ID -> STRING CON LOS NÚMEROS DE LÍNEA SEPARADOS POR COMA.
  ' LAS CLAVES SON CASE-SENSITIVE POR DEFECTO (VERIFICADO EN GAMBAS), ASÍ QUE
  ' [^Nota] Y [^nota] SON DOS IDENTIFICADORES DISTINTOS, COMO EN PANDOC
  Dim cRefLineas As New Collection
  Dim cDefLineas As New Collection

  Dim aDefiniciones As New String[]
  Dim aTextoSinDefiniciones As New String[]
  Dim aResultado As New String[5]
  Dim sId As String
  Dim bEnDefinicionMultilinea As Boolean
  Dim bEsLineaDefinicion As Boolean
  Dim bHuboCambios As Boolean
  Dim bHayErrores As Boolean
  Dim sRefSinDef As String
  Dim sDefSinRef As String
  Dim sRefDuplicadas As String
  Dim sDefDuplicadas As String
  Dim sLineasTemp As String
  Dim aLineasTemp As String[]

  aResultado[0] = "OK"
  aResultado[1] = ""
  aResultado[2] = ""
  aResultado[3] = ""
  aResultado[4] = ""

  ' --- 2. LEER EL ARCHIVO ---
  Try sContenidoOriginal = File.Load(sRutaArchivo)
  If Error Then
    aResultado[0] = "Error lectura"
    Return aResultado
  Endif

  ' --- 3. NORMALIZAR PRIMERO, ANALIZAR DESPUÉS ---
  ' EL ORDEN ES LO QUE ARREGLA EL BUG. LA PRIMERA PASADA SOLO SIRVE PARA SEPARAR
  ' CUERPO Y DEFINICIONES Y PODER REARMAR EL ARCHIVO; SUS NÚMEROS DE LÍNEA SE
  ' DESCARTAN. LA SEGUNDA CORRE SOBRE EL CONTENIDO DEFINITIVO Y ES LA QUE
  ' ALIMENTA EL INFORME, ASÍ LAS LÍNEAS QUE SE MUESTRAN SON LAS QUE EL USUARIO
  ' VA A ENCONTRAR AL IR AL EDITOR

  ' --- 3.A. PASADA ESTRUCTURAL SOBRE EL CONTENIDO LEÍDO ---
  EscanearFootnotes(sContenidoOriginal, aTextoSinDefiniciones, aDefiniciones,
    aRefIds, cRefLineas, aDefIds, cDefLineas)

  ' --- 3.B. ARMAR EL CONTENIDO DEFINITIVO ---
  ' SIN DEFINICIONES NO HAY NADA QUE REORGANIZAR Y EL DEFINITIVO ES EL ORIGINAL
  If aDefiniciones.Count = 0 Then
    sNuevoContenido = sContenidoOriginal
  Else
    ' QUITAR LÍNEAS VACÍAS DEL FINAL DEL CUERPO Y DEL INICIO DE LAS DEFINICIONES.
    ' Do + If + Break Y NO While CON And: RC-GM-17. EL CÓDIGO ANTERIOR ERA
    '     While a.Count > 0 And Trim$(a[a.Max]) = ""
    ' Y COMO And NO CORTOCIRCUITA, CUANDO EL ARRAY SE VACÍA SE EVALÚA IGUAL
    ' a[a.Max] CON Max = -1 Y REVIENTA CON "Out of bounds". VERIFICADO EN GAMBAS.
    ' SE DISPARA CON UN .md CUYO CUERPO SEA TODO LÍNEAS EN BLANCO — TÍPICAMENTE
    ' UN ARCHIVO QUE SOLO CONTIENE DEFINICIONES DE NOTAS. TAMPOCO SIRVE "And If":
    ' ESA FORMA SOLO EXISTE EN If, EN UN While DA "Unexpected And"
    Do
      If aTextoSinDefiniciones.Count = 0 Then Break
      If Trim$(aTextoSinDefiniciones[aTextoSinDefiniciones.Max]) <> "" Then Break
      aTextoSinDefiniciones.Remove(aTextoSinDefiniciones.Max)
    Loop

    Do
      If aDefiniciones.Count = 0 Then Break
      If Trim$(aDefiniciones[0]) <> "" Then Break
      aDefiniciones.Remove(0)
    Loop

    ' CUERPO + DOS LÍNEAS VACÍAS + DEFINICIONES
    sNuevoContenido = aTextoSinDefiniciones.Join(Chr(10))
    sNuevoContenido &= Chr(10) & Chr(10)
    sNuevoContenido &= aDefiniciones.Join(Chr(10))
    If Right$(sNuevoContenido, 1) <> Chr(10) Then sNuevoContenido &= Chr(10)
  Endif

  ' --- 3.C. ESCRIBIR SOLO SI EL CONTENIDO CAMBIÓ DE VERDAD ---
  bHuboCambios = (sNuevoContenido <> sContenidoOriginal)

  If bHuboCambios Then
    Try File.Save(sRutaArchivo, sNuevoContenido)
    If Error Then
      aResultado[0] = "Error escritura"
      Return aResultado
    Endif

    ' SI EL ARCHIVO REESCRITO ES EL QUE ESTÁ EN EL EDITOR, REFRESCARLO Y
    ' ACTUALIZAR EL SNAPSHOT: SIN ESTO EL GUARD DE SC-06 CREERÍA QUE HAY
    ' CAMBIOS SIN GUARDAR APENAS SE CAMBIE DE ARCHIVO
    If sRutaArchivo = FMain.sRutaArchivoAbierto Then
      ' RC-GM-08: ASIGNAR .Text PUEDE FALLAR POR ESTADO INTERNO DEL EDITOR
      Try FMain.txtEditorProyecto.Text = sNuevoContenido
      If Error Then
        aResultado[0] = "Error escritura"
        Return aResultado
      Endif
      FMain.sContenidoOriginal = sNuevoContenido
    Endif
  Endif

  ' --- 3.D. PASADA DE ANÁLISIS SOBRE EL CONTENIDO DEFINITIVO ---
  ' SE DESCARTAN LOS ACUMULADORES DE LA PRIMERA PASADA Y SE VUELVE A RECORRER.
  ' EL COSTO ES UN SEGUNDO O(n) SOBRE UN ARCHIVO DE TEXTO, IRRELEVANTE AL LADO
  ' DE HABER TENIDO QUE CALCULAR A MANO CUÁNTAS LÍNEAS SE CORRIÓ CADA MARCA
  aTextoSinDefiniciones = New String[]
  aDefiniciones = New String[]
  aRefIds = New String[]
  aDefIds = New String[]
  cRefLineas = New Collection
  cDefLineas = New Collection

  EscanearFootnotes(sNuevoContenido, aTextoSinDefiniciones, aDefiniciones,
    aRefIds, cRefLineas, aDefIds, cDefLineas)

  ' --- 4. REFERENCIAS SIN DEFINICIÓN ---
  For Each sId In aRefIds
    If Not cDefLineas.Exist(sId) Then
      If sRefSinDef <> "" Then sRefSinDef &= ", "
      sLineasTemp = cRefLineas[sId]
      aLineasTemp = Split(sLineasTemp, ",")
      sRefSinDef &= sId & " (ln " & aLineasTemp[0] & ")"
    Endif
  Next

  ' --- 5. DEFINICIONES SIN REFERENCIA ---
  For Each sId In aDefIds
    If Not cRefLineas.Exist(sId) Then
      If sDefSinRef <> "" Then sDefSinRef &= ", "
      sLineasTemp = cDefLineas[sId]
      aLineasTemp = Split(sLineasTemp, ",")
      sDefSinRef &= sId & " (ln " & aLineasTemp[0] & ")"
    Endif
  Next

  ' --- 6. REFERENCIAS DUPLICADAS ---
  For Each sId In aRefIds
    sLineasTemp = cRefLineas[sId]
    aLineasTemp = Split(sLineasTemp, ",")
    If aLineasTemp.Count > 1 Then
      If sRefDuplicadas <> "" Then sRefDuplicadas &= ", "
      sRefDuplicadas &= sId & " (ln " & sLineasTemp & ")"
    Endif
  Next

  ' --- 7. DEFINICIONES DUPLICADAS ---
  For Each sId In aDefIds
    sLineasTemp = cDefLineas[sId]
    aLineasTemp = Split(sLineasTemp, ",")
    If aLineasTemp.Count > 1 Then
      If sDefDuplicadas <> "" Then sDefDuplicadas &= ", "
      sDefDuplicadas &= sId & " (ln " & sLineasTemp & ")"
    Endif
  Next

  ' --- 8. PREPARAR RESULTADO Y ESTADO FINAL ---
  aResultado[1] = sRefSinDef
  aResultado[2] = sDefSinRef
  aResultado[3] = sRefDuplicadas
  aResultado[4] = sDefDuplicadas

  ' LAS REFERENCIAS DUPLICADAS NO CUENTAN COMO ERROR: PANDOC ADMITE VARIAS
  ' REFERENCIAS A LA MISMA NOTA. SE INFORMAN EN SU COLUMNA PERO NO TIÑEN EL ESTADO
  bHayErrores = (sRefSinDef <> "" Or sDefSinRef <> "" Or sDefDuplicadas <> "")

  If bHayErrores Then
    aResultado[0] = "ERROR"
  Else If bHuboCambios Then
    aResultado[0] = "OK (reorg)"
  Else
    aResultado[0] = "OK"
  Endif

  Return aResultado

End

' ============================================
' Función   : ExtraerDefinicionId
' Propósito : Extrae el identificador de una línea de definición de footnote.
' Parámetros: sLinea As String — línea de texto a analizar
' Retorna   : String — el identificador, o "" si la línea no es una definición
' Notas     : Formato esperado "[^identificador]: texto..."
' ============================================
Private Function ExtraerDefinicionId(sLinea As String) As String

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim iPosCierra As Integer
  Dim sId As String
  Dim sLineaTrim As String

  ' --- 2. LA LÍNEA DEBE EMPEZAR CON [^ ---
  sLineaTrim = LTrim$(sLinea)
  If Left$(sLineaTrim, 2) <> "[^" Then Return ""

  ' --- 3. Y CONTENER EL CIERRE ]: ---
  iPosCierra = InStr(sLineaTrim, "]:")
  If iPosCierra = 0 Then Return ""

  ' --- 4. EXTRAER Y VALIDAR EL IDENTIFICADOR ---
  sId = Mid$(sLineaTrim, 3, iPosCierra - 3)
  If Len(Trim$(sId)) = 0 Then Return ""

  Return Trim$(sId)

End

' ============================================
' Función   : ExtraerReferenciasDeLinea
' Propósito : Busca todas las referencias [^id] de una línea y las acumula en
'             los contenedores que recibe por parámetro.
' Parámetros: sLinea       As String     — línea de texto a analizar
'             iNumLinea    As Integer    — número de línea actual (base 1)
'             aRefIds      As String[]   — OUT: ids en orden de aparición
'             colRefLineas As Collection — OUT: id -> líneas separadas por coma
' Retorna   : (Sub, sin retorno)
' ============================================
Private Sub ExtraerReferenciasDeLinea(sLinea As String, iNumLinea As Integer, aRefIds As String[], colRefLineas As Collection)

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim iPosicion As Integer
  Dim iPosInicio As Integer
  Dim iPosCierre As Integer
  Dim sId As String
  Dim sResto As String

  iPosicion = 1

  ' --- 2. RECORRER TODAS LAS APARICIONES DE [^ EN LA LÍNEA ---
  Do
    iPosInicio = InStr(sLinea, "[^", iPosicion)
    If iPosInicio = 0 Then Break

    iPosCierre = InStr(sLinea, "]", iPosInicio + 2)
    If iPosCierre = 0 Then Break

    sId = Mid$(sLinea, iPosInicio + 2, iPosCierre - iPosInicio - 2)
    sResto = Mid$(sLinea, iPosCierre, 2)

    ' DESCARTAR LAS DEFINICIONES: SI DESPUÉS DEL ] VIENE UN :, NO ES REFERENCIA
    If sResto <> "]:" Then
      sId = Trim$(sId)
      If Len(sId) > 0 Then
        If colRefLineas.Exist(sId) Then
          colRefLineas[sId] = colRefLineas[sId] & "," & CStr(iNumLinea)
        Else
          aRefIds.Add(sId)
          colRefLineas[sId] = CStr(iNumLinea)
        Endif
      Endif
    Endif

    iPosicion = iPosCierre + 1

  Loop

End

' ============================================
' Función   : EscanearFootnotes
' Propósito : Recorre un contenido Markdown separando el cuerpo de las
'             definiciones de nota al pie, y registrando qué identificadores
'             aparecen y en qué líneas.
' Parámetros: sContenido            As String     — texto a recorrer
'             aTextoSinDefiniciones As String[]   — OUT: líneas del cuerpo
'             aDefiniciones         As String[]   — OUT: líneas de definición
'             aRefIds               As String[]   — OUT: ids referenciados, en
'                                                   orden de aparición
'             cRefLineas            As Collection — OUT: id -> líneas, coma
'             aDefIds               As String[]   — OUT: ids definidos, en orden
'             cDefLineas            As Collection — OUT: id -> líneas, coma
' Retorna   : (Sub, sin retorno) — llena los seis acumuladores
' Notas     : Los acumuladores NO se limpian: el llamador los crea nuevos en
'             cada pasada. Los números de línea son base 1 y corresponden a
'             sContenido, así que la pasada que alimenta el informe tiene que
'             hacerse sobre el contenido DEFINITIVO del archivo, no sobre el
'             que se leyó al entrar.
' ============================================
Private Sub EscanearFootnotes(sContenido As String, aTextoSinDefiniciones As String[], aDefiniciones As String[], aRefIds As String[], cRefLineas As Collection, aDefIds As String[], cDefLineas As Collection)

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim aLineas As String[]
  Dim sLinea As String
  Dim sId As String
  Dim i As Integer
  Dim bEnDefinicionMultilinea As Boolean
  Dim bEsLineaDefinicion As Boolean

  aLineas = Split(sContenido, Chr(10))
  bEnDefinicionMultilinea = False

  ' --- 2. RECORRIDO LÍNEA POR LÍNEA ---
  For i = 0 To aLineas.Max
    sLinea = aLineas[i]
    bEsLineaDefinicion = False

    ' DETECTAR INICIO DE DEFINICIÓN: [^identificador]:
    sId = ExtraerDefinicionId(sLinea)

    If sId <> "" Then
      bEsLineaDefinicion = True

      ' REGISTRAR LA DEFINICIÓN CON SU NÚMERO DE LÍNEA
      If cDefLineas.Exist(sId) Then
        cDefLineas[sId] = cDefLineas[sId] & "," & CStr(i + 1)
      Else
        aDefIds.Add(sId)
        cDefLineas[sId] = CStr(i + 1)
      Endif

      aDefiniciones.Add(sLinea)
      bEnDefinicionMultilinea = True

    Else If bEnDefinicionMultilinea Then

      ' UNA DEFINICIÓN CONTINÚA MIENTRAS LAS LÍNEAS VENGAN SANGRADAS CON CUATRO
      ' ESPACIOS O UN TAB. UNA LÍNEA EN BLANCO SOLO LA CONTINÚA SI LA SIGUIENTE
      ' VUELVE A ESTAR SANGRADA: ES EL SEPARADOR DE PÁRRAFOS DE PANDOC
      If Len(sLinea) >= 4 And Left$(sLinea, 4) = "    " Then
        bEsLineaDefinicion = True
        aDefiniciones.Add(sLinea)
      Else If Len(sLinea) >= 1 And Left$(sLinea, 1) = Chr$(9) Then
        bEsLineaDefinicion = True
        aDefiniciones.Add(sLinea)
      Else If Trim$(sLinea) = "" Then
        If i < aLineas.Max Then
          If Len(aLineas[i + 1]) >= 4 And Left$(aLineas[i + 1], 4) = "    " Then
            bEsLineaDefinicion = True
            aDefiniciones.Add(sLinea)
          Else
            bEnDefinicionMultilinea = False
          Endif
        Else
          bEnDefinicionMultilinea = False
        Endif
      Else
        bEnDefinicionMultilinea = False
      Endif
    Endif

    ' LAS LÍNEAS QUE NO SON DEFINICIÓN QUEDAN EN EL CUERPO Y SE LES BUSCAN
    ' REFERENCIAS [^id]
    If Not bEsLineaDefinicion Then
      aTextoSinDefiniciones.Add(sLinea)
      ExtraerReferenciasDeLinea(sLinea, i + 1, aRefIds, cRefLineas)
    Endif

  Next

End

' ============================================
' Función   : EliminarFootnote
' Propósito : Elimina el footnote reference seleccionado en el editor (ej. [^5])
'             junto con su definition y los párrafos sangrados que la continúan.
' Parámetros: (ninguno) — opera sobre FMain.txtEditorProyecto.SelectedText
' Retorna   : (Sub, sin retorno)
' Notas     : No renumera las notas restantes, y no hace falta: el siguiente
'             número lo calcula ObtenerSiguienteNumeroFootnote por máximo y no
'             por conteo (RC-GM-09), así que un hueco no produce colisión.
'
' CORRECCIÓN: LA RECONSTRUCCIÓN DEL TEXTO CONCATENABA CON
'   If Len(sResultado) > 0 Then sResultado &= "\n"
' QUE SE COME LAS LÍNEAS EN BLANCO DEL PRINCIPIO DEL ARCHIVO: MIENTRAS
' sResultado ESTÁ VACÍO NO AGREGA SEPARADOR, ASÍ QUE UN .md QUE EMPIEZA CON
' UNA O MÁS LÍNEAS VACÍAS LAS PERDÍA SILENCIOSAMENTE. AHORA SE ACUMULA EN UN
' String[] Y SE UNE CON Join, QUE PRESERVA LOS VACÍOS.
' ============================================
Public Sub EliminarFootnote()

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim sSeleccion As String
  Dim sTexto As String
  Dim sNumero As String
  Dim sPatronRef As String
  Dim sPatronDef As String
  Dim sLinea As String
  Dim sResultado As String
  Dim aLineas As String[]
  Dim aConservadas As New String[]
  Dim iContador As Integer
  Dim iPos As Integer
  Dim iInicioDef As Integer
  Dim iFinDef As Integer
  Dim iRespuesta As Integer
  Dim i As Integer
  Dim bEnDefinicion As Boolean

  ' --- 2. VALIDAR LA SELECCIÓN ---
  sSeleccion = FMain.txtEditorProyecto.SelectedText

  If Left(sSeleccion, 2) <> "[^" Or Right(sSeleccion, 1) <> "]" Then
    m_Sonido.sonar("Error")
    Message.Error("La selección no es un footnote válido." & Chr(10) &
      "Debe seleccionar un footnote con formato [^N]")
    FMain.txtEditorProyecto.SetFocus()
    Return
  Endif

  sNumero = Mid$(sSeleccion, 3, Len(sSeleccion) - 3)

  If Not IsNumber(sNumero) Then
    m_Sonido.sonar("Error")
    Message.Error("El footnote no contiene un número válido.")
    FMain.txtEditorProyecto.SetFocus()
    Return
  Endif

  ' --- 3. CONTAR CUÁNTAS REFERENCIAS HAY (SIN CONTAR LA DEFINICIÓN) ---
  sTexto = FMain.txtEditorProyecto.Text
  sPatronRef = "[^" & sNumero & "]"
  sPatronDef = "[^" & sNumero & "]:"
  iContador = 0
  iPos = 1

  Do
    iPos = InStr(sTexto, sPatronRef, iPos)
    If iPos = 0 Then Break
    ' SI DESPUÉS DEL ] VIENE UN :, ES LA DEFINICIÓN Y NO CUENTA COMO REFERENCIA
    If Mid$(sTexto, iPos + Len(sPatronRef), 1) <> ":" Then Inc iContador
    iPos += 1
  Loop

  ' VARIAS REFERENCIAS A LA MISMA NOTA: BORRAR UNA SOLA DEJARÍA EL RESTO
  ' HUÉRFANO, ASÍ QUE SE DERIVA AL USUARIO
  If iContador > 1 Then
    m_Sonido.sonar("Warning")
    Message.Warning("El footnote " & sPatronRef & " aparece " & CStr(iContador) & " veces en el documento." & Chr(10) &
      "Debe resolver manualmente las múltiples referencias antes de eliminar.")
    FMain.txtEditorProyecto.SetFocus()
    Return
  Endif

  ' --- 4. LOCALIZAR LA DEFINICIÓN Y SU EXTENSIÓN ---
  aLineas = Split(sTexto, Chr(10))
  iInicioDef = -1
  iFinDef = -1
  bEnDefinicion = False

  For i = 0 To aLineas.Max
    sLinea = aLineas[i]

    If bEnDefinicion Then
      If Len(sLinea) = 0 Then
        ' LÍNEA EN BLANCO: SOLO CONTINÚA LA DEFINICIÓN SI LA SIGUIENTE SANGRA
        If i < aLineas.Max Then
          If Left(aLineas[i + 1], 4) = "    " Then Continue
        Endif
        iFinDef = i - 1
        Break
      Else If Left(sLinea, 2) = "[^" And InStr(sLinea, "]:") > 0 Then
        ' EMPIEZA OTRA DEFINICIÓN: LA ACTUAL TERMINÓ
        iFinDef = i - 1
        Break
      Else If Left(sLinea, 4) <> "    " And Len(Trim(sLinea)) > 0 Then
        ' TEXTO SIN SANGRÍA: LA DEFINICIÓN TERMINÓ
        iFinDef = i - 1
        Break
      Endif
    Else
      If Left(sLinea, Len(sPatronDef)) = sPatronDef Then
        iInicioDef = i
        bEnDefinicion = True
      Endif
    Endif
  Next

  ' LA DEFINICIÓN LLEGA HASTA EL FINAL DEL ARCHIVO
  If bEnDefinicion And iFinDef = -1 Then iFinDef = aLineas.Max

  ' --- 5. FOOTNOTE HUÉRFANO: SOLO SE BORRA LA REFERENCIA ---
  If iInicioDef = -1 Then
    m_Sonido.sonar("Question")
    iRespuesta = Message.Question("El footnote " & sPatronRef & " no tiene definition." & Chr(10) &
      "¿Eliminar la referencia de todas formas?", "Sí", "No")
    If iRespuesta = 1 Then
      sTexto = Replace(sTexto, sSeleccion, "")
      AplicarTextoAlEditor(sTexto)
    Endif
    FMain.txtEditorProyecto.SetFocus()
    Return
  Endif

  ' --- 6. CONFIRMAR LA ELIMINACIÓN ---
  m_Sonido.sonar("Question")
  iRespuesta = Message.Question("¿Eliminar el footnote " & sPatronRef & " y su definition?", "Sí", "No")
  If iRespuesta <> 1 Then
    FMain.txtEditorProyecto.SetFocus()
    Return
  Endif

  ' --- 7. RECONSTRUIR EL TEXTO SIN LAS LÍNEAS DE LA DEFINICIÓN ---
  ' Join Y NO CONCATENACIÓN CONDICIONAL: PRESERVA LAS LÍNEAS VACÍAS INICIALES
  For i = 0 To aLineas.Max
    If i < iInicioDef Or i > iFinDef Then aConservadas.Add(aLineas[i])
  Next

  sResultado = aConservadas.Join(Chr(10))

  ' --- 8. ELIMINAR LA REFERENCIA Y VOLCAR AL EDITOR ---
  sResultado = Replace(sResultado, sSeleccion, "")
  AplicarTextoAlEditor(sResultado)

  ' --- 9. RESTAURAR FOCO (RC-GM-07) ---
  FMain.txtEditorProyecto.SetFocus()

End

' ============================================
' Función   : AplicarTextoAlEditor
' Propósito : Vuelca un texto completo en el editor de proyecto informando el
'             fallo si la asignación no prospera. Centraliza el patrón que
'             EliminarFootnote repetía en dos ramas sin protección.
' Parámetros: sTexto As String — contenido nuevo del editor
' Retorna   : Boolean — True si se pudo asignar
' Notas     : NO actualiza FMain.sContenidoOriginal a propósito. El texto queda
'             modificado y sin guardar, que es justo lo que el guard de SC-06
'             tiene que detectar cuando el usuario cambie de archivo.
' ============================================
Private Function AplicarTextoAlEditor(sTexto As String) As Boolean

  ' --- 1. ASIGNAR CON PROTECCIÓN (RC-GM-08) ---
  Try FMain.txtEditorProyecto.Text = sTexto
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo actualizar el editor:" & Chr(10) & Error.Text)
    Return False
  Endif

  Return True

End

' ============================================
' Función   : MostrarAyuda
' Propósito : Muestra la ayuda contextual del control activo, delegando en
'             FAyudas la selección del idioma.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub MostrarAyuda()

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim oControl As Object
  Dim sNombreControl As String
  Dim hResult As Result
  Dim fAyuda As New FAyudas

  ' --- 2. OBTENER EL CONTROL ACTIVO ---
  oControl = Application.ActiveControl
  If IsNull(oControl) Then Return

  sNombreControl = oControl.Name
  If sNombreControl = "" Then Return

  ' --- 3. CONSULTA A BASE DE DATOS ---
  ' Try EXPLÍCITO (RC-GM-02): SIN ÉL UN FALLO DE SQL SE PROPAGA HACIA ARRIBA
  Try hResult = m_ConexionBD.mConn.Exec("SELECT COUNT(*) AS total FROM manual_ayudas WHERE componente = &1", sNombreControl)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo consultar la ayuda:" & Chr(10) & Error.Text)
    Return
  Endif

  ' --- 4. VERIFICAR QUE HAY AYUDA PARA ESTE COMPONENTE ---
  ' If ANIDADO Y NO "Not hResult.Available Or hResult!total = 0": Or NO ES
  ' SHORT-CIRCUIT (RC-GM-17), ASÍ QUE CON EL Result NO DISPONIBLE SE EVALUABA
  ' IGUAL hResult!total Y REVENTABA
  If Not hResult.Available Then
    m_Sonido.sonar("Info")
    Message.Info("No hay ayuda disponible para este campo.")
    Return
  Endif

  If hResult!total = 0 Then
    m_Sonido.sonar("Info")
    Message.Info("No hay ayuda disponible para este campo.")
    Return
  Endif

  ' --- 5. DELEGAR EN FAyudas ---
  ' NO SE PASA TEXTO: FAyudas BUSCA SEGÚN EL IDIOMA DEL SISTEMA
  fAyuda.MostrarTexto(sNombreControl)
  fAyuda.ShowModal()

End

' ============================================
' Función   : GetCPUInfo
' Propósito : Lee el modelo de procesador desde /proc/cpuinfo.
' Parámetros: (ninguno)
' Retorna   : String — modelo del procesador, o un texto de diagnóstico
' ============================================
Private Function GetCPUInfo() As String

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim sResult As String
  Dim hFile As File
  Dim sLine As String
  Dim asParts As String[]

  sResult = "No disponible"

  ' --- 2. ABRIR EL ARCHIVO ---
  Try hFile = Open "/proc/cpuinfo" For Input
  If Error Then Return "Error al leer información del CPU"

  ' --- 3. BUSCAR LA PRIMERA LÍNEA "model name" ---
  While Not Eof(hFile)
    Line Input #hFile, sLine
    If sLine Begins "model name" Then
      asParts = Split(sLine, ":")
      If asParts.Count >= 2 Then sResult = Trim(asParts[1])
      Break
    Endif
  Wend

  ' --- 4. CERRAR Y RETORNAR ---
  Try Close #hFile

  Return sResult

End

' ============================================
' Función   : GetMemoryInfo
' Propósito : Lee la memoria total del sistema desde /proc/meminfo.
' Parámetros: (ninguno)
' Retorna   : String — memoria total en MB, o un texto de diagnóstico
' ============================================
Private Function GetMemoryInfo() As String

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim sResult As String
  Dim hFile As File
  Dim sLine As String
  Dim lMemTotal As Long
  Dim asParts As String[]
  Dim sMemValue As String

  sResult = "No disponible"

  ' --- 2. ABRIR EL ARCHIVO ---
  Try hFile = Open "/proc/meminfo" For Input
  If Error Then Return "Error al leer información de memoria"

  ' --- 3. BUSCAR LA LÍNEA MemTotal ---
  While Not Eof(hFile)
    Line Input #hFile, sLine
    If sLine Begins "MemTotal:" Then
      asParts = Split(sLine, ":")
      If asParts.Count >= 2 Then
        sMemValue = Trim(asParts[1])
        sMemValue = Replace(sMemValue, " kB", "")
        sMemValue = Replace(sMemValue, "kB", "")
        lMemTotal = Val(sMemValue) \ 1024
        sResult = CStr(lMemTotal) & " MB"
      Endif
      Break
    Endif
  Wend

  ' --- 4. CERRAR Y RETORNAR ---
  Try Close #hFile

  Return sResult

End

