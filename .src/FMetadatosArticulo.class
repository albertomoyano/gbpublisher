' ============================================
' Función   : ArmarIdiomasTraduccion
' Propósito : Llena el selector de traducción: los idiomas de la revista menos
'             el principal del artículo, más los que ya tienen traducción
'             aunque la revista no los declare (para que no queden ocultos).
'             Muestra el preferido si está en la lista; si no, el primero
' Parámetros: sPreferido As String — idioma a dejar a la vista ("" = el primero)
' Retorna   : nada
' ============================================
Private Sub ArmarIdiomasTraduccion(sPreferido As String)

  Dim aLista As New String[]
  Dim sIdioma As String
  Dim sTexto As String
  Dim sPrincipal As String
  Dim bCargandoAntes As Boolean
  Dim iIndice As Integer

  ' --- 1. INICIALIZACIÓN: LOS Click DEL COMBO NO DEBEN ACTUAR MIENTRAS SE ARMA ---
  bCargandoAntes = $bCargando
  $bCargando = True
  If cmbIdiomaArticulo.Index >= 0 Then sPrincipal = cmbIdiomaArticulo.Text

  ' --- 2. IDIOMAS DE LA REVISTA, SIN EL PRINCIPAL ---
  For Each sIdioma In $aIdiomasRevista
    If sIdioma <> sPrincipal Then aLista.Add(sIdioma)
  Next

  ' --- 3. TRADUCCIONES EN IDIOMAS QUE LA REVISTA NO DECLARA ---
  For Each sTexto In $cTitulosTrad
    sIdioma = $cTitulosTrad.Key
    If sIdioma <> sPrincipal And aLista.Find(sIdioma) < 0 Then aLista.Add(sIdioma)
  Next
  For Each sTexto In $cSubtitulosTrad
    sIdioma = $cSubtitulosTrad.Key
    If sIdioma <> sPrincipal And aLista.Find(sIdioma) < 0 Then aLista.Add(sIdioma)
  Next

  ' --- 4. SELECTOR Y CAMPOS ---
  cmbIdiomaTradArticulo.List = aLista
  If aLista.Count = 0 Then
    ' REVISTA DE UN SOLO IDIOMA: NO HAY A QUÉ TRADUCIR
    $sIdiomaTrad = ""
    txtTituloTradArticulo.Placeholder = "La revista no declara otros idiomas de publicación"
  Else
    iIndice = aLista.Find(sPreferido)
    If iIndice < 0 Then iIndice = 0
    cmbIdiomaTradArticulo.Index = iIndice
    $sIdiomaTrad = aLista[iIndice]
    txtTituloTradArticulo.Placeholder = "trans-title"
  Endif
  hbxTituloTradArticulo.Enabled = (aLista.Count > 0)
  hbxSubtituloTradArticulo.Enabled = (aLista.Count > 0)
  MostrarTraduccion()

  ' --- 5. LIMPIEZA ---
  $bCargando = bCargandoAntes

End

' ============================================
' Función   : MostrarTraduccion
' Propósito : Pone en los campos el título y el subtítulo del idioma a la vista
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub MostrarTraduccion()

  ' UNA CLAVE AUSENTE SE LEE Null, QUE VA AL CAMPO COMO VACÍO (GV-68)
  If $sIdiomaTrad = "" Then
    txtTituloTradArticulo.Text = ""
    txtSubtituloTradArticulo.Text = ""
    Return
  Endif
  txtTituloTradArticulo.Text = $cTitulosTrad[$sIdiomaTrad]
  txtSubtituloTradArticulo.Text = $cSubtitulosTrad[$sIdiomaTrad]

End

' ============================================
' Función   : GuardarTraduccionEnMemoria
' Propósito : Pasa lo escrito al idioma a la vista. Un campo vacío borra la
'             clave (GV-68), que es justo «sin traducción»
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub GuardarTraduccionEnMemoria()

  If $sIdiomaTrad = "" Then Return
  $cTitulosTrad[$sIdiomaTrad] = Trim(txtTituloTradArticulo.Text)
  $cSubtitulosTrad[$sIdiomaTrad] = Trim(txtSubtituloTradArticulo.Text)

End

' ============================================
' Función   : cmbIdiomaTradArticulo_Click
' Propósito : Cambio de idioma de traducción: guarda en memoria lo escrito y
'             muestra el otro
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub cmbIdiomaTradArticulo_Click()

  If $bCargando Then Return
  GuardarTraduccionEnMemoria()
  $sIdiomaTrad = cmbIdiomaTradArticulo.Text
  MostrarTraduccion()

End

' ============================================
' Función   : cmbIdiomaArticulo_Click
' Propósito : Cambio del idioma principal: el selector de traducción deja de
'             ofrecerlo. Una traducción ya escrita en ese idioma queda en
'             memoria; si se guarda así, se borra (el título en el idioma
'             principal es articulo.titulo). Vuelve si se elige otro principal
'             antes de guardar
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub cmbIdiomaArticulo_Click()

  Dim sPrincipal As String

  ' --- 1. LO ESCRITO PASA A MEMORIA ANTES DE REARMAR LA LISTA ---
  If $bCargando Then Return
  If $iFila < 0 Then Return
  GuardarTraduccionEnMemoria()
  sPrincipal = cmbIdiomaArticulo.Text

  ' --- 2. AVISO: EL TÍTULO EN EL IDIOMA PRINCIPAL ES articulo.titulo ---
  If $cTitulosTrad.Exist(sPrincipal) Or $cSubtitulosTrad.Exist(sPrincipal) Then
    m_Sonido.sonar("Warning")
    Message.Warning("Hay una traducción del título en «" & sPrincipal & "», que ahora es el idioma principal." & gb.NewLine & "Si guarda así, esa traducción se borra. Para conservarla, vuelva al idioma principal anterior antes de guardar.")
  Endif

  ' --- 3. LISTAS NUEVAS, CONSERVANDO EL IDIOMA A LA VISTA SI SIGUE ---
  ArmarIdiomasTraduccion($sIdiomaTrad)
  ' EN TEXTOS EL PRINCIPAL ENCABEZA LA LISTA Y DECIDE abstract / trans-abstract
  GuardarTextosEnMemoria()
  ArmarIdiomasTextos($sIdiomaTextos)
  ' DECLARACIONES: EL MISMO CRITERIO DE LISTA
  GuardarDeclaracionEnMemoria()
  ArmarIdiomasDeclaracion($sIdiomaDecl)

End

' ============================================
' Función   : RedibujarContribuyentes
' Propósito : Llena la grilla desde $aContribuyentes, que es la fuente: así
'             la grilla y la lista no se desalinean nunca
' Parámetros: iElegido As Integer — fila a dejar elegida; -1 ninguna
' Retorna   : nada
' ============================================
Private Sub RedibujarContribuyentes(iElegido As Integer)

  Dim oContribuyente As CContribuyente
  Dim sAfiliacion As String
  Dim i As Integer

  gvContribuyentes.Rows.Count = $aContribuyentes.Count
  For i = 0 To $aContribuyentes.Count - 1
    oContribuyente = $aContribuyentes[i]
    gvContribuyentes[i, 0].Text = CStr(i + 1)
    If oContribuyente.iIdAutor > 0 Then
      gvContribuyentes[i, 1].Text = oContribuyente.sNombre
    Else
      gvContribuyentes[i, 1].Text = oContribuyente.sNombre & "  (colectivo)"
    Endif
    gvContribuyentes[i, 2].Text = m_Articulo.LeyendaRolContribuyente(oContribuyente.sRol)
    gvContribuyentes[i, 3].Text = If(oContribuyente.bCorrespondencia, oContribuyente.sEmail, "")
    ' LA PRIMERA AFILIACIÓN, Y CUÁNTAS MÁS HAY
    sAfiliacion = ""
    If oContribuyente.aInstituciones.Count > 0 Then
      sAfiliacion = oContribuyente.aInstituciones[0]
      If oContribuyente.aInstituciones.Count > 1 Then sAfiliacion &= "  (+" & CStr(oContribuyente.aInstituciones.Count - 1) & ")"
    Endif
    gvContribuyentes[i, 4].Text = sAfiliacion
  Next
  If iElegido >= 0 And iElegido < $aContribuyentes.Count Then gvContribuyentes.Row = iElegido

End

' ============================================
' Función   : EditarContribuyente
' Propósito : Abre el diálogo sobre una copia del contribuyente; si se acepta,
'             la copia reemplaza al original
' Parámetros: iFila As Integer — posición en la lista
' Retorna   : Boolean — True si se aceptaron cambios
' ============================================
Private Function EditarContribuyente(iFila As Integer) As Boolean

  Dim oCopia As CContribuyente

  If iFila < 0 Or iFila >= $aContribuyentes.Count Then Return False

  ' LA REFERENCIA A LA COPIA QUEDA ACÁ: LA INSTANCIA DEL DIÁLOGO SE DESTRUYE
  ' AL CERRARSE (VER Uso EN FContribuyenteArticulo)
  oCopia = $aContribuyentes[iFila].Copia()
  FContribuyenteArticulo.oContribuyente = oCopia
  FContribuyenteArticulo.bSoloLectura = $bSoloLectura
  If FContribuyenteArticulo.ShowModal() <> 1 Then Return False

  $aContribuyentes[iFila] = oCopia
  RedibujarContribuyentes(iFila)
  Return True

End

' ============================================
' Función   : btnPersonaContribuyente_Click
' Propósito : Elige una persona en FAutores, la agrega al final con su
'             afiliación propuesta y abre el diálogo. Si se cierra sin
'             aceptar, no queda agregada
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnPersonaContribuyente_Click()

  Dim oNuevo As CContribuyente
  Dim iIdAutor As Integer
  Dim i As Integer

  ' --- 1. ELECCIÓN: FAutores DEVUELVE EL id POR MÓDULO (RC-GM-13) ---
  If $iFila < 0 Then Return
  m_FuncionesGenericas.iAutorSeleccionadoEnFAutores = 0
  FAutores.ShowModal()
  iIdAutor = m_FuncionesGenericas.iAutorSeleccionadoEnFAutores
  If iIdAutor <= 0 Then Return

  ' --- 2. SIN REPETIDOS: UNA PERSONA FIGURA UNA SOLA VEZ ---
  For i = 0 To $aContribuyentes.Count - 1
    If $aContribuyentes[i].iIdAutor = iIdAutor Then
      m_Sonido.sonar("Warning")
      Message.Warning("Esa persona ya está entre los contribuyentes.")
      Return
    Endif
  Next

  ' --- 3. ALTA PROVISORIA Y DIÁLOGO ---
  oNuevo = m_Articulo.NuevaPersona(iIdAutor)
  If Not oNuevo Then Return
  $aContribuyentes.Add(oNuevo)
  If Not EditarContribuyente($aContribuyentes.Count - 1) Then $aContribuyentes.Remove($aContribuyentes.Count - 1)
  RedibujarContribuyentes($aContribuyentes.Count - 1)

End

' ============================================
' Función   : btnColectivoContribuyente_Click
' Propósito : Agrega una autoría colectiva: el nombre se escribe en el
'             diálogo. Si se cierra sin aceptar, no queda agregada
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnColectivoContribuyente_Click()

  If $iFila < 0 Then Return
  $aContribuyentes.Add(m_Articulo.NuevoColectivo(""))
  If Not EditarContribuyente($aContribuyentes.Count - 1) Then $aContribuyentes.Remove($aContribuyentes.Count - 1)
  RedibujarContribuyentes($aContribuyentes.Count - 1)

End

' ============================================
' Función   : btnEditarContribuyente_Click
' Propósito : Abre el contribuyente elegido
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnEditarContribuyente_Click()

  EditarContribuyente(gvContribuyentes.Row)

End

' ============================================
' Función   : gvContribuyentes_DblClick
' Propósito : Doble clic: lo mismo que «Editar»
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub gvContribuyentes_DblClick()

  EditarContribuyente(gvContribuyentes.Row)

End

' ============================================
' Función   : btnQuitarContribuyente_Click
' Propósito : Quita el contribuyente elegido de la lista (se borra de la
'             base al guardar)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnQuitarContribuyente_Click()

  Dim iFila As Integer

  iFila = gvContribuyentes.Row
  If iFila < 0 Or iFila >= $aContribuyentes.Count Then Return
  $aContribuyentes.Remove(iFila)
  RedibujarContribuyentes(Min(iFila, $aContribuyentes.Count - 1))

End

' ============================================
' Función   : btnSubirContribuyente_Click
' Propósito : Sube el contribuyente elegido un lugar
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnSubirContribuyente_Click()

  MoverContribuyente(-1)

End

' ============================================
' Función   : btnBajarContribuyente_Click
' Propósito : Baja el contribuyente elegido un lugar
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnBajarContribuyente_Click()

  MoverContribuyente(1)

End

' ============================================
' Función   : MoverContribuyente
' Propósito : Mueve el contribuyente elegido; el orden es el de la firma
' Parámetros: iPaso As Integer — -1 sube, 1 baja
' Retorna   : nada
' ============================================
Private Sub MoverContribuyente(iPaso As Integer)

  Dim oContribuyente As CContribuyente
  Dim iFila As Integer
  Dim iDestino As Integer

  iFila = gvContribuyentes.Row
  iDestino = iFila + iPaso
  If iFila < 0 Or iDestino < 0 Or iDestino >= $aContribuyentes.Count Then Return
  ' INTERCAMBIO A MANO: LOS ARREGLOS NO TIENEN Exchange EN 3.19 (MEDIDO, 28/10)
  oContribuyente = $aContribuyentes[iFila]
  $aContribuyentes[iFila] = $aContribuyentes[iDestino]
  $aContribuyentes[iDestino] = oContribuyente
  RedibujarContribuyentes(iDestino)

End

' ============================================
' Función   : ArmarIdiomasTextos
' Propósito : Llena el selector de «Textos por idioma»: primero el idioma
'             principal del artículo, después los de la revista y al final
'             los que ya tienen textos aunque la revista no los declare
'             (decisión de Alberto, 28/10). Muestra el preferido si está
' Parámetros: sPreferido As String — idioma a dejar a la vista ("" = el
'             principal)
' Retorna   : nada
' ============================================
Private Sub ArmarIdiomasTextos(sPreferido As String)

  Dim aLista As New String[]
  Dim aConDatos As New String[]
  Dim aTerminos As String[]
  Dim cDelIdioma As Collection
  Dim sIdioma As String
  Dim sTexto As String
  Dim bCargandoAntes As Boolean
  Dim iIndice As Integer

  ' --- 1. INICIALIZACIÓN: LOS Click DEL COMBO NO DEBEN ACTUAR MIENTRAS SE ARMA ---
  bCargandoAntes = $bCargando
  $bCargando = True

  ' --- 2. PRINCIPAL Y REVISTA ---
  If cmbIdiomaArticulo.Index >= 0 Then aLista.Add(cmbIdiomaArticulo.Text)
  For Each sIdioma In $aIdiomasRevista
    If aLista.Find(sIdioma) < 0 Then aLista.Add(sIdioma)
  Next

  ' --- 3. IDIOMAS CON DATOS QUE LA REVISTA NO DECLARA ---
  For Each sTexto In $oTextos.cResumenes
    aConDatos.Add($oTextos.cResumenes.Key)
  Next
  For Each cDelIdioma In $oTextos.cSecciones
    aConDatos.Add($oTextos.cSecciones.Key)
  Next
  For Each sTexto In $oTextos.cPalabrasAutor
    aConDatos.Add($oTextos.cPalabrasAutor.Key)
  Next
  For Each aTerminos In $oTextos.cTerminosControlados
    aConDatos.Add($oTextos.cTerminosControlados.Key)
  Next
  For Each sIdioma In aConDatos
    If aLista.Find(sIdioma) < 0 Then aLista.Add(sIdioma)
  Next

  ' --- 4. SELECTOR ---
  cmbIdiomaTextos.List = aLista
  If aLista.Count = 0 Then
    $sIdiomaTextos = ""
  Else
    iIndice = aLista.Find(sPreferido)
    If iIndice < 0 Then iIndice = 0
    cmbIdiomaTextos.Index = iIndice
    $sIdiomaTextos = aLista[iIndice]
  Endif
  MostrarTextos()

  ' --- 5. LIMPIEZA ---
  $bCargando = bCargandoAntes

End

' ============================================
' Función   : MostrarTextos
' Propósito : Pone en la pestaña el resumen y las palabras clave del idioma a
'             la vista, y dice cómo sale ese resumen en JATS
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub MostrarTextos()

  ' --- 1. RESUMEN: SIMPLE O POR SECCIONES, SEGÚN LA PLANTILLA (ENTREGA C2) ---
  MostrarResumen()

  ' UNA CLAVE AUSENTE SE LEE Null, QUE VA AL CAMPO COMO VACÍO (GV-68)
  If $sIdiomaTextos = "" Then
    txaPalabrasAutor.Text = ""
    RedibujarControladas(-1)
    cmbVocabulario.Text = ""
    lblTipoResumen.Text = ""
    Return
  Endif

  ' --- 2. PALABRAS CLAVE ---
  txaPalabrasAutor.Text = $oTextos.cPalabrasAutor[$sIdiomaTextos]
  cmbVocabulario.Text = $oTextos.cVocabularios[$sIdiomaTextos]
  ' CONTROLADAS: LA LISTA DEL IDIOMA Y BÚSQUEDA LIMPIA
  RedibujarControladas(-1)
  txtBuscarControlado.Text = ""

  ' --- 3. CÓMO SALE: EL DEL PRINCIPAL ES <abstract>; LOS DEMÁS, TRADUCCIONES
  ' (JATS4R); EL ESTRUCTURADO LLEVA UN <sec> POR SECCIÓN ---
  If cmbIdiomaArticulo.Index >= 0 And $sIdiomaTextos = cmbIdiomaArticulo.Text Then
    lblTipoResumen.Text = "Idioma principal: sale como <abstract>"
  Else
    lblTipoResumen.Text = "Traducción: sale como <trans-abstract>"
  Endif
  If $oTextos.iIdPlantilla > 0 Then lblTipoResumen.Text &= ", estructurado («" & $oTextos.sNombrePlantilla & "»)"

End

' ============================================
' Función   : GuardarTextosEnMemoria
' Propósito : Pasa lo escrito al idioma a la vista. Un campo vacío borra la
'             clave (GV-68), que es justo «sin dato»
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub GuardarTextosEnMemoria()

  If $sIdiomaTextos = "" Then Return
  ' EL RESUMEN QUE SE VE ES EL QUE SE GUARDA: SIMPLE O LA SECCIÓN A LA VISTA
  If $bEstructuradoALaVista Then
    GuardarSeccionResumenEnMemoria()
  Else
    $oTextos.cResumenes[$sIdiomaTextos] = Trim(txaResumen.Text)
  Endif
  ' LAS LISTAS VAN TAL CUAL: LAS LÍNEAS SE LIMPIAN AL GRABAR
  ' (m_Articulo.Lineas); UN ÁREA CON SOLO BLANCOS CUENTA COMO VACÍA
  If Trim(txaPalabrasAutor.Text) = "" Then
    $oTextos.cPalabrasAutor[$sIdiomaTextos] = ""
  Else
    $oTextos.cPalabrasAutor[$sIdiomaTextos] = txaPalabrasAutor.Text
  Endif
  ' LAS CONTROLADAS NO SE PASAN: SE EDITAN DIRECTAMENTE EN MEMORIA (C3)
  $oTextos.cVocabularios[$sIdiomaTextos] = Trim(cmbVocabulario.Text)

End

' ============================================
' Función   : cmbIdiomaTextos_Click
' Propósito : Cambio de idioma en la pestaña: guarda en memoria lo escrito y
'             muestra el otro
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub cmbIdiomaTextos_Click()

  If $bCargando Then Return
  GuardarTextosEnMemoria()
  $sIdiomaTextos = cmbIdiomaTextos.Text
  MostrarTextos()

End

' ============================================
' Función   : MostrarResumen
' Propósito : Muestra el resumen del idioma a la vista: un área si es simple;
'             la lista de secciones de la plantilla y el texto de la elegida
'             si la sección del artículo exige estructurado (entrega C2)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub MostrarResumen()

  Dim bEstructurado As Boolean
  Dim bCargandoAntes As Boolean
  Dim sTitulo As String
  Dim i As Integer

  ' --- 1. MODO ---
  bEstructurado = ($oTextos.iIdPlantilla > 0)
  $bEstructuradoALaVista = bEstructurado
  txaResumen.Visible = Not bEstructurado
  hbxResumenEstructurado.Visible = bEstructurado
  If bEstructurado Then
    lblResumenTextos.Text = "resumen estructurado («" & $oTextos.sNombrePlantilla & "»; todas las secciones son obligatorias):"
  Else
    lblResumenTextos.Text = "resumen:"
  Endif

  ' --- 2. SIMPLE ---
  If Not bEstructurado Then
    txaResumen.Text = If($sIdiomaTextos = "", "", $oTextos.cResumenes[$sIdiomaTextos])
    $iSeccionResumen = -1
    Return
  Endif

  ' --- 3. ESTRUCTURADO: TÍTULOS EN EL IDIOMA A LA VISTA; SIN TÍTULO, EL CÓDIGO ---
  bCargandoAntes = $bCargando
  $bCargando = True
  lstSeccionesResumen.Clear()
  For i = 0 To $oTextos.aCodigosPlantilla.Count - 1
    sTitulo = ""
    If $sIdiomaTextos <> "" Then sTitulo = $oTextos.aTitulosPlantilla[i][$sIdiomaTextos]
    If sTitulo = "" Then sTitulo = "[" & $oTextos.aCodigosPlantilla[i] & "]"
    lstSeccionesResumen.Add(sTitulo)
  Next
  If $oTextos.aCodigosPlantilla.Count > 0 And $sIdiomaTextos <> "" Then
    $iSeccionResumen = 0
    lstSeccionesResumen.Index = 0
  Else
    $iSeccionResumen = -1
  Endif
  MostrarSeccionResumen()
  $bCargando = bCargandoAntes

End

' ============================================
' Función   : MostrarSeccionResumen
' Propósito : Pone en el área el texto de la sección a la vista
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub MostrarSeccionResumen()

  If $iSeccionResumen < 0 Then
    txaSeccionResumen.Text = ""
    Return
  Endif
  txaSeccionResumen.Text = $oTextos.TextoSeccion($sIdiomaTextos, $oTextos.aCodigosPlantilla[$iSeccionResumen])

End

' ============================================
' Función   : GuardarSeccionResumenEnMemoria
' Propósito : Pasa el texto del área a la sección a la vista. Vacío la borra
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub GuardarSeccionResumenEnMemoria()

  If $iSeccionResumen < 0 Or $sIdiomaTextos = "" Then Return
  $oTextos.FijarTextoSeccion($sIdiomaTextos, $oTextos.aCodigosPlantilla[$iSeccionResumen], Trim(txaSeccionResumen.Text))

End

' ============================================
' Función   : lstSeccionesResumen_Click
' Propósito : Cambia la sección del resumen a la vista, guardando antes la
'             anterior
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub lstSeccionesResumen_Click()

  If $bCargando Then Return
  If lstSeccionesResumen.Index < 0 Or lstSeccionesResumen.Index = $iSeccionResumen Then Return
  GuardarSeccionResumenEnMemoria()
  $iSeccionResumen = lstSeccionesResumen.Index
  MostrarSeccionResumen()

End

' ============================================
' Función   : RedibujarControladas
' Propósito : Llena la lista de términos controlados del idioma a la vista
'             desde la memoria, que es la fuente
' Parámetros: iElegido As Integer — fila a dejar elegida; -1 ninguna
' Retorna   : nada
' ============================================
Private Sub RedibujarControladas(iElegido As Integer)

  Dim aTerminos As String[]
  Dim aIds As String[]
  Dim i As Integer

  lstControladas.Clear()
  If $sIdiomaTextos = "" Then Return
  aTerminos = $oTextos.TerminosControlados($sIdiomaTextos)
  aIds = $oTextos.IdsControlados($sIdiomaTextos)
  For i = 0 To aTerminos.Count - 1
    lstControladas.Add(TextoTermino(aTerminos[i], aIds[i]))
  Next
  ' ASIGNAR Index A UNA ListBox NO DISPARA Click (MEDIDO, 28/10)
  If iElegido >= 0 And iElegido < aTerminos.Count Then lstControladas.Index = iElegido

End

' ============================================
' Función   : TextoTermino
' Propósito : Cómo se muestra un término: con su identificador, si tiene
' Parámetros: sTermino As String — término
'             sIdentificador As String — código; "" si no tiene
' Retorna   : String — «Humanos  [D006801]»
' ============================================
Private Function TextoTermino(sTermino As String, sIdentificador As String) As String

  If sIdentificador = "" Then Return sTermino
  Return sTermino & "  [" & sIdentificador & "]"

End

' ============================================
' Función   : txtBuscarControlado_Change
' Propósito : Sugiere términos del catálogo mientras se tipea (Change se
'             dispara también al asignar Text por código, pero no si el texto
'             no cambia: MEDIDO, 28/10)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub txtBuscarControlado_Change()

  ActualizarCoincidencias()

End

' ============================================
' Función   : cmbVocabulario_Click
' Propósito : Otro vocabulario elegido de la lista: las sugerencias de lo ya
'             tipeado cambian
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub cmbVocabulario_Click()

  ActualizarCoincidencias()

End

' ============================================
' Función   : cmbVocabulario_Change
' Propósito : Un vocabulario escrito a mano: las sugerencias cambian
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub cmbVocabulario_Change()

  ActualizarCoincidencias()

End

' ============================================
' Función   : ActualizarCoincidencias
' Propósito : Llena la lista de sugerencias del catálogo para lo tipeado,
'             en el vocabulario e idioma a la vista
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub ActualizarCoincidencias()

  Dim rDatos As Result
  Dim sTexto As String

  ' --- 1. LIMPIEZA ---
  lstCoincidencias.Clear()
  $aCoincTerminos.Clear()
  $aCoincIds.Clear()
  If $bCargando Then Return

  ' --- 2. HACE FALTA VOCABULARIO, IDIOMA Y AL MENOS DOS CARACTERES ---
  sTexto = Trim(txtBuscarControlado.Text)
  If String.Len(sTexto) < 2 Or Trim(cmbVocabulario.Text) = "" Or $sIdiomaTextos = "" Then Return

  ' --- 3. SUGERENCIAS: SIN DISTINGUIR TILDES (m_Vocabularios.Buscar) ---
  rDatos = m_Vocabularios.Buscar(m_ConexionBD.mConn, Trim(cmbVocabulario.Text), $sIdiomaTextos, sTexto, MAX_COINCIDENCIAS)
  If Not rDatos Then Return
  While rDatos.Available
    $aCoincTerminos.Add(rDatos!termino)
    ' UN NULL SE LEE VACÍO
    $aCoincIds.Add(rDatos!identificador)
    lstCoincidencias.Add(TextoTermino(rDatos!termino, rDatos!identificador))
    rDatos.MoveNext
  Wend

End

' ============================================
' Función   : btnAgregarControlado_Click
' Propósito : Agrega al idioma a la vista la sugerencia elegida o, si no hay
'             ninguna elegida, lo escrito: si el catálogo ya lo tiene (sin
'             distinguir mayúsculas) se usa su forma y su identificador; si
'             no, entra como término nuevo y se agrega al catálogo al guardar
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnAgregarControlado_Click()

  Dim rTermino As Result
  Dim aTerminos As String[]
  Dim sTermino As String
  Dim sIdentificador As String
  Dim sAviso As String
  Dim i As Integer

  ' --- 1. HACE FALTA VOCABULARIO E IDIOMA ---
  If $sIdiomaTextos = "" Then Return
  If Trim(cmbVocabulario.Text) = "" Then
    m_Sonido.sonar("Warning")
    Message.Warning("Elija o escriba primero el vocabulario controlado (MeSH, DeCS…).")
    cmbVocabulario.SetFocus()
    Return
  Endif

  ' --- 2. QUÉ TÉRMINO: LA SUGERENCIA ELEGIDA O LO ESCRITO ---
  If lstCoincidencias.Index >= 0 And lstCoincidencias.Index < $aCoincTerminos.Count Then
    sTermino = $aCoincTerminos[lstCoincidencias.Index]
    sIdentificador = $aCoincIds[lstCoincidencias.Index]
  Else
    sTermino = Trim(txtBuscarControlado.Text)
    If sTermino = "" Then Return
    ' YA EN EL CATÁLOGO CON OTRAS MAYÚSCULAS: MANDA LA FORMA DEL CATÁLOGO
    rTermino = m_Vocabularios.TerminoDelCatalogo(m_ConexionBD.mConn, Trim(cmbVocabulario.Text), $sIdiomaTextos, sTermino)
    If rTermino Then
      sTermino = rTermino!termino
      sIdentificador = rTermino!identificador
    Endif
    sAviso = m_Vocabularios.AvisoTermino(Trim(cmbVocabulario.Text), $sIdiomaTextos, sTermino, sIdentificador)
    If sAviso <> "" Then
      m_Sonido.sonar("Warning")
      Message.Warning(sAviso)
      Return
    Endif
  Endif

  ' --- 3. SIN REPETIDOS EN EL IDIOMA (MISMA REGLA QUE LA CLAVE: 0900_as_ci) ---
  aTerminos = $oTextos.TerminosControlados($sIdiomaTextos)
  For i = 0 To aTerminos.Count - 1
    If String.LCase(aTerminos[i]) = String.LCase(sTermino) Then
      m_Sonido.sonar("Warning")
      Message.Warning("«" & sTermino & "» ya está entre las palabras de vocabulario controlado.")
      Return
    Endif
  Next

  ' --- 4. AGREGADO Y BÚSQUEDA LIMPIA ---
  $oTextos.AgregarControlado($sIdiomaTextos, sTermino, sIdentificador)
  RedibujarControladas($oTextos.TerminosControlados($sIdiomaTextos).Count - 1)
  txtBuscarControlado.Text = ""
  txtBuscarControlado.SetFocus()

End

' ============================================
' Función   : btnQuitarControlada_Click
' Propósito : Quita el término controlado elegido (del artículo, no del
'             catálogo)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnQuitarControlada_Click()

  Dim iFila As Integer

  iFila = lstControladas.Index
  If iFila < 0 Then Return
  $oTextos.QuitarControlado($sIdiomaTextos, iFila)
  RedibujarControladas(Min(iFila, $oTextos.TerminosControlados($sIdiomaTextos).Count - 1))

End

' ============================================
' Función   : btnSubirControlada_Click
' Propósito : Sube el término controlado elegido un lugar
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnSubirControlada_Click()

  If lstControladas.Index < 0 Then Return
  RedibujarControladas($oTextos.MoverControlado($sIdiomaTextos, lstControladas.Index, -1))

End

' ============================================
' Función   : btnBajarControlada_Click
' Propósito : Baja el término controlado elegido un lugar
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnBajarControlada_Click()

  If lstControladas.Index < 0 Then Return
