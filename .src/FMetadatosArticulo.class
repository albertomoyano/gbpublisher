' ============================================
' Función   : RedibujarFinanciadores
' Propósito : Llena la grilla de financiadores desde la memoria, que es la
'             fuente, y pone en los campos el elegido
' Parámetros: iElegido As Integer — fila a dejar elegida; -1 ninguna
' Retorna   : nada
' ============================================
Private Sub RedibujarFinanciadores(iElegido As Integer)

  Dim iIndice As Integer
  Dim i As Integer

  ' --- 1. GRILLA ---
  gvFinanciadores.Rows.Count = $oFin.aFinanciadores.Count
  For i = 0 To $oFin.aFinanciadores.Count - 1
    gvFinanciadores[i, 0].Text = $oFin.aFinanciadores[i]
    If $oFin.aTiposId[i] = "" Then
      gvFinanciadores[i, 1].Text = ""
    Else
      iIndice = m_Articulo.TiposIdFinanciadorCodigos().Find($oFin.aTiposId[i])
      gvFinanciadores[i, 1].Text = m_Articulo.TiposIdFinanciadorLeyendas()[Max(iIndice, 0)] & ": " & $oFin.aIdsFinanciador[i]
    Endif
    gvFinanciadores[i, 2].Text = $oFin.aProyectos[i]
  Next

  ' --- 2. ELEGIDO Y CAMPOS ---
  If iElegido >= $oFin.aFinanciadores.Count Then iElegido = $oFin.aFinanciadores.Count - 1
  $iFinanciador = iElegido
  If iElegido >= 0 Then gvFinanciadores.Row = iElegido
  MostrarFinanciador()

End

' ============================================
' Función   : MostrarFinanciador
' Propósito : Pone en los campos el financiador elegido; sin financiador, los
'             vacía y los apaga
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub MostrarFinanciador()

  Dim bCargandoAntes As Boolean
  Dim iIndice As Integer

  bCargandoAntes = $bCargando
  $bCargando = True
  If $iFinanciador < 0 Then
    txtFinanciador.Text = ""
    cmbTipoIdFinanciador.Index = 0
    txtIdFinanciador.Text = ""
    txtProyectoFinanciador.Text = ""
  Else
    txtFinanciador.Text = $oFin.aFinanciadores[$iFinanciador]
    iIndice = m_Articulo.TiposIdFinanciadorCodigos().Find($oFin.aTiposId[$iFinanciador])
    cmbTipoIdFinanciador.Index = Max(iIndice, 0)
    txtIdFinanciador.Text = $oFin.aIdsFinanciador[$iFinanciador]
    txtProyectoFinanciador.Text = $oFin.aProyectos[$iFinanciador]
  Endif
  FijarCamposFinanciador()
  $bCargando = bCargandoAntes

End

' ============================================
' Función   : FijarCamposFinanciador
' Propósito : Los campos del financiador se editan si hay uno elegido y el
'             artículo no está publicado
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub FijarCamposFinanciador()

  Dim bHabilitados As Boolean

  bHabilitados = ($iFinanciador >= 0)
  If $bSoloLectura Then bHabilitados = False
  hbxFinanciador.Enabled = bHabilitados
  hbxIdFinanciador.Enabled = bHabilitados
  hbxProyectoFinanciador.Enabled = bHabilitados

End

' ============================================
' Función   : GuardarFinanciadorEnMemoria
' Propósito : Pasa los campos al financiador elegido y refresca su fila. El
'             identificador se normaliza según su tipo
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub GuardarFinanciadorEnMemoria()

  Dim sTipo As String

  If $iFinanciador < 0 Or $bSoloLectura Then Return
  sTipo = m_Articulo.TiposIdFinanciadorCodigos()[Max(cmbTipoIdFinanciador.Index, 0)]
  $oFin.aFinanciadores[$iFinanciador] = Trim(txtFinanciador.Text)
  $oFin.aTiposId[$iFinanciador] = sTipo
  $oFin.aIdsFinanciador[$iFinanciador] = m_Articulo.NormalizarIdFinanciador(sTipo, txtIdFinanciador.Text)
  $oFin.aProyectos[$iFinanciador] = Trim(txtProyectoFinanciador.Text)
  RedibujarFinanciadores($iFinanciador)

End

' ============================================
' Función   : gvFinanciadores_Click
' Propósito : Cambia el financiador elegido, guardando antes el anterior
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub gvFinanciadores_Click()

  Dim iFila As Integer

  iFila = gvFinanciadores.Row
  If iFila < 0 Or iFila = $iFinanciador Then Return
  GuardarFinanciadorEnMemoria()
  $iFinanciador = iFila
  MostrarFinanciador()

End

