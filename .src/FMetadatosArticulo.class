' Gambas class file

' ============================================
' Formulario : FMetadatosArticulo
' Propósito  : Metadatos de los artículos del número abierto, sobre el esquema
'              nuevo. Reemplaza a FMetadatosArticulos como destino del botón
'              de FMain (decisión de Alberto, 26/10). Pestañas con nombre
'              (decisión 19). Entrega A: Identificación y Permisos; las demás
'              pestañas llegan en las entregas B a E.
'              Los títulos traducidos van en Identificación con su propio
'              selector de idioma (decisión de Alberto, 26/10).
'              Entrega B: Contribuyentes, en memoria (CContribuyente) y
'              editados en FContribuyenteArticulo; se graban con «Guardar»
'              (decisiones de Alberto, 28/10).
'              Entrega C: Textos por idioma (resumen simple y palabras clave),
'              en memoria (CTextosArticulo), con su propio selector de idioma
'              (decisiones de Alberto, 28/10).
'              Entrega D2: financiadores (grilla + campos) y declaraciones
'              del núcleo por tipo e idioma, en memoria como
'              CFinanciamientoArticulo (SC-73).
'              Entrega D1: fechas, DOI y páginas (solo lectura) en «Fechas e
'              identificadores»; autoría anónima y notas de autor en
'              «Contribuyentes» (decisiones de Alberto, 28/10).
'              Entrega C3: las palabras de vocabulario controlado se buscan
'              en el catálogo global mientras se tipea; lo que no está, se
'              agrega y entra al catálogo al guardar (decisiones de Alberto,
'              28/10).
'              Entrega C2: si la sección del artículo tiene plantilla de
'              resumen, el resumen se edita por secciones (lista + texto).
'              Los controles y los manejadores viven acá; las consultas, las
'              validaciones y las grabaciones, en m_Articulo.
' ============================================

' NÚMERO DEL PROYECTO ABIERTO Y SU REVISTA
Private $iIdNumero As Integer
Private $iIdRevista As Integer
' UNA ENTRADA POR FILA DE LA GRILLA, EN EL MISMO ORDEN: NOMBRE DEL ARCHIVO, id
' (0 = SIN METADATOS) Y SI EL ARCHIVO EXISTE (False = HUÉRFANA)
Private $aArchivos As New String[]
Private $aIds As New Integer[]
Private $aConArchivo As New Boolean[]
' ARTÍCULO EN EDICIÓN: FILA DE LA GRILLA E id (0 = TODAVÍA NO ESTÁ EN LA BASE)
Private $iFila As Integer = -1
Private $iIdArticulo As Integer
' UNA ENTRADA POR ÍTEM DE LOS COMBOS DE SECCIÓN Y DE DOSSIER (0 = SIN DOSSIER)
Private $aIdsSecciones As New Integer[]
Private $aIdsDossiers As New Integer[]
' TIPO DE ACCESO: EL PRIMER ÍTEM ES «HEREDA» (NULL)
Private $aAccesoCodigos As New String[]
' IDIOMAS DE PUBLICACIÓN DE LA REVISTA, EN SU ORDEN
Private $aIdiomasRevista As New String[]
' TÍTULOS Y SUBTÍTULOS TRADUCIDOS EN MEMORIA (CLAVE: IDIOMA) E IDIOMA A LA
' VISTA. SE GRABAN AL GUARDAR EL ARTÍCULO
Private $cTitulosTrad As New Collection
Private $cSubtitulosTrad As New Collection
Private $sIdiomaTrad As String
' CONTRIBUYENTES EN MEMORIA, EN ORDEN. SE GRABAN AL GUARDAR EL ARTÍCULO
Private $aContribuyentes As New CContribuyente[]
' SI NO SE PUDIERON LEER, GUARDAR BORRARÍA LOS QUE HAY: SE BLOQUEA
Private $bContribuyentesIlegibles As Boolean
' PUBLICADO A LA VISTA: EL DIÁLOGO DEL CONTRIBUYENTE SE ABRE SOLO PARA VER
Private $bSoloLectura As Boolean
' RESÚMENES Y PALABRAS CLAVE EN MEMORIA, E IDIOMA A LA VISTA EN LA PESTAÑA
Private $oTextos As New CTextosArticulo
' FINANCIAMIENTO Y DECLARACIONES EN MEMORIA (ENTREGA D2): FINANCIADOR ELEGIDO
' (-1 NINGUNO); CÓDIGO DE TIPO POR ÍTEM DEL COMBO; TIPO E IDIOMA A LA VISTA
Private $oFin As New CFinanciamientoArticulo
Private $iFinanciador As Integer = -1
Private $aTiposDecl As New String[]
Private $sTipoDecl As String
Private $sIdiomaDecl As String
' SI NO SE PUDIERON LEER, GUARDAR LOS BORRARÍA: SE BLOQUEA (SC-73)
Private $bFinIlegible As Boolean
Private Const COLUMNAS_FINANCIADORES As Integer = 3
' RELACIONES Y UBICACIONES EN MEMORIA (ENTREGA D3): RELACIÓN ELEGIDA (-1
' NINGUNA) Y id DE CADA ÍTEM DEL COMBO DE DESTINO (0 = EXTERNO)
Private $oRel As New CRelacionesArticulo
Private $iRelacion As Integer = -1
Private $aIdsDestino As New Integer[]
' SI NO SE PUDIERON LEER, GUARDAR LAS BORRARÍA: SE BLOQUEA (SC-73)
Private $bRelIlegible As Boolean
Private Const COLUMNAS_RELACIONES As Integer = 2
Private $sIdiomaTextos As String
' SI HAY TEXTOS QUE LA PESTAÑA NO PUEDE MOSTRAR ENTEROS, GUARDAR LOS
' BORRARÍA: SE BLOQUEA CON ESTE MOTIVO (VACÍO = SE PUEDE GUARDAR)
Private $sAvisoTextos As String
' SECCIÓN DEL RESUMEN ESTRUCTURADO A LA VISTA (ÍNDICE EN LA PLANTILLA; -1 NINGUNA)
Private $iSeccionResumen As Integer = -1
' MODO DEL RESUMEN A LA VISTA (True = POR SECCIONES). VARIABLE PROPIA Y NO
' .Visible: CON LA PESTAÑA OCULTA, Visible PODRÍA INFORMAR LA DEL CONTENEDOR
Private $bEstructuradoALaVista As Boolean
' SUGERENCIAS DEL CATÁLOGO A LA VISTA: TÉRMINO E IDENTIFICADOR, UNA ENTRADA
' POR ÍTEM DE lstCoincidencias, EN EL MISMO ORDEN
Private $aCoincTerminos As New String[]
Private $aCoincIds As New String[]
' SUGERENCIAS COMO MÁXIMO
Private Const MAX_COINCIDENCIAS As Integer = 20
' EVITA QUE LOS Click DE LOS COMBOS ACTÚEN MIENTRAS SE CARGA
Private $bCargando As Boolean
' COLUMNAS DE LA GRILLA (GV-58: CONTEO FIJO)
Private Const COLUMNAS_ARTICULOS As Integer = 3
Private Const COLUMNAS_CONTRIBUYENTES As Integer = 5

' ============================================
' Función   : Form_Show
' Propósito : Aplicar la configuración de botones del marco (SC-20)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub Form_Show()

  m_Ventana.FijarBotones(Me)

End

' ============================================
' Función   : Form_Open
' Propósito : Ubica el número del proyecto, prepara grilla y combos y llena
'             la lista
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub Form_Open()

  Dim rNumero As Result
  Dim i As Integer

  ' --- 1. NÚMERO DEL PROYECTO (RC-GM-16: id DE LA VARIABLE DE SESIÓN) ---
  rNumero = m_Numero.CargarNumeroDeProyecto(m_InicioCierre.IdProyectoEnCurso)
  If Not rNumero Then
    m_Sonido.sonar("Warning")
    Message.Warning("El proyecto abierto no tiene número: complete primero los metadatos del número.")
    Me.Close()
    Return
  Endif
  $iIdNumero = rNumero!id_numero
  $iIdRevista = rNumero!id_revista
  lblNumeroArticulo.Text = m_Numero.DescripcionNumero(m_InicioCierre.IdProyectoEnCurso)

  ' --- 2. GRILLA ---
  With gvArticulos
    .Header = GridView.Horizontal
    .Columns.Count = COLUMNAS_ARTICULOS
    .Columns[0].Title = "Archivo"
    .Columns[0].Width = 150
    .Columns[1].Title = "Título"
    .Columns[1].Width = 200
    .Columns[2].Title = "Estado"
    .Columns[2].Width = 110
  End With

  With gvContribuyentes
    .Header = GridView.Horizontal
    .Columns.Count = COLUMNAS_CONTRIBUYENTES
    .Columns[0].Title = "#"
    .Columns[0].Width = 40
    .Columns[1].Title = "Contribuyente"
    .Columns[1].Width = 300
    .Columns[2].Title = "Rol"
    .Columns[2].Width = 110
    .Columns[3].Title = "Correspondencia"
    .Columns[3].Width = 140
    .Columns[4].Title = "Afiliación principal"
    .Columns[4].Width = 360
  End With

  With gvFinanciadores
    .Header = GridView.Horizontal
    .Columns.Count = COLUMNAS_FINANCIADORES
    .Columns[0].Title = "Financiador"
    .Columns[0].Width = 380
    .Columns[1].Title = "Identificador"
    .Columns[1].Width = 320
    .Columns[2].Title = "Proyecto"
    .Columns[2].Width = 160
  End With

  With gvRelaciones
    .Header = GridView.Horizontal
    .Columns.Count = COLUMNAS_RELACIONES
    .Columns[0].Title = "Tipo"
    .Columns[0].Width = 180
    .Columns[1].Title = "Destino"
    .Columns[1].Width = 680
  End With

  ' --- 3. COMBOS ---
  LlenarCombos()
  ' TIPOS DE RELACIÓN: CÓDIGO JATS Y QUÉ ES, DESDE ESTE ARTÍCULO
  For i = 0 To m_Articulo.TiposRelacionCodigos().Count - 1
    cmbTipoRelacion.Add(m_Articulo.TiposRelacionCodigos()[i] & " — " & m_Articulo.TiposRelacionLeyendas()[i])
  Next

  ' --- 4. LISTA ---
  CargarLista()

End

' ============================================
' Función   : LlenarCombos
' Propósito : Secciones y dossiers del número, article-type, idiomas y
'             licencias
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub LlenarCombos()

  Dim aIdiomas As String[]
  Dim rDatos As Result
  Dim sIdioma As String

  ' --- 1. IDIOMA DE LOS TÍTULOS DE SECCIÓN Y DOSSIER: EL PRIMERO DE LA REVISTA ---
  aIdiomas = m_Revistas.IdiomasDeRevista(m_ConexionBD.mConn, $iIdRevista)
  If aIdiomas.Count > 0 Then sIdioma = aIdiomas[0]
  ' LOS MISMOS IDIOMAS ALIMENTAN EL SELECTOR DE TRADUCCIÓN
  $aIdiomasRevista = aIdiomas

  ' --- 2. SECCIONES ---
  cmbSeccionArticulo.Clear()
  $aIdsSecciones.Clear()
  rDatos = m_Revistas.ListarSecciones(m_ConexionBD.mConn, $iIdRevista, sIdioma)
  If rDatos Then
    While rDatos.Available
      If IsNull(rDatos!titulo) Then
        cmbSeccionArticulo.Add(rDatos!codigo)
      Else
        cmbSeccionArticulo.Add(rDatos!titulo & "  [" & rDatos!codigo & "]")
      Endif
      $aIdsSecciones.Add(rDatos!id_seccion)
      rDatos.MoveNext
    Wend
  Endif

  ' --- 3. DOSSIERS: EL PRIMER ÍTEM ES «SIN DOSSIER» ---
  cmbDossierArticulo.Clear()
  $aIdsDossiers.Clear()
  cmbDossierArticulo.Add("(sin dossier)")
  $aIdsDossiers.Add(0)
  rDatos = m_Dossiers.ListarDossiers($iIdNumero, sIdioma)
  If rDatos Then
    While rDatos.Available
      cmbDossierArticulo.Add(If(IsNull(rDatos!titulo), "(dossier sin título)", rDatos!titulo))
      $aIdsDossiers.Add(rDatos!id_dossier)
      rDatos.MoveNext
    Wend
  Endif

  ' --- 4. CATÁLOGOS ---
  cmbTipoArticulo.List = m_Revistas.TiposArticulo()
  ' IDIOMA PRINCIPAL: EL CATÁLOGO COMPLETO, NO SOLO LOS DE LA REVISTA (UN
  ' ARTÍCULO PUEDE ESTAR EN UN IDIOMA QUE LA REVISTA NO DECLARA)
  m_Idiomas.LlenarCombo(cmbIdiomaArticulo)
  ' LICENCIAS DE CONTENIDO: EDITABLE (SC-23)
  m_Licencias.LlenarCombo(cmbLicenciaArticulo, False)
  ' VOCABULARIOS CONTROLADOS: EDITABLE, ACEPTA OTROS (SC-23)
  cmbVocabulario.List = m_Vocabularios.Vocabularios(m_ConexionBD.mConn)
  ' FINANCIAMIENTO Y DECLARACIONES (ENTREGA D2)
  cmbTipoIdFinanciador.List = m_Articulo.TiposIdFinanciadorLeyendas()
  cmbTipoDeclaracion.Clear()
  $aTiposDecl.Clear()
  rDatos = m_Articulo.TiposDeclaracionNucleo()
  If rDatos Then
    While rDatos.Available
      cmbTipoDeclaracion.Add(rDatos!etiqueta)
      $aTiposDecl.Add(rDatos!codigo)
      rDatos.MoveNext
    Wend
  Endif

End

' ============================================
' Función   : CargarLista
' Propósito : Cruza los a-*.md de articulos/ con las filas de la base y llena
'             la grilla. Deja el editor vacío
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub CargarLista()

  Dim aEnDisco As String[]
  Dim rFilas As Result
  Dim cIds As New Collection
  Dim cTitulos As New Collection
  Dim cEstados As New Collection
  Dim sArchivo As String
  Dim iFila As Integer

  ' --- 1. LO QUE HAY EN LA BASE, POR NOMBRE DE ARCHIVO ---
  rFilas = m_Articulo.FilasDelNumero($iIdNumero)
  If rFilas Then
    While rFilas.Available
      cIds[rFilas!nombre_archivo] = rFilas!id_articulo
      cTitulos[rFilas!nombre_archivo] = rFilas!titulo
      cEstados[rFilas!nombre_archivo] = rFilas!estado
      rFilas.MoveNext
    Wend
  Endif

  ' --- 2. LOS ARCHIVOS, EN ORDEN; DESPUÉS LAS HUÉRFANAS ---
  $aArchivos.Clear()
  $aIds.Clear()
  $aConArchivo.Clear()
  aEnDisco = m_Articulo.ArchivosDelProyecto()
  For Each sArchivo In aEnDisco
    $aArchivos.Add(sArchivo)
    If cIds.Exist(sArchivo) Then
      $aIds.Add(cIds[sArchivo])
    Else
      $aIds.Add(0)
    Endif
    $aConArchivo.Add(True)
  Next
  ' UNA FILA CUYO ARCHIVO YA NO ESTÁ: SE MUESTRA PARA QUE NO QUEDE OCULTA
  For Each iFila In cIds
    sArchivo = cIds.Key
    If aEnDisco.Find(sArchivo) < 0 Then
      $aArchivos.Add(sArchivo)
      $aIds.Add(iFila)
      $aConArchivo.Add(False)
    Endif
  Next

  ' --- 3. GRILLA ---
  gvArticulos.Rows.Count = $aArchivos.Count
  For iFila = 0 To $aArchivos.Count - 1
    sArchivo = $aArchivos[iFila]
    gvArticulos[iFila, 0].Text = sArchivo
    If $aIds[iFila] = 0 Then
      gvArticulos[iFila, 1].Text = ""
      gvArticulos[iFila, 2].Text = "Sin metadatos"
    Else
      ' UN TÍTULO NULL NO CREA SU CLAVE (GV-68) Y SE LEE VACÍO
      gvArticulos[iFila, 1].Text = cTitulos[sArchivo]
      gvArticulos[iFila, 2].Text = m_Articulo.LeyendaEstado(cEstados[sArchivo])
    Endif
    If Not $aConArchivo[iFila] Then gvArticulos[iFila, 2].Text = "Huérfana: falta el archivo"
  Next

  ' --- 4. NADA ELEGIDO ---
  LimpiarEditor()

End

' ============================================
' Función   : LimpiarEditor
' Propósito : Editor vacío y botón de guardar apagado
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub LimpiarEditor()

  $bCargando = True
  $iFila = -1
  $iIdArticulo = 0
  txtArchivoArticulo.Text = ""
  cmbSeccionArticulo.Index = -1
  cmbDossierArticulo.Index = 0
  cmbTipoArticulo.Index = -1
  cmbIdiomaArticulo.Index = -1
  txtTituloArticulo.Text = ""
  txtSubtituloArticulo.Text = ""
  txtTituloCortoArticulo.Text = ""
  $cTitulosTrad = New Collection
  $cSubtitulosTrad = New Collection
  $sIdiomaTrad = ""
  cmbIdiomaTradArticulo.Clear()
  txtTituloTradArticulo.Text = ""
  txtSubtituloTradArticulo.Text = ""
  cmbLicenciaArticulo.Text = ""
  txtUrlLicenciaArticulo.Text = ""
  txtTitularArticulo.Text = ""
  txtAnioCopyrightArticulo.Text = ""
  dtbRecepcionArticulo.Value = Null
  dtbRevisionArticulo.Value = Null
  dtbAceptacionArticulo.Value = Null
  dtbPublicacionArticulo.Value = Null
  txtDoiArticulo.Text = ""
  txtPaginasArticulo.Text = ""
  chkAnonimosArticulo.Value = False
  txaNotasAutorArticulo.Text = ""
  $oFin = New CFinanciamientoArticulo
  $bFinIlegible = False
  RedibujarFinanciadores(-1)
  $oRel = New CRelacionesArticulo
  $bRelIlegible = False
  cmbDestinoRelacion.Clear()
  $aIdsDestino.Clear()
  RedibujarRelaciones(-1)
  MostrarUbicaciones()
  ' EL TIPO DE DECLARACIÓN A LA VISTA ES EL PRIMERO DEL CATÁLOGO
  If $aTiposDecl.Count > 0 Then
    cmbTipoDeclaracion.Index = 0
    $sTipoDecl = $aTiposDecl[0]
  Else
    $sTipoDecl = ""
  Endif
  $sIdiomaDecl = ""
  cmbIdiomaDeclaracion.Clear()
  txaDeclaracion.Text = ""
  $aContribuyentes = New CContribuyente[]
  $bContribuyentesIlegibles = False
  RedibujarContribuyentes(-1)
  hbxBotonesContribuyentes.Enabled = False
  $oTextos = New CTextosArticulo
  $sIdiomaTextos = ""
  $sAvisoTextos = ""
  cmbIdiomaTextos.Clear()
  lblTipoResumen.Text = ""
  txaResumen.Text = ""
  $iSeccionResumen = -1
  lstSeccionesResumen.Clear()
  txaSeccionResumen.Text = ""
  txaResumen.Visible = True
  hbxResumenEstructurado.Visible = False
  $bEstructuradoALaVista = False
  txaPalabrasAutor.Text = ""
  txtBuscarControlado.Text = ""
  lstCoincidencias.Clear()
  $aCoincTerminos.Clear()
  $aCoincIds.Clear()
  lstControladas.Clear()
  cmbVocabulario.Text = ""
  lblEstadoArticulo.Text = ""
  btnGuardarArticulo.Enabled = False
  $bCargando = False

End

' ============================================
' Función   : gvArticulos_Click
' Propósito : Al elegir una fila: carga el artículo, o prepara el alta si el
'             archivo todavía no tiene metadatos
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub gvArticulos_Click()

  Dim iFila As Integer

  iFila = gvArticulos.Row
  If iFila < 0 Or iFila >= $aArchivos.Count Then Return

  If $aIds[iFila] = 0 Then
    PrepararAlta(iFila)
  Else
    CargarEditor(iFila)
  Endif

End

' ============================================
' Función   : PrepararHerencia
' Propósito : Muestra en los campos heredables, como texto de ayuda, el valor
'             de la revista que toman mientras estén vacíos (decisión 14). El
'             tipo de acceso es un combo de solo lectura: su primer ítem dice
'             qué se hereda
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub PrepararHerencia()

  Dim rRevista As Result
  Dim sAcceso As String
  Dim iIndice As Integer

  ' --- 1. VALORES DE LA REVISTA ---
  rRevista = m_Articulo.ValoresRevista($iIdNumero)

  ' --- 2. TEXTOS DE AYUDA ---
  ' Placeholder EXISTE EN TextBox Y EN ComboBox EDITABLE (VERIFICADO EN 3.19)
  If rRevista Then
    cmbLicenciaArticulo.Placeholder = TextoHerencia(rRevista!licencia_defecto)
    txtUrlLicenciaArticulo.Placeholder = TextoHerencia(rRevista!url_licencia_defecto)
    txtTitularArticulo.Placeholder = TextoHerencia(rRevista!titular_copyright_defecto)
    If IsNull(rRevista!tipo_acceso_defecto) Then
      sAcceso = "sin valor"
    Else
      iIndice = m_Revistas.TiposAccesoCodigos().Find(rRevista!tipo_acceso_defecto)
      If iIndice < 0 Then
        sAcceso = rRevista!tipo_acceso_defecto
      Else
        sAcceso = m_Revistas.TiposAccesoLeyendas()[iIndice]
      Endif
    Endif
  Else
    sAcceso = "sin valor"
  Endif
  txtAnioCopyrightArticulo.Placeholder = "Vacío: el año de la publicación"

  ' --- 3. TIPO DE ACCESO: «HEREDA» + LOS TRES VALORES ---
  $aAccesoCodigos = ["", "abierto", "suscripcion", "embargo"]
  cmbAccesoArticulo.List = ["(hereda de la revista: " & sAcceso & ")", "Abierto", "Suscripción", "Embargo"]

End

' ============================================
' Función   : TextoHerencia
' Propósito : El texto de ayuda de un campo heredable
' Parámetros: vValor As Variant — el valor de la revista (puede ser Null)
' Retorna   : String — «Hereda de la revista: …»
' ============================================
Private Function TextoHerencia(vValor As Variant) As String

  If IsNull(vValor) Then Return "Hereda de la revista (que no define valor)"
  Return "Hereda de la revista: " & vValor

End

' ============================================
' Función   : PrepararAlta
' Propósito : El archivo no tiene metadatos: editor vacío con el nombre del
'             archivo; la fila se crea al guardar
' Parámetros: iFila As Integer — fila de la grilla
' Retorna   : nada
' ============================================
Private Sub PrepararAlta(iFila As Integer)

  Dim aIdiomas As String[]

  LimpiarEditor()
  $bCargando = True
  $iFila = iFila
  $iIdArticulo = 0
  txtArchivoArticulo.Text = $aArchivos[iFila]
  PrepararHerencia()
  cmbAccesoArticulo.Index = 0
  ' IDIOMA PROPUESTO: EL PRIMERO DE LA REVISTA
  aIdiomas = m_Revistas.IdiomasDeRevista(m_ConexionBD.mConn, $iIdRevista)
  If aIdiomas.Count > 0 Then cmbIdiomaArticulo.Index = cmbIdiomaArticulo.Find(aIdiomas[0])
  ' SIN TRADUCCIONES TODAVÍA: EL SELECTOR OFRECE LOS DEMÁS IDIOMAS DE LA REVISTA
  ArmarIdiomasTraduccion("")
  ArmarIdiomasTextos("")
  ArmarIdiomasDeclaracion("")
  ArmarDestinos()
  RedibujarRelaciones(-1)
  lblEstadoArticulo.Text = "Sin metadatos: se crean al guardar."
  FijarEdicion(True)
  $bCargando = False

End

' ============================================
' Función   : CargarEditor
' Propósito : Vuelca un artículo de la base al editor
' Parámetros: iFila As Integer — fila de la grilla
' Retorna   : nada
' ============================================
Private Sub CargarEditor(iFila As Integer)

  Dim rArticulo As Result
  Dim aLeidos As CContribuyente[]
  Dim oTextos As CTextosArticulo
  Dim oFin As CFinanciamientoArticulo
  Dim oRel As CRelacionesArticulo
  Dim iIndice As Integer
  Dim bPublicado As Boolean

  ' --- 1. LECTURA ---
  rArticulo = m_Articulo.CargarArticulo($aIds[iFila])
  If Not rArticulo Then Return

  ' --- 2. IDENTIFICACIÓN ---
  LimpiarEditor()
  $bCargando = True
  $iFila = iFila
  $iIdArticulo = $aIds[iFila]
  txtArchivoArticulo.Text = rArticulo!nombre_archivo
  ' Find DE UN Integer[] NO ACEPTA Null (MEDIDO: «Type mismatch»)
  If IsNull(rArticulo!id_seccion) Then
    cmbSeccionArticulo.Index = -1
  Else
    cmbSeccionArticulo.Index = $aIdsSecciones.Find(rArticulo!id_seccion)
  Endif
  If IsNull(rArticulo!id_dossier) Then
    cmbDossierArticulo.Index = 0
  Else
    cmbDossierArticulo.Index = $aIdsDossiers.Find(rArticulo!id_dossier)
  Endif
  cmbTipoArticulo.Index = m_Revistas.TiposArticulo().Find(rArticulo!article_type)
  ' Find DISTINGUE MAYÚSCULAS, IGUAL QUE EL COMBO DE SOLO LECTURA (SC-23)
  cmbIdiomaArticulo.Index = cmbIdiomaArticulo.Find(rArticulo!idioma_principal)
  txtTituloArticulo.Text = rArticulo!titulo
  txtSubtituloArticulo.Text = rArticulo!subtitulo
  txtTituloCortoArticulo.Text = rArticulo!titulo_corto
  ' TRADUCCIONES: A MEMORIA, Y A LA VISTA EL PRIMER IDIOMA DISPONIBLE
  $cTitulosTrad = m_Articulo.TextosTraducidos($iIdArticulo, "titulo")
  $cSubtitulosTrad = m_Articulo.TextosTraducidos($iIdArticulo, "subtitulo")
  ArmarIdiomasTraduccion("")

  ' --- 2 BIS. FECHAS E IDENTIFICADORES (ENTREGA D1) ---
  ' UN NULL DE LA BASE DEJA EL DateBox VACÍO (MEDIDO: Value ACEPTA Null)
  dtbRecepcionArticulo.Value = rArticulo!fecha_recepcion
  dtbRevisionArticulo.Value = rArticulo!fecha_revision
  dtbAceptacionArticulo.Value = rArticulo!fecha_aceptacion
  dtbPublicacionArticulo.Value = rArticulo!fecha_publicacion
  txtDoiArticulo.Text = rArticulo!doi
  txtPaginasArticulo.Text = m_Articulo.TextoPaginas(rArticulo!pagina_inicio, rArticulo!pagina_fin)
  ' TINYINT(1) LLEGA COMO Boolean (RC-GM-01)
  chkAnonimosArticulo.Value = rArticulo!autores_anonimos
  txaNotasAutorArticulo.Text = rArticulo!notas_autor

  ' --- 3. PERMISOS: VACÍO ES «HEREDA» ---
  PrepararHerencia()
  cmbLicenciaArticulo.Text = rArticulo!licencia
  txtUrlLicenciaArticulo.Text = rArticulo!url_licencia
  txtTitularArticulo.Text = rArticulo!titular_copyright
  txtAnioCopyrightArticulo.Text = If(IsNull(rArticulo!anio_copyright), "", CStr(rArticulo!anio_copyright))
  If IsNull(rArticulo!tipo_acceso) Then
    cmbAccesoArticulo.Index = 0
  Else
    iIndice = $aAccesoCodigos.Find(rArticulo!tipo_acceso)
    If iIndice < 0 Then iIndice = 0
    cmbAccesoArticulo.Index = iIndice
  Endif

  ' --- 4. CONTRIBUYENTES ---
  aLeidos = m_Articulo.ContribuyentesArticulo($iIdArticulo)
  If aLeidos Then
    $aContribuyentes = aLeidos
  Else
    ' NO SE PUDIERON LEER (YA SE INFORMÓ): GUARDAR LOS BORRARÍA
    $bContribuyentesIlegibles = True
  Endif
  RedibujarContribuyentes(-1)

  ' --- 5. TEXTOS POR IDIOMA ---
  ' PRIMERO SE MIRA SI HAY ALGO QUE LA PESTAÑA NO PUEDE MOSTRAR ENTERO
  $sAvisoTextos = m_Articulo.AvisoTextosNoEditables($iIdArticulo)
  oTextos = m_Articulo.TextosArticulo($iIdArticulo)
  If oTextos Then
    $oTextos = oTextos
  Else
    ' NO SE PUDIERON LEER (YA SE INFORMÓ): GUARDAR LOS BORRARÍA
    If $sAvisoTextos = "" Then $sAvisoTextos = "No se pudieron leer los resúmenes y las palabras clave."
  Endif
  ' LA SECCIÓN DECIDE SI EL RESUMEN ES SIMPLE O ESTRUCTURADO (ENTREGA C2)
  If IsNull(rArticulo!id_seccion) Then
    m_Articulo.CargarPlantilla($oTextos, 0)
  Else
    m_Articulo.CargarPlantilla($oTextos, rArticulo!id_seccion)
  Endif
  ArmarIdiomasTextos("")

  ' --- 5 BIS. FINANCIAMIENTO Y DECLARACIONES (ENTREGA D2) ---
  oFin = m_Articulo.FinanciamientoArticulo($iIdArticulo)
  If oFin Then
    $oFin = oFin
  Else
    ' NO SE PUDIERON LEER (YA SE INFORMÓ): GUARDAR LOS BORRARÍA
    $bFinIlegible = True
  Endif
  RedibujarFinanciadores(-1)
  ArmarIdiomasDeclaracion("")

  ' --- 5 TER. RELACIONES Y UBICACIONES (ENTREGA D3) ---
  oRel = m_Articulo.RelacionesArticulo($iIdArticulo)
  If oRel Then
    $oRel = oRel
  Else
    ' NO SE PUDIERON LEER (YA SE INFORMÓ): GUARDAR LAS BORRARÍA
    $bRelIlegible = True
  Endif
  ' EL COMBO DE DESTINO EXCLUYE A ESTE ARTÍCULO: SE ARMA CON SU id YA FIJADO
  ArmarDestinos()
  RedibujarRelaciones(-1)
  MostrarUbicaciones()

  ' --- 6. ESTADO: UN PUBLICADO ES DE SOLO LECTURA (DECISIÓN 17) ---
  bPublicado = (rArticulo!estado = "publicado")
  lblEstadoArticulo.Text = "Estado: " & m_Articulo.LeyendaEstado(rArticulo!estado)
  If Not $aConArchivo[iFila] Then lblEstadoArticulo.Text &= "  ·  Huérfana: falta el archivo en articulos/"
  FijarEdicion(Not bPublicado)
  If $bContribuyentesIlegibles Then
    btnGuardarArticulo.Enabled = False
    lblEstadoArticulo.Text &= "  ·  No se pudieron leer los contribuyentes: no se puede guardar"
  Endif
  If $sAvisoTextos <> "" Then
    btnGuardarArticulo.Enabled = False
    lblEstadoArticulo.Text &= "  ·  " & $sAvisoTextos & " No se puede guardar desde acá."
  Endif
  If $bFinIlegible Then
    btnGuardarArticulo.Enabled = False
    lblEstadoArticulo.Text &= "  ·  No se pudieron leer el financiamiento y las declaraciones: no se puede guardar"
  Endif
  If $bRelIlegible Then
    btnGuardarArticulo.Enabled = False
    lblEstadoArticulo.Text &= "  ·  No se pudieron leer las relaciones y ubicaciones: no se puede guardar"
  Endif
  $bCargando = False

End

' ============================================
' Función   : FijarEdicion
' Propósito : Habilita o bloquea la edición de las pestañas y el guardado. Con
'             la edición bloqueada, los contribuyentes se pueden abrir para
'             ver pero no cambiar
' Parámetros: bEditable As Boolean — False: solo lectura (publicado)
' Retorna   : nada
' ============================================
Private Sub FijarEdicion(bEditable As Boolean)

  svwIdentificacion.Enabled = bEditable
  svwPermisos.Enabled = bEditable
  btnGuardarArticulo.Enabled = bEditable
  ' LA GRILLA QUEDA VIVA PARA ABRIR Y VER; LOS BOTONES QUE CAMBIAN, NO
  hbxBotonesContribuyentes.Enabled = True
  btnPersonaContribuyente.Enabled = bEditable
  btnColectivoContribuyente.Enabled = bEditable
  btnQuitarContribuyente.Enabled = bEditable
  btnSubirContribuyente.Enabled = bEditable
  btnBajarContribuyente.Enabled = bEditable
  $bSoloLectura = Not bEditable
  ' TEXTOS: SOLO LECTURA Y NO APAGADOS, PARA QUE UN PUBLICADO SE PUEDA LEER Y
  ' RECORRER; EL SELECTOR DE IDIOMA SIGUE VIVO
  txaResumen.ReadOnly = Not bEditable
  txaSeccionResumen.ReadOnly = Not bEditable
  txaPalabrasAutor.ReadOnly = Not bEditable
  ' CONTROLADAS: LA LISTA ELEGIDA SE VE; BUSCAR, AGREGAR Y REORDENAR, NO
  hbxBuscarControlado.Enabled = bEditable
  vbxBotonesControladas.Enabled = bEditable
  cmbVocabulario.Enabled = bEditable
  ' FECHAS: Enabled Y NO ReadOnly, QUE NO BLOQUEA EL CALENDARIO (RC-GM-14)
  svwFechasArticulo.Enabled = bEditable
  chkAnonimosArticulo.Enabled = bEditable
  txaNotasAutorArticulo.ReadOnly = Not bEditable
  ' FINANCIAMIENTO: LA GRILLA SE VE; LOS BOTONES Y LOS CAMPOS, SEGÚN EL ESTADO
  vbxBotonesFinanciadores.Enabled = bEditable
  FijarCamposFinanciador()
  txaDeclaracion.ReadOnly = Not bEditable
  ' RELACIONES: LA GRILLA SE VE; LOS BOTONES Y LOS CAMPOS, SEGÚN EL ESTADO.
  ' LAS URL, SOLO LECTURA Y NO APAGADAS, PARA PODER COPIARLAS
  vbxBotonesRelaciones.Enabled = bEditable
  FijarCamposRelacion()
  txtUrlPagina.ReadOnly = Not bEditable
  txtUrlHtml.ReadOnly = Not bEditable
  txtUrlPdf.ReadOnly = Not bEditable
  txtUrlEpub.ReadOnly = Not bEditable
  txtUrlXml.ReadOnly = Not bEditable

End

' ============================================
' Función   : cmbSeccionArticulo_Click
' Propósito : Una sección propone su article-type, si todavía no hay uno
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub cmbSeccionArticulo_Click()

  Dim sTipo As String
  Dim iIdSeccion As Integer

  ' --- 1. SECCIÓN ELEGIDA ---
  If $bCargando Then Return
  If cmbSeccionArticulo.Index < 0 Then Return
  iIdSeccion = $aIdsSecciones[cmbSeccionArticulo.Index]

  ' --- 2. SU PLANTILLA DECIDE CÓMO SE EDITA EL RESUMEN (ENTREGA C2) ---
  ' LO ESCRITO PASA ANTES A MEMORIA; SI EL MODO CAMBIA, LO QUE NO ENCAJE LO
  ' SEÑALA LA VALIDACIÓN AL GUARDAR, SIN BORRAR NADA
  GuardarTextosEnMemoria()
  m_Articulo.CargarPlantilla($oTextos, iIdSeccion)
  MostrarTextos()

  ' --- 3. ARTICLE-TYPE PROPUESTO, SI TODAVÍA NO HAY UNO ---
  If cmbTipoArticulo.Index >= 0 Then Return
  sTipo = m_Articulo.TipoDeSeccion(iIdSeccion)
  If sTipo <> "" Then cmbTipoArticulo.Index = m_Revistas.TiposArticulo().Find(sTipo)

End

' ============================================
' Función   : cmbLicenciaArticulo_Click
' Propósito : Al elegir una licencia del catálogo, completa su URL
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub cmbLicenciaArticulo_Click()

  If $bCargando Then Return
  m_Licencias.CompletarUrl(cmbLicenciaArticulo, txtUrlLicenciaArticulo)

End

' ============================================
' Función   : btnGuardarArticulo_Click
' Propósito : Junta los valores de Identificación y Permisos y los graba por
'             m_Articulo
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnGuardarArticulo_Click()

  Dim cDatos As New Collection
  Dim iId As Integer
  Dim sArchivo As String
  Dim sAnio As String
  Dim i As Integer

  ' --- 1. HAY FILA ELEGIDA ---
  If $iFila < 0 Then Return
  sArchivo = $aArchivos[$iFila]
  ' LO ESCRITO EN LOS IDIOMAS A LA VISTA TODAVÍA NO PASÓ A MEMORIA
  GuardarTraduccionEnMemoria()
  GuardarTextosEnMemoria()
  GuardarFinanciadorEnMemoria()
  GuardarDeclaracionEnMemoria()
  GuardarRelacionEnMemoria()
  GuardarUbicacionesEnMemoria()

  ' --- 2. IDENTIFICACIÓN; UN VACÍO NO CREA SU CLAVE Y SE GRABA NULL (GV-68, GV-74) ---
  If cmbSeccionArticulo.Index >= 0 Then cDatos["id_seccion"] = $aIdsSecciones[cmbSeccionArticulo.Index]
  If cmbDossierArticulo.Index > 0 Then cDatos["id_dossier"] = $aIdsDossiers[cmbDossierArticulo.Index]
  If cmbTipoArticulo.Index >= 0 Then cDatos["article_type"] = cmbTipoArticulo.Text
  If cmbIdiomaArticulo.Index >= 0 Then cDatos["idioma_principal"] = cmbIdiomaArticulo.Text
  cDatos["titulo"] = Trim(txtTituloArticulo.Text)
  cDatos["subtitulo"] = Trim(txtSubtituloArticulo.Text)
  cDatos["titulo_corto"] = Trim(txtTituloCortoArticulo.Text)

  ' --- 3. PERMISOS: VACÍO ES «HEREDA» ---
  cDatos["licencia"] = Trim(cmbLicenciaArticulo.Text)
  cDatos["url_licencia"] = Trim(txtUrlLicenciaArticulo.Text)
  cDatos["titular_copyright"] = Trim(txtTitularArticulo.Text)
  sAnio = Trim(txtAnioCopyrightArticulo.Text)
  If sAnio <> "" Then
    ' SOLO DÍGITOS: Val ACEPTARÍA «20x6» A MEDIAS
    For i = 1 To Len(sAnio)
      If Mid(sAnio, i, 1) < "0" Or Mid(sAnio, i, 1) > "9" Then
        m_Sonido.sonar("Warning")
        Message.Warning("El año del copyright tiene que ser un número entero.")
        tsArticulo.Index = 4
        txtAnioCopyrightArticulo.SetFocus()
        Return
      Endif
    Next
    cDatos["anio_copyright"] = CInt(sAnio)
  Endif
  If cmbAccesoArticulo.Index > 0 Then cDatos["tipo_acceso"] = $aAccesoCodigos[cmbAccesoArticulo.Index]

  ' --- 3 BIS. FECHAS E IDENTIFICADORES (ENTREGA D1); UNA FECHA VACÍA NO CREA SU CLAVE ---
  If Not IsNull(dtbRecepcionArticulo.Value) Then cDatos["fecha_recepcion"] = dtbRecepcionArticulo.Value
  If Not IsNull(dtbRevisionArticulo.Value) Then cDatos["fecha_revision"] = dtbRevisionArticulo.Value
  If Not IsNull(dtbAceptacionArticulo.Value) Then cDatos["fecha_aceptacion"] = dtbAceptacionArticulo.Value
  If Not IsNull(dtbPublicacionArticulo.Value) Then cDatos["fecha_publicacion"] = dtbPublicacionArticulo.Value
  ' EL DOI SE GUARDA SIN EL RESOLVEDOR: LO QUE PIDE EL DEPÓSITO EN CROSSREF
  cDatos["doi"] = m_Articulo.NormalizarDoi(txtDoiArticulo.Text)
  txtDoiArticulo.Text = cDatos["doi"]
  cDatos["autores_anonimos"] = If(chkAnonimosArticulo.Value, 1, 0)
  cDatos["notas_autor"] = Trim(txaNotasAutorArticulo.Text)

  ' --- 4. GRABACIÓN ---
  iId = m_Articulo.GuardarArticulo($iIdArticulo, $iIdNumero, sArchivo, cDatos, $cTitulosTrad, $cSubtitulosTrad, $aContribuyentes, $oTextos, $oFin, $oRel)
  If iId = 0 Then Return

  ' --- 5. RELECTURA MANTENIENDO LA SELECCIÓN ---
  m_Sonido.sonar("Info")
  CargarLista()
  i = $aArchivos.Find(sArchivo)
  If i >= 0 Then
    gvArticulos.Row = i
    CargarEditor(i)
  Endif

End

