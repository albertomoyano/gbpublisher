' ============================================
Public Sub cmbIdiomaDeclaracion_Click()

  If $bCargando Then Return
  GuardarDeclaracionEnMemoria()
  $sIdiomaDecl = cmbIdiomaDeclaracion.Text
  MostrarDeclaracion()

End

' ============================================
' Función   : ArmarDestinos
' Propósito : Llena el combo de destino: «externo» y los artículos de la
'             revista, menos el que está en edición
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub ArmarDestinos()

  Dim rDatos As Result
  Dim bCargandoAntes As Boolean

  ' --- 1. EL PRIMER ÍTEM ES EL EXTERNO (id 0) ---
  bCargandoAntes = $bCargando
  $bCargando = True
  cmbDestinoRelacion.Clear()
  $aIdsDestino.Clear()
  cmbDestinoRelacion.Add("(externo: DOI o datos de cita abajo)")
  $aIdsDestino.Add(0)

  ' --- 2. ARTÍCULOS DE LA REVISTA; SI FALLA, QUEDA SOLO EL EXTERNO (YA SE INFORMÓ) ---
  rDatos = m_Articulo.ArticulosDeLaRevista($iIdNumero, $iIdArticulo)
  If rDatos Then
    While rDatos.Available
      cmbDestinoRelacion.Add(m_Articulo.EtiquetaArticulo(rDatos!volumen, rDatos!numero, rDatos!nombre_archivo, rDatos!titulo))
      $aIdsDestino.Add(rDatos!id_articulo)
      rDatos.MoveNext
    Wend
  Endif
  $bCargando = bCargandoAntes

End

' ============================================
' Función   : RedibujarRelaciones
' Propósito : Llena la grilla de relaciones desde la memoria, que es la
'             fuente, y pone en los campos la elegida
' Parámetros: iElegido As Integer — fila a dejar elegida; -1 ninguna
' Retorna   : nada
' ============================================
Private Sub RedibujarRelaciones(iElegido As Integer)

  Dim oRelacion As CRelacion
  Dim sDestino As String
  Dim i As Integer

  ' --- 1. GRILLA: TIPO Y DESTINO ---
  gvRelaciones.Rows.Count = $oRel.aRelaciones.Count
  For i = 0 To $oRel.aRelaciones.Count - 1
    oRelacion = $oRel.aRelaciones[i]
    gvRelaciones[i, 0].Text = oRelacion.sTipo
    If oRelacion.iIdLocal > 0 Then
      sDestino = oRelacion.sLocal
    Else
      ' EXTERNO: EL DOI SI LO HAY; SI NO, REVISTA Y AÑO
      sDestino = oRelacion.sDoi
      If sDestino = "" Then
        sDestino = oRelacion.sRevista
        If oRelacion.sAnio <> "" Then sDestino &= " (" & oRelacion.sAnio & ")"
      Endif
    Endif
    gvRelaciones[i, 1].Text = sDestino
  Next

  ' --- 2. ELEGIDA Y CAMPOS ---
  If iElegido >= $oRel.aRelaciones.Count Then iElegido = $oRel.aRelaciones.Count - 1
  $iRelacion = iElegido
  If iElegido >= 0 Then gvRelaciones.Row = iElegido
  MostrarRelacion()

End

' ============================================
' Función   : MostrarRelacion
' Propósito : Pone en los campos la relación elegida; sin relación, los
'             vacía y los apaga
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub MostrarRelacion()

  Dim oRelacion As CRelacion
  Dim bCargandoAntes As Boolean
  Dim iIndice As Integer

  ' --- 1. LOS Click DE LOS COMBOS NO ACTÚAN MIENTRAS SE LLENAN (GV-53) ---
  bCargandoAntes = $bCargando
  $bCargando = True

  ' --- 2. SIN RELACIÓN: CAMPOS VACÍOS ---
  If $iRelacion < 0 Then
    cmbTipoRelacion.Index = -1
    If cmbDestinoRelacion.Count > 0 Then cmbDestinoRelacion.Index = 0
    txtDoiRelacion.Text = ""
    txtRevistaRelacion.Text = ""
    txtAnioRelacion.Text = ""
    txtVolumenRelacion.Text = ""
    txtNumeroRelacion.Text = ""
    txtFpageRelacion.Text = ""
    txtLpageRelacion.Text = ""
  Else
    ' --- 3. LA ELEGIDA ---
    oRelacion = $oRel.aRelaciones[$iRelacion]
    cmbTipoRelacion.Index = m_Articulo.TiposRelacionCodigos().Find(oRelacion.sTipo)
    iIndice = $aIdsDestino.Find(oRelacion.iIdLocal)
    ' UN DESTINO QUE EL COMBO NO TRAE (NO SE PUDO LEER LA LISTA) SE AGREGA
    ' PARA NO PERDERLO AL GUARDAR
    If iIndice < 0 Then
      cmbDestinoRelacion.Add(oRelacion.sLocal)
      $aIdsDestino.Add(oRelacion.iIdLocal)
      iIndice = $aIdsDestino.Count - 1
    Endif
    cmbDestinoRelacion.Index = iIndice
    txtDoiRelacion.Text = oRelacion.sDoi
    txtRevistaRelacion.Text = oRelacion.sRevista
    txtAnioRelacion.Text = oRelacion.sAnio
    txtVolumenRelacion.Text = oRelacion.sVolumen
    txtNumeroRelacion.Text = oRelacion.sNumero
    txtFpageRelacion.Text = oRelacion.sFpage
    txtLpageRelacion.Text = oRelacion.sLpage
  Endif
  FijarCamposRelacion()
  $bCargando = bCargandoAntes

End

' ============================================
' Función   : FijarCamposRelacion
' Propósito : Los campos se editan si hay una relación elegida y el artículo
'             no está publicado; los del externo, solo si el destino es
'             externo
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub FijarCamposRelacion()

  Dim bHabilitados As Boolean
  Dim bExterno As Boolean

  bHabilitados = ($iRelacion >= 0)
  If $bSoloLectura Then bHabilitados = False
  bExterno = bHabilitados
  If cmbDestinoRelacion.Index > 0 Then bExterno = False
  hbxTipoRelacion.Enabled = bHabilitados
  hbxDestinoRelacion.Enabled = bHabilitados
  hbxDoiRelacion.Enabled = bExterno
  hbxRevistaRelacion.Enabled = bExterno
  hbxCitaRelacion.Enabled = bExterno
  hbxPaginasRelacion.Enabled = bExterno

End

' ============================================
' Función   : GuardarRelacionEnMemoria
' Propósito : Pasa los campos a la relación elegida y refresca su fila. Un
'             destino local descarta los datos del externo: se graba solo
'             el id
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub GuardarRelacionEnMemoria()

  Dim oRelacion As CRelacion

  ' --- 1. HAY RELACIÓN ELEGIDA Y SE PUEDE EDITAR ---
  If $iRelacion < 0 Or $bSoloLectura Then Return
  oRelacion = $oRel.aRelaciones[$iRelacion]

  ' --- 2. TIPO ---
  If cmbTipoRelacion.Index >= 0 Then
    oRelacion.sTipo = m_Articulo.TiposRelacionCodigos()[cmbTipoRelacion.Index]
  Else
    oRelacion.sTipo = ""
  Endif

  ' --- 3. DESTINO: LOCAL (SOLO EL id) O EXTERNO (SUS DATOS) ---
  If cmbDestinoRelacion.Index > 0 Then
    oRelacion.iIdLocal = $aIdsDestino[cmbDestinoRelacion.Index]
    oRelacion.sLocal = cmbDestinoRelacion.Text
    oRelacion.sDoi = ""
    oRelacion.sRevista = ""
    oRelacion.sAnio = ""
    oRelacion.sVolumen = ""
    oRelacion.sNumero = ""
    oRelacion.sFpage = ""
    oRelacion.sLpage = ""
  Else
    oRelacion.iIdLocal = 0
    oRelacion.sLocal = ""
    ' EL DOI SIN RESOLVEDOR, COMO EL DEL ARTÍCULO
    oRelacion.sDoi = m_Articulo.NormalizarDoi(txtDoiRelacion.Text)
    oRelacion.sRevista = Trim(txtRevistaRelacion.Text)
    oRelacion.sAnio = Trim(txtAnioRelacion.Text)
    oRelacion.sVolumen = Trim(txtVolumenRelacion.Text)
    oRelacion.sNumero = Trim(txtNumeroRelacion.Text)
    oRelacion.sFpage = Trim(txtFpageRelacion.Text)
    oRelacion.sLpage = Trim(txtLpageRelacion.Text)
  Endif
  RedibujarRelaciones($iRelacion)

End

' ============================================
' Función   : gvRelaciones_Click
' Propósito : Cambia la relación elegida, guardando antes la anterior
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub gvRelaciones_Click()

  Dim iFila As Integer

  iFila = gvRelaciones.Row
  If iFila < 0 Or iFila = $iRelacion Then Return
  GuardarRelacionEnMemoria()
  $iRelacion = iFila
  MostrarRelacion()

End

