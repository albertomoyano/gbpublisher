'             «externo» los prende
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub cmbDestinoRelacion_Click()

  If $bCargando Then Return
  FijarCamposRelacion()

End

' ============================================
' Función   : btnNuevaRelacion_Click
' Propósito : Agrega una relación vacía (destino externo) al final y la deja
'             elegida
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnNuevaRelacion_Click()

  Dim oRelacion As CRelacion

  If $iFila < 0 Then Return
  GuardarRelacionEnMemoria()
  ' New NO SE ADMITE COMO ARGUMENTO (GV-32)
  oRelacion = New CRelacion
  $oRel.aRelaciones.Add(oRelacion)
  RedibujarRelaciones($oRel.aRelaciones.Count - 1)
  cmbTipoRelacion.SetFocus()

End

' ============================================
' Función   : btnQuitarRelacion_Click
' Propósito : Quita la relación elegida (se borra de la base al guardar)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnQuitarRelacion_Click()

  If $iRelacion < 0 Then Return
  $oRel.aRelaciones.Remove($iRelacion)
  RedibujarRelaciones($iRelacion)

End

' ============================================
' Función   : btnSubirRelacion_Click
' Propósito : Sube la relación elegida un lugar
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnSubirRelacion_Click()

  If $iRelacion < 0 Then Return
  GuardarRelacionEnMemoria()
  RedibujarRelaciones($oRel.MoverRelacion($iRelacion, -1))

End

' ============================================
' Función   : btnBajarRelacion_Click
' Propósito : Baja la relación elegida un lugar
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub btnBajarRelacion_Click()

  If $iRelacion < 0 Then Return
  GuardarRelacionEnMemoria()
  RedibujarRelaciones($oRel.MoverRelacion($iRelacion, 1))

End

' ============================================
' Función   : CajaUrl
' Propósito : El TextBox de la URL de cada tipo de ubicación
' Parámetros: sTipo As String — pagina, html, pdf, epub o xml
' Retorna   : TextBox — su caja
' ============================================
Private Function CajaUrl(sTipo As String) As TextBox

  Select Case sTipo
    Case "pagina"
      Return txtUrlPagina
    Case "html"
      Return txtUrlHtml
    Case "pdf"
      Return txtUrlPdf
    Case "epub"
      Return txtUrlEpub
    Case Else
      Return txtUrlXml
  End Select

End

' ============================================
' Función   : MostrarUbicaciones
' Propósito : Pone en las cajas las URL que hay en memoria
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub MostrarUbicaciones()

  Dim sTipo As String

  ' UNA CLAVE AUSENTE DEVUELVE Null, QUE EN UN Text QUEDA VACÍO
  For Each sTipo In m_Articulo.TiposUbicacion()
    CajaUrl(sTipo).Text = $oRel.cUbicaciones[sTipo]
  Next

End

' ============================================
' Función   : GuardarUbicacionesEnMemoria
' Propósito : Pasa las cajas a memoria; una caja vacía no crea su clave
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub GuardarUbicacionesEnMemoria()

  Dim sTipo As String

  If $bSoloLectura Then Return
  $oRel.cUbicaciones = New Collection
  For Each sTipo In m_Articulo.TiposUbicacion()
    ' "" NO CREA LA CLAVE (GV-68): SIN FILA EN LA BASE
    $oRel.cUbicaciones[sTipo] = Trim(CajaUrl(sTipo).Text)
  Next

End
