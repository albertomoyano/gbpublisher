' ============================================
' Función   : ArmarIdiomasDeclaracion
' Propósito : Llena el selector de idioma de las declaraciones con el mismo
'             criterio que «Textos por idioma»: el principal, los de la
'             revista y los que ya tienen declaraciones
' Parámetros: sPreferido As String — idioma a dejar a la vista ("" = el
'             principal)
' Retorna   : nada
' ============================================
Private Sub ArmarIdiomasDeclaracion(sPreferido As String)

  Dim aLista As New String[]
  Dim aClave As String[]
  Dim sIdioma As String
  Dim sTexto As String
  Dim bCargandoAntes As Boolean
  Dim iIndice As Integer

  ' --- 1. INICIALIZACIÓN: LOS Click DEL COMBO NO DEBEN ACTUAR (GV-53) ---
  bCargandoAntes = $bCargando
  $bCargando = True

  ' --- 2. PRINCIPAL, REVISTA E IDIOMAS CON DECLARACIONES ---
  If cmbIdiomaArticulo.Index >= 0 Then aLista.Add(cmbIdiomaArticulo.Text)
  For Each sIdioma In $aIdiomasRevista
    If aLista.Find(sIdioma) < 0 Then aLista.Add(sIdioma)
  Next
  For Each sTexto In $oFin.cDeclaraciones
    aClave = Split($oFin.cDeclaraciones.Key, "|")
    If aLista.Find(aClave[1]) < 0 Then aLista.Add(aClave[1])
  Next

  ' --- 3. SELECTOR ---
  cmbIdiomaDeclaracion.List = aLista
  If aLista.Count = 0 Then
    $sIdiomaDecl = ""
  Else
    iIndice = aLista.Find(sPreferido)
    If iIndice < 0 Then iIndice = 0
    cmbIdiomaDeclaracion.Index = iIndice
    $sIdiomaDecl = aLista[iIndice]
  Endif
  MostrarDeclaracion()

  ' --- 4. LIMPIEZA ---
  $bCargando = bCargandoAntes

End

' ============================================
' Función   : MostrarDeclaracion
' Propósito : Pone en el área la declaración del tipo y del idioma elegidos
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub MostrarDeclaracion()

  If $sTipoDecl = "" Or $sIdiomaDecl = "" Then
    txaDeclaracion.Text = ""
    Return
  Endif
  ' UNA CLAVE AUSENTE SE LEE Null, QUE VA AL ÁREA COMO VACÍO (GV-68)
  txaDeclaracion.Text = $oFin.cDeclaraciones[$oFin.ClaveDeclaracion($sTipoDecl, $sIdiomaDecl)]

End

' ============================================
' Función   : GuardarDeclaracionEnMemoria
' Propósito : Pasa el área a la declaración del tipo y del idioma elegidos.
'             Vacía la borra (GV-68)
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Private Sub GuardarDeclaracionEnMemoria()

  If $sTipoDecl = "" Or $sIdiomaDecl = "" Or $bSoloLectura Then Return
  $oFin.cDeclaraciones[$oFin.ClaveDeclaracion($sTipoDecl, $sIdiomaDecl)] = Trim(txaDeclaracion.Text)

End

' ============================================
' Función   : cmbTipoDeclaracion_Click
' Propósito : Otro tipo de declaración: guarda lo escrito y muestra el otro
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub cmbTipoDeclaracion_Click()

  If $bCargando Then Return
  GuardarDeclaracionEnMemoria()
  If cmbTipoDeclaracion.Index >= 0 Then $sTipoDecl = $aTiposDecl[cmbTipoDeclaracion.Index]
  MostrarDeclaracion()

End

' ============================================
' Función   : cmbIdiomaDeclaracion_Click
' Propósito : Otro idioma: guarda lo escrito y muestra el otro
