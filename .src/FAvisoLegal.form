# Gambas Form File 3.0

{ Form Form
  Move(0,0,960,600)
  #Scaled = False
  #Translate = False
  Text = "Aviso de Ausencia de Garantía y Condiciones de la Licencia"
  Resizable = False
  Arrangement = Arrange.Vertical
  Centered = True
  Spacing = True
  Margin = True
  Padding = 4
  { HBoxBotonCerrarTerminos HBox
    Move(18,18,549,36)
    #Translate = False
    { Spring1 Spring
      Move(18,0,45,36)
    }
    { !ButtonCerrarLegal Button
      Move(387,0,144,36)
      #Public = True
      Text = ("Cerrar")
      Picture = Picture["iconos/salir.png"]
    }
  }
  { HtmlViewLegales HtmlView
    Move(18,63,306,144)
    Expand = True
  }
  { hbAceptar HBox
    Move(18,216,558,36)
    #Translate = False
    { btnAceptar Button
      Move(0,0,360,36)
      Font = Font["Bold"]
      Background = &H9FFF7F
      Expand = True
      Text = ("Acepto los términos. Continuar con la aplicación")
    }
  }
}
