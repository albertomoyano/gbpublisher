' ============================================
' Función   : SanitizarClaveBibtex
' Propósito : Normaliza una clave BibTeX eliminando caracteres no permitidos
'             Solo se aceptan A-Z (normalizados a mayúscula), 0-9 y guión corto
' Parámetros: sClave As String — texto crudo ingresado por el usuario
' Retorna   : String — clave sanitizada, o cadena vacía si no hay caracteres válidos
' ============================================
Private Function SanitizarClaveBibtex(sClave As String) As String

  ' --- 1. Normalización inicial ---
  Dim sNormalizada As String

  sNormalizada = UCase(Trim(sClave))

  ' --- 2. Filtrado carácter por carácter ---
  Dim sResultado As String
  Dim i As Integer
  Dim c As String

  For i = 1 To String.Len(sNormalizada)
    c = String.Mid(sNormalizada, i, 1)
    ' SOLO SE ACEPTAN LETRAS MAYÚSCULAS, DÍGITOS Y GUIÓN CORTO
    If c Like "[A-Z0-9-]" Then
      sResultado &= c
    Endif
  Next

  Return sResultado

End Function

