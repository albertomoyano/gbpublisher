End

' ============================================
' Función   : LimpiarTabStrip
' Propósito : Recorre TODAS las solapas de un TabStrip, no solo la visible.
' Parámetros: hPanel     As TabStrip — control a recorrer
'             aExcluidos As String[] — nombres de control a saltear
' Retorna   : String[] — descripciones de lo encontrado, sin repetir
' Nota      : DOS COMPORTAMIENTOS VERIFICADOS EMPÍRICAMENTE:
'             1. .Children DEVUELVE SOLO LA SOLAPA VISIBLE. RECORRER CON
'                .Children LIMPIABA ÚNICAMENTE LO QUE EL USUARIO TENÍA A LA
'                VISTA AL APRETAR GUARDAR, QUE ES PEOR QUE NO LIMPIAR: DA LA
'                IMPRESIÓN DE ESTAR RESUELTO.
'             2. EL ACCESO INDEXADO hPanel[i] DEVUELVE UN OBJETO VIRTUAL Y DA
'                "Bad use of virtual class", TANTO ASIGNADO A UNA VARIABLE
'                COMO PASADO DIRECTO COMO ARGUMENTO. ES DE LA MISMA FAMILIA
'                QUE txtEditor[i] (RF-02) Y gvNombre.Data (GV-15).
'             POR ESO SE RECORRE CAMBIANDO Index, QUE ES PROPIEDAD COMÚN, Y SE
'             RESTAURA LA SOLAPA ORIGINAL AL TERMINAR.
' ============================================
Public Function LimpiarTabStrip(hPanel As TabStrip, aExcluidos As String[]) As String[]

  Dim aTotal As New String[]
  Dim aParcial As String[]
  Dim sDesc As String
  Dim i As Integer
  Dim iIndiceOriginal As Integer

  ' --- 1. RECORDAR LA SOLAPA QUE EL USUARIO TENÍA A LA VISTA ---
  iIndiceOriginal = hPanel.Index

  ' --- 2. RECORRIDO DE TODAS LAS SOLAPAS ---
  ' SE OCULTA EL CONTROL DURANTE EL RECORRIDO PARA QUE NO SE VEA PASAR LAS
  ' SEIS SOLAPAS.
  hPanel.Visible = False

  For i = 0 To hPanel.Count - 1
    hPanel.Index = i
    aParcial = LimpiarControlesPegados(hPanel, aExcluidos)
    For Each sDesc In aParcial
      If Not aTotal.Exist(sDesc) Then aTotal.Add(sDesc)
    Next
  Next

  ' --- 3. RESTAURACIÓN ---
  hPanel.Index = iIndiceOriginal
  hPanel.Visible = True

  Return aTotal

End
