Public Sub mostrarIguales()

  If FMain.txtTitle.Text = "" Then
    m_Sonido.sonar("Warning")
    Message.Warning("Debe introducir contenido a buscar.")
    Return
  Else
    Dim sConsulta As String = "SELECT * FROM bibtex WHERE title LIKE &1 AND id_proyecto = &2"
    ' ID DESDE LA GLOBAL (RC-GM-16)
    ContenidoBib = m_ConexionBD.mConn.Exec(sConsulta, "%" & Trim(FMain.txtTitle.Text) & "%", m_InicioCierre.IdProyectoEnCurso)
    CargarDatosResultados(FMain.gvReferenciasEnCurso, ContenidoBib)
  Endif

End

Public Sub EliminarBibtex()

  ' --- 1. VALIDAR QUE HAYA UNA ENTRADA SELECCIONADA ---
  If FMain.id_bibtex.Text = "" Then
    m_Sonido.sonar("Info")
    Message.Info("Debe primero seleccionarse la entrada a borrar.")
    Return
  Endif

  ' --- 2. CONFIRMAR LA BAJA (CANCELAR = NO TOCAR NADA) ---
  m_Sonido.sonar("Question")
  If Message.Question("¿Desea borrar la entrada?", "Sí", "No") <> 1 Then Return

  ' --- 3. BORRAR EN BD Y CONFIRMAR ---
  ' PARAMETRIZADO + Commit: SIN Commit LA BAJA NO SE PERSISTE, NO LA VEN LAS OTRAS
  ' MÁQUINAS (autocommit OFF) Y SE PIERDE POR ROLLBACK AL DESCONECTAR. RC-GM-02.
  Try m_ConexionBD.mConn.Exec("DELETE FROM bibtex WHERE id = &1", FMain.id_bibtex.Text)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo borrar la entrada:" & Chr(10) & Error.Text)
    Return
  Endif
  Try m_ConexionBD.mConn.Commit

  ' --- 4. RECARGAR EL GRID ---
  ' IniciarBibtex UNIFICA EL RELOAD (LIMPIA TEXTBOX + RECARGA POR EVENTO Data) Y
  ' YA RESIEMBRA LA HUELLA, ASÍ QUE EL TIMER LOCAL NO RECARGA DE MÁS
  IniciarBibtex()

  ' --- 5. ESTADO FINAL DE BOTONES ---
  FMain.BtnNuevoBib.Visible = True
  FMain.btnGuardarBib.Visible = False
  FMain.btnGuardarCambiosBib.Visible = False
  FMain.BtnEliminarBib.Visible = False
  FMain.btnGuardarIGUAL.Visible = False

End

Public Sub IniciarBibtex()

  Dim iniBIB As String

  LimpiarTextboxBibtex()
  iniBIB = "SELECT * FROM bibtex WHERE id_proyecto = &1 ORDER BY id DESC"
  ' FUENTE DE VERDAD DEL ID: GLOBAL DE SESIÓN, NO EL CONTROL (RC-GM-16)
  ContenidoBib = m_ConexionBD.mConn.Exec(iniBIB, m_InicioCierre.IdProyectoEnCurso)
  If ContenidoBib.Available Then
    FMain.gvReferenciasEnCurso.Clear
    FMain.gvReferenciasEnCurso.Rows.Count = ContenidoBib.Count
    FMain.gvReferenciasEnCurso.Refresh
  Else
    FMain.gvReferenciasEnCurso.Rows.Count = 0
  Endif
  ' SEMBRAR LA HUELLA CON LO RECIÉN CARGADO (BASE PARA EL TIMER DE FONDO)
  SembrarHuellaReferencias()

End

Public Sub GuardarBibtexPrimeraVez()

  ' VERIFICAMOS CAMPOS
  If VerificacionBase() Then Return

  ContenidoBib = m_ConexionBD.mConn.Create("bibtex")
  GuardarCamposBib()
  ContenidoBib.Update()
  m_ConexionBD.mConn.Commit()
  IniciarBibtex()   ' ERA RefrescarTableViewBibtexEnCurso()

  RefrescarTableViewBibtexEnCurso()
  m_Sonido.sonar("Info")
  Message.Info("La referencia se guardó con éxito.")
Catch
  m_Sonido.sonar("Error")
  Message.Error("Error al intentar guardar la entrada: " & Error.Text)

End

