' ============================================
' Función   : ExtraerYGuardarReferenciasDelEditor
' Propósito : Parsea el contenido del archivo abierto en el editor
'             buscando citekeys en todos los formatos Pandoc:
'               [@key], [-@key], [ver @key], [@key, p. 5],
'               [@key1; @key2], [@key1; -@key2], etc.
'             y los guarda como CSV en la columna referencias_citadas
'             de la tabla correspondiente según el tipo de proyecto:
'               - TIPO_REVISTA_MD → articulos.referencias_citadas
'               - TIPO_LIBRO_MD   → capitulos.referencias_citadas
'
'             Reemplaza a ExtraerYGuardarReferenciasDelArticulo
'             (versión anterior solo para revistas). El renombre
'             refleja que la función es agnóstica del tipo: opera
'             sobre lo que hay en el editor, sea artículo o capítulo.
'
'             Prefijos válidos: fm-, a-, bm-. Cualquier otro archivo
'             se ignora silenciosamente. El caso especial bm-99-colofon
'             no tiene registro en BD por diseño y también se ignora.
'
' Parámetros: sContenidoMD  As String — contenido completo del .md
'             sRutaArchivo  As String — ruta completa del .md abierto
' Retorna   : Boolean — True si se guardó exitosamente o si el archivo
'                       no requiere procesamiento (prefijo no aplicable
'                       o colofón reservado)
' ============================================
Public Function ExtraerYGuardarReferenciasDelEditor(sContenidoMD As String, sRutaArchivo As String) As Boolean

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim sNombreArchivo As String
  Dim sPrefijoTres As String
  Dim sPrefijoDos As String
  Dim bPrefijoValido As Boolean
  Dim sTabla As String
  Dim sColumnaId As String
  Dim iIdRegistro As Integer
  Dim sLinea As String
  Dim aLineas As String[]
  Dim sCitekeys As String
  Dim aEncontradas As New String[]
  Dim colUnicas As New Collection
  Dim iPos As Integer
  Dim iPosFin As Integer
  Dim iPosAt As Integer
  Dim iPosEspacio As Integer
  Dim iPosComa As Integer
  Dim sBloque As String
  Dim aPartes As String[]
  Dim sParte As String
  Dim sCitekey As String
  Dim hResult As Result

  ' --- 2. VALIDACIÓN DE ENTRADA: NOMBRE Y PREFIJO ---
  ' EXTRAER NOMBRE DE ARCHIVO SIN EXTENSIÓN NI RUTA
  sNombreArchivo = File.BaseName(sRutaArchivo)

  ' CHEQUEAR PREFIJOS VÁLIDOS EN LIBROS Y REVISTAS
  '   fm-  → front-matter (LIBROS)
  '   a-   → articulos    (LIBROS Y REVISTAS)
  '   bm-  → back-matter  (LIBROS)
  sPrefijoTres = Left(sNombreArchivo, 3)
  sPrefijoDos = Left(sNombreArchivo, 2)
  bPrefijoValido = (sPrefijoTres = "fm-" Or sPrefijoTres = "bm-" Or sPrefijoDos = "a-")

  If Not bPrefijoValido Then
    ' NO ES UN CAPÍTULO/ARTÍCULO: NO HAY NADA QUE HACER
    Return True
  Endif

  ' EL COLOFÓN NO TIENE REGISTRO EN BD (CONVENCIÓN DE LIBROS)
  If sNombreArchivo = "bm-99-colofon" Then
    Return True
  Endif

  ' --- 3. RESOLVER TABLA DESTINO SEGÚN TIPO DE PROYECTO ---
  ' USAR FMain.TipoProyectoActual (SETEADO EN AbrirProyecto) EN LUGAR
  ' DE INTENTAR AMBAS TABLAS: EVITA AMBIGÜEDAD Y AHORRA UNA QUERY.
  Select Case FMain.TipoProyectoActual
    Case m_Constantes.TIPO_REVISTA_MD
      sTabla = "articulos"
      sColumnaId = "id_articulo"
    Case m_Constantes.TIPO_LIBRO_MD
      sTabla = "capitulos"
      sColumnaId = "id_capitulo"
    Case Else
      ' TIPO NO SOPORTADO PARA GUARDADO DE REFERENCIAS (EJ. LATEX)
      Return True
  End Select

  ' --- 4. BUSCAR REGISTRO EN LA BD POR nombre_archivo ---
  Try hResult = m_ConexionBD.mConn.Exec(
    "SELECT " & sColumnaId & " FROM " & sTabla &
    " WHERE nombre_archivo = &1 AND id_proyecto = &2 LIMIT 1",
    sNombreArchivo,
    m_InicioCierre.IdProyectoEnCurso)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al buscar el archivo en la base de datos:" & Chr(10) &
      Error.Text)
    Return False
  Endif

  If Not hResult.Available Then
    m_Sonido.sonar("Warning")
    Message.Warning("El archivo " & sNombreArchivo &
      " no tiene registro en la base de datos." & Chr(10) &
      "Las referencias citadas no se pudieron guardar.")
    Return False
  Endif

  iIdRegistro = hResult[sColumnaId]

  ' --- 5. PARSEAR EL CONTENIDO MD BUSCANDO CITEKEYS EN FORMATOS PANDOC ---
  ' CUBRE: [@key], [-@key], [ver @key], [@key, p. 5], [@key1; @key2], ETC.
  aLineas = Split(sContenidoMD, Chr(10))

  For Each sLinea In aLineas

    ' BUSCAR TODOS LOS BLOQUES ENTRE CORCHETES [ ... ] EN LA LÍNEA
    iPos = 1

    While InStr(sLinea, "[", iPos) > 0
      iPos = InStr(sLinea, "[", iPos)

      ' BUSCAR EL CIERRE ]
      iPosFin = InStr(sLinea, "]", iPos)
      If iPosFin = 0 Then Break

      ' EXTRAER EL CONTENIDO ENTRE [ Y ]
      sBloque = Mid(sLinea, iPos + 1, iPosFin - iPos - 1)

      ' DESCARTAR BLOQUES SIN @ (LINKS DE MARKDOWN, IMÁGENES, ATRIBUTOS)
      If InStr(sBloque, "@") = 0 Then
        iPos = iPosFin + 1
        Continue
      Endif

      ' EL BLOQUE PUEDE TENER MÚLTIPLES CITAS SEPARADAS POR ;
      ' EJEMPLOS: @key1; @key2  /  @key1; -@key2  /  ver @key1; @key2
      aPartes = Split(sBloque, ";")

      For Each sParte In aPartes
        sParte = Trim(sParte)

        ' BUSCAR @ DENTRO DE LA PARTE
        ' CUBRE: @key, -@key, ver @key, cf. @key, ETC.
        iPosAt = InStr(sParte, "@")
        If iPosAt = 0 Then Continue

        sCitekey = Trim(Mid(sParte, iPosAt + 1))

        ' ELIMINAR LOCALIZADOR: @key, p. 45 → key
        ' TOMAR SOLO HASTA EL PRIMER ESPACIO O COMA
        iPosEspacio = InStr(sCitekey, " ")
        iPosComa = InStr(sCitekey, ",")

        If iPosEspacio > 0 And (iPosComa = 0 Or iPosEspacio < iPosComa) Then
          sCitekey = Left(sCitekey, iPosEspacio - 1)
        Else If iPosComa > 0 Then
          sCitekey = Left(sCitekey, iPosComa - 1)
        Endif

        sCitekey = Trim(sCitekey)

        ' FILTRAR FALSOS POSITIVOS: LOS CITEKEYS NO CONTIENEN PUNTO
        ' ESTO DESCARTA EMAILS COMO usuario@dominio.com
        If InStr(sCitekey, ".") > 0 Then Continue

        ' GUARDAR SOLO SI NO ESTÁ DUPLICADA Y TIENE CONTENIDO
        If sCitekey <> "" And Not colUnicas.Exist(sCitekey) Then
          colUnicas[sCitekey] = True
          aEncontradas.Add(sCitekey)
        Endif
      Next

      ' AVANZAR LA POSICIÓN PARA SEGUIR BUSCANDO EN LA MISMA LÍNEA
      iPos = iPosFin + 1
    Wend
  Next

  ' --- 6. CONSTRUIR EL STRING SEPARADO POR COMAS ---
  sCitekeys = aEncontradas.Join(",")

  ' --- 7. GUARDAR EN LA TABLA CORRESPONDIENTE ---
  Try m_ConexionBD.mConn.Exec(
    "UPDATE " & sTabla & " SET referencias_citadas = &1 " &
    "WHERE " & sColumnaId & " = &2",
    sCitekeys,
    iIdRegistro)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("Error al guardar las referencias citadas:" & Chr(10) &
      Error.Text)
    Return False
  Endif

  Return True

Catch
  m_Sonido.sonar("Error")
  Message.Error("Error inesperado al procesar referencias:" & Chr(10) &
    Error.Text)
  Return False

End Function

Public Sub RellenarEditorTypes(Combos As ComboBox[])

  Dim rsEditor As Result
  Dim cmb As ComboBox

  Try rsEditor = m_ConexionBD.mConn.Exec("SELECT nombre FROM cmb_biblatex WHERE tipo='editor_type' AND activo=TRUE ORDER BY nombre;")
  If Error Then
    Message.Warning("Error al obtener editor_type: " & Error.Text)
    Error.Clear
    Return
  Endif

  For Each cmb In Combos
    cmb.Clear
    While rsEditor.Available
      cmb.Add(rsEditor["nombre"])
      rsEditor.MoveNext
    Wend
  Next

End

