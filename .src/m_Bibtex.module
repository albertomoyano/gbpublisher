Public Sub BuscarPorCampo(campo As TextBox, grid As GridView, campoBD As String)

  Dim sValor As String = Trim(campo.Text)
  Dim sConsulta As String
  Dim resultado As Result

  If sValor = "" Then
    m_Sonido.sonar("Warning")
    Message.Warning("Debe introducir contenido a buscar.")
    campo.SetFocus
    Return
  Endif

  ' ESCAPAR COMILLAS SIMPLES PARA EVITAR ERRORES SQL
  sValor = Replace(sValor, "'", "''")

  ' campoBD ES NOMBRE DE COLUMNA (NO PARAMETRIZABLE), VIENE DE UNA LISTA CERRADA
  ' DEL CÓDIGO, NO DEL USUARIO. sValor E id_proyecto SÍ VAN PARAMETRIZADOS:
  ' ANTES SE CONCATENABAN CRUDOS (DOBLE INYECCIÓN). ID DESDE LA GLOBAL (RC-GM-16)
  sConsulta = "SELECT * FROM bibtex WHERE " & campoBD & " LIKE &1 AND id_proyecto = &2"
  ' EJECUTAR CONSULTA EN VARIABLE LOCAL
  resultado = m_ConexionBD.mConn.Exec(sConsulta, "%" & sValor & "%", m_InicioCierre.IdProyectoEnCurso)

  ' VERIFICAR SI HAY RESULTADOS
  If resultado.Count = 0 Then
    m_Sonido.sonar("Info")
    Message.Info("No se ha encontrado ningún resultado.")
    Return  ' <-- SALE SIN TOCAR EL GRID
  Endif

  ' SOLO SI HAY RESULTADOS, CARGAR EN EL GRID
  CargarDatosResultados(grid, resultado)

End

Public Sub CargarDatosResultados(Grid As GridView, resultado As Result)

  Dim i As Integer
  Dim j As Integer

  ' LIMPIAR EL GRID ANTES DE MOSTRAR LOS RESULTADOS
  Grid.Clear()
  Grid.Rows.Count = resultado.Count

  ' LLENAR EL GRID CON LOS RESULTADOS
  For i = 0 To resultado.Count - 1
    For j = 0 To resultado.Fields.Count - 1
      If IsNull(resultado[j]) Then
        Grid[i, j].Text = ""
      Else
        Grid[i, j].Text = resultado[j]
      Endif
    Next
    resultado.MoveNext
  Next

End

Public Sub BuscarBibTeXEnEditor(grid As GridView, campoBD As String)

  Dim sConsulta As String
  Dim resultado As Result
  Dim sValor As String

  ' OBTENER EL TEXTO SELECCIONADO EN EL EDITOR
  sValor = Trim(m_EditorPrincipal.TextoSeleccionado())

  If sValor = "" Then
    m_Sonido.sonar("Warning")
    Message.Warning("No hay ningún texto seleccionado.")
    Return
  Endif

  ' LA REFERENCIA DEBE COMENZAR CON @
  If Left(sValor, 1) <> "@" Then
    m_Sonido.sonar("Warning")
    Message.Warning("El texto seleccionado debe comenzar con @ para ser entendida como una referencia BibTeX.")
    Return
  Endif

  ' ELIMINAR EL @ SI LA CLAVE EN LA BD NO LO CONTIENE
  sValor = Mid(sValor, 2)

  ' ESCAPAR COMILLAS SIMPLES
  sValor = Replace(sValor, "'", "''")

  ' campoBD ES NOMBRE DE COLUMNA (NO PARAMETRIZABLE), VIENE DE UNA LISTA CERRADA
  ' DEL CÓDIGO, NO DEL USUARIO. sValor E id_proyecto SÍ VAN PARAMETRIZADOS:
  ' ANTES SE CONCATENABAN CRUDOS (DOBLE INYECCIÓN). ID DESDE LA GLOBAL (RC-GM-16)
  sConsulta = "SELECT * FROM bibtex WHERE " & campoBD & " LIKE &1 AND id_proyecto = &2"
  ' EJECUTAR CONSULTA EN VARIABLE LOCAL
  resultado = m_ConexionBD.mConn.Exec(sConsulta, "%" & sValor & "%", m_InicioCierre.IdProyectoEnCurso)

  If resultado.Count = 0 Then
    m_Sonido.sonar("Info")
    Message.Info("No se ha encontrado ningún resultado.")
    Return
  Endif

  CargarDatosResultados(grid, resultado)

End

' ============================================
' Función   : SembrarHuellaReferencias
' Propósito : Fija la huella (cantidad + MAX(id)) del estado actual, derivándola
'             de ContenidoBib ya cargado SIN consulta extra (la primera fila es
'             el MAX(id) por el ORDER BY id DESC). Se llama al final de cada
'             recarga para que el timer solo detecte cambios posteriores.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub SembrarHuellaReferencias()

  ' --- 1. SIN RESULTADO: HUELLA EN CERO ---
  If ContenidoBib = Null Then
    $iUltimoCountRef = 0
    $iUltimoMaxIdRef = 0
    Return
  Endif

  ' --- 2. CANTIDAD ---
  $iUltimoCountRef = ContenidoBib.Count

  ' --- 3. MAX(id): PRIMERA FILA POR EL ORDER BY id DESC ---
  If ContenidoBib.Count = 0 Then
    $iUltimoMaxIdRef = 0
  Else
    ContenidoBib.MoveTo(0)
    $iUltimoMaxIdRef = ContenidoBib["id"]
  Endif

End

' ============================================
' Función   : RecargarSoloGridReferencias
' Propósito : Recarga ContenidoBib y reconstruye el grid SIN tocar los textbox
'             de edición. Variante no invasiva de IniciarBibtex para el refresco
'             de fondo (IniciarBibtex llama a LimpiarTextboxBibtex, que borraría
'             una edición en curso). Al terminar, resiembra la huella.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub RecargarSoloGridReferencias()

  ' --- 1. RECARGAR EL RESULTADO (MISMO SCOPE QUE IniciarBibtex: id_proyecto) ---
  ' GLOBAL DE SESIÓN COMO FUENTE DE VERDAD DEL ID (RC-GM-16)
  Try ContenidoBib = m_ConexionBD.mConn.Exec(
    "SELECT * FROM bibtex WHERE id_proyecto = &1 ORDER BY id DESC",
    m_InicioCierre.IdProyectoEnCurso)
  If Error Then Return   ' FALLO TRANSITORIO: NO TOCAR LA UI, REINTENTA AL SIGUIENTE TICK

  ' --- 2. RECONSTRUIR EL GRID (NULL CHECK ANIDADO, RC-GM-17) ---
  If ContenidoBib = Null Then
    FMain.gvReferenciasEnCurso.Rows.Count = 0
    SembrarHuellaReferencias()
    Return
  Endif

  If ContenidoBib.Available Then
    FMain.gvReferenciasEnCurso.Clear
    FMain.gvReferenciasEnCurso.Rows.Count = ContenidoBib.Count
    FMain.gvReferenciasEnCurso.Refresh
  Else
    FMain.gvReferenciasEnCurso.Rows.Count = 0
  Endif

  ' --- 3. RESEMBRAR LA HUELLA CON EL NUEVO ESTADO ---
  SembrarHuellaReferencias()

End

' ============================================
' Función   : RestaurarSeleccionReferencia
' Propósito : Reselecciona en el grid la referencia cuyo id se pasa, por clave
'             estable, tras una recarga que pudo mover las filas (alta/baja ajena).
'             Si la referencia ya no existe (borrada por otro), deja sin selección.
' Parámetros: iId As Integer — id de bibtex de la fila a reseleccionar
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub RestaurarSeleccionReferencia(iId As Integer)

  Dim iPos As Integer

  ' --- 1. NADA QUE RESTAURAR ---
  If iId <= 0 Then Return
  If ContenidoBib = Null Then Return
  If ContenidoBib.Count = 0 Then Return

  ' --- 2. BUSCAR LA POSICIÓN DE LA FILA CON ESE id Y RESELECCIONAR ---
  iPos = 0
  For Each ContenidoBib
    If ContenidoBib["id"] = iId Then
      bRefrescandoReferencias = True
      FMain.gvReferenciasEnCurso.Row = iPos   ' SELECCIONA Y HACE VISIBLE LA FILA
      bRefrescandoReferencias = False
      Return
    Endif
    Inc iPos
  Next

  ' --- 3. NO ENCONTRADA: FUE BORRADA POR OTRO, SIN SELECCIÓN ---

End

' ============================================
' Función   : VerificarCambiosReferencias
' Propósito : Handler de fondo (lo invoca el Timer de FMain). Con una consulta
'             barata (COUNT + MAX(id)) detecta si OTRO usuario dio de alta o baja
'             una referencia del proyecto abierto y, solo en ese caso, recarga el
'             grid preservando la fila seleccionada. Las modificaciones in-place
'             NO disparan recarga (la BD es la fuente de verdad; el .bib se
'             regenera al compilar).
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub VerificarCambiosReferencias()

  Dim rHuella As Result
  Dim iCount As Integer
  Dim iMaxId As Integer
  Dim iIdSeleccionado As Integer

  ' --- 1. GATE: SOLO CON PROYECTO ABIERTO ---
  ' VALE EN COMPLETO Y EN PARCIAL: OTRO USUARIO EN PARCIAL PUEDE TOCAR LAS
  ' REFERENCIAS DEL MISMO PROYECTO QUE ESTE TIENE EN COMPLETO (bibtex ES COMPARTIDA)
  If m_InicioCierre.IdProyectoEnCurso = 0 Then Return

  ' --- 2. GATE: NO REFRESCAR DURANTE UN ALTA EN PROGRESO ---
  ' btnGuardarBib VISIBLE = EL USUARIO ESTÁ CARGANDO UNA REFERENCIA NUEVA.
  ' SE DIFIERE AL PRÓXIMO TICK (CORTESÍA: NO MOVER FILAS MIENTRAS DA DE ALTA)
  If FMain.btnGuardarBib.Visible Then Return

  ' --- 3. LEER LA HUELLA (CONSULTA BARATA) ---
  ' REINICIAR EL SNAPSHOT DE LECTURA ANTES DE LEER: autocommit OFF + REPEATABLE
  ' READ (default InnoDB) DEJAN A ESTA SESIÓN VIENDO UN SNAPSHOT CONGELADO, POR LO
  ' QUE NUNCA DETECTARÍA LAS ALTAS/BAJAS COMMITEADAS POR OTRAS MÁQUINAS. UN Commit
  ' SIN NADA PENDIENTE CIERRA LA TRANSACCIÓN DE LECTURA Y FUERZA UN SNAPSHOT NUEVO.
  ' (EL TIMER NO PUEDE INTERLEAVEAR CON UN HANDLER EN CURSO — LOOP DE EVENTOS
  '  SINGLE-THREAD —, ASÍ QUE ACÁ NUNCA HAY UNA ESCRITURA A MEDIO CONFIRMAR.)
  Try m_ConexionBD.mConn.Commit
  Try rHuella = m_ConexionBD.mConn.Exec(
    "SELECT COUNT(*) AS c, MAX(id) AS m FROM bibtex WHERE id_proyecto = &1",
    m_InicioCierre.IdProyectoEnCurso)
  If Error Then Return
  If rHuella = Null Then Return
  If Not rHuella.Available Then Return

  iCount = rHuella["c"]
  ' MAX(id) ES NULL SI EL PROYECTO NO TIENE REFERENCIAS
  If IsNull(rHuella["m"]) Then
    iMaxId = 0
  Else
    iMaxId = rHuella["m"]
  Endif

  ' --- 4. COMPARAR CON LA ÚLTIMA HUELLA CONOCIDA ---
  ' COUNT DETECTA BAJAS; MAX(id) (auto_increment MONÓTONO) DETECTA ALTAS AUNQUE
  ' HAYA UNA BAJA SIMULTÁNEA. If ANIDADO (RC-GM-17)
  If iCount = $iUltimoCountRef Then
    If iMaxId = $iUltimoMaxIdRef Then Return   ' SIN CAMBIOS: NO TOCAR LA UI
  Endif

  ' --- 5. HUBO ALTA O BAJA: CAPTURAR LA SELECCIÓN ACTUAL POR id ESTABLE ---
  ' NULL CHECKS ANIDADOS (RC-GM-17). Row MAPEA 1:1 CON LA POSICIÓN EN ContenidoBib
  iIdSeleccionado = -1
  If FMain.gvReferenciasEnCurso.Row >= 0 Then
    If ContenidoBib <> Null Then
      If FMain.gvReferenciasEnCurso.Row < ContenidoBib.Count Then
        ContenidoBib.MoveTo(FMain.gvReferenciasEnCurso.Row)
        iIdSeleccionado = ContenidoBib["id"]
      Endif
    Endif
  Endif

  ' --- 6. RECARGAR SIN TOCAR TEXTBOX Y RESTAURAR SELECCIÓN ---
  ' RecargarSoloGridReferencias YA RESEMBRÓ LA HUELLA CON EL NUEVO ESTADO
  RecargarSoloGridReferencias()
  RestaurarSeleccionReferencia(iIdSeleccionado)

End

' ============================================
' Función   : NombreArchivoBib
' Propósito : Nombre del archivo .bib del proyecto en curso, derivado del
'             nombre del archivo del proyecto: l-LIBRO-PRUEBA.md produce
'             ref-l-LIBRO-PRUEBA.bib.
'             ÚNICO LUGAR DONDE ESTÁ ESCRITA ESA DERIVACIÓN. La consumen
'             ExportarBibTeX, que escribe el archivo, y
'             m_GenerarPDFLibro.GenerarPreambuloProyecto, que emite el
'             \addbibresource que lo busca. Si se calculara en los dos, el día
'             que cambie el prefijo el .bib se escribiría con un nombre y el
'             preámbulo apuntaría a otro: el libro compilaría con todas las
'             citas sin resolver y sin ningún error visible.
' Parámetros: (ninguno)
' Retorna   : String — nombre con extensión, sin ruta
' Nota      : File.BaseName devuelve el nombre SIN extensión (GV-01).
' ============================================
Public Function NombreArchivoBib() As String

  Return "ref-" & File.BaseName(m_InicioCierre.NombreProyectoEnCurso) & ".bib"

End

' ============================================
' Función   : InicializarMapaBiblatex
' Propósito : Construye la tabla que traduce el nombre de una columna de la
'             tabla bibtex al campo que espera biblatex. Las columnas usan
'             snake_case y biblatex no.
'             Una columna que no está acá se emite con su propio nombre, que
'             es lo correcto para author, title, volume, doi y compañía.
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno) — deja $cMapaBiblatex poblada
' Nota      : LAS CLAVES DE Collection SON CASE-SENSITIVE (GV-04). LOS NOMBRES
'             DE COLUMNA LLEGAN EN MINÚSCULA DESDE EL DRIVER, ASÍ QUE SE
'             ESCRIBEN EN MINÚSCULA ACÁ.
' ============================================
Private Sub InicializarMapaBiblatex()

  If $cMapaBiblatex Then Return

  $cMapaBiblatex = New Collection

  ' --- 1. PERSONAS Y ROLES ---
  $cMapaBiblatex["book_author"] = "bookauthor"
  $cMapaBiblatex["short_author"] = "shortauthor"
  $cMapaBiblatex["name_addon"] = "nameaddon"
  $cMapaBiblatex["editor_a"] = "editora"
  $cMapaBiblatex["editor_b"] = "editorb"
  $cMapaBiblatex["editor_c"] = "editorc"
  $cMapaBiblatex["editor_type"] = "editortype"
  $cMapaBiblatex["editor_type_a"] = "editortypea"
  $cMapaBiblatex["editor_type_b"] = "editortypeb"
  $cMapaBiblatex["editor_type_c"] = "editortypec"

  ' --- 2. TÍTULOS ---
  $cMapaBiblatex["sub_title"] = "subtitle"
  $cMapaBiblatex["title_addon"] = "titleaddon"
  $cMapaBiblatex["book_title"] = "booktitle"
  $cMapaBiblatex["book_title_addon"] = "booktitleaddon"
  $cMapaBiblatex["main_title"] = "maintitle"
  $cMapaBiblatex["main_title_addon"] = "maintitleaddon"
  $cMapaBiblatex["journal_title"] = "journaltitle"
  $cMapaBiblatex["journal_title_addon"] = "journaltitleaddon"
  $cMapaBiblatex["issue_title"] = "issuetitle"
  $cMapaBiblatex["issue_title_addon"] = "issuetitleaddon"
  $cMapaBiblatex["event_title"] = "eventtitle"
  $cMapaBiblatex["event_title_addon"] = "eventtitleaddon"
  $cMapaBiblatex["index_title"] = "indextitle"
  $cMapaBiblatex["short_title"] = "shorttitle"
  $cMapaBiblatex["reprint_title"] = "reprinttitle"

  ' --- 3. FECHAS ---
  $cMapaBiblatex["event_date"] = "eventdate"
  $cMapaBiblatex["orig_date"] = "origdate"
  $cMapaBiblatex["url_date"] = "urldate"

  ' --- 4. IDIOMA ---
  ' hyphenation ES EL NOMBRE VIEJO DE langid: SE RENOMBRÓ EN biblatex 2.8, EN
  ' 2013, Y SOLO SE CONSERVA COMO ALIAS DE COMPATIBILIDAD. LAS DOS COLUMNAS
  ' EXISTEN EN LA TABLA Y APUNTAN AL MISMO CAMPO, ASÍ QUE EL BUCLE DE EMISIÓN
  ' TIENE UNA GUARDA PARA NO ESCRIBIRLO DOS VECES.
  $cMapaBiblatex["hyphenation"] = "langid"
  $cMapaBiblatex["lang_id"] = "langid"
  ' LA COLUMNA TIENE UN TYPO DE ORIGEN: land POR lang. EL CAMPO DE biblatex ES
  ' langidopts, Y EL MAPEO ANTERIOR EMITÍA landidopts, QUE biber IGNORABA.
  $cMapaBiblatex["land_id_opts"] = "langidopts"
  $cMapaBiblatex["orig_language"] = "origlanguage"

  ' --- 5. PAGINACIÓN ---
  $cMapaBiblatex["page_total"] = "pagetotal"
  $cMapaBiblatex["book_pagination"] = "bookpagination"

  ' --- 6. EDICIÓN Y LUGAR ---
  $cMapaBiblatex["orig_publisher"] = "origpublisher"
  $cMapaBiblatex["orig_location"] = "origlocation"
  $cMapaBiblatex["how_published"] = "howpublished"
  $cMapaBiblatex["pub_state"] = "pubstate"

  ' --- 7. IDENTIFICADORES Y RELACIONES ---
  $cMapaBiblatex["eprint_type"] = "eprinttype"
  $cMapaBiblatex["related_type"] = "relatedtype"
  $cMapaBiblatex["related_string"] = "relatedstring"
  $cMapaBiblatex["cross_ref"] = "crossref"
  $cMapaBiblatex["entry_set"] = "entryset"
  $cMapaBiblatex["entry_sub_type"] = "entrysubtype"

  ' --- 8. ETIQUETAS Y ORDENAMIENTO ---
  $cMapaBiblatex["short_hand"] = "shorthand"
  $cMapaBiblatex["short_hand_intro"] = "shorthandintro"
  ' NO TENÍA MAPEO Y SALÍA LITERAL. EL CAMPO ES sortshorthand.
  $cMapaBiblatex["sort_hand"] = "sortshorthand"
  $cMapaBiblatex["pre_sort"] = "presort"
  $cMapaBiblatex["sort_key"] = "sortkey"
  $cMapaBiblatex["sort_name"] = "sortname"
  $cMapaBiblatex["sort_year"] = "sortyear"
  $cMapaBiblatex["sort_title"] = "sorttitle"
  $cMapaBiblatex["index_sort_title"] = "indexsorttitle"

  ' --- 9. TIPO DE TESIS ---
  ' EN biblatex EL TIPO DE UNA @thesis VA EN EL CAMPO type.
  $cMapaBiblatex["tipo_de_tesis"] = "type"

End

' ============================================
' Función   : CampoBiblatex
' Propósito : Traduce el nombre de una columna al campo de biblatex. Si no
'             está en el mapa, devuelve el nombre tal cual.
' Parámetros: sColumna As String — nombre de la columna
' Retorna   : String — nombre del campo para el .bib
' ============================================
Private Function CampoBiblatex(sColumna As String) As String

  InicializarMapaBiblatex()

  If $cMapaBiblatex.Exist(sColumna) Then
    Return $cMapaBiblatex[sColumna]
  Endif

  Return sColumna

End

' ============================================
' Función   : ExportarBibTeX
' Propósito : Escribe {proyecto}/referencias/ref-{proyecto}.bib con todas las
'             referencias del proyecto en curso.
'             El archivo se versiona, así que la salida tiene que ser
'             DETERMINISTA: mismos datos, mismo archivo, byte a byte. De ahí
'             el ORDER BY y la ausencia de marca de tiempo.
' Parámetros: (ninguno — trabaja sobre m_InicioCierre.IdProyectoEnCurso)
' Retorna   : Boolean — True si se escribió, False si falló con mensaje
' ============================================
Public Function ExportarBibTeX() As Boolean

  Dim hRes As Result
  Dim oCampo As ResultField
  Dim aColumnas As New String[]
  Dim cEmitidos As Collection
  Dim sSQL As String
  Dim s As String
  Dim sColumna As String
  Dim sCampo As String
  Dim sValor As String
  Dim sRelleno As String
  Dim sArchivo As String
  Dim iAncho As Integer

  ' COLUMNAS DE CONTROL: NO SON CAMPOS BIBLIOGRÁFICOS Y NO VAN AL .bib.
  ' SE SALTEAN POR NOMBRE Y NO POR POSICIÓN: UNA COLUMNA NUEVA INSERTADA EN EL
  ' MEDIO CORRÍA TODO Y EL .bib SALÍA CON LA CLAVE EQUIVOCADA, SIN ERROR.
  Dim aControl As String[] = ["id", "id_proyecto", "id_articulo",
    "tipo_de_entrada", "clave_bibtex"]

  ' --- 1. CONSULTA ---
  ' EL ORDER BY NO ES COSMÉTICO: SIN ÉL MySQL NO GARANTIZA EL ORDEN DE LAS
  ' FILAS, Y EL .bib PODRÍA SALIR DISTINTO CON LOS MISMOS DATOS. COMO EL
  ' ARCHIVO ESTÁ VERSIONADO, ESO PRODUCE UN DIFF QUE NO CORRESPONDE A NINGÚN
  ' CAMBIO REAL.
  sSQL = "SELECT * FROM bibtex WHERE id_proyecto = &1 ORDER BY clave_bibtex"

  Try hRes = m_ConexionBD.mConn.Exec(sSQL, m_InicioCierre.IdProyectoEnCurso)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudieron leer las referencias del proyecto:" &
      gb.NewLine & Error.Text)
    Return False
  Endif

  ' --- 2. INVENTARIO DE COLUMNAS Y ANCHO DE ALINEACIÓN ---
  ' EL ANCHO SE CALCULA SOBRE EL NOMBRE YA TRADUCIDO, QUE ES EL QUE SE IMPRIME.
  For Each oCampo In hRes.Fields
    If Not aControl.Exist(oCampo.Name) Then
      aColumnas.Add(oCampo.Name)
      sCampo = CampoBiblatex(oCampo.Name)
      If Len(sCampo) > iAncho Then iAncho = Len(sCampo)
    Endif
  Next

  ' --- 3. RECORRIDO DE LAS ENTRADAS ---
  s = ""

  While hRes.Available

    s &= "\n@" & hRes["tipo_de_entrada"] & "{" & hRes["clave_bibtex"] & ",\n"

    ' GUARDA DE CAMPO YA EMITIDO. hyphenation Y lang_id SON DOS COLUMNAS QUE
    ' APUNTAN AL MISMO CAMPO langid: SIN ESTO, UNA ENTRADA CON LAS DOS
    ' CARGADAS SALE CON langid DUPLICADO Y biber AVISA.
    cEmitidos = New Collection

    For Each sColumna In aColumnas

      ' RC-GM-17: And NO CORTOCIRCUITA. CON EL CAMPO EN NULL, EL Len(NULL) DE
      ' LA VERSIÓN ANTERIOR SE EJECUTABA IGUAL. VAN ANIDADOS.
      If Not IsNull(hRes[sColumna]) Then
        sValor = Trim(CStr(hRes[sColumna]))
        If sValor <> "" Then

          sCampo = CampoBiblatex(sColumna)

          If Not cEmitidos.Exist(sCampo) Then
            cEmitidos[sCampo] = True
            sRelleno = String$(iAncho - Len(sCampo), " ")
            s &= "  " & sCampo & sRelleno & " = {" & sValor & "},\n"
          Endif

        Endif
      Endif

    Next

    s &= "}\n"
    hRes.MoveNext

  Wend

  ' --- 4. FIRMA ---
  ' SIN FECHA NI VERSIÓN: CUALQUIER DATO QUE CAMBIE ENTRE DOS GENERACIONES
  ' IGUALES ENSUCIA EL DIFF Y ROMPE LA GUARDA DE DESACTUALIZACIÓN. EL
  ' REPOSITORIO YA FECHA EL COMMIT, QUE ES EL EVENTO REAL.
  s &= "\n\n@Comment{generado con gbpublisher}"

  ' --- 5. ESCRITURA ---
  ' File.Save OPERA EN UTF-8 NATIVAMENTE (SC-02).
  sArchivo = m_InicioCierre.RutaProyectoEnCurso &/ "referencias" &/ NombreArchivoBib()

  Try File.Save(sArchivo, s)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo escribir el archivo de referencias:" & gb.NewLine &
      sArchivo & gb.NewLine & Error.Text)
    Return False
  Endif

  ' NO SE VERIFICA CON Exist(): SI EL ARCHIVO QUEDÓ DE UNA CORRIDA ANTERIOR Y
  ' EL GUARDADO FALLÓ, DEVOLVERÍA True IGUAL. EL Try ES LA VERIFICACIÓN.
  Return True

End

' ============================================
' Función   : LimpiarControlesPegados
' Propósito : Recorre los controles de texto de un contenedor y les quita los
'             caracteres invisibles que llegan pegados desde Word.
'             Actúa SOBRE LOS CONTROLES y no sobre los valores al escribir en
'             la base, porque las validaciones posteriores comparan el
'             contenido del control.
' Parámetros: hContenedor As Container — contenedor a recorrer
'             aExcluidos  As String[]  — nombres de control a saltear
' Retorna   : String[] — descripciones de lo encontrado, sin repetir
' Nota      : RECURSIVA, PORQUE LOS CAMPOS ESTÁN EN CONTENEDORES ANIDADOS.
'             EL HALLAZGO VUELVE POR RETORNO Y NO POR PARÁMETRO DE SALIDA: EN
'             GAMBAS LOS PRIMITIVOS SE PASAN SIEMPRE POR VALOR, CON ByRef O
'             SIN ÉL (GV-24).
' ============================================
Public Function LimpiarControlesPegados(hContenedor As Container, aExcluidos As String[]) As String[]

  Dim hCtrl As Control
  Dim aTotal As New String[]
  Dim aParcial As String[]
  Dim sDesc As String

  ' --- 1. RECORRIDO DE LOS HIJOS ---
  For Each hCtrl In hContenedor.Children

    ' --- 2. CONTENEDOR: BAJAR UN NIVEL ---
    If hCtrl Is Container Then
      aParcial = LimpiarControlesPegados(hCtrl, aExcluidos)
      For Each sDesc In aParcial
        If Not aTotal.Exist(sDesc) Then aTotal.Add(sDesc)
      Next
      Continue
    Endif

    ' --- 3. CONTROL DE TEXTO: LIMPIAR SI NO ESTÁ EXCLUIDO ---
    ' LOS If VAN ANIDADOS Y NO ENCADENADOS CON And, QUE NO CORTOCIRCUITA
    ' (RC-GM-17)
    If hCtrl Is TextBox Then
      If Not aExcluidos.Exist(hCtrl.Name) Then
        aParcial = m_FuncionesGenericas.DetectarInvisibles(TextBox(hCtrl).Text)
        If aParcial.Count > 0 Then
          TextBox(hCtrl).Text = m_FuncionesGenericas.LimpiarTextoPegado(TextBox(hCtrl).Text)
          For Each sDesc In aParcial
            If Not aTotal.Exist(sDesc) Then aTotal.Add(sDesc)
          Next
        Endif
      Endif
    Endif

  Next

  Return aTotal

End

' ============================================
' Función   : GuardarBibtex
' Propósito : Guarda una entrada bibliográfica nueva en el proyecto en curso,
'             después de validar la clave, los duplicados de título y los
'             caracteres inválidos.
' Parámetros: (ninguno — trabaja sobre los controles de FMain)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub GuardarBibtex()

  Dim rDuplicado As Result
  Dim aInvisibles As String[]

  ' --- 1. LIMPIEZA DE TEXTO PEGADO ---
  ' VA ANTES DEL CHEQUEO DE DUPLICADOS: ESE CHEQUEO COMPARA txtTitle.Text
  ' CRUDO, Y UN CARÁCTER INVISIBLE HACE QUE NO ENCUENTRE LA ENTRADA EXISTENTE.
  ' url, doi, file Y eprint QUEDAN AFUERA: AHÍ UN CARÁCTER QUE PARECE BASURA
  ' PUEDE SER PARTE DEL IDENTIFICADOR.
  aInvisibles = LimpiarTabStrip(FMain.TabPanelBibliografia,
    ["txtUrl", "txtDoi", "txtFile", "txtEprint"])

  If aInvisibles.Count > 0 Then
    m_Sonido.sonar("Info")
    Message.Info("El texto pegado traía caracteres invisibles de Word:" &
      gb.NewLine & "  " & aInvisibles.Join(gb.NewLine & "  ") & gb.NewLine &
      gb.NewLine & "Se limpiaron antes de guardar.")
  Endif

  ' --- 2. VALIDACIÓN DE LA CLAVE ---
  If Trim(FMain.txtClaveBibtex.Text) = "" Then
    m_Sonido.sonar("Info")
    Message.Info("Debe generar una clave." & gb.NewLine &
      "No es posible guardar la entrada.")
    Return
  Endif

  ' --- 3. VALIDACIONES DE CONTENIDO ---
  If VerificacionBase() Then Return
  If VerificarCaracteresInvalidos() Then Return

  ' --- 4. CHEQUEO DE TÍTULO DUPLICADO EN EL PROYECTO ---
  ' Result LOCAL PARA NO PISAR ContenidoBib, QUE ES LA FUENTE DE DATOS DEL
  ' GRID. EL ID DEL PROYECTO SALE DE LA GLOBAL (RC-GM-16): SI SE LEYERA DE UN
  ' CONTROL QUE UN EVENTO DE UI RESETEÓ, EL CHEQUEO CORRERÍA CONTRA
  ' id_proyecto = 0 Y TRAERÍA UN CONJUNTO EQUIVOCADO.
  Try rDuplicado = m_ConexionBD.mConn.Exec(
    "SELECT id FROM bibtex WHERE title = &1 AND id_proyecto = &2",
    Trim(FMain.txtTitle.Text), m_InicioCierre.IdProyectoEnCurso)

  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo verificar si el título ya existe:" & gb.NewLine &
      Error.Text)
    Return
  Endif

  If rDuplicado.Count > 0 Then
    m_Sonido.sonar("Error")
    Message.Error("El título que desea agregar ya existe en este libro/revista.")

    ' MOSTRAR LAS COINCIDENCIAS Y OFRECER GUARDAR IGUAL
    mostrarIguales()
    FMain.gvReferenciasEnCurso.ScrollY = 0
    FMain.BtnNuevoBib.Visible = True
    FMain.btnGuardarBib.Visible = False
    FMain.btnGuardarIGUAL.Visible = True
    FMain.TabPanel5.Index = 0
    Return
  Endif

  ' --- 5. ALTA ---
  GuardarBibtexPrimeraVez()
  LimpiarTextboxBibtex()

  ' --- 6. ESTADO FINAL DE LA INTERFAZ ---
  FMain.txtTMPbiblio.Enabled = False
  FMain.txtTMPbiblio.Background = Color.Background
  FMain.txtTMPbiblio.Clear
  FMain.TabPanel5.Index = 0

  FMain.BtnNuevoBib.Visible = True
  FMain.btnGuardarBib.Visible = False
  FMain.btnGuardarCambiosBib.Visible = False
  FMain.BtnEliminarBib.Visible = False
  ' ASEGURAR QUE EL TIPO DE TESIS QUEDE ESCONDIDO
  FMain.HBoxTipoDeTesis.Visible = False

Catch
  ' RED DE ÚLTIMO RECURSO (RC-GM-20). LOS FALLOS PREVISIBLES SE ATRAPAN CON
  ' Try + If Error EN SU PUNTO, PARA QUE EL MENSAJE DIGA QUÉ PASÓ.
  m_Sonido.sonar("Error")
  Message.Error("Se obtuvo el siguiente error al intentar guardar: <b>" &
    Error.Text & "</b>.")

End

' ============================================
' Función   : GuardarCambiosBibtex
' Propósito : Guarda los cambios de una entrada bibliográfica ya existente.
' Parámetros: (ninguno — trabaja sobre los controles de FMain)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub GuardarCambiosBibtex()

  Dim aInvisibles As String[]
  Dim iIdBibtex As Integer

  ' --- 1. LIMPIEZA DE TEXTO PEGADO ---
  ' MISMO CRITERIO QUE EN EL ALTA: SOBRE LOS CONTROLES Y ANTES DE VALIDAR.
  aInvisibles = LimpiarTabStrip(FMain.TabPanelBibliografia,
    ["txtUrl", "txtDoi", "txtFile", "txtEprint"])

  If aInvisibles.Count > 0 Then
    m_Sonido.sonar("Info")
    Message.Info("El texto pegado traía caracteres invisibles de Word:" &
      gb.NewLine & "  " & aInvisibles.Join(gb.NewLine & "  ") & gb.NewLine &
      gb.NewLine & "Se limpiaron antes de guardar.")
  Endif

  ' --- 2. VALIDACIÓN DE CONTENIDO ---
  If VerificacionBase() Then Return

  ' --- 3. VALIDACIÓN DEL IDENTIFICADOR ---
  ' PENDIENTE (RC-GM-16): ESTE ID DEBERÍA SALIR DE UNA VARIABLE Public DE
  ' m_InicioCierre Y NO DE UN CONTROL DE FMain, QUE PUEDE RESETEARSE POR UN
  ' EVENTO DE UI. MIENTRAS TANTO SE VALIDA, PARA QUE UN CONTROL VACÍO DÉ UN
  ' MENSAJE Y NO UN Edit CONTRA id = 0.
  If Not IsInteger(Trim(FMain.id_bibtex.Text)) Then
    m_Sonido.sonar("Error")
    Message.Error("No hay una referencia seleccionada para editar." & gb.NewLine &
      "Volvé a seleccionarla en la grilla.")
    Return
  Endif

  iIdBibtex = CInt(Trim(FMain.id_bibtex.Text))

  If iIdBibtex <= 0 Then
    m_Sonido.sonar("Error")
    Message.Error("No hay una referencia seleccionada para editar." & gb.NewLine &
      "Volvé a seleccionarla en la grilla.")
    Return
  Endif

  ' --- 4. BLOQUEO DE LA INTERFAZ DURANTE LA ESCRITURA ---
  FMain.btnGuardarCambiosBib.Visible = False
  FMain.BtnEliminarBib.Visible = False
  Wait

  ' --- 5. APERTURA DEL REGISTRO ---
  ' PLACEHOLDER Y NO CONCATENACIÓN (RC-GM-15)
  Try ContenidoBib = m_ConexionBD.mConn.Edit("bibtex", "id = &1", iIdBibtex)

  If Error Then
    FMain.btnGuardarCambiosBib.Visible = True
    FMain.BtnEliminarBib.Visible = True
    m_Sonido.sonar("Error")
    Message.Error("No se pudo abrir la referencia para editar:" & gb.NewLine &
      Error.Text)
    Return
  Endif

  If Not ContenidoBib.Available Then
    FMain.btnGuardarCambiosBib.Visible = True
    FMain.BtnEliminarBib.Visible = True
    m_Sonido.sonar("Error")
    Message.Error("No se encontró la referencia para editar.")
    Return
  Endif

  ' --- 6. ESCRITURA ---
  GuardarCamposBib()

  Try ContenidoBib.Update

  If Error Then
    FMain.btnGuardarCambiosBib.Visible = True
    FMain.BtnEliminarBib.Visible = True
    m_Sonido.sonar("Error")
    Message.Error("No se pudieron guardar los cambios:" & gb.NewLine & Error.Text)
    Return
  Endif

  ' EL Commit SOLO CORRE SI EL Update FUE BIEN. ANTES CORRÍA IGUAL, AUNQUE LA
  ' ESCRITURA HUBIERA FALLADO.
  Try m_ConexionBD.mConn.Commit()

  If Error Then
    FMain.btnGuardarCambiosBib.Visible = True
    FMain.BtnEliminarBib.Visible = True
    m_Sonido.sonar("Error")
    Message.Error("No se pudo confirmar la transacción:" & gb.NewLine & Error.Text)
    Return
  Endif

  ' --- 7. REFRESCO Y AVISO ---
  RefrescarTableViewBibtexEnCurso()
  FMain.gvReferenciasEnCurso.Refresh()
  LimpiarTextboxBibtex()
  m_Sonido.sonar("Info")
  Message.Info("Cambios guardados correctamente.")

  ' --- 8. ESTADO FINAL DE LA INTERFAZ ---
  FMain.BtnNuevoBib.Visible = True
  FMain.btnGuardarBib.Visible = False
  FMain.HBoxTipoDeTesis.Visible = False

Catch
  ' RED DE ÚLTIMO RECURSO (RC-GM-20)
  FMain.btnGuardarCambiosBib.Visible = True
  FMain.BtnEliminarBib.Visible = True
  m_Sonido.sonar("Error")
