' Gambas module file

' --- MAPA CONTROL → CAMPO DE biblatex (2.0.0) ---
' UN CONTROL POR CAMPO DEL CATÁLOGO (bibtex_campo_catalogo). LOS DATOS DE LA
' ENTRADA (tipo_de_entrada, clave_bibtex) NO ESTÁN ACÁ: SON COLUMNAS DE bibtex
Private $MapaCampos As New Collection
Public ContenidoBib As Result
Public mMapaPubState As New Collection
Public mPagination As New Collection ' y bookPagination
Public mEprint As New Collection
Public mRelatedType As New Collection
Public mTipoDeTesis As New Collection
Public mTipoDeEntrada As New Collection
' --- ESTADO DEL REFRESCO DE REFERENCIAS ---
' HUELLA (CANTIDAD + MAX(id)) DE LA ÚLTIMA CARGA CONOCIDA DEL GRID.
' PRIVADAS: SOLO LAS USA ESTE MÓDULO.
Private $iUltimoCountRef As Integer = -1
Private $iUltimoMaxIdRef As Integer = -1

' GUARD DE RE-ENTRADA (DEFENSIVO): True MIENTRAS EL REFRESCO DE FONDO REASIGNA
' gvReferenciasEnCurso.Row. LO LEE gvReferenciasEnCurso_Click POR SI SETEAR .Row
' LLEGARA A DISPARAR EL Click, PARA NO RE-VOLCAR LA FILA A LOS TEXTBOX. Public
' PORQUE LO LEE FMain.
Public bRefrescandoReferencias As Boolean = False

' --- INVERSA DE $MapaCampos: CAMPO → CONTROL. SE ARMA AL PRIMER USO ---
Private $cControlDeCampo As Collection

' --- EL CATÁLOGO DE CAMPOS (bibtex_campo_catalogo), LEÍDO UNA VEZ ---
' $aCampos EN EL ORDEN DEL .bib; $cLiteral: campo → True SI ES LITERAL
Private $aCampos As String[]
Private $cLiteral As Collection
Private $cAnterior As Collection
Private $iAnchoCampo As Integer

' --- ÚLTIMO ERROR Y ÚLTIMA CLAVE DE EscribirEntrada ---
Private $sUltimoErrorEscritura As String
Private $sUltimaClave As String

' --- COLUMNAS DE LA GRILLA DE REFERENCIAS (POSICIÓN EN ConsultaGrilla) ---
Public Const COL_ID As Integer = 0
Public Const COL_TIPO As Integer = 1
Public Const COL_CLAVE As Integer = 2
Public Const COL_AUTOR As Integer = 3
Public Const COL_EDITOR As Integer = 4
Public Const COL_TITULO As Integer = 5
Public Const COL_ANIO As Integer = 6
Public Const COL_FECHA As Integer = 7
Private Const COLUMNAS_GRILLA As Integer = 8

' --- CONTROLES DE LAS COLUMNAS DE LA ENTRADA (NO SON CAMPOS DEL CATÁLOGO) ---
Public Const CONTROL_TIPO As String = "cmbTipoDeEntrada"

' CLAVES DE LOCALIZACIÓN DE IDIOMA DE biblatex PARA language Y origlanguage:
' SON LAS lang<clave> DEFINIDAS EN spanish.lbx (biblatex 3.19). CON UNA DE
' ESTAS, biblatex IMPRIME EL NOMBRE TRADUCIDO («inglés»); CON OTRO VALOR LO
' IMPRIME TAL CUAL. DECISIÓN DEL 20/11/2026: SOLO SE ADMITEN ESTAS (SC-102).
' SI UNA VERSIÓN NUEVA DE biblatex AGREGA CLAVES, SE SUMAN ACÁ
Public Const CLAVES_IDIOMA_BIBLATEX As String = "american,brazilian,bulgarian,catalan,croatian,czech,danish,dutch,english,estonian,finnish,french,galician,german,greek,hungarian,italian,japanese,latin,latvian,norwegian,polish,portuguese,russian,slovak,slovene,spanish,swedish,ukrainian"

' ============================================
' Función   : ConfigurarTableViewBibtexEnCurso
' Propósito : Prepara la grilla de referencias: las ocho columnas de
'             ConsultaGrilla, con id, tipo y clave ocultos
' Parámetros: grid As GridView — la grilla a configurar
' Retorna   : nada
' Nota      : LAS COLUMNAS SE LEEN POR NOMBRE EN LA CONSULTA Y POR LAS
'             CONSTANTES COL_* EN LA GRILLA: YA NO DEPENDEN DEL ORDEN DE LAS
'             COLUMNAS DE LA TABLA (2.0.0)
' ============================================
Public Sub ConfigurarTableViewBibtexEnCurso(grid As GridView)

  Dim i As Integer

  With grid
    .Header = True
    .Grid = True
    .Columns.Count = COLUMNAS_GRILLA

    ' --- 1. TODAS OCULTAS ---
    For i = 0 To COLUMNAS_GRILLA - 1
      .Columns[i].Title = ""
      .Columns[i].Width = 0
    Next

    ' --- 2. LAS VISIBLES ---
    .Columns[COL_AUTOR].Title = "Autor"
    .Columns[COL_AUTOR].Width = 180
    .Columns[COL_EDITOR].Title = "Editor"
    .Columns[COL_EDITOR].Width = 180
    .Columns[COL_TITULO].Title = "Título"
    .Columns[COL_TITULO].Width = 340
    .Columns[COL_ANIO].Title = "Año"
    .Columns[COL_ANIO].Alignment = Align.Center
    .Columns[COL_ANIO].Width = 52
    .Columns[COL_FECHA].Title = "Fecha"
    .Columns[COL_FECHA].Width = 100
  End With

End

' ============================================
' Función   : CargarCatalogo
' Propósito : Lee bibtex_campo_catalogo una vez por sesión: los campos en el
'             orden del .bib, cuáles son literales y el ancho de alineación
'             del .bib. Controla que cada campo tenga su control en FMain
' Parámetros: (ninguno)
' Retorna   : Boolean — True si el catálogo está cargado
' Nota      : UN CAMPO SIN CONTROL SE PERDERÍA AL EDITAR LA ENTRADA: EL
'             GUARDADO REESCRIBE LOS PARES DESDE EL FORMULARIO. POR ESO ES UN
'             ERROR Y NO UN AVISO
' ============================================
Public Function CargarCatalogo() As Boolean

  Dim rDatos As Result
  Dim aCampos As New String[]
  Dim cLiteral As New Collection
  Dim cAnterior As New Collection
  Dim aSinControl As New String[]
  Dim sCampo As String
  Dim iAncho As Integer

  ' --- 1. YA CARGADO ---
  If $aCampos Then Return True

  ' --- 2. CONSULTA ---
  Try rDatos = m_ConexionBD.mConn.Exec("SELECT campo, literal, nombre_anterior FROM bibtex_campo_catalogo ORDER BY orden")
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo leer el catálogo de campos de la bibliografía " &
      "(¿falta la actualización de esquema 2.0.0?):" & gb.NewLine & Error.Text)
    Return False
  Endif

  ' --- 3. ARMADO ---
  ' literal ES TINYINT(1): SE COMPARA CON 1 Y NO SE TOMA COMO Boolean (RC-GM-01)
  While rDatos.Available
    sCampo = rDatos["campo"]
    aCampos.Add(sCampo)
    cLiteral[sCampo] = (CInt(rDatos["literal"]) = 1)
    If Not IsNull(rDatos["nombre_anterior"]) Then cAnterior[rDatos["nombre_anterior"]] = sCampo
    If Len(sCampo) > iAncho Then iAncho = Len(sCampo)
    rDatos.MoveNext
  Wend

  ' --- 4. CADA CAMPO TIENE SU CONTROL ---
  For Each sCampo In aCampos
    If ControlDeCampo(sCampo) = "" Then aSinControl.Add(sCampo)
  Next
  If aSinControl.Count > 0 Then
    m_Sonido.sonar("Error")
    Message.Error("Hay campos de la bibliografía sin control en el formulario:" &
      gb.NewLine & "  " & aSinControl.Join(", ") & gb.NewLine & gb.NewLine &
      "No se pueden editar referencias hasta corregirlo.")
    Return False
  Endif

  ' lang_id NO ESTÁ EN EL CATÁLOGO: SE UNIÓ A langid EN LA MIGRACIÓN
  cAnterior["lang_id"] = "langid"
  $aCampos = aCampos
  $cLiteral = cLiteral
  $cAnterior = cAnterior
  $iAnchoCampo = iAncho
  Return True

End

' ============================================
' Función   : EsCampo
' Propósito : Dice si un nombre es un campo del catálogo de biblatex
' Parámetros: sCampo As String — nombre del campo
' Retorna   : Boolean
' Nota      : ES LA GUARDA DE LAS CONSULTAS QUE ARMAN EL NOMBRE DEL CAMPO EN
'             EL SQL (SubconsultaCampo): UN NOMBRE FUERA DEL CATÁLOGO NO LLEGA
' ============================================
Public Function EsCampo(sCampo As String) As Boolean

  If Not CargarCatalogo() Then Return False
  Return $cLiteral.Exist(sCampo)

End

' ============================================
' Función   : CampoDeNombreAnterior
' Propósito : Traduce el nombre de una columna de bibtex anterior a la 2.0.0
'             (journal_title, hyphenation…) a su campo de biblatex. Lo usa la
'             importación de los JSON exportados antes de la 2.0.0
' Parámetros: sNombre As String — nombre de la columna vieja
' Retorna   : String — el campo, o vacío si no era una columna de datos
' ============================================
Public Function CampoDeNombreAnterior(sNombre As String) As String

  If Not CargarCatalogo() Then Return ""
  If $cAnterior.Exist(sNombre) Then Return $cAnterior[sNombre]
  Return ""

End

' ============================================
' Función   : SubconsultaCampo
' Propósito : Expresión SQL que devuelve el valor de un campo de una entrada,
'             para usar en un SELECT sobre bibtex: el reemplazo de la columna
'             que el campo tenía hasta la 2.0.0
' Parámetros: sCampo As String — campo del catálogo (author, journaltitle…)
'             sAlias As String — alias de bibtex en la consulta (por omisión b)
' Retorna   : String — «(SELECT …) AS `campo`», o vacío si el campo no está en
'             el catálogo
' Nota      : LA CLAVE PRIMARIA (id_bibtex, campo) HACE QUE CADA SUBCONSULTA
'             SEA UNA LECTURA POR ÍNDICE. EL NOMBRE VA EN EL SQL PORQUE NO ES
'             UN DATO DEL USUARIO: SE VALIDA CONTRA EL CATÁLOGO
' ============================================
Public Function SubconsultaCampo(sCampo As String, Optional sAlias As String = "b") As String

  If Not EsCampo(sCampo) Then Return ""
  Return "(SELECT c_" & sCampo & ".valor FROM bibtex_campo c_" & sCampo &
    " WHERE c_" & sCampo & ".id_bibtex = " & sAlias & ".id AND c_" & sCampo &
    ".campo = '" & sCampo & "') AS `" & sCampo & "`"

End

' ============================================
' Función   : ConsultaGrilla
' Propósito : SELECT de la grilla de referencias: id, tipo, clave, autor,
'             editor, título, año y fecha, en el orden de las constantes COL_*
' Parámetros: sFiltro As String — condición del WHERE sobre bibtex b; puede
'             llevar marcadores &1, &2… que completa el llamador
' Retorna   : String — la consulta, ordenada del id más nuevo al más viejo
' ============================================
Public Function ConsultaGrilla(sFiltro As String) As String

  Return "SELECT b.id, b.tipo_de_entrada, b.clave_bibtex, " &
    SubconsultaCampo("author") & ", " & SubconsultaCampo("editor") & ", " &
    SubconsultaCampo("title") & ", " & SubconsultaCampo("year") & ", " &
    SubconsultaCampo("date") &
    " FROM bibtex b WHERE " & sFiltro & " ORDER BY b.id DESC"

End

Public Function VerificarCaracteresInvalidos() As Boolean

  Dim aCampos As TextBox[] = [FMain.txtAuthor, FMain.book_author, FMain.txtEditor, FMain.txtEditorA, FMain.txtEditorB, FMain.txtEditorC]
  Dim aNombres As String[] = ["author", "bookauthor", "editor", "editor-a", "editor-b", "editor-c"]
  Dim i As Integer

  For i = 0 To aCampos.Max
    If InStr(aCampos[i].Text, ";") > 0 Then
      m_Sonido.sonar("Error")
      Message.Error("El campo de " & aNombres[i] & " no debe contener el carácter ; (punto y coma). Por favor, revisa tu entrada.")
      aCampos[i].SetFocus
      Return True ' INDICA QUE HAY UN ERROR
    End If
  Next

  Return False ' INDICA QUE TODO ESTÁ BIEN

End

' ============================================
' Función   : ProblemaOrdenesLatex
' Propósito : Dice si un valor de una referencia cumple la regla de las órdenes
'             de LaTeX (SC-58): solo \enquote{…}, \sptext{…}, \emph{…} y el
'             signo escapado \&, con
'             \enquote hasta el nivel que admite el campo, y las llaves
'             balanceadas. Es la regla que usan el formulario al guardar, la
'             exportación del .bib y el canónico (m_XML.TextoBibDocBook).
' Parámetros: sValor As String — el valor de un campo
'             iMaxEnquote As Integer — niveles de \enquote admitidos: 2 por
'                                      omisión, 1 en un título que el estilo
'                                      pone entre comillas (NivelesEnquote)
' Retorna   : String — "" si cumple; si no, qué falla
' Nota      : NO SE APLICA A LOS CAMPOS LITERALES (EsCampoLiteral): ES EL
'             LLAMADOR EL QUE LOS SALTEA.
'             SE RECORRE POR BYTES (Mid, Len): LAS MARCAS SON ASCII Y UN BYTE
'             DE UN CARÁCTER UTF-8 NUNCA ES «\», «{» NI «}».
'             LAS LLAVES SUELTAS SON LEGÍTIMAS: AGRUPAN UN NOMBRE
'             ({de la Fuente}) O PROTEGEN UNA MAYÚSCULA ({I}'ve).
'             LOS NIVELES: csquotes ADMITE DOS (maxlevel=2, MANUAL §2.1) Y EL
'             TERCERO CORTA EL PDF (MEDIDO). SI EL ESTILO YA PUSO COMILLAS AL
'             TÍTULO, EN EL DATO QUEDA UNO SOLO (DECISIÓN DE ALBERTO, SC-58).
' ============================================
Public Function ProblemaOrdenesLatex(sValor As String, Optional iMaxEnquote As Integer = 2) As String

  Dim i As Integer
  Dim j As Integer
  Dim sCaracter As String
  Dim sOrden As String
  Dim aGrupos As New String[]
  Dim sGrupo As String
  Dim iAbiertos As Integer

  ' --- 1. RECORRIDO ---
  ' aGrupos ES LA PILA DE LO QUE ESTÁ ABIERTO: «q» UN \enquote, «o» OTRA
  ' ORDEN, «g» UNA LLAVE SUELTA. CADA «}» CIERRA EL ÚLTIMO
  i = 1
  While i <= Len(sValor)
    sCaracter = Mid(sValor, i, 1)

    If sCaracter = "\\" Then
      ' EL & ESCAPADO: PARTE DEL TEXTO (UN journaltitle CON «&»). SIN LA
      ' BARRA, LaTeX LO TOMA COMO SEPARADOR DE COLUMNAS (DECISIÓN DE ALBERTO)
      If Mid(sValor, i, 2) = "\\&" Then
        i += 2
        Continue
      Endif

      ' LAS TRES ÓRDENES ADMITIDAS (DECISIÓN DE ALBERTO), CON SU LLAVE
      If Mid(sValor, i, 9) = "\\enquote{" Then
        ' LOS \enquote YA ABIERTOS: ESTE SERÍA EL SIGUIENTE NIVEL
        iAbiertos = 0
        For Each sGrupo In aGrupos
          If sGrupo = "q" Then Inc iAbiertos
        Next
        If iAbiertos >= iMaxEnquote Then
          If iMaxEnquote = 1 Then Return "un \\enquote dentro de otro \\enquote en un título que el estilo pone entre comillas (un solo nivel)"
          Return "tres niveles de \\enquote (csquotes admite dos)"
        Endif
        aGrupos.Push("q")
        i += 9
        Continue
      Else If Mid(sValor, i, 8) = "\\sptext{" Then
        aGrupos.Push("o")
        i += 8
        Continue
      Else If Mid(sValor, i, 6) = "\\emph{" Then
        aGrupos.Push("o")
        i += 6
        Continue
      Endif

      ' EL NOMBRE DE LA ORDEN, PARA EL MENSAJE: LAS LETRAS QUE SIGUEN
      j = i + 1
      While j <= Len(sValor)
        If Not (Mid(sValor, j, 1) Like "[A-Za-z]") Then Break
        Inc j
      Wend
      sOrden = Mid(sValor, i, j - i)
      If sOrden = "\\" Then sOrden = "\\" & Mid(sValor, i + 1, 1)
      ' UNA DE LAS TRES SIN SU LLAVE PEGADA NO ES UNA ORDEN DE OTRA FAMILIA
      If ["\\enquote", "\\sptext", "\\emph"].Exist(sOrden) Then
        Return "«" & sOrden & "» sin su llave «{» pegada"
      Endif
      Return "orden no admitida «" & sOrden & "» (solo \\enquote, \\sptext, \\emph y \\&)"
    Endif

    ' UN & SIN LA BARRA: EN LaTeX ES EL SEPARADOR DE COLUMNAS Y CORTA EL PDF
    ' («Misplaced alignment tab character &», MEDIDO)
    If sCaracter = "&" Then Return "«&» sin escapar: en las referencias se escribe \\&"

    If sCaracter = "{" Then
      aGrupos.Push("g")
    Else If sCaracter = "}" Then
      If aGrupos.Count = 0 Then Return "una llave «}» que no abrió ninguna «{»"
      aGrupos.Pop()
    Endif

    Inc i
  Wend

  ' --- 2. CIERRE ---
  If aGrupos.Count > 0 Then Return "falta cerrar " & CStr(aGrupos.Count) & " llave(s) «{»"

  Return ""

End

' ============================================
' Función   : NivelesEnquote
' Propósito : Cuántos niveles de \enquote admite un campo de una referencia:
'             uno en el título y el subtítulo de los tipos cuyo título algún
'             estilo pone entre comillas; dos en todo lo demás (SC-58).
' Parámetros: sCampo As String — el campo de biblatex
'             sTipo  As String — tipo_de_entrada
' Retorna   : Integer — 1 o 2
' Nota      : LA LISTA ES LA UNIÓN DE LOS ESTILOS DE LA APLICACIÓN, NO LA DEL
'             ESTILO DEL LIBRO: EL ESTILO SE PUEDE CAMBIAR DESPUÉS (MISMO
'             CRITERIO QUE RC-BL-02; DECISIÓN DE ALBERTO). SALE DEL FUENTE:
'               biblatex.def (3.19)   article inbook incollection inproceedings
'                                     patent thesis unpublished
'               philosophy-standard   article inreference (thesis EN CURSIVA)
'               ieee.bbx              online report
'               apa.bbx, iso.bbx      NINGUNO
'             conference ES EL ALIAS DE inproceedings EN biber.
'             EL SUBTÍTULO VA DENTRO DE LAS MISMAS COMILLAS QUE EL TÍTULO
'             (MEDIDO CON VERONA).
' ============================================
Public Function NivelesEnquote(sCampo As String, sTipo As String) As Integer

  Dim aTipos As String[] = ["article", "conference", "inbook", "incollection",
    "inproceedings", "inreference", "online", "patent", "report", "thesis",
    "unpublished"]

  ' EL CAMPO CON SU NOMBRE DE biblatex (2.0.0): subtitle, YA NO sub_title
  If sCampo <> "title" And sCampo <> "subtitle" Then Return 2
  If aTipos.Exist(LCase(Trim(sTipo))) Then Return 1
  Return 2

End

' ============================================
' Función   : EsCampoLiteral
' Propósito : Dice si un campo es de los que biblatex toma literal, sin
'             interpretar LaTeX: ahí no corre la regla de SC-58.
' Parámetros: sCampo As String — el campo de biblatex
' Retorna   : Boolean
' Nota      : LOS DE TIPO verbatim Y uri DEL MODELO DE DATOS DE biblatex
'             (blx-dm.def, 3.19): doi, eprint, file Y url. UNA URL PUEDE
'             LLEVAR «&» SIN ESCAPAR, Y ESTÁ BIEN.
'             DESDE LA 2.0.0 LA LISTA ES LA COLUMNA literal DEL CATÁLOGO
' ============================================
Public Function EsCampoLiteral(sCampo As String) As Boolean

  If Not CargarCatalogo() Then Return False
  If Not $cLiteral.Exist(sCampo) Then Return False
  Return $cLiteral[sCampo]

End
' ============================================
' Función   : VerificarOrdenesLatex
' Propósito : Antes de guardar una referencia, controla que los campos de texto
'             cumplan la regla de las órdenes de LaTeX (ProblemaOrdenesLatex).
'             Si alguno no la cumple, lo informa y la referencia no se guarda.
' Parámetros: (ninguno — trabaja sobre los controles de FMain)
' Retorna   : Boolean — True SI HAY UN ERROR (LA CONVENCIÓN DE
'             VerificarCaracteresInvalidos Y VerificacionBase)
' Nota      : RECORRE LAS SOLAPAS DE TabPanelBibliografia COMO LimpiarTabStrip.
'             LA CLAVE NO SE MIRA: LA SANEA SanitizarClaveBibtex.
' ============================================

Public Function VerificarOrdenesLatex() As Boolean

  Dim aTotal As New String[]
  Dim aParcial As String[]
  Dim sDesc As String
  Dim i As Integer
  Dim iIndiceOriginal As Integer

  ' --- 1. RECORRIDO DE TODAS LAS SOLAPAS ---
  ' SE OCULTA EL CONTROL DURANTE EL RECORRIDO, COMO EN LimpiarTabStrip
  iIndiceOriginal = FMain.TabPanelBibliografia.Index
  FMain.TabPanelBibliografia.Visible = False

  For i = 0 To FMain.TabPanelBibliografia.Count - 1
    FMain.TabPanelBibliografia.Index = i
    aParcial = OrdenesLatexEnControles(FMain.TabPanelBibliografia)
    For Each sDesc In aParcial
      If Not aTotal.Exist(sDesc) Then aTotal.Add(sDesc)
    Next
  Next

  FMain.TabPanelBibliografia.Index = iIndiceOriginal
  FMain.TabPanelBibliografia.Visible = True

  ' --- 2. INFORME ---
  If aTotal.Count = 0 Then Return False

  m_Sonido.sonar("Error")
  Message.Error("En las referencias solo se admiten tres órdenes de LaTeX:" & gb.NewLine &
    "\\enquote{…}, \\sptext{…} y \\emph{…}, más el signo \\&." & gb.NewLine & gb.NewLine &
    "  " & aTotal.Join(gb.NewLine & "  ") & gb.NewLine & gb.NewLine &
    "La referencia no se guardó.")
  Return True

End

' ============================================
' Función   : OrdenesLatexEnControles
' Propósito : Recorre los controles de texto de un contenedor y devuelve los
'             que no cumplen la regla de las órdenes de LaTeX.
' Parámetros: hContenedor As Container — contenedor a recorrer
' Retorna   : String[] — «campo: problema», uno por control
' Nota      : RECURSIVA, COMO LimpiarControlesPegados: LOS CAMPOS ESTÁN EN
'             CONTENEDORES ANIDADOS. EL CAMPO SE NOMBRA POR SU NOMBRE DE
'             biblatex ($MapaCampos) Y, SI NO LO TIENE, POR EL DEL CONTROL.
' ============================================
Private Function OrdenesLatexEnControles(hContenedor As Container) As String[]

  Dim hCtrl As Control
  Dim aTotal As New String[]
  Dim aParcial As String[]
  Dim sDesc As String
  Dim sProblema As String
  Dim sCampo As String

  ' --- 1. RECORRIDO DE LOS HIJOS ---
  For Each hCtrl In hContenedor.Children

    ' --- 2. CONTENEDOR: BAJAR UN NIVEL ---
    If hCtrl Is Container Then
      aParcial = OrdenesLatexEnControles(hCtrl)
      For Each sDesc In aParcial
        If Not aTotal.Exist(sDesc) Then aTotal.Add(sDesc)
      Next
      Continue
    Endif

    ' --- 3. CONTROL DE TEXTO ---
    ' LOS If VAN ANIDADOS Y NO ENCADENADOS CON And, QUE NO CORTOCIRCUITA
    ' (RC-GM-17)
    If hCtrl Is TextBox Then
      If hCtrl.Name <> "txtClaveBibtex" Then
        ' EL CAMPO SE NOMBRA POR SU NOMBRE DE biblatex: LO NECESITA NivelesEnquote
        sCampo = hCtrl.Name
        If $MapaCampos.Exist(hCtrl.Name) Then sCampo = $MapaCampos[hCtrl.Name]
        ' LOS CAMPOS LITERALES (url, doi…) NO PASAN POR LA REGLA
        sProblema = ""
        If Not EsCampoLiteral(sCampo) Then
          sProblema = ProblemaOrdenesLatex(TextBox(hCtrl).Text,
            NivelesEnquote(sCampo, FMain.cmbTipoDeEntrada.Text))
        Endif
        If sProblema <> "" Then
          aTotal.Add(sCampo & ": " & sProblema)
        Endif
      Endif
    Endif

  Next

  Return aTotal

End

' ============================================
' Función   : VerificacionBase
' Propósito : Controles de la entrada antes de guardarla: tipo de entrada,
'             idioma, tipo de tesis, los nombres de idioma de biblatex y la
'             relación (RC-BL-01)
' Parámetros: (ninguno — trabaja sobre los controles de FMain)
' Retorna   : Boolean — True SI HAY UN ERROR (CONVENCIÓN DE
'             VerificarCaracteresInvalidos)
' ============================================
Public Function VerificacionBase() As Boolean

  ' --- 1. TIPO DE ENTRADA ---
  If FMain.cmbTipoDeEntrada.Text = "" Then
    m_Sonido.sonar("Error")
    Message.Error("Debe seleccionar un tipo de entrada.")
    FMain.cmbTipoDeEntrada.SetFocus
    Return True
  Endif

  ' --- 2. IDIOMA (langid) ---
  If Trim(FMain.txtHyphenation.Text) = "" Then
    m_Sonido.sonar("Error")
    Message.Error("Debe seleccionar un idioma.")
    FMain.txtHyphenation.SetFocus
    Return True
  Endif

  ' --- 3. TIPO DE TESIS ---
  If FMain.cmbTipoDeEntrada.Text = "thesis" And FMain.cmbTipoDeTesis.Text = "" Then
    m_Sonido.sonar("Error")
    Message.Error("Debe seleccionar el tipo de tesis.")
    FMain.cmbTipoDeTesis.SetFocus
    Return True
  Endif

  ' --- 4. NOMBRES DE IDIOMA ---
  ' langid LLEVA UN NOMBRE DE babel: CON UNO QUE NO LO ES («eng», «span») LA
  ' PARTICIÓN SALE MAL Y NADA AVISA. language Y origlanguage SON TEXTO QUE SE
  ' IMPRIME: SOLO SE ADMITEN CLAVES DE LOCALIZACIÓN DE biblatex, QUE SALEN
  ' TRADUCIDAS (SC-102)
  If IdiomaInvalido(FMain.txtHyphenation, "langid", True) Then Return True
  If IdiomaInvalido(FMain.txtLanguage, "language", False) Then Return True
  If IdiomaInvalido(FMain.txtOrigLanguage, "origlanguage", False) Then Return True

  ' --- 5. RELACIÓN: relatedtype O relatedstring, NO LOS DOS (RC-BL-01) ---
  ' CON LOS DOS CARGADOS, biber IMPRIME relatedtype Y relatedstring NO SALE
  ' EN NINGUNA PARTE, SIN AVISO
  If Trim(FMain.cmbRelatedType.Text) <> "" Then
    If Trim(FMain.txtRelatedString.Text) <> "" Then
      m_Sonido.sonar("Error")
      Message.Error("relatedtype y relatedstring no pueden ir juntos: con los dos, " &
        "relatedstring no sale en la bibliografía (RC-BL-01)." & gb.NewLine &
        "Deje uno solo.")
      FMain.txtRelatedString.SetFocus
      Return True
    Endif
  Endif

  Return False

End

' ============================================
' Función   : IdiomaInvalido
' Propósito : Controla los campos de idioma. langid: un solo nombre de babel
'             (catálogo idiomas). language y origlanguage: una lista de
'             claves de localización de biblatex unidas por « and »
'             (CLAVES_IDIOMA_BIBLATEX)
' Parámetros: hTexto As TextBox — el control del campo
'             sCampo As String — nombre del campo, para el aviso
'             bBabel As Boolean — True para langid, False para language y
'             origlanguage
' Retorna   : Boolean — True SI HAY UN ERROR (avisa y pone el foco)
' ============================================
Private Function IdiomaInvalido(hTexto As TextBox, sCampo As String, bBabel As Boolean) As Boolean

  Dim aMalos As New String[]
  Dim sNombre As String
  Dim sTexto As String

  ' --- 1. VACÍO: NADA QUE CONTROLAR ---
  sTexto = Trim(hTexto.Text)
  If sTexto = "" Then Return False

  ' --- 2. langid: UN SOLO NOMBRE DE babel ---
  If bBabel Then
    If m_Idiomas.EsNombreBabel(sTexto) Then Return False
    m_Sonido.sonar("Error")
    Message.Error("En " & sCampo & ", «" & sTexto & "» no es un idioma de babel." & gb.NewLine &
      "Use el nombre completo, como spanish, english o portuguese (la lista " &
      "aparece al escribir y pulsar Enter). La referencia no se guardó.")
    hTexto.SetFocus
    Return True
  Endif

  ' --- 3. language Y origlanguage: CADA CLAVE DE LA LISTA ---
  ' Split TOMA SU SEGUNDO ARGUMENTO COMO UNA LISTA DE CARACTERES SEPARADORES,
  ' NO COMO UNA CADENA: Split("spanish", " and ") DA [sp] [] [ish] (GV-185;
  ' MEDIDO DE NUEVO EL 20/11/2026). LA PALABRA « and » SE CAMBIA ANTES POR
  ' Chr(1), QUE NO APARECE EN UN NOMBRE DE IDIOMA, Y SE CORTA POR ESE CARÁCTER
  For Each sNombre In Split(Replace(sTexto, " and ", Chr(1)), Chr(1))
    sNombre = Trim(sNombre)
    If sNombre = "" Then Continue
    If Not EsClaveIdiomaBiblatex(sNombre) Then aMalos.Add(sNombre)
  Next
  If aMalos.Count = 0 Then Return False

  ' --- 4. AVISO ---
  m_Sonido.sonar("Error")
  Message.Error("En " & sCampo & " hay valores que no son idiomas de biblatex: " &
    aMalos.Join(", ") & gb.NewLine &
    "Use uno de la lista, como english, german o portuguese (aparece al " &
    "escribir y pulsar Enter); varios van unidos con « and ». La referencia " &
    "no se guardó.")
  hTexto.SetFocus
  Return True

End

' ============================================
' Función   : EsClaveIdiomaBiblatex
' Propósito : Dice si un nombre es una clave de idioma de biblatex, con o
'             sin el prefijo lang (biblatex acepta las dos formas:
'             biblatex.def, \DeclareListFormat{language})
' Parámetros: sNombre As String — el nombre a controlar
' Retorna   : Boolean — True si es una clave de CLAVES_IDIOMA_BIBLATEX
' ============================================
Public Function EsClaveIdiomaBiblatex(sNombre As String) As Boolean

  Dim aClaves As String[]

  ' --- 1. LA LISTA, Y EL NOMBRE SIN EL PREFIJO lang ---
  ' EL SEPARADOR ES UN SOLO CARÁCTER (GV-185)
  aClaves = Split(CLAVES_IDIOMA_BIBLATEX, ",")
  If sNombre Begins "lang" Then sNombre = Mid$(sNombre, 5)

  ' --- 2. COMPARACIÓN EXACTA (biblatex DISTINGUE MAYÚSCULAS) ---
  Return aClaves.Exist(sNombre, gb.Binary)

End

' ============================================
' Función   : MostrarRefereciasEnTableViewBibtexEnCurso
' Propósito : Muestra en el formulario la entrada de una fila de la grilla
' Parámetros: iRow As Integer — fila de gvReferenciasEnCurso
' Retorna   : nada
' Nota      : EL id SALE DE ContenidoBib, QUE ES LO QUE MUESTRA LA GRILLA EN
'             TODOS LOS CASOS (CARGA COMPLETA, BÚSQUEDA, DUPLICADOS)
' ============================================
Public Sub MostrarRefereciasEnTableViewBibtexEnCurso(iRow As Integer)

  ' --- 1. VALIDACIÓN (RC-GM-17: ANIDADO) ---
  If ContenidoBib = Null Then Return
  If iRow < 0 Then Return
  If iRow >= ContenidoBib.Count Then Return

  ' --- 2. LA ENTRADA DE ESA FILA ---
  ContenidoBib.MoveTo(iRow)
  MostrarEntrada(ContenidoBib["id"])

End

' ============================================
' Función   : MostrarEntrada
' Propósito : Carga en el formulario una entrada: sus columnas de bibtex y
'             cada par de bibtex_campo en el control de su campo
' Parámetros: iId As Integer — id de la entrada
' Retorna   : Boolean — True si se mostró
' ============================================
Public Function MostrarEntrada(iId As Integer) As Boolean

  Dim rEntrada As Result
  Dim rPares As Result
  Dim sControl As String

  ' --- 1. LA ENTRADA ---
  Try rEntrada = m_ConexionBD.mConn.Exec("SELECT tipo_de_entrada, clave_bibtex FROM bibtex WHERE id = &1", iId)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo leer la referencia:" & gb.NewLine & Error.Text)
    Return False
  Endif
  If Not rEntrada.Available Then
    m_Sonido.sonar("Error")
    Message.Error("La referencia ya no existe (id " & iId & ").")
    Return False
  Endif

  ' --- 2. SUS CAMPOS ---
  Try rPares = m_ConexionBD.mConn.Exec("SELECT campo, valor FROM bibtex_campo WHERE id_bibtex = &1", iId)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudieron leer los campos de la referencia:" & gb.NewLine & Error.Text)
    Return False
  Endif

  ' --- 3. FORMULARIO LIMPIO: UN CAMPO SIN PAR QUEDA VACÍO ---
  LimpiarCamposDatos()

  ' --- 4. COLUMNAS DE LA ENTRADA ---
  ' EL TIPO VA PRIMERO: SU Click DECIDE SI SE VE EL TIPO DE TESIS
  FMain.id_bibtex.Value = iId
  FMain.cmbTipoDeEntrada.Text = TextoDe(rEntrada["tipo_de_entrada"])
  FMain.txtClaveBibtex.Text = TextoDe(rEntrada["clave_bibtex"])

  ' --- 5. CADA PAR EN SU CONTROL ---
  ' CargarCatalogo GARANTIZA QUE TODO CAMPO DEL CATÁLOGO TIENE CONTROL; LA
  ' CLAVE FORÁNEA HACIA EL CATÁLOGO, QUE NO HAY PARES FUERA DE ÉL
  While rPares.Available
    sControl = ControlDeCampo(rPares["campo"])
    If sControl <> "" Then Object.SetProperty(FMain[sControl], "Text", rPares["valor"])
    rPares.MoveNext
  Wend

  Return True

End

' ============================================
' Función   : TextoDe
' Propósito : Valor de un campo de un Result como texto: vacío si es NULL
' Parámetros: vValor As Variant — el valor
' Retorna   : String
' ============================================
Private Function TextoDe(vValor As Variant) As String

  If IsNull(vValor) Then Return ""
  Return CStr(vValor)

End

' ============================================
' Función   : LimpiarCamposDatos
' Propósito : Vacía los controles de los campos del catálogo, sin tocar lo
'             demás del formulario (a diferencia de LimpiarTextboxBibtex, no
'             olvida el origen pendiente de «Usar esta»)
' Parámetros: (ninguno)
' Retorna   : nada
' ============================================
Private Sub LimpiarCamposDatos()

  Dim sCampo As String

  For Each sCampo In $MapaCampos
    Object.SetProperty(FMain[$MapaCampos.Key], "Text", "")
  Next

End


' ============================================
' Función   : AgregarClaveBib
' Propósito : Genera automáticamente la clave BibTeX a partir de los campos
'             del formulario (prefijo, autor/editor, año/fecha) y la escribe
'             en el campo de destino ya sanitizada
' Parámetros: ninguno — opera directamente sobre los controles de FMain
' Retorna   : nada
' ============================================
Public Sub AgregarClaveBib()

  ' --- 1. Inicialización de variables ---
  Dim textoOrigen As String
  Dim posicion As Integer
  Dim cadenaTercerTextBox As String
  Dim cadenaCuartoTextBox As String
  Dim Header As String

  ' --- 2. Construcción del prefijo ---
  ' EL PREFIJO ES EL ID DEL REGISTRO BIBTEX SEGUIDO DE UN GUIÓN
  Header = FMain.id_bibtex.Text & "-"

  ' --- 3. Determinación del texto de origen (autor o editor) ---
  ' SI NO HAY AUTOR SE USA EL CAMPO EDITOR COMO ALTERNATIVA
  If Trim(FMain.txtAuthor.Text) = "" Then
    textoOrigen = FMain.txtEditor.Text
  Else
    textoOrigen = FMain.txtAuthor.Text
  End If

  ' --- 4. Extracción del primer token (apellido) ---
  ' SE BUSCA EL PRIMER DELIMITADOR EN ORDEN DE PRIORIDAD
  posicion = InStr(textoOrigen, ",")
  If posicion = 0 Then posicion = InStr(textoOrigen, ";")
  If posicion = 0 Then posicion = InStr(textoOrigen, ".")
  If posicion = 0 Then posicion = InStr(textoOrigen, " ")

  ' SI SE ENCONTRÓ UN DELIMITADOR SE TOMA SOLO EL TEXTO ANTERIOR
  If posicion > 0 Then
    textoOrigen = Left(textoOrigen, posicion - 1)
  End If

  ' NORMALIZACIÓN DEL FRAGMENTO DE AUTOR (ACENTOS, CARACTERES ESPECIALES, ETC.)
  textoOrigen = LimpiarTexto(textoOrigen)

  ' --- 5. Ensamblado parcial: prefijo + autor ---
  FMain.txtClaveBibtex.Text = Header & textoOrigen

  ' --- 6. Resolución del componente año/fecha ---
  ' SE INTENTA PRIMERO txtYear; SI ESTÁ VACÍO SE RECURRE A txtDate
  cadenaTercerTextBox = UCase(Replace(FMain.txtYear.Text, "/", ""))

  If Trim(cadenaTercerTextBox) = "" Then
    cadenaCuartoTextBox = UCase(Replace(FMain.txtDate.Text, "/", ""))
    If Trim(cadenaCuartoTextBox) = "" Then
      ' NINGÚN CAMPO DE FECHA DISPONIBLE
      FMain.txtClaveBibtex.Text = FMain.txtClaveBibtex.Text & "-SINFECHA"
    Else
      FMain.txtClaveBibtex.Text = FMain.txtClaveBibtex.Text & Left(cadenaCuartoTextBox, 4)
    End If
  Else
    FMain.txtClaveBibtex.Text = FMain.txtClaveBibtex.Text & cadenaTercerTextBox
  End If

  ' --- 7. Sanitización final de la clave completa ---
  ' SE APLICA AL RESULTADO ENSAMBLADO: SOLO A-Z, 0-9 Y GUIÓN CORTO
  FMain.txtClaveBibtex.Text = SanitizarClaveBibtex(FMain.txtClaveBibtex.Text)

End Sub

' FUNCIÓN AUXILIAR PARA LIMPIAR TEXTO (USANDO REPLACE - MÁS CONFIABLE)
Public Function LimpiarTexto(texto As String) As String

  ' PRIMERO CONVERTIR TODOS LOS CARACTERES ESPECIALES USANDO REPLACE
  texto = Replace(texto, "á", "a")
  texto = Replace(texto, "à", "a")
  texto = Replace(texto, "â", "a")
  texto = Replace(texto, "ä", "a")
  texto = Replace(texto, "ã", "a")
  texto = Replace(texto, "å", "a")
  texto = Replace(texto, "Á", "A")
  texto = Replace(texto, "À", "A")
  texto = Replace(texto, "Â", "A")
  texto = Replace(texto, "Ä", "A")
  texto = Replace(texto, "Ã", "A")
  texto = Replace(texto, "Å", "A")

  texto = Replace(texto, "é", "e")
  texto = Replace(texto, "è", "e")
  texto = Replace(texto, "ê", "e")
  texto = Replace(texto, "ë", "e")
  texto = Replace(texto, "É", "E")
  texto = Replace(texto, "È", "E")
  texto = Replace(texto, "Ê", "E")
  texto = Replace(texto, "Ë", "E")

  texto = Replace(texto, "í", "i")
  texto = Replace(texto, "ì", "i")
  texto = Replace(texto, "î", "i")
  texto = Replace(texto, "ï", "i")
  texto = Replace(texto, "Í", "I")
  texto = Replace(texto, "Ì", "I")
  texto = Replace(texto, "Î", "I")
  texto = Replace(texto, "Ï", "I")

  texto = Replace(texto, "ó", "o")
  texto = Replace(texto, "ò", "o")
  texto = Replace(texto, "ô", "o")
  texto = Replace(texto, "ö", "o")
  texto = Replace(texto, "õ", "o")
  texto = Replace(texto, "Ó", "O")
  texto = Replace(texto, "Ò", "O")
  texto = Replace(texto, "Ô", "O")
  texto = Replace(texto, "Ö", "O")
  texto = Replace(texto, "Õ", "O")

  texto = Replace(texto, "ú", "u")
  texto = Replace(texto, "ù", "u")
  texto = Replace(texto, "û", "u")
  texto = Replace(texto, "ü", "u")
  texto = Replace(texto, "Ú", "U")
  texto = Replace(texto, "Ù", "U")
  texto = Replace(texto, "Û", "U")
  texto = Replace(texto, "Ü", "U")

  ' OTROS CARACTERES ESPECIALES
  texto = Replace(texto, "ñ", "n")
  texto = Replace(texto, "Ñ", "N")
  texto = Replace(texto, "ç", "c")
  texto = Replace(texto, "Ç", "C")

  ' CARACTERES ESPECIALES ADICIONALES (MINÚSCULAS)
  texto = Replace(texto, "ẑ", "z")
  texto = Replace(texto, "ž", "z")
  texto = Replace(texto, "ẋ", "x")
  texto = Replace(texto, "ẍ", "x")
  texto = Replace(texto, "ṽ", "v")
  texto = Replace(texto, "ṕ", "p")
  texto = Replace(texto, "ṗ", "p")
  texto = Replace(texto, "ʠ", "q")
  texto = Replace(texto, "ḿ", "m")
  texto = Replace(texto, "ṁ", "m")
  texto = Replace(texto, "ṃ", "m")
  texto = Replace(texto, "ĵ", "j")
  texto = Replace(texto, "ǰ", "j")
  texto = Replace(texto, "ḅ", "b")
  texto = Replace(texto, "ḃ", "b")
  texto = Replace(texto, "ḟ", "f")

  ' CARACTERES ESPECIALES ADICIONALES (MAYÚSCULAS)
  texto = Replace(texto, "Ẑ", "Z")
  texto = Replace(texto, "Ž", "Z")
  texto = Replace(texto, "Ẋ", "X")
  texto = Replace(texto, "Ẍ", "X")
  texto = Replace(texto, "Ṽ", "V")
  texto = Replace(texto, "Ṕ", "P")
  texto = Replace(texto, "Ṗ", "P")
  texto = Replace(texto, "ʠ", "Q")
  texto = Replace(texto, "Ḿ", "M")
  texto = Replace(texto, "Ṁ", "M")
  texto = Replace(texto, "Ṃ", "M")
  texto = Replace(texto, "Ĵ", "J")
  texto = Replace(texto, "J̌", "J")
  texto = Replace(texto, "Ḅ", "B")
  texto = Replace(texto, "Ḃ", "B")
  texto = Replace(texto, "Ḟ", "F")

  ' CONVERTIR A MAYÚSCULAS
  texto = UCase(texto)

  ' AHORA FILTRAR SOLO A-Z Y 0-9
  Dim i As Integer
  Dim caracter As String
  Dim resultado As String = ""

  For i = 1 To Len(texto)
    caracter = Mid(texto, i, 1)
    If (caracter >= "A" And caracter <= "Z") Or (caracter >= "0" And caracter <= "9") Then
      resultado = resultado & caracter
    End If
  Next

  Return resultado

End Function

Public Sub RefrescarTableViewBibtexEnCurso()

  Dim iRow As Integer
  Dim iCol As Integer

  ' LA GRILLA SE ARMA CON ConsultaGrilla: COLUMNAS POR NOMBRE (2.0.0)
  Try ContenidoBib = m_ConexionBD.mConn.Exec(ConsultaGrilla("b.id_proyecto = &1"), m_InicioCierre.IdProyectoEnCurso)
  If Error Then
    Debug "ERROR EN REFRESCO BIBTEX: " & Error.Text
    Return
  Endif

  ' LIMPIAR EL GRIDVIEW SIEMPRE
  FMain.gvReferenciasEnCurso.Clear

  ' SI NO HAY DATOS, ESTABLECER EL GRID VACÍO Y SALIR
  If ContenidoBib = Null Then
    FMain.gvReferenciasEnCurso.Rows.Count = 0
    FMain.gvReferenciasEnCurso.Columns.Count = 0
    Return
  Endif

  If ContenidoBib.Count = 0 Then
    FMain.gvReferenciasEnCurso.Rows.Count = 0
    FMain.gvReferenciasEnCurso.Columns.Count = 0
    Return
  Endif

  ' CONFIGURAR COLUMNAS Y FILAS
  FMain.gvReferenciasEnCurso.Columns.Count = ContenidoBib.Fields.Count
  FMain.gvReferenciasEnCurso.Rows.Count = ContenidoBib.Count
  FMain.gvReferenciasEnCurso.MoveTo(0, 0)

  ' POBLAR LOS DATOS
  iRow = 0
  For Each ContenidoBib
    For iCol = 0 To ContenidoBib.Fields.Count - 1
      If IsNull(ContenidoBib[iCol]) Then
        FMain.gvReferenciasEnCurso[iRow, iCol].Text = ""
      Else
        FMain.gvReferenciasEnCurso[iRow, iCol].Text = ContenidoBib[iCol]
      Endif
    Next
    iRow += 1
  Next

End

