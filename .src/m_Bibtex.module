' ============================================
' Función   : SanitizarClaveBibtex
' Propósito : Normaliza una clave BibTeX eliminando caracteres no permitidos
'             Solo se aceptan A-Z (normalizados a mayúscula), 0-9 y guión corto
' Parámetros: sClave As String — texto crudo ingresado por el usuario
' Retorna   : String — clave sanitizada, o cadena vacía si no hay caracteres válidos
' ============================================
Private Function SanitizarClaveBibtex(sClave As String) As String

  ' --- 1. Normalización inicial ---
  Dim sNormalizada As String

  sNormalizada = UCase(Trim(sClave))

  ' --- 2. Filtrado carácter por carácter ---
  Dim sResultado As String
  Dim i As Integer
  Dim c As String

  For i = 1 To String.Len(sNormalizada)
    c = String.Mid(sNormalizada, i, 1)
    ' SOLO SE ACEPTAN LETRAS MAYÚSCULAS, DÍGITOS Y GUIÓN CORTO
    If c Like "[A-Z0-9-]" Then
      sResultado &= c
    Endif
  Next

  Return sResultado

End Function

' ============================================
' Función   : ValoresDelFormulario
' Propósito : Los campos con dato del formulario: un valor por campo del
'             catálogo, recortado. Un control vacío no entra: sin dato, sin
'             par (2.0.0)
' Parámetros: (ninguno — lee los controles de $MapaCampos)
' Retorna   : Collection — campo → valor
' ============================================
Public Function ValoresDelFormulario() As Collection

  Dim cValores As New Collection
  Dim sCampo As String
  Dim sValor As String

  For Each sCampo In $MapaCampos
    sValor = Trim(Object.GetProperty(FMain[$MapaCampos.Key], "Text"))
    If sValor <> "" Then cValores[sCampo] = sValor
  Next

  Return cValores

End

' ============================================
' Función   : EscribirEntrada
' Propósito : Escribe una entrada en una transacción: crea la fila de bibtex
'             (iId = 0) o actualiza la existente, y reemplaza todos sus pares
'             de bibtex_campo por los de cValores. Sin interfaz: la usan
'             GuardarEntrada (formulario) y m_Json.ImportarJSON
' Parámetros: iId As Integer — id de la entrada; 0 para una nueva
'             sTipo As String — tipo_de_entrada
'             sClave As String — clave_bibtex
'             cValores As Collection — campo → valor, campos del catálogo
'             iIdOrigen As Integer — entrada de origen de «Usar esta»; 0 si no hay
'             sProvisorio As String — prefijo «id-» con el que se armó la
'             clave antes de tener el id real; vacío si no hay que corregirlo
' Retorna   : Integer — id de la entrada escrita; 0 si falló (el motivo, en
'             UltimoErrorEscritura). La clave final, en UltimaClaveEscrita
' Nota      : EL id DE UNA ENTRADA NUEVA LO DA AUTO_INCREMENT. ANTES SE
'             CALCULABA CON MAX(id) + 1 ANTES DE GUARDAR, Y DOS ALTAS
'             SIMULTÁNEAS CHOCABAN EN LA CLAVE PRIMARIA. SI LA CLAVE SE ARMÓ
'             CON EL id PROVISORIO (AgregarClaveBib) Y EL REAL ES OTRO, SE
'             CORRIGE EL PREFIJO: LA CLAVE QUEDA ÚNICA.
'             fecha_modificacion SE ACTUALIZA A MANO: CAMBIAR SOLO LOS PARES NO
'             TOCA LA FILA DE bibtex Y SU ON UPDATE NO SE DISPARA.
'             Begin / Commit / Rollback (GV-173). EL TEXTO DEL ERROR SE
'             GUARDA ANTES DEL Rollback, QUE PASA POR EL DRIVER
' ============================================
Public Function EscribirEntrada(iId As Integer, sTipo As String, sClave As String, cValores As Collection, Optional iIdOrigen As Integer, Optional sProvisorio As String) As Integer

  Dim hConn As Connection
  Dim rId As Result
  Dim iEscrito As Integer
  Dim sValor As String

  ' --- 1. INICIALIZACIÓN ---
  $sUltimoErrorEscritura = ""
  $sUltimaClave = sClave
  hConn = m_ConexionBD.mConn

  Try hConn.Begin()
  If Error Then
    $sUltimoErrorEscritura = Error.Text
    Return 0
  Endif

  ' --- 2. LA FILA DE bibtex ---
  ' ID DEL PROYECTO DESDE LA GLOBAL DE SESIÓN (RC-GM-16)
  If iId = 0 Then
    Try hConn.Exec("INSERT INTO bibtex (id_proyecto, tipo_de_entrada, clave_bibtex) VALUES (&1, &2, &3)",
      m_InicioCierre.IdProyectoEnCurso, sTipo, sClave)
    If Error Then Goto Fallo
    ' LAST_INSERT_ID ES DE ESTA CONEXIÓN: OTRA ALTA AL MISMO TIEMPO NO LO MUEVE
    Try rId = hConn.Exec("SELECT LAST_INSERT_ID() AS id")
    If Error Then Goto Fallo
    iEscrito = rId["id"]
    ' PREFIJO PROVISORIO → EL REAL
    If sProvisorio <> "" Then
      If Left(sClave, Len(sProvisorio)) = sProvisorio And If CStr(iEscrito) & "-" <> sProvisorio Then
        sClave = CStr(iEscrito) & "-" & Mid(sClave, Len(sProvisorio) + 1)
        Try hConn.Exec("UPDATE bibtex SET clave_bibtex = &1 WHERE id = &2", sClave, iEscrito)
        If Error Then Goto Fallo
      Endif
    Endif
    ' TRAZABILIDAD (1.1.0): UN 0 NO SE ESCRIBE, VIOLARÍA fk_bibtex_origen
    If iIdOrigen > 0 Then
      Try hConn.Exec("UPDATE bibtex SET id_origen = &1 WHERE id = &2", iIdOrigen, iEscrito)
      If Error Then Goto Fallo
    Endif
  Else
    iEscrito = iId
    Try hConn.Exec("UPDATE bibtex SET tipo_de_entrada = &1, clave_bibtex = &2, fecha_modificacion = NOW() WHERE id = &3",
      sTipo, sClave, iEscrito)
    If Error Then Goto Fallo
  Endif

  ' --- 3. LOS PARES: SE REEMPLAZAN TODOS ---
  ' EL FORMULARIO TIENE UN CONTROL POR CAMPO DEL CATÁLOGO (CargarCatalogo):
  ' LO QUE NO ESTÁ EN cValores ES UN CAMPO QUE QUEDÓ VACÍO
  Try hConn.Exec("DELETE FROM bibtex_campo WHERE id_bibtex = &1", iEscrito)
  If Error Then Goto Fallo
  For Each sValor In cValores
    Try hConn.Exec("INSERT INTO bibtex_campo (id_bibtex, campo, valor) VALUES (&1, &2, &3)",
      iEscrito, cValores.Key, sValor)
    If Error Then Goto Fallo
  Next

  ' --- 4. CONFIRMACIÓN ---
  Try hConn.Commit()
  If Error Then Goto Fallo
  $sUltimaClave = sClave
  Return iEscrito

Fallo:
  $sUltimoErrorEscritura = Error.Text
  Try hConn.Rollback()
  Return 0

End

' ============================================
' Función   : UltimoErrorEscritura
' Propósito : Motivo del último fallo de EscribirEntrada
' Parámetros: (ninguno)
' Retorna   : String — vacío si la última escritura fue bien
' ============================================
Public Function UltimoErrorEscritura() As String

  Return $sUltimoErrorEscritura

End

' ============================================
' Función   : UltimaClaveEscrita
' Propósito : Clave con la que quedó la última entrada escrita: puede diferir
'             de la pedida si se corrigió el prefijo provisorio
' Parámetros: (ninguno)
' Retorna   : String
' ============================================
Public Function UltimaClaveEscrita() As String

  Return $sUltimaClave

End

' ============================================
' Función   : GuardarEntrada
' Propósito : Escribe la entrada del formulario (EscribirEntrada) y avisa si
'             falla. Deja en txtClaveBibtex la clave con la que quedó
' Parámetros: iId As Integer — id de la entrada; 0 para una nueva
'             sTipo As String — tipo_de_entrada
'             sClave As String — clave_bibtex ya sanitizada
'             cValores As Collection — campo → valor (ValoresDelFormulario)
'             iIdOrigen As Integer — entrada de origen de «Usar esta»; 0 si no hay
' Retorna   : Integer — id de la entrada escrita; 0 si falló (con mensaje)
' Nota      : EL PREFIJO PROVISORIO ES EL id QUE MUESTRA id_bibtex, CON EL QUE
'             AgregarClaveBib ARMÓ LA CLAVE
' ============================================
Public Function GuardarEntrada(iId As Integer, sTipo As String, sClave As String, cValores As Collection, Optional iIdOrigen As Integer) As Integer

  Dim iEscrito As Integer

  iEscrito = EscribirEntrada(iId, sTipo, sClave, cValores, iIdOrigen, CStr(FMain.id_bibtex.Value) & "-")
  If iEscrito = 0 Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo guardar la referencia:" & gb.NewLine & $sUltimoErrorEscritura)
    Return 0
  Endif

  FMain.txtClaveBibtex.Text = $sUltimaClave
  Return iEscrito

End

Public Sub EliminarBibtex()

  ' --- 1. VALIDAR QUE HAYA UNA ENTRADA SELECCIONADA ---
  If FMain.id_bibtex.Text = "" Then
    m_Sonido.sonar("Info")
    Message.Info("Debe primero seleccionarse la entrada a borrar.")
    Return
  Endif

  ' --- 2. CONFIRMAR LA BAJA (CANCELAR = NO TOCAR NADA) ---
  m_Sonido.sonar("Question")
  If Message.Question("¿Desea borrar la entrada?", "Sí", "No") <> 1 Then Return

  ' --- 3. BORRAR EN BD Y CONFIRMAR ---
  ' PARAMETRIZADO + Commit: SIN Commit LA BAJA NO SE PERSISTE, NO LA VEN LAS OTRAS
  ' MÁQUINAS (autocommit OFF) Y SE PIERDE POR ROLLBACK AL DESCONECTAR. RC-GM-02.
  Try m_ConexionBD.mConn.Exec("DELETE FROM bibtex WHERE id = &1", FMain.id_bibtex.Text)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo borrar la entrada:" & Chr(10) & Error.Text)
    Return
  Endif
  Try m_ConexionBD.mConn.Commit

  ' --- 4. RECARGAR EL GRID ---
  ' IniciarBibtex UNIFICA EL RELOAD (LIMPIA TEXTBOX + RECARGA POR EVENTO Data) Y
  ' YA RESIEMBRA LA HUELLA, ASÍ QUE EL TIMER LOCAL NO RECARGA DE MÁS
  IniciarBibtex()

  ' --- 5. ESTADO FINAL DE BOTONES ---
  FMain.BtnNuevoBib.Visible = True
  FMain.btnGuardarBib.Visible = False
  FMain.btnGuardarCambiosBib.Visible = False
  FMain.BtnEliminarBib.Visible = False
  FMain.btnGuardarIGUAL.Visible = False

End

Public Sub IniciarBibtex()

  Dim iniBIB As String

  LimpiarTextboxBibtex()
  ' LA GRILLA SE ARMA CON ConsultaGrilla: COLUMNAS POR NOMBRE (2.0.0)
  iniBIB = ConsultaGrilla("b.id_proyecto = &1")
  ' FUENTE DE VERDAD DEL ID: GLOBAL DE SESIÓN, NO EL CONTROL (RC-GM-16)
  ContenidoBib = m_ConexionBD.mConn.Exec(iniBIB, m_InicioCierre.IdProyectoEnCurso)
  If ContenidoBib.Available Then
    FMain.gvReferenciasEnCurso.Clear
    FMain.gvReferenciasEnCurso.Rows.Count = ContenidoBib.Count
    FMain.gvReferenciasEnCurso.Refresh
  Else
    FMain.gvReferenciasEnCurso.Rows.Count = 0
  Endif
  ' SEMBRAR LA HUELLA CON LO RECIÉN CARGADO (BASE PARA EL TIMER DE FONDO)
  SembrarHuellaReferencias()

End

' ============================================
' Función   : GuardarBibtexPrimeraVez
' Propósito : Alta de la entrada que está en el formulario
' Parámetros: (ninguno — trabaja sobre los controles de FMain)
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub GuardarBibtexPrimeraVez()

  Dim iId As Integer

  ' --- 1. VERIFICAMOS CAMPOS ---
  If VerificacionBase() Then Return

  ' --- 2. ALTA ---
  ' TRAZABILIDAD (1.1.0): ENTRADA COPIADA DE OTRO PROYECTO CON «Usar esta».
  ' SOLO EN EL ALTA
  iId = GuardarEntrada(0, FMain.cmbTipoDeEntrada.Text,
    SanitizarClaveBibtex(FMain.txtClaveBibtex.Text), ValoresDelFormulario(),
    m_BuscarBib.IdOrigenPendiente())
  If iId = 0 Then Return

  ' --- 3. RECARGA Y AVISO ---
  IniciarBibtex()
  m_Sonido.sonar("Info")
  Message.Info("La referencia se guardó con éxito.")

End

