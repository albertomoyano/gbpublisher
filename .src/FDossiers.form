# Gambas Form File 3.0

{ Form Form
  Move(0,0,960,640)
  #Scaled = False
  Text = ("Dossiers del número")
  Resizable = False
  Arrangement = Arrange.Vertical
  Centered = True
  Spacing = True
  Margin = True
  Padding = 4
  { lblNumeroDossiers Label
    Move(9,9,927,36)
    Foreground = &H0000FF
    Alignment = Align.Center
    Border = Border.Plain
  }
  { hbxCuerpoDossiers HBox
    Move(9,54,927,531)
    Expand = True
    Spacing = True
    { gvDossiers GridView
      Move(9,0,342,531)
      Mode = Select.Single
      ShowCursor = True
      Header = GridView.Horizontal
    }
    { vbxEditorDossier VBox
      Move(360,0,570,530)
      Expand = True
      Spacing = True
      Padding = 4
      { hbxSeccionDossier HBox
        Move(0,0,560,36)
        { lblSeccionDossier Label
          Move(0,0,150,36)
          Alignment = Align.Right
          Text = ("sección: ")
        }
        { cmbSeccionDossier ComboBox
          Move(153,0,400,36)
          Expand = True
          ReadOnly = True
        }
      }
      { hbxOrdenDossier HBox
        Move(0,45,560,36)
        { lblOrdenDossier Label
          Move(0,0,150,36)
          Alignment = Align.Right
          Text = ("orden: ")
        }
        { spnOrdenDossier SpinBox
          Move(153,0,400,36)
          Expand = True
          MaxValue = 9999
        }
      }
      { hbxIdiomaDossier HBox
        Move(0,90,560,36)
        { lblIdiomaDossier Label
          Move(0,0,150,36)
          Alignment = Align.Right
          Text = ("idioma-del-título: ")
        }
        { cmbIdiomaDossier ComboBox
          Move(153,0,400,36)
          Expand = True
          ReadOnly = True
        }
      }
      { hbxTituloDossier HBox
        Move(0,135,560,36)
        { lblTituloDossier Label
          Move(0,0,150,36)
          Alignment = Align.Right
          Text = ("título: ")
        }
        { txtTituloDossier TextBox
          Move(153,0,400,36)
          Expand = True
          Placeholder = ("Título del dossier en el idioma elegido")
        }
      }
      { hbxSubtituloDossier HBox
        Move(0,180,560,36)
        { lblSubtituloDossier Label
          Move(0,0,150,36)
          Alignment = Align.Right
          Text = ("subtítulo: ")
        }
        { txtSubtituloDossier TextBox
          Move(153,0,400,36)
          Expand = True
        }
      }
      { hbxEpigrafeDossier HBox
        Move(0,225,560,90)
        { lblEpigrafeDossier Label
          Move(0,0,150,36)
          Alignment = Align.Right
          Text = ("epígrafe: ")
        }
        { txaEpigrafeDossier TextArea
          Move(153,0,400,90)
          Expand = True
          Wrap = True
        }
      }
      { hbxEditoresDossier HBox
        Move(0,324,558,153)
        Expand = True
        { lblEditoresDossier Label
          Move(0,0,150,36)
          Alignment = Align.Right
          Text = ("a-cargo: ")
        }
        { vbxListaEditoresDossier VBox
          Move(153,0,360,144)
          Expand = True
          Spacing = True
          Padding = 4
          { cmbRolEditorDossier ComboBox
            Move(0,0,360,36)
            ToolTip = ("Rol de la persona elegida, o de la próxima que se agregue")
            ReadOnly = True
          }
          { lstEditoresDossier ListBox
            Move(0,63,360,72)
            Expand = True
          }
        }
        { vbxBotonesEditoresDossier VBox
          Move(518,0,36,180)
          { btnAgregarEditorDossier Button
            Move(0,0,36,36)
            ToolTip = ("Agregar una persona (de la tabla de autores)")
            Picture = Picture["iconos/+nuevo.png"]
          }
          { btnQuitarEditorDossier Button
            Move(0,36,36,36)
            ToolTip = ("Quitar a la persona elegida")
            Picture = Picture["iconos/borrar.png"]
          }
          { btnSubirEditorDossier Button
            Move(0,72,36,36)
            ToolTip = ("Subir")
            Text = ("▲")
          }
          { btnBajarEditorDossier Button
            Move(0,108,36,36)
            ToolTip = ("Bajar")
            Text = ("▼")
          }
          { Spring1 Spring
            Move(0,144,36,36)
          }
        }
      }
    }
  }
  { hbxBotonesDossiers HBox
    Move(9,594,927,36)
    { btnNuevoDossier Button
      Move(0,0,36,36)
      ToolTip = ("Nuevo dossier")
      Picture = Picture["iconos/+nuevo.png"]
    }
    { btnGuardarDossier Button
      Move(36,0,36,36)
      ToolTip = ("Guardar el dossier")
      Picture = Picture["iconos/guardarComo.png"]
    }
    { btnBorrarDossier Button
      Move(72,0,36,36)
      ToolTip = ("Borrar el dossier (solo si no tiene artículos)")
      Picture = Picture["iconos/borrar.png"]
    }
    { sprBotonesDossiers Spring
      Move(126,0,36,36)
    }
    { btnCerrar Button
      Move(738,0,144,36)
      Text = ("Cerrar")
      Picture = Picture["iconos/salir.png"]
    }
  }
}
