' Gambas module file

' ============================================
' Módulo    : m_Ventana
' Propósito : CONTROL DE LOS BOTONES DEL MARCO DE VENTANA VÍA _MOTIF_WM_HINTS
' ============================================

' CONSTANTES MOTIF (VALORES SEGÚN reload_mwm_hints DE MUFFIN)
' A NIVEL DE MÓDULO PORQUE GAMBAS NO ADMITE Const LOCAL
Private Const MWM_HINTS_FUNCTIONS As Integer = 1
Private Const MWM_FUNC_RESIZE As Integer = 2
Private Const MWM_FUNC_MOVE As Integer = 4
Private Const MWM_FUNC_CLOSE As Integer = 32

' ============================================
' Función   : FijarBotones
' Propósito : QUITAR MINIMIZAR, MAXIMIZAR Y (OPCIONALMENTE) CERRAR DEL MARCO,
'             CONSERVANDO TÍTULO, MOVIMIENTO Y REDIMENSIÓN
' Parámetros: oVentana As Window — formulario a configurar
'             bPermitirCerrar As Boolean — True deja el botón de cerrar
' Retorna   : nada
' ============================================
Public Sub FijarBotones(oVentana As Window, Optional bPermitirCerrar As Boolean = False)

  Dim iFunciones As Integer
  Dim aHints As Integer[]

  ' --- 1. Validación de entrada ---
  ' UN FORMULARIO EMBEBIDO NO TIENE MARCO PROPIO: NO HAY NADA QUE CONFIGURAR
  If Not oVentana Then Return
  If Not oVentana.TopLevel Then Return

  ' --- 2. Cálculo de las funciones permitidas ---
  ' SIN EL BIT MWM_FUNC_ALL, MUFFIN HABILITA SOLO LAS FUNCIONES LISTADAS
  iFunciones = MWM_FUNC_MOVE Or MWM_FUNC_RESIZE
  If bPermitirCerrar Then iFunciones = iFunciones Or MWM_FUNC_CLOSE

  ' --- 3. Escritura de la propiedad ---
  ' [FLAGS, FUNCTIONS, DECORATIONS, INPUT_MODE, STATUS]
  ' SIN MWM_HINTS_DECORATIONS EN FLAGS, LA DECORACIÓN (TÍTULO) QUEDA POR DEFECTO
  aHints = [MWM_HINTS_FUNCTIONS, iFunciones, 0, 0, 0]
  X11.SetWindowProperty(oVentana.Handle, "_MOTIF_WM_HINTS", "_MOTIF_WM_HINTS", aHints)

End