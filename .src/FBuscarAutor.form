# Gambas Form File 3.0

{ Form Form
  Move(0,0,800,560)
  #Scaled = False
  Text = ("Elegir una persona de Autores")
  Resizable = False
  Centered = True
  Arrangement = Arrange.Vertical
  Spacing = True
  Margin = True
  Padding = 4
  { hbxBuscarAutor HBox
    Move(9,9,780,36)
    Spacing = True
    { txtBuscarAutor TextBox
      Move(0,0,700,36)
      Expand = True
      Placeholder = ("Apellido, nombre u ORCID; Enter busca")
    }
    { btnBuscarAutor Button
      Move(708,0,36,36)
      #Translate = False
      ToolTip = "Buscar"
      Picture = Picture["iconos/search.png"]
    }
  }
  { gvAutores GridView
    Move(9,54,780,400)
    Expand = True
    Mode = Select.Single
    ShowCursor = True
    Header = GridView.Horizontal
  }
  { hbxBotonesBuscarAutor HBox
    Move(9,513,780,36)
    Spacing = True
    { lblAvisoBuscarAutor Label
      Move(0,0,450,36)
      Foreground = &H0000FF
      Expand = True
      Text = ("Si la persona no está, se da de alta en Autores.")
    }
    { btnElegirAutor Button
      Move(468,0,144,36)
      Text = ("Elegir")
      Picture = Picture["iconos/ok.png"]
    }
    { btnCancelarAutor Button
      Move(621,0,144,36)
      Text = ("Cancelar")
      Picture = Picture["iconos/cancelar.png"]
    }
  }
}
