' Gambas module file

' ============================================
' Módulo    : m_ValidacionSchematron
' Propósito : Validación Schematron por grupo temático de JATS4R para
'             el auditor de XML externos (m_AuditarJats). El pipeline
'             propio ya no lo usa: valida los canónicos con el maestro
'             compilado en una sola hoja (validar_canonicos.sh, SC-87).
'
' PIPELINE:  .sch precompilado a .xsl  →  Saxon-HE  →  SVRL  →  objetos
'
' ============================================
' POR QUÉ ESTE MÓDULO SE REESCRIBIÓ POR COMPLETO
'
' La versión anterior tenía cuatro defectos, verificados en consola:
'
' 1. pipeline-for-svrl.xsl de SchXslt COMPILA el Schematron pero NO lo
'    ejecuta. El archivo que quedaba en disco no era un SVRL sino el
'    XSLT compilado, cuya raíz es <xsl:transform>. Al contar los
'    <failed-assert> de ese archivo se contaban las REGLAS, no los
'    incumplimientos, de modo que el resultado era idéntico para
'    cualquier XML de entrada.
'
' 2. Los archivos temáticos de JATS4R (permissions-errors.sch y
'    compañía) NO son documentos Schematron completos: son fragmentos
'    que empiezan en <pattern> y están pensados para entrar por
'    <include> en el maestro. Pasados sueltos al compilador dan
'    'this document contains more than one top-level element'.
'    Necesitan un envoltorio con las declaraciones de namespace.
'
' 3. Finally NO se ejecuta en un Return normal, solo si se disparó un
'    error (RC-GM-20). El Close del archivo abierto nunca corría en el
'    camino exitoso, con fuga de descriptores en cada validación.
'
' 4. Los <successful-report> también tienen <svrl:text>, así que el
'    parseo por líneas los emitía como si fueran errores.
'
' DECISIÓN DE DISEÑO: los .sch se compilan UNA VEZ y los .xsl
' resultantes se distribuyen en .hidden/schematron/compilados. Los
' genera generar-schematron-jats4r.sh (raíz del repositorio), desde la
' versión fijada de JATS4R y verificados contra el maestro, junto con
' los vocabularios que leen con document(). Hasta el 18/11/2026 se
' hacían a mano con un compilar-schematron.sh que no quedó en el
' repositorio, y no viajaban en el .deb (SC-97, bloque 3a). En
' tiempo de ejecución hay una sola invocación de Saxon por regla, sin
' pasos de compilación. Y el SVRL se recibe por STDOUT en lugar de
' escribirse a disco: 'Exec ... To' captura stdout, verificado, y así
' no hay archivos de salida que limpiar.
'
' ============================================
' RENDIMIENTO: POR QUÉ SE QUITA EL DOCTYPE
'
' Saxon tardaba OCHO SEGUNDOS por archivo, con solo dos de CPU. El
' desglose ubicó la causa sin ambigüedad:
'
'   arranque de la JVM sin hacer nada           0,24 s
'   ese XML con una plantilla que no hace nada 12,87 s   <-- acá
'   una regla real sobre un XML mínimo           0,57 s
'
' No era la JVM ni eran las reglas: era PARSEAR ESE XML. La prueba
' definitiva, el mismo comando sin red con 'unshare -rn', dio 0,42 s
' y falló con 'I/O error reported by XML parser'.
'
' Saxon sale a buscar la DTD de JATS a jats.nlm.nih.gov EN CADA
' ARCHIVO, y no hay forma de impedírselo desde la línea de comandos.
' Se probaron -Djavax.xml.accessExternalDTD, -Djavax.xml.
' accessExternalSchema, -dtd:off, -Dxml.catalog.ignoreMissing y
' -Dxmlresolver.properties: ninguna cambió el tiempo. El resolvedor
' de Saxon 12 ignora las propiedades estándar de JAXP.
'
' Es la CONTRACARA de RC-XJ-03: allí el problema era que Saxon no
' conseguía la DTD y la solución fue permitirle buscarla; acá la
' busca cuando no hace falta y no se la puede prohibir.
'
' Solución: se le entrega una copia temporal SIN DOCTYPE. Las reglas
' de JATS4R validan estructura, no gramática. Verificado: 0,43 s en
' lugar de 8,1 s, con hallazgos IDÉNTICOS.
' ============================================

' ============================================
' 1. RUTAS Y OPCIONES
' ============================================

Private Const SAXON_JAR As String = "/opt/Saxon-HE/saxon-he.jar"
' LA CARPETA DE LAS REGLAS COMPILADAS: LA DE LOS RECURSOS DEL SISTEMA
' (m_InicioCierre.RutaRecursos: .hidden/ DESDE EL IDE, /usr/share/gbpublisher
' INSTALADO), COMO m_Sonido. NUNCA ~/.gbpublisher: UN INFORME DE JATS4R SOLO
' SE SOSTIENE CON LAS REGLAS DEL PAQUETE (SC-11). HASTA EL 18/11/2026 ERA
' UNA RUTA FIJA A /usr/share, Y DESDE EL IDE SE PROBABA CONTRA LO INSTALADO
Private Const SUBRUTA_COMPILADOS As String = "schematron/compilados"

' --- TRAZA DE TIEMPOS ---
' Imprime en consola cuánto tarda cada invocación de Saxon. Sirve para
' diagnosticar lentitud sin adivinar. Poner en False para producción.
Public bTrazaTiempos As Boolean = False

' --- MOTIVO DEL ÚLTIMO FALLO DE ValidarConSchematron ---
' VARIABLE DE MÓDULO CON ACCESOR Y NO PARÁMETRO ByRef: EN GAMBAS UN
' String SE PASA SIEMPRE POR VALOR Y EL LLAMADOR NUNCA LO RECIBÍA
' (GV-24, ALTERNATIVA 4)
Private $sUltimoError As String

' ============================================
' Función   : UltimoErrorSchematron
' Propósito : Devuelve el motivo del último fallo de ValidarConSchematron.
' Parámetros: ninguno
' Retorna   : String — el motivo, o cadena vacía si la última
'             invocación no falló
' ============================================
Public Function UltimoErrorSchematron() As String

  Return $sUltimoError

End

' ============================================
' 2. NÚCLEO: EJECUCIÓN Y PARSEO
' ============================================

' ============================================
' Función   : ValidarConSchematron
' Propósito : Ejecuta una regla Schematron ya compilada sobre un XML y
'             devuelve las aserciones incumplidas como objetos.
'
'             Es el punto único de entrada del módulo. Todo lo demás
'             se apoya en esta función.
'
' Parámetros: sArchivoXML As String — ruta absoluta del XML a validar
'             sRegla As String — nombre del .xsl compilado, sin extensión
' Retorna   : CAsercionSVRL[] — aserciones incumplidas, o Null si falló.
'             Si falló, el motivo se lee con UltimoErrorSchematron():
'             un String no puede volver por parámetro (GV-24).
' ============================================
Public Function ValidarConSchematron(sArchivoXML As String, sRegla As String) As CAsercionSVRL[]

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim sRutaXsl As String
  Dim sSvrl As String
  Dim sRutaTemp As String
  Dim fInicio As Float

  $sUltimoError = ""

  ' --- 2. GUARDAS ---
  If Not Exist(sArchivoXML) Then
    $sUltimoError = ("No se encuentra el archivo XML: ") & sArchivoXML
    Return Null
  Endif

  If Not Exist(SAXON_JAR) Then
    $sUltimoError = ("No se encuentra Saxon-HE en ") & SAXON_JAR
    Return Null
  Endif

  sRutaXsl = m_InicioCierre.RutaRecursos() &/ SUBRUTA_COMPILADOS &/ sRegla & ".xsl"
  If Not Exist(sRutaXsl) Then
    $sUltimoError = ("No se encuentra la regla compilada: ") & sRutaXsl
    Return Null
  Endif

  ' --- 3. COPIA SIN DOCTYPE ---
  ' Sin esto Saxon resuelve la DTD por red y cada archivo cuesta ocho
  ' segundos en lugar de medio.
  If bTrazaTiempos Then Print "  → entrando "; sRegla; " ("; File.Name(sArchivoXML); ")"

  fInicio = Timer
  sRutaTemp = CopiaSinDoctype(sArchivoXML)
  If sRutaTemp = "" Then
    $sUltimoError = ("No se pudo preparar el archivo para validar.")
    Return Null
  Endif

  If bTrazaTiempos Then Print "    temp: "; sRutaTemp; "  bytes="; Stat(sRutaTemp).Size

  ' --- 4. EJECUCIÓN ---
  ' SC-05: Exec con array, nunca Shell. La ruta puede venir de una
  ' carpeta elegida por el usuario y no debe pasar por sh -c.
  ' Sin -o: Saxon escribe el resultado en stdout, que 'Exec ... To'
  ' captura. Los diagnósticos van a stderr y se pierden, pero eso se
  ' detecta en el apartado 5: si Saxon falló, la salida no es un SVRL.
  Try Exec ["java", "-jar", SAXON_JAR, "-s:" & sRutaTemp, "-xsl:" & sRutaXsl] To sSvrl
  If Error Then
    Try Kill sRutaTemp
    $sUltimoError = ("Falló la ejecución de Saxon: ") & Error.Text
    Return Null
  Endif

  ' --- 5. LIMPIEZA ---
  ' Explícita y en cada camino de salida. No se usa Finally: no corre
  ' en un Return normal (RC-GM-20), que era justamente el defecto de
  ' la versión anterior de este módulo.
  Try Kill sRutaTemp

  If bTrazaTiempos Then
    Print "  SAXON "; sRegla; " "; Format(Timer - fInicio, "0.00"); "s  ("; File.Name(sArchivoXML); ")"
  Endif

  ' --- 6. VERIFICACIÓN DE QUE LA SALIDA ES UN SVRL ---
  ' Esta guarda es la que habría detectado el defecto original: un
  ' XSLT compilado tiene raíz <xsl:transform> y no contiene
  ' schematron-output.
  If sSvrl = "" Then
    $sUltimoError = ("Saxon no produjo salida para ") & sRegla
    Return Null
  Endif

  If InStr(sSvrl, "schematron-output") = 0 Then
    $sUltimoError = ("La salida de ") & sRegla & (" no es un informe SVRL.")
    Return Null
  Endif

  ' --- 7. PARSEO ---
  Return ParsearSVRL(sSvrl)

End

' ============================================
' Función   : ParsearSVRL
' Propósito : Convierte el texto de un informe SVRL en objetos.
'
'             El recorrido es por BLOQUES y no por líneas: los
'             atributos de una aserción pueden quedar repartidos en
'             varias líneas según cómo indente el serializador, y un
'             parseo línea a línea los pierde.
'
'             Se toman SOLO los <failed-assert>. Los
'             <successful-report> también llevan <svrl:text> y una
'             versión anterior los emitía como si fueran errores.
'
'             El recorrido NO usa una función auxiliar con ByRef: la
'             posición se calcula en línea. Si el paso por referencia
'             no propaga el valor, el índice queda en cero, InStr
'             vuelve a encontrar la primera etiqueta y el bucle no
'             termina nunca.
'
' Parámetros: sSvrl As String — informe SVRL completo
' Retorna   : CAsercionSVRL[] — las aserciones incumplidas
' ============================================
Private Function ParsearSVRL(sSvrl As String) As CAsercionSVRL[]

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim aResultado As New CAsercionSVRL[]
  Dim oAsercion As CAsercionSVRL
  Dim sPatron As String
  Dim sContexto As String
  Dim sBloque As String
  Dim iApertura As Integer
  Dim iCierre As Integer
  Dim iPos As Integer
  Dim iVueltas As Integer

  iPos = 1
  iVueltas = 0

  ' --- 2. RECORRIDO SECUENCIAL DEL INFORME ---
  ' El patrón activo y el contexto de la regla se declaran ANTES de
  ' las aserciones que les corresponden, así que se van recordando a
  ' medida que aparecen.
  Do

    ' 2.1 LOCALIZACIÓN DE LA PRÓXIMA ETIQUETA
    iApertura = InStr(sSvrl, "<", iPos)
    If iApertura = 0 Then Break

    iCierre = InStr(sSvrl, ">", iApertura)
    If iCierre = 0 Then Break

    sBloque = Mid(sSvrl, iApertura, iCierre - iApertura + 1)

    ' 2.2 PATRÓN ACTIVO
    If InStr(sBloque, "active-pattern") > 0 Then
      sPatron = ValorAtributoSVRL(sBloque, "id")
      If sPatron = "" Then sPatron = ValorAtributoSVRL(sBloque, "name")
    Endif

    ' 2.3 REGLA DISPARADA
    If InStr(sBloque, "fired-rule") > 0 Then
      sContexto = ValorAtributoSVRL(sBloque, "context")
    Endif

    ' 2.4 ASERCIÓN INCUMPLIDA
    ' Se excluye la etiqueta de cierre, que también contiene la cadena
    If InStr(sBloque, "failed-assert") > 0 Then
      If InStr(sBloque, "</") = 0 Then
        oAsercion = New CAsercionSVRL
        oAsercion.sPatron = sPatron
        oAsercion.sContexto = sContexto
        oAsercion.sTest = ValorAtributoSVRL(sBloque, "test")
        oAsercion.sRol = ValorAtributoSVRL(sBloque, "role")
        oAsercion.sUbicacion = ValorAtributoSVRL(sBloque, "location")
        oAsercion.sTexto = TextoDeAsercion(sSvrl, iCierre + 1)
        aResultado.Add(oAsercion)
      Endif
    Endif

    ' 2.5 AVANCE
    ' GUARDA CONTRA BUCLE INFINITO: si por cualquier motivo la posición
    ' no avanzara, el análisis quedaría colgado y la interfaz
    ' bloqueada, sin ningún mensaje. Vale un contador.
    If iCierre + 1 <= iPos Then Break
    iPos = iCierre + 1

    Inc iVueltas
    If iVueltas > 200000 Then
      Print "PARSEAR SVRL: recorrido interrumpido por exceso de vueltas"
      Break
    Endif

  Loop

  Return aResultado

End

' ============================================
' Función   : TextoDeAsercion
' Propósito : Devuelve el contenido del <svrl:text> que sigue a una
'             aserción, normalizando el espacio en blanco.
' Parámetros: sSvrl As String — informe completo
'             iDesde As Integer — posición tras la etiqueta de apertura
' Retorna   : String — el texto, o cadena vacía
' ============================================
Private Function TextoDeAsercion(sSvrl As String, iDesde As Integer) As String

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim iIni As Integer
  Dim iFin As Integer
  Dim sTexto As String

  ' --- 2. LOCALIZACIÓN ---
  ' Se busca la etiqueta sin prefijo para no depender de cómo se haya
  ' declarado el namespace
  iIni = InStr(sSvrl, ":text>", iDesde)
  If iIni = 0 Then Return ""

  iIni += 6
  iFin = InStr(sSvrl, "</", iIni)
  If iFin = 0 Then Return ""

  sTexto = Mid(sSvrl, iIni, iFin - iIni)

  ' --- 3. NORMALIZACIÓN ---
  sTexto = Replace(sTexto, Chr(10), " ")
  sTexto = Replace(sTexto, Chr(9), " ")
  While InStr(sTexto, "  ") > 0
    sTexto = Replace(sTexto, "  ", " ")
  Wend

  ' --- 4. LAS ENTIDADES DEL TEXTO SE RESUELVEN PARA MOSTRAR ---
  ' El ampersand va ÚLTIMO: si fuera primero volvería a interpretar
  ' las secuencias que se acaban de generar
  sTexto = Replace(sTexto, "&lt;", "<")
  sTexto = Replace(sTexto, "&gt;", ">")
  sTexto = Replace(sTexto, "&quot;", Chr(34))
  sTexto = Replace(sTexto, "&amp;", "&")

  Return Trim(sTexto)

End

' ============================================
' Función   : ValorAtributoSVRL
' Propósito : Extrae el valor de un atributo de una etiqueta.
' Parámetros: sBloque As String — etiqueta completa
'             sAtributo As String — nombre del atributo
' Retorna   : String — el valor, o cadena vacía
' ============================================
Private Function ValorAtributoSVRL(sBloque As String, sAtributo As String) As String

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim iIni As Integer
  Dim iFin As Integer
  Dim sComilla As String

  ' SC-01: Chr(34) en lugar del escape
  sComilla = Chr(34)

  iIni = InStr(sBloque, sAtributo & "=" & sComilla)
  If iIni = 0 Then Return ""

  iIni += Len(sAtributo) + 2
  iFin = InStr(sBloque, sComilla, iIni)
  If iFin = 0 Then Return ""

  Return Mid(sBloque, iIni, iFin - iIni)

End

' ============================================
' 3. PREPARACIÓN DEL DOCUMENTO
' ============================================

' ============================================
' Función   : CopiaSinDoctype
' Propósito : Deja en el directorio temporal una copia del XML sin su
'             declaración DOCTYPE, para que Saxon no salga a resolver
'             la DTD por red.
'
'             El archivo original NO SE MODIFICA.
'
' Parámetros: sRuta As String — XML original
' Retorna   : String — ruta de la copia, o cadena vacía si falló
' ============================================
Private Function CopiaSinDoctype(sRuta As String) As String

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim sContenido As String
  Dim sSalida As String
  Dim sRutaTemp As String
  Dim iIni As Integer
  Dim iFin As Integer

  ' --- 2. LECTURA ---
  ' File.Load no decodifica ni valida, que es lo correcto acá: el
  ' contenido se copia tal cual salvo el fragmento que se quita
  Try sContenido = File.Load(sRuta)
  If Error Then Return ""

  ' --- 3. LOCALIZACIÓN DEL DOCTYPE ---
  iIni = InStr(sContenido, "<!DOCTYPE")

  If iIni = 0 Then
    ' SIN DOCTYPE NO HAY NADA QUE QUITAR, PERO IGUAL SE COPIA PARA QUE
    ' EL LLAMADOR TENGA UN SOLO CAMINO DE LIMPIEZA
    sSalida = sContenido
  Else
    iFin = FinDeDoctype(sContenido, iIni)
    If iFin = 0 Then Return ""
    sSalida = Mid(sContenido, 1, iIni - 1) & Mid(sContenido, iFin + 1)
  Endif

  ' --- 4. VOLCADO ---
  sRutaTemp = Temp$() & ".xml"
  Try File.Save(sRutaTemp, sSalida)
  If Error Then Return ""

  Return sRutaTemp

End

' ============================================
' Función   : FinDeDoctype
' Propósito : Devuelve la posición del '>' que cierra la declaración
'             DOCTYPE, respetando el subconjunto interno.
'
'             Hace falta contar corchetes porque un DOCTYPE de JATS
'             trae declaraciones de entidades entre corchetes, y esas
'             declaraciones contienen sus propios '>'. Cortar en el
'             primero rompe el documento: probado con sed ingenuo,
'             dejó el prefijo ali sin enlazar.
'
' Parámetros: sContenido As String — texto completo
'             iIni As Integer — posición del '<!DOCTYPE'
' Retorna   : Integer — posición del '>' de cierre, o 0 si no se halló
' ============================================
Private Function FinDeDoctype(sContenido As String, iIni As Integer) As Integer

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim iPos As Integer
  Dim iProfundidad As Integer
  Dim sCaracter As String
  Dim iLargo As Integer

  iProfundidad = 0
  iLargo = Len(sContenido)

  ' --- 2. RECORRIDO ---
  ' Por bytes a propósito: los caracteres que interesan son ASCII y un
  ' DOCTYPE no contiene texto multibyte, así que no hace falta el
  ' costo de String.Mid
  For iPos = iIni To iLargo

    sCaracter = Mid(sContenido, iPos, 1)

    If sCaracter = "[" Then Inc iProfundidad
    If sCaracter = "]" Then Dec iProfundidad

    ' SOLO CIERRA SI NO ESTAMOS DENTRO DEL SUBCONJUNTO INTERNO
    If sCaracter = ">" Then
      If iProfundidad <= 0 Then Return iPos
    Endif

  Next

  Return 0

End

' ============================================
' 4. INFRAESTRUCTURA
' ============================================

' ============================================
' Función   : ReglasDisponibles
' Propósito : Lista las reglas compiladas presentes en los recursos del
'             sistema (.hidden/ desde el IDE, /usr/share/gbpublisher instalado).
' Parámetros: ninguno
' Retorna   : String[] — nombres sin extensión, ordenados
' ============================================
Public Function ReglasDisponibles() As String[]

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim aArchivos As String[]
  Dim aResultado As New String[]
  Dim sNombre As String
  Dim sCarpeta As String

  sCarpeta = m_InicioCierre.RutaRecursos() &/ SUBRUTA_COMPILADOS

  ' --- 2. GUARDA ---
  ' RC-GM-17: Exist e IsDir en If separados, porque And no cortocircuita
  If Not Exist(sCarpeta) Then Return aResultado
  If Not IsDir(sCarpeta) Then Return aResultado

  ' --- 3. LISTADO ---
  Try aArchivos = Dir(sCarpeta, "*.xsl")
  If Error Then Return aResultado

  For Each sNombre In aArchivos
    aResultado.Add(File.BaseName(sNombre))
  Next

  aResultado.Sort()
  Return aResultado

End

' ============================================
' Función   : EstaInstalado
' Propósito : Verifica que estén Saxon y al menos una regla compilada.
' Parámetros: ninguno
' Retorna   : Boolean
' ============================================
Public Function EstaInstalado() As Boolean

  If Not Exist(SAXON_JAR) Then Return False
  If ReglasDisponibles().Count = 0 Then Return False

  Return True

End
