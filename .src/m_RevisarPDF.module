' Gambas module file

' --- DECLARACIONES GLOBALES DE SESIÓN DEL VISOR (RESET AL ABRIR PROYECTO / LOGOUT) ---
Public hDocActual As PdfDocument      ' DOCUMENTO ABIERTO (Null SI NO HAY)
Public iPaginaActual As Integer       ' PÁGINA EN PANTALLA (BASE 0)
Public fZoom As Float                 ' FACTOR DE ZOOM ACTUAL
Public iRotacion As Integer           ' 0 / 90 / 180 / 270
Public sDirPDFActual As String        ' <raiz>/salidas/pdf RESUELTO AL POBLAR

' --- ESTADO DEL REFRESCO EN CALIENTE DEL COMBO (hTimerRefrescarPDF) ---
Private $sFirmaPDF As String          ' FOTO DE LOS NOMBRES DE salidas/pdf PARA DETECTAR CAMBIOS
Private $sArchivoCargado As String    ' NOMBRE DEL PDF EFECTIVAMENTE ABIERTO EN EL VISOR ("" SI NINGUNO)
Private $bRepoblando As Boolean       ' SUPRIME SeleccionarPDF MIENTRAS SE REPUEBLA EL COMBO

' --- PARÁMETROS DE ZOOM Y LAYOUT ---
Private Const PASO_ZOOM As Float = 1.10       ' MULTIPLICADOR POR PULSACIÓN
Private Const ZOOM_MIN As Float = 0.25        ' TOPE INFERIOR
Private Const ZOOM_MAX As Float = 5.0         ' TOPE SUPERIOR
Private Const MARGEN_SCROLL As Integer = 34   ' HOLGURA PARA LA BARRA VERTICAL EN AJUSTE AL ANCHO

' ============================================
' Función   : PoblarComboPDF
' Propósito : Lista los .pdf de <raíz>/salidas/pdf en cmbVerPDF. Se invoca
'             una sola vez desde el flujo de "abrir proyecto"; los cambios
'             posteriores de la carpeta los recoge RefrescarComboSiCambio.
' Parámetros: —
' Retorna   : —
' ============================================
Public Sub PoblarComboPDF()

  ' --- 0. INICIALIZACIÓN DE VARIABLES ---
  Dim sArch As String
  Dim aArchivos As String[]

  ' --- 1. LIMPIAR ESTADO PREVIO DEL VISOR ---
  ResetVisorPDF()

  ' --- 2. GUARDA: DEBE HABER PROYECTO ABIERTO ---
  ' SIN ESTA GUARDA LA RUTA QUEDARÍA RELATIVA ("salidas/pdf")
  If m_InicioCierre.RutaProyectoEnCurso = "" Then Return

  ' --- 3. RESOLVER EL DIRECTORIO <raíz>/salidas/pdf ---
  ' SE FIJA AUNQUE LA CARPETA NO EXISTA: EL REFRESCO LA VUELVE A MIRAR EN CADA TICK
  sDirPDFActual = m_InicioCierre.RutaProyectoEnCurso &/ "salidas/pdf"

  ' --- 4. LISTAR LOS .pdf ---
  ' Null ES UN FALLO DE Dir: SE PUEBLA VACÍO Y EL TIMER REINTENTA
  aArchivos = ListarPDFs()
  If aArchivos = Null Then aArchivos = New String[]

  ' --- 5. POBLAR EL COMBOBOX ---
  ' EN UN COMBO DE SOLO LECTURA, Add DEJA EL ÍNDICE EN 0 SIN DISPARAR Click:
  ' EL COMBO MUESTRA EL PRIMERO Y EL VISOR QUEDA VACÍO HASTA QUE SE ELIJA UNO
  For Each sArch In aArchivos
    FMain.cmbVerPDF.Add(sArch)
  Next

  ' --- 6. FOTO INICIAL: EL PRIMER TICK DEL TIMER NO DEBE REPOBLAR ---
  $sFirmaPDF = aArchivos.Join(Chr(10))

End

' ============================================
' Función   : ListarPDFs
' Propósito : Devuelve la lista ordenada de los .pdf de sDirPDFActual. Fuente
'             única del listado: la usan el poblado inicial y el refresco.
' Parámetros: —
' Retorna   : String[] — nombres con extensión, ordenados; vacío si no hay
'             carpeta; Null si Dir falló (el llamador decide qué hacer)
' ============================================
Private Function ListarPDFs() As String[]

  ' --- 0. INICIALIZACIÓN DE VARIABLES ---
  Dim aArchivos As New String[]
  Dim aEncontrados As String[]

  ' --- 1. SIN CARPETA RESUELTA O INEXISTENTE: LISTA VACÍA ---
  ' IsDir Y NO Exist: Exist DA True TAMBIÉN PARA UN ARCHIVO (GV-01)
  If sDirPDFActual = "" Then Return aArchivos
  If Not IsDir(sDirPDFActual) Then Return aArchivos

  ' --- 2. LISTAR SOLO ARCHIVOS .pdf (RC-GM-02) ---
  ' NO SE AVISA CON Message: ESTA FUNCIÓN CORRE CADA 3 s DESDE EL TIMER Y UN
  ' FALLO TRANSITORIO (CARPETA BORRADA ENTRE IsDir Y Dir) LLENARÍA LA PANTALLA
  ' DE MENSAJES. NO ES UN CANAL MUDO (GV-23): EL Null LE DICE AL LLAMADOR QUE
  ' LA LISTA NO ES CONFIABLE, Y EL LLAMADOR NO LA CONFUNDE CON UNA CARPETA VACÍA
  Try aEncontrados = Dir(sDirPDFActual, "*.pdf", gb.File)
  If Error Then Return Null

  ' --- 3. COPIAR Y ORDENAR ---
  If aEncontrados Then aArchivos.Insert(aEncontrados)
  aArchivos.Sort()

  Return aArchivos

End

' ============================================
' Función   : RefrescarComboSiCambio
' Propósito : Invocada por hTimerRefrescarPDF. Si la lista de .pdf de
'             salidas/pdf cambió, repuebla cmbVerPDF conservando el PDF
'             abierto en el visor (página, zoom y rotación). Si el PDF
'             abierto desapareció del disco, limpia el visor.
' Parámetros: —
' Retorna   : —
' ============================================
Public Sub RefrescarComboSiCambio()

  ' --- 0. INICIALIZACIÓN DE VARIABLES ---
  Dim aArchivos As String[]
  Dim sFirma As String
  Dim sSeleccionAnterior As String
  Dim sArch As String
  Dim bSigueEnDisco As Boolean
  Dim i As Integer

  ' --- 1. SIN PROYECTO ABIERTO O SIN CARPETA RESUELTA: NADA QUE HACER ---
  If m_InicioCierre.RutaProyectoEnCurso = "" Then Return
  If sDirPDFActual = "" Then Return

  ' --- 2. FOTO ACTUAL DE LA CARPETA ---
  aArchivos = ListarPDFs()
  ' FALLO TRANSITORIO DE Dir: SE SALTEA ESTE TICK SIN TOCAR NADA; EL PRÓXIMO REINTENTA
  If aArchivos = Null Then Return
  sFirma = aArchivos.Join(Chr(10))

  ' --- 3. SIN CAMBIOS EN LA LISTA: SALIR SIN TOCAR LA UI ---
  ' SOLO SE COMPARAN NOMBRES: UN PDF REGENERADO CON EL MISMO NOMBRE NO CUENTA
  ' COMO CAMBIO. SE RECARGA VOLVIÉNDOLO A ELEGIR EN EL COMBO, PORQUE ASIGNAR
  ' Index DISPARA Click AUNQUE EL ÍNDICE NO CAMBIE (GV-53)
  If sFirma = $sFirmaPDF Then Return
  $sFirmaPDF = sFirma

  ' --- 4. RECORDAR LO QUE EL USUARIO TIENE ELEGIDO ---
  If FMain.cmbVerPDF.Index >= 0 Then sSeleccionAnterior = FMain.cmbVerPDF.Text

  ' --- 5. REPOBLAR CON SeleccionarPDF SUPRIMIDO ---
  ' REPONER EL Index DISPARA Click (GV-53): SIN LA BANDERA SE RECARGARÍA EL
  ' PDF ABIERTO Y SE PERDERÍAN PÁGINA, ZOOM Y ROTACIÓN
  $bRepoblando = True
  FMain.cmbVerPDF.Clear
  For Each sArch In aArchivos
    FMain.cmbVerPDF.Add(sArch)
  Next

  ' --- 6. RESTAURAR LA SELECCIÓN POR NOMBRE ---
  ' POR NOMBRE Y NO POR ÍNDICE: UN PDF NUEVO PUEDE ENTRAR ANTES EN EL ORDEN.
  ' SI NO SE ENCUENTRA, QUEDA EL ÍNDICE 0 QUE PONE Add, SIN Click: EL MISMO
  ' ESTADO QUE AL ABRIR EL PROYECTO
  If sSeleccionAnterior <> "" Then
    For i = 0 To FMain.cmbVerPDF.Count - 1
      If FMain.cmbVerPDF[i].Text = sSeleccionAnterior Then
        FMain.cmbVerPDF.Index = i
        Break
      Endif
    Next
  Endif
  $bRepoblando = False

  ' --- 7. EL PDF ABIERTO DESAPARECIÓ DEL DISCO: LIMPIAR EL VISOR ---
  ' EL DOCUMENTO EN MEMORIA YA NO CORRESPONDE A NINGÚN ARCHIVO
  If $sArchivoCargado = "" Then Return
  bSigueEnDisco = False
  For Each sArch In aArchivos
    If sArch = $sArchivoCargado Then
      bSigueEnDisco = True
      Break
    Endif
  Next
  If Not bSigueEnDisco Then LimpiarVistaPDF()

End

' ============================================
' Función   : SeleccionarPDF
' Propósito : Carga el PDF elegido en cmbVerPDF. Invocada desde el _Click
'             del combo.
' Parámetros: —
' Retorna   : —
' ============================================
Public Sub SeleccionarPDF()

  ' --- 1. GUARDAS: NO REPOBLANDO, DIRECTORIO Y SELECCIÓN VÁLIDA ---
  ' DURANTE EL REPOBLADO EN CALIENTE EL Click VIENE DE REPONER EL Index (GV-53),
  ' NO DEL USUARIO: EL PDF ABIERTO NO SE RECARGA
  If $bRepoblando Then Return
  If sDirPDFActual = "" Then Return
  If FMain.cmbVerPDF.Index < 0 Then Return

  ' --- 2. CARGAR EL ARCHIVO SELECCIONADO ---
  CargarPDF(sDirPDFActual &/ FMain.cmbVerPDF.Text)

End

' ============================================
' Función   : CargarPDF
' Propósito : Abre un PDF, fija el estado inicial (página 0, sin rotación,
'             zoom = ajuste al ancho) y hace el primer render.
' Parámetros: sRutaCompleta As String — ruta absoluta al archivo .pdf
' Retorna   : —
' ============================================
Public Sub CargarPDF(sRutaCompleta As String)

  ' --- 0. INICIALIZACIÓN DE VARIABLES ---
  Dim hDoc As PdfDocument

  ' --- 1. VALIDACIÓN DE ENTRADA ---
  If Not Exist(sRutaCompleta) Then
    m_Sonido.sonar("Error")
    Message.Error("No se encontró el archivo:" & Chr(10) & sRutaCompleta)
    Return
  Endif

  ' --- 2. APERTURA DEL DOCUMENTO (RC-GM-02: TRY + IF ERROR) ---
  Try hDoc = New PdfDocument(sRutaCompleta)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo abrir el PDF (¿encriptado o dañado?):" & Chr(10) & Error.Text)
    Return
  Endif

  ' --- 3. VALIDAR QUE TENGA PÁGINAS ---
  If hDoc.Count <= 0 Then
    m_Sonido.sonar("Error")
    Message.Error("El PDF no contiene páginas.")
    Return
  Endif

  ' --- 4. FIJAR ESTADO INICIAL DEL VISOR ---
  ' EL ORDEN IMPORTA: CalcularZoomAjusteAncho LEE hDocActual/iPaginaActual/iRotacion
  hDocActual = hDoc
  $sArchivoCargado = File.Name(sRutaCompleta)
  iPaginaActual = 0
  iRotacion = 0
  fZoom = CalcularZoomAjusteAncho()

  ' --- 5. RENDER INICIAL ---
  RenderizarPagina()

End

' ============================================
' Función   : RenderizarPagina
' Propósito : FUNCIÓN CENTRAL. Rasteriza la página actual con el zoom y la
'             rotación vigentes, la vuelca al PictureBox y actualiza los
'             indicadores. Todo el resto del visor solo muta estado y la llama.
' Parámetros: —
' Retorna   : —
' ============================================
Public Sub RenderizarPagina()

  ' --- 0. INICIALIZACIÓN DE VARIABLES ---
  Dim img As Image
  Dim fPtsW As Float
  Dim fPtsH As Float
  Dim iRecorteW As Integer
  Dim iRecorteH As Integer
  Dim fResolucion As Float

  ' --- 1. GUARDA: DEBE HABER UN DOCUMENTO ABIERTO ---
  If hDocActual = Null Then Return

  ' --- 2. CLAMP DE PÁGINA ACTUAL AL RANGO VÁLIDO ---
  If iPaginaActual < 0 Then iPaginaActual = 0
  If iPaginaActual > hDocActual.Max Then iPaginaActual = hDocActual.Max

  ' --- 3. DIMENSIONES DE PÁGINA EN PUNTOS ---
  fPtsW = hDocActual[iPaginaActual].W
  fPtsH = hDocActual[iPaginaActual].H

  ' --- 4. VENTANA DE RECORTE EN PÍXELES (INTERCAMBIA EJES A 90/270) ---
  ' RC-GM-17: OR NO ES SHORT-CIRCUIT, PERO AMBAS SON COMPARACIONES SEGURAS
  If iRotacion = 90 Or iRotacion = 270 Then
    iRecorteW = CInt(fPtsH * fZoom)
    iRecorteH = CInt(fPtsW * fZoom)
  Else
    iRecorteW = CInt(fPtsW * fZoom)
    iRecorteH = CInt(fPtsH * fZoom)
  Endif

  ' --- 5. RESOLUCIÓN = 72 dpi * FACTOR DE ZOOM ---
  fResolucion = 72 * fZoom

  ' --- 6. RENDER DE LA PÁGINA (RC-GM-02: VERIFICAR ERROR) ---
  Try img = hDocActual[iPaginaActual].Render(0, 0, iRecorteW, iRecorteH, iRotacion, fResolucion)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo renderizar la página." & Chr(10) & Error.Text)
    Return
  Endif

  ' --- 7. VOLCADO AL PICTUREBOX Y AJUSTE DE TAMAÑO (DISPARA EL SCROLL) ---
  FMain.pbPDF.Picture = img.Picture
  FMain.pbPDF.Move(0, 0, img.W, img.H)

  ' --- 8. ACTUALIZAR INDICADORES DE PÁGINA ---
  ' txtGotoPage MUESTRA LA PÁGINA ACTUAL (BASE 1); lblInformacion, EL TOTAL
  FMain.txtGotoPage.Text = CStr(iPaginaActual + 1)
  FMain.lblInformacion.Text = " de " & CStr(hDocActual.Count)

End

' ============================================
' Función   : CalcularZoomAjusteAncho
' Propósito : Devuelve el factor de zoom que hace que la página actual (con
'             la rotación vigente) llene el ancho útil del viewport.
' Parámetros: —
' Retorna   : Float — factor de zoom acotado a [ZOOM_MIN, ZOOM_MAX]
' ============================================
Private Function CalcularZoomAjusteAncho() As Float

  ' --- 0. INICIALIZACIÓN DE VARIABLES ---
  Dim fPtsAncho As Float
  Dim iAnchoVista As Integer
  Dim fZoomCalc As Float

  ' --- 1. GUARDA: SIN DOC, ZOOM NEUTRO ---
  If hDocActual = Null Then Return 1.0

  ' --- 2. ANCHO EFECTIVO EN PUNTOS SEGÚN ROTACIÓN ---
  If iRotacion = 90 Or iRotacion = 270 Then
    fPtsAncho = hDocActual[iPaginaActual].H
  Else
    fPtsAncho = hDocActual[iPaginaActual].W
  Endif

  ' --- 3. ANCHO ÚTIL DEL VIEWPORT (MENOS HOLGURA PARA LA BARRA VERTICAL) ---
  iAnchoVista = FMain.svViewPDF.Width - MARGEN_SCROLL

  ' --- 4. GUARDA: VIEWPORT NO REALIZADO O DATO INVÁLIDO -> ZOOM NEUTRO ---
  If iAnchoVista <= 0 Or fPtsAncho <= 0 Then Return 1.0

  ' --- 5. CÁLCULO Y CLAMP ---
  fZoomCalc = iAnchoVista / fPtsAncho
  If fZoomCalc < ZOOM_MIN Then fZoomCalc = ZOOM_MIN
  If fZoomCalc > ZOOM_MAX Then fZoomCalc = ZOOM_MAX

  Return fZoomCalc

End

' ============================================
' Función   : SiguientePagina / AnteriorPagina
' Propósito : Navegación secuencial con clamp a [0, Max].
' Parámetros: —
' Retorna   : —
' ============================================
Public Sub SiguientePagina()

  If hDocActual = Null Then Return
  If iPaginaActual < hDocActual.Max Then
    Inc iPaginaActual
    RenderizarPagina()
  Endif

End

Public Sub AnteriorPagina()

  If hDocActual = Null Then Return
  If iPaginaActual > 0 Then
    Dec iPaginaActual
    RenderizarPagina()
  Endif

End

' ============================================
' Función   : AumentarZoom / ReducirZoom
' Propósito : Escala fZoom por PASO_ZOOM con clamp. El zoom PERSISTE al
'             navegar entre páginas.
' Parámetros: —
' Retorna   : —
' ============================================
Public Sub AumentarZoom()

  If hDocActual = Null Then Return
  fZoom = fZoom * PASO_ZOOM
  If fZoom > ZOOM_MAX Then fZoom = ZOOM_MAX
  RenderizarPagina()

End

Public Sub ReducirZoom()

  If hDocActual = Null Then Return
  fZoom = fZoom / PASO_ZOOM
  If fZoom < ZOOM_MIN Then fZoom = ZOOM_MIN
  RenderizarPagina()

End

' ============================================
' Función   : RotarPagina
' Propósito : Rota +90° a la derecha, acumulativo (0->90->180->270->0).
' Parámetros: —
' Retorna   : —
' ============================================
Public Sub RotarPagina()

  If hDocActual = Null Then Return
  iRotacion = (iRotacion + 90) Mod 360
  RenderizarPagina()

End

' ============================================
' Función   : IrAPagina
' Propósito : Salta a la página escrita en txtGotoPage. Solo enteros en
'             rango 1..Count; si no, beep y revierte al valor actual.
' Parámetros: sTexto As String — contenido crudo del TextBox
' Retorna   : —
' ============================================
Public Sub IrAPagina(sTexto As String)

  ' --- 0. INICIALIZACIÓN DE VARIABLES ---
  Dim iPag As Integer

  ' --- 1. GUARDA: DEBE HABER DOCUMENTO ---
  If hDocActual = Null Then Return

  ' --- 2. VALIDAR QUE SEA ENTERO (RC-GM-02) ---
  Try iPag = CInt(Trim(sTexto))
  If Error Then
    m_Sonido.sonar("Error")
    FMain.txtGotoPage.Text = CStr(iPaginaActual + 1)
    Return
  Endif

  ' --- 3. VALIDAR RANGO 1..Count ---
  If iPag < 1 Or iPag > hDocActual.Count Then
    m_Sonido.sonar("Error")
    FMain.txtGotoPage.Text = CStr(iPaginaActual + 1)
    Return
  Endif

  ' --- 4. IR A LA PÁGINA (INTERNO BASE 0) ---
  iPaginaActual = iPag - 1
  RenderizarPagina()

End

' ============================================
' Función   : ResetVisorPDF
' Propósito : Libera el documento y limpia estado y controles, combo incluido.
'             Se llama al abrir proyecto (vía PoblarComboPDF) y al hacer logout.
' Parámetros: —
' Retorna   : —
' ============================================
Public Sub ResetVisorPDF()

  ' --- 1. LIBERAR DOCUMENTO Y VISTA ---
  LimpiarVistaPDF()

  ' --- 2. LIBERAR ESTADO DE SESIÓN Y DEL REFRESCO ---
  ' SIN CARPETA NI FOTO, EL TIMER NO HACE NADA HASTA EL PRÓXIMO PoblarComboPDF
  sDirPDFActual = ""
  $sFirmaPDF = ""
  $bRepoblando = False

  ' --- 3. DEFENSIVO: GARANTIZAR ARRANGEMENT NONE EN EL SCROLLVIEW ---
  ' (YA ESTÁ EN NONE EN EL DISEÑADOR; ESTO PROTEGE ANTE CAMBIOS FUTUROS)
  FMain.svViewPDF.Arrangement = Arrange.None

  ' --- 4. LIMPIAR EL COMBO ---
  FMain.cmbVerPDF.Clear

End

' ============================================
' Función   : LimpiarVistaPDF
' Propósito : Cierra el documento y limpia la vista del visor sin tocar el
'             combo. La usan ResetVisorPDF y el refresco, cuando el PDF
'             abierto desapareció del disco.
' Parámetros: —
' Retorna   : —
' ============================================
Private Sub LimpiarVistaPDF()

  ' --- 1. LIBERAR ESTADO DEL DOCUMENTO ---
  hDocActual = Null
  $sArchivoCargado = ""
  iPaginaActual = 0
  fZoom = 1.0
  iRotacion = 0

  ' --- 2. LIMPIAR CONTROLES DE LA VISTA ---
  FMain.pbPDF.Picture = Null
  FMain.txtGotoPage.Text = ""
  FMain.lblInformacion.Text = ""

End

' ============================================
' Función   : AbrirPDFEnVisorExterno
' Propósito : Abre el PDF seleccionado en cmbVerPDF con la aplicación
'             predeterminada del sistema (xdg-open vía gb.desktop).
'             Invocada desde btnVerPDFenVisor_Click.
' Parámetros: —
' Retorna   : —
' ============================================
Public Sub AbrirPDFEnVisorExterno()

  ' --- 0. INICIALIZACIÓN DE VARIABLES ---
  Dim sRuta As String

  ' --- 1. GUARDA: DEBE HABER UN PROYECTO CON CARPETA DE PDF RESUELTA ---
  If sDirPDFActual = "" Then
    m_Sonido.sonar("Error")
    Message.Warning("No hay un proyecto abierto con carpeta de PDF.")
    Return
  Endif

  ' --- 2. GUARDA: DEBE HABER UN ÍTEM SELECCIONADO EN EL COMBO ---
  If FMain.cmbVerPDF.Index < 0 Then
    m_Sonido.sonar("Error")
    Message.Warning("Seleccionar primero un PDF de la lista.")
    Return
  Endif

  ' --- 3. RESOLVER LA RUTA ABSOLUTA DEL ÍTEM SELECCIONADO ---
  ' MISMO CRITERIO QUE SeleccionarPDF: CON Index >= 0, Text ES EL ÍTEM ELEGIDO
  sRuta = sDirPDFActual &/ FMain.cmbVerPDF.Text

  ' --- 4. GUARDA: EL ARCHIVO PUDO BORRARSE DESPUÉS DE POBLAR EL COMBO ---
  ' ES LA ÚNICA FORMA DE INFORMAR ESTE FALLO: Desktop.Open SIN ESPERA NO LO REPORTA (GV-23)
  If Not Exist(sRuta) Then
    m_Sonido.sonar("Error")
    Message.Error("No se encontró el archivo:" & Chr(10) & sRuta)
    Return
  Endif

  ' --- 5. ABRIR EN EL VISOR DEL SISTEMA (RC-GM-02) ---
  ' SIN Wait: Wait = True USA Process.Wait Y CONGELA LA INTERFAZ (GV-17).
  ' ESTE Try SOLO ATRAPA FALLOS DE LANZAMIENTO, NO LA FALTA DE VISOR ASOCIADO.
  Try Desktop.Open(sRuta)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo abrir el PDF en el visor del sistema:" & Chr(10) & Error.Text)
    Return
  Endif

End
