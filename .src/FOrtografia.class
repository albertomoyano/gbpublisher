' Gambas class file

' ============================================
' Clase     : FOrtografia
' Propósito : Formulario modal de corrección ortográfica sobre el editor de
'             texto del proyecto (FMain.txtEditorProyecto).
' Proyecto  : gbpublisher
' ============================================
'
' REESCRITURA 2026-09. QUÉ CAMBIÓ Y POR QUÉ:
'
' 1. ConvertirPosicionALineaColumna SALIÓ DEL FORMULARIO. ESTABA DECLARADA CON
'    PARÁMETROS ByRef Y NUNCA PROPAGÓ NADA: EN GAMBAS LOS PRIMITIVOS SE PASAN
'    SIEMPRE POR VALOR (GV-24). LÍNEA Y COLUMNA QUEDABAN EN CERO, ASÍ QUE EL
'    EDITOR NUNCA SALTÓ AL ERROR. AHORA LA APORTA m_Hunspell Y DEVUELVE UN
'    CPosicionTexto, QUE ES LA ALTERNATIVA 2 DE ESA MISMA REGLA.
'
' 2. LA LLAMADA A Select TENÍA LOS ARGUMENTOS INVERTIDOS. EL TextEditor USA
'    (Column, Line) EN TODOS SUS MÉTODOS DE POSICIONAMIENTO (RC-GM-06). EL BUG
'    ESTABA TAPADO POR EL ANTERIOR: CON CEROS NO SE NOTA.
'
' 3. $aErrores PASA DE Collection[] CON ARRAYS PARALELOS A CPalabraHallada[].
'    COMO m_Hunspell.ExtraerPalabras YA DEVUELVE LAS PALABRAS EN ORDEN DE
'    APARICIÓN, DESAPARECE TAMBIÉN EL ORDENAMIENTO BURBUJA.
'
' 4. LOS CORTES DEL REEMPLAZO VAN CON String.Mid Y String.Len. CON Left / Mid /
'    Len EL CORTE ERA EN BYTES Y PODÍA PARTIR UN CARÁCTER MULTIBYTE POR LA
'    MITAD, DEJANDO UN BYTE HUÉRFANO EN EL ARCHIVO (RC-GM-12, SC-02, GV-03).
'
' 5. «TODAS» REEMPLAZA POR POSICIÓN Y NO CON Replace DE SUBCADENAS. LA VERSIÓN
'    ANTERIOR CONVERTÍA «casco» EN «casaco» AL REEMPLAZAR «cas» POR «casa».
'
' 6. SE CONSULTA m_Hunspell.UltimoError DESPUÉS DE CADA INVOCACIÓN. ANTES, SI
'    FALTABA EL DICCIONARIO O EL BINARIO, EL RESULTADO VACÍO SE ANUNCIABA COMO
'    «no se encontraron errores ortográficos» (GV-23).
'
' PENDIENTE ANOTADO: APLICAR UN REEMPLAZO REASIGNA txtEditorProyecto.Text
' COMPLETO, LO QUE PIERDE LA PILA DE DESHACER Y LA POSICIÓN DEL CURSOR. LA VÍA
' LIMPIA SERÍA Select MÁS Insert SOBRE EL PROPIO CONTROL, PERO NO ESTÁ
' VERIFICADO QUE Insert REEMPLACE LA SELECCIÓN EN LUGAR DE AGREGARSE A ELLA.
' SE DEJA LA REASIGNACIÓN, QUE ESTÁ PROBADA, HASTA HACER ESE MINI-TEST.

' ============================================
' VARIABLES DE ESTADO DEL CORRECTOR
' ============================================

Private $aErrores As New CPalabraHallada[]    ' ERRORES EN ORDEN DE APARICIÓN
Private $iIndiceActual As Integer             ' ÍNDICE DEL ERROR EN PANTALLA
Private $iTotalErrores As Integer             ' TOTAL VIGENTE DE ERRORES
Private $sIdiomaActual As String              ' CÓDIGO DE IDIOMA SELECCIONADO
Private $aPalabrasIgnoradas As New String[]   ' IGNORADAS DURANTE ESTA SESIÓN
Private $bHuboCambios As Boolean              ' SE APLICÓ AL MENOS UN REEMPLAZO
Private $bCierrePermitido As Boolean          ' HABILITA EL CIERRE DESDE EL BOTÓN

' ============================================
' Función   : Form_Open
' Propósito : Inicializa el estado y carga los diccionarios disponibles
' Parámetros: ninguno
' Retorna   : nada
' ============================================

Public Sub Form_Open()

  ' --- 1. DISPOSICIÓN ---
  SplitterOrtografia.Layout = [1, 1]

  ' --- 2. ESTADO INICIAL ---
  $bHuboCambios = False
  $bCierrePermitido = False
  $iIndiceActual = 0
  $iTotalErrores = 0
  $aErrores.Clear()
  $aPalabrasIgnoradas.Clear()

  ' --- 3. DICCIONARIOS ---
  CargarDiccionarios()

  If cmbDiccionarioIdioma.Count > 0 Then
    SeleccionarIdiomaDefault()
    $sIdiomaActual = cmbDiccionarioIdioma.Text
    txtContadorErrores.Text = "Cargando..."
  Else
    m_Sonido.sonar("Error")
    Message.Warning("No se encontraron diccionarios instalados en el sistema." & gb.NewLine &
      "Instale los diccionarios de LibreOffice/Hunspell.")
    txtContadorErrores.Text = "Sin diccionario"
  Endif

End

' ============================================
' Función   : Form_Show
' Propósito : Lanza el escaneo una vez que el formulario ya es visible
' Parámetros: ninguno
' Retorna   : nada
' ============================================

Public Sub Form_Show()

  ' EL GUARD VA EN If ANIDADO: And NO CORTOCIRCUITA (RC-GM-17)
  If cmbDiccionarioIdioma.Count > 0 Then
    If $sIdiomaActual <> "" Then
      EscanearDocumento()
    Endif
  Endif

End

' ============================================
' Función   : CargarDiccionarios
' Propósito : Llena el combo con los idiomas que tienen diccionario instalado
' Parámetros: ninguno
' Retorna   : nada
' ============================================

Private Sub CargarDiccionarios()

  Dim aDiccionarios As String[]
  Dim sIdioma As String

  cmbDiccionarioIdioma.Clear()

  aDiccionarios = m_Hunspell.ObtenerDiccionariosDisponibles()

  For Each sIdioma In aDiccionarios
    cmbDiccionarioIdioma.Add(sIdioma)
  Next

End

' ============================================
' Función   : SeleccionarIdiomaDefault
' Propósito : Elige el idioma inicial con prioridad es_ES, es_AR, es_*, primero
' Parámetros: ninguno
' Retorna   : nada
' ============================================

Private Sub SeleccionarIdiomaDefault()

  Dim sIdioma As String
  Dim i As Integer

  ' --- 1. PRIORIDAD ES_ES ---
  For i = 0 To cmbDiccionarioIdioma.Count - 1
    If cmbDiccionarioIdioma[i].Text = "es_ES" Then
      cmbDiccionarioIdioma.Index = i
      Return
    Endif
  Next

  ' --- 2. PRIORIDAD ES_AR ---
  For i = 0 To cmbDiccionarioIdioma.Count - 1
    If cmbDiccionarioIdioma[i].Text = "es_AR" Then
      cmbDiccionarioIdioma.Index = i
      Return
    Endif
  Next

  ' --- 3. CUALQUIER VARIANTE DE ESPAÑOL ---
  For i = 0 To cmbDiccionarioIdioma.Count - 1
    sIdioma = cmbDiccionarioIdioma[i].Text
    If Left(sIdioma, 3) = "es_" Then
      cmbDiccionarioIdioma.Index = i
      Return
    Endif
  Next

  ' --- 4. SIN ESPAÑOL: EL PRIMERO DE LA LISTA ---
  cmbDiccionarioIdioma.Index = 0

End

' ============================================
' Función   : EscanearDocumento
' Propósito : Recorre el documento y arma la lista de errores ortográficos
' Parámetros: ninguno
' Retorna   : nada
' ============================================

Public Sub EscanearDocumento()

  Dim aHalladas As CPalabraHallada[]
  Dim aUnicas As New String[]
  Dim aIncorrectas As String[]
  Dim cIncorrectas As New Collection
  Dim oPalabra As CPalabraHallada
  Dim sPalabra As String
  Dim sTexto As String

  ' --- 1. ESTADO DE ESPERA ---
  txtContadorErrores.Text = "Analizando..."
  Me.Refresh()

  $aErrores.Clear()
  $iIndiceActual = 0
  $iTotalErrores = 0

  ' --- 2. EXTRACCIÓN DE PALABRAS ---
  ' bLimpiarShortcodes QUEDA EN True: EN UN .md HAY URLS, DOIS Y SHORTCODES
  ' QUE NO DEBEN VERIFICARSE. EL EDITOR RTF LLAMARÁ CON False.
  sTexto = FMain.txtEditorProyecto.Text
  aHalladas = m_Hunspell.ExtraerPalabras(sTexto, True)

  If aHalladas.Count = 0 Then
    LimpiarInterfaz()
    txtContadorErrores.Text = "0 de 0"
    m_Sonido.sonar("info")
    Message.Info("El documento no tiene palabras para verificar.")
    Return
  Endif

  ' --- 3. LISTA DE PALABRAS ÚNICAS, SALTEANDO LAS IGNORADAS ---
  ' LAS CLAVES DE Collection SON SENSIBLES A MAYÚSCULAS (GV-04), QUE ES LO QUE
  ' QUEREMOS: «Marx» Y «marx» SON PALABRAS DISTINTAS PARA EL CORRECTOR.
  For Each oPalabra In aHalladas

    If $aPalabrasIgnoradas.Find(oPalabra.sPalabra) >= 0 Then Continue

    If aUnicas.Find(oPalabra.sPalabra) < 0 Then
      aUnicas.Add(oPalabra.sPalabra)
    Endif

  Next

  If aUnicas.Count = 0 Then
    LimpiarInterfaz()
    txtContadorErrores.Text = "0 de 0"
    m_Sonido.sonar("info")
    Message.Info("No quedan palabras por verificar.")
    Return
  Endif

  ' --- 4. VERIFICACIÓN EN UNA SOLA INVOCACIÓN ---
  aIncorrectas = m_Hunspell.VerificarPalabrasLote(aUnicas, $sIdiomaActual)

  ' UN ARRAY VACÍO PUEDE SER «NINGUNA INCORRECTA» O «FALLÓ LA VERIFICACIÓN»:
  ' SIN ESTE CONTROL, UN DICCIONARIO AUSENTE SE ANUNCIABA COMO DOCUMENTO
  ' IMPECABLE (GV-23).
  If m_Hunspell.UltimoError <> "" Then
    LimpiarInterfaz()
    txtContadorErrores.Text = "Error"
    m_Sonido.sonar("Error")
    Message.Error("No se pudo verificar la ortografía:" & gb.NewLine & m_Hunspell.UltimoError)
    Return
  Endif

  ' --- 5. ARMADO DE LA LISTA DE ERRORES ---
  ' SE INDEXAN LAS INCORRECTAS EN UNA Collection PARA NO HACER UNA BÚSQUEDA
  ' LINEAL POR CADA PALABRA DEL DOCUMENTO.
  For Each sPalabra In aIncorrectas
    cIncorrectas[sPalabra] = True
  Next

  ' ExtraerPalabras DEVUELVE EN ORDEN DE APARICIÓN, ASÍ QUE EL FILTRADO
  ' CONSERVA EL ORDEN Y NO HACE FALTA ORDENAR DESPUÉS.
  For Each oPalabra In aHalladas
    If cIncorrectas.Exist(oPalabra.sPalabra) Then
      $aErrores.Add(oPalabra)
    Endif
  Next

  $iTotalErrores = $aErrores.Count

  ' --- 6. PRIMER ERROR O AVISO DE DOCUMENTO LIMPIO ---
  If $iTotalErrores > 0 Then
    $iIndiceActual = 0
    MostrarErrorActual()
  Else
    LimpiarInterfaz()
    txtContadorErrores.Text = "0 de 0"
    m_Sonido.sonar("info")
    Message.Info("No se encontraron errores ortográficos.")
  Endif

End

' ============================================
' Función   : MostrarErrorActual
' Propósito : Vuelca el error en curso en la interfaz y lo ubica en el editor
' Parámetros: ninguno
' Retorna   : nada
' ============================================

Private Sub MostrarErrorActual()

  Dim oError As CPalabraHallada
  Dim oPosicion As CPosicionTexto
  Dim aSugerencias As String[]
  Dim sSugerencia As String
  Dim sContexto As String
  Dim sTexto As String

  ' --- 1. VALIDACIÓN DEL ÍNDICE ---
  If $iTotalErrores = 0 Or If $iIndiceActual >= $aErrores.Count Then
    LimpiarInterfaz()
    txtContadorErrores.Text = "0 de 0"
    Return
  Endif

  oError = $aErrores[$iIndiceActual]

  ' --- 2. PALABRA Y CONTEXTO ---
  txtErrorEncontrado.Text = oError.sPalabra

  sTexto = FMain.txtEditorProyecto.Text
  sContexto = m_Hunspell.ObtenerContexto(sTexto, oError.iPosicion, oError.iLongitud, 50)
  txtContexto.Text = sContexto
  txtContexto.HighlightString(oError.sPalabra, False, True)

  ' --- 3. SUGERENCIAS ---
  lstSugerencias.Clear()
  aSugerencias = m_Hunspell.ObtenerSugerencias(oError.sPalabra, $sIdiomaActual)

  For Each sSugerencia In aSugerencias
    lstSugerencias.Add(sSugerencia)
  Next

  If lstSugerencias.Count > 0 Then
    lstSugerencias.Index = 0
    txtReemplazar.Text = lstSugerencias[0].Text
  Else
    txtReemplazar.Text = oError.sPalabra
  Endif

  ' --- 4. CONTADOR ---
  txtContadorErrores.Text = CStr($iIndiceActual + 1) & " de " & CStr($iTotalErrores)

  ' --- 5. UBICACIÓN EN EL EDITOR ---
  ' EL RESULTADO VIENE COMO OBJETO PORQUE UN PRIMITIVO NO PUEDE VOLVER POR
  ' PARÁMETRO (GV-24). Y EL ORDEN DE LOS ARGUMENTOS ES (Column, Line) EN TODOS
  ' LOS MÉTODOS DE POSICIONAMIENTO DEL TextEditor (RC-GM-06): LA CONVENCIÓN
  ' SEMÁNTICA «LÍNEA PRIMERO» QUE SUGIEREN LAS PROPIEDADES DE LECTURA NO SE
  ' APLICA ACÁ. NO INVERTIR.
  oPosicion = m_Hunspell.ConvertirPosicionALineaColumna(sTexto, oError.iPosicion)

  Try FMain.txtEditorProyecto.GotoCenter(oPosicion.iColumna, oPosicion.iLinea)
  If Error Then Return

  Try FMain.txtEditorProyecto.Select(oPosicion.iColumna, oPosicion.iLinea,
    oPosicion.iColumna + oError.iLongitud, oPosicion.iLinea)

End

' ============================================
' Función   : LimpiarInterfaz
' Propósito : Deja los campos del formulario vacíos
' Parámetros: ninguno
' Retorna   : nada
' ============================================

Private Sub LimpiarInterfaz()

  txtErrorEncontrado.Text = ""
  txtContexto.Clear()
  lstSugerencias.Clear()
  txtReemplazar.Text = ""

End

' ============================================
' Función   : IrAlSiguienteError
' Propósito : Avanza al siguiente error de la lista
' Parámetros: ninguno
' Retorna   : nada
' ============================================

Private Sub IrAlSiguienteError()

  Inc $iIndiceActual

  If $iIndiceActual >= $aErrores.Count Then
    LimpiarInterfaz()
    txtContadorErrores.Text = CStr($iTotalErrores) & " de " & CStr($iTotalErrores)
    m_Sonido.sonar("info")
    Message.Info("Se han revisado todos los errores.")
    Return
  Endif

  MostrarErrorActual()

End

' ============================================
' Función   : lstSugerencias_Click
' Propósito : Copia la sugerencia elegida al campo de reemplazo
' Parámetros: ninguno
' Retorna   : nada
' ============================================

Public Sub lstSugerencias_Click()

  If lstSugerencias.Index >= 0 Then
    txtReemplazar.Text = lstSugerencias.Current.Text
  Endif

End

' ============================================
' Función   : lstSugerencias_DblClick
' Propósito : Aplica directamente la sugerencia con doble clic
' Parámetros: ninguno
' Retorna   : nada
' ============================================

Public Sub lstSugerencias_DblClick()

  If lstSugerencias.Index >= 0 Then
    txtReemplazar.Text = lstSugerencias.Current.Text
    btnAplicar_Click()
  Endif

End

' ============================================
' Función   : ReemplazarEnTexto
' Propósito : Sustituye un tramo del texto por otro, cortando en caracteres
' Parámetros: sTexto As String — texto completo
'             iPosicion As Integer — inicio del tramo, en caracteres, base 1
'             iLongitud As Integer — largo del tramo, en caracteres
'             sNuevo As String — texto de reemplazo
' Retorna   : String — el texto con la sustitución aplicada
' ============================================

Private Function ReemplazarEnTexto(sTexto As String, iPosicion As Integer, iLongitud As Integer, sNuevo As String) As String

  Dim sIzquierda As String
  Dim sDerecha As String
  Dim iLargo As Integer
  Dim iInicioDerecha As Integer

  ' String.Mid Y NO Mid: EL CORTE EN BYTES PUEDE PARTIR UN CARÁCTER MULTIBYTE
  ' POR LA MITAD Y DEJAR UN BYTE HUÉRFANO EN EL ARCHIVO (GV-03, SC-02).
  iLargo = String.Len(sTexto)
  sIzquierda = ""
  sDerecha = ""

  If iPosicion > 1 Then
    sIzquierda = String.Mid(sTexto, 1, iPosicion - 1)
  Endif

  iInicioDerecha = iPosicion + iLongitud

  If iInicioDerecha <= iLargo Then
    sDerecha = String.Mid(sTexto, iInicioDerecha, iLargo - iInicioDerecha + 1)
  Endif

  Return sIzquierda & sNuevo & sDerecha

End

' ============================================
' Función   : btnAplicar_Click
' Propósito : Reemplaza la palabra del error en curso
' Parámetros: ninguno
' Retorna   : nada
' ============================================

Public Sub btnAplicar_Click()

  Dim oError As CPalabraHallada
  Dim oSiguiente As CPalabraHallada
  Dim sReemplazo As String
  Dim sTexto As String
  Dim iDiferencia As Integer
  Dim i As Integer

  ' --- 1. VALIDACIÓN DE ESTADO ---
  If $iTotalErrores = 0 Or If $iIndiceActual >= $aErrores.Count Then
    Return
  Endif

  oError = $aErrores[$iIndiceActual]
  sReemplazo = Trim(txtReemplazar.Text)

  If sReemplazo = "" Then
    m_Sonido.sonar("Error")
    Message.Warning("Debe ingresar una palabra de reemplazo.")
    Return
  Endif

  ' --- 2. SUSTITUCIÓN EN EL EDITOR ---
  sTexto = FMain.txtEditorProyecto.Text
  FMain.txtEditorProyecto.Text = ReemplazarEnTexto(sTexto, oError.iPosicion, oError.iLongitud, sReemplazo)
  $bHuboCambios = True

  ' --- 3. CORRIMIENTO DE LOS ERRORES POSTERIORES ---
  ' EL ARRAY GUARDA REFERENCIAS Y NO COPIAS (GV-14), ASÍ QUE MODIFICAR EL
  ' OBJETO ACTUALIZA LA ENTRADA DE LA LISTA.
  iDiferencia = String.Len(sReemplazo) - oError.iLongitud

  If iDiferencia <> 0 Then
    For i = $iIndiceActual + 1 To $aErrores.Max
      oSiguiente = $aErrores[i]
      oSiguiente.iPosicion += iDiferencia
    Next
  Endif

  ' --- 4. BAJA DEL ERROR RESUELTO ---
  ' Remove REINDEXA (GV-14): EL ÍNDICE ACTUAL YA APUNTA AL SIGUIENTE ERROR.
  $aErrores.Remove($iIndiceActual)
  $iTotalErrores = $aErrores.Count

  ' --- 5. SIGUIENTE ERROR ---
  If $aErrores.Count = 0 Then
    LimpiarInterfaz()
    txtContadorErrores.Text = "0 de 0"
    m_Sonido.sonar("info")
    Message.Info("Se han corregido todos los errores.")
    Return
  Endif

  If $iIndiceActual >= $aErrores.Count Then
    $iIndiceActual = $aErrores.Max
  Endif

  MostrarErrorActual()

End

' ============================================
' Función   : btnAplicaTodas_Click
' Propósito : Reemplaza todas las apariciones de la palabra del error en curso
' Parámetros: ninguno
' Retorna   : nada
' ============================================

Public Sub btnAplicaTodas_Click()

  Dim oError As CPalabraHallada
  Dim sPalabraOriginal As String
  Dim sReemplazo As String
  Dim sTexto As String
  Dim iCambios As Integer
  Dim i As Integer

  ' --- 1. VALIDACIÓN DE ESTADO ---
  If $iTotalErrores = 0 Or If $iIndiceActual >= $aErrores.Count Then
    Return
  Endif

  oError = $aErrores[$iIndiceActual]
  sPalabraOriginal = oError.sPalabra
  sReemplazo = Trim(txtReemplazar.Text)

  If sReemplazo = "" Then
    m_Sonido.sonar("Error")
    Message.Warning("Debe ingresar una palabra de reemplazo.")
    Return
  Endif

  ' --- 2. CONFIRMACIÓN ---
  If Message.Question("¿Reemplazar todas las apariciones de " & Chr(34) & sPalabraOriginal & Chr(34) &
      " por " & Chr(34) & sReemplazo & Chr(34) & "?", "Sí", "No") <> 1 Then
    Return
  Endif

  ' --- 3. SUSTITUCIÓN POR POSICIÓN, DE ATRÁS HACIA ADELANTE ---
  ' RECORRER EN REVERSA MANTIENE VÁLIDAS LAS POSICIONES ANTERIORES SIN TENER
  ' QUE RECALCULARLAS. NO SE USA Replace SOBRE EL TEXTO: REEMPLAZA SUBCADENAS
  ' Y CONVERTIRÍA «casco» EN «casaco» AL CAMBIAR «cas» POR «casa».
  sTexto = FMain.txtEditorProyecto.Text
  iCambios = 0

  For i = $aErrores.Max To 0 Step -1

    oError = $aErrores[i]

    If oError.sPalabra = sPalabraOriginal Then
      sTexto = ReemplazarEnTexto(sTexto, oError.iPosicion, oError.iLongitud, sReemplazo)
      Inc iCambios
    Endif

  Next

  FMain.txtEditorProyecto.Text = sTexto
  $bHuboCambios = True

  m_Sonido.sonar("info")
  Message.Info("Se reemplazaron " & CStr(iCambios) & " apariciones.")

  ' --- 4. REESCANEO ---
  ' LAS POSICIONES DE TODO EL DOCUMENTO SE CORRIERON: SE RECALCULA DESDE CERO
  ' EN LUGAR DE ARRASTRAR AJUSTES ACUMULADOS.
  EscanearDocumento()

End

' ============================================
' Función   : btnIgnorar_Click
' Propósito : Deja el error en curso como está y pasa al siguiente
' Parámetros: ninguno
' Retorna   : nada
' ============================================

Public Sub btnIgnorar_Click()

  IrAlSiguienteError()

End

' ============================================
' Función   : btnIgnorarTodas_Click
' Propósito : Descarta todas las apariciones de la palabra del error en curso
' Parámetros: ninguno
' Retorna   : nada
' ============================================

Public Sub btnIgnorarTodas_Click()

  Dim oError As CPalabraHallada
  Dim sPalabra As String
  Dim i As Integer

  ' --- 1. VALIDACIÓN DE ESTADO ---
  If $iTotalErrores = 0 Or If $iIndiceActual >= $aErrores.Count Then
    Return
  Endif

  sPalabra = $aErrores[$iIndiceActual].sPalabra

  ' --- 2. ALTA EN LA LISTA DE IGNORADAS DE LA SESIÓN ---
  If $aPalabrasIgnoradas.Find(sPalabra) < 0 Then
    $aPalabrasIgnoradas.Add(sPalabra)
  Endif

  ' --- 3. BAJA DE LAS APARICIONES ---
  ' EN REVERSA: Remove REINDEXA Y NUNCA HAY QUE BORRAR DENTRO DE UN RECORRIDO
  ' ASCENDENTE SOBRE EL MISMO ARRAY (GV-14).
  For i = $aErrores.Max To 0 Step -1
    oError = $aErrores[i]
    If oError.sPalabra = sPalabra Then
      $aErrores.Remove(i)
    Endif
  Next

  $iTotalErrores = $aErrores.Count

  ' --- 4. SIGUIENTE ERROR ---
  If $aErrores.Count = 0 Then
    LimpiarInterfaz()
    txtContadorErrores.Text = "0 de 0"
    m_Sonido.sonar("info")
    Message.Info("Se han revisado todos los errores.")
    Return
  Endif

  If $iIndiceActual >= $aErrores.Count Then
    $iIndiceActual = $aErrores.Max
  Endif

  MostrarErrorActual()

End

' ============================================
' Función   : btnAgregarAlDiccionario_Click
' Propósito : Suma la palabra al diccionario personal del usuario
' Parámetros: ninguno
' Retorna   : nada
' ============================================

Public Sub btnAgregarAlDiccionario_Click()

  Dim sPalabra As String

  ' --- 1. PALABRA A AGREGAR ---
  ' SE PRIORIZA LA PALABRA ERRÓNEA: AGREGAR AL DICCIONARIO SIGNIFICA «ESTA
  ' ESTÁ BIEN ESCRITA», NO «GUARDAR LA SUGERENCIA».
  sPalabra = Trim(txtErrorEncontrado.Text)

  If sPalabra = "" Then
    sPalabra = Trim(txtReemplazar.Text)
  Endif

  If sPalabra = "" Then
    m_Sonido.sonar("Error")
    Message.Warning("No hay palabra para agregar al diccionario.")
    Return
  Endif

  ' --- 2. ALTA ---
  If Not m_Hunspell.AgregarAlDiccionarioPersonal(sPalabra, $sIdiomaActual) Then
    m_Sonido.sonar("Error")
    Message.Error("No se pudo agregar la palabra al diccionario personal:" & gb.NewLine & m_Hunspell.UltimoError)
    Return
  Endif

  m_Sonido.sonar("info")
  Message.Info("La palabra " & Chr(34) & sPalabra & Chr(34) & " se agregó al diccionario personal.")

  ' --- 3. SE DESCARTAN SUS APARICIONES EN ESTA SESIÓN ---
  btnIgnorarTodas_Click()

End

' ============================================
' Función   : cmbDiccionarioIdioma_Click
' Propósito : Cambia el idioma del corrector y vuelve a escanear
' Parámetros: ninguno
' Retorna   : nada
' ============================================

Public Sub cmbDiccionarioIdioma_Click()

  Dim sNuevoIdioma As String

  sNuevoIdioma = cmbDiccionarioIdioma.Text

  If sNuevoIdioma = $sIdiomaActual Then Return

  ' --- 1. GUARD DE CAMBIOS SIN GUARDAR ---
  If $bHuboCambios Then

    Select Case Message.Question("Hubo cambios en el documento. ¿Desea guardarlos antes de cambiar de idioma?",
          "Guardar", "No guardar", "Cancelar")
      Case 1
        FMain.btnGuardarCambiosEditor_Click()
        $bHuboCambios = False
      Case 2
        ' SE CONTINÚA SIN GUARDAR
      Case 3
        ' SE RESTAURA EL IDIOMA ANTERIOR Y SE ABORTA
        cmbDiccionarioIdioma.Text = $sIdiomaActual
        Return
    End Select

  Endif

  ' --- 2. NUEVO IDIOMA Y REESCANEO ---
  ' LAS IGNORADAS SE LIMPIAN: LO QUE ERA CORRECTO EN UN IDIOMA NO TIENE POR
  ' QUÉ SERLO EN OTRO.
  $sIdiomaActual = sNuevoIdioma
  $aPalabrasIgnoradas.Clear()

  EscanearDocumento()

End

' ============================================
' Función   : btnRefrescar_Click
' Propósito : Vuelve a escanear el documento completo
' Parámetros: ninguno
' Retorna   : nada
' ============================================

Public Sub btnRefrescar_Click()

  EscanearDocumento()

End

' ============================================
' Función   : btnCerrar_Click
' Propósito : Cierra el formulario avisando si quedaron cambios sin guardar
' Parámetros: ninguno
' Retorna   : nada
' ============================================

Public Sub btnCerrar_Click()

  If $bHuboCambios Then
    m_Sonido.sonar("info")
    Message.Info("Se realizaron cambios en el documento." & gb.NewLine &
      "Recuerde guardar el archivo para conservarlos.")
  Endif

  $bCierrePermitido = True
  Me.Close()

End

' ============================================
' Función   : Form_Close
' Propósito : Limpia el resaltado y bloquea el cierre por la X del sistema
' Parámetros: ninguno
' Retorna   : nada
' ============================================

Public Sub Form_Close()

  ' --- 1. CIERRE POR EL BOTÓN: SE LIMPIA Y SE PERMITE ---
  If $bCierrePermitido Then
    Try FMain.txtEditorProyecto.HighlightString("")
    Return
  Endif

  ' --- 2. CIERRE POR LA X: SE BLOQUEA ---
  m_Sonido.sonar("info")
  Message.Info("Para cerrar el formulario correctamente," & gb.NewLine &
    "use el botón <b>Cerrar</b>.")
  Stop Event

End

' ============================================
' Función   : SplitterOrtografia_Resize
' Propósito : Mantiene las dos mitades del divisor en proporción pareja
' Parámetros: ninguno
' Retorna   : nada
' ============================================

Public Sub SplitterOrtografia_Resize()

  SplitterOrtografia.Layout = [1, 1]

End
