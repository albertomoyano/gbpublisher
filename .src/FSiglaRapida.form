# Gambas Form File 3.0

{ Form Form
  Move(0,0,560,380)
  #Scaled = False
  Text = ("Insertar sigla")
  Resizable = False
  Arrangement = Arrange.Vertical
  Spacing = True
  Margin = True
  Padding = 4
  { txtBuscarSigla TextBox
    Move(9,9,540,36)
    Placeholder = ("Sigla o parte del desarrollo")
  }
  { lstSiglas ListBox
    Move(9,54,540,200)
    NoTabFocus = True
    Expand = True
  }
  { vbxAlta VBox
    Move(9,263,540,72)
    Visible = False
    { hbxAltaSigla HBox
      Move(0,0,540,36)
      { lblAltaSigla Label
        Move(0,0,110,36)
        Alignment = Align.Right
        Text = ("sigla: ")
      }
      { txtAltaSigla TextBox
        Move(113,0,160,36)
        MaxLength = 32
      }
    }
    { hbxAltaDesarrollo HBox
      Move(0,36,540,36)
      { lblAltaDesarrollo Label
        Move(0,0,110,36)
        Alignment = Align.Right
        Text = ("desarrollo: ")
      }
      { txtAltaDesarrollo TextBox
        Move(113,0,420,36)
        Expand = True
        Placeholder = ("La cursiva va entre asteriscos: *Clarín*")
        MaxLength = 500
      }
    }
  }
  { lblEstadoRapida Label
    Move(9,344,459,36)
    Font = Font["-1"]
    Foreground = &H0000FF
  }
}
