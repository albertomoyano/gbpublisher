' Gambas module file

' ============================================
' Módulo    : m_GestionImagenes
' Propósito : NÚCLEO DEL RETOCADOR DE FIGURAS DE /media DEL PROYECTO ABIERTO.
'             CADA OPERACIÓN ES UNA FUNCIÓN PURA SOBRE LA IMAGEN EN MEMORIA ($hImage).
'             LAS VISTAS (SEMÁFORO, txtInfoImagen, VISOR) SON DERIVADAS DE ESA RAÍZ.
' Depende de: gb.image, gb.image.effect, componente gráfico (gb.qt5).
'             NO USA gb.image.io (INCOMPATIBLE CON qt5) NI gb.image.imlib.
' Regla usr : FIGURAS EN /media, MINÚSCULA, PREFIJO fig- OBLIGATORIO.
' ============================================

' --- 0. ESTADO RAÍZ (LA "RAÍZ" DE LA QUE CUELGA CADA BOTÓN) ---
Private $hImage As Image              ' IMAGEN ACTIVA EN MEMORIA — FUENTE DE VERDAD
Private $hTemp As Image               ' COPIA PARA BALANCE (PATRÓN begin/apply/cancel)
Private $hUndoStack As New Image[]    ' PILA DE DESHACER — SOLO EN MEMORIA (SE PIERDE AL CERRAR)
Private $bModify As Boolean           ' HAY CAMBIOS SIN GUARDAR EN LA FIGURA ACTUAL
Private $sModo As String              ' "" (NORMAL) O "recorte" (ARRASTRE DIBUJA SELECCIÓN)
Private $sArchivoActual As String     ' NOMBRE DEL fig-* CARGADO (SIN RUTA)
Private $sFirmaMedia As String        ' FOTO DEL CONTENIDO DE /media PARA DETECTAR CAMBIOS

' ============================================
' Función   : ResetearEstado
' Propósito : LIMPIAR LA RAÍZ Y LAS VISTAS. LLAMAR AL ABRIR PROYECTO Y AL LOGOUT (RC-GM-16).
' Parámetros: (NINGUNO)
' Retorna   : (NADA)
' ============================================
Public Sub ResetearEstado()

  ' --- 1. VACIAR ESTADO EN MEMORIA ---
  $hImage = Null
  $hTemp = Null
  $hUndoStack = New Image[]
  $bModify = False
  $sModo = ""
  $sArchivoActual = ""

  ' --- 2. LIMPIAR LA UI DERIVADA ---
  FMain.cmbImagenes.Clear()
  FMain.txtInfoImagen.Text = ""
  FMain.pbImagen.Image = Null
  FMain.pbSemaforo.Picture = Null
  FMain.iIndiceImagenCargada = -1

End

' ============================================
' Función   : RefrescarVisor
' Propósito : SINCRONIZAR TODAS LAS VISTAS DERIVADAS CON EL ESTADO ACTUAL DE $hImage.
'             LLAMAR TRAS CARGA Y TRAS TODA OPERACIÓN QUE MODIFIQUE LA IMAGEN.
' Parámetros: (NINGUNO)
' Retorna   : (NADA)
' ============================================
Public Sub RefrescarVisor()

  ' --- 1. SIN IMAGEN: LIMPIAR VISTAS Y SALIR ---
  If Not $hImage Then
    FMain.pbImagen.Image = Null
    FMain.txtInfoImagen.Text = ""
    FMain.pbSemaforo.Picture = Null
    Return
  Endif

  ' --- 2. MOSTRAR LA IMAGEN EN EL VISOR Y AJUSTAR (FIT CON TOPE 100%) ---
  FMain.pbImagen.Image = $hImage
  AjustarFitVentana()

  ' --- 3. ACTUALIZAR TEXTO INFORMATIVO (NOMBRE Y DIMENSIONES) ---
  FMain.txtInfoImagen.Text = $sArchivoActual & "  —  " & $hImage.W & " x " & $hImage.H & " px"

  ' --- 4. RECALCULAR SEMÁFORO (FUNCIÓN PURA DEL ANCHO EN PX) ---
  ActualizarSemaforo()

End

' ============================================
' Función   : EvaluarResolucion
' Propósito : DEVOLVER EL ESTADO DEL SEMÁFORO SEGÚN EL ANCHO EN PX CONTRA UMBRALES.
'             (COSTURA MODELO B: HOY CAJA CONSTANTE 11 cm VÍA LOS UMBRALES DE m_Constantes.)
' Parámetros: iAnchoPx As Integer — ANCHO DE LA IMAGEN EN PÍXELES
' Retorna   : Integer — 0 ROJO, 1 AMARILLO, 2 VERDE
' ============================================
Public Function EvaluarResolucion(iAnchoPx As Integer) As Integer

  ' --- 1. DECISIÓN POR UMBRALES (NÚMEROS CENTRALIZADOS EN m_Constantes, SC-03) ---
  If iAnchoPx >= m_Constantes.RES_PX_VERDE Then Return 2
  If iAnchoPx >= m_Constantes.RES_PX_AMARILLO Then Return 1
  Return 0

End

' ============================================
' Función   : ColorSemaforo
' Propósito : TRADUCIR EL ESTADO (0/1/2) AL COLOR INTEGER DEL CÍRCULO.
' Parámetros: iEstado As Integer — 0 ROJO, 1 AMARILLO, 2 VERDE
' Retorna   : Integer — COLOR PARA Paint.Color()
' ============================================
Private Function ColorSemaforo(iEstado As Integer) As Integer

  ' --- 1. MAPEO ESTADO -> COLOR (CADA Case EN LÍNEA PROPIA) ---
  Select Case iEstado
    Case 2
      Return &H00AA00&    ' VERDE   — >= 300 DPI @ 11 cm
    Case 1
      Return &HD4A017&    ' ÁMBAR   — 150..300 DPI
    Case Else
      Return &HCC0000&    ' ROJO    — < 150 DPI
  End Select

End

' ============================================
' Función   : ColorFondoSemaforo
' Propósito : DEVOLVER EL COLOR CON QUE RELLENAR EL CUADRO, PARA QUE EL ÁREA FUERA DEL
'             CÍRCULO SE FUNDA CON LA PESTAÑA (EVITA EL FONDO NEGRO DE LA IMAGEN OPACA).
' Parámetros: (NINGUNO)
' Retorna   : Integer — COLOR DE FONDO (RESUELVE Color.Default A UN COLOR REAL)
' ============================================
Private Function ColorFondoSemaforo() As Integer

  ' --- 0. INICIALIZACIÓN DE VARIABLES ---
  Dim iFondo As Integer

  ' --- 1. LEER EL FONDO DEL CONTROL ---
  iFondo = FMain.pbSemaforo.Background

  ' --- 2. Color.Default NO ES PINTABLE: RESOLVER AL FONDO ESTÁNDAR DEL TEMA ---
  If iFondo = Color.Default Then iFondo = Color.Background

  Return iFondo

End

' ============================================
' Función   : ActualizarSemaforo
' Propósito : PINTAR pbSemaforo SEGÚN LA RESOLUCIÓN DE LA IMAGEN ACTUAL.
'             CÍRCULO OPACO DE 28px CENTRADO EN CONTROL DE 36x36 (BGRP-SAFE),
'             CON EL FONDO FUNDIDO AL COLOR DE LA PESTAÑA.
' Parámetros: (NINGUNO)
' Retorna   : (NADA)
' ============================================
Public Sub ActualizarSemaforo()

  ' --- 0. INICIALIZACIÓN DE VARIABLES ---
  Dim hImg As Image
  Dim iEstado As Integer
  Dim iLado As Integer
  Dim iDisco As Integer
  Dim iMargen As Integer

  ' --- 1. SIN IMAGEN: NO HAY SEMÁFORO ---
  If Not $hImage Then
    FMain.pbSemaforo.Picture = Null
    Return
  Endif

  ' --- 2. EVALUAR ESTADO SEGÚN ANCHO EN PX ---
  iEstado = EvaluarResolucion($hImage.W)

  ' --- 3. GEOMETRÍA E IMAGEN OPACA ---
  iLado = 36
  iDisco = 20
  iMargen = (iLado - iDisco) / 2
  hImg = New Image(iLado, iLado, False)

  ' --- 4. PINTAR FONDO INTEGRADO Y LUEGO EL CÍRCULO DEL COLOR DEL ESTADO ---
  Paint.Begin(hImg)
  Paint.Rectangle(0, 0, iLado, iLado)
  Paint.Brush = Paint.Color(ColorFondoSemaforo())
  Paint.Fill
  Paint.Ellipse(iMargen, iMargen, iDisco, iDisco)
  Paint.Brush = Paint.Color(ColorSemaforo(iEstado))
  Paint.Fill
  Paint.End

  ' --- 5. ASIGNAR AL CONTROL ---
  FMain.pbSemaforo.Picture = hImg.Picture

Catch

  ' MANEJO DE ERROR DEL BLOQUE DE PINTADO (RC-GM-02 VÍA Catch). NO ABORTA LA CARGA.
  m_Sonido.sonar("Error")
  Print "ActualizarSemaforo FALLA: " & Error.Text

End

' ============================================
' Función   : HayImagenCargada
' Propósito : GUARD ÚNICO DE PRECONDICIÓN PARA LOS BOTONES DE OPERACIÓN.
' Parámetros: (NINGUNO)
' Retorna   : Boolean — True SI HAY IMAGEN EN MEMORIA
' ============================================
Public Function HayImagenCargada() As Boolean

  ' --- 1. VALIDAR RAÍZ ---
  If $hImage Then Return True

  ' --- 2. AVISAR Y NEGAR ---
  m_Sonido.sonar("Error")
  Message.Warning(("No hay ninguna imagen cargada."))
  Return False

End

' ============================================
' Función   : PushUndo
' Propósito : APILAR UNA COPIA DEL ESTADO ACTUAL ANTES DE UNA OPERACIÓN DESTRUCTIVA.
' Parámetros: (NINGUNO)
' Retorna   : (NADA)
' ============================================
Public Sub PushUndo()

  ' --- 1. APILAR COPIA (SOLO SI HAY IMAGEN) ---
  If Not $hImage Then Return
  $hUndoStack.Add($hImage.Copy())

End

' ============================================
' Función   : ConfirmarDescartarCambios
' Propósito : GUARD LOCAL. SOLO SE INVOCA AL CAMBIAR DE IMAGEN EN cmbImagenes.
'             SI HAY CAMBIOS SIN GUARDAR, AVISA ANTES DE PISAR $hImage.
'             NO SE USA AL CERRAR LA APP (AHÍ SE PIERDE SIN AVISO, POR DISEÑO).
' Parámetros: (NINGUNO)
' Retorna   : Boolean — True SI SE PUEDE CONTINUAR (SIN CAMBIOS O EL USUARIO DESCARTA)
'                       False SI EL USUARIO CANCELA (EL LLAMADOR ABORTA)
' ============================================
Public Function ConfirmarDescartarCambios() As Boolean

  ' --- 1. SIN CAMBIOS: CONTINUAR SIN PREGUNTAR ---
  If Not $bModify Then Return True

  ' --- 2. HAY CAMBIOS: AVISAR (DESCARTAR / CANCELAR) ---
  If Message.Question(("Hay cambios sin guardar en la imagen.") & Chr(10) &
      ("¿Descartar los cambios?"), ("Descartar"), ("Cancelar")) = 1 Then
    Return True
  Endif

  ' --- 3. EL USUARIO CANCELA ---
  Return False

End

' ============================================
' Función   : CargarImagen
' Propósito : CARGAR EN MEMORIA EL fig-* SELECCIONADO Y REFRESCAR VISTAS.
' Parámetros: (NINGUNO — LEE LA SELECCIÓN DEL COMBO)
' Retorna   : Boolean — True SI LA CARGA SE CONCRETÓ;
'                       False SI EL USUARIO CANCELÓ EL DESCARTE O FALLÓ LA CARGA
' ============================================
Public Function CargarImagen() As Boolean

  ' --- 0. INICIALIZACIÓN DE VARIABLES ---
  Dim sRuta As String

  ' --- 1. VALIDACIÓN: DEBE HABER SELECCIÓN EN EL COMBO ---
  If FMain.cmbImagenes.Index < 0 Then Return False

  ' --- 2. GUARD DE CAMBIOS SIN GUARDAR (SC-06) ANTES DE PISAR $hImage ---
  If Not ConfirmarDescartarCambios() Then Return False

  ' --- 3. CARGAR DESDE DISCO ---
  $sArchivoActual = FMain.cmbImagenes.Text
  sRuta = FMain.RutaProyecto &/ "media" &/ $sArchivoActual

  Try $hImage = Image.Load(sRuta)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error(("No se pudo cargar la imagen:") & Chr(10) & Error.Text)
    $hImage = Null
    RefrescarVisor()
    Return False
  Endif

  ' --- 4. RESETEAR ESTADO DE EDICIÓN PARA LA NUEVA IMAGEN ---
  $bModify = False
  $hUndoStack = New Image[]
  $sModo = ""

  ' --- 5. REFRESCAR VISTAS Y CONFIRMAR CARGA EXITOSA ---
  RefrescarVisor()
  Return True

End

' ============================================
' Función   : ConvertirAEscalaDeGrises
' Propósito : CONVERTIR LA IMAGEN ACTIVA A ESCALA DE GRISES (Desaturate).
'             Gray ESTÁ DEPRECADO EN 3.22; SE USA Desaturate (VERIFICADO EN SONDA).
' Parámetros: (NINGUNO)
' Retorna   : (NADA)
' ============================================
Public Sub ConvertirAEscalaDeGrises()

  ' --- 1. GUARD: DEBE HABER IMAGEN CARGADA ---
  If Not HayImagenCargada() Then Return

  ' --- 2. APILAR ESTADO PARA DESHACER ---
  PushUndo()

  ' --- 3. OPERAR SOBRE LA IMAGEN EN MEMORIA ---
  Try $hImage.Desaturate()
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error(("No se pudo convertir a escala de grises:") & Chr(10) & Error.Text)
    Return
  Endif

  ' --- 4. MARCAR CAMBIOS SIN GUARDAR ---
  $bModify = True

  ' --- 5. REFRESCAR VISTAS (NO CAMBIA DIMENSIONES: EL SEMÁFORO NO VARÍA, PERO RefrescarVisor ES UNIFORME) ---
  RefrescarVisor()

End

' ============================================
' Función   : AjustarFitVentana
' Propósito : AJUSTAR LA IMAGEN AL VISOR (FIT) SIN SUPERAR EL 100%.
'             LAS FIGURAS CHICAS SE MUESTRAN A TAMAÑO REAL, NO AMPLIADAS
'             (EVITA PIXELADO Y FALSA IMPRESIÓN DE BAJA CALIDAD).
' Parámetros: (NINGUNO)
' Retorna   : (NADA)
' ============================================
Public Sub AjustarFitVentana()

  ' --- 0. INICIALIZACIÓN DE VARIABLES ---
  Dim fZoom As Float

  ' --- 1. SIN IMAGEN: NADA QUE AJUSTAR ---
  If Not $hImage Then Return

  ' --- 2. FACTOR QUE HACE ENTRAR LA IMAGEN COMPLETA (EL MENOR DE ANCHO/ALTO) ---
  fZoom = Min(FMain.pbImagen.ClientW / $hImage.W, FMain.pbImagen.ClientH / $hImage.H)

  ' --- 3. TOPE EN 1: NUNCA AMPLIAR, SOLO REDUCIR ---
  If fZoom > 1 Then fZoom = 1

  ' --- 4. APLICAR ---
  Try FMain.pbImagen.Zoom = fZoom

End

' ============================================
' Función   : AjustarAncho
' Propósito : AJUSTAR EL ANCHO DE LA IMAGEN AL ANCHO DEL VISOR, SIN SUPERAR 100%.
'             EL ALTO PUEDE DESBORDAR Y SCROLLEAR.
' Parámetros: (NINGUNO)
' Retorna   : (NADA)
' ============================================
Public Sub AjustarAncho()

  ' --- 0. INICIALIZACIÓN DE VARIABLES ---
  Dim fZoom As Float

  ' --- 1. SIN IMAGEN: NADA QUE AJUSTAR ---
  If Not $hImage Then Return

  ' --- 2. FACTOR PARA QUE EL ANCHO LLENE EL VISOR, CAPADO EN 1 ---
  fZoom = FMain.pbImagen.ClientW / $hImage.W
  If fZoom > 1 Then fZoom = 1

  ' --- 3. APLICAR ---
  Try FMain.pbImagen.Zoom = fZoom

End

' ============================================
' Función   : AjustarAlto
' Propósito : AJUSTAR EL ALTO DE LA IMAGEN AL ALTO DEL VISOR, SIN SUPERAR 100%.
'             EL ANCHO PUEDE DESBORDAR Y SCROLLEAR.
' Parámetros: (NINGUNO)
' Retorna   : (NADA)
' ============================================
Public Sub AjustarAlto()

  ' --- 0. INICIALIZACIÓN DE VARIABLES ---
  Dim fZoom As Float

  ' --- 1. SIN IMAGEN: NADA QUE AJUSTAR ---
  If Not $hImage Then Return

  ' --- 2. FACTOR PARA QUE EL ALTO LLENE EL VISOR, CAPADO EN 1 ---
  fZoom = FMain.pbImagen.ClientH / $hImage.H
  If fZoom > 1 Then fZoom = 1

  ' --- 3. APLICAR ---
  Try FMain.pbImagen.Zoom = fZoom

End

' ============================================
' Función   : RotarIzquierda
' Propósito : ROTAR LA IMAGEN 90° A LA IZQUIERDA (ACUMULABLE). INTERCAMBIA ANCHO↔ALTO.
' Parámetros: (NINGUNO)
' Retorna   : (NADA)
' ============================================
Public Sub RotarIzquierda()

  ' --- 1. GUARD: DEBE HABER IMAGEN CARGADA ---
  If Not HayImagenCargada() Then Return

  ' --- 2. APILAR ESTADO PARA DESHACER ---
  PushUndo()

  ' --- 3. ROTAR 90° IZQUIERDA (REASIGNAR EL RESULTADO A $hImage) ---
  Try $hImage = $hImage.RotateLeft()
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error(("No se pudo rotar la imagen:") & Chr(10) & Error.Text)
    Return
  Endif

  ' --- 4. MARCAR CAMBIOS SIN GUARDAR ---
  $bModify = True

  ' --- 5. REFRESCAR (RECALCULA FIT Y SEMÁFORO: LAS DIMENSIONES CAMBIARON) ---
  RefrescarVisor()

End

' ============================================
' Función   : RotarDerecha
' Propósito : ROTAR LA IMAGEN 90° A LA DERECHA (ACUMULABLE). INTERCAMBIA ANCHO↔ALTO.
' Parámetros: (NINGUNO)
' Retorna   : (NADA)
' ============================================
Public Sub RotarDerecha()

  ' --- 1. GUARD: DEBE HABER IMAGEN CARGADA ---
  If Not HayImagenCargada() Then Return

  ' --- 2. APILAR ESTADO PARA DESHACER ---
  PushUndo()

  ' --- 3. ROTAR 90° DERECHA (REASIGNAR EL RESULTADO A $hImage) ---
  Try $hImage = $hImage.RotateRight()
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error(("No se pudo rotar la imagen:") & Chr(10) & Error.Text)
    Return
  Endif

  ' --- 4. MARCAR CAMBIOS SIN GUARDAR ---
  $bModify = True

  ' --- 5. REFRESCAR (RECALCULA FIT Y SEMÁFORO: LAS DIMENSIONES CAMBIARON) ---
  RefrescarVisor()

End

' ============================================
' Función   : BorrarImagenDisco
' Propósito : ELIMINAR EL fig-* SELECCIONADO DE /media (IRREVERSIBLE EN DISCO).
'             ADVIERTE PORQUE ES INSUMO DEL PIPELINE (PUEDE ESTAR REFERENCIADA).
'             TRAS BORRAR, RECONSTRUYE EL COMBO Y CARGA OTRA (O LIMPIA SI ERA LA ÚLTIMA).
' Parámetros: (NINGUNO)
' Retorna   : (NADA)
' ============================================
Public Sub BorrarImagenDisco()

  ' --- 0. INICIALIZACIÓN DE VARIABLES ---
  Dim sArchivo As String
  Dim sRuta As String

  ' --- 1. GUARD: DEBE HABER SELECCIÓN EN EL COMBO (NO DEPENDE DE $hImage) ---
  If FMain.cmbImagenes.Index < 0 Then
    m_Sonido.sonar("Error")
    Message.Warning(("No hay ninguna imagen seleccionada."))
    Return
  Endif

  ' --- 2. CONFIRMACIÓN EXPLÍCITA (IRREVERSIBLE, INSUMO DEL PIPELINE) ---
  sArchivo = FMain.cmbImagenes.Text
  m_Sonido.sonar("Question")
  If Message.Question(("¿Borrar definitivamente la figura del disco?") & Chr(10) &
      sArchivo & Chr(10) & Chr(10) &
      ("Esta acción no se puede deshacer. Si la figura está referenciada en el documento, la salida fallará."),
      ("Borrar"), ("Cancelar")) <> 1 Then Return

    ' --- 3. BORRAR EL ARCHIVO DE DISCO ---
    sRuta = FMain.RutaProyecto &/ "media" &/ sArchivo
    Try Kill sRuta
    If Error Then
      m_Sonido.sonar("Error")
      Message.Error(("No se pudo borrar la imagen:") & Chr(10) & Error.Text)
      Return
    Endif

    ' --- 4. RECONSTRUIR ESTADO Y COMBO ---
    ' LIMPIAR MEMORIA: PONER $bModify EN False ANTES DE REPOBLAR EVITA LA PREGUNTA
    ' FANTASMA DE "DESCARTAR CAMBIOS" SOBRE UNA IMAGEN QUE YA NO EXISTE
    $hImage = Null
    $bModify = False
    $hUndoStack = New Image[]
    $sArchivoActual = ""

    ' REPOBLAR DESDE DISCO (YA SIN EL ARCHIVO BORRADO); CARGA LA PRIMERA SI QUEDAN
    PoblarComboImagenes()

    ' SI NO QUEDARON FIGURAS, LIMPIAR VISTAS Y RESETEAR EL ÍNDICE DE REVERSIÓN
    If FMain.cmbImagenes.Count = 0 Then
      FMain.iIndiceImagenCargada = -1
      RefrescarVisor()
    Endif

End

' ============================================
' Función   : GuardarCambios
' Propósito : SOBRESCRIBIR EL fig-* EN /media CON LA IMAGEN EN MEMORIA.
'             CALIDAD SOLO EN jpg/jpeg (EN png EL 2º PARÁM ES COMPRESIÓN, NO CALIDAD).
'             AVISA SOLO CON SONIDO (COMO GUARDAR DEL EDITOR, SIN VENTANA).
' Parámetros: (NINGUNO)
' Retorna   : (NADA)
' ============================================
Public Sub GuardarCambios()

  ' --- 0. INICIALIZACIÓN DE VARIABLES ---
  Dim sRuta As String
  Dim sExt As String

  ' --- 1. GUARD: DEBE HABER IMAGEN CARGADA ---
  If Not HayImagenCargada() Then Return

  ' --- 2. SIN CAMBIOS: NADA QUE GUARDAR (SOLO SONIDO, SIN VENTANA) ---
  If Not $bModify Then
    m_Sonido.sonar("Info")
    Return
  Endif

  ' --- 3. CONSTRUIR RUTA Y DETERMINAR FORMATO POR EXTENSIÓN ---
  sRuta = FMain.RutaProyecto &/ "media" &/ $sArchivoActual
  sExt = String.LCase(File.Ext($sArchivoActual))

  ' --- 4. GUARDAR (CALIDAD SOLO EN jpg/jpeg) ---
  If sExt = "jpg" Or If sExt = "jpeg" Then
    Try $hImage.Save(sRuta, m_Constantes.CALIDAD_JPEG_FIGURA)
  Else
    Try $hImage.Save(sRuta)
  Endif

  If Error Then
    m_Sonido.sonar("Error")
    Message.Error(("No se pudo guardar la imagen:") & Chr(10) & Error.Text)
    Return
  Endif

  ' --- 5. CONFIRMAR: CAMBIOS PERSISTIDOS (SOLO SONIDO) ---
  $bModify = False
  m_Sonido.sonar("Info")

End

' ============================================
' Función   : IniciarBalance
' Propósito : GUARDAR UNA COPIA PRÍSTINA EN $hTemp ANTES DE EMPEZAR A PREVISUALIZAR.
'             CADA PREVIEW RE-APLICA DESDE ESTA COPIA (NUNCA ACUMULA REDONDEOS).
' Parámetros: (NINGUNO)
' Retorna   : Boolean — True SI SE PUDO INICIAR (HAY IMAGEN)
' ============================================
Public Function IniciarBalance() As Boolean

  ' --- 1. GUARD: DEBE HABER IMAGEN CARGADA ---
  If Not $hImage Then Return False

  ' --- 2. COPIA PRÍSTINA DE REFERENCIA ---
  $hTemp = $hImage.Copy()
  Return True

End

' ============================================
' Función   : PreviewBalance
' Propósito : APLICAR BALANCE DESDE LA COPIA PRÍSTINA Y MOSTRAR EL RESULTADO.
'             NO TOCA $bModify NI EL UNDO: ES SOLO PREVISUALIZACIÓN.
'             REFRESCO LIVIANO: PRESERVA EL ZOOM (EL BALANCE NO CAMBIA DIMENSIONES).
' Parámetros: fBrillo As Float — -1..1
'             fContraste As Float — -1..1
'             fGamma As Float — -1..1
' Retorna   : (NADA)
' ============================================
Public Sub PreviewBalance(fBrillo As Float, fContraste As Float, fGamma As Float)

  ' --- 0. INICIALIZACIÓN DE VARIABLES ---
  Dim fZoom As Float

  ' --- 1. GUARD: DEBE HABER COPIA DE REFERENCIA ---
  If Not $hTemp Then Return

  ' --- 2. RESTAURAR DESDE LA COPIA PRÍSTINA (EVITA ACUMULACIÓN) ---
  $hImage = $hTemp.Copy()

  ' --- 3. APLICAR LOS TRES AJUSTES EN UNA SOLA LLAMADA (Balance MUTA IN-PLACE) ---
  Try $hImage.Balance(fBrillo, fContraste, fGamma)
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error(("No se pudo aplicar el balance:") & Chr(10) & Error.Text)
    Return
  Endif

  ' --- 4. REFRESCO LIVIANO PRESERVANDO EL ZOOM DEL USUARIO ---
  fZoom = FMain.pbImagen.Zoom
  FMain.pbImagen.Image = $hImage
  Try FMain.pbImagen.Zoom = fZoom

End

' ============================================
' Función   : AplicarBalance
' Propósito : CONFIRMAR EL BALANCE PREVISUALIZADO: APILAR EL ESTADO PREVIO PARA
'             DESHACER, MARCAR CAMBIOS Y LIBERAR LA COPIA DE REFERENCIA.
' Parámetros: (NINGUNO)
' Retorna   : (NADA)
' ============================================
Public Sub AplicarBalance()

  ' --- 1. GUARD: DEBE HABER COPIA DE REFERENCIA ---
  If Not $hTemp Then Return

  ' --- 2. APILAR EL ESTADO PREVIO REAL ($hTemp, NO $hImage QUE YA ESTÁ BALANCEADA) ---
  ' NO SE USA PushUndo() PORQUE APILARÍA LA IMAGEN YA MODIFICADA
  $hUndoStack.Add($hTemp.Copy())

  ' --- 3. MARCAR CAMBIOS SIN GUARDAR Y LIBERAR REFERENCIA ---
  $bModify = True
  $hTemp = Null

End

' ============================================
' Función   : CancelarBalance
' Propósito : DESCARTAR EL PREVIEW Y VOLVER A LA IMAGEN PREVIA AL DIÁLOGO.
' Parámetros: (NINGUNO)
' Retorna   : (NADA)
' ============================================
Public Sub CancelarBalance()

  ' --- 1. SIN COPIA DE REFERENCIA: NADA QUE RESTAURAR ---
  If Not $hTemp Then Return

  ' --- 2. RESTAURAR Y LIBERAR ---
  $hImage = $hTemp
  $hTemp = Null

  ' --- 3. REFRESCAR VISTAS ---
  RefrescarVisor()

End

' ============================================
' Función   : DeshacerCambios
' Propósito : RESTAURAR EL ESTADO ANTERIOR DESDE LA PILA DE DESHACER (SOLO EN MEMORIA).
'             SI LA PILA QUEDA VACÍA, SE VOLVIÓ AL ESTADO DE LA ÚLTIMA CARGA/GUARDADO.
' Parámetros: (NINGUNO)
' Retorna   : (NADA)
' ============================================
Public Sub DeshacerCambios()

  ' --- 1. GUARD: DEBE HABER IMAGEN CARGADA ---
  If Not HayImagenCargada() Then Return

  ' --- 2. SIN NADA QUE DESHACER: AVISAR CON SONIDO Y SALIR ---
  If $hUndoStack.Count = 0 Then
    m_Sonido.sonar("Error")
    Return
  Endif

  ' --- 3. RESTAURAR EL ÚLTIMO ESTADO APILADO Y QUITARLO DE LA PILA ---
  $hImage = $hUndoStack[$hUndoStack.Max]
  $hUndoStack.Remove($hUndoStack.Max)

  ' --- 4. ESTADO DE CAMBIOS ---
  ' SI LA PILA QUEDÓ VACÍA, VOLVIMOS AL ESTADO DE LA ÚLTIMA CARGA/GUARDADO: SIN CAMBIOS.
  ' SI AÚN QUEDAN ESTADOS, SIGUE HABIENDO CAMBIOS PENDIENTES.
  If $hUndoStack.Count = 0 Then
    $bModify = False
  Else
    $bModify = True
  Endif

  ' --- 5. REFRESCAR (RECALCULA FIT Y SEMÁFORO: EL UNDO PUEDE CAMBIAR DIMENSIONES) ---
  RefrescarVisor()

End

' ============================================
' Función   : EnfocarImagen
' Propósito : APLICAR ENFOQUE (Sharpen) A LA IMAGEN ACTIVA. NO CAMBIA DIMENSIONES.
' Parámetros: (NINGUNO)
' Retorna   : (NADA)
' ============================================
Public Sub EnfocarImagen()

  ' --- 1. GUARD: DEBE HABER IMAGEN CARGADA ---
  If Not HayImagenCargada() Then Return

  ' --- 2. APILAR ESTADO PARA DESHACER ---
  PushUndo()

  ' --- 3. OPERAR SOBRE LA IMAGEN EN MEMORIA ---
  Try $hImage.Sharpen()
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error(("No se pudo enfocar la imagen:") & Chr(10) & Error.Text)
    Return
  Endif

  ' --- 4. MARCAR CAMBIOS SIN GUARDAR ---
  $bModify = True

  ' --- 5. REFRESCAR VISTAS ---
  RefrescarVisor()

End

' ============================================
' Función   : NormalizarImagen
' Propósito : NORMALIZAR (Normalize): ESTIRA EL RANGO TONAL A TODO EL ESPECTRO.
'             NO CAMBIA DIMENSIONES.
' Parámetros: (NINGUNO)
' Retorna   : (NADA)
' ============================================
Public Sub NormalizarImagen()

  ' --- 1. GUARD: DEBE HABER IMAGEN CARGADA ---
  If Not HayImagenCargada() Then Return

  ' --- 2. APILAR ESTADO PARA DESHACER ---
  PushUndo()

  ' --- 3. OPERAR SOBRE LA IMAGEN EN MEMORIA ---
  Try $hImage.Normalize()
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error(("No se pudo normalizar la imagen:") & Chr(10) & Error.Text)
    Return
  Endif

  ' --- 4. MARCAR CAMBIOS SIN GUARDAR ---
  $bModify = True

  ' --- 5. REFRESCAR VISTAS ---
  RefrescarVisor()

End

' ============================================
' Función   : QuitarMotasImagen
' Propósito : QUITAR MOTAS/RUIDO (Despeckle). NO CAMBIA DIMENSIONES.
' Parámetros: (NINGUNO)
' Retorna   : (NADA)
' ============================================
Public Sub QuitarMotasImagen()

  ' --- 1. GUARD: DEBE HABER IMAGEN CARGADA ---
  If Not HayImagenCargada() Then Return

  ' --- 2. APILAR ESTADO PARA DESHACER ---
  PushUndo()

  ' --- 3. OPERAR SOBRE LA IMAGEN EN MEMORIA ---
  Try $hImage.Despeckle()
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error(("No se pudieron quitar las motas:") & Chr(10) & Error.Text)
    Return
  Endif

  ' --- 4. MARCAR CAMBIOS SIN GUARDAR ---
  $bModify = True

  ' --- 5. REFRESCAR VISTAS ---
  RefrescarVisor()

End

' ============================================
' Función   : CorreccionAutomatica
' Propósito : CORRECCIÓN AUTOMÁTICA POR ECUALIZACIÓN DE HISTOGRAMA (Equalize).
'             DISTINTO DE Normalize: REDISTRIBUYE TONOS, NO SOLO ESTIRA EL RANGO.
'             NO CAMBIA DIMENSIONES.
' Parámetros: (NINGUNO)
' Retorna   : (NADA)
' ============================================
Public Sub CorreccionAutomatica()

  ' --- 1. GUARD: DEBE HABER IMAGEN CARGADA ---
  If Not HayImagenCargada() Then Return

  ' --- 2. APILAR ESTADO PARA DESHACER ---
  PushUndo()

  ' --- 3. OPERAR SOBRE LA IMAGEN EN MEMORIA ---
  Try $hImage.Equalize()
  If Error Then
    m_Sonido.sonar("Error")
    Message.Error(("No se pudo aplicar la corrección automática:") & Chr(10) & Error.Text)
    Return
  Endif

  ' --- 4. MARCAR CAMBIOS SIN GUARDAR ---
  $bModify = True

  ' --- 5. REFRESCAR VISTAS ---
  RefrescarVisor()

End

' ============================================
' Función   : RefrescarComboSiCambio
' Propósito : REPOBLAR EL COMBO SOLO SI EL CONTENIDO DE /media CAMBIÓ.
'             COMPARA POR FIRMA (LISTA COMPLETA), NO POR CANTIDAD: DETECTA TAMBIÉN
'             RENOMBRADOS Y ALTA+BAJA ENTRE DOS TICKS.
' Parámetros: (NINGUNO)
' Retorna   : (NADA)
' ============================================
Public Sub RefrescarComboSiCambio()

  ' --- 0. INICIALIZACIÓN DE VARIABLES ---
  Dim sFirma As String

  ' --- 1. SIN PROYECTO ABIERTO: NADA QUE HACER ---
  If FMain.RutaProyecto = "" Then Return

  ' --- 2. FIRMA ACTUAL DEL DIRECTORIO ---
  sFirma = ListarFiguras().Join(Chr(10))

  ' --- 3. SIN CAMBIOS: SALIR SIN TOCAR LA UI ---
  If sFirma = $sFirmaMedia Then Return

  ' --- 4. HAY CAMBIOS: ACTUALIZAR FIRMA Y REPOBLAR PRESERVANDO SELECCIÓN ---
  $sFirmaMedia = sFirma
  PoblarComboImagenes(True)

End

' ============================================
' Función   : ListarFiguras
' Propósito : DEVOLVER LA LISTA ORDENADA DE fig-* DE /media (png + jpg, MINÚSCULA).
'             FUENTE ÚNICA DEL LISTADO: LA USAN EL POBLADO Y LA DETECCIÓN DE CAMBIOS.
' Parámetros: (NINGUNO)
' Retorna   : String[] — NOMBRES PELADOS ORDENADOS (VACÍO SI NO HAY /media)
' ============================================
Private Function ListarFiguras() As String[]

  ' --- 0. INICIALIZACIÓN DE VARIABLES ---
  Dim sRutaMedia As String
  Dim aArchivos As New String[]
  Dim aPng As String[]
  Dim aJpg As String[]

  ' --- 1. SIN PROYECTO O SIN /media: LISTA VACÍA ---
  If FMain.RutaProyecto = "" Then Return aArchivos
  sRutaMedia = FMain.RutaProyecto &/ "media"
  If Not Exist(sRutaMedia) Then Return aArchivos

  ' --- 2. LISTAR SOLO fig-* (EL PREFIJO ES EL DISCRIMINADOR CONTRA EL RESTO DE /media) ---
  aPng = Dir(sRutaMedia, "fig-*.png")
  aJpg = Dir(sRutaMedia, "fig-*.jpg")
  If aPng Then aArchivos.Insert(aPng)
  If aJpg Then aArchivos.Insert(aJpg)
  aArchivos.Sort()

  Return aArchivos

End

' ============================================
' Función   : PoblarComboImagenes
' Propósito : CARGAR EN cmbImagenes LOS fig-* DE /media DEL PROYECTO ABIERTO.
' Parámetros: bPreservarSeleccion As Boolean — SI ES True, MANTIENE LA FIGURA ACTUAL
'             Y SUPRIME EL _Click (REFRESCO EN CALIENTE: NO TOCA LA IMAGEN EN MEMORIA)
' Retorna   : (NADA)
' ============================================
Public Sub PoblarComboImagenes(Optional bPreservarSeleccion As Boolean = False)

  ' --- 0. INICIALIZACIÓN DE VARIABLES ---
  Dim aArchivos As String[]
  Dim sArchivo As String
  Dim sSeleccionAnterior As String
  Dim i As Integer

  ' --- 1. VALIDACIÓN DE ENTRADA: DEBE HABER PROYECTO ABIERTO ---
  If FMain.RutaProyecto = "" Then Return

  ' --- 2. GUARDAR LA SELECCIÓN ACTUAL SI SE REQUIERE PRESERVARLA ---
  If bPreservarSeleccion Then
    If FMain.cmbImagenes.Index >= 0 Then sSeleccionAnterior = FMain.cmbImagenes.Text
  Endif

  ' --- 3. SUPRIMIR EL _Click MIENTRAS REPOBLAMOS EN CALIENTE ---
  ' SIN ESTO, Clear() Y LA REASIGNACIÓN DE Index DISPARARÍAN CargarImagen Y EL
  ' GUARD DE DESCARTE APARECERÍA SOLO, PISANDO EL TRABAJO DEL MAQUETADOR
  FMain.bPoblandoComboImagen = bPreservarSeleccion

  ' --- 4. REPOBLAR DESDE DISCO ---
  FMain.cmbImagenes.Clear()
  aArchivos = ListarFiguras()
  For Each sArchivo In aArchivos
    FMain.cmbImagenes.Add(sArchivo)
  Next

  ' --- 5. RESTAURAR SELECCIÓN O CARGAR LA PRIMERA ---
  If bPreservarSeleccion And If sSeleccionAnterior <> "" Then
    ' BUSCAR POR TEXTO: EL ÍNDICE PUDO CORRERSE SI ENTRÓ UNA FIGURA ANTES ALFABÉTICAMENTE
    For i = 0 To FMain.cmbImagenes.Count - 1
      If FMain.cmbImagenes[i].Text = sSeleccionAnterior Then
        FMain.cmbImagenes.Index = i
        ' RESINCRONIZAR EL ÍNDICE DE REVERSIÓN CON LA NUEVA POSICIÓN
        FMain.iIndiceImagenCargada = i
        Break
      Endif
    Next
  Else
    ' POBLADO INICIAL: EL _Click NO ESTÁ SUPRIMIDO Y CARGARÁ LA PRIMERA FIGURA
    If FMain.cmbImagenes.Count > 0 Then FMain.cmbImagenes.Index = 0
  Endif

  ' --- 6. LEVANTAR LA SUPRESIÓN ---
  FMain.bPoblandoComboImagen = False

End
