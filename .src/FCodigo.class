' Gambas class file

' ==============================================================================
' Formulario: FCodigo
' ------------------------------------------------------------------------------
' Diálogo del modo codigo de los shortcodes (SC-42): pide el lenguaje del
' bloque y, si es un listado, su nombre (el identificador lst-…).
' Uso: asignar EsListado y llamar a ShowModal, que devuelve 1 si se aceptó;
' el lenguaje y el nombre quedan en m_Shortcodes.sLenguajeCodigo y
' m_Shortcodes.sNombreListado. NO EN VARIABLES Public DEL FORM: NO
' SOBREVIVEN AL CIERRE (RC-GM-13).
' EL NOMBRE DE LA VENTANA LO DECIDE EsListado.
' LA LISTA DE LENGUAJES ES LA DE codigo.lua, QUE VALIDA AL GENERAR, Y LA DE
' codigo-comun.xsl (RÓTULOS): UN CAMBIO VA EN LOS TRES.
' ==============================================================================

' --- ENTRADA: TRUE PIDE TAMBIÉN EL NOMBRE DEL LISTADO ---
Public EsListado As Boolean

' LENGUAJES ADMITIDOS, EN EL ORDEN DEL COMBO (GEMELA DE codigo.lua)
Private Const LENGUAJES As String = "python,r,sql,bash,javascript,json,yaml,markdown,latex,html,xml,xslt,css,lua,docbook,jats,texto"

' ==============================================================================
' Función   : Form_Open
' Propósito : Prepara el diálogo: llena el combo y muestra el nombre solo
'             para un listado
' Parámetros: ninguno
' Retorna   : nada
' ==============================================================================
Public Sub Form_Open()

  Dim sLenguaje As String

  ' --- 1. ESTADO: CADA APERTURA EMPIEZA SIN RESPUESTA ---
  m_Shortcodes.sLenguajeCodigo = ""
  m_Shortcodes.sNombreListado = ""

  ' --- 2. CONTROLES ---
  cmbLenguaje.Clear
  For Each sLenguaje In Split(LENGUAJES, ",")
    cmbLenguaje.Add(sLenguaje)
  Next
  cmbLenguaje.Index = 0
  txtNombre.Text = ""
  hbxNombre.Visible = EsListado
  If EsListado Then
    Me.Text = "Listado de código"
  Else
    Me.Text = "Bloque de código"
  Endif

  cmbLenguaje.SetFocus()

End

' ==============================================================================
' Función   : txtNombre_KeyPress
' Propósito : Admite en el nombre solo minúsculas sin acento, números y guion:
'             es un identificador XML (xml:id, @id) y una clase de Pandoc
' Parámetros: ninguno
' Retorna   : nada
' ==============================================================================
Public Sub txtNombre_KeyPress()

  ' LAS TECLAS DE EDICIÓN PASAN, Y ENTER Y TAB: ENTER ACTIVA EL BOTÓN POR
  ' DEFECTO, TAB CAMBIA DE CONTROL
  If Key.Code = Key.BackSpace Or Key.Code = Key.Delete Or Key.Code = Key.Left Or Key.Code = Key.Right Or Key.Code = Key.Home Or Key.Code = Key.End Or Key.Code = Key.Return Or Key.Code = Key.Enter Or Key.Code = Key.Tab Then
    Return
  Endif

  ' UN CARÁCTER FUERA DE LA LISTA NO SE ESCRIBE
  If Key.Text = "" Or If InStr("abcdefghijklmnopqrstuvwxyz0123456789-", Key.Text) = 0 Then
    Stop Event
  Endif

End

' ==============================================================================
' Función   : btnAceptar_Click
' Propósito : Valida y devuelve el lenguaje y, en un listado, el nombre
' Parámetros: ninguno
' Retorna   : nada
' ==============================================================================
Public Sub btnAceptar_Click()

  Dim sNombre As String

  ' --- 1. EL NOMBRE DEL LISTADO ES OBLIGATORIO ---
  sNombre = Trim(txtNombre.Text)
  If EsListado And sNombre = "" Then
    m_Sonido.sonar("Warning")
    Message.Warning("Escriba el nombre del listado." & gb.NewLine & gb.NewLine &
      "Es su identificador: lst-nombre.")
    txtNombre.SetFocus()
    Return
  Endif

  ' --- 2. RESPUESTA: LOS DATOS AL MÓDULO, LA DECISIÓN COMO VALOR (RC-GM-13) ---
  m_Shortcodes.sLenguajeCodigo = cmbLenguaje.Text
  m_Shortcodes.sNombreListado = sNombre
  Me.Close(1)

End

' ==============================================================================
' Función   : btnCancelar_Click
' Propósito : Cierra sin respuesta
' Parámetros: ninguno
' Retorna   : nada
' ==============================================================================
Public Sub btnCancelar_Click()

  Me.Close(0)

End
