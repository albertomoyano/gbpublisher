# Gambas Form File 3.0

{ Form Form
  Move(0,0,960,480)
  #Scaled = False
  Icon = Picture["iconos/gbadoc.png"]
  Resizable = False
  Arrangement = Arrange.Vertical
  Spacing = True
  Margin = True
  Padding = 4
  { hbxBarra HBox
    Move(9,9,882,36)
    { btnBase Button
      Move(0,0,36,36)
      #Translate = False
      NoTabFocus = True
      ToolTip = "Volver a la plantilla base de gbpublisher (no se guarda hasta apretar Guardar)"
      Picture = Picture["iconos/+nuevo.png"]
    }
    { btnGuardarPlantilla Button
      Move(36,0,36,36)
      #Translate = False
      NoTabFocus = True
      ToolTip = "Guardar este texto como plantilla de la editorial"
      Picture = Picture["iconos/guardar.png"]
    }
    { lblOrigen Label
      Move(81,0,450,36)
      #Translate = False
      Expand = True
    }
    { btnAplicar Button
      Move(558,0,144,36)
      #Translate = False
      Font = Font["Bold"]
      Background = &H9FFF7F
      NoTabFocus = True
      ToolTip = "Copiar este texto al campo del libro y cerrar"
      Text = "Aplicar"
      Picture = Picture["iconos/enviar.png"]
    }
    { btnCerrar Button
      Move(711,0,144,36)
      #Translate = False
      NoTabFocus = True
      ToolTip = "Cerrar la ventana"
      Text = "Cerrar"
      Picture = Picture["iconos/salir.png"]
    }
  }
  { txaPlantilla TextArea
    Move(9,54,882,360)
    #Translate = False
    Font = Font["Monospace"]
    Expand = True
    Wrap = True
    ScrollBar = Scroll.Vertical
  }
}
