' Gambas class file

' ============================================
' Clase     : CFinanciamientoArticulo
' Propósito : Financiamiento estructurado y declaraciones del artículo en
'             memoria, mientras se editan en la pestaña «Financiamiento y
'             declaraciones» (entrega D2). Se graban con el artículo, en su
'             transacción (SC-73). Clase chica por GV-24: viaja a m_Articulo.
' Tablas    : articulo_financiamiento, articulo_declaracion.
' ============================================

' FINANCIADORES EN ORDEN: CUATRO ARREGLOS PARALELOS, UNA ENTRADA POR
' FINANCIADOR. sTipoId: "" (SIN IDENTIFICADOR) | "ror" | "funder_id"
Public aFinanciadores As New String[]
Public aTiposId As New String[]
Public aIdsFinanciador As New String[]
Public aProyectos As New String[]

' DECLARACIONES: CLAVE «tipo|idioma», VALOR EL TEXTO. UNA CLAVE AUSENTE ES
' «SIN DECLARACIÓN»; ASIGNAR "" LA BORRA (GV-68)
Public cDeclaraciones As New Collection

' ============================================
' Función   : ClaveDeclaracion
' Propósito : La clave de una declaración en cDeclaraciones
' Parámetros: sTipo As String — código de tipo_declaracion
'             sIdioma As String — idioma
' Retorna   : String — «tipo|idioma»
' ============================================
Public Function ClaveDeclaracion(sTipo As String, sIdioma As String) As String

  Return sTipo & "|" & sIdioma

End

' ============================================
' Función   : AgregarFinanciador
' Propósito : Agrega un financiador al final, en los cuatro arreglos a la vez
' Parámetros: sFinanciador, sTipoId, sIdFinanciador, sProyecto As String
' Retorna   : nada
' ============================================
Public Sub AgregarFinanciador(sFinanciador As String, sTipoId As String, sIdFinanciador As String, sProyecto As String)

  aFinanciadores.Add(sFinanciador)
  aTiposId.Add(sTipoId)
  aIdsFinanciador.Add(sIdFinanciador)
  aProyectos.Add(sProyecto)

End

' ============================================
' Función   : QuitarFinanciador
' Propósito : Quita un financiador de los cuatro arreglos a la vez
' Parámetros: iIndice As Integer — posición
' Retorna   : nada
' ============================================
Public Sub QuitarFinanciador(iIndice As Integer)

  If iIndice < 0 Or iIndice >= aFinanciadores.Count Then Return
  aFinanciadores.Remove(iIndice)
  aTiposId.Remove(iIndice)
  aIdsFinanciador.Remove(iIndice)
  aProyectos.Remove(iIndice)

End

' ============================================
' Función   : MoverFinanciador
' Propósito : Intercambia un financiador con el vecino, en los cuatro arreglos
' Parámetros: iIndice As Integer — posición
'             iPaso As Integer — -1 sube, 1 baja
' Retorna   : Integer — la nueva posición; la misma si no se pudo mover
' ============================================
Public Function MoverFinanciador(iIndice As Integer, iPaso As Integer) As Integer

  Dim iDestino As Integer

  iDestino = iIndice + iPaso
  If iIndice < 0 Or iDestino < 0 Or iDestino >= aFinanciadores.Count Then Return iIndice
  ' INTERCAMBIO A MANO: LOS ARREGLOS NO TIENEN Exchange (GV-148)
  Intercambiar(aFinanciadores, iIndice, iDestino)
  Intercambiar(aTiposId, iIndice, iDestino)
  Intercambiar(aIdsFinanciador, iIndice, iDestino)
  Intercambiar(aProyectos, iIndice, iDestino)

  Return iDestino

End

' ============================================
' Función   : Intercambiar
' Propósito : Intercambia dos posiciones de un arreglo de texto
' Parámetros: aLista As String[] — el arreglo (es un objeto: se modifica)
'             iUna As Integer — una posición
'             iOtra As Integer — la otra
' Retorna   : nada
' ============================================
Private Sub Intercambiar(aLista As String[], iUna As Integer, iOtra As Integer)

  Dim sTexto As String

  sTexto = aLista[iUna]
  aLista[iUna] = aLista[iOtra]
  aLista[iOtra] = sTexto

End
