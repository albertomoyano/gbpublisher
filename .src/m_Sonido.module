' Gambas module file

' ================================================================
'  Módulo: m_Sonido
'  Propósito:
'     Proveer una interfaz simple para reproducir sonidos del
'     sistema según eventos de la aplicación.
'
'  Descripción:
'     Los sonidos se leen de la carpeta de recursos del sistema,
'     NO de la copia local (SC-11, QUÉ NO SE COPIA):
'
'        m_InicioCierre.RutaRecursos() &/ "sonido"
'
'     Desde el IDE eso es .hidden/sonido; instalado,
'     /usr/share/gbpublisher/sonido.
'
'     Permite reproducir diferentes efectos según una palabra clave
'     («Error», «Warning», «OpenApp», etc.).
'
'  Dependencias:
'     - Clase Sound (gb.sdl2.audio)
'     - m_InicioCierre.RutaRecursos
'
' ================================================================

' EL OBJETO VIVE A NIVEL DE MÓDULO PARA QUE NO SE LIBERE MIENTRAS SUENA
Private $hSonido As Sound

' ============================================
' Función   : sonar
' Propósito : Reproduce el sonido asociado a una palabra clave
' Parámetros: sCancion As String — «Error», «Question», «Info», «OpenApp» o «Warning»
' Retorna   : (nada)
' ============================================
Public Sub sonar(sCancion As String)

  ' --- 1. Declaración de variables ---
  Dim sArchivo As String
  Dim sRuta As String

  ' --- 2. Resolver el archivo de la palabra clave ---
  ' UNA PALABRA CLAVE DESCONOCIDA NO SUENA
  Select Case sCancion
    Case "Error"
      sArchivo = "Error.wav"
    Case "Question"
      sArchivo = "Question.wav"
    Case "Info"
      sArchivo = "Info.wav"
    Case "OpenApp"
      sArchivo = "OpenApp.wav"
    Case "Warning"
      sArchivo = "Warning.wav"
    Case Else
      Return
  End Select

  ' --- 3. Ruta en los recursos del sistema (SC-11) ---
  ' SE CALCULA ACÁ Y NO EN LA DECLARACIÓN DEL MÓDULO: ASÍ NO DEPENDE DEL
  ' ORDEN EN QUE GAMBAS CARGA m_Sonido Y m_InicioCierre
  sRuta = m_InicioCierre.RutaRecursos() &/ "sonido" &/ sArchivo

  ' --- 4. Cargar y reproducir ---
  ' SE VACÍA ANTES DE CARGAR: SI EL Load FALLA, NO DEBE VOLVER A SONAR EL
  ' SONIDO ANTERIOR EN LUGAR DEL PEDIDO
  $hSonido = Null
  Try $hSonido = Sound.Load(sRuta)

  If $hSonido Then
    Try $hSonido.Play()
  Endif

End
