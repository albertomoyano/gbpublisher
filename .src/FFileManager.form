# Gambas Form File 3.0

{ Form Form
  Move(0,0,960,600)
  #Scaled = False
  Expand = True
  Text = ("Archivos del proyecto")
  Icon = Picture["iconos/gbadoc.png"]
  Arrangement = Arrange.Vertical
  Centered = True
  Spacing = True
  Margin = True
  Padding = 4
  { menuFF Menu
    Text = ("menuFF")
    Visible = False
    { mnuAbrir Menu
      Text = ("Abrir")
      Picture = Picture["iconos/abrirBuscar.png"]
    }
    { mnuRenombrar Menu
      Text = ("Renombrar")
      Picture = Picture["iconos/reemplazar.png"]
    }
    { mnuBorrar Menu
      Text = ("Borrar")
      Picture = Picture["iconos/borrar.png"]
    }
    { mnuSeparador1 Menu
    }
    { mnuAgregarArchivo Menu
      Text = ("Agregar archivo")
      Picture = Picture["iconos/agregardarchivo.png"]
    }
    { mnuAgregarCarpeta Menu
      Text = ("Agregar carpeta")
      Picture = Picture["iconos/agregarcarpeta.png"]
    }
  }
  { HBoxGit HBox
    Move(9,18,864,36)
    { btnEmpujar Button
      Move(144,0,144,36)
      Text = ("Empujar")
      Picture = Picture["iconos/git2.png"]
    }
    { txtGit TextBox
      Move(405,0,144,36)
      Expand = True
      Placeholder = ("Mensaje del commit")
    }
    { txtUsuarioGit TextBox
      Move(558,0,180,36)
      Placeholder = ("Usuario de GitHub")
    }
  }
  { Panel1 Panel
    Move(9,90,918,441)
    Expand = True
    Arrangement = Arrange.Horizontal
    Spacing = True
    { Panel3 Panel
      Move(9,9,243,423)
      Arrangement = Arrange.Vertical
      Spacing = True
      Padding = 4
      { dvProyecto DirView
        Move(9,54,216,279)
        Expand = True
        HideRoot = True
      }
    }
    { sFileManager Splitter
      Move(261,9,603,423)
      Expand = True
      Arrangement = Arrange.Vertical
      Border = False
      { fvProyecto FileView
        Move(45,36,216,108)
        Expand = True
        PopupMenu = "menuFF"
        ShowDirectory = True
      }
      { gvDetalles GridView
        Move(9,279,477,135)
        Expand = True
        ShowCursor = True
        ScrollBar = Scroll.Vertical
      }
    }
  }
  { HBoxCerrar HBox
    Move(9,558,864,36)
    { lblRaiz TextLabel
      Move(36,0,144,36)
      Background = Color.Background
      Foreground = &H0000FF
      Expand = True
      Border = Border.Plain
      Alignment = Align.Normal
    }
    { btnCerrar Button
      Move(666,0,144,36)
      Text = ("Cerrar")
      Picture = Picture["iconos/salir.png"]
      Cancel = True
    }
  }
}
