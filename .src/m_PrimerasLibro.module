' Gambas module file

' ==========================================================
' MÓDULO    : m_PrimerasLibro
' PROPÓSITO : Los datos y los textos de las primeras del libro —portadilla,
'             portada y créditos— que comparten el PDF y el EPUB (SC-25).
'             Cada salida los compone a su modo: este módulo no escribe
'             LaTeX ni XHTML de página, solo entrega valores y texto
'             convertido.
'
' LOS TEXTOS
' ----------------------------------------------------------
'   texto_catalogacion y texto_legal (y sus variantes digitales) se escriben
'   en Markdown de línea, con marcadores entre llaves. Se resuelven en dos
'   pasos, en este orden:
'     1. ResolverTexto reemplaza los marcadores por los valores de la base.
'     2. ConvertirMarkdown pasa el resultado por Pandoc, a latex o a html.
'   El orden importa: los valores entran al Markdown ESCAPADOS, y es Pandoc
'   quien los escapa después para LaTeX o XHTML. Así un título con & o %
'   no rompe nada, y un ISBN que empieza una línea no se lee como lista.
'
' LOS ERRORES
' ----------------------------------------------------------
'   Las funciones que pueden fallar devuelven su resultado y dejan el motivo
'   en UltimoError(). Un primitivo no se puede devolver por parámetro
'   (GV-24, alternativa 4). El llamador pregunta UltimoError() <> "" y decide.
' ==========================================================

' CARPETA DEL PROYECTO DONDE VIVEN LOS LOGOS, IGUAL QUE LA TAPA
Public Const CARPETA_MEDIA As String = "media"

' CARPETA DE LAS PLANTILLAS PROPIAS DE LA EDITORIAL, EN ~/.gbpublisher
Private Const CARPETA_PLANTILLAS As String = "plantillas"

' VALOR QUE OCUPA EL LUGAR DE UN DATO VACÍO, COMO UNA REFERENCIA SIN RESOLVER
Private Const VALOR_VACIO As String = "??"

' MOTIVO DEL ÚLTIMO FALLO; VACÍO SI LA ÚLTIMA LLAMADA FUNCIONÓ
Private $sUltimoError As String = ""

' ============================================
' Función   : UltimoError
' Propósito : Motivo del fallo de la última llamada a ResolverTexto,
'             ConvertirMarkdown, LeerValores o TextoParaSalida.
' Parámetros: (ninguno)
' Retorna   : String — el motivo, o "" si la última llamada funcionó
' ============================================
Public Function UltimoError() As String

  Return $sUltimoError

End

' ============================================
' Función   : EsPrimera
' Propósito : Dice si un tipo de pieza es una de las primeras del libro.
' Parámetros: sTipo As String — capitulos.tipo_capitulo
' Retorna   : Boolean
' ============================================
Public Function EsPrimera(sTipo As String) As Boolean

  Select Case LCase(Trim(sTipo))
    Case "portadilla", "portada", "creditos"
      Return True
    Case Else
      Return False
  End Select

End

' ============================================
' Función   : OrdenPrimera
' Propósito : Lugar de cada primera en la secuencia estándar del libro.
'             Sirve para verificar que las declaradas estén en ese orden.
' Parámetros: sTipo As String — capitulos.tipo_capitulo
' Retorna   : Integer — 1 portadilla, 2 portada, 3 créditos; 0 si no es una
'             primera
' ============================================
Public Function OrdenPrimera(sTipo As String) As Integer

  Select Case LCase(Trim(sTipo))
    Case "portadilla"
      Return 1
    Case "portada"
      Return 2
    Case "creditos"
      Return 3
    Case Else
      Return 0
  End Select

End

' ============================================
' Función   : PlantillaTexto
' Propósito : La plantilla de un campo de créditos: la propia de la editorial
'             si existe, la base de gbpublisher si no.
' Parámetros: sCampo As String — texto_catalogacion, texto_legal,
'             texto_catalogacion_digital o texto_legal_digital
' Retorna   : String — el texto de la plantilla
' Nota      : LAS PLANTILLAS PROPIAS SON CONTENIDO DEL USUARIO, COMO LOS
'             SNIPPETS (SC-21): UN ARCHIVO POR CAMPO EN ~/.gbpublisher/plantillas/,
'             FUERA DE LA COPIA DEL SISTEMA (SC-11). CADA SELLO GUARDA LA SUYA.
'             SI EL ARCHIVO NO SE PUEDE LEER, SE DEVUELVE LA BASE: UNA
'             PLANTILLA ES UNA AYUDA, NO UN DATO.
' ============================================
Public Function PlantillaTexto(sCampo As String) As String

  Dim sTexto As String

  If EsPlantillaPropia(sCampo) Then
    Try sTexto = File.Load(RutaPlantilla(sCampo))
    If Not Error Then
      ' UN EDITOR EXTERNO AGREGA UN SALTO FINAL AL GUARDAR (SC-21)
      If Right(sTexto, 1) = Chr(10) Then sTexto = Left(sTexto, Len(sTexto) - 1)
      Return sTexto
    Endif
  Endif

  Return PlantillaBase(sCampo)

End

' ============================================
' Función   : EsPlantillaPropia
' Propósito : Dice si la editorial guardó su propia plantilla para un campo.
' Parámetros: sCampo As String — el campo de créditos
' Retorna   : Boolean
' ============================================
Public Function EsPlantillaPropia(sCampo As String) As Boolean

  ' Exist DA True TAMBIÉN PARA UNA CARPETA; EL NOMBRE LO ARMA EL CÓDIGO (GV-01)
  Return Exist(RutaPlantilla(sCampo))

End

' ============================================
' Función   : GuardarPlantilla
' Propósito : Guarda la plantilla propia de la editorial para un campo.
' Parámetros: sCampo As String — el campo de créditos
'             sTexto As String — el texto de la plantilla
' Retorna   : Boolean — True si se guardó; False con el motivo en
'             UltimoError()
' Nota      : LA CARPETA SE CREA ACÁ, EN EL PRIMER GUARDADO: NO HACE FALTA QUE
'             EXISTA ANTES, PORQUE SIN ARCHIVO SE USA LA BASE.
'             File.Save ESCRIBE EN UTF-8 SIN RECODIFICAR (SC-02).
' ============================================
Public Function GuardarPlantilla(sCampo As String, sTexto As String) As Boolean

  Dim sCarpeta As String

  ' --- 1. INICIALIZACIÓN ---
  $sUltimoError = ""
  sCarpeta = User.Home &/ ".gbpublisher" &/ CARPETA_PLANTILLAS

  ' --- 2. CARPETA ---
  ' IsDir Y NO Exist: Exist TAMBIÉN DA True PARA UN ARCHIVO (GV-01)
  If Not IsDir(sCarpeta) Then
    Try Mkdir sCarpeta
    If Error Then
      $sUltimoError = "No se pudo crear la carpeta de plantillas: " & Error.Text
      Return False
    Endif
  Endif

  ' --- 3. ESCRITURA ---
  Try File.Save(RutaPlantilla(sCampo), sTexto)
  If Error Then
    $sUltimoError = "No se pudo guardar la plantilla: " & Error.Text
    Return False
  Endif

  Return True

End

' ============================================
' Función   : RutaPlantilla
' Propósito : Ruta del archivo de la plantilla propia de un campo.
' Parámetros: sCampo As String — el campo de créditos
' Retorna   : String — ~/.gbpublisher/plantillas/<campo>.md
' ============================================
Private Function RutaPlantilla(sCampo As String) As String

  Return User.Home &/ ".gbpublisher" &/ CARPETA_PLANTILLAS &/ sCampo & ".md"

End

' ============================================
' Función   : PlantillaBase
' Propósito : La plantilla que trae gbpublisher, para la editorial que todavía
'             no guardó la suya.
' Parámetros: sCampo As String — el campo de créditos
' Retorna   : String — la plantilla, o "" si el campo no tiene
' Nota      : LA ESTRUCTURA SIGUE LA FICHA DE CATALOGACIÓN ARGENTINA. LO QUE
'             ESTÁ EN MAYÚSCULAS ENTRE CORCHETES ES PARA REEMPLAZAR A MANO; LO
'             QUE ESTÁ ENTRE LLAVES LO COMPLETA LA BASE. LAS DIGITALES NO
'             LLEVAN {paginas} NI {formato}, QUE AHÍ SON UN ERROR, NI IMPRENTA.
'             NADA DE UN SELLO EN PARTICULAR: LOS DATOS DE CADA EDITORIAL VAN
'             EN SU PLANTILLA PROPIA.
' ============================================
Public Function PlantillaBase(sCampo As String) As String

  Dim a As New String[]

  Select Case sCampo

    Case "texto_catalogacion"
      a.Add("{autoria}")
      a.Add("{titulo}. {subtitulo}. {edicion} ed.")
      a.Add("{ciudad}: {anio}.")
      a.Add("{paginas} p.; {formato}. ISBN {isbn_impreso}")
      a.Add("1. [MATERIA]. I. Título.")
      a.Add("CDD [NÚMERO]")
      a.Add("Fecha de catalogación: [DD/MM/AAAA]")
      a.Add("© {anio}, {autoria}")
      a.Add("© {anio}, {editorial}")
      a.Add("Imagen de tapa: *[OBRA]* de [ARTISTA]")
      a.Add("Hecho el depósito que marca la ley 11.723")

    Case "texto_catalogacion_digital"
      a.Add("{autoria}")
      a.Add("{titulo}. {subtitulo}. {edicion} ed.")
      a.Add("{ciudad}: {anio}.")
      a.Add("Libro digital. ISBN {isbn_digital}")
      a.Add("1. [MATERIA]. I. Título.")
      a.Add("CDD [NÚMERO]")
      a.Add("Fecha de catalogación: [DD/MM/AAAA]")
      a.Add("© {anio}, {autoria}")
      a.Add("© {anio}, {editorial}")

    Case "texto_legal"
      ' LA LÍNEA VACÍA SEPARA PÁRRAFOS: SIN ELLA, PANDOC UNE LA URL CON EL
      ' TEXTO EN UN SOLO PÁRRAFO CON SALTO DE LÍNEA
      a.Add("{url_libro}")
      a.Add("")
      a.Add("[TEXTO DE RESERVA DE DERECHOS O LICENCIA]")
      a.Add("")
      a.Add("Este libro se terminó de imprimir en [MES] de [AAAA] en [IMPRENTA], " &
        "[DIRECCIÓN]. Tirada: [NÚMERO] ejemplares.")

    Case "texto_legal_digital"
      a.Add("{url_libro}")
      a.Add("")
      a.Add("[TEXTO DE RESERVA DE DERECHOS O LICENCIA]")

    Case Else
      Return ""

  End Select

  Return a.Join(Chr(10))

End

' ============================================
' Función   : LeerValores
' Propósito : Lee de la base los valores que pueden ocupar un marcador.
' Parámetros: iIdLibro As Integer — libros_md.id_libro
' Retorna   : Collection — clave: nombre del marcador; valor: texto CRUDO,
'             salvo edicion, que ya viene como Markdown. Null si falló, con
'             el motivo en UltimoError()
' Nota      : UN VALOR VACÍO NO DEJA CLAVE: ASIGNAR "" A UNA Collection NO LA
'             CREA, Y SI EXISTÍA LA BORRA, PORQUE "" ES NULL (VERIFICADO). POR
'             ESO QUÉ MARCADORES EXISTEN LO DICE EsMarcadorConocido, NO
'             Exist, Y EL VALOR SE LEE CON ValorDe.
'             formato SE ESCRIBE COMO EN LA FICHA: ancho x alto, SIN CEROS DE
'             MÁS Y CON PUNTO. CStr NO DEPENDE DEL LOCALE (VERIFICADO BAJO
'             es_AR: CStr DA 15.5, Str$ DA 15,5).
' ============================================
Public Function LeerValores(iIdLibro As Integer) As Collection

  Dim hLibro As Result
  Dim cValores As New Collection
  Dim sEdicion As String

  ' --- 1. INICIALIZACIÓN ---
  $sUltimoError = ""

  ' --- 2. CONSULTA ---
  ' LOS DOS LEFT JOIN DEJAN NULL SI EL LIBRO NO TIENE FORMATO O COLECCIÓN:
  ' ESOS MARCADORES QUEDAN VACÍOS Y SALEN COMO ??.
  Try hLibro = m_ConexionBD.mConn.Exec(
    "SELECT l.titulo_libro, l.subtitulo, l.tipo_libro, l.numero_edicion, " &
    "       l.edicion, l.ciudad_publicacion, l.ano_publicacion, l.editorial, " &
    "       l.isbn_impreso, l.isbn_electronico, l.url_libro, l.numero_paginas, " &
    "       l.leyenda_autoria, " &
    "       f.ancho, f.alto, " &
    "       c.nombre AS coleccion, c.director_coleccion " &
    "FROM libros_md l " &
    "LEFT JOIN formatos_pdf f ON f.id_formato_pdf = l.id_formato_pdf " &
    "LEFT JOIN colecciones c ON c.id_coleccion = l.id_coleccion " &
    "WHERE l.id_libro = &1 LIMIT 1", iIdLibro)

  If Error Then
    $sUltimoError = "No se pudieron leer los datos del libro: " & Error.Text
    Return Null
  Endif

  If Not hLibro.Available Then
    $sUltimoError = "No existe el libro " & CStr(iIdLibro) & " en libros_md."
    Return Null
  Endif

  ' --- 3. VALORES DIRECTOS ---
  LeerAutoria(iIdLibro, NuloAVacio(hLibro["tipo_libro"]), cValores)
  If $sUltimoError <> "" Then Return Null

  cValores["titulo"] = NuloAVacio(hLibro["titulo_libro"])
  cValores["subtitulo"] = NuloAVacio(hLibro["subtitulo"])
  cValores["ciudad"] = NuloAVacio(hLibro["ciudad_publicacion"])
  cValores["anio"] = NuloAVacio(hLibro["ano_publicacion"])
  cValores["editorial"] = NuloAVacio(hLibro["editorial"])
  cValores["coleccion"] = NuloAVacio(hLibro["coleccion"])
  cValores["director_coleccion"] = NuloAVacio(hLibro["director_coleccion"])
  cValores["isbn_impreso"] = NuloAVacio(hLibro["isbn_impreso"])
  cValores["isbn_digital"] = NuloAVacio(hLibro["isbn_electronico"])
  cValores["url_libro"] = NuloAVacio(hLibro["url_libro"])
  cValores["paginas"] = NuloAVacio(hLibro["numero_paginas"])
  ' NO ES MARCADOR: ES LA LÍNEA DE LA PORTADA DEBAJO DE LOS NOMBRES. LA
  ' ESCRIBE EL EDITOR PORQUE CONCUERDA EN GÉNERO Y NÚMERO (SC-25)
  cValores["leyenda_autoria"] = NuloAVacio(hLibro["leyenda_autoria"])

  ' --- 4. EDICIÓN, YA COMO MARKDOWN ---
  ' EL NÚMERO VA CON EL ORDINAL VOLADO: 1.^a^ DA 1.ª EN LAS DOS SALIDAS. SI NO
  ' HAY NÚMERO SE USA EL TEXTO LIBRE DE edicion, ESCAPADO COMO CUALQUIER DATO.
  sEdicion = ""
  If Not IsNull(hLibro["numero_edicion"]) Then
    sEdicion = CStr(hLibro["numero_edicion"]) & ".^a^"
  Else If NuloAVacio(hLibro["edicion"]) <> "" Then
    sEdicion = EscaparMarkdown(NuloAVacio(hLibro["edicion"]))
  Endif
  cValores["edicion"] = sEdicion

  ' --- 5. FORMATO DE PÁGINA ---
  ' RC-GM-17: EL SEGUNDO NULL SE PREGUNTA EN UN If ANIDADO
  cValores["formato"] = ""
  If Not IsNull(hLibro["ancho"]) Then
    If Not IsNull(hLibro["alto"]) Then
      cValores["formato"] = CStr(hLibro["ancho"]) & "x" & CStr(hLibro["alto"]) & "cm"
    Endif
  Endif

  Return cValores

End

' ============================================
' Función   : ResolverTexto
' Propósito : Reemplaza los marcadores {nombre} de un texto por sus valores.
' Parámetros: sTexto As String — el texto de la base, en Markdown
'             cValores As Collection — lo que devolvió LeerValores
'             bDigital As Boolean — True si el texto es de una salida digital
' Retorna   : String — el Markdown con los valores; "" si falló, con el
'             motivo en UltimoError()
' Nota      : UN MARCADOR ES UNA LLAVE, UNA O MÁS LETRAS a-z O _, Y OTRA
'             LLAVE. CUALQUIER OTRA COSA ENTRE LLAVES QUEDA COMO ESTÁ.
'             UN MARCADOR DESCONOCIDO DETIENE LA GENERACIÓN: SI SE DEJARA
'             PASAR, UNA ERRATA EN {isbn_impreso} SALDRÍA IMPRESA (GV-23).
'             {paginas} Y {formato} DESCRIBEN EL IMPRESO: EN UN TEXTO DIGITAL
'             SON UN ERROR (SC-25).
'             EL RECORRIDO USA String.* PORQUE EL TEXTO TRAE ACENTOS
'             (RC-GM-12).
' ============================================
Public Function ResolverTexto(sTexto As String, cValores As Collection, bDigital As Boolean) As String

  Dim sRes As String = ""
  Dim sNombre As String
  Dim sValor As String
  Dim iPos As Integer = 1
  Dim iIni As Integer
  Dim iFin As Integer

  ' --- 1. INICIALIZACIÓN ---
  $sUltimoError = ""
  If sTexto = "" Then Return ""

  ' --- 2. RECORRIDO DE LAS LLAVES ---
  Do
    iIni = String.InStr(sTexto, "{", iPos)
    If iIni = 0 Then Break

    iFin = String.InStr(sTexto, "}", iIni + 1)
    If iFin = 0 Then Break

    ' LO QUE HAY ANTES DE LA LLAVE PASA TAL CUAL
    sRes &= String.Mid(sTexto, iPos, iIni - iPos)
    sNombre = String.Mid(sTexto, iIni + 1, iFin - iIni - 1)

    ' NO ES UN MARCADOR: LA LLAVE QUEDA COMO TEXTO Y SE SIGUE DESPUÉS DE ELLA,
    ' PORQUE PUEDE HABER UN MARCADOR ADENTRO: {a {titulo}
    If Not EsNombreMarcador(sNombre) Then
      sRes &= "{"
      iPos = iIni + 1
      Continue
    Endif

    ' --- 3. VALIDACIÓN DEL MARCADOR ---
    If Not EsMarcadorConocido(sNombre) Then
      $sUltimoError = "Marcador desconocido: {" & sNombre & "}"
      Return ""
    Endif

    If bDigital Then
      If sNombre = "paginas" Or If sNombre = "formato" Then
        $sUltimoError = "El marcador {" & sNombre & "} describe el impreso y no " &
          "puede ir en un texto digital."
        Return ""
      Endif
    Endif

    ' --- 4. VALOR ---
    sValor = ValorDe(cValores, sNombre)

    If sValor = "" Then
      sRes &= VALOR_VACIO
    Else If sNombre = "url_libro" Then
      ' AUTOENLACE: PANDOC DA \url{} EN LATEX, QUE CORTA LA LÍNEA EN LAS
      ' BARRAS, Y <a href> EN XHTML. UNA URL DESNUDA SALE COMO TEXTO Y NO SE
      ' CORTA (VERIFICADO)
      sRes &= "<" & sValor & ">"
    Else If sNombre = "edicion" Then
      ' YA VIENE COMO MARKDOWN DE LeerValores
      sRes &= sValor
    Else
      sRes &= EscaparMarkdown(sValor)
    Endif

    iPos = iFin + 1
  Loop

  ' --- 5. RESTO DEL TEXTO ---
  sRes &= String.Mid(sTexto, iPos)

  Return sRes

End

' ============================================
' Función   : ConvertirMarkdown
' Propósito : Convierte Markdown de línea al formato de una salida con Pandoc.
' Parámetros: sMarkdown As String — el texto ya resuelto
'             sFormato As String — "latex" o "html"
' Retorna   : String — el texto convertido, sin salto final; "" si falló,
'             con el motivo en UltimoError()
' Nota      : hard_line_breaks: CADA SALTO DE LÍNEA DEL TEXTO ES UN SALTO EN LA
'             SALIDA, COMO EN LA FICHA DE CATALOGACIÓN. --wrap=none: UN PÁRRAFO
'             POR LÍNEA, PARA QUE EL DERIVADO VERSIONADO TENGA DIFERENCIAS
'             LIMPIAS.
'             Exec SOBRE UN ARRAY, SIN SHELL (SC-05). LA ENTRADA VA POR
'             ARCHIVO TEMPORAL Y LA SALIDA POR stdout (GV-20). stderr NO SE
'             CAPTURA: SI PANDOC FALLA, LO ÚNICO QUE SE VE ES LA SALIDA VACÍA,
'             Y POR ESO SE LA TRATA COMO ERROR.
' ============================================
Public Function ConvertirMarkdown(sMarkdown As String, sFormato As String) As String

  Dim sTemp As String
  Dim sSalida As String = ""
  Dim aComando As New String[]

  ' --- 1. INICIALIZACIÓN ---
  $sUltimoError = ""
  If Trim(sMarkdown) = "" Then Return ""

  ' --- 2. ARCHIVO DE ENTRADA ---
  sTemp = Temp$() & ".md"
  Try File.Save(sTemp, sMarkdown)
  If Error Then
    $sUltimoError = "No se pudo escribir el temporal para Pandoc: " & Error.Text
    Return ""
  Endif

  ' --- 3. CONVERSIÓN ---
  aComando.Add("pandoc")
  aComando.Add("-f")
  aComando.Add("markdown+hard_line_breaks")
  aComando.Add("-t")
  aComando.Add(sFormato)
  aComando.Add("--wrap=none")
  aComando.Add(sTemp)

  Try Exec aComando To sSalida
  If Error Then
    $sUltimoError = "No se pudo ejecutar Pandoc: " & Error.Text
    Try Kill sTemp
    Return ""
  Endif

  ' EL TEMPORAL SE BORRA ANTES DE EVALUAR LA SALIDA, EN LOS DOS CAMINOS
  Try Kill sTemp

  ' --- 4. RESULTADO ---
  If Trim(sSalida) = "" Then
    $sUltimoError = "Pandoc no devolvió nada al convertir a " & sFormato & "."
    Return ""
  Endif

  ' UN SOLO SALTO FINAL, EL QUE AGREGA PANDOC
  If Right(sSalida, 1) = Chr(10) Then sSalida = Left(sSalida, Len(sSalida) - 1)

  Return sSalida

End

' ============================================
' Función   : TextoParaSalida
' Propósito : Los dos pasos juntos: resolver los marcadores y convertir.
' Parámetros: sTexto As String — el texto de la base
'             cValores As Collection — lo que devolvió LeerValores
'             sFormato As String — "latex" o "html"
'             bDigital As Boolean — True si el texto es de una salida digital
' Retorna   : String — el texto listo para la salida; "" si falló o si el
'             texto era vacío. Se distingue por UltimoError()
' ============================================
Public Function TextoParaSalida(sTexto As String, cValores As Collection, sFormato As String, bDigital As Boolean) As String

  Dim sMarkdown As String

  ' --- 1. MARCADORES ---
  sMarkdown = ResolverTexto(sTexto, cValores, bDigital)
  If $sUltimoError <> "" Then Return ""

  ' --- 2. CONVERSIÓN ---
  Return ConvertirMarkdown(sMarkdown, sFormato)

End

' ============================================
' Función   : EsFormatoLogo
' Propósito : Dice si un archivo tiene un formato admitido para los logos.
' Parámetros: sNombre As String — nombre o ruta del archivo
' Retorna   : Boolean — True para PNG y JPG
' Nota      : SOLO PNG Y JPG: SIRVEN IGUAL AL PDF Y AL EPUB, SIN CONVERSIÓN.
'             UN LOGO EN PDF OBLIGABA A GENERAR UN SVG PARA EL EPUB, QUE NO
'             ADMITE PDF COMO IMAGEN (SC-25).
' ============================================
Public Function EsFormatoLogo(sNombre As String) As Boolean

  Select Case LCase(File.Ext(sNombre))
    Case "png", "jpg", "jpeg"
      Return True
    Case Else
      Return False
  End Select

End

' ============================================
' Función   : EscaparMarkdown
' Propósito : Escapa un valor de la base para que Markdown lo lea literal.
' Parámetros: sValor As String — texto crudo
' Retorna   : String — el texto con una barra delante de cada signo ASCII
' Nota      : SE ESCAPA TODO SIGNO DE PUNTUACIÓN ASCII, SIN ELEGIR: PANDOC
'             ADMITE LA BARRA DELANTE DE CUALQUIERA (all_symbols_escapable) Y
'             LOS DEVUELVE LITERALES EN LATEX Y EN XHTML (VERIFICADO CON
'             & % # _ * [ ] < > \ ^ Y EL RESTO). ASÍ UN TÍTULO CON UN
'             ASTERISCO NO SE VUELVE CURSIVA NI UN «1.» SE VUELVE LISTA.
'             RANGOS ASCII: 33-47, 58-64, 91-96 Y 123-126.
' ============================================
Private Function EscaparMarkdown(sValor As String) As String

  Dim sRes As String = ""
  Dim sCar As String
  Dim iCodigo As Integer
  Dim iPos As Integer

  For iPos = 1 To String.Len(sValor)
    sCar = String.Mid(sValor, iPos, 1)
    iCodigo = String.Code(sCar)

    If (iCodigo >= 33 And iCodigo <= 47) Or (iCodigo >= 58 And iCodigo <= 64) Or
      (iCodigo >= 91 And iCodigo <= 96) Or (iCodigo >= 123 And iCodigo <= 126) Then
      sRes &= "\\" & sCar
    Else
      sRes &= sCar
    Endif
  Next

  Return sRes

End

' ============================================
' Función   : EsMarcadorConocido
' Propósito : La lista cerrada de marcadores (SC-25).
' Parámetros: sNombre As String — el nombre entre llaves
' Retorna   : Boolean
' Nota      : LA LISTA ESTÁ ACÁ Y NO EN LAS CLAVES DE LA Collection: UN VALOR
'             VACÍO NO DEJA CLAVE (VER LeerValores).
' ============================================
Private Function EsMarcadorConocido(sNombre As String) As Boolean

  Select Case sNombre
    Case "autoria", "titulo", "subtitulo", "edicion", "ciudad", "anio",
      "editorial", "coleccion", "director_coleccion", "isbn_impreso",
      "isbn_digital", "url_libro", "paginas", "formato"
      Return True
    Case Else
      Return False
  End Select

End

' ============================================
' Función   : ValorDe
' Propósito : El valor de un marcador, vacío si la Collection no tiene clave.
' Parámetros: cValores As Collection — lo que devolvió LeerValores
'             sNombre As String — el marcador
' Retorna   : String
' ============================================
Public Function ValorDe(cValores As Collection, sNombre As String) As String

  If cValores.Exist(sNombre) Then Return cValores[sNombre]
  Return ""

End

' ============================================
' Función   : EsNombreMarcador
' Propósito : Dice si lo que hay entre dos llaves tiene forma de marcador.
' Parámetros: sNombre As String — el contenido entre llaves
' Retorna   : Boolean — True si es no vacío y solo tiene a-z o _
' ============================================
Private Function EsNombreMarcador(sNombre As String) As Boolean

  Dim iPos As Integer
  Dim iCodigo As Integer

  If sNombre = "" Then Return False

  For iPos = 1 To String.Len(sNombre)
    iCodigo = String.Code(String.Mid(sNombre, iPos, 1))
    ' 95 ES EL GUION BAJO; 97-122, a-z
    If iCodigo <> 95 Then
      If iCodigo < 97 Or iCodigo > 122 Then Return False
    Endif
  Next

  Return True

End

' ============================================
' Función   : LeerAutoria
' Propósito : Lee la autoría del libro y deja en cValores tres entradas:
'               autoria          «Adrián Cammarota y Astrid Dahhur (coords.)»,
'                                para el marcador {autoria} de la ficha
'               nombres_autoria  String[] con los nombres, para la portada
'               rol_autoria      «coords.», o vacío (lo usa la ficha; la
'                                portada usa leyenda_autoria)
' Parámetros: iIdLibro As Integer — libros_md.id_libro
'             sTipoLibro As String — libros_md.tipo_libro
'             cValores As Collection — donde se dejan las entradas
' Retorna   : (Sub, sin retorno). Si la consulta falla, deja el motivo en
'             UltimoError()
' Nota      : EL ROL VA ABREVIADO Y UNA SOLA VEZ PARA TODOS: LA ABREVIATURA NO
'             TIENE GÉNERO, ASÍ QUE NO HAY QUE CONCORDAR (coords., NO
'             «coordinadores» NI «coordinadoras»). EL NÚMERO SÍ: EL PLURAL DE
'             UNA ABREVIATURA AGREGA s ANTES DEL PUNTO (coord. → coords.).
'             SI LOS ROLES SON DISTINTOS ENTRE SÍ, CADA NOMBRE LLEVA EL SUYO Y
'             NO HAY ROL COMÚN.
'             LOS ROLES QUE CUENTAN LOS DECIDE EL TIPO DE LIBRO, CON LA MISMA
'             REGLA QUE LOS METADATOS DEL PDF (RolesDeAutoriaSegunTipo).
'             nombres_autoria ES UN OBJETO: NO SE PIERDE EN LA Collection AUNQUE
'             ESTÉ VACÍO, A DIFERENCIA DE UNA CADENA VACÍA.
' ============================================
Private Sub LeerAutoria(iIdLibro As Integer, sTipoLibro As String, cValores As Collection)

  Dim hRes As Result
  Dim aNombres As New String[]
  Dim aAbrev As New String[]
  Dim sRol As String = ""
  Dim bUniforme As Boolean = True
  Dim sAutoria As String = ""
  Dim i As Integer

  ' --- 1. CONSULTA ---
  ' EL IN SE INTERPOLA PORQUE LO ARMA EL CÓDIGO DESDE UN enum CERRADO
  Try hRes = m_ConexionBD.mConn.Exec(
    "SELECT a.nombre, a.apellidos, la.rol_libro " &
    "FROM libro_autor la " &
    "JOIN autores a ON a.id_autor = la.id_autor " &
    "WHERE la.id_libro = &1 " &
    "AND la.rol_libro IN (" & m_GenerarPDFLibro.RolesDeAutoriaSegunTipo(sTipoLibro) & ") " &
    "ORDER BY la.orden_autoria", iIdLibro)

  If Error Then
    $sUltimoError = "No se pudo leer la autoría del libro: " & Error.Text
    Return
  Endif

  ' --- 2. NOMBRES Y ABREVIATURAS ---
  If hRes.Available Then
    For Each hRes
      aNombres.Add(Trim(hRes["nombre"]) & " " & Trim(hRes["apellidos"]))
      aAbrev.Add(m_GenerarPDFLibro.AbreviaturaDeRol(hRes["rol_libro"]))
    Next
  Endif

  ' --- 3. ¿UN SOLO ROL PARA TODOS? ---
  For i = 1 To aAbrev.Max
    If aAbrev[i] <> aAbrev[0] Then bUniforme = False
  Next

  If aNombres.Count > 0 Then
    If bUniforme Then
      sRol = aAbrev[0]
      ' PLURAL DE LA ABREVIATURA: coord. → coords.
      If sRol <> "" And aNombres.Count > 1 Then sRol = Left(sRol, Len(sRol) - 1) & "s."
    Else
      ' ROLES MEZCLADOS: CADA NOMBRE CON EL SUYO
      For i = 0 To aNombres.Max
        If aAbrev[i] <> "" Then aNombres[i] &= " (" & aAbrev[i] & ")"
      Next
    Endif
  Endif

  ' --- 4. LA FORMA DE LA FICHA ---
  For i = 0 To aNombres.Max
    sAutoria &= SeparadorAutoria(i, aNombres.Count) & aNombres[i]
  Next
  If sRol <> "" Then sAutoria &= " (" & sRol & ")"

  ' --- 5. ENTRADAS ---
  cValores["autoria"] = sAutoria
  cValores["nombres_autoria"] = aNombres
  cValores["rol_autoria"] = sRol

End

' ============================================
' Función   : SeparadorAutoria
' Propósito : Lo que va antes del nombre i en una lista de n: nada, coma o «y».
' Parámetros: i As Integer — posición del nombre, desde 0
'             n As Integer — cantidad de nombres
' Retorna   : String — "", ", " o " y ": «A», «A y B», «A, B y C»
' ============================================
Public Function SeparadorAutoria(i As Integer, n As Integer) As String

  If i = 0 Then Return ""
  If i = n - 1 Then Return " y "
  Return ", "

End

' ============================================
' Función   : NuloAVacio
' Propósito : Convierte un NULL de la base en cadena vacía.
' Parámetros: vValor As Variant — valor leído de un Result
' Retorna   : String — el valor sin espacios en los bordes, o ""
' ============================================
Private Function NuloAVacio(vValor As Variant) As String

  If IsNull(vValor) Then Return ""
  Return Trim(CStr(vValor))

End
