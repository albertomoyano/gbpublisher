# Gambas Form File 3.0

{ Form Form
  Move(0,0,960,600)
  #Scaled = False
  Resizable = False
  Arrangement = Arrange.Vertical
  Spacing = True
  Margin = True
  Padding = 4
  { HBoxBuscarEnProyecto1 HBox
    Move(18,18,783,36)
    { lblEncabezado Label
      Move(441,0,225,36)
      Expand = True
    }
  }
  { HBoxBuscarEnProyecto3 HBox
    Move(18,54,783,36)
    { lblContador Label
      Move(441,0,225,36)
      Expand = True
    }
  }
  { gvResultados GridView
    Move(405,180,144,144)
    Expand = True
  }
  { !txtContexto TextArea
    Move(387,351,144,144)
    #Public = True
    Background = Color.Background
    Expand = True
    ReadOnly = True
    Wrap = True
    ScrollBar = Scroll.Vertical
  }
  { HBoxBuscarEnProyecto2 HBox
    Move(63,540,783,36)
    { Spring5 Spring
      Move(279,0,45,36)
    }
    { btnReemplazar Button
      Move(486,0,144,36)
      Font = Font["Bold"]
      Background = &H9FFF7F
      Text = ("Reemplazar")
      Picture = Picture["iconos/enviar.png"]
    }
    { btnCerrar Button
      Move(630,0,144,36)
      Text = ("Cerrar")
      Picture = Picture["iconos/salir.png"]
    }
  }
}
