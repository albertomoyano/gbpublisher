  Spacing = True
  Margin = True
  Padding = 4
  { HBoxBuscarEnProyecto1 HBox
    Move(18,45,783,36)
    { !TextBox1 TextBox
      Move(288,0,144,36)
      #Public = True
      Background = Color.Background
      NoTabFocus = True
      Expand = True
      ReadOnly = True
    }
  }
  { !termProcesosResultados TerminalView
    Move(351,216,144,144)
    #Public = True
    #Translate = False
    Background = Color.Background
    NoTabFocus = True
    Expand = True
    AutoResize = False
    Limit = 10000
    Blink = True
    ShowScrollBar = True
    ShowLink = True
