' Gambas class file

' Este módulo almacena la referencia al cuadro de texto original.
Public OriginalTextBox As TextBox

' ============================================
' Función   : Form_Show
' Propósito : APLICAR LA CONFIGURACIÓN DE BOTONES DEL MARCO
' Parámetros: ninguno
' Retorna   : nada
' ============================================
Public Sub Form_Show()

  m_Ventana.FijarBotones(Me)

End

Public Sub Form_Open()

  txtTextAreaCompleto.Text = OriginalTextBox.Text

End

' Evento del botón "Guardar y Cerrar".
Public Sub ButtonGuardarCerrar_Click()

  OriginalTextBox.Text = txtTextAreaCompleto.Text
  Me.Close

End
