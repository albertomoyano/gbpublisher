# Gambas Form File 3.0

{ Form Form
  Move(0,0,960,400)
  #Scaled = False
  Resizable = False
  Arrangement = Arrange.Vertical
  Spacing = True
  Margin = True
  Padding = 4
  { lblMotivo Label
    Move(9,9,936,36)
    #Translate = False
    Font = Font["Bold"]
  }
  { lblAyuda Label
    Move(9,45,936,36)
    #Translate = False
  }
  { gvCandidatos GridView
    Move(9,81,504,135)
    Expand = True
    Mode = Select.Single
    Header = GridView.Horizontal
  }
  { hbxBotones HBox
    Move(9,225,936,36)
    #Translate = False
    { btnConsultarLLM Button
      Move(0,0,198,36)
      #Translate = False
      Text = "Consultar al LLM"
    }
    { Panel1 Panel
      Move(540,0,36,36)
      Expand = True
    }
    { btnUsar Button
      Move(648,0,144,36)
      #Translate = False
      Font = Font["Bold"]
      Background = &H9FFF7F
      Text = "Usar esta"
      Picture = Picture["iconos/enviar.png"]
    }
    { btnCancelar Button
      Move(792,0,144,36)
      #Translate = False
      Text = "Cancelar"
      Picture = Picture["iconos/salir.png"]
    }
  }
}
