    { btnGuardarMod Button
      Move(72,0,36,36)
      #Translate = False
      NoTabFocus = True
      ToolTip = "Guardar cambios"
      Picture = Picture["iconos/guardarComo.png"]
    }
    { btnBorrar Button
      Move(108,0,36,36)
      #Translate = False
      NoTabFocus = True
      ToolTip = "Eliminar entrada"
      Picture = Picture["iconos/borrar.png"]
    }
    { Label7 Label
      Move(153,0,144,36)
      #Translate = False
      NoTabFocus = True
      Alignment = Align.Right
      Text = "asunto de la nota: "
    }
    { txtAsunto TextBox
      Move(315,0,171,36)
      #Translate = False
      NoTabFocus = True
