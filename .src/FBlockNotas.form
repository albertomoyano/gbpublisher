    }
  }
  { gridNotas TableView
    Move(9,108,540,108)
    Expand = True
    Mode = Select.Single
    ShowCursor = True
    Header = GridView.Horizontal
    ScrollBar = Scroll.Vertical
    Resizable = False
  }
  { HBox2 HBox
    Move(9,261,918,36)
