  Resizable = False
  Arrangement = Arrange.Vertical
  Spacing = True
  Margin = True
  Padding = 4
  { HBox1 HBox
    Move(9,18,918,36)
    { btnNuevo Button
      Move(0,0,36,36)
      #Translate = False
      NoTabFocus = True
      ToolTip = "Agregar entrada"
      Picture = Picture["iconos/+nuevo.png"]
    }
    { btnGuardar Button
      Move(36,0,36,36)
      #Translate = False
