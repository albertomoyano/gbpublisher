      Picture = Picture["iconos/salir.png"]
    }
  }
  { HBox8 HBox
    Move(9,63,918,36)
    { btnRefrescarGridNotas Button
      Move(0,0,36,36)
      #Translate = False
      NoTabFocus = True
      Picture = Picture["iconos/integridad.png"]
    }
    { btnBuscar Button
      Move(99,0,36,36)
      #Translate = False
      NoTabFocus = True
      ToolTip = "Buscar en toda la base de datos"
      Picture = Picture["iconos/search.png"]
    }
    { !txtBuscar TextBox
      Move(144,0,135,36)
