' Gambas module file

' ============================================
' Módulo    : m_GitHub
' Propósito : Genera .estado-proyecto.json como puente
'             entre la BD MySQL y GitHub Actions para
'             el seguimiento editorial del director.
'             Los IDs de GitHub viven exclusivamente en
'             .github-ids.json, gestionado solo por el Action.
' Requiere  : gb.util.web (JSON, JSONCollection)
' ============================================

' ============================================
' Función   : GenerarEstadoProyecto
' Propósito : Consulta la BD y escribe .estado-proyecto.json
'             en la raíz del proyecto con el estado editorial
'             puro. No incluye ningún campo de GitHub —
'             esos viven en .github-ids.json exclusivamente.
' Parámetros: sRutaProyecto   As String  — raíz del proyecto
'             iIdProyecto     As Integer — ID del proyecto en BD
'             sNombreProyecto As String  — nombre legible
' Retorna   : Boolean — True si el archivo se generó sin error
' ============================================
Public Function GenerarEstadoProyecto(sRutaProyecto As String, iIdProyecto As Integer, sNombreProyecto As String) As Boolean

  ' --- 1. DEFINIR RUTA DEL ARCHIVO JSON ---
  Dim sRutaJSON As String = sRutaProyecto &/ ".estado-proyecto.json"

  ' --- 2. CONSULTAR ARTÍCULOS DEL NÚMERO DEL PROYECTO EN LA BD ---
  ' ESQUEMA NUEVO (articulo, numero) DESDE EL 18/11/2026 (SC-98). LAS CLAVES
  ' DEL JSON NO CAMBIAN: LAS LEE .github/workflows/estado-editorial.yml.
  ' fecha_publicacion_online SALE DE fecha_publicacion; responsable_edicion
  ' NO TIENE COLUMNA EN EL ESQUEMA NUEVO Y VA NULO (EL WORKFLOW MUESTRA N/D)
  Dim hDB As Result

  Try hDB = m_ConexionBD.mConn.Exec(
    "SELECT a.id_articulo, a.nombre_archivo, a.titulo, a.doi, a.estado, a.article_type, " &
    "a.fecha_recepcion, a.fecha_aceptacion, a.fecha_publicacion " &
    "FROM articulo a JOIN numero n ON n.id_numero = a.id_numero " &
    "WHERE n.id_proyecto = &1 ORDER BY a.nombre_archivo", iIdProyecto)
  If Error Then Return False

  ' PROYECTO SIN ARTÍCULOS AÚN: NO HAY NADA QUE REPORTAR
  If Not hDB.Available Then Return True

  ' --- 3. CONSTRUIR ARRAY DE ARTÍCULOS ---
  Dim aArticulos As New Variant[]

  While hDB.Available

    Dim jArticulo As New JSONCollection
    jArticulo["nombre_archivo"] = CStr(hDB["nombre_archivo"])
    ' LOS TÍTULOS VAN PLANOS: EL JSON NO CORTA (SC-28)
    jArticulo["titulo"] = m_CorteTitulo.Plano(CStr(hDB["titulo"]))
    jArticulo["doi"] = ValorONull(hDB["doi"])
    jArticulo["tipo_articulo"] = ValorONull(hDB["article_type"])
    jArticulo["estado"] = CStr(hDB["estado"])
    jArticulo["fecha_recepcion"] = FechaONull(hDB["fecha_recepcion"])
    jArticulo["fecha_aceptacion"] = FechaONull(hDB["fecha_aceptacion"])
    jArticulo["fecha_publicacion_online"] = FechaONull(hDB["fecha_publicacion"])
    jArticulo["responsable_edicion"] = Null
    jArticulo["autores"] = ObtenerAutoresArticulo(CInt(hDB["id_articulo"]))

    aArticulos.Add(jArticulo)
    hDB.MoveNext()

  Wend

  ' --- 4. CONSTRUIR JSON RAÍZ Y GUARDAR EN DISCO ---
  Dim jRaiz As New JSONCollection
  ' DISCRIMINADOR DE FORMA PARA EL ACTION: UN ARRAY "articulos" (REVISTA)
  ' O UN OBJETO "libro". EVITA QUE EL WORKFLOW TENGA QUE INFERIRLO.
  jRaiz["tipo"] = "revista"
  jRaiz["proyecto"] = sNombreProyecto
  jRaiz["generado"] = Format(Now(), "yyyy-mm-ddThh:nn:ss")
  jRaiz["articulos"] = aArticulos

  Try File.Save(sRutaJSON, JSON.Encode(jRaiz))
  Return Not Error

Catch
  Return False

End Function

' ============================================
' Función   : ObtenerAutoresArticulo
' Propósito : Devuelve Variant[] con los apellidos_nombre
'             de los autores del artículo ordenados por
'             orden de autoría. Una autoría colectiva va con
'             su nombre (articulo_contribuyente, esquema nuevo)
' Parámetros: iIdArticulo As Integer
' Retorna   : Variant[] — ["Apellidos, Nombre", ...]
' ============================================
Private Function ObtenerAutoresArticulo(iIdArticulo As Integer) As Variant[]

  Dim aAutores As New Variant[]

  ' --- 1. CONSULTAR AUTORES ORDENADOS ---
  Dim hAut As Result

  Try hAut = m_ConexionBD.mConn.Exec(
    "SELECT COALESCE(a.apellidos_nombre, c.nombre_colectivo) AS apellidos_nombre " &
    "FROM articulo_contribuyente c LEFT JOIN autores a ON a.id_autor = c.id_autor " &
    "WHERE c.id_articulo = &1 AND c.rol = 'autor' ORDER BY c.orden", iIdArticulo)
  If Error Then Return aAutores

  ' --- 2. ACUMULAR NOMBRES NO NULOS ---
  While hAut.Available
    If Not IsNull(hAut["apellidos_nombre"]) Then
      aAutores.Add(CStr(hAut["apellidos_nombre"]))
    Endif
    hAut.MoveNext()
  Wend

  Return aAutores

Catch
  Return aAutores

End Function

' ============================================
' Función   : GenerarEstadoLibro
' Propósito : Consulta la BD y escribe .estado-proyecto.json
'             en la raíz del proyecto con el estado editorial
'             del libro. A DIFERENCIA DE LAS REVISTAS, LA UNIDAD
'             DE SEGUIMIENTO ES EL LIBRO COMPLETO, NO EL CAPÍTULO:
'             una sola Discussion por repositorio, porque la
'             interlocución editorial pasa siempre por la
'             coordinadora/editora. Los capítulos viajan como
'             manifiesto informativo, sin estado propio.
'             No incluye ningún campo de GitHub — esos viven en
'             .github-ids.json exclusivamente.
' Parámetros: sRutaProyecto   As String  — raíz del proyecto
'             iIdProyecto     As Integer — ID del proyecto en BD
'             sNombreProyecto As String  — nombre legible
' Retorna   : Boolean — True si el archivo se generó sin error
' ============================================
Public Function GenerarEstadoLibro(sRutaProyecto As String, iIdProyecto As Integer, sNombreProyecto As String) As Boolean

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim sRutaJSON As String
  Dim hDB As Result
  Dim jLibro As New JSONCollection
  Dim jRaiz As New JSONCollection
  Dim oEditoriales As CEditorialesLibro

  sRutaJSON = sRutaProyecto &/ ".estado-proyecto.json"

  ' --- 2. CONSULTAR EL LIBRO DEL PROYECTO ---
  ' libros_md.id_proyecto ES UNIQUE: HAY UN SOLO LIBRO POR PROYECTO.
  ' POR ESO NO HAY BUCLE NI ARRAY, A DIFERENCIA DE LOS ARTÍCULOS.
  Try hDB = m_ConexionBD.mConn.Exec(
    "SELECT id_libro, titulo_libro, subtitulo, tipo_libro, " &
    "isbn_impreso, isbn_electronico, doi_libro, " &
    "ano_publicacion, idioma_principal, " &
    "estado_libro, estado_publicacion " &
    "FROM libros_md WHERE id_proyecto = " & iIdProyecto)
  If Error Then Return False

  ' PROYECTO SIN REGISTRO DE LIBRO AÚN: NO HAY NADA QUE REPORTAR
  If Not hDB.Available Then Return True

  ' --- 3. CONSTRUIR EL OBJETO LIBRO ---
  ' LOS TÍTULOS VAN PLANOS: EL JSON NO CORTA (SC-28)
  jLibro["titulo"] = m_CorteTitulo.Plano(CStr(hDB["titulo_libro"]))
  jLibro["subtitulo"] = ValorONull(m_CorteTitulo.Plano(hDB["subtitulo"]))
  jLibro["tipo_libro"] = ValorONull(hDB["tipo_libro"])
  jLibro["isbn_impreso"] = ValorONull(hDB["isbn_impreso"])
  jLibro["isbn_electronico"] = ValorONull(hDB["isbn_electronico"])
  jLibro["doi"] = ValorONull(hDB["doi_libro"])
  ' LAS EDITORIALES DEL LIBRO, UNIDAS COMO EN LA FICHA (libro_editorial, 2.2.0)
  oEditoriales = m_EditorialLibro.Resumen(CInt(hDB["id_libro"]))
  If Not oEditoriales Then Return False
  jLibro["editorial"] = ValorONull(oEditoriales.Unidos())
  jLibro["ano_publicacion"] = ValorONull(hDB["ano_publicacion"])
  jLibro["idioma"] = ValorONull(hDB["idioma_principal"])

  ' EL ESTADO DE PROCESO NUNCA DEBE VIAJAR NULO: ES EL CAMPO QUE EL ACTION
  ' COMPARA CONTRA ultimo_estado PARA DETECTAR TRANSICIONES. RC-GM-17:
  ' EL NULL-CHECK VA EN If ANIDADO, NO COMBINADO CON LA CONVERSIÓN.
  If IsNull(hDB["estado_libro"]) Then
    jLibro["estado"] = "borrador"
  Else
    jLibro["estado"] = CStr(hDB["estado_libro"])
  Endif

  ' ESTADO BIBLIOGRÁFICO: VIAJA COMO DATO DE CONTEXTO, NO DISPARA TRANSICIONES
  jLibro["estado_publicacion"] = ValorONull(hDB["estado_publicacion"])

  ' RESPONSABLE = QUIEN EJECUTA EL EMPUJE (EL MAQUETADOR), NO EL CREADOR
  ' DEL REGISTRO. SALE DE LA GLOBAL DE SESIÓN CACHEADA AL LOGIN (RC-GM-11).
  jLibro["responsable"] = m_InicioCierre.UsuarioEnCurso

  ' MANIFIESTO DE CAPÍTULOS: ÍNDICE PARA LECTURA DEL DIRECTOR
  jLibro["capitulos"] = ObtenerManifiestoCapitulos(CInt(hDB["id_libro"]))

  ' --- 4. CONSTRUIR JSON RAÍZ Y GUARDAR EN DISCO ---
  jRaiz["tipo"] = "libro"
  jRaiz["proyecto"] = sNombreProyecto
  jRaiz["generado"] = Format(Now(), "yyyy-mm-ddThh:nn:ss")
  jRaiz["libro"] = jLibro

  Try File.Save(sRutaJSON, JSON.Encode(jRaiz))
  Return Not Error

Catch
  Return False

End Function

' ============================================
' Función   : ObtenerManifiestoCapitulos
' Propósito : Devuelve Variant[] con el índice de capítulos del
'             libro, ordenado por nombre de archivo (la convención
'             fm- / a- / bm- fija el orden editorial, el mismo que
'             usa el ensamblado del EPUB).
'             Es INFORMATIVO: el capítulo no lleva estado porque
'             no es unidad de seguimiento.
' Parámetros: iIdLibro As Integer — ID del libro en libros_md
' Retorna   : Variant[] — objetos {orden, titulo, tipo}
' ============================================
Private Function ObtenerManifiestoCapitulos(iIdLibro As Integer) As Variant[]

  ' --- 1. INICIALIZACIÓN DE VARIABLES ---
  Dim aCapitulos As New Variant[]
  Dim hCap As Result
  Dim jCapitulo As JSONCollection

  ' --- 2. CONSULTAR CAPÍTULOS EN ORDEN EDITORIAL ---
  ' ORDEN EDITORIAL: POR FAMILIA (fm-, a-, bm-) Y DENTRO DE CADA UNA POR
  ' NOMBRE DE ARCHIVO. EL CRITERIO VIVE EN UN SOLO LUGAR (m_OrdenPiezas).
  Try hCap = m_ConexionBD.mConn.Exec(
    "SELECT nombre_archivo, titulo_capitulo, tipo_capitulo " &
    "FROM capitulos WHERE id_libro = " & iIdLibro &
    " ORDER BY " & m_OrdenPiezas.ClausulaOrden("nombre_archivo"))
  If Error Then Return aCapitulos

  ' --- 3. ACUMULAR CADA CAPÍTULO COMO OBJETO ---
  While hCap.Available
    jCapitulo = New JSONCollection
    jCapitulo["orden"] = ValorONull(hCap["nombre_archivo"])
    jCapitulo["titulo"] = m_CorteTitulo.Plano(CStr(hCap["titulo_capitulo"]))
    jCapitulo["tipo"] = ValorONull(hCap["tipo_capitulo"])
    aCapitulos.Add(jCapitulo)
    hCap.MoveNext()
  Wend

  Return aCapitulos

Catch
  Return aCapitulos

End Function

' ============================================
' Función   : ValorONull
' Propósito : Devuelve el valor como String o JSON.Null
'             si es nulo o vacío. Centraliza la lógica
'             repetitiva de campos opcionales de la BD.
' Parámetros: vValor As Variant — valor proveniente de la BD
' Retorna   : Variant — String o JSON.Null
' ============================================
Private Function ValorONull(vValor As Variant) As Variant

  If IsNull(vValor) Then Return JSON.Null
  Dim sValor As String
  Try sValor = CStr(vValor)
  If Error Or sValor = "" Then Return JSON.Null
  Return sValor

End Function

' ============================================
' Función   : FechaONull
' Propósito : Convierte fecha de BD a string ISO 8601
'             (yyyy-mm-dd) o JSON.Null si es nula.
'             JSON no tiene tipo Date nativo; el formato
'             ISO 8601 es el estándar para intercambio.
' Parámetros: vFecha As Variant — valor de fecha de la BD
' Retorna   : Variant — String "yyyy-mm-dd" o JSON.Null
' ============================================
Private Function FechaONull(vFecha As Variant) As Variant

  If IsNull(vFecha) Then Return JSON.Null
  Try Return Format(CDate(vFecha), "yyyy-mm-dd")
  Return JSON.Null

Catch
  Return JSON.Null

End Function

' ============================================
' Función   : EmpujarGitLocal
' Propósito : Hace el commit en el repositorio local del proyecto con
'             engine/commit_local.sh, por la lanzadora (SC-53). Acá queda solo
'             lo que el script no puede hacer: pedir el mensaje (FCommits)
' Parámetros: (ninguno)
' Retorna   : (Sub, sin retorno)
' Nota      : HASTA EL 21/11/2026 TIPEABA git init, git add Y git commit EN LA
'             TERMINAL CON Input(), SIN RECIBIR EL RESULTADO Y CON EL MENSAJE
'             ESCAPADO A MANO (DEUDA DE SC-13). EL MISMO SCRIPT HACE EL COMMIT
'             DEL EMPUJE REMOTO (empujar_remoto.sh LO LLAMA ANIDADO)
' ============================================
Public Sub EmpujarGitLocal()

  ' --- 1. INICIALIZACIÓN ---
  Dim sRutaProyecto As String
  Dim aArgumentos As String[]
  Dim iResultado As Integer

  ' --- 2. VALIDACIÓN ---
  sRutaProyecto = m_InicioCierre.RutaProyectoEnCurso
  If sRutaProyecto = "" Then
    m_Sonido.sonar("Warning")
    Message.Warning("No hay un proyecto abierto.")
    Return
  Endif

  ' --- 3. MENSAJE DEL COMMIT ---
  ' FCommits LO DEJA EN SU VARIABLE Static PUBLIC Y DEVUELVE True AL ACEPTAR
  If Not FCommits.ShowModal() Then Return

  ' --- 4. LANZAMIENTO ---
  ' UN COMMIT LOCAL NO TOCA LA RED: 60 s ALCANZAN; SI VENCE, LA LANZADORA
  ' PREGUNTA SI SEGUIR ESPERANDO
  aArgumentos = [sRutaProyecto, FCommits.MensajeCommit]
  iResultado = m_Lanzadora.EjecutarScript("commit_local.sh", aArgumentos, 60, "Commit en el repositorio local")

  ' --- 5. RESULTADO ---
  InformarCommit(iResultado)

End

' ============================================
' Función   : InformarCommit
' Propósito : Traduce el resultado de la lanzadora a un mensaje del commit
'             local. El detalle está en la terminal.
' Parámetros: iResultado As Integer — lo que devolvió EjecutarScript
' Retorna   : (Sub, sin retorno)
' ============================================
Private Sub InformarCommit(iResultado As Integer)

  Select Case iResultado
    Case m_Lanzadora.SALIDA_OK
      m_Sonido.sonar("Info")
      Message.Info("Se hizo el commit en el repositorio local.")
      Return
    Case m_Lanzadora.SALIDA_AVISOS
      m_Sonido.sonar("Info")
      Message.Info("No había cambios para commitear.")
      Return
    Case m_Lanzadora.SALIDA_FALLO
      m_Sonido.sonar("Error")
      Message.Error("No se hizo el commit." & gb.NewLine & gb.NewLine &
        "El motivo está al final de la salida en la terminal.")
      Return
  End Select

  ' RESULTADOS PROPIOS DE LA LANZADORA, Y CUALQUIER OTRO CÓDIGO
  m_Lanzadora.InformarResultado(iResultado, "El commit", "")

End

' ============================================
' Función   : EmpujarRemoto
' Propósito : Empuja el proyecto al repositorio remoto de GitHub con
'             engine/empujar_remoto.sh, por la lanzadora (SC-53). Acá queda
'             solo lo que el script no puede hacer: leer la base (el JSON de
'             la integración) y los datos de la interfaz (SC-13).
' Parámetros: sMensaje As String — mensaje del commit
'             sUsuario As String — usuario de GitHub (FFileManager.
'             txtUsuarioGit); puede ir vacío si el proyecto ya tiene origin
' Retorna   : Boolean — True si se empujó (con o sin avisos)
' Nota      : LO LLAMA FFileManager.btnEmpujar_Click. REEMPLAZA A
'             EmpujarGitHubRemoto, EjecutarPushGitHub, VerificarAccesoSSHGitHub
'             Y VerificarProtocoloRemoto (21/11/2026): TIPEABAN EN LA TERMINAL
'             SIN RECIBIR RESULTADO, Y ssh -T CON Shell ... To CONGELABA LA
'             INTERFAZ. EL REMOTO ES SOLO SSH: EL SCRIPT NO CORRIGE UNO HTTPS
' ============================================
Public Function EmpujarRemoto(sMensaje As String, sUsuario As String) As Boolean

  ' --- 1. INICIALIZACIÓN ---
  Dim sRutaProyecto As String
  Dim sUrlRemoto As String
  Dim sIntegracion As String
  Dim aArgumentos As String[]
  Dim bJsonOk As Boolean
  Dim iResultado As Integer

  ' --- 2. VALIDACIÓN ---
  sRutaProyecto = m_InicioCierre.RutaProyectoEnCurso
  If sRutaProyecto = "" Then
    m_Sonido.sonar("Warning")
    Message.Warning("No hay un proyecto abierto.")
    Return False
  Endif

  If Trim(sMensaje) = "" Then
    m_Sonido.sonar("Warning")
    Message.Warning("Falta el mensaje del commit.")
    Return False
  Endif

  ' --- 3. URL DEL REMOTO ---
  ' SOLO HACE FALTA SI EL PROYECTO TODAVÍA NO TIENE origin: CON origin, EL
  ' SCRIPT USA EL QUE ESTÁ. SIN USUARIO VA «-» (SC-53: NINGÚN ARGUMENTO
  ' VACÍO) Y EL SCRIPT, SI NO HAY origin, LO DICE.
  ' EL REPOSITORIO SE LLAMA COMO EL .md DEL PROYECTO SIN LA EXTENSIÓN:
  ' NombreProyectoEnCurso ES File.Name DEL .md, CON «.md» (FMain, APERTURA)
  sUsuario = Trim(sUsuario)
  If sUsuario = "" Then
    sUrlRemoto = "-"
  Else
    sUrlRemoto = "git@github.com:" & sUsuario & "/" & File.BaseName(m_InicioCierre.NombreProyectoEnCurso) & ".git"
  Endif

  ' --- 4. INTEGRACIÓN: EL JSON SALE DE LA BASE, LO ESCRIBE GAMBAS ANTES (SC-13) ---
  sIntegracion = "no"
  If UsaIntegracionGitHub() Then
    sIntegracion = "si"

    ' LA FORMA DEL JSON DEPENDE DEL TIPO DE PROYECTO: LA REVISTA EMITE UN ARRAY
    ' DE ARTÍCULOS; EL LIBRO, UN OBJETO ÚNICO CON MANIFIESTO DE CAPÍTULOS
    Select Case FMain.TipoProyectoActual
      Case m_Constantes.TIPO_LIBRO_MD
        bJsonOk = GenerarEstadoLibro(sRutaProyecto, m_InicioCierre.IdProyectoEnCurso, File.BaseName(m_InicioCierre.NombreProyectoEnCurso))
      Case m_Constantes.TIPO_REVISTA_MD
        bJsonOk = GenerarEstadoProyecto(sRutaProyecto, m_InicioCierre.IdProyectoEnCurso, File.BaseName(m_InicioCierre.NombreProyectoEnCurso))
      Default
        ' TIPO NO CONTEMPLADO (LATEX LEGACY): NO SE GENERA JSON. ES PREFERIBLE
        ' NO EMITIR NADA A EMITIR UN DOCUMENTO CON LA FORMA EQUIVOCADA
        bJsonOk = True
    End Select

    If Not bJsonOk Then
      m_Sonido.sonar("Warning")
      If Message.Question("No se pudo generar el archivo de integración con GitHub." & gb.NewLine & gb.NewLine &
          "¿Continuar el empuje sin él?", "Continuar", "Cancelar") <> 1 Then Return False
      Endif
    Endif

    ' --- 5. LANZAMIENTO ---
    ' NADA EN EL SCRIPT ESPERA UNA RESPUESTA (BatchMode): 120 s ALCANZAN PARA UN
    ' EMPUJE NORMAL; SI VENCE, LA LANZADORA PREGUNTA SI SEGUIR ESPERANDO
    aArgumentos = [sRutaProyecto, sUrlRemoto, sIntegracion, sMensaje]
    iResultado = m_Lanzadora.EjecutarScript("empujar_remoto.sh", aArgumentos, 120, "Empujando al repositorio remoto")

    Return InformarEmpuje(iResultado)

End

' ============================================
' Función   : UsuarioGitGuardado
' Propósito : El usuario de GitHub guardado en gbpublisher.conf (SC-17)
' Parámetros: (ninguno)
' Retorna   : String — el usuario, o vacío si no hay o no se pudo leer
' ============================================
Public Function UsuarioGitGuardado() As String

  ' --- 1. INICIALIZACIÓN ---
  Dim hConfiguracion As Settings
  Dim sUsuario As String

  ' --- 2. LECTURA ---
  ' NO ES CRÍTICO: SIN VALOR, EL CAMPO QUEDA VACÍO Y SE ESCRIBE A MANO
  Try hConfiguracion = New Settings(m_InicioCierre.RutaConfiguracion())
  If Error Then Return ""
  Try sUsuario = Trim(CStr(hConfiguracion["GitHub/Usuario", ""]))
  If Error Then Return ""

  Return sUsuario

End

' ============================================
' Función   : GuardarUsuarioGit
' Propósito : Guarda el usuario de GitHub en gbpublisher.conf (SC-17), con
'             Save explícito
' Parámetros: sUsuario As String — el usuario
' Retorna   : (Sub, sin retorno)
' ============================================
Public Sub GuardarUsuarioGit(sUsuario As String)

  ' --- 1. INICIALIZACIÓN ---
  Dim hConfiguracion As Settings

  ' --- 2. ESCRITURA ---
  ' SOLO UN USUARIO NO VACÍO: UN EMPUJE SIN USUARIO (CON origin) NO BORRA EL
  ' QUE YA ESTABA GUARDADO
  If Trim(sUsuario) = "" Then Return
  Try hConfiguracion = New Settings(m_InicioCierre.RutaConfiguracion())
  If Error Then Return
  hConfiguracion["GitHub/Usuario"] = Trim(sUsuario)
  Try hConfiguracion.Save()

End

' ============================================
' Función   : InformarEmpuje
' Propósito : Traduce el resultado de la lanzadora a un mensaje del empuje.
'             El detalle está en la terminal.
' Parámetros: iResultado As Integer — lo que devolvió EjecutarScript
' Retorna   : Boolean — True si se empujó (con o sin avisos)
' Nota      : m_Lanzadora.InformarResultado HABLA DE «ARCHIVO GENERADO», QUE
'             NO APLICA A UN EMPUJE; SE USA SOLO PARA LOS RESULTADOS PROPIOS
'             DE LA LANZADORA (EN CURSO, NO LANZADO, ABANDONADO, ILEGIBLE)
' ============================================
Private Function InformarEmpuje(iResultado As Integer) As Boolean

  Select Case iResultado
    Case m_Lanzadora.SALIDA_OK
      m_Sonido.sonar("Info")
      Message.Info("Se empujó al repositorio remoto.")
      Return True
    Case m_Lanzadora.SALIDA_AVISOS
      m_Sonido.sonar("Warning")
      Message.Warning("Se empujó, pero con avisos." & gb.NewLine & gb.NewLine &
        "Revisá la terminal: los avisos están marcados con ⚠.")
      Return True
    Case m_Lanzadora.SALIDA_FALLO
      m_Sonido.sonar("Error")
      Message.Error("No se empujó." & gb.NewLine & gb.NewLine &
        "El motivo está al final de la salida en la terminal.")
      Return False
  End Select

  ' RESULTADOS PROPIOS DE LA LANZADORA, Y CUALQUIER OTRO CÓDIGO
  m_Lanzadora.InformarResultado(iResultado, "El empuje", "")
  Return False

End

' ============================================
' Función   : UsaIntegracionGitHub
' Propósito : Consulta si el proyecto activo tiene
'             activada la integración con GitHub Actions.
'             Se llama solo desde EmpujarRemoto.
' Retorna   : Boolean — True si debe generar el JSON
' ============================================
Public Function UsaIntegracionGitHub() As Boolean

  Dim hProyecto As Result

  ' RC-GM-16: EL ID SALE DE LA GLOBAL, NO DEL ValueBox (QUE PUEDE HABERSE
  ' RESETEADO POR UN EVENTO DE UI)
  Try hProyecto = m_ConexionBD.mConn.Exec(
    "SELECT integracion_github FROM proyectos WHERE id = " & m_InicioCierre.IdProyectoEnCurso)
  If Error Then Return False
  If Not hProyecto.Available Then Return False
  Return CStr(hProyecto["integracion_github"]) = "con_integracion"

End Function
